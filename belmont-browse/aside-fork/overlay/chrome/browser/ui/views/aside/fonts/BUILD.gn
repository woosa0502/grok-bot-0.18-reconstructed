# Geist font family bundled by the original (Aside Framework.framework/
# Resources/Geist-*.ttf). Copied next to the binary; registered with
# fontconfig at startup by chrome/browser/ui/aside/aside_fonts.cc.
copy("aside_fonts") {
  sources = [
    "Geist-Black.ttf",
    "Geist-BlackItalic.ttf",
    "Geist-Bold.ttf",
    "Geist-BoldItalic.ttf",
    "Geist-ExtraBold.ttf",
    "Geist-ExtraBoldItalic.ttf",
    "Geist-ExtraLight.ttf",
    "Geist-ExtraLightItalic.ttf",
    "Geist-Italic.ttf",
    "Geist-Light.ttf",
    "Geist-LightItalic.ttf",
    "Geist-Medium.ttf",
    "Geist-MediumItalic.ttf",
    "Geist-Regular.ttf",
    "Geist-SemiBold.ttf",
    "Geist-SemiBoldItalic.ttf",
    "Geist-Thin.ttf",
    "Geist-ThinItalic.ttf",
  ]
  outputs = [ "$root_out_dir/aside_fonts/{{source_file_part}}" ]
}
