+// Native Chats and Tabs section controls. Recent chats belong to Chats above
+// the native tab strip. Native tab collections provide pins and groups.
+// Session commands and attention popovers use the account-scoped TasksClient.
+class AsideVerticalTabStripAdditions : public views::View,
+                                       public views::ContextMenuController,
+                                       public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(AsideVerticalTabStripAdditions, views::View)
