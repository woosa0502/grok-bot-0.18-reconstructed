+void LocationBarView::RebindToProfile(Profile* profile) {
+  CHECK(browser_);
+  CHECK(profile);
+  CHECK_EQ(profile, browser_->GetProfile());
+  if (profile_ == profile) {
+    return;
+  }
+
+  auto RebindPrefs = [this]() {
+    pref_registrar_->Reset();
+    pref_registrar_->Init(profile_->GetPrefs());
+    pref_registrar_->Add(
+        omnibox::kShowAiModeOmniboxButton,
+        base::BindRepeating(&LocationBarView::OnChanged,
+                            base::Unretained(this)));
+  };
+
+  if (!is_initialized_) {
+    profile_ = profile;
+    if (pref_registrar_) {
+      RebindPrefs();
+    }
+    return;
+  }
+
+  // The Browser callback is deliberately dispatched after destination-manager
+  // adoption and before its tabs are restored. Rebuilding with live tab state
+  // would risk persisting source-profile input into the destination profile.
+  CHECK(browser_->tab_strip_model()->empty());
+  is_initialized_ = false;
+  weak_factory_.InvalidateWeakPtrs();
+  deferred_location_bar_refresh_pending_ = false;
+  in_popup_state_transition_ = false;
+  omnibox_popup_file_selector_.reset();
+
+  views::FocusManager* const focus_manager = GetFocusManager();
+  if (focus_manager && omnibox_view_ &&
+      omnibox_view_->Contains(focus_manager->GetFocusedView())) {
+    focus_manager->ClearFocus();
+  }
+
+  const size_t omnibox_view_index = GetIndexOf(omnibox_view_).value();
+  const size_t selected_keyword_view_index =
+      GetIndexOf(selected_keyword_view_).value();
+
+  // SelectedKeywordView pins both the source Profile and the old controller.
+  auto selected_keyword_view = RemoveChildViewT(selected_keyword_view_.get());
+  selected_keyword_view_ = nullptr;
+  selected_keyword_view.reset();
+
+  DestroyOmniboxSubsystem();
+  profile_ = profile;
+  RebindPrefs();
+  CreateOmniboxSubsystem(omnibox_view_index);
+  if (omnibox::IsAimPopupFeatureEnabled()) {
+    omnibox_popup_file_selector_ = std::make_unique<OmniboxPopupFileSelector>(
+        GetWidget()->GetNativeWindow());
+  }
+
+  const gfx::FontList& font_list = views::TypographyProvider::Get().GetFont(
+      CONTEXT_OMNIBOX_PRIMARY, views::style::STYLE_PRIMARY);
+  selected_keyword_view_ = AddChildViewAt(
+      std::make_unique<SelectedKeywordView>(this, profile_,
+                                            omnibox_controller_.get(),
+                                            font_list),
+      selected_keyword_view_index);
+  selected_keyword_view_->SetVisible(false);
+
+  // This callback was created with base::Unretained(old_omnibox_view).
+  clear_all_button_->SetCallback(base::BindRepeating(
+      static_cast<void (OmniboxView::*)(const std::u16string&)>(
+          &OmniboxView::SetUserText),
+      base::Unretained(omnibox_view_), std::u16string()));
+
+  SetImeInlineAutocompletion(std::u16string_view());
+  SetOmniboxAdditionalText(std::u16string_view());
+  aside_page_title_view_->SetText(std::u16string());
+  aside_page_title_view_->SetVisible(false);
+  is_initialized_ = true;
+  RefreshBackground();
+  InvalidateLayout();
+}
