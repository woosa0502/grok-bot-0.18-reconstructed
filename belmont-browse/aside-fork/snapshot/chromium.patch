+  RecordingImporterObserver observer;
+  auto* host = new ExternalProcessImporterHost();
+  host->set_observer(&observer);
+  host->Cancel();  // Uses the real host path; no utility process is started.
+  EXPECT_TRUE(observer.cancelled);
+  EXPECT_TRUE(observer.ended);
+}
