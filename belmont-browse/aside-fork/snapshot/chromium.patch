+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id,
+                                    Profile::FromBrowserContext(browser_context()),
+                                    include_incognito_information(), &contents) ||
+      !contents) {
+    return RespondNow(Error(kInvalidTabId));
+  }
+  auto added = session->contexts().AddTab(params->tab_id,
+      contents->GetLastCommittedURL(), base::UTF16ToUTF8(contents->GetTitle()));
+  if (!added.has_value()) {
