+    BrowserWindowInterface* browser) {
+  if (browser->IsActive() && ShouldTrackBrowser(browser)) {
+    if (TabsWindowsAPI* api = TabsWindowsAPI::Get(&(*profile_))) {
+      // The native window remains active, but it is leaving this profile.
+      // Clear the source cache so returning to the same window ID later emits
+      // a focus gain instead of being mistaken for an unchanged focus.
+      api->windows_event_router()->OnActiveWindowChanged(nullptr);
+    }
+  }
+  if (TabListInterface* tab_list = TabListInterface::From(browser)) {
+    router_->UntrackTabListForProfileSwitch(*tab_list);
+  }
