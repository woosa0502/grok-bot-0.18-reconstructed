+  Profile* const profile = admitted->second;
+  counted_browsers_.erase(admitted);
+  auto count = browser_counts_.find(profile);
+  CHECK(count != browser_counts_.end());
+  CHECK_GT(count->second, 0);
+  if (--count->second == 0) {
+    browser_counts_.erase(count);
+    std::erase(active_profiles_, profile);
+    if (!closing_all_browsers_) {
+      SaveActiveProfiles();
+    }
+  }
