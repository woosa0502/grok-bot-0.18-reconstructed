+  host->set_observer(&observer);
+  host->NotifyImportFailed("missing source");
+  host->NotifyImportEnded();
+  EXPECT_EQ("missing source", observer.failure);
+  EXPECT_FALSE(observer.cancelled);
+  EXPECT_TRUE(observer.ended);
