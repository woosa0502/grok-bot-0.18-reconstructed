+  }
+  if (join) {
+    std::move(join).Run(
+        collaboration::CollaborationControllerDelegate::Outcome::kCancel);
+    if (!weak_this) return;
+  }
+  if (close) {
+    std::move(close).Run(std::nullopt, std::nullopt);
+    if (!weak_this) return;
+  }
+  profile_ = CHECK_DEREF(profile);
+  rebinding_profile_ = false;
+}
