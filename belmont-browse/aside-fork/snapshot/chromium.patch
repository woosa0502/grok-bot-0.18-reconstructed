+TEST(AsideAgentOwnershipTest, AssignmentExpiresAndCannotOutliveItsGroup) {
+  content::BrowserTaskEnvironment environment(
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  const auto id = tab_groups::TabGroupId::GenerateNew();
+  auto group = std::make_unique<TestAsideGroup>(id);
+  aside::RecordAgentTabsAssignment(group.get(), aside::kAsideExtensionId);
+  environment.FastForwardBy(base::Seconds(11));
+  aside::ConfirmAgentTabsAssignment(group.get(), aside::kAsideExtensionId, u"Agent Tabs");
+  EXPECT_FALSE(aside::IsAgentTabsGroup(group.get()));
+  aside::RecordAgentTabsAssignment(group.get(), aside::kAsideExtensionId);
+  group.reset();
+  TestAsideGroup replacement(id);
+  aside::ConfirmAgentTabsAssignment(&replacement, aside::kAsideExtensionId, u"Agent Tabs");
+  EXPECT_FALSE(aside::IsAgentTabsGroup(&replacement));
+  aside::ClearAiTabsMetadata(id);
