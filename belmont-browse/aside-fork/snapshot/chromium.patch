   registered_browsers_.erase(CHECK_DEREF(browser_for_close));
 }
 
+void SearchEngineChoiceDialogService::BrowserRegistry::
+    OnBrowserRemovedForProfileSwitch(BrowserWindowInterface* browser) {
+  Browser* const moved_browser = browser->GetBrowserForMigrationOnly();
+  if (!moved_browser) {
+    return;
+  }
+
+  auto registration = registered_browsers_.find(CHECK_DEREF(moved_browser));
+  if (registration == registered_browsers_.end()) {
+    return;
+  }
+  base::OnceClosure close_dialog = std::move(registration->second);
+  registered_browsers_.erase(registration);
+  if (close_dialog) {
+    std::move(close_dialog).Run();
+  }
+}
+
 bool SearchEngineChoiceDialogService::BrowserRegistry::IsRegistered(
     Browser& browser) const {
   return registered_browsers_.contains(browser);
