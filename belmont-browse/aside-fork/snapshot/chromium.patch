+void WebsiteMetrics::OnBrowserRemovedForProfileSwitch(
+    BrowserWindowInterface* browser) {
+  if (IsAppBrowser(browser)) {
+    return;
+  }
+
+  aura::Window* const window = GetWindowWithBrowser(browser);
+  if (!window) {
+    return;
+  }
+
+  // The pager normally detaches every tab before moving the Browser between
+  // profile collections. Keep this teardown complete if a caller changes that
+  // ordering: URL/accounting state belongs to the source profile and must not
+  // follow the native window.
+  for (tabs::TabInterface* tab : *browser->GetTabStripModel()) {
+    content::WebContents* const contents = tab->GetContents();
+    if (webcontents_to_observer_map_.contains(contents) ||
+        webcontents_to_ukm_key_.contains(contents)) {
+      OnTabClosed(contents);
+    }
+  }
+
+  auto window_it = window_to_web_contents_.find(window);
+  if (window_it != window_to_web_contents_.end()) {
+    content::WebContents* const active_contents = window_it->second;
+    if (active_contents &&
+        (webcontents_to_observer_map_.contains(active_contents) ||
+         webcontents_to_ukm_key_.contains(active_contents))) {
+      OnTabClosed(active_contents);
+    }
+    window_to_web_contents_.erase(window_it);
+  }
+  MaybeRemoveObserveWindowActivationClient(window);
+  if (observed_windows_.IsObservingSource(window)) {
+    observed_windows_.RemoveObservation(window);
+  }
+}
