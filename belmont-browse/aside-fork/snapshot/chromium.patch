@@ -0,0 +1,171 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/extensions/extension_installed_watcher.h"
+
+#include <optional>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/profiles/profile_test_util.h"
+#include "chrome/test/base/testing_browser_process.h"
+#include "chrome/test/base/testing_profile.h"
+#include "content/public/test/browser_task_environment.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/extension_builder.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+class ExtensionInstalledWatcherTest : public testing::Test {
+ public:
+  ExtensionInstalledWatcherTest()
+      : profile_manager_(TestingBrowserProcess::GetGlobal()) {}
+
+  void SetUp() override {
+    ASSERT_TRUE(profile_manager_.SetUp());
+    profile_a_ = profile_manager_.CreateTestingProfile("profile-a");
+    profile_b_ = profile_manager_.CreateTestingProfile("profile-b");
+    ASSERT_TRUE(profile_a_);
+    ASSERT_TRUE(profile_b_);
+  }
+
+ protected:
+  void LoadExtension(
+      Profile* profile,
+      const scoped_refptr<const extensions::Extension>& extension) {
+    extensions::ExtensionRegistry* const registry =
+        extensions::ExtensionRegistry::Get(profile);
+    ASSERT_TRUE(registry->AddEnabled(extension));
+    registry->TriggerOnLoaded(extension.get());
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfileManager profile_manager_;
+  raw_ptr<TestingProfile> profile_a_ = nullptr;
+  raw_ptr<TestingProfile> profile_b_ = nullptr;
+};
+
+TEST_F(ExtensionInstalledWatcherTest,
+       RebindCancelsSourceWaitAndIgnoresSourceEvents) {
+  ExtensionInstalledWatcher watcher(profile_a_);
+  const auto extension = extensions::ExtensionBuilder("test-extension").Build();
+  std::vector<bool> results;
+
+  watcher.WaitForInstall(
+      extension->id(),
+      base::BindOnce(
+          [](std::vector<bool>* results, bool installed) {
+            results->push_back(installed);
+          },
+          &results));
+
+  watcher.RebindProfileForAside(profile_b_);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false}));
+
+  LoadExtension(profile_a_, extension);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false}));
+
+  watcher.WaitForInstall(
+      extension->id(),
+      base::BindOnce(
+          [](std::vector<bool>* results, bool installed) {
+            results->push_back(installed);
+          },
+          &results));
+  LoadExtension(profile_b_, extension);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false, true}));
+}
+
+TEST_F(ExtensionInstalledWatcherTest, RepeatedRebindDoesNotDuplicateCallbacks) {
+  ExtensionInstalledWatcher watcher(profile_a_);
+  const auto extension_a = extensions::ExtensionBuilder("extension-a").Build();
+  const auto extension_b = extensions::ExtensionBuilder("extension-b").Build();
+  std::vector<bool> results;
+
+  watcher.WaitForInstall(
+      extension_a->id(),
+      base::BindOnce(
+          [](std::vector<bool>* results, bool installed) {
+            results->push_back(installed);
+          },
+          &results));
+  watcher.RebindProfileForAside(profile_b_);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false}));
+
+  watcher.WaitForInstall(
+      extension_b->id(),
+      base::BindOnce(
+          [](std::vector<bool>* results, bool installed) {
+            results->push_back(installed);
+          },
+          &results));
+  watcher.RebindProfileForAside(profile_a_);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false, false}));
+
+  watcher.WaitForInstall(
+      extension_a->id(),
+      base::BindOnce(
+          [](std::vector<bool>* results, bool installed) {
+            results->push_back(installed);
+          },
+          &results));
+
+  LoadExtension(profile_b_, extension_b);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false, false}));
+
+  LoadExtension(profile_a_, extension_a);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(results, std::vector<bool>({false, false, true}));
+}
+
+TEST_F(ExtensionInstalledWatcherTest,
+       CancellationCallbackCanStartDestinationWait) {
+  ExtensionInstalledWatcher watcher(profile_a_);
+  const auto source_extension =
+      extensions::ExtensionBuilder("source-extension").Build();
+  const auto destination_extension =
+      extensions::ExtensionBuilder("destination-extension").Build();
+  std::optional<bool> source_result;
+  std::optional<bool> destination_result;
+
+  watcher.WaitForInstall(
+      source_extension->id(),
+      base::BindOnce(
+          [](ExtensionInstalledWatcher* watcher,
+             const extensions::ExtensionId& destination_id,
+             std::optional<bool>* source_result,
+             std::optional<bool>* destination_result, bool installed) {
+            *source_result = installed;
+            watcher->WaitForInstall(
+                destination_id,
+                base::BindOnce(
+                    [](std::optional<bool>* result, bool destination_installed) {
+                      *result = destination_installed;
+                    },
+                    destination_result));
+          },
+          &watcher, destination_extension->id(), &source_result,
+          &destination_result));
+
+  watcher.RebindProfileForAside(profile_b_);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(source_result.has_value());
+  EXPECT_FALSE(*source_result);
+  EXPECT_FALSE(destination_result.has_value());
+
+  LoadExtension(profile_b_, destination_extension);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(destination_result.has_value());
+  EXPECT_TRUE(*destination_result);
+}
+
+}  // namespace
