diff --git a/chrome/browser/ui/extensions/aside_theme_install_blocked_dialog.cc b/chrome/browser/ui/extensions/aside_theme_install_blocked_dialog.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7760d7da41ec887bd03ce951f522135eb071cd37
--- /dev/null
+++ b/chrome/browser/ui/extensions/aside_theme_install_blocked_dialog.cc
@@ -0,0 +1,45 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Aside refuses theme installs from the Chrome Web Store. Replica of the
+// original's helper in
+// chrome/browser/extensions/api/webstore_private/webstore_private_api.cc
+// (825.1 framework region 0x07f8e140-0x07f90d30): the tail call at the top of
+// WebstorePrivateBeginInstallWithManifest3Function::ShowInstallDialog() when
+// dummy_extension_->manifest()->type() == Manifest::TYPE_THEME builds a
+// ui::DialogModel with the __ustring literals "Theme installation failed" and
+// "Aside browser does not support themes." plus an "OK" button, shows it with
+// chrome::ShowTabModal(), and answers the API from the dialog-destroying
+// callback.
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/ui/dialogs/browser_dialogs.h"
+#include "chrome/browser/ui/extensions/extensions_dialogs.h"
+#include "content/public/browser/browser_thread.h"
+#include "extensions/buildflags/buildflags.h"
+#include "ui/base/models/dialog_model.h"
+
+static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
+
+namespace extensions {
+
+void ShowAsideThemeInstallBlockedDialog(content::WebContents* web_contents,
+                                        base::OnceClosure done_callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  // The original hard-codes these three strings (they are not in the .pak).
+  ui::DialogModel::Builder dialog_builder;
+  dialog_builder.SetTitle(u"Theme installation failed")
+      .AddParagraph(
+          ui::DialogModelLabel(u"Aside browser does not support themes."))
+      .AddOkButton(base::DoNothing(),
+                   ui::DialogModel::Button::Params().SetLabel(u"OK"))
+      .SetDialogDestroyingCallback(std::move(done_callback));
+
+  chrome::ShowTabModal(dialog_builder.Build(), web_contents);
+}
+
+}  // namespace extensions
