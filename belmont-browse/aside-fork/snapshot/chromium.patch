+protocol::Response BrowserHandler::SetAiTabsMetadata(
+    const std::string& target_id,
+    std::optional<std::string> badge_label,
+    std::optional<std::string> initial_origin) {
+  if (!secure_session_) {
+    return protocol::Response::ServerError(
