+class ReadingListSidePanelCoordinatorUnitTest : public testing::Test {
+ public:
+  void SetUp() override {
+    source_profile_ = TestingProfile::Builder().Build();
+    target_profile_ = TestingProfile::Builder().Build();
+    tab_strip_model_delegate_ = std::make_unique<TestTabStripModelDelegate>();
+    tab_strip_model_ = std::make_unique<TabStripModel>(
+        tab_strip_model_delegate_.get(), source_profile_.get());
+    browser_window_interface_ = std::make_unique<MockBrowserWindowInterface>();
+    // SidePanelRegistry::Deregister() consults the window features; a default
+    // container (side_panel_ui() == nullptr) is the supported test-window path.
+    ON_CALL(*browser_window_interface_, GetFeatures())
+        .WillByDefault(::testing::ReturnRef(browser_window_features_));
+    registry_ = std::make_unique<SidePanelRegistry>(
+        browser_window_interface_.get());
+    coordinator_ = std::make_unique<ReadingListSidePanelCoordinator>(
+        browser_window_interface_.get(), source_profile_.get(),
+        tab_strip_model_.get());
+  }
+
+ protected:
+  content::BrowserTaskEnvironment task_environment_;
+  std::unique_ptr<TestingProfile> source_profile_;
+  std::unique_ptr<TestingProfile> target_profile_;
+  std::unique_ptr<TestTabStripModelDelegate> tab_strip_model_delegate_;
+  std::unique_ptr<TabStripModel> tab_strip_model_;
+  // Declared before the mock, registry and coordinator so it outlives them.
+  BrowserWindowFeatures browser_window_features_;
+  std::unique_ptr<MockBrowserWindowInterface> browser_window_interface_;
+  std::unique_ptr<SidePanelRegistry> registry_;
+  std::unique_ptr<ReadingListSidePanelCoordinator> coordinator_;
+};
+
+TEST_F(ReadingListSidePanelCoordinatorUnitTest,
+       RebindReplacesRegisteredEntryAndInvalidatesSourceCallback) {
+  const SidePanelEntry::Key key(SidePanelEntry::Id::kReadingList);
+  coordinator_->CreateAndRegisterEntry(registry_.get());
+  auto* source_entry = registry_->GetEntryForKey(key);
+  ASSERT_TRUE(source_entry);
+  auto source_entry_weak = source_entry->GetWeakPtr();
+
+  coordinator_->RebindProfileForAside(target_profile_.get(), registry_.get());
+
+  // The rebind destroys the source entry object (its weak pointer is
+  // invalidated) and registers exactly one fresh entry under the key. Raw
+  // pointer inequality is deliberately not asserted: the allocator may reuse
+  // the freed address for the replacement entry.
+  EXPECT_FALSE(source_entry_weak);
+  auto* target_entry = registry_->GetEntryForKey(key);
+  ASSERT_TRUE(target_entry);
+  EXPECT_TRUE(target_entry->GetWeakPtr());
+  EXPECT_EQ(1u, registry_->entries().size());
+}
+
+TEST_F(ReadingListSidePanelCoordinatorUnitTest,
+       RebindPreservesUnregisteredState) {
+  const SidePanelEntry::Key key(SidePanelEntry::Id::kReadingList);
+  EXPECT_FALSE(registry_->GetEntryForKey(key));
+
+  coordinator_->RebindProfileForAside(target_profile_.get(), registry_.get());
+
+  EXPECT_FALSE(registry_->GetEntryForKey(key));
+}
+
+}  // namespace
