+TabDragTarget* VerticalTabStripRegionView::GetTabDragTarget(
+    const gfx::Point& point_in_screen) {
+  if (const auto* button = GetToolbarCollapseButton();
+      button && button->IsDrawn()) {
+    // Native tab drags query targets rather than dispatching MouseEntered to
+    // the toolbar button. Reveal the same preview before resolving the target.
+    OnToolbarCollapseButtonHoverChanged(
+        button->GetBoundsInScreen().Contains(point_in_screen));
+  }
+  if (tab_strip_view_ && drag_handler_ &&
+      (!drag_handler_->IsDragging() || drag_handler_->IsDraggingPinnedTabs()) &&
+      aside_pinned_tabs_->IsDrawn() &&
+      aside_pinned_tabs_->GetBoundsInScreen().Contains(point_in_screen)) {
+    if (auto* pinned = GetPinnedTabsContainer()) {
+      return &pinned->GetTabDragTarget(point_in_screen);
+    }
+  }
+  if (auto* native_target =
+          BaseTabStripRegionView::GetTabDragTarget(point_in_screen)) {
+    return native_target;
+  }
+  // The path from Tabs to Bookmarks crosses Chats and section headers. Keep
+  // tabs attached through that corridor, but only Bookmarks accepts the drop.
+  if (CanKeepNativeTabDragInSidebar(point_in_screen)) {
+    return aside_bookmarks_;
+  }
+  return nullptr;
+}
