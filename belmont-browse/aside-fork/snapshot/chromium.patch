+         aside::ProfileIndicatorIcons()) {
+      if (column % kIconPickerColumns == 0) {
+        auto new_row = std::make_unique<views::BoxLayoutView>();
+        new_row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+        new_row->SetBetweenChildSpacing(2);
