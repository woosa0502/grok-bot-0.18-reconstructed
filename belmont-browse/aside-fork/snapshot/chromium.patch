+void VerticalTabStripStateController::RebindForAsideProfileSwitch(
+    Profile* profile) {
+  CHECK(profile);
+  PrefService* const pref_service = profile->GetPrefs();
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfile(profile);
+  if (pref_service == pref_service_ && session_service == session_service_) {
+    return;
+  }
+
+  // Detach every source-profile callback before changing any captured pointer.
+  pref_change_registrar_.Reset();
+  if (session_service_) {
+    session_service_->RemoveObserver(this);
+  }
+
+  pref_service_ = pref_service;
+  session_service_ = session_service;
+
+  pref_change_registrar_.Init(pref_service_);
+  pref_change_registrar_.Add(
+      prefs::kVerticalTabsEnabled,
+      base::BindRepeating(&VerticalTabStripStateController::OnModeChanged,
+                          base::Unretained(this)));
+  if (IsVerticalTabsExpandOnHoverFeatureEnabled()) {
+    pref_change_registrar_.Add(
+        prefs::kVerticalTabsExpandOnHoverEnabled,
+        base::BindRepeating(
+            &VerticalTabStripStateController::OnExpandOnHoverEnabledChanged,
+            base::Unretained(this)));
+  }
+  if (session_service_) {
+    session_service_->AddObserver(this);
+  }
+
+  const bool target_vertical_tabs_enabled =
+      pref_service_->GetBoolean(prefs::kVerticalTabsEnabled);
+  const bool mode_changed =
+      enable_state_lock_count_ == 0 &&
+      target_vertical_tabs_enabled != is_vertical_tabs_enabled_;
+  if (mode_changed) {
+    NotifyModeWillChange();
+    is_vertical_tabs_enabled_ = target_vertical_tabs_enabled;
+    NotifyModeChanged();
+  }
+
+  const bool target_expand_on_hover_enabled =
+      IsVerticalTabsExpandOnHoverFeatureEnabled() &&
+      pref_service_->GetBoolean(prefs::kVerticalTabsExpandOnHoverEnabled);
+  if (target_expand_on_hover_enabled != is_expand_on_hover_enabled_) {
+    is_expand_on_hover_enabled_ = target_expand_on_hover_enabled;
+    NotifyExpandOnHoverEnabledChanged();
+  }
+
+  const bool target_collapsed =
+      pref_service_->GetBoolean(prefs::kVerticalTabsCollapsedState);
+  const int target_uncollapsed_width =
+      pref_service_->GetInteger(prefs::kVerticalTabsUncollapsedWidth);
+  if (state_.collapsed != target_collapsed ||
+      state_.uncollapsed_width != target_uncollapsed_width) {
+    state_.collapsed = target_collapsed;
+    state_.uncollapsed_width = target_uncollapsed_width;
+    // Import destination preferences without writing session state before
+    // its parked tabs and window metadata have been restored.
+    on_collapse_changed_callback_list_.Notify(GetCollapseState());
+    UpdateCollapseActionItem();
+  } else {
+    UpdateCollapseActionItem();
+  }
+}
