+  EXPECT_FALSE(aside::IsAgentTabsGroup(&replacement));
+  aside::RecordAgentTabsAssignment(&replacement, aside::kAsideExtensionId);
+  aside::ConfirmAgentTabsAssignment(&replacement, aside::kAsideExtensionId,
+                                    u"Agent Tabs");
+  EXPECT_TRUE(aside::IsAgentTabsGroup(&replacement));
+  aside::ClearAiTabsMetadata(id);
+}
