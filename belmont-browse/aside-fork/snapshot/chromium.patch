index 0000000000000000000000000000000000000000..5c8321ef63a23023855302cc9575ccf695557470
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_engine.cc
@@ -0,0 +1,1712 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_engine.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "base/json/json_reader.h"
+#include "base/pickle.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/browser/aside_adblock/aside_adblock_procedural.h"
+#include "chrome/browser/aside_adblock/aside_adblock_resources.h"
+#include "chrome/browser/aside_adblock/aside_adblock_redirect_resources.h"
+#include "components/subresource_filter/core/common/first_party_origin.h"
+#include "components/subresource_filter/core/common/indexed_ruleset.h"
+#include "components/subresource_filter/core/common/load_policy.h"
+#include "components/subresource_filter/tools/rule_parser/rule.h"
+#include "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#include "components/url_pattern_index/flat/url_pattern_index_generated.h"
+#include "components/url_pattern_index/url_pattern_index.h"
+#include "crypto/hash.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace aside_adblock {
+
+using url_pattern_index::proto::ElementType;
+using Bucket = PreprocessedRule::Bucket;
+
+// A side index: one RulesetIndexer + matcher for rules whose option was
+// rewritten by the preprocessor.
+struct Engine::SideIndex {
+  explicit SideIndex(uint64_t id)
+      : indexer(std::make_unique<subresource_filter::RulesetIndexer>(id)) {}
+  ~SideIndex() = default;
+
+  bool Add(const url_pattern_index::proto::UrlRule& rule) {
+    if (!indexer->AddUrlRule(rule)) {
+      return false;
+    }
+    ++count;
+    return true;
+  }
+  void Finish() {
+    indexer->Finish();
+    if (count > 0) {
+      matcher = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          indexer->data());
+    }
+  }
+  // Deserialized form: owns the index bytes instead of an indexer.
+  void Load(base::span<const uint8_t> bytes, int rule_count) {
+    indexer.reset();
+    loaded.assign(bytes.begin(), bytes.end());
+    count = rule_count;
+    if (count > 0) {
+      matcher = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          base::span<const uint8_t>(loaded));
+    }
+  }
+  base::span<const uint8_t> data() const {
+    return indexer ? indexer->data() : base::span<const uint8_t>(loaded);
+  }
+  size_t size() const { return data().size(); }
+
+  std::unique_ptr<subresource_filter::RulesetIndexer> indexer;
+  std::vector<uint8_t> loaded;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> matcher;
+  int count = 0;
+};
+
+// Metadata belongs to a complete rule, never just its URL pattern. Multiple
+// rules with the same pattern can have different domains, types and modifiers.
+// A separate all-match index keeps matching efficient while retaining identity.
+struct Engine::MetadataRule {
+  url_pattern_index::proto::UrlRule proto;
+  PreprocessedRule options;
+  bool document_rule = false;
+  RuleInfo info;
+};
+
+struct Engine::MetadataIndex {
+  MetadataIndex() : builder(&buffer) {}
+
+  bool Add(MetadataRule rule) {
+    auto offset = url_pattern_index::SerializeUrlRule(
+        rule.proto, &buffer, &domains);
+    if (offset.IsNull()) {
+      return false;
+    }
+    builder.IndexUrlRule(offset);
+    offsets.push_back(offset);
+    rules.push_back(std::move(rule));
+    return true;
+  }
+
+  void Finish() {
+    buffer.Finish(builder.Finish());
+    matcher = std::make_unique<url_pattern_index::UrlPatternIndexMatcher>(
+        flatbuffers::GetRoot<url_pattern_index::flat::UrlPatternIndex>(
+            buffer.GetBufferPointer()));
+    for (size_t i = 0; i < offsets.size(); ++i) {
+      const auto* rule = flatbuffers::GetTemporaryPointer(buffer, offsets[i]);
+      identities.emplace(rule, i);
+    }
+  }
+
+  std::vector<const MetadataRule*> Matches(
+      const GURL& url,
+      const url::Origin& initiator,
+      const subresource_filter::FirstPartyOrigin& first_party,
+      ElementType element_type) const {
+    std::vector<const MetadataRule*> matches;
+    if (!matcher) {
+      return matches;
+    }
+    for (const auto* hit : matcher->FindAllMatches(
+             url, initiator, element_type,
+             url_pattern_index::proto::ACTIVATION_TYPE_UNSPECIFIED,
+             first_party.IsThirdParty(url), false, {}, {})) {
+      auto found = identities.find(hit);
+      if (found != identities.end()) {
+        matches.push_back(&rules[found->second]);
+      }
+    }
+    return matches;
+  }
+
+  flatbuffers::FlatBufferBuilder buffer;
+  url_pattern_index::FlatDomainMap domains;
+  url_pattern_index::UrlPatternIndexBuilder builder;
+  std::vector<url_pattern_index::UrlRuleOffset> offsets;
+  std::vector<MetadataRule> rules;
+  std::unordered_map<const url_pattern_index::flat::UrlRule*, size_t> identities;
+  std::unique_ptr<url_pattern_index::UrlPatternIndexMatcher> matcher;
+};
+
+struct Engine::RegexRule {
+  std::unique_ptr<re2::RE2> re;
+  url_pattern_index::proto::UrlRule proto;  // options only
+  bool document_rule = false;
+  Bucket bucket = Bucket::kMain;
+  std::string redirect;
+  std::string redirect_directive;
+  int redirect_priority = 0;
+  RuleInfo info;
+};
+
+namespace {
+
+// Options that only make sense for whole-document navigations. Rules carrying
+// them are indexed into the document rule set with the option rewritten to
+// "subdocument", which the parser understands.
+bool ExtractDocumentRule(std::string_view line, std::string* rewritten) {
+  size_t dollar = line.rfind('$');
+  if (dollar == std::string_view::npos || line.starts_with("@@")) {
+    return false;
+  }
+  std::string_view options = line.substr(dollar + 1);
+  std::vector<std::string> parts = base::SplitString(
+      options, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  bool has_document = false;
+  for (auto& part : parts) {
+    if (part == "document" || part == "doc") {
+      part = "subdocument";
+      has_document = true;
+    }
+  }
+  if (!has_document) {
+    return false;
+  }
+  *rewritten = std::string(line.substr(0, dollar + 1)) +
+               base::JoinString(parts, ",");
+  return true;
+}
+
+
+// $badfilter targets the rule with the option removed, independent of source
+// order and option/domain ordering. Keep all other matcher/modifier conditions
+// in the identity; a cancellation for one domain must not disable another.
+std::string NetworkRuleKey(url_pattern_index::proto::UrlRule proto,
+                           const PreprocessedRule& options,
+                           bool document_rule) {
+  auto normalize_domains = [](auto* domains) {
+    std::vector<std::pair<std::string, bool>> ordered;
+    for (const auto& domain : *domains) {
+      ordered.emplace_back(base::ToLowerASCII(domain.domain()), domain.exclude());
+    }
+    std::sort(ordered.begin(), ordered.end());
+    ordered.erase(std::unique(ordered.begin(), ordered.end()), ordered.end());
+    domains->Clear();
+    for (const auto& [name, excluded] : ordered) {
+      auto* domain = domains->Add();
+      domain->set_domain(name);
+      domain->set_exclude(excluded);
+    }
+  };
+  normalize_domains(proto.mutable_initiator_domains());
+  normalize_domains(proto.mutable_request_domains());
+  if (!proto.match_case()) {
+    proto.set_url_pattern(base::ToLowerASCII(proto.url_pattern()));
+  }
+  base::Pickle key;
+  key.WriteString(proto.SerializeAsString());
+  key.WriteInt(static_cast<int>(options.bucket));
+  key.WriteString(options.regex);
+  key.WriteString(options.redirect_directive);
+  key.WriteString(options.csp);
+  key.WriteString(options.method);
+  key.WriteBool(options.important);
+  key.WriteBool(document_rule);
+  return std::string(reinterpret_cast<const char*>(key.data()), key.size());
+}
+
+std::string PatternOf(const url_pattern_index::flat::UrlRule* rule) {
+  return rule && rule->url_pattern() ? rule->url_pattern()->str()
+                                     : std::string();
+}
+
+std::string DataUrl(const Resource& res) {
+  return "data:" + res.mime + ";base64," + base::Base64Encode(res.body);
+}
+
+}  // namespace
+
+ElementType ElementTypeForDestination(
+    network::mojom::RequestDestination destination) {
+  using D = network::mojom::RequestDestination;
+  switch (destination) {
+    case D::kScript:
+    case D::kServiceWorker:
+    case D::kSharedWorker:
+    case D::kWorker:
+    case D::kAudioWorklet:
+    case D::kPaintWorklet:
+    case D::kJson:
+    case D::kWebBundle:
+    case D::kSpeculationRules:
+      return ElementType::ELEMENT_TYPE_SCRIPT;
+    case D::kImage:
+      return ElementType::ELEMENT_TYPE_IMAGE;
+    case D::kStyle:
+    case D::kXslt:
+      return ElementType::ELEMENT_TYPE_STYLESHEET;
+    case D::kFont:
+      return ElementType::ELEMENT_TYPE_FONT;
+    case D::kAudio:
+    case D::kVideo:
+    case D::kTrack:
+      return ElementType::ELEMENT_TYPE_MEDIA;
+    case D::kObject:
+    case D::kEmbed:
+      return ElementType::ELEMENT_TYPE_OBJECT;
+    case D::kIframe:
+    case D::kFrame:
+    case D::kFencedframe:
+    case D::kDocument:
+      return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+    case D::kReport:
+      return ElementType::ELEMENT_TYPE_PING;
+    case D::kEmpty:
+      return ElementType::ELEMENT_TYPE_XMLHTTPREQUEST;
+    default:
+      return ElementType::ELEMENT_TYPE_OTHER;
+  }
+}
+
+ElementType ElementTypeForName(const std::string& name, bool* is_document) {
+  *is_document = false;
+  std::string n = base::ToLowerASCII(name);
+  if (n == "script") {
+    return ElementType::ELEMENT_TYPE_SCRIPT;
+  }
+  if (n == "image" || n == "img") {
+    return ElementType::ELEMENT_TYPE_IMAGE;
+  }
+  if (n == "stylesheet" || n == "css") {
+    return ElementType::ELEMENT_TYPE_STYLESHEET;
+  }
+  if (n == "font") {
+    return ElementType::ELEMENT_TYPE_FONT;
+  }
+  if (n == "media" || n == "audio" || n == "video") {
+    return ElementType::ELEMENT_TYPE_MEDIA;
+  }
+  if (n == "object") {
+    return ElementType::ELEMENT_TYPE_OBJECT;
+  }
+  if (n == "subdocument" || n == "sub_frame" || n == "frame" || n == "iframe") {
+    return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+  }
+  if (n == "document" || n == "main_frame") {
+    *is_document = true;
+    return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+  }
+  if (n == "xmlhttprequest" || n == "xhr" || n == "fetch") {
+    return ElementType::ELEMENT_TYPE_XMLHTTPREQUEST;
+  }
+  if (n == "websocket") {
+    return ElementType::ELEMENT_TYPE_WEBSOCKET;
+  }
+  if (n == "ping" || n == "beacon") {
+    return ElementType::ELEMENT_TYPE_PING;
+  }
+  return ElementType::ELEMENT_TYPE_OTHER;
+}
+
+Engine::Engine(const EngineOptions& options)
+    : max_invalid_lines_(options.max_invalid_lines_per_source),
+      indexer_(std::make_unique<subresource_filter::RulesetIndexer>(1)),
+      document_indexer_(
+          std::make_unique<subresource_filter::RulesetIndexer>(2)),
+      popup_(std::make_unique<SideIndex>(3)),
+      generichide_(std::make_unique<SideIndex>(4)),
+      elemhide_(std::make_unique<SideIndex>(5)),
+      important_(std::make_unique<SideIndex>(6)),
+      important_document_(std::make_unique<SideIndex>(7)),
+      metadata_(std::make_unique<MetadataIndex>()) {
+  LoadResources(options.resources_json);
+}
+
+Engine::~Engine() = default;
+
+// static
+scoped_refptr<Engine> Engine::Build(const std::vector<FilterSource>& sources) {
+  return BuildWithOptions(sources, EngineOptions());
+}
+
+// static
+scoped_refptr<Engine> Engine::BuildWithOptions(
+    const std::vector<FilterSource>& sources,
+    const EngineOptions& options) {
+  scoped_refptr<Engine> engine(new Engine(options));
+  // Collect cancellations across every source before indexing any target.
+  subresource_filter::RuleParser cancellation_parser;
+  for (const FilterSource& source : sources) {
+    for (std::string_view raw : base::SplitStringPiece(
+             source.text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+      if (base::ToLowerASCII(raw).find("badfilter") == std::string::npos) {
+        continue;
+      }
+      const PreprocessedRule pre = PreprocessNetworkRule(raw);
+      if (!pre.is_network || !pre.badfilter) {
+        continue;
+      }
+      std::string rewritten;
+      const bool document_rule = ExtractDocumentRule(pre.line, &rewritten);
+      if (cancellation_parser.Parse(document_rule ? rewritten : pre.line) ==
+          url_pattern_index::proto::RULE_TYPE_URL) {
+        engine->disabled_network_rules_.insert(NetworkRuleKey(
+            cancellation_parser.url_rule().ToProtobuf(), pre, document_rule));
+      }
+    }
+  }
+  for (const FilterSource& source : sources) {
+    engine->AddSource(source);
+  }
+  engine->Finish();
+  return engine;
+}
+
+void Engine::LoadResources(const std::string& json) {
+  for (const BuiltinResource& r : kBuiltinResources) {
+    resources_[std::string(r.name)] =
+        Resource{std::string(r.mime), std::string(r.body)};
+  }
+  for (const std::string_view source :
+       {kBundledRedirectResourcesJson, std::string_view(json)}) {
+    if (source.empty()) {
+      continue;
+    }
+    // adblock-rust resources.json: [{name, aliases:[...], kind:{mime},
+    // content:<base64>}]
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(source, base::JSON_PARSE_RFC);
+    if (!parsed || !parsed->is_list()) {
+      continue;
+    }
+    for (const base::Value& item : parsed->GetList()) {
+      if (!item.is_dict()) {
+        continue;
+      }
+      const base::DictValue& d = item.GetDict();
+      const std::string* name = d.FindString("name");
+      const std::string* content = d.FindString("content");
+      if (!name || !content) {
+        continue;
+      }
+      Resource res;
+      if (const base::DictValue* kind = d.FindDict("kind")) {
+        if (const std::string* mime = kind->FindString("mime")) {
+          res.mime = *mime;
+        }
+      }
+      if (res.mime.empty()) {
+        res.mime = "application/octet-stream";
+      }
+      std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*content);
+      if (!bytes) {
+        continue;
+      }
+      res.body.assign(bytes->begin(), bytes->end());
+      resources_[*name] = res;
+      if (const base::ListValue* aliases = d.FindList("aliases")) {
+        for (const base::Value& alias : *aliases) {
+          if (alias.is_string()) {
+            resources_[alias.GetString()] = res;
+          }
+        }
+      }
+    }
+  }
+}
+
+const Resource* Engine::FindResource(const std::string& name) const {
+  auto it = resources_.find(name);
+  if (it != resources_.end()) {
+    return &it->second;
+  }
+  // Unknown resources stay unknown. Returning a successful empty script hides
+  // missing surrogate APIs and breaks sites that depend on their callbacks.
+  return nullptr;
+}
+
+void Engine::AddSource(const FilterSource& source) {
+  SourceStats stats;
+  stats.id = source.id;
+  stats.title = source.title;
+  std::string source_label =
+      source.id == "custom"
+          ? "custom"
+          : (source.id.starts_with("manual:") ? source.id
+                                              : "subscription:" + source.title);
+  auto invalid = [&](size_t line_no, const std::string& line,
+                     std::string_view why) {
+    ++stats.parse_error_count;
+    if (stats.invalid_lines.size() < max_invalid_lines_) {
+      stats.invalid_lines.push_back(base::NumberToString(line_no) + ": " +
+                                    line + " (" + std::string(why) + ")");
+    }
+  };
+
+  subresource_filter::RuleParser parser;
+  size_t line_no = 0;
+  for (std::string_view raw : base::SplitStringPiece(
+           source.text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    ++line_no;
+    if (raw.empty() || raw[0] == '!' || raw[0] == '[') {
+      continue;
+    }
+    std::string line(raw);
+    std::string cosmetic_line = line;
+    const CosmeticKind cosmetic = NormalizeCosmeticRule(&cosmetic_line);
+    if (cosmetic == CosmeticKind::kUnsupported) {
+      invalid(line_no, line, "unsupported feature");
+      continue;
+    }
+    // Chromium's style RuleParser rejects every ~domain before returning a
+    // StyleRule. Own the domain prefix here and let it parse only the selector
+    // and exception delimiter; the engine already supports include/exclude.
+    std::vector<std::string> cosmetic_domains;
+    if (cosmetic != CosmeticKind::kNotCosmetic &&
+        !ExtractCosmeticDomains(&cosmetic_line, &cosmetic_domains)) {
+      invalid(line_no, line, "malformed cosmetic domain prefix");
+      continue;
+    }
+    PreprocessedRule pre;
+    if (cosmetic == CosmeticKind::kNotCosmetic) {
+      pre = PreprocessNetworkRule(line);
+    }
+    std::string rewritten;
+    bool document_rule = false;
+    if (pre.is_network) {
+      document_rule = ExtractDocumentRule(pre.line, &rewritten);
+    }
+    const std::string& to_parse =
+        pre.is_network ? (document_rule ? rewritten : pre.line)
+                       : cosmetic_line;
+    url_pattern_index::proto::RuleType type = parser.Parse(to_parse);
+    switch (type) {
+      case url_pattern_index::proto::RULE_TYPE_URL: {
+        url_pattern_index::proto::UrlRule proto =
+            parser.url_rule().ToProtobuf();
+        RuleInfo info{line, source_label};
+        if (pre.badfilter ||
+            (!disabled_network_rules_.empty() && disabled_network_rules_.contains(
+                NetworkRuleKey(proto, pre, document_rule)))) {
+          ++stats.network_rule_count;  // valid instruction, intentionally unindexed
+          break;
+        }
+        if (pre.is_regex) {
+          if (pre.bucket != Bucket::kMain && pre.bucket != Bucket::kImportant &&
+              pre.bucket != Bucket::kPopup) {
+            invalid(line_no, line, "regex with unsupported option");
+            break;
+          }
+          re2::RE2::Options opts;
+          opts.set_case_sensitive(proto.match_case());
+          opts.set_log_errors(false);
+          auto re = std::make_unique<re2::RE2>(pre.regex, opts);
+          if (!re->ok()) {
+            invalid(line_no, line, "regex unsupported: " + re->error());
+            break;
+          }
+          auto rule = std::make_unique<RegexRule>();
+          rule->re = std::move(re);
+          rule->proto = proto;
+          rule->document_rule = document_rule;
+          rule->bucket = pre.bucket;
+          rule->redirect = pre.redirect;
+          rule->redirect_directive = pre.redirect_directive;
+          rule->redirect_priority = pre.redirect_priority;
+          rule->info = info;
+          regex_patterns_.push_back(pre.regex);
+          if (pre.bucket == Bucket::kPopup) {
+            ++popup_rule_count_;
+          }
+          regex_rules_.push_back(std::move(rule));
+          ++stats.network_rule_count;
+          break;
+        }
+        bool ok = false;
+        switch (pre.bucket) {
+          case Bucket::kMain:
+            ok = document_rule ? document_indexer_->AddUrlRule(proto)
+                               : indexer_->AddUrlRule(proto);
+            break;
+          case Bucket::kPopup:
+            ok = popup_->Add(proto);
+            if (ok) {
+              ++popup_rule_count_;
+            }
+            break;
+          case Bucket::kGenericHide:
+            ok = generichide_->Add(proto);
+            break;
+          case Bucket::kElemHide:
+            ok = elemhide_->Add(proto);
+            break;
+          case Bucket::kImportant:
+            ok = document_rule ? important_document_->Add(proto)
+                               : important_->Add(proto);
+            break;
+          case Bucket::kRedirectRule:
+            // adblock-rust also places redirect exceptions in its ordinary
+            // exception list. They allow a non-important matching block, not
+            // merely select another redirect. Method-qualified exceptions are
+            // handled below without stripping the method condition.
+            ok = true;
+            if (proto.semantics() ==
+                    url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST &&
+                pre.method.empty()) {
+              ok = document_rule ? document_indexer_->AddUrlRule(proto)
+                                 : indexer_->AddUrlRule(proto);
+            }
+            break;
+          case Bucket::kCsp:
+          case Bucket::kMethod:
+            ok = true;  // Indexed below with complete modifier metadata.
+            break;
+        }
+        if (ok && (pre.bucket == Bucket::kCsp ||
+                   pre.bucket == Bucket::kMethod ||
+                   pre.bucket == Bucket::kRedirectRule ||
+                   !pre.redirect.empty())) {
+          ok = metadata_->Add({proto, pre, document_rule, info});
+          if (ok && pre.bucket == Bucket::kCsp) {
+            ++csp_rule_count_;
+          }
+        }
+        if (!ok) {
+          invalid(line_no, line, "not indexable");
+          break;
+        }
+        ++stats.network_rule_count;
+        rules_by_identity_.insert_or_assign(RuleIdentityKey(proto),
+                                            std::move(info));
+        break;
+      }
+      case url_pattern_index::proto::RULE_TYPE_STYLE: {
+        const subresource_filter::StyleRule& css = parser.style_rule();
+        std::string normalized;
+        std::string procedural_json;
+        const ProceduralParse parse = ParseProceduralSelector(
+            css.selector, &normalized, &procedural_json);
+        if (parse == ProceduralParse::kUnsupported) {
+          invalid(line_no, line, "unsupported selector");
+          break;
+        }
+        if (parse == ProceduralParse::kProcedural) {
+          ++stats.cosmetic_rule_count;
+          ProceduralRule rule;
+          rule.is_exception = css.is_allowlist;
+          rule.json = std::move(procedural_json);
+          for (const std::string& domain : cosmetic_domains) {
+            if (domain.starts_with("~")) {
+              rule.exclude.push_back(domain.substr(1));
+            } else {
+              rule.include.push_back(domain);
+            }
+          }
+          procedural_rules_.push_back(std::move(rule));
+          ++procedural_rule_count_;
+          break;
+        }
+        CosmeticRule rule;
+        rule.selector = normalized;
+        rule.is_exception = css.is_allowlist;
+        for (const std::string& domain : cosmetic_domains) {
+          if (domain.starts_with("~")) {
+            rule.exclude.push_back(domain.substr(1));
+          } else {
+            rule.include.push_back(domain);
+          }
+        }
+        ++stats.cosmetic_rule_count;
+        if (!rule.is_exception && rule.include.empty() &&
+            rule.exclude.empty()) {
+          generic_selectors_.push_back(rule.selector);
+        } else {
+          conditional_rules_.push_back(std::move(rule));
+        }
+        break;
+      }
+      case url_pattern_index::proto::RULE_TYPE_COMMENT:
+        break;
+      default: {
+        const auto& err = parser.parse_error();
+        std::string why;
+        switch (err.error_code) {
+          case subresource_filter::RuleParser::ParseError::UNKNOWN_OPTION:
+            why = "unknown option";
+            break;
+          case subresource_filter::RuleParser::ParseError::
+              UNSUPPORTED_FEATURE:
+            why = "unsupported feature";
+            break;
+          case subresource_filter::RuleParser::ParseError::
+              EMPTY_CSS_SELECTOR:
+            why = "empty selector";
+            break;
+          case subresource_filter::RuleParser::ParseError::DEPRECATED_OPTION:
+            why = "deprecated option";
+            break;
+          default:
+            why = "parse error";
+        }
+        invalid(line_no, line, why);
+        break;
+      }
+    }
+  }
+  network_rule_count_ += stats.network_rule_count;
+  cosmetic_rule_count_ += stats.cosmetic_rule_count;
+  parse_error_count_ += stats.parse_error_count;
+  sources_.push_back(std::move(stats));
+}
+
+void Engine::Finish() {
+  FinishIndexes();
+  BuildCosmeticTables();
+}
+
+void Engine::FinishIndexes() {
+  indexer_->Finish();
+  document_indexer_->Finish();
+  flatbuffer_size_ = indexer_->data().size() + document_indexer_->data().size();
+  matcher_ = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+      indexer_->data());
+  document_matcher_ =
+      std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          document_indexer_->data());
+  for (SideIndex* side : {popup_.get(), generichide_.get(), elemhide_.get(),
+                          important_.get(), important_document_.get()}) {
+    side->Finish();
+    flatbuffer_size_ += side->size();
+  }
+  metadata_->Finish();
+  flatbuffer_size_ += metadata_->buffer.GetSize();
+}
+
+void Engine::BuildCosmeticTables() {
+  // Exceptions without domains remove generic selectors outright.
+  base::flat_set<std::string> generic_exceptions;
+  for (const CosmeticRule& rule : conditional_rules_) {
+    if (rule.is_exception && rule.include.empty() && rule.exclude.empty()) {
+      generic_exceptions.insert(rule.selector);
+    }
+  }
+  if (!generic_exceptions.empty()) {
+    std::erase_if(generic_selectors_, [&](const std::string& s) {
+      return generic_exceptions.contains(s);
+    });
+  }
+  generic_stylesheet_.clear();
+  if (!generic_selectors_.empty()) {
+    generic_stylesheet_ =
+        base::JoinString(generic_selectors_, ",\n") + "{display:none!important;}\n";
+  }
+  // Key generic selectors by their leading .class / #id (the cosmetic script
+  // asks for those by the classes/ids it sees); the rest ship with the page.
+  generic_by_class_.clear();
+  generic_by_id_.clear();
+  generic_misc_.clear();
+  for (const std::string& selector : generic_selectors_) {
+    if (selector.size() < 2 || (selector[0] != '.' && selector[0] != '#')) {
+      generic_misc_.push_back(selector);
+      continue;
+    }
+    size_t end = 1;
+    while (end < selector.size()) {
+      const char c = selector[end];
+      if (base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_' ||
+          static_cast<unsigned char>(c) >= 0x80) {
+        ++end;
+      } else if (c == '\\') {
+        end += 2;
+      } else {
+        break;
+      }
+    }
+    if (end > selector.size()) {
+      end = selector.size();
+    }
+    const std::string key = selector.substr(1, end - 1);
+    if (key.empty() || key.find('\\') != std::string::npos) {
+      generic_misc_.push_back(selector);
+    } else if (selector[0] == '.') {
+      generic_by_class_[key].push_back(selector);
+    } else {
+      generic_by_id_[key].push_back(selector);
+    }
+  }
+}
+
+// ---- cache -----------------------------------------------------------------
+
+namespace {
+
+// Bump whenever parsing/indexing changes: the cache digest only covers the
+// inputs, so a stale engine0/1.dat would otherwise be reused by a new build.
+constexpr uint32_t kCacheVersion = 7;
+
+std::string HexSha256(std::string_view data) {
+  return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(data)));
+}
+
+void WriteStrings(base::Pickle* pickle, const std::vector<std::string>& v) {
+  pickle->WriteUInt32(static_cast<uint32_t>(v.size()));
+  for (const std::string& s : v) {
+    pickle->WriteString(s);
+  }
+}
+
+bool ReadStrings(base::PickleIterator* it, std::vector<std::string>* v) {
+  uint32_t n = 0;
+  if (!it->ReadUInt32(&n)) {
+    return false;
+  }
+  v->clear();
+  v->reserve(n);
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string s;
+    if (!it->ReadString(&s)) {
+      return false;
+    }
+    v->push_back(std::move(s));
+  }
+  return true;
+}
+
+}  // namespace
+
+// static
+std::string Engine::SourceDigest(const std::vector<FilterSource>& sources,
+                                 const std::string& resources_json) {
+  std::string acc;
+  for (const FilterSource& s : sources) {
+    acc += s.id + "\n" + s.title + "\n" + HexSha256(s.text) + "\n";
+  }
+  acc += "resources:" + HexSha256(resources_json) + "\n";
+  acc += "version:" + base::NumberToString(kCacheVersion);
+  return HexSha256(acc);
+}
+
+// static
+std::string Engine::CachedSourceDigest(const std::string& bytes) {
+  base::Pickle pickle = base::Pickle::WithUnownedBuffer(base::as_byte_span(bytes));
+  base::PickleIterator it(pickle);
+  uint32_t version = 0;
+  std::string digest;
+  if (!it.ReadUInt32(&version) || version != kCacheVersion ||
+      !it.ReadString(&digest)) {
+    return std::string();
+  }
+  return digest;
+}
+
+std::string Engine::Serialize(const std::string& source_digest) const {
+  base::Pickle body;
+  // Stats.
+  body.WriteUInt32(static_cast<uint32_t>(sources_.size()));
+  for (const SourceStats& s : sources_) {
+    body.WriteString(s.id);
+    body.WriteString(s.title);
+    body.WriteInt(s.network_rule_count);
+    body.WriteInt(s.cosmetic_rule_count);
+    body.WriteInt(s.parse_error_count);
+    WriteStrings(&body, s.invalid_lines);
+  }
+  body.WriteUInt64(static_cast<uint64_t>(flatbuffer_size_));
+  body.WriteInt(network_rule_count_);
+  body.WriteInt(cosmetic_rule_count_);
+  body.WriteInt(parse_error_count_);
+  body.WriteInt(csp_rule_count_);
+  body.WriteInt(popup_rule_count_);
+  body.WriteInt(procedural_rule_count_);
+  // Indexes.
+  body.WriteData(indexer_ ? indexer_->data()
+                          : base::span<const uint8_t>(loaded_main_));
+  body.WriteData(document_indexer_
+                     ? document_indexer_->data()
+                     : base::span<const uint8_t>(loaded_document_));
+  for (const SideIndex* side :
+       {popup_.get(), generichide_.get(), elemhide_.get(), important_.get(),
+        important_document_.get()}) {
+    body.WriteInt(side->count);
+    body.WriteData(side->data());
+  }
+  // Rule tables.
+  body.WriteUInt32(static_cast<uint32_t>(rules_by_identity_.size()));
+  for (const auto& [identity, info] : rules_by_identity_) {
+    body.WriteString(identity);
+    body.WriteString(info.text);
+    body.WriteString(info.source);
+  }
+  // Rebuild the metadata all-match index from exact protos on load. This also
+  // avoids serializing pointer identities or relying on platform addresses.
+  body.WriteUInt32(static_cast<uint32_t>(metadata_->rules.size()));
+  for (const MetadataRule& r : metadata_->rules) {
+    body.WriteString(r.proto.SerializeAsString());
+    body.WriteString(r.info.text);
+    body.WriteString(r.info.source);
+    body.WriteBool(r.document_rule);
+  }
+  body.WriteUInt32(static_cast<uint32_t>(regex_rules_.size()));
+  for (size_t i = 0; i < regex_rules_.size(); ++i) {
+    const RegexRule& r = *regex_rules_[i];
+    body.WriteString(regex_patterns_[i]);
+    body.WriteString(r.proto.SerializeAsString());
+    body.WriteBool(r.document_rule);
+    body.WriteInt(static_cast<int>(r.bucket));
+    body.WriteString(r.redirect);
+    body.WriteString(r.redirect_directive);
+    body.WriteInt(r.redirect_priority);
+    body.WriteString(r.info.text);
+    body.WriteString(r.info.source);
+  }
+  body.WriteUInt32(static_cast<uint32_t>(resources_.size()));
+  for (const auto& [name, res] : resources_) {
+    body.WriteString(name);
+    body.WriteString(res.mime);
+    body.WriteString(res.body);
+  }
+  // Cosmetic tables (keyed tables are rebuilt on load).
+  WriteStrings(&body, generic_selectors_);
+  body.WriteUInt32(static_cast<uint32_t>(conditional_rules_.size()));
+  for (const CosmeticRule& r : conditional_rules_) {
+    body.WriteString(r.selector);
+    WriteStrings(&body, r.include);
+    WriteStrings(&body, r.exclude);
+    body.WriteBool(r.is_exception);
+  }
+  body.WriteUInt32(static_cast<uint32_t>(procedural_rules_.size()));
+  for (const ProceduralRule& r : procedural_rules_) {
+    body.WriteString(r.json);
+    WriteStrings(&body, r.include);
+    WriteStrings(&body, r.exclude);
+    body.WriteBool(r.is_exception);
+  }
+
+  const std::string_view payload(reinterpret_cast<const char*>(body.data()),
+                                 body.size());
+  base::Pickle file;
+  file.WriteUInt32(kCacheVersion);
+  file.WriteString(source_digest);
+  file.WriteString(HexSha256(payload));
+  file.WriteData(payload);
+  return std::string(reinterpret_cast<const char*>(file.data()), file.size());
+}
+
+// static
+scoped_refptr<Engine> Engine::Deserialize(const std::string& bytes,
+                                          const EngineOptions& options) {
+  base::Pickle file = base::Pickle::WithUnownedBuffer(base::as_byte_span(bytes));
+  base::PickleIterator head(file);
+  uint32_t version = 0;
+  std::string digest, payload_hash;
+  if (!head.ReadUInt32(&version) || version != kCacheVersion ||
+      !head.ReadString(&digest) || !head.ReadString(&payload_hash)) {
+    return nullptr;
+  }
+  std::optional<base::span<const uint8_t>> payload = head.ReadData();
+  if (!payload) {
+    return nullptr;
+  }
+  const std::string_view payload_view(
+      reinterpret_cast<const char*>(payload->data()), payload->size());
+  if (HexSha256(payload_view) != payload_hash) {
+    return nullptr;
+  }
+  base::Pickle body = base::Pickle::WithUnownedBuffer(*payload);
+  base::PickleIterator it(body);
+
+  scoped_refptr<Engine> engine(new Engine(options));
+  Engine& e = *engine;
+  uint32_t n = 0;
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    SourceStats s;
+    if (!it.ReadString(&s.id) || !it.ReadString(&s.title) ||
+        !it.ReadInt(&s.network_rule_count) ||
+        !it.ReadInt(&s.cosmetic_rule_count) ||
+        !it.ReadInt(&s.parse_error_count) ||
+        !ReadStrings(&it, &s.invalid_lines)) {
+      return nullptr;
+    }
+    e.sources_.push_back(std::move(s));
+  }
+  uint64_t flat = 0;
+  if (!it.ReadUInt64(&flat) || !it.ReadInt(&e.network_rule_count_) ||
+      !it.ReadInt(&e.cosmetic_rule_count_) || !it.ReadInt(&e.parse_error_count_) ||
+      !it.ReadInt(&e.csp_rule_count_) || !it.ReadInt(&e.popup_rule_count_) ||
+      !it.ReadInt(&e.procedural_rule_count_)) {
+    return nullptr;
+  }
+  e.flatbuffer_size_ = static_cast<size_t>(flat);
+  std::optional<base::span<const uint8_t>> main = it.ReadData();
+  std::optional<base::span<const uint8_t>> document = it.ReadData();
+  if (!main || !document) {
+    return nullptr;
+  }
+  e.indexer_.reset();
+  e.document_indexer_.reset();
+  e.loaded_main_.assign(main->begin(), main->end());
+  e.loaded_document_.assign(document->begin(), document->end());
+  e.matcher_ = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+      base::span<const uint8_t>(e.loaded_main_));
+  e.document_matcher_ =
+      std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          base::span<const uint8_t>(e.loaded_document_));
+  for (SideIndex* side :
+       {e.popup_.get(), e.generichide_.get(), e.elemhide_.get(),
+        e.important_.get(), e.important_document_.get()}) {
+    int count = 0;
+    if (!it.ReadInt(&count)) {
+      return nullptr;
+    }
+    std::optional<base::span<const uint8_t>> data = it.ReadData();
+    if (!data) {
+      return nullptr;
+    }
+    side->Load(*data, count);
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string identity;
+    RuleInfo info;
+    if (!it.ReadString(&identity) || !it.ReadString(&info.text) ||
+        !it.ReadString(&info.source)) {
+      return nullptr;
+    }
+    e.rules_by_identity_.insert_or_assign(std::move(identity), std::move(info));
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    MetadataRule rule;
+    std::string proto_bytes;
+    if (!it.ReadString(&proto_bytes) || !it.ReadString(&rule.info.text) ||
+        !it.ReadString(&rule.info.source) || !it.ReadBool(&rule.document_rule) ||
+        !rule.proto.ParseFromString(proto_bytes)) {
+      return nullptr;
+    }
+    rule.options = PreprocessNetworkRule(rule.info.text);
+    if (!e.metadata_->Add(std::move(rule))) {
+      return nullptr;
+    }
+  }
+  e.metadata_->Finish();
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    auto rule = std::make_unique<RegexRule>();
+    std::string pattern, proto_bytes;
+    int bucket = 0;
+    if (!it.ReadString(&pattern) || !it.ReadString(&proto_bytes) ||
+        !it.ReadBool(&rule->document_rule) || !it.ReadInt(&bucket) ||
+        !it.ReadString(&rule->redirect) ||
+        !it.ReadString(&rule->redirect_directive) ||
+        !it.ReadInt(&rule->redirect_priority) || !it.ReadString(&rule->info.text) ||
+        !it.ReadString(&rule->info.source) ||
+        !rule->proto.ParseFromString(proto_bytes)) {
+      return nullptr;
+    }
+    rule->bucket = static_cast<Bucket>(bucket);
+    re2::RE2::Options opts;
+    opts.set_case_sensitive(rule->proto.match_case());
+    opts.set_log_errors(false);
+    rule->re = std::make_unique<re2::RE2>(pattern, opts);
+    if (!rule->re->ok()) {
+      return nullptr;
+    }
+    e.regex_patterns_.push_back(pattern);
+    e.regex_rules_.push_back(std::move(rule));
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  e.resources_.clear();
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string name;
+    Resource res;
+    if (!it.ReadString(&name) || !it.ReadString(&res.mime) ||
+        !it.ReadString(&res.body)) {
+      return nullptr;
+    }
+    e.resources_[name] = std::move(res);
+  }
+  if (!ReadStrings(&it, &e.generic_selectors_) || !it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    CosmeticRule r;
+    if (!it.ReadString(&r.selector) || !ReadStrings(&it, &r.include) ||
+        !ReadStrings(&it, &r.exclude) || !it.ReadBool(&r.is_exception)) {
+      return nullptr;
+    }
+    e.conditional_rules_.push_back(std::move(r));
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    ProceduralRule r;
+    if (!it.ReadString(&r.json) || !ReadStrings(&it, &r.include) ||
+        !ReadStrings(&it, &r.exclude) || !it.ReadBool(&r.is_exception)) {
+      return nullptr;
+    }
+    e.procedural_rules_.push_back(std::move(r));
+  }
+  e.BuildCosmeticTables();
+  return engine;
+}
+
+// The matcher identity of a rule: everything url_pattern_index uses to decide
+// whether the rule applies to a request. Two rules that share a URL pattern
+// but carry different domain conditions are different rules and must not
+// shadow each other in the reporting table.
+namespace {
+
+std::string JoinSortedDomains(std::vector<std::string> domains) {
+  std::sort(domains.begin(), domains.end());
+  return base::JoinString(domains, ",");
+}
+
+}  // namespace
+
+// static
+std::string Engine::RuleIdentityKey(
+    const url_pattern_index::proto::UrlRule& proto) {
+  std::vector<std::string> initiator_included;
+  std::vector<std::string> initiator_excluded;
+  for (const auto& domain : proto.initiator_domains()) {
+    (domain.exclude() ? initiator_excluded : initiator_included)
+        .push_back(base::ToLowerASCII(domain.domain()));
+  }
+  std::vector<std::string> request_included;
+  std::vector<std::string> request_excluded;
+  for (const auto& domain : proto.request_domains()) {
+    (domain.exclude() ? request_excluded : request_included)
+        .push_back(base::ToLowerASCII(domain.domain()));
+  }
+  // url_pattern_index lowercases the pattern of a rule that is not match-case
+  // when it writes the flat rule, so this side lowercases it too.
+  const std::string pattern = proto.match_case()
+                                  ? proto.url_pattern()
+                                  : base::ToLowerASCII(proto.url_pattern());
+  // proto::AnchorType reserves 0 for UNSPECIFIED; flat::AnchorType does not.
+  return base::JoinString(
+      {pattern, JoinSortedDomains(std::move(initiator_included)),
+       JoinSortedDomains(std::move(initiator_excluded)),
+       JoinSortedDomains(std::move(request_included)),
+       JoinSortedDomains(std::move(request_excluded)),
+       base::NumberToString(static_cast<int>(proto.anchor_left()) - 1),
+       base::NumberToString(static_cast<int>(proto.anchor_right()) - 1),
+       base::NumberToString(proto.semantics() ==
+                                    url_pattern_index::proto::
+                                        RULE_SEMANTICS_ALLOWLIST
+                                ? 1
+                                : 0)},
+      std::string(1, '\0'));
+}
+
+// static
+std::string Engine::RuleIdentityKey(
+    const url_pattern_index::flat::UrlRule& rule) {
+  auto collect = [](const flatbuffers::Vector<
+                     flatbuffers::Offset<flatbuffers::String>>* list) {
+    std::vector<std::string> out;
+    if (list) {
+      for (auto it = list->begin(); it != list->end(); ++it) {
+        out.push_back(base::ToLowerASCII(it->str()));
+      }
+    }
+    return out;
+  };
+  const bool allowlist =
+      (rule.options() &
+       url_pattern_index::flat::OptionFlag_IS_ALLOWLIST) != 0;
+  return base::JoinString(
+      {rule.url_pattern() ? rule.url_pattern()->str() : std::string(),
+       JoinSortedDomains(collect(rule.initiator_domains_included())),
+       JoinSortedDomains(collect(rule.initiator_domains_excluded())),
+       JoinSortedDomains(collect(rule.request_domains_included())),
+       JoinSortedDomains(collect(rule.request_domains_excluded())),
+       base::NumberToString(static_cast<int>(rule.anchor_left())),
+       base::NumberToString(static_cast<int>(rule.anchor_right())),
+       base::NumberToString(allowlist ? 1 : 0)},
+      std::string(1, '\0'));
+}
+
+const Engine::RuleInfo* Engine::FindRuleInfo(
+    const url_pattern_index::flat::UrlRule* rule) const {
+  if (!rule) {
+    return nullptr;
+  }
+  auto it = rules_by_identity_.find(RuleIdentityKey(*rule));
+  return it == rules_by_identity_.end() ? nullptr : &it->second;
+}
+
+// static
+bool Engine::DomainMatches(const std::string& host, const std::string& domain) {
+  if (host == domain) {
+    return true;
+  }
+  return host.size() > domain.size() &&
+         host.ends_with(domain) &&
+         host[host.size() - domain.size() - 1] == '.';
+}
+
+bool Engine::RegexRuleMatches(
+    const RegexRule& rule,
+    const GURL& url,
+    const url::Origin& initiator,
+    const subresource_filter::FirstPartyOrigin& first_party,
+    ElementType element_type,
+    bool is_document) const {
+  if (rule.document_rule != is_document) {
+    return false;
+  }
+  const auto& proto = rule.proto;
+  if (!is_document && !(proto.element_types() & element_type)) {
+    return false;
+  }
+  if (proto.source_type() == url_pattern_index::proto::SOURCE_TYPE_THIRD_PARTY &&
+      !first_party.IsThirdParty(url)) {
+    return false;
+  }
+  if (proto.source_type() == url_pattern_index::proto::SOURCE_TYPE_FIRST_PARTY &&
+      first_party.IsThirdParty(url)) {
+    return false;
+  }
+  if (proto.initiator_domains_size() > 0) {
+    const std::string host = initiator.host();
+    bool has_include = false;
+    bool included = false;
+    for (const auto& item : proto.initiator_domains()) {
+      const bool match = DomainMatches(host, item.domain());
+      if (item.exclude()) {
+        if (match) {
+          return false;
+        }
+      } else {
+        has_include = true;
+        included = included || match;
+      }
+    }
+    if (has_include && !included) {
+      return false;
+    }
+  }
+  return re2::RE2::PartialMatch(url.spec(), *rule.re);
+}
+
+void Engine::FillRedirect(
+    MatchResult* result,
+    const GURL& url,
+    const url::Origin& initiator,
+    const subresource_filter::FirstPartyOrigin& first_party,
+    ElementType element_type,
+    bool is_document,
+    const std::string& method) const {
+  struct Candidate {
+    std::string resource;
+    std::string directive;
+    int priority;
+    bool exception;
+  };
+  std::vector<Candidate> candidates;
+  for (const MetadataRule* rule :
+       metadata_->Matches(url, initiator, first_party, element_type)) {
+    const auto& opt = rule->options;
+    if (opt.redirect.empty() || rule->document_rule != is_document ||
+        (!opt.method.empty() &&
+         (method.empty() || !MethodMatches(opt.method, method)))) {
+      continue;
+    }
+    candidates.push_back({opt.redirect, opt.redirect_directive,
+                          opt.redirect_priority,
+                          rule->proto.semantics() ==
+                              url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST});
+  }
+  for (const auto& rule : regex_rules_) {
+    if (!rule->redirect.empty() &&
+        RegexRuleMatches(*rule, url, initiator, first_party, element_type,
+                         is_document)) {
+      candidates.push_back({rule->redirect, rule->redirect_directive,
+                            rule->redirect_priority,
+                            rule->proto.semantics() ==
+                                url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST});
+    }
+  }
+  base::flat_set<std::string> exceptions;
+  for (const Candidate& candidate : candidates) {
+    if (candidate.exception) {
+      exceptions.insert(candidate.directive);
+    }
+  }
+  const Candidate* best = nullptr;
+  for (const Candidate& candidate : candidates) {
+    if (!candidate.exception && !exceptions.contains(candidate.directive) &&
+        (!best || candidate.priority > best->priority ||
+         (candidate.priority == best->priority &&
+          candidate.directive < best->directive))) {
+      best = &candidate;
+    }
+  }
+  if (best) {
+    if (const Resource* resource = FindResource(best->resource)) {
+      result->redirect_resource = best->resource;
+      result->rewritten_url = DataUrl(*resource);
+    }
+  }
+}
+
+MatchResult Engine::Evaluate(const GURL& url,
+                             const url::Origin& initiator,
+                             ElementType element_type,
+                             bool is_document,
+                             const std::string& method) const {
+  MatchResult result;
+  if (!url.is_valid()) {
+    return result;
+  }
+  subresource_filter::FirstPartyOrigin first_party(initiator);
+  const url_pattern_index::flat::UrlRule* rule = nullptr;
+  auto note_rule = [&](const url_pattern_index::flat::UrlRule* r,
+                       const RuleInfo* info_override) {
+    if (info_override) {
+      result.filter = info_override->text;
+      result.source = info_override->source;
+      return;
+    }
+    if (const RuleInfo* info = FindRuleInfo(r)) {
+      result.filter = info->text;
+      result.source = info->source;
+    } else {
+      result.filter = PatternOf(r);
+    }
+  };
+
+  // Important method rules retain both conditions; removing $method while
+  // indexing an important rule would incorrectly block other HTTP methods.
+  for (const MetadataRule* m :
+       metadata_->Matches(url, initiator, first_party, element_type)) {
+    if (m->options.bucket != Bucket::kMethod || !m->options.important ||
+        m->document_rule != is_document || method.empty() ||
+        !MethodMatches(m->options.method, method)) {
+      continue;
+    }
+    const bool allow = m->proto.semantics() ==
+                       url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+    result.has_filter = true;
+    result.has_exception = allow;
+    result.should_block = !allow;
+    note_rule(nullptr, &m->info);
+    if (!allow) {
+      FillRedirect(&result, url, initiator, first_party, element_type,
+                   is_document, method);
+    }
+    return result;
+  }
+
+  // 1. $important rules: a block here wins over every exception.
+  const SideIndex* important =
+      is_document ? important_document_.get() : important_.get();
+  if (important->matcher) {
+    subresource_filter::LoadPolicy policy =
+        important->matcher->GetLoadPolicyForResourceLoad(
+            url, first_party, element_type, /*disable_generic_rules=*/false,
+            &rule);
+    if (policy == subresource_filter::LoadPolicy::DISALLOW) {
+      result.should_block = true;
+      result.has_filter = true;
+      note_rule(rule, nullptr);
+      FillRedirect(&result, url, initiator, first_party, element_type,
+                   is_document, method);
+      return result;
+    }
+    if (policy == subresource_filter::LoadPolicy::EXPLICITLY_ALLOW) {
+      result.has_exception = true;
+      result.has_filter = rule != nullptr;
+      note_rule(rule, nullptr);
+      return result;
+    }
+  }
+  for (const auto& regex : regex_rules_) {
+    if (regex->bucket == Bucket::kImportant &&
+        RegexRuleMatches(*regex, url, initiator, first_party, element_type,
+                         is_document)) {
+      const bool allow = regex->proto.semantics() ==
+                         url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+      result.has_filter = true;
+      result.has_exception = allow;
+      result.should_block = !allow;
+      note_rule(nullptr, &regex->info);
+      if (!allow) {
+        FillRedirect(&result, url, initiator, first_party, element_type,
+                     is_document, method);
+      }
+      return result;
+    }
+  }
+
+  // 2. Main index.
+  bool block_matched = false;
+  bool exception_matched = false;
+  const subresource_filter::IndexedRulesetMatcher* matcher =
+      is_document ? document_matcher_.get() : matcher_.get();
+  if (matcher) {
+    subresource_filter::LoadPolicy policy =
+        matcher->GetLoadPolicyForResourceLoad(url, first_party, element_type,
+                                              /*disable_generic_rules=*/false,
+                                              &rule);
+    if (policy == subresource_filter::LoadPolicy::DISALLOW) {
+      block_matched = true;
+      note_rule(rule, nullptr);
+    } else if (policy == subresource_filter::LoadPolicy::EXPLICITLY_ALLOW) {
+      exception_matched = true;
+      result.has_filter = rule != nullptr;
+      note_rule(rule, nullptr);
+    }
+  }
+
+  // 3. Match every complete $method rule. A match for GET must not hide
+  // another matching pattern/domain rule for POST or its scoped exception.
+  for (const MetadataRule* m :
+       metadata_->Matches(url, initiator, first_party, element_type)) {
+    const bool method_exception =
+        m->options.redirect_only && !m->options.method.empty() &&
+        m->proto.semantics() ==
+            url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+    if ((m->options.bucket != Bucket::kMethod && !method_exception) ||
+        m->document_rule != is_document || method.empty() ||
+        !MethodMatches(m->options.method, method)) {
+      continue;
+    }
+    if (m->proto.semantics() ==
+        url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST) {
+      exception_matched = true;
+    } else if (!block_matched) {
+      block_matched = true;
+      note_rule(nullptr, &m->info);
+    }
+  }
+
+  // 4. Regex rules (main bucket).
+  for (const auto& regex : regex_rules_) {
+    if (regex->bucket != Bucket::kMain) {
+      continue;
+    }
+    if (!RegexRuleMatches(*regex, url, initiator, first_party, element_type,
+                          is_document)) {
+      continue;
+    }
+    const bool allow = regex->proto.semantics() ==
+                       url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+    if (allow) {
+      exception_matched = true;
+      result.has_filter = true;
+      note_rule(nullptr, &regex->info);
+    } else if (!block_matched) {
+      block_matched = true;
+      note_rule(nullptr, &regex->info);
+      if (!regex->redirect.empty()) {
+        if (const Resource* res = FindResource(regex->redirect)) {
+          result.redirect_resource = regex->redirect;
+          result.rewritten_url = DataUrl(*res);
+        }
+      }
+    }
+  }
+
+  if (exception_matched) {
+    result.has_exception = true;
+    result.has_filter = result.has_filter || block_matched;
+    result.should_block = false;
+    result.redirect_resource.clear();
+    result.rewritten_url.clear();
+    return result;
+  }
+  if (block_matched) {
+    result.should_block = true;
+    result.has_filter = true;
+    result.redirect_resource.clear();
+    result.rewritten_url.clear();
+    FillRedirect(&result, url, initiator, first_party, element_type,
+                 is_document, method);
+  }
+  return result;
+}
+
+MatchResult Engine::EvaluatePopup(const GURL& url,
+                                  const url::Origin& opener) const {
+  MatchResult result;
+  if (!url.is_valid()) {
+    return result;
+  }
+  subresource_filter::FirstPartyOrigin first_party(opener);
+  if (popup_->matcher) {
+    const url_pattern_index::flat::UrlRule* rule = nullptr;
+    subresource_filter::LoadPolicy policy =
+        popup_->matcher->GetLoadPolicyForResourceLoad(
+            url, first_party, ElementType::ELEMENT_TYPE_SUBDOCUMENT,
+            /*disable_generic_rules=*/false, &rule);
+    if (rule) {
+      if (const RuleInfo* info = FindRuleInfo(rule)) {
+        result.filter = info->text;
+        result.source = info->source;
+      }
+    }
+    if (policy == subresource_filter::LoadPolicy::EXPLICITLY_ALLOW) {
+      result.has_exception = true;
+      result.has_filter = rule != nullptr;
+      return result;
+    }
+    if (policy == subresource_filter::LoadPolicy::DISALLOW) {
+      result.should_block = true;
+      result.has_filter = true;
+    }
+  }
+  for (const auto& regex : regex_rules_) {
+    if (regex->bucket != Bucket::kPopup ||
+        !RegexRuleMatches(*regex, url, opener, first_party,
+                          ElementType::ELEMENT_TYPE_SUBDOCUMENT,
+                          /*is_document=*/false)) {
+      continue;
+    }
+    const bool allow = regex->proto.semantics() ==
+                       url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+    result.has_filter = true;
+    result.filter = regex->info.text;
+    result.source = regex->info.source;
+    if (allow) {
+      result.has_exception = true;
+      result.should_block = false;
+      return result;
+    }
+    result.should_block = true;
+  }
+  return result;
+}
+
+std::string Engine::CspForDocument(const GURL& url) const {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  const url::Origin origin = url::Origin::Create(url);
+  subresource_filter::FirstPartyOrigin first_party(origin);
+  base::flat_set<std::string> policies;
+  base::flat_set<std::string> exceptions;
+  for (const MetadataRule* rule : metadata_->Matches(
+           url, origin, first_party, ElementType::ELEMENT_TYPE_SUBDOCUMENT)) {
+    if (rule->options.bucket != Bucket::kCsp) {
+      continue;
+    }
+    const std::string& policy = rule->options.csp;
+    if (rule->proto.semantics() ==
+        url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST) {
+      if (policy.empty()) {
+        return std::string();  // Bare @@...$csp disables all injection.
+      }
+      exceptions.insert(policy);
+    } else if (!policy.empty()) {
+      policies.insert(policy);
+    }
+  }
+  std::vector<std::string> enabled;
+  for (const std::string& policy : policies) {
+    if (!exceptions.contains(policy)) {
+      enabled.push_back(policy);
+    }
+  }
+  // A comma-delimited CSP header enforces each policy independently. Joining
+  // with semicolons would weaken repeated directives (only the first wins).
+  return base::JoinString(enabled, ",");
+}
+
+// static
+bool Engine::CosmeticRuleApplies(const std::vector<std::string>& include,
+                                 const std::vector<std::string>& exclude,
+                                 const std::string& host) {
+  bool included = include.empty();
+  for (const std::string& d : include) {
+    if (DomainMatches(host, d)) {
+      included = true;
+      break;
+    }
+  }
+  if (!included) {
+    return false;
+  }
+  for (const std::string& d : exclude) {
+    if (DomainMatches(host, d)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void Engine::CollectSpecific(const std::string& host,
+                             std::vector<std::string>* selectors,
+                             base::flat_set<std::string>* exceptions,
+                             bool include_generic) const {
+  for (const CosmeticRule& rule : conditional_rules_) {
+    if (!CosmeticRuleApplies(rule.include, rule.exclude, host)) {
+      continue;
+    }
+    if (rule.is_exception) {
+      exceptions->insert(rule.selector);
+    } else if (include_generic || !rule.include.empty()) {
+      selectors->push_back(rule.selector);
+    }
+  }
+}
+
+bool Engine::ElemhideDisabled(const GURL& url) const {
+  return elemhide_->matcher &&
+         elemhide_->matcher->ShouldDisableFilteringForDocument(
+             url, url::Origin::Create(url),
+             url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT);
+}
+
+bool Engine::GenerichideDisabled(const GURL& url) const {
+  return generichide_->matcher &&
+         generichide_->matcher->ShouldDisableFilteringForDocument(
+             url, url::Origin::Create(url),
+             url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT);
+}
+
+std::string Engine::CosmeticResourcesJson(const GURL& url) const {
+  base::DictValue payload;
+  base::ListValue hide;
+  base::ListValue procedural;
+  bool generichide = true;
+  if (url.SchemeIsHTTPOrHTTPS() && !ElemhideDisabled(url)) {
+    generichide = GenerichideDisabled(url);
+    const std::string host(url.host());
+    std::vector<std::string> selectors;
+    base::flat_set<std::string> exceptions;
+    CollectSpecific(host, &selectors, &exceptions, !generichide);
+    base::flat_set<std::string> seen;
+    for (const std::string& s : selectors) {
+      if (!exceptions.contains(s) && seen.insert(s).second) {
+        hide.Append(s);
+      }
+    }
+    if (!generichide) {
+      for (const std::string& s : generic_misc_) {
+        if (!exceptions.contains(s) && seen.insert(s).second) {
+          hide.Append(s);
+        }
+      }
+    }
+    base::flat_set<std::string> procedural_exceptions;
+    for (const ProceduralRule& rule : procedural_rules_) {
+      if (rule.is_exception &&
+          CosmeticRuleApplies(rule.include, rule.exclude, host)) {
+        procedural_exceptions.insert(rule.json);
+      }
+    }
+    base::flat_set<std::string> emitted;
+    for (const ProceduralRule& rule : procedural_rules_) {
+      if (!rule.is_exception &&
+          !(generichide && rule.include.empty()) &&
+          CosmeticRuleApplies(rule.include, rule.exclude, host) &&
+          !procedural_exceptions.contains(rule.json) &&
+          emitted.insert(rule.json).second) {
+        procedural.Append(rule.json);
+      }
+    }
+  }
+  payload.Set("hideSelectors", std::move(hide));
+  payload.Set("proceduralActions", std::move(procedural));
+  payload.Set("generichide", generichide);
+  std::string json;
+  base::JSONWriter::Write(payload, &json);
+  return json;
+}
+
+std::vector<std::string> Engine::HiddenClassIdSelectors(
+    const GURL& url,
+    const std::vector<std::string>& classes,
+    const std::vector<std::string>& ids) const {
+  std::vector<std::string> out;
+  if (!url.SchemeIsHTTPOrHTTPS() || ElemhideDisabled(url) ||
+      GenerichideDisabled(url)) {
+    return out;
+  }
+  std::vector<std::string> unused;
+  base::flat_set<std::string> exceptions;
+  CollectSpecific(std::string(url.host()), &unused, &exceptions);
+  base::flat_set<std::string> seen;
+  auto add = [&](const std::unordered_map<std::string, std::vector<std::string>>&
+                     table,
+                 const std::string& key) {
+    auto it = table.find(key);
+    if (it == table.end()) {
+      return;
+    }
+    for (const std::string& s : it->second) {
+      if (!exceptions.contains(s) && seen.insert(s).second) {
+        out.push_back(s);
+      }
+    }
+  };
+  for (const std::string& c : classes) {
+    add(generic_by_class_, c);
+  }
+  for (const std::string& i : ids) {
+    add(generic_by_id_, i);
+  }
+  return out;
+}
+
+std::string Engine::HidingStylesheet(const GURL& url) const {
+  if (!url.SchemeIsHTTPOrHTTPS() || ElemhideDisabled(url)) {
+    return std::string();
+  }
+  const bool generic_disabled = GenerichideDisabled(url);
+  const std::string host(url.host());
+  std::vector<std::string> selectors;
+  base::flat_set<std::string> exceptions;
+  CollectSpecific(host, &selectors, &exceptions, !generic_disabled);
+  std::string css;
+  if (!generic_disabled && !generic_stylesheet_.empty()) {
+    if (exceptions.empty()) {
+      css = generic_stylesheet_;
+    } else {
+      std::vector<std::string> generic;
+      for (const std::string& s : generic_selectors_) {
+        if (!exceptions.contains(s)) {
+          generic.push_back(s);
+        }
+      }
+      if (!generic.empty()) {
+        css = base::JoinString(generic, ",\n") + "{display:none!important;}\n";
+      }
+    }
+  }
+  if (!selectors.empty()) {
+    std::vector<std::string> kept;
+    for (const std::string& s : selectors) {
+      if (!exceptions.contains(s)) {
+        kept.push_back(s);
+      }
+    }
+    if (!kept.empty()) {
+      css += base::JoinString(kept, ",\n") + "{display:none!important;}\n";
+    }
+  }
+  return css;
+}
+
+}  // namespace aside_adblock
diff --git a/chrome/browser/aside_adblock/aside_adblock_engine.h b/chrome/browser/aside_adblock/aside_adblock_engine.h
new file mode 100644
index 0000000000000000000000000000000000000000..a0b333f039c71eadf950d606f7c9df9a97821530
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_engine.h
@@ -0,0 +1,269 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Aside ad-block engine (replica of the adblock-rust based engine of the
+// original components/aside_adblock). Filter lists in EasyList syntax are
+// parsed with //components/subresource_filter's rule parser and indexed with
+// //components/url_pattern_index; options that index cannot carry ($popup,
+// $generichide/$elemhide, $important, $redirect/$rewrite, $csp, $method) go
+// through aside_adblock_rule_preprocessor into side indexes, /regex/ rules
+// into an RE2 table, and element hiding rules are kept as selector tables.
+// An Engine is immutable once built and can be shared across threads.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/memory/ref_counted.h"
+#include "chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h"
+#include "components/url_pattern_index/flat/url_pattern_index_generated.h"
+#include "components/url_pattern_index/proto/rules.pb.h"
+#include "services/network/public/mojom/fetch_api.mojom-forward.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace re2 {
+class RE2;
+}
+
+namespace subresource_filter {
+class FirstPartyOrigin;
+class IndexedRulesetMatcher;
+class RulesetIndexer;
+}  // namespace subresource_filter
+
+namespace aside_adblock {
+
+struct FilterSource {
+  std::string id;     // subscription id, "custom" or "manual:<file>"
+  std::string title;  // human readable title
+  std::string text;   // filter list text (UTF-8)
+};
+
+struct SourceStats {
+  std::string id;
+  std::string title;
+  int network_rule_count = 0;
+  int cosmetic_rule_count = 0;
+  int parse_error_count = 0;
+  std::vector<std::string> invalid_lines;  // "<line>: <error>", capped
+};
+
+struct Resource {
+  std::string mime;
+  std::string body;
+};
+
+struct MatchResult {
+  bool should_block = false;
+  bool has_filter = false;     // a blocking filter matched
+  bool has_exception = false;  // an exception (@@) filter matched
+  std::string filter;          // matched filter text (best effort)
+  std::string source;          // "subscription:<name>" / "custom" / "manual:<f>"
+  std::string redirect_resource;  // $redirect resource name when blocked
+  std::string rewritten_url;      // data: URL of that resource
+};
+
+struct EngineOptions {
+  size_t max_invalid_lines_per_source = 200;
+  std::string resources_json;  // adblock-rust resources.json (may be empty)
+};
+
+// Maps a fetch destination to the EasyList resource type used for matching.
+url_pattern_index::proto::ElementType ElementTypeForDestination(
+    network::mojom::RequestDestination destination);
+
+// Parses a request type name as used by the internals page / TestRule
+// ("script", "image", "stylesheet", "subdocument", "document", "xmlhttprequest",
+// "font", "media", "websocket", "ping", "object", "other").
+url_pattern_index::proto::ElementType ElementTypeForName(
+    const std::string& name,
+    bool* is_document);
+
+class Engine : public base::RefCountedThreadSafe<Engine> {
+ public:
+  // Builds an engine from |sources|. Safe to call on a worker thread.
+  static scoped_refptr<Engine> Build(const std::vector<FilterSource>& sources);
+  static scoped_refptr<Engine> BuildWithOptions(
+      const std::vector<FilterSource>& sources,
+      const EngineOptions& options);
+
+  // Engine cache (the original's engine0.dat / engine1.dat). |source_digest|
+  // identifies the inputs (SourceDigest); Deserialize refuses a file whose
+  // payload is damaged or whose format version differs.
+  static std::string SourceDigest(const std::vector<FilterSource>& sources,
+                                  const std::string& resources_json);
+  // Digest recorded in a serialized engine, or empty if unreadable.
+  static std::string CachedSourceDigest(const std::string& bytes);
+  std::string Serialize(const std::string& source_digest) const;
+  static scoped_refptr<Engine> Deserialize(const std::string& bytes,
+                                           const EngineOptions& options);
+
+  Engine(const Engine&) = delete;
+  Engine& operator=(const Engine&) = delete;
+
+  // Network filtering. |is_document| selects the top-level document rule set
+  // ($document filters) instead of the sub-resource rule set. |method| is the
+  // HTTP method ("GET"...) for $method rules; empty skips them.
+  MatchResult Evaluate(const GURL& url,
+                       const url::Origin& initiator,
+                       url_pattern_index::proto::ElementType element_type,
+                       bool is_document,
+                       const std::string& method = std::string()) const;
+
+  // $popup rules: a new window/tab navigation to |url| opened by a document at
+  // |opener|.
+  MatchResult EvaluatePopup(const GURL& url, const url::Origin& opener) const;
+
+  // $csp rules: the Content-Security-Policy value to add to the document at
+  // |url|, or empty.
+  std::string CspForDocument(const GURL& url) const;
+
+  // Element hiding: CSS text ("sel1,sel2{display:none!important}") for the
+  // document at |url|, or empty when nothing applies ($elemhide exceptions
+  // disable everything, $generichide the generic selectors).
+  std::string HidingStylesheet(const GURL& url) const;
+
+  // Cosmetic resources for the document at |url| in the payload shape of the
+  // original's cosmetic script: {"hideSelectors": [specific + generic
+  // selectors not keyed by a class/id], "proceduralActions": [rule json],
+  // "generichide": bool}.
+  std::string CosmeticResourcesJson(const GURL& url) const;
+  // Generic selectors keyed by a leading .class / #id that the document at
+  // |url| reported, minus that document's exceptions.
+  std::vector<std::string> HiddenClassIdSelectors(
+      const GURL& url,
+      const std::vector<std::string>& classes,
+      const std::vector<std::string>& ids) const;
+  int procedural_rule_count() const { return procedural_rule_count_; }
+
+  // Redirect resource by name (built-in table + resources.json).
+  const Resource* FindResource(const std::string& name) const;
+
+  const std::vector<SourceStats>& sources() const { return sources_; }
+  size_t flatbuffer_size() const { return flatbuffer_size_; }
+  int network_rule_count() const { return network_rule_count_; }
+  int cosmetic_rule_count() const { return cosmetic_rule_count_; }
+  int parse_error_count() const { return parse_error_count_; }
+  int csp_rule_count() const { return csp_rule_count_; }
+  int popup_rule_count() const { return popup_rule_count_; }
+  // Compiled regex patterns (for the internals page).
+  const std::vector<std::string>& regex_patterns() const {
+    return regex_patterns_;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Engine>;
+  struct RuleInfo {
+    std::string text;
+    std::string source;
+  };
+  struct CosmeticRule {
+    std::string selector;
+    std::vector<std::string> include;
+    std::vector<std::string> exclude;
+    bool is_exception = false;
+  };
+  struct ProceduralRule {
+    std::string json;
+    std::vector<std::string> include;
+    std::vector<std::string> exclude;
+    bool is_exception = false;
+  };
+  struct MetadataRule;
+  struct MetadataIndex;
+  struct SideIndex;
+  struct RegexRule;
+
+  explicit Engine(const EngineOptions& options);
+  ~Engine();
+
+  void AddSource(const FilterSource& source);
+  void Finish();
+  void BuildCosmeticTables();
+  void FinishIndexes();
+  void LoadResources(const std::string& json);
+  // The rule text/source recorded for an indexed rule. Keyed by the whole
+  // matcher identity, not the URL pattern alone: several rules can share one
+  // pattern and differ only in their domain conditions, and reporting must
+  // name the rule that actually matched.
+  const RuleInfo* FindRuleInfo(
+      const url_pattern_index::flat::UrlRule* rule) const;
+  static std::string RuleIdentityKey(
+      const url_pattern_index::proto::UrlRule& proto);
+  static std::string RuleIdentityKey(
+      const url_pattern_index::flat::UrlRule& rule);
+  static bool DomainMatches(const std::string& host, const std::string& domain);
+  static bool CosmeticRuleApplies(const std::vector<std::string>& include,
+                                  const std::vector<std::string>& exclude,
+                                  const std::string& host);
+  // Specific selectors and exceptions for |host| (from conditional_rules_).
+  void CollectSpecific(const std::string& host,
+                       std::vector<std::string>* selectors,
+                       base::flat_set<std::string>* exceptions,
+                       bool include_generic = true) const;
+  bool ElemhideDisabled(const GURL& url) const;
+  bool GenerichideDisabled(const GURL& url) const;
+  bool RegexRuleMatches(const RegexRule& rule,
+                        const GURL& url,
+                        const url::Origin& initiator,
+                        const subresource_filter::FirstPartyOrigin& first_party,
+                        url_pattern_index::proto::ElementType element_type,
+                        bool is_document) const;
+  void FillRedirect(MatchResult* result,
+                    const GURL& url,
+                    const url::Origin& initiator,
+                    const subresource_filter::FirstPartyOrigin& first_party,
+                    url_pattern_index::proto::ElementType element_type,
+                    bool is_document,
+                    const std::string& method) const;
+
+  const size_t max_invalid_lines_;
+  std::unique_ptr<subresource_filter::RulesetIndexer> indexer_;
+  std::unique_ptr<subresource_filter::RulesetIndexer> document_indexer_;
+  std::vector<uint8_t> loaded_main_;      // index bytes when deserialized
+  std::vector<uint8_t> loaded_document_;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> matcher_;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> document_matcher_;
+  // Side indexes for options url_pattern_index cannot carry.
+  std::unique_ptr<SideIndex> popup_;
+  std::unique_ptr<SideIndex> generichide_;
+  std::unique_ptr<SideIndex> elemhide_;
+  std::unique_ptr<SideIndex> important_;
+  std::unique_ptr<SideIndex> important_document_;
+  std::unique_ptr<MetadataIndex> metadata_;
+  std::unordered_map<std::string, RuleInfo> rules_by_identity_;
+  base::flat_set<std::string> disabled_network_rules_;  // build-time only
+  std::vector<std::unique_ptr<RegexRule>> regex_rules_;
+  std::vector<std::string> regex_patterns_;
+  std::map<std::string, Resource> resources_;
+
+  std::vector<std::string> generic_selectors_;  // no include, no exclude
+  std::vector<CosmeticRule> conditional_rules_;  // has include or exclude
+  std::string generic_stylesheet_;
+  // generic_selectors_ split the way the cosmetic script consumes them.
+  std::unordered_map<std::string, std::vector<std::string>> generic_by_class_;
+  std::unordered_map<std::string, std::vector<std::string>> generic_by_id_;
+  std::vector<std::string> generic_misc_;
+  std::vector<ProceduralRule> procedural_rules_;
+  int procedural_rule_count_ = 0;
+
+  std::vector<SourceStats> sources_;
+  size_t flatbuffer_size_ = 0;
+  int network_rule_count_ = 0;
+  int cosmetic_rule_count_ = 0;
+  int parse_error_count_ = 0;
+  int csp_rule_count_ = 0;
+  int popup_rule_count_ = 0;
+};
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
diff --git a/chrome/browser/aside_adblock/aside_adblock_engine_tests.cc b/chrome/browser/aside_adblock/aside_adblock_engine_tests.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f6070a234a73f307cfbbb05f8a527fc8fcf3adfc
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_engine_tests.cc
@@ -0,0 +1,425 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_split.h"
+#include "base/values.h"
+#include "chrome/browser/aside_adblock/aside_adblock_engine.h"
+#include "chrome/browser/aside_adblock/aside_adblock_cosmetic_request.h"
+#include "chrome/common/aside_adblock/aside_adblock_readiness.h"
+
+namespace {
+using aside_adblock::Engine;
+using aside_adblock::FilterSource;
+using url_pattern_index::proto::ELEMENT_TYPE_SCRIPT;
+int failures = 0;
+int assertions = 0;
+
+void Expect(bool condition, const char* name) {
+  ++assertions;
+  std::cout << (condition ? "PASS " : "FAIL ") << name << '\n';
+  if (!condition) {
+    ++failures;
+  }
+}
+
+scoped_refptr<Engine> Build(const std::string& text) {
+  auto engine = Engine::Build({{"custom", "test", text}});
+  Expect(engine->parse_error_count() == 0, "fixture parses without ignored rules");
+  return engine;
+}
+
+aside_adblock::MatchResult Request(const Engine& engine,
+                                  const char* url,
+                                  const char* origin,
+                                  const char* method = "GET") {
+  return engine.Evaluate(GURL(url), url::Origin::Create(GURL(origin)),
+                         ELEMENT_TYPE_SCRIPT, false, method);
+}
+
+size_t ProceduralCount(const Engine& engine, const char* url) {
+  auto value = base::JSONReader::Read(engine.CosmeticResourcesJson(GURL(url)),
+                                     base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return 99999;
+  }
+  const auto* actions = value->GetDict().FindList("proceduralActions");
+  return actions ? actions->size() : 99999;
+}
+
+// The end-to-end fixture's host rules as the renderer receives them: an IP
+// host that carries a $generichide exception must still get its own hide
+// selector and both of its procedural actions.
+void CheckCosmeticPayloadForIpHost() {
+  auto engine = Engine::Build({{"custom", "test", R"RULES(
+127.0.0.1##.aside-site-specific
+@@||127.0.0.1^$generichide
+127.0.0.1##.aside-proc-item:has-text(Sponsored)
+127.0.0.1##.aside-style-item:style(color: rgb(9, 8, 7) !important)
+)RULES"}});
+  const std::string json =
+      engine->CosmeticResourcesJson(GURL("http://127.0.0.1:18791/index.html"));
+  auto value = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  Expect(value && value->is_dict(), "IP-host cosmetic payload is JSON");
+  if (!value || !value->is_dict()) {
+    return;
+  }
+  const auto& dict = value->GetDict();
+  const auto* hide = dict.FindList("hideSelectors");
+  const auto* actions = dict.FindList("proceduralActions");
+  Expect(dict.FindBool("generichide").value_or(false),
+         "$generichide exception reaches the renderer for an IP host");
+  Expect(hide && hide->size() == 1,
+         "host-specific hide selector survives $generichide");
+  Expect(actions && actions->size() == 2,
+         "both host procedural actions survive $generichide");
+}
+
+void CheckSemantics(const Engine& engine) {
+  // Identical URL pattern and different document domains: metadata must stay
+  // attached to the rule which actually matched, regardless of input order.
+  Expect(engine.CspForDocument(GURL("https://a.test/page")) ==
+             "img-src 'none',script-src 'none'",
+         "CSP merges all matching policies and preserves domain identity");
+  Expect(engine.CspForDocument(GURL("https://b.test/page")) ==
+             "connect-src 'none'", "CSP does not borrow another domain policy");
+  Expect(engine.CspForDocument(GURL("https://c.test/page")).empty(),
+         "unrelated domain receives no CSP");
+  Expect(engine.CspForDocument(GURL("https://a.test/exempt-script")) ==
+             "img-src 'none'", "CSP exact exception removes only its policy");
+  Expect(engine.CspForDocument(GURL("https://a.test/exempt-all")).empty(),
+         "bare CSP exception suppresses all matching policies");
+
+  Expect(Request(engine, "https://tracker.test/api", "https://a.test", "POST")
+             .should_block, "POST rule survives same-pattern GET rule");
+  Expect(!Request(engine, "https://tracker.test/api", "https://a.test", "GET")
+              .should_block, "GET cannot borrow POST domain metadata");
+  Expect(Request(engine, "https://tracker.test/api", "https://b.test", "GET")
+             .should_block, "GET rule matches its own domain");
+  Expect(!Request(engine, "https://tracker.test/api", "https://b.test", "POST")
+              .should_block, "POST cannot borrow GET domain metadata");
+  Expect(!Request(engine, "https://tracker.test/api", "https://a.test", "HEAD")
+              .should_block, "unlisted HTTP method remains allowed");
+  Expect(!Request(engine, "https://tracker.test/exempt", "https://a.test", "POST")
+              .should_block, "method-scoped exception suppresses its method");
+  Expect(Request(engine, "https://tracker.test/important", "https://a.test", "POST")
+             .should_block, "important method block wins over ordinary exception");
+  Expect(!Request(engine, "https://tracker.test/important", "https://a.test", "GET")
+              .should_block, "important method retains the HTTP condition");
+
+  auto redirect_a = Request(engine, "https://ads.test/shared.js", "https://a.test");
+  auto redirect_b = Request(engine, "https://ads.test/shared.js", "https://b.test");
+  Expect(redirect_a.should_block && redirect_a.redirect_resource == "noop.js",
+         "redirect retains complete domain-qualified identity");
+  Expect(redirect_b.should_block && redirect_b.redirect_resource == "noop.json",
+         "second same-pattern redirect retains its own resource");
+  Expect(Request(engine, "https://ads.test/priority.js", "https://a.test")
+             .redirect_resource == "noop.json",
+         "highest signed redirect priority wins across all matching rules");
+  Expect(Request(engine, "https://ads.test/negative.js", "https://a.test")
+             .redirect_resource == "noop.js", "negative redirect priorities compare as signed integers");
+  Expect(Request(engine, "https://ads.test/exception.js", "https://a.test")
+             .redirect_resource == "noop.js", "redirect-rule exception cancels exact high-priority directive");
+  Expect(!Request(engine, "https://alone.test/rule.js", "https://a.test", "POST")
+              .should_block, "redirect-rule plus method never creates a blocking rule");
+  Expect(Request(engine, "https://ads.test/method.js", "https://a.test", "POST")
+             .redirect_resource == "noop.js", "method-qualified redirect matches POST");
+  Expect(Request(engine, "https://ads.test/method.js", "https://a.test", "GET")
+             .redirect_resource.empty(), "method-qualified redirect cannot leak to GET");
+  Expect(Request(engine, "https://ads.test/missing.js", "https://a.test")
+             .redirect_resource.empty(), "missing highest-priority resource is not silently noop");
+  Expect(ProceduralCount(engine, "https://a.test/") == 0,
+         "domain-scoped procedural exception removes normalized action");
+  Expect(ProceduralCount(engine, "https://b.test/") == 1,
+         "procedural exception does not remove another domain action");
+}
+
+void CheckCosmeticDomainExclusions() {
+  const auto engine = Build(R"RULES(
+example.test,~private.example.test##.advert
+~excluded.test##.generic-excluded
+example.test,~private.example.test#?#.procedural:has-text(Sponsored)
+example.test,~private.example.test#@#.global-exception
+##.global-exception
+@@||no-generic.test^$generichide
+)RULES");
+  auto check = [&](const Engine& candidate) {
+    const std::string included = candidate.HidingStylesheet(GURL("https://example.test/"));
+    const std::string excluded = candidate.HidingStylesheet(GURL("https://private.example.test/"));
+    Expect(included.find(".advert") != std::string::npos,
+           "mixed cosmetic domain rule hides on included domain");
+    Expect(excluded.find(".advert") == std::string::npos,
+           "mixed cosmetic domain rule preserves excluded subdomain");
+    Expect(candidate.HidingStylesheet(GURL("https://unrelated.test/")).find(".advert") == std::string::npos,
+           "mixed cosmetic domain rule does not affect unrelated host");
+    Expect(candidate.HidingStylesheet(GURL("https://example.test/")).find(".generic-excluded") != std::string::npos &&
+               candidate.HidingStylesheet(GURL("https://excluded.test/")).find(".generic-excluded") == std::string::npos,
+           "negative-only cosmetic domain prefix applies everywhere except exclusion");
+    Expect(candidate.HidingStylesheet(GURL("https://no-generic.test/")).find(".generic-excluded") == std::string::npos,
+           "generichide also disables negative-only generic selectors");
+    Expect(included.find(".global-exception") == std::string::npos &&
+               excluded.find(".global-exception") != std::string::npos,
+           "cosmetic exceptions preserve their own excluded domains");
+    Expect(ProceduralCount(candidate, "https://example.test/") == 1 &&
+               ProceduralCount(candidate, "https://private.example.test/") == 0,
+           "procedural rules support positive domains plus excluded subdomains");
+  };
+  check(*engine);
+  auto restored = Engine::Deserialize(engine->Serialize("cosmetic-domains"), {});
+  Expect(!!restored, "cosmetic domain exclusions survive cache load");
+  if (restored) {
+    check(*restored);
+  }
+}
+
+void CheckBadfilterAndRedirectExceptions() {
+  // Separate source files deliberately put cancellation before the target and
+  // reorder options/domains, as actual subscriptions do.
+  const std::vector<FilterSource> sources{
+      {"custom", "cancellations", R"RULES(
+||cancel.test^$badfilter,domain=b.test|a.test,script
+@@||restore.test^$badfilter,script
+||method.test^$badfilter,script,method=post
+||redirect.test^$redirect=noop.js,badfilter,script
+)RULES"},
+      {"manual:targets", "targets", R"RULES(
+||cancel.test^$script,domain=a.test|b.test
+||cancel.test^$image,domain=a.test
+||cancel.test^$script,domain=c.test
+||restore.test^$script
+@@||restore.test^$script
+||remain.test^$script
+||method.test^$method=post,script
+||method.test^$method=get,script
+||redirect.test^$script
+||redirect.test^$script,redirect=noop.js
+||allow-redirect.test^$script
+||allow-redirect.test^$redirect-rule=noop.js:1
+||allow-redirect.test^$redirect-rule=noop.json:8
+@@||allow-redirect.test^$redirect-rule=noop.json:8,domain=a.test
+||method-allow.test^$script
+@@||method-allow.test^$redirect-rule=noop.js,method=post
+)RULES"}};
+  auto engine = Engine::Build(sources);
+  auto check = [&](const Engine& candidate) {
+    Expect(candidate.parse_error_count() == 0, "badfilter is accepted without parse errors");
+    Expect(!Request(candidate, "https://cancel.test/asset", "https://a.test").should_block,
+           "badfilter before target cancels reordered options and domains across sources");
+    Expect(Request(candidate, "https://cancel.test/asset", "https://c.test").should_block,
+           "badfilter preserves different-domain control");
+    Expect(candidate.Evaluate(GURL("https://cancel.test/asset"),
+                             url::Origin::Create(GURL("https://a.test")),
+                             url_pattern_index::proto::ELEMENT_TYPE_IMAGE, false, "GET")
+               .should_block, "badfilter preserves different-type control");
+    Expect(Request(candidate, "https://restore.test/asset", "https://a.test").should_block,
+           "badfilter of exception restores its blocking rule");
+    Expect(Request(candidate, "https://remain.test/asset", "https://a.test").should_block,
+           "badfilter leaves unrelated blocking rule intact");
+    Expect(!Request(candidate, "https://method.test/asset", "https://a.test", "POST").should_block,
+           "badfilter cancels full method-qualified rule identity");
+    Expect(Request(candidate, "https://method.test/asset", "https://a.test", "GET").should_block,
+           "badfilter preserves another method on the same pattern");
+    const auto redirect = Request(candidate, "https://redirect.test/asset", "https://a.test");
+    Expect(redirect.should_block && redirect.redirect_resource.empty(),
+           "badfilter cancels redirect modifier without canceling a plain block");
+    Expect(!Request(candidate, "https://allow-redirect.test/asset", "https://a.test").should_block,
+           "redirect-rule exception allows a non-important block per reference engine");
+    Expect(Request(candidate, "https://allow-redirect.test/asset", "https://b.test").should_block,
+           "redirect exception retains its domain boundary");
+    Expect(!Request(candidate, "https://method-allow.test/asset", "https://a.test", "POST").should_block,
+           "method-qualified redirect exception permits its HTTP method");
+    Expect(Request(candidate, "https://method-allow.test/asset", "https://a.test", "GET").should_block,
+           "method-qualified redirect exception does not permit other methods");
+  };
+  check(*engine);
+  auto restored = Engine::Deserialize(engine->Serialize(Engine::SourceDigest(sources, "")), {});
+  Expect(!!restored, "badfilter-effective indexes survive cache load");
+  if (restored) {
+    check(*restored);
+  }
+}
+
+void CheckReadiness() {
+  using Gate = aside_adblock::PendingCosmeticRequest;
+  Gate request;
+  std::vector<std::string> replies;
+  std::vector<bool> settlements;
+  auto callback = [&]() {
+    return base::BindOnce(
+        [](std::vector<std::string>* out, std::vector<bool>* states,
+           bool settled, const std::string& payload) {
+          out->push_back(payload);
+          states->push_back(settled);
+        }, &replies, &settlements);
+  };
+  Expect(Gate::Readiness(true, false, false, false, true, false) == Gate::State::kLoading,
+         "startup waits for subscription metadata as well as engine creation");
+  Expect(Gate::Readiness(true, true, true, true, true, false) == Gate::State::kLoading,
+         "first compiled empty engine cannot bypass initial downloads in flight");
+  Expect(Gate::Readiness(true, true, true, false, false, false) == Gate::State::kLoading,
+         "download completion still waits for compile of the latest inputs");
+  Expect(Gate::Readiness(true, true, true, false, true, false) == Gate::State::kReady,
+         "settled downloads plus current engine release document readiness");
+  Expect(Gate::Readiness(true, true, false, false, false, true) == Gate::State::kFailed,
+         "terminal compile failure resolves distinctly from an engine still loading");
+  Expect(Gate::Readiness(false, true, true, true, false, false) == Gate::State::kDisabled,
+         "profile disabling overrides pending downloads and compilation");
+  const uint64_t cold = request.Begin(
+      Gate::Readiness(true, true, true, true, true, false), "empty-engine", callback());
+  Expect(cold != 0 && replies.empty(),
+         "empty initial compile keeps the actual request callback pending");
+  const auto full_state = Gate::Readiness(true, true, true, false, true, false);
+  Expect(full_state == Gate::State::kReady && request.Complete(cold, "downloaded-rules") &&
+             replies.back() == "downloaded-rules",
+         "initial download then current compile delivers real rules to queued document");
+  replies.clear();
+  const uint64_t first =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(first != 0 && replies.empty(),
+         "enabled loading engine defers its document response");
+  Expect(request.Complete(first, "late-rules") && replies.size() == 1 &&
+             replies.back() == "late-rules",
+         "delayed engine readiness delivers the original pending response");
+  Expect(!request.Complete(first, "duplicate"),
+         "readiness completion is delivered at most once");
+
+  const uint64_t old_document =
+      request.Begin(Gate::State::kLoading, "", callback());
+  request.Cancel();  // production navigation IPC path
+  Expect(!request.IsPending(old_document) && replies.back().empty(),
+         "navigation cancels old-document readiness and completes its callback");
+  const uint64_t new_document =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(!request.Complete(old_document, "old-document-rules") &&
+             request.IsPending(new_document),
+         "old readiness event cannot complete a new document request");
+  Expect(request.Complete(new_document, "new-document-rules") &&
+             replies.back() == "new-document-rules",
+         "new document receives only its own readiness result");
+
+  const auto before_disabled = replies.size();
+  Expect(request.Begin(Gate::State::kDisabled, "must-not-inject", callback()) == 0 &&
+             replies.size() == before_disabled + 1 && replies.back().empty(),
+         "disabled profile resolves immediately without startup waiting");
+  const auto before_ready = replies.size();
+  Expect(request.Begin(Gate::State::kReady, "no-rules-payload", callback()) == 0 &&
+             replies.size() == before_ready + 1 &&
+             replies.back() == "no-rules-payload",
+         "ready no-rules engine is distinct from enabled-but-loading");
+  const uint64_t deadline =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(request.Complete(deadline, "", false) && !request.IsPending(deadline) &&
+             !settlements.back(),
+         "bounded readiness deadline releases the pending callback");
+  Expect(!request.Complete(deadline, "too-late"),
+         "engine event after timeout cannot inject stale payload");
+  aside_adblock::CosmeticReadinessRetryBudget budget;
+  Expect(budget.TryStart(), "document starts its first bounded readiness wait");
+  const uint64_t slow = request.Begin(Gate::State::kLoading, "", callback());
+  request.Complete(slow, "", false);  //30-second host deadline, download continues
+  Expect(!settlements.back() && budget.CanRetry() && budget.TryStart(),
+         "not-ready deadline permits re-request without marking document applied");
+  const uint64_t later = request.Begin(Gate::State::kLoading, "", callback());
+  Expect(request.Complete(later, "rules-after-35-seconds") && settlements.back() &&
+             replies.back() == "rules-after-35-seconds",
+         "valid first download after initial deadline still supplies document rules");
+  int remaining = 0;
+  while (budget.TryStart()) {
+    ++remaining;
+  }
+  Expect(remaining == 4 && !budget.CanRetry(),
+         "unresolved readiness attempts have a finite per-document budget");
+  budget.Reset();
+  Expect(budget.TryStart(), "navigation grants a fresh readiness budget");
+  request.Begin(Gate::State::kDisabled, "", callback());
+  Expect(settlements.back(), "disabled final-empty result never schedules readiness retry");
+  const uint64_t disable_while_loading =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(request.Complete(disable_while_loading, "") && replies.back().empty(),
+         "disabling during startup resolves the waiting document without injection");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(argc, argv);
+  CheckReadiness();
+  CheckBadfilterAndRedirectExceptions();
+  CheckCosmeticDomainExclusions();
+  CheckCosmeticPayloadForIpHost();
+  const std::string rules = R"RULES(
+*$csp=script-src 'none',domain=a.test
+*$csp=connect-src 'none',domain=b.test
+*$csp=img-src 'none',domain=a.test
+@@/exempt-script$csp=script-src 'none',domain=a.test
+@@/exempt-all$csp,domain=a.test
+||tracker.test/api$method=post,domain=a.test
+||tracker.test/api$method=get,domain=b.test
+||tracker.test/exempt$method=post,domain=a.test
+@@||tracker.test/exempt$method=post,domain=a.test
+||tracker.test/important$method=post,important,domain=a.test
+@@||tracker.test/important$domain=a.test
+||ads.test/shared.js$script,redirect=noop.js,domain=a.test
+||ads.test/shared.js$script,redirect=noop.json,domain=b.test
+||ads.test/priority.js$script
+||ads.test/priority.js$redirect-rule=noop.js:-4
+||ads.test/priority.js$redirect-rule=noop.json:12
+||ads.test/negative.js$script
+||ads.test/negative.js$redirect-rule=noop.js:-1
+||ads.test/negative.js$redirect-rule=noop.json:-9
+||ads.test/exception.js$important,script
+||ads.test/exception.js$redirect-rule=noop.js:1
+||ads.test/exception.js$redirect-rule=noop.json:9
+@@||ads.test/exception.js$redirect-rule=noop.json:9
+||alone.test/rule.js$redirect-rule=noop.js,method=post
+||ads.test/method.js$script
+||ads.test/method.js$method=post,redirect-rule=noop.js
+||ads.test/missing.js$script
+||ads.test/missing.js$redirect-rule=noop.js:1
+||ads.test/missing.js$redirect-rule=unknown-surrogate.js:10
+a.test,b.test#?#.promo:has-text(Sponsored)
+a.test#@?#.promo:has-text(Sponsored)
+)RULES";
+  auto engine = Build(rules);
+  CheckSemantics(*engine);
+  const auto* chartbeat = engine->FindResource("chartbeat.js");
+  Expect(chartbeat && chartbeat->body.find("pSUPERFLY") != std::string::npos,
+         "Chartbeat surrogate provides its public API");
+  const auto* gtm = engine->FindResource("googletagmanager_gtm.js");
+  Expect(gtm && gtm->body.size() > 1000,
+         "Google Tag Manager alias resolves to real analytics surrogate");
+  const auto* mp3 = engine->FindResource("noopmp3-0.1s");
+  Expect(mp3 && !mp3->body.empty(), "audio redirect contains playable bytes");
+  Expect(!engine->FindResource("unimplemented-surrogate.js"),
+         "unknown JavaScript surrogate remains explicitly unavailable");
+
+  const std::vector<FilterSource> sources{{"custom", "test", rules}};
+  std::string serialized = engine->Serialize(Engine::SourceDigest(sources, ""));
+  auto restored = Engine::Deserialize(serialized, {});
+  Expect(!!restored, "versioned metadata and cosmetic exception cache loads");
+  if (restored) {
+    CheckSemantics(*restored);
+    Expect(restored->FindResource("chartbeat.js") &&
+               restored->FindResource("chartbeat.js")->body == chartbeat->body,
+           "bundled surrogate body survives cache roundtrip");
+    auto twice = Engine::Deserialize(restored->Serialize("roundtrip"), {});
+    Expect(!!twice, "deserialized engine serializes again without lost indexes");
+    if (twice) {
+      CheckSemantics(*twice);
+    }
+  }
+  serialized.back() ^= 1;
+  Expect(!Engine::Deserialize(serialized, {}), "damaged cache payload is rejected");
+  std::cout << "SUMMARY " << assertions - failures << '/' << assertions
+            << " assertions passed\n";
+  return failures ? 1 : 0;
+}
