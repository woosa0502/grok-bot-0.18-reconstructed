+bool SessionService::CanRestoreLastSessionForAside(Browser* browser) const {
+  // A different pager may still own actual detached tabs. Do not replay its
+  // disk copy, or replay LAST over windows already restored in this process.
+  return !profile()->restored_last_session() && aside_parked_windows_.empty() &&
+         !HasOpenTrackableBrowsers(browser->session_id());
+}
