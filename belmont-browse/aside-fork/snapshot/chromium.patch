+std::vector<std::unique_ptr<sessions::SessionWindow>>
+SessionService::GetOrphanedAsideWindows() {
+  std::vector<std::unique_ptr<sessions::SessionCommand>> commands;
+  for (const auto& [id, parked] : aside_parked_windows_) {
+    if (!parked.owner) {
+      for (const auto& command : parked.commands) {
+        commands.push_back(command->Clone());
+      }
+    }
+  }
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active_window_id = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded_window_ids;
+  sessions::RestoreSessionFromCommands(commands, &windows, &active_window_id,
+                                      &platform_session_id,
+                                      &discarded_window_ids);
+  RemoveUnusedRestoreWindows(&windows);
+  return windows;
+}
+
+void SessionService::DidRestoreOrphanedAsideWindows(
+    const std::vector<SessionID>& window_ids) {
+  for (SessionID id : window_ids) {
+    auto it = aside_parked_windows_.find(id);
+    if (it != aside_parked_windows_.end() && !it->second.owner) {
+      aside_parked_windows_.erase(it);
+    }
+  }
+  ResetFromCurrentBrowsers();
+}
