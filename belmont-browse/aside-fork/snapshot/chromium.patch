+void BrowserView::LayoutVerticalTabStripAdjacentPaneDecoration() {
+  if (!vertical_tab_strip_adjacent_pane_decoration_ || !contents_container_) {
+    return;
+  }
+  const bool visible = vertical_tab_strip_region_view_ &&
+                       vertical_tab_strip_region_view_->GetVisible() &&
+                       !IsVerticalTabStripCollapsed() &&
+                       !vertical_tab_strip_region_view_->bounds().IsEmpty() &&
+                       multi_contents_view_ &&
+                       multi_contents_view_->IsInSplitView();
+  vertical_tab_strip_adjacent_pane_decoration_->SetVisible(visible);
+  if (!visible) {
+    return;
+  }
+  // A thin strip along the leading edge of the contents area, from the top of
+  // the contents to its bottom.
+  constexpr int kSeamWidth = 6;
+  const gfx::Rect contents = contents_container_->bounds();
+  gfx::Rect seam(contents.x(), contents.y(), kSeamWidth, contents.height());
+  if (base::i18n::IsRTL()) {
+    seam.set_x(contents.right() - kSeamWidth);
+  }
+  vertical_tab_strip_adjacent_pane_decoration_->SetBoundsRect(seam);
 }
 
