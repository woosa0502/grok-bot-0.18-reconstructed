+bool LocationBarView::IsBromiumPage() const {
+  const content::WebContents* const contents =
+      const_cast<LocationBarView*>(this)->GetWebContentsForPageActionIconView();
+  if (!contents) {
+    return false;
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  return url.SchemeIs("chrome-extension") && url.host() == kAsideExtensionHost &&
+         url.path() == kAsideNewTabPath;
+}
+
+void LocationBarView::ScheduleBromiumLocationBarRefreshRetries() {
+  if (!IsBromiumPage()) {
+    bromium_location_bar_refresh_retries_ = 0;
+    bromium_location_bar_refresh_timer_.Stop();
+    return;
+  }
+  bromium_location_bar_refresh_retries_ = kAsideBromiumRefreshRetries;
+  bromium_location_bar_refresh_timer_.Start(
+      FROM_HERE, kAsideBromiumRefreshInterval,
+      base::BindRepeating(&LocationBarView::RunBromiumLocationBarRefreshRetry,
+                          base::Unretained(this)));
+}
+
+void LocationBarView::RunBromiumLocationBarRefreshRetry() {
+  if (--bromium_location_bar_refresh_retries_ <= 0) {
+    bromium_location_bar_refresh_timer_.Stop();
+    bromium_location_bar_refresh_retries_ = 0;
+  }
+  RefreshPageActionIconViews();
+  OnChanged();
+}
