+TEST_F(CookieControlsUserBypassTest,
+       RebindSettingsStopsObservingSourceAndResetsTabState) {
+  NavigateAndCommit(GURL(kUrl));
+  EXPECT_CALL(*mock(), OnStatusChanged(testing::_, testing::_, testing::_));
+  EXPECT_CALL(*mock(), OnCookieControlsIconStatusChanged(
+                           testing::_, testing::_, testing::_));
+  cookie_controls()->Update(web_contents());
+  testing::Mock::VerifyAndClearExpectations(mock());
+
+  cookie_controls()->SetStateChangedViaBypass(true);
+  ASSERT_TRUE(cookie_controls()->StateChangedViaBypass());
+
+  TestingProfile* target_profile = CreateTargetProfileForRebind();
+  target_profile->GetPrefs()->SetInteger(
+      prefs::kCookieControlsMode,
+      static_cast<int>(
+          content_settings::CookieControlsMode::kBlockThirdParty));
+  auto target_cookie_settings =
+      CookieSettingsFactory::GetForProfile(target_profile);
+  cookie_controls()->RebindSettingsForAside(
+      target_cookie_settings, nullptr,
+      HostContentSettingsMapFactory::GetForProfile(target_profile));
+
+  EXPECT_FALSE(cookie_controls()->StateChangedViaBypass());
+
+  EXPECT_CALL(*mock(), OnStatusChanged(testing::_, testing::_, testing::_));
+  EXPECT_CALL(*mock(), OnCookieControlsIconStatusChanged(
+                           testing::_, testing::_, testing::_));
+  cookie_controls()->Update(web_contents());
+  testing::Mock::VerifyAndClearExpectations(mock());
+
+  // A source-profile preference update must no longer reach the controller.
+  EXPECT_CALL(*mock(), OnStatusChanged(testing::_, testing::_, testing::_))
+      .Times(0);
+  EXPECT_CALL(*mock(), OnCookieControlsIconStatusChanged(
+                           testing::_, testing::_, testing::_))
+      .Times(0);
+  profile()->GetPrefs()->SetInteger(
+      prefs::kCookieControlsMode,
+      static_cast<int>(content_settings::CookieControlsMode::kOff));
+  testing::Mock::VerifyAndClearExpectations(mock());
+
+  // The destination CookieSettings is observed after the rebind. As for the
+  // original profile (see PreferenceDisabled), a cookie-controls preference
+  // change reaches observers through UpdateUserBypass(), which only reports
+  // the icon status; OnStatusChanged() is not emitted on this path.
+  EXPECT_CALL(*mock(), OnStatusChanged(testing::_, testing::_, testing::_))
+      .Times(0);
+  EXPECT_CALL(*mock(), OnCookieControlsIconStatusChanged(
+                           /*icon_visible=*/false,
+                           CookieControlsState::kHidden,
+                           /*should_highlight=*/false));
+  target_profile->GetPrefs()->SetInteger(
+      prefs::kCookieControlsMode,
+      static_cast<int>(content_settings::CookieControlsMode::kOff));
+  testing::Mock::VerifyAndClearExpectations(mock());
+}
