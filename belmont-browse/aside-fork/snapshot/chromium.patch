+  AsideSessionTestClient aside(true);
+  AsideSessionObserver observer(agent.get());
+  DevToolsAgentHost::AddObserver(&observer);
+  ASSERT_TRUE(agent->AttachClient(&developer));
+  EXPECT_FALSE(agent->HasSecureRemoteDebuggingSession());
+  EXPECT_EQ(1, observer.attached);
+  EXPECT_EQ(0, observer.secure_changes);
+  ASSERT_TRUE(agent->AttachClient(&aside));
+  EXPECT_TRUE(agent->HasSecureRemoteDebuggingSession());
+  EXPECT_EQ(1, observer.attached);
+  EXPECT_EQ(1, observer.secure_changes);
+  agent->ForceDetachSecureRemoteDebuggingSessions();
+  EXPECT_TRUE(aside.closed);
+  EXPECT_FALSE(developer.closed);
+  EXPECT_FALSE(agent->HasSecureRemoteDebuggingSession());
+  EXPECT_TRUE(agent->IsAttached());
+  EXPECT_EQ(0, observer.detached);
+  EXPECT_EQ(2, observer.secure_changes);
+  EXPECT_TRUE(agent->DetachClient(&developer));
+  EXPECT_FALSE(agent->IsAttached());
+  EXPECT_EQ(1, observer.detached);
+  EXPECT_EQ(2, observer.secure_changes);
+  DevToolsAgentHost::RemoveObserver(&observer);
+}
+
+TEST_F(DevToolsAgentHostImplTest, AsideAuthenticationFollowsAttachedTarget) {
+  auto target = DevToolsAgentHost::GetOrCreateFor(web_contents());
+  for (bool secure : {false, true}) {
+    auto browser = DevToolsAgentHost::CreateForBrowser(
+        nullptr, DevToolsAgentHost::CreateServerSocketCallback());
+    AsideSessionTestClient client(secure);
+    ASSERT_TRUE(browser->AttachClient(&client));
+    const std::string command =
+        "{\"id\":1,\"method\":\"Target.attachToTarget\",\"params\":{\"targetId\":\"" +
+        target->GetId() + "\",\"flatten\":true}}";
+    browser->DispatchProtocolMessage(&client, base::as_byte_span(command));
+    EXPECT_TRUE(target->IsAttached());
+    EXPECT_EQ(secure, target->HasSecureRemoteDebuggingSession());
+    target->ForceDetachSecureRemoteDebuggingSessions();
+    EXPECT_FALSE(target->HasSecureRemoteDebuggingSession());
+    EXPECT_EQ(!secure, target->IsAttached());
+    EXPECT_TRUE(browser->DetachClient(&client));
+    EXPECT_FALSE(target->IsAttached());
+  }
+}
