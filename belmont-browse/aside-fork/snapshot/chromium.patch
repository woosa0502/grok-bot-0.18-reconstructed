+// O01: the empty bookmarks state is a dashed rounded rectangle ("Drag tabs
+// here to add bookmarks"). views has no dashed border, so paint one.
+class DashedRoundedBorder : public views::Border {
+ public:
+  DashedRoundedBorder(ui::ColorId color_id, float corner_radius,
+                      const gfx::Insets& insets)
+      : color_id_(color_id), corner_radius_(corner_radius), insets_(insets) {}
+  DashedRoundedBorder(const DashedRoundedBorder&) = delete;
+  DashedRoundedBorder& operator=(const DashedRoundedBorder&) = delete;
+  ~DashedRoundedBorder() override = default;
+
+  void Paint(const views::View& view, gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.0f);
+    flags.setAntiAlias(true);
+    flags.setColor(view.GetColorProvider()->GetColor(color_id_));
+    const SkScalar intervals[] = {4.0f, 3.0f};
+    flags.setPathEffect(cc::PathEffect::MakeDash(intervals, 2, 0));
+    gfx::RectF bounds(view.GetLocalBounds());
+    bounds.Inset(0.5f);
+    canvas->DrawRoundRect(bounds, corner_radius_, flags);
+  }
+  gfx::Insets GetInsets() const override { return insets_; }
+  gfx::Size GetMinimumSize() const override { return gfx::Size(); }
+
+ private:
+  const ui::ColorId color_id_;
+  const float corner_radius_;
+  const gfx::Insets insets_;
+};
