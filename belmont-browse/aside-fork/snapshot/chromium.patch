+std::unique_ptr<AsideTextButton> MakeIconTextButton(
+    views::Button::PressedCallback callback,
+    const std::u16string& text,
+    const gfx::VectorIcon& icon) {
+  // use_text_color_for_icon=false so the leading icon keeps its own muted-gray
+  // color instead of following the (accent) label color, matching O01 where the
+  // row icon is gray and the label is dark.
+  auto button = std::make_unique<AsideTextButton>(
+      std::move(callback), text, views::style::CONTEXT_BUTTON_MD,
+      /*use_text_color_for_icon=*/false);
+  button->SetStyle(ui::ButtonStyle::kText);
+  button->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(icon, kColorAsideMutedForeground,
+                                     kIconSize));
+  button->SetLabelFontList(
+      aside::UiFontList(13, gfx::Font::Weight::MEDIUM));
+  return button;
+}
