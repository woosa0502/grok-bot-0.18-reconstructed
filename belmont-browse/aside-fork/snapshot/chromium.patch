+void LocationBarView::UpdateAsidePageTitleSuffix() {
+  // Only the display-only label is changed here. In particular, OnChanged()
+  // may run after SetOmniboxAdditionalText() during match selection, so it must
+  // not clear or recolor that label even while this suffix is hidden.
+  if (!IsInitialized() || !aside_page_title_view_ || !omnibox_view_) {
+    return;
+  }
+  std::u16string suffix;
+  const bool editing =
+      omnibox_view_->HasFocus() ||
+      GetOmniboxController()->edit_model()->user_input_in_progress() ||
+      GetOmniboxController()->edit_model()->is_caret_visible() ||
+      GetOmniboxController()->IsPopupOpen() ||
+      ime_inline_autocomplete_view_->GetVisible() ||
+      omnibox_additional_text_view_->GetVisible();
+  content::WebContents* const contents = GetWebContents();
+  if (contents && !editing && !IsBromiumPage()) {
+    const std::u16string title = contents->GetTitle();
+    const GURL& url = contents->GetLastCommittedURL();
+    // Before a page's real <title> parses, WebContents::GetTitle() falls back to
+    // a display form of the URL (typically the host). In that window the domain
+    // is already shown by the omnibox, so appending the same text would read as
+    // a redundant "domain | domain". Suppress the suffix whenever the title
+    // matches what the omnibox already displays or the URL host; the real title
+    // is picked up on the next refresh (page-load trickle / tab change / focus).
+    const std::u16string omnibox_text(omnibox_view_->GetText());
+    const bool title_is_url_fallback =
+        title == omnibox_text || title == base::ASCIIToUTF16(url.host());
+    if (!title.empty() && !title_is_url_fallback && url.is_valid() &&
+        !url.IsAboutBlank() &&
+        (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile() ||
+         url.SchemeIs("chrome-extension"))) {
+      suffix = std::u16string(u"  |  ") + title;
+    }
+  }
+  SetOmniboxAdjacentText(aside_page_title_view_, suffix);
+}
