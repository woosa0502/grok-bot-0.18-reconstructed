+    delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, views::BubbleBorder::BOTTOM_LEFT);
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetShowCloseButton(false);
+    delegate_->SetShowTitle(false);
+    delegate_->set_margins(gfx::Insets());
+    delegate_->SetContentsView(std::make_unique<AsideProfileMenuView>(browser));
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(),
+        base::BindOnce(&AsideProfileMenuController::OnClosed,
+                       base::Unretained(this)));
+    widget_->Show();
+  }
+
+  ~AsideProfileMenuController() = default;
+
+ private:
+  void OnClosed(views::Widget::ClosedReason) {
+    // Close can reenter while Hide() notifies native activation observers.
+    // Keep handling it here until deferred destruction actually runs.
+    widget_->MakeCloseSynchronous(base::BindOnce(
+        &AsideProfileMenuController::OnClosed, base::Unretained(this)));
+    if (closing_) {
+      return;
+    }
+    closing_ = true;
+    // The bubble activation observer is still using its delegate after this
+    // callback returns. Keep both widget and delegate alive until that stack
+    // unwinds, including nested native event loops (DeleteSoon is non-nestable).
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+    widget_->Hide();
+  }
+
+  bool closing_ = false;
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+};
+
+// Backs the "Edit profile" and "Delete profile?" dialogs.
+class ProfileDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit ProfileDialogDelegate(const base::FilePath& path) : path_(path) {}
+
+  void OnRename() {
+    ProfileAttributesEntry* entry = EntryForPath(path_);
+    if (!entry) {
+      return;
+    }
+    const std::u16string name =
+        dialog_model()->GetTextfieldByUniqueId(kEditProfileNameFieldId)->text();
+    if (!name.empty()) {
+      entry->SetLocalProfileName(name, /*is_default_name=*/false);
+    }
+  }
+
+  void OnDelete() {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (!manager) {
+      return;
+    }
+    manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+        path_, base::DoNothing(),
+        ProfileMetrics::DELETE_PROFILE_SETTINGS);
+  }
+
+ private:
+  const base::FilePath path_;
+};
