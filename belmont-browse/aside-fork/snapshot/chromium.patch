+void ToolbarActionsModel::MaybeInitializeAsidePins() {
+  // Aside: auto-pin the password manager and the agent ("Ask Aside") actions
+  // the first time we see them.
+  if (!profile_->IsOffTheRecord()) {
+    const std::pair<const char*, const char*> kAsideAutoPinned[] = {
+        {kAsidePasswordManagerExtensionId,
+         kAsidePasswordManagerToolbarPinInitializedPref},
+        {kAsideAgentExtensionId, kAsideAgentToolbarPinInitializedPref},
+    };
+    for (const auto& [extension_id_literal, pref_key] : kAsideAutoPinned) {
+      const extensions::ExtensionId extension_id(extension_id_literal);
+      if (!action_ids_.contains(extension_id)) {
+        continue;
+      }
+      bool pin_initialized = false;
+      if (extension_prefs_->ReadPrefAsBoolean(extension_id, pref_key,
+                                            &pin_initialized) &&
+          pin_initialized) {
+        continue;
+      }
+      extension_prefs_->UpdateExtensionPref(extension_id, pref_key,
+                                           base::Value(true));
+      auto stored_pinned_actions = extension_prefs_->GetPinnedExtensions();
+      if (!std::ranges::contains(stored_pinned_actions, extension_id)) {
+        stored_pinned_actions.push_back(extension_id);
+        extension_prefs_->SetPinnedExtensions(stored_pinned_actions);
+      }
+    }
+  }
