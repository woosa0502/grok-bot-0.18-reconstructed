+    ready_version_ = version;
+    ready_dir_ = install_dir;
+    ready_manifest_ = std::move(manifest);
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  base::ScopedTempDir install_dir_;
+  int ready_count_ = 0;
+  AsideComponentKind ready_kind_ = AsideComponentKind::kDaemon;
+  base::Version ready_version_;
+  base::FilePath ready_dir_;
+  base::DictValue ready_manifest_;
+};
+
+TEST_F(AsideComponentInstallerPolicyTest, RejectsMissingMalformedOrOtherKey) {
+  AsideComponentInstallerPolicy policy(AsideComponentKind::kPasswordManager,
+                                      ReadyCallback());
+  for (const char* key : {"", "invalid key !", kAgentManagerKey}) {
+    auto manifest = MakeManifest(key);
+    EXPECT_FALSE(policy.VerifyInstallation(manifest, install_dir_.GetPath()));
+    policy.ComponentReady(base::Version("1.26.907.1712"),
+                          install_dir_.GetPath(), std::move(manifest));
+  }
+  auto missing_key = MakeManifest(kPasswordManagerKey);
+  missing_key.Remove("key");
+  EXPECT_FALSE(policy.VerifyInstallation(missing_key, install_dir_.GetPath()));
+  policy.ComponentReady(base::Version("1.26.907.1712"), install_dir_.GetPath(),
+                        std::move(missing_key));
+  EXPECT_EQ(ready_count_, 0);
+}
+
+TEST_F(AsideComponentInstallerPolicyTest, RequiresManifestFileAndAbsolutePath) {
+  AsideComponentInstallerPolicy policy(AsideComponentKind::kPasswordManager,
+                                      ReadyCallback());
+  auto manifest = MakeManifest(kPasswordManagerKey);
+  EXPECT_FALSE(policy.VerifyInstallation(
+      manifest, install_dir_.GetPath().AppendASCII("absent")));
+  policy.ComponentReady(base::Version("1.26.907.1712"),
+                        base::FilePath(FILE_PATH_LITERAL("relative")),
+                        std::move(manifest));
+  EXPECT_EQ(ready_count_, 0);
+}
+
+TEST_F(AsideComponentInstallerPolicyTest, PreservesVerifiedManifestAndIdentity) {
+  for (auto [kind, key] : {
+           std::pair{AsideComponentKind::kPasswordManager, kPasswordManagerKey},
+           std::pair{AsideComponentKind::kAgentManager, kAgentManagerKey}}) {
+    AsideComponentInstallerPolicy policy(kind, ReadyCallback());
+    auto manifest = MakeManifest(key);
+    EXPECT_TRUE(policy.VerifyInstallation(manifest, install_dir_.GetPath()));
+    policy.ComponentReady(base::Version("1.26.907.1712"),
+                          install_dir_.GetPath(), manifest.Clone());
+    EXPECT_EQ(ready_kind_, kind);
+    EXPECT_EQ(ready_version_, base::Version("1.26.907.1712"));
+    EXPECT_EQ(ready_dir_, install_dir_.GetPath());
+    EXPECT_EQ(ready_manifest_, manifest);
+  }
+  EXPECT_EQ(ready_count_, 2);
+  EXPECT_EQ(AsideComponentAppId(AsideComponentKind::kPasswordManager),
+            "clcdgiameigmljcbkkcbjiljinmfkncl");
+  EXPECT_EQ(AsideComponentAppId(AsideComponentKind::kAgentManager),
+            "fjdhphbdlfjogobdofoaagnlnkoibdge");
+}
+
+TEST_F(AsideComponentInstallerPolicyTest,
+       LoadsExactPinnedPairAndPreservesNewerFilesByteForByte) {
+  const ComponentFiles pinned_agent = WriteComponent(
+      install_dir_.GetPath(), AsideComponentKind::kAgentManager,
+      kPinnedVersion, MakeManifest(kAgentManagerKey));
+  const ComponentFiles pinned_password = WriteComponent(
+      install_dir_.GetPath(), AsideComponentKind::kPasswordManager,
+      kPinnedVersion, MakeManifest(kPasswordManagerKey));
+  const ComponentFiles newer_agent = WriteComponent(
+      install_dir_.GetPath(), AsideComponentKind::kAgentManager, kNewerVersion,
+      MakeManifest(kAgentManagerKey, kNewerVersion));
+  const ComponentFiles newer_password = WriteComponent(
+      install_dir_.GetPath(), AsideComponentKind::kPasswordManager,
+      kNewerVersion, MakeManifest(kPasswordManagerKey, kNewerVersion));
+
+  auto components = LoadAsidePinnedComponents(
+      install_dir_.GetPath(), base::Version(kPinnedVersion));
+
+  ASSERT_TRUE(components.has_value());
+  ASSERT_EQ(components->size(), 2u);
+  EXPECT_EQ((*components)[0].kind, AsideComponentKind::kAgentManager);
+  EXPECT_EQ((*components)[0].install_dir, pinned_agent.install_dir);
+  const std::string* agent_version =
+      (*components)[0].manifest.FindString("version");
+  ASSERT_NE(agent_version, nullptr);
+  EXPECT_EQ(*agent_version, kPinnedVersion);
+  EXPECT_EQ((*components)[1].kind, AsideComponentKind::kPasswordManager);
+  EXPECT_EQ((*components)[1].install_dir, pinned_password.install_dir);
+  const std::string* password_version =
+      (*components)[1].manifest.FindString("version");
+  ASSERT_NE(password_version, nullptr);
+  EXPECT_EQ(*password_version, kPinnedVersion);
+
+  for (const ComponentFiles* files : {&pinned_agent, &pinned_password,
+                                      &newer_agent, &newer_password}) {
+    ExpectFileBytes(files->install_dir.AppendASCII("manifest.json"),
+                    files->manifest_bytes);
+    ExpectFileBytes(files->install_dir.AppendASCII("payload.bin"),
+                    files->payload_bytes);
+  }
+}
+
+TEST_F(AsideComponentInstallerPolicyTest,
+       RejectsIncompletePinnedPairWithoutFallingBackToNewer) {
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kAgentManager,
+                 kPinnedVersion, MakeManifest(kAgentManagerKey));
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kAgentManager,
+                 kNewerVersion,
+                 MakeManifest(kAgentManagerKey, kNewerVersion));
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kPasswordManager,
+                 kNewerVersion,
+                 MakeManifest(kPasswordManagerKey, kNewerVersion));
+
+  EXPECT_FALSE(LoadAsidePinnedComponents(install_dir_.GetPath(),
+                                         base::Version(kPinnedVersion))
+                   .has_value());
+}
+
+TEST_F(AsideComponentInstallerPolicyTest,
+       RejectsPinnedPairWithSwappedSigningKeys) {
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kAgentManager,
+                 kPinnedVersion, MakeManifest(kPasswordManagerKey));
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kPasswordManager,
+                 kPinnedVersion, MakeManifest(kAgentManagerKey));
+
+  EXPECT_FALSE(LoadAsidePinnedComponents(install_dir_.GetPath(),
+                                         base::Version(kPinnedVersion))
+                   .has_value());
+}
+
+TEST_F(AsideComponentInstallerPolicyTest,
+       RejectsManifestVersionDifferentFromPinnedDirectory) {
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kAgentManager,
+                 kPinnedVersion,
+                 MakeManifest(kAgentManagerKey, kNewerVersion));
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kPasswordManager,
+                 kPinnedVersion, MakeManifest(kPasswordManagerKey));
+
+  EXPECT_FALSE(LoadAsidePinnedComponents(install_dir_.GetPath(),
+                                         base::Version(kPinnedVersion))
+                   .has_value());
+}
+
+TEST_F(AsideComponentInstallerPolicyTest,
+       RejectsParsedManifestThatExtensionValidationRejects) {
+  auto malformed_manifest = MakeManifest(kAgentManagerKey);
+  malformed_manifest.Remove("name");
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kAgentManager,
+                 kPinnedVersion, std::move(malformed_manifest));
+  WriteComponent(install_dir_.GetPath(), AsideComponentKind::kPasswordManager,
+                 kPinnedVersion, MakeManifest(kPasswordManagerKey));
+
+  EXPECT_FALSE(LoadAsidePinnedComponents(install_dir_.GetPath(),
+                                         base::Version(kPinnedVersion))
+                   .has_value());
+}
+
+TEST_F(AsideComponentInstallerPolicyTest,
+       RejectsInvalidVersionAndRelativeUserDataPath) {
+  EXPECT_FALSE(LoadAsidePinnedComponents(install_dir_.GetPath(), base::Version())
+                   .has_value());
+  EXPECT_FALSE(LoadAsidePinnedComponents(
+                   base::FilePath(FILE_PATH_LITERAL("relative")),
+                   base::Version(kPinnedVersion))
+                   .has_value());
+}
+
+}  // namespace
+}  // namespace component_updater
