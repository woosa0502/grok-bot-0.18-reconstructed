+IN_PROC_BROWSER_TEST_F(AsideBookmarkCorrectnessBrowserTest,
+                       ActivationResolvesReorderedTabBeforeRefresh) {
+  const GURL target("about:blank#represented");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), target));
+  TabStripModel* strip = browser()->tab_strip_model();
+  tabs::TabInterface* represented = strip->GetActiveTab();
+  const BookmarkNode* node = AddBookmark(model_, u"Represented", target);
+  chrome::AddTabAt(browser(), GURL("about:blank#unrelated"), -1, true);
+  AsideBookmarkTabRepresentation representation(browser());
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(representation.IsNodeRepresentingOpenTab(node->id()));
+
+  const int old_index = strip->GetIndexOfTab(represented);
+  strip->MoveWebContentsAt(old_index, strip->count() - 1, false);
+  // Deliberately do not drain the scheduled refresh after the move.
+  ASSERT_NE(old_index, strip->GetIndexOfTab(represented));
+  ASSERT_NE(represented, strip->GetTabAtIndex(old_index));
+  EXPECT_EQ(represented, representation.FindTabForNode(node->id()));
+}
+
+IN_PROC_BROWSER_TEST_F(AsideBookmarkCorrectnessBrowserTest,
+                       ActivationRejectsDetachedOrEditedTargetBeforeRefresh) {
+  const GURL target("about:blank#represented");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), target));
+  TabStripModel* strip = browser()->tab_strip_model();
+  tabs::TabInterface* represented = strip->GetActiveTab();
+  const BookmarkNode* node = AddBookmark(model_, u"Represented", target);
+  chrome::AddTabAt(browser(), GURL("about:blank#other-a"), -1, true);
+  chrome::AddTabAt(browser(), GURL("about:blank#other-b"), -1, true);
+  AsideBookmarkTabRepresentation representation(browser());
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(represented, representation.FindTabForNode(node->id()));
+
+  model_->SetURL(node, GURL("about:blank#changed-bookmark"),
+                 bookmarks::metrics::BookmarkEditSource::kUser);
+  EXPECT_EQ(nullptr, representation.FindTabForNode(node->id()));
+  model_->SetURL(node, target, bookmarks::metrics::BookmarkEditSource::kUser);
+  EXPECT_EQ(represented, representation.FindTabForNode(node->id()));
+
+  const int old_index = strip->GetIndexOfTab(represented);
+  auto detached = strip->DetachTabAtForInsertion(old_index);
+  ASSERT_LT(old_index, strip->count());
+  EXPECT_NE(represented, strip->GetTabAtIndex(old_index));
+  EXPECT_EQ(nullptr, representation.FindTabForNode(node->id()));
+}
