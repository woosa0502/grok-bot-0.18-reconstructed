+ExtensionId ComponentLoader::AddOrReplace(
+    base::DictValue manifest,
+    const base::FilePath& root_directory) {
+  ComponentExtensionInfo info(std::move(manifest), root_directory);
+  if (!ignore_allowlist_for_testing_ &&
+      !IsComponentExtensionAllowlisted(info.extension_id)) {
+    return std::string();
+  }
+
+  auto existing = std::ranges::find(component_extensions_, info.extension_id,
+                                    &ComponentExtensionInfo::extension_id);
+  if (existing == component_extensions_.end()) {
+    component_extensions_.push_back(std::move(info));
+    existing = std::prev(component_extensions_.end());
+  } else {
+    // Remove() emits an uninstall event, which would clear alarms, pins, and
+    // service-worker storage. The registrar handles an already-loaded ID as
+    // an update when Load() supplies the replacement extension instead.
+    *existing = std::move(info);
+  }
+  const ExtensionId id = existing->extension_id;
+  if (extension_system_->is_ready()) {
+    Load(*existing);
+  }
+  return id;
+}
