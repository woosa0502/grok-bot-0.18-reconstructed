+namespace {
+
+// Finalize only after the specific native restorer has been destroyed. A
+// profile-wide restored notification can fire for unrelated foreign restores.
+void CompleteAsideProfileSwitch(base::WeakPtr<Browser> weak_browser) {
+  Browser* browser = weak_browser.get();
+  if (!browser || browser->IsDeleteScheduled()) {
+    return;
+  }
+  if (browser->tab_strip_model()->empty()) {
+    AddTabAt(browser, GURL(), /*index=*/-1, /*foreground=*/true);
+  }
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfile(browser->profile())) {
+    session->ResumeWindowForAside(browser);
+    session->SetSelectedTabInWindow(
+        browser->session_id(), browser->tab_strip_model()->active_index());
+    session->ResetFromCurrentBrowsers();
+  }
+  browser->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+  if (browser->IsActive()) {
+    BrowserManagerServiceFactory::GetForProfile(browser->profile())
+        ->NotifyBrowserActivatedForAsideProfileSwitch(browser);
+  }
+  browser->CompleteAsideProfileSwitch();
+}
+
+// Second half of the pager, once the target profile is on disk and loaded.
+void FinishAsideProfileSwitch(base::WeakPtr<Browser> weak_browser,
+                              Profile* profile) {
+  Browser* browser = weak_browser.get();
+  if (!browser || browser->IsDeleteScheduled()) {
+    return;
+  }
+  if (!profile || profile == browser->profile()) {
+    browser->CompleteAsideProfileSwitch();
+    return;
+  }
+  if (SessionRestore::IsRestoring(profile)) {
+    // The source remains usable until the destination profile is idle. Keep
+    // the target alive, and recheck on delivery as another pager may win first.
+    auto keep_alive = std::make_unique<ScopedProfileKeepAlive>(
+        profile, ProfileKeepAliveOrigin::kBrowserWindow);
+    SessionRestore::RunWhenIdleForAside(
+        profile, base::BindOnce(
+                     [](base::WeakPtr<Browser> weak,
+                        std::unique_ptr<ScopedProfileKeepAlive> target) {
+                       FinishAsideProfileSwitch(weak, target->profile());
+                     },
+                     weak_browser, std::move(keep_alive)));
+    return;
+  }
+
+  Profile* const old_profile = browser->profile();
+  std::unique_ptr<ScopedProfileKeepAlive> old_profile_keep_alive;
+  if (!old_profile->IsOffTheRecord()) {
+    // SetProfileForAsideProfileSwitch() replaces the Browser's primary
+    // keepalive. Keep the source alive independently until all source
+    // collection callbacks and window-feature rebinds have released their
+    // old profile services, even when the source tab strip was empty.
+    old_profile_keep_alive = std::make_unique<ScopedProfileKeepAlive>(
+        old_profile->GetOriginalProfile(),
+        ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+  browser->StashTabsForAsideProfileSwitch();
+  std::unique_ptr<Browser> owned =
+      BrowserManagerServiceFactory::GetForProfile(old_profile)
+          ->ReleaseBrowserForAsideProfileSwitch(browser);
+  if (!owned) {
+    browser->RestoreTabsForAsideProfileSwitch();
+    CompleteAsideProfileSwitch(weak_browser);
+    return;
+  }
+
+  browser->SetProfileForAsideProfileSwitch(profile);
+  BrowserManagerServiceFactory::GetForProfile(profile)
+      ->AddBrowserForAsideProfileSwitch(std::move(owned));
+  browser->NotifyAsideProfileSwitchedAfterAdoption();
+  if (!weak_browser || weak_browser->IsDeleteScheduled()) {
+    return;
+  }
+
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    if (local_state->FindPreference("aside.last_active_profile")) {
+      local_state->SetString("aside.last_active_profile",
+                            profile->GetBaseName().AsUTF8Unsafe());
+    }
+  }
+
+  if (browser->RestoreTabsForAsideProfileSwitch() == 0) {
+    if (SessionService* session =
+            SessionServiceFactory::GetForProfile(profile)) {
+      auto windows = session->GetOrphanedAsideWindows();
+      if (!windows.empty()) {
+        // Decoded snapshots need no disk IO or nested message loop. Remove
+        // their old IDs only after native restore actually created tabs.
+        auto consumed = SessionRestore::RestoreWindowsForAside(
+            browser, std::move(windows));
+        if (!weak_browser || weak_browser->IsDeleteScheduled()) {
+          return;
+        }
+        session->DidRestoreOrphanedAsideWindows(consumed);
+      } else if (session->CanRestoreLastSessionForAside(browser)) {
+        SessionRestore::RestoreSessionForAside(
+            browser, base::BindOnce(&CompleteAsideProfileSwitch, weak_browser));
+        return;
+      }
+    }
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CompleteAsideProfileSwitch, weak_browser));
+}
+
+}  // namespace
+
+void SwitchProfileInPlaceForAside(Browser* browser,
+                                  const base::FilePath& profile_path) {
+  if (!browser || browser->IsDeleteScheduled() || profile_path.empty()) {
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager || !browser->BeginAsideProfileSwitch(profile_path)) {
+    return;
+  }
+  if (profile_path == browser->profile()->GetPath()) {
+    browser->CompleteAsideProfileSwitch();
+    return;
+  }
+  base::RecordAction(UserMetricsAction("Aside_SwitchProfileInPlace"));
+  manager->CreateProfileAsync(
+      profile_path,
+      base::BindOnce(&FinishAsideProfileSwitch, browser->AsWeakPtr()));
+}
