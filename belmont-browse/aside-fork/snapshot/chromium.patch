+void AsideVerticalTabStripAdditions::SetCollapsed(bool collapsed) {
+  if (collapsed_ == collapsed) {
+    return;
+  }
+  collapsed_ = collapsed;
+  UpdateSectionVisibility();
+}
+
+void AsideVerticalTabStripAdditions::OnChatsToggled() {
+  chats_expanded_ = !chats_expanded_;
+  UpdateSectionVisibility();
+}
+
+void AsideVerticalTabStripAdditions::UpdateSectionVisibility() {
+  chats_divider_->SetVisible(!collapsed_);
+  chats_header_->SetVisible(!collapsed_);
+  tabs_divider_->SetVisible(!collapsed_);
+  tabs_header_->SetVisible(!collapsed_);
+  // Original 825.1/907: closing Chats hides recents but leaves New Chat.
+  chats_content_->SetVisible(true);
+  tabs_content_->SetVisible(true);
+  UpdateActionButton(new_chat_button_, kNewChat, collapsed_);
+  UpdateActionButton(new_tab_button_, kNewTab, collapsed_);
+  const bool has_recents = !recents_rows_->children().empty();
+  recents_rows_->SetVisible(!collapsed_ && chats_expanded_ && has_recents);
+  // Show more is a full-list action, also available when all three retained
+  // recents fit, as in the original. No empty list placeholder is invented.
+  show_more_row_->SetVisible(!collapsed_ && chats_expanded_ && has_recents);
+  tasks_section_->SetVisible(!collapsed_ && chats_expanded_ &&
+                             !tasks_rows_->children().empty());
+  tab_actions_->SetVisible(!collapsed_);
+  UpdateDisclosure(chats_header_button_, chats_chevron_, chats_expanded_);
+  InvalidateLayout();
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
