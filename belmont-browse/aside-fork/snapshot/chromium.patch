+class AsideBookmarkCorrectnessBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    model_ = ModelFor(browser()->profile());
+    browser()->profile()->GetPrefs()->SetBoolean(
+        bookmarks::prefs::kEditBookmarksEnabled, true);
+  }
+
+  void TearDownOnMainThread() override {
+    model_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  BookmarkModel* ModelFor(Profile* profile) {
+    BookmarkModel* model = BookmarkModelFactory::GetForBrowserContext(profile);
+    bookmarks::test::WaitForBookmarkModelToLoad(model);
+    return model;
+  }
+
+  const BookmarkNode* AddBookmark(BookmarkModel* model,
+                                  const std::u16string& title,
+                                  const GURL& url) {
+    return model->AddURL(model->bookmark_bar_node(),
+                         model->bookmark_bar_node()->children().size(), title,
+                         url);
+  }
+
+  const BookmarkNode* AddFolder(const std::u16string& title) {
+    return model_->AddFolder(model_->bookmark_bar_node(),
+                             model_->bookmark_bar_node()->children().size(),
+                             title);
+  }
+
+  std::unique_ptr<ui::DialogModel> Dialog(int64_t id, BookmarkDialogType type) {
+    return aside::CreateBookmarkDialogModel(browser(), id, type);
+  }
+
+  void Accept(std::unique_ptr<ui::DialogModel> model) {
+    ui::TestDialogModelHost::Accept(
+        std::make_unique<ui::TestDialogModelHost>(std::move(model)));
+  }
+
+  raw_ptr<BookmarkModel> model_ = nullptr;
+};
