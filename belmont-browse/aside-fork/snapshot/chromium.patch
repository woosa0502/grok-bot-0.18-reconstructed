+// AsideMenuItemButton: an icon + label row, optionally with a secondary label
+// on the right (a submenu chevron, a check mark or free text).
+class AsideMenuItemButton : public AsideTextButton {
+  METADATA_HEADER(AsideMenuItemButton, AsideTextButton)
+
+ public:
+  AsideMenuItemButton(views::Button::PressedCallback callback,
+                      const std::u16string& text,
+                      const gfx::VectorIcon* icon,
+                      bool has_submenu = false)
+      // use_text_color_for_icon=false so the leading icon keeps its own gray
+      // instead of following the label color (O01: dark label + gray icon,
+      // not the accent-blue the kText default would give).
+      : AsideTextButton(std::move(callback),
+                        text,
+                        views::style::CONTEXT_BUTTON_MD,
+                        /*use_text_color_for_icon=*/false) {
+    SetStyle(ui::ButtonStyle::kText);
+    SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    SetCustomPadding(gfx::Insets::VH(6, 10));
+    SetImageLabelSpacing(10);
+    SetLabelFontList(aside::UiFontList(13, gfx::Font::Weight::NORMAL));
+    // O01: menu labels are near-black, not the accent color. Explicit
+    // SetTextColor marks the normal color so MdTextButton keeps it.
+    SetTextColor(views::Button::STATE_NORMAL,
+                 kColorAsideSurfacePrimaryForeground);
+    SetTextColor(views::Button::STATE_HOVERED,
+                 kColorAsideSurfacePrimaryForeground);
+    SetTextColor(views::Button::STATE_PRESSED,
+                 kColorAsideSurfacePrimaryForeground);
+    if (icon) {
+      SetImageModel(
+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(*icon, ui::kColorIcon, kIconSize));
+    }
+    SetPreferredSize(gfx::Size(kMenuWidth - 16, 32));
+    if (has_submenu) {
+      SetCustomPadding(gfx::Insets::TLBR(6, 10, 6, 30));
+      auto chevron = std::make_unique<views::ImageView>(
+          ui::ImageModel::FromVectorIcon(kAsideChevronRightMediumStrokeIcon,
+                                        ui::kColorIcon, kIconSize));
+      chevron->SetCanProcessEventsWithinSubtree(false);
+      submenu_chevron_ = AddChildView(std::move(chevron));
+    }
+  }
+  ~AsideMenuItemButton() override = default;
+
+  void SetShortcutText(const std::u16string& text) {
+    if (text.empty()) {
+      return;
+    }
+    auto shortcut = std::make_unique<views::Label>(
+        text, views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY);
+    shortcut->SetFontList(aside::UiFontList(11, gfx::Font::Weight::NORMAL));
+    shortcut->SetHorizontalAlignment(gfx::ALIGN_RIGHT);
+    shortcut->SetCanProcessEventsWithinSubtree(false);
+    shortcut_label_ = AddChildView(std::move(shortcut));
+    const int shortcut_width = shortcut_label_->GetPreferredSize({}).width();
+    SetCustomPadding(gfx::Insets::TLBR(6, 10, 6, 10 + shortcut_width + 12));
+    // Platform shortcuts can be wider than the macOS glyphs in O-03. Let the
+    // menu grow to retain both the full action label and its real shortcut.
+    SetPreferredSize(gfx::Size(
+        std::max(kMenuWidth - 16,
+                 20 + (HasImage(views::Button::STATE_NORMAL) ? kIconSize + 10
+                                                           : 0) +
+                     label()->GetPreferredSize({}).width() + 12 +
+                     shortcut_width),
+        32));
+  }
+
+ private:
+  void Layout(PassKey) override {
+    LayoutSuperclass<AsideTextButton>(this);
+    if (submenu_chevron_) {
+      submenu_chevron_->SetBounds(width() - 10 - kIconSize,
+                                 (height() - kIconSize) / 2, kIconSize,
+                                 kIconSize);
+    }
+    if (shortcut_label_) {
+      const int shortcut_width = shortcut_label_->GetPreferredSize({}).width();
+      shortcut_label_->SetBounds(width() - 10 - shortcut_width, 0,
+                                 shortcut_width, height());
+    }
+  }
+
+  raw_ptr<views::ImageView> submenu_chevron_ = nullptr;
+  raw_ptr<views::Label> shortcut_label_ = nullptr;
+};
