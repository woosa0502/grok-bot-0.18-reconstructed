+// Set the actual model fields by their user-visible labels, using the same
+// host integration API as a rendered dialog. Accept still uses Chromium's
+// TestDialogModelHost and the production delegate.
+class DialogTextFields : public ui::DialogModelHost,
+                         public ui::DialogModelFieldHost {
+ public:
+  static bool Set(ui::DialogModel& model,
+                  const std::u16string& label,
+                  std::u16string text) {
+    for (const auto& field : model.fields(ui::DialogModelHost::GetPassKey())) {
+      if (field->type() == ui::DialogModelField::kTextfield &&
+          field->AsTextfield()->label() == label) {
+        field->AsTextfield()->OnTextChanged(
+            ui::DialogModelFieldHost::GetPassKey(), std::move(text));
+        return true;
+      }
+    }
+    return false;
+  }
+};
+
+class DisableEditingOnBookmarkChange
+    : public bookmarks::BaseBookmarkModelObserver {
+ public:
+  explicit DisableEditingOnBookmarkChange(PrefService* prefs) : prefs_(prefs) {}
+  void BookmarkModelChanged() override {
+    prefs_->SetBoolean(bookmarks::prefs::kEditBookmarksEnabled, false);
+  }
+
+ private:
+  const raw_ptr<PrefService> prefs_;
+};
