+void AsideBookmarksSectionView::Rebuild() {
+  rebuild_weak_factory_.InvalidateWeakPtrs();
+  rebuild_scheduled_ = false;
+  if (extensive_changes_) {
+    // Rows retain node IDs only; model changes still invalidate pending drops
+    // immediately. Recreate the full unbounded tree once after bulk imports.
+    rebuild_pending_ = true;
+    return;
+  }
+  rebuild_pending_ = false;
+  PrefService* prefs = browser_->profile()->GetPrefs();
+  const bool enabled = prefs->GetBoolean(kEnabledPref);
+  const bool expanded = prefs->GetBoolean(kExpandedPref);
+  const bool loaded = bookmark_service_ && bookmark_service_->loaded();
+  SetVisible(enabled && loaded);
+  header_row_->SetVisible(!collapsed_);
+  chevron_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          expanded ? kAsideExpandLessIcon : kAsideExpandMoreIcon,
+          ui::kColorIcon, 14));
+  for (views::View* view : {static_cast<views::View*>(header_.get()),
+                            static_cast<views::View*>(chevron_.get())}) {
+    if (expanded) {
+      view->GetViewAccessibility().SetIsExpanded();
+    } else {
+      view->GetViewAccessibility().SetIsCollapsed();
+    }
+  }
+  rows_->RemoveAllChildViews();
+  row_nodes_.clear();
+  rows_scroll_->SetVisible(expanded);
+  if (enabled && expanded && loaded) {
+    AddNodeRows(BookmarkParentFolder::BookmarkBarFolder(), 0);
+  }
+  // The original shows "Drag tabs here to add bookmarks" only while the section
+  // is open and holds nothing.
+  empty_label_->SetVisible(!collapsed_ && expanded &&
+                           rows_->children().empty());
+  InvalidateLayout();
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
