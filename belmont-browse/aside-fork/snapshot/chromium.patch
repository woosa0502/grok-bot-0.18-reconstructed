+base::DictValue MakeManifest(const char* key,
+                             const char* version = kPinnedVersion) {
+  return base::DictValue()
+      .Set("manifest_version", 3)
+      .Set("name", "Aside component test")
+      .Set("version", version)
+      .Set("key", key)
+      .Set("permissions", base::ListValue().Append("storage"));
+}
+
+base::FilePath ComponentDir(const base::FilePath& user_data_dir,
+                            AsideComponentKind kind,
+                            const char* version) {
+  return user_data_dir.AppendASCII("aside_component")
+      .AppendASCII(AsideComponentToken(kind))
+      .AppendASCII(version);
+}
+
+struct ComponentFiles {
+  base::FilePath install_dir;
+  std::string manifest_bytes;
+  std::string payload_bytes;
+};
+
+ComponentFiles WriteComponent(const base::FilePath& user_data_dir,
+                              AsideComponentKind kind,
+                              const char* directory_version,
+                              base::DictValue manifest) {
+  const base::FilePath install_dir =
+      ComponentDir(user_data_dir, kind, directory_version);
+  CHECK(base::CreateDirectory(install_dir));
+  std::optional<std::string> json = base::WriteJson(manifest);
+  CHECK(json.has_value());
+  std::string manifest_bytes = " \n" + *json + "\n";
+  std::string payload_bytes = "raw payload for " + AsideComponentToken(kind) +
+                              " at " + directory_version + "\n";
+  CHECK(base::WriteFile(install_dir.AppendASCII("manifest.json"),
+                        manifest_bytes));
+  CHECK(base::WriteFile(install_dir.AppendASCII("payload.bin"), payload_bytes));
+  return {install_dir, std::move(manifest_bytes), std::move(payload_bytes)};
+}
+
+void ExpectFileBytes(const base::FilePath& path,
+                     const std::string& expected) {
+  std::string actual;
+  ASSERT_TRUE(base::ReadFileToString(path, &actual));
+  EXPECT_EQ(actual, expected);
+}
