+TEST_F(BookmarksServiceImplTest, RebindPreservesPipesAndChangesModel) {
+  mojom::BookmarksSnapshotPtr snapshot;
+  {
+    base::RunLoop run_loop;
+    remote_service_->GetBookmarks(base::BindOnce(
+        [](mojom::BookmarksSnapshotPtr* out_snapshot,
+           base::OnceClosure quit_closure,
+           mojom::BookmarksService::GetBookmarksResult result) {
+          ASSERT_TRUE(result.has_value());
+          *out_snapshot = std::move(result.value());
+          std::move(quit_closure).Run();
+        },
+        &snapshot, run_loop.QuitClosure()));
+    run_loop.Run();
+  }
+  ASSERT_TRUE(snapshot);
+  TestBookmarksObserver observer(std::move(snapshot->stream));
+
+  auto target_client = std::make_unique<bookmarks::TestBookmarkClient>();
+  auto target_model =
+      std::make_unique<bookmarks::BookmarkModel>(std::move(target_client));
+  target_model->LoadEmptyForTest();
+  const bookmarks::BookmarkNode* target_parent =
+      target_model->bookmark_bar_node();
+  ASSERT_TRUE(target_parent);
+  const bookmarks::BookmarkNode* target_node = target_model->AddURL(
+      target_parent, 0, u"Target", GURL("https://target.example"));
+
+  service_->Rebind(target_model.get(), nullptr);
+
+  observer.WaitForEvent();
+  ASSERT_EQ(observer.events().size(), 1u);
+  EXPECT_EQ(observer.call_count(), 1);
+  ASSERT_TRUE(observer.events()[0]->is_reset());
+  const auto& reset = observer.events()[0]->get_reset();
+  EXPECT_EQ(reset->id, target_model->root_node()->uuid());
+  EXPECT_TRUE(RootContainsUrlWithTitle(*reset, "Target"));
+  observer.ClearEvents();
+
+  // The source translator is gone, so later source changes do not leak to the
+  // preserved observer pipe.
+  model_->AddURL(model_->bookmark_bar_node(), 0, u"Source",
+                 GURL("https://source.example"));
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(observer.events().empty());
+  EXPECT_EQ(observer.call_count(), 0);
+
+  // The existing service pipe now resolves target nodes.
+  base::RunLoop target_lookup_loop;
+  remote_service_->GetBookmark(
+      target_node->uuid(),
+      base::BindOnce(
+          [](base::OnceClosure quit_closure,
+             mojom::BookmarksService::GetBookmarkResult result) {
+            EXPECT_TRUE(result.has_value());
+            if (result.has_value()) {
+              EXPECT_TRUE(result.value()->is_url());
+              if (result.value()->is_url()) {
+                EXPECT_EQ(result.value()->get_url()->title, "Target");
+              }
+            }
+            std::move(quit_closure).Run();
+          },
+          target_lookup_loop.QuitClosure()));
+  target_lookup_loop.Run();
+
+  target_model->AddURL(target_parent, 1, u"Target event",
+                       GURL("https://target-event.example"));
+  observer.WaitForEvent();
+  ASSERT_EQ(observer.events().size(), 1u);
+  EXPECT_EQ(observer.call_count(), 1);
+  ASSERT_TRUE(observer.events()[0]->is_added());
+  EXPECT_EQ(observer.events()[0]->get_added()->node->get_url()->title,
+            "Target event");
+
+  observer.ClearEvents();
+  service_->Rebind(model_.get(), nullptr);
+  observer.WaitForEvent();
+  ASSERT_EQ(observer.events().size(), 1u);
+  EXPECT_EQ(observer.call_count(), 1);
+  ASSERT_TRUE(observer.events()[0]->is_reset());
+  EXPECT_EQ(observer.events()[0]->get_reset()->id, model_->root_node()->uuid());
+  EXPECT_TRUE(
+      RootContainsUrlWithTitle(*observer.events()[0]->get_reset(), "Source"));
+  observer.ClearEvents();
+
+  // A target change after switching back must not leak through the preserved
