+IN_PROC_BROWSER_TEST_F(AsideBookmarkCorrectnessBrowserTest,
+                       EveryDialogRechecksEditingPolicyOnAccept) {
+  const BookmarkNode* folder = AddFolder(u"Original folder");
+  const BookmarkNode* child =
+      model_->AddURL(folder, 0, u"Child", GURL("https://child.example/"));
+  const BookmarkNode* node =
+      AddBookmark(model_, u"Original", GURL("https://original.example/"));
+  std::vector<std::unique_ptr<ui::DialogModel>> dialogs;
+  dialogs.push_back(Dialog(folder->id(), BookmarkDialogType::kRenameFolder));
+  dialogs.push_back(Dialog(folder->id(), BookmarkDialogType::kDeleteFolder));
+  dialogs.push_back(Dialog(node->id(), BookmarkDialogType::kEditBookmark));
+  dialogs.push_back(Dialog(node->id(), BookmarkDialogType::kDeleteBookmark));
+  for (const auto& dialog : dialogs) {
+    ASSERT_TRUE(dialog);
+  }
+  ASSERT_TRUE(DialogTextFields::Set(*dialogs[0], u"Folder name", u"Forbidden"));
+  ASSERT_TRUE(DialogTextFields::Set(*dialogs[2], u"Name", u"Forbidden"));
+  ASSERT_TRUE(DialogTextFields::Set(*dialogs[2], u"URL",
+                                    u"https://forbidden.example/"));
+  const int64_t folder_id = folder->id();
+  const int64_t node_id = node->id();
+  const int64_t child_id = child->id();
+
+  browser()->profile()->GetPrefs()->SetBoolean(
+      bookmarks::prefs::kEditBookmarksEnabled, false);
+  EXPECT_FALSE(aside::CanEditBookmark(browser(), node_id));
+  for (auto& dialog : dialogs) {
+    Accept(std::move(dialog));
+  }
+  ASSERT_EQ(folder, bookmarks::GetBookmarkNodeByID(model_, folder_id));
+  ASSERT_EQ(node, bookmarks::GetBookmarkNodeByID(model_, node_id));
+  EXPECT_EQ(child, bookmarks::GetBookmarkNodeByID(model_, child_id));
+  EXPECT_EQ(u"Original folder", folder->GetTitle());
+  EXPECT_EQ(u"Original", node->GetTitle());
+  EXPECT_EQ(GURL("https://original.example/"), node->url());
+}
