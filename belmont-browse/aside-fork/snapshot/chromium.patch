+void AsideBookmarksSectionView::BookmarkMergedSurfaceServiceBeingDeleted() {
+  drop_weak_factory_.InvalidateWeakPtrs();
+  rebuild_weak_factory_.InvalidateWeakPtrs();
+  rebuild_scheduled_ = false;
+  tab_representation_subscription_ = {};
+  tab_representation_.reset();
+  bookmark_service_->RemoveObserver(this);
+  bookmark_service_ = nullptr;
+  model_ = nullptr;
+  OnTabDragEnded();
+  SetVisible(false);
+}
