+///////////////////////////////////////////////////////////////////////////////
+// Browser, Aside profile pager:
+
+void Browser::StashTabsForAsideProfileSwitch() {
+  TRACE_EVENT1("ui", "Browser::StashTabsForAsideProfileSwitch", "tab_count",
+               tab_strip_model_->count());
+  aside_suppress_tab_strip_empty_ = true;
+
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfile(profile_)) {
+    session->ParkWindowForAside(this);
+  }
+
+  AsideStashedTabState stash;
+  stash.tab_count = tab_strip_model_->count();
+  stash.selection = tab_strip_model_->selection_model().GetListSelectionModel();
+  stash.focused_group = tab_strip_model_->GetFocusedGroup();
+  if (TabGroupModel* groups = tab_strip_model_->group_model()) {
+    for (const tab_groups::TabGroupId& group : groups->ListTabGroups()) {
+      stash.group_visuals.emplace(group,
+                                 *groups->GetTabGroup(group)->visual_data());
+    }
+  }
+
+  // Detach complete collections, including splits nested in groups, instead
+  // of flattening them into individual tabs. This API retains the original
+  // TabModels and records pin state before removal changes their parent.
+  std::vector<int> tab_indices(stash.tab_count);
+  std::iota(tab_indices.begin(), tab_indices.end(), 0);
+  {
+    TRACE_EVENT0("ui", "Browser::MoveTabsPreservingCollections.DetachAll");
+    stash.tabs_and_collections =
+        tab_strip_model_->DetachTabsAndCollectionsForInsertion(tab_indices);
+  }
+  // Emptying the strip made UnloadController latch "this browser is closing"
+  // (UnloadController::TabStripEmpty). The window is staying, so drop it —
+  // otherwise the next stash posts ProcessPendingTabs(), which closes the tabs
+  // this pager restores and then the window.
+  if (UnloadController* unload_controller = UnloadController::From(this)) {
+    unload_controller->ResetForAsideProfileSwitch();
+  }
+  if (stash.tabs_and_collections.empty()) {
+    TRACE_EVENT1("ui", "Browser::StashTabsForAsideProfileSwitch.Fallback",
+                 "tab_count", 0);
+    return;
+  }
+  const base::FilePath path = profile_->GetPath();
+  // The stashed WebContents still belong to this profile, so hold it open
+  // until they are restored or the window closes.
+  if (!profile_->IsOffTheRecord() &&
+      !aside_stashed_profile_keep_alives_.contains(path)) {
+    aside_stashed_profile_keep_alives_[path] =
+        std::make_unique<ScopedProfileKeepAlive>(
+            profile_->GetOriginalProfile(),
+            ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+  aside_stashed_tabs_[path] = std::move(stash);
+}
+
+int Browser::RestoreTabsForAsideProfileSwitch() {
+  auto it = aside_stashed_tabs_.find(profile_->GetPath());
+  if (it == aside_stashed_tabs_.end()) {
+    TRACE_EVENT1("ui", "Browser::RestoreTabsForAsideProfileSwitch.Fallback",
+                 "tab_count", 0);
+    return 0;
+  }
+  // Selection indices belong to the complete stashed strip. Restoring into a
+  // nonempty strip would both misapply them and permit duplicate group IDs.
+  CHECK(tab_strip_model_->empty());
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfile(profile_)) {
+    session->ResumeWindowForAside(this);
+  }
+  AsideStashedTabState stash = std::move(it->second);
+  aside_stashed_tabs_.erase(it);
+  TRACE_EVENT1("ui", "Browser::RestoreTabsForAsideProfileSwitch", "tab_count",
+               stash.tab_count);
+  const std::optional<size_t> active_index = stash.selection.active();
+  {
+    TRACE_EVENT0("ui", "Browser::MoveTabsPreservingCollections.InsertAll");
+    for (auto& tab_or_collection : stash.tabs_and_collections) {
+      const int insertion_index = tab_strip_model_->count();
+      if (auto* detached_tab =
+              std::get_if<std::unique_ptr<DetachedTab>>(&tab_or_collection)) {
+        int add_types = (*detached_tab)->was_pinned_at_time_of_removal
+                            ? ADD_PINNED
+                            : ADD_NONE;
+        if (active_index == static_cast<size_t>(insertion_index)) {
+          add_types |= ADD_ACTIVE;
+        }
+        tab_strip_model_->InsertDetachedTabAt(
+            insertion_index, std::move((*detached_tab)->tab), add_types);
+      } else {
+        auto collection = std::move(
+            std::get<std::unique_ptr<DetachedTabCollection>>(tab_or_collection));
+        const size_t collection_size = std::visit(
+            [](const auto& value) { return value->TabCountRecursive(); },
+            collection->collection_);
+        // Detaching earlier objects can temporarily activate a later
+        // collection. Only the original active tab should activate on insert.
+        collection->active_index_.reset();
+        if (active_index &&
+            *active_index >= static_cast<size_t>(insertion_index) &&
+            *active_index < insertion_index + collection_size) {
+          collection->active_index_ =
+              static_cast<int>(*active_index - insertion_index);
+        }
+        if (std::holds_alternative<
+                std::unique_ptr<tabs::TabGroupTabCollection>>(
+                collection->collection_)) {
+          tab_strip_model_->InsertDetachedTabGroupAt(std::move(collection),
+                                                    insertion_index);
+        } else {
+          const bool pinned = collection->pinned_;
+          tab_strip_model_->InsertDetachedSplitTabAt(
+              std::move(collection), insertion_index, pinned);
+        }
+      }
+    }
+  }
+
+  if (stash.focused_group) {
+    tab_strip_model_->SetFocusedGroup(stash.focused_group);
+  }
+  // Restore active, selected and anchor indices only once all tab identities
+  // and collection boundaries are present again.
+  tab_strip_model_->SetSelectionFromModel(std::move(stash.selection));
+  // Intermediate selections during detach/insert can expand collapsed groups.
+  // Restore their visual metadata after restoring the final selection.
+  for (const auto& [group, visuals] : stash.group_visuals) {
+    if (*tab_strip_model_->group_model()->GetTabGroup(group)->visual_data() !=
+        visuals) {
+      tab_strip_model_->ChangeTabGroupVisuals(group, visuals);
+    }
+  }
+  const int restored = tab_strip_model_->count();
+  // Keep the source profile alive through insertion and selection callbacks.
+  aside_stashed_profile_keep_alives_.erase(profile_->GetPath());
+  return restored;
+}
+
+void Browser::SetProfileForAsideProfileSwitch(Profile* profile) {
+  CHECK(profile);
+  CHECK(aside_suppress_tab_strip_empty_)
+      << "SetProfileForAsideProfileSwitch outside a stash/restore pair";
+  if (profile == profile_) {
+    return;
+  }
+  profile_ = profile;
+  tab_strip_model_->SetProfileForAsideProfileSwitch(profile);
+  browser_window_features()->RebindExtensionWindowControllerForAside(this);
+  GetCommandController()->RebindTabRestoreServiceForAsideProfileSwitch();
+
+  profile_keep_alive_.reset();
+  if (!profile_->IsOffTheRecord()) {
+    profile_keep_alive_ = std::make_unique<ScopedProfileKeepAlive>(
+        profile_->GetOriginalProfile(),
+        ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+
+  profile_pref_registrar_.Reset();
+  profile_pref_registrar_.Init(profile_->GetPrefs());
+  profile_pref_registrar_.Add(
+      prefs::kDevToolsAvailability,
+      base::BindRepeating(&Browser::OnDevToolsAvailabilityChanged,
+                          base::Unretained(this)));
+
+}
