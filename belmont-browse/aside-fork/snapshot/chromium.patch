+void BrowserView::OnAsideProfileSwitched(Browser* browser) {
+  CHECK_EQ(browser, browser_.get());
+  Profile* const profile = browser_->GetProfile();
+  CHECK(profile);
+  CHECK(browser_->tab_strip_model()->empty());
+
+  if (toolbar_) {
+    toolbar_->RebindProfileForAside();
+  }
+  projects_panel_subscription_ = {};
+  if (projects_panel_container_) {
+    GetBrowserViewLayout()->set_projects_panel_container(nullptr);
+    RemoveChildViewT(projects_panel_container_.get());
+    projects_panel_container_ = nullptr;
+  }
+  if (auto* state = ProjectsPanelStateController::From(browser_)) {
+    if (projects_panel::IsProjectsPanelVisibleForProfile(profile)) {
+      projects_panel_container_ = AddChildView(std::make_unique<ProjectsPanelView>(
+          browser_.get(), browser_->GetActions()->root_action_item(), state));
+      GetBrowserViewLayout()->set_projects_panel_container(projects_panel_container_);
+      projects_panel_subscription_ = state->RegisterOnStateChanged(
+          base::BindRepeating(&BrowserView::OnProjectsPanelStateChanged,
+                              base::Unretained(this)));
+      EnsureFocusOrder();
+    }
+  }
+  registrar_.Reset();
+  registrar_.Init(profile->GetPrefs());
+  registrar_.Add(
+      prefs::kFullscreenAllowed,
+      base::BindRepeating(&BrowserView::UpdateFullscreenAllowedFromPolicy,
+                          base::Unretained(this), CanFullscreen()));
+  UpdateFullscreenAllowedFromPolicy(CanFullscreen());
+
+  if (LocationBarView* const location_bar = GetLocationBarView()) {
+    location_bar->RebindToProfile(profile);
+    if (auto* const popup_view = location_bar->GetOmniboxPopupView()) {
+      if (auto* const embedded_view =
+              popup_view->AsOmniboxPopupViewBrowserView()) {
+        embedded_view->SetBrowserView(this);
+      }
+    }
+  }
+
+  for (ContentsContainerView* const container : GetContentsContainerViews()) {
+    container->RebindToProfile(profile);
+  }
+
+  if (tab_search_bubble_host_) {
+    tab_search_bubble_host_->CloseTabSearchBubble();
+    tab_search_bubble_host_.reset();
+  }
+  if (initialized_) {
+    UpdateTabSearchBubbleHost();
+  }
+
+  if (GetWidget()) {
+    GetWidget()->SetNativeWindowProperty(Profile::kProfileKey, profile);
+#if defined(USE_AURA)
+    SetThemeProfileForWindow(GetNativeWindow(), profile);
+#endif
+  }
+
+  if (auto* const theme_observer =
+          BrowserWindowThemeObserver::From(browser_.get())) {
+    theme_observer->RebindToProfile(profile);
+    // Changing the observed service does not itself generate an event. Refresh
+    // the existing widget hierarchy after its native profile keys are current.
+    theme_observer->NotifyThemeChanged(BrowserThemeChangeType::kBrowserTheme);
+  }
+}
