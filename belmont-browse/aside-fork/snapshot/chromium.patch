+void AsideProfileMenuView::ShowPage(Page page) {
+  page_ = page;
+  // Six 40-DIP icon buttons need a wider page than the original root menu.
+  SetMinimumCrossAxisSize(
+      (page == Page::kIconPicker ? kIconPickerWidth : kMenuWidth) - 16);
+  body_->RemoveAllChildViews();
+  body_->GetViewAccessibility().SetName(std::u16string(kProfileIndicatorMenu));
+  switch (page) {
+    case Page::kRoot:
+      BuildRootPage();
+      break;
+    case Page::kProfiles:
+      BuildProfilesPage();
+      break;
+    case Page::kExtensions:
+      BuildExtensionsPage();
+      break;
+    case Page::kExtensionActions:
+      BuildExtensionActionsPage();
+      break;
+    case Page::kBookmarks:
+      BuildBookmarksPage();
+      break;
+    case Page::kDownloads:
+      BuildDownloadsPage();
+      break;
+    case Page::kHistory:
+      BuildHistoryPage();
+      break;
+    case Page::kDevelopers:
+      BuildDevelopersPage();
+      break;
+    case Page::kAdvanced:
+      BuildAdvancedPage();
+      break;
+    case Page::kProfileActions:
+      BuildProfileActionsPage();
+      break;
+    case Page::kIconPicker:
+      BuildIconPickerPage();
+      break;
+  }
+  InvalidateLayout();
+  if (views::Widget* widget = GetWidget()) {
+    widget->SetSize(widget->non_client_view()->GetPreferredSize({}));
+  }
+}
