+    }
+  }
+  if (browser_select_file_dialog_controller_) {
+    browser_select_file_dialog_controller_->RebindProfileForAside(profile);
+  }
+  if (new_tab_footer_controller_) {
+    new_tab_footer_controller_->RebindProfileForAside(profile);
+  }
+  if (profile_menu_coordinator_) {
+    profile_menu_coordinator_->RebindProfileForAside(profile);
+    if (!weak_browser) {
+      return;
+    }
+  }
+  if (reading_list_side_panel_coordinator_) {
+    reading_list_side_panel_coordinator_->RebindProfileForAside(
+        profile, side_panel_registry_.get());
+  }
+  if (tabs_from_other_devices_side_panel_coordinator_) {
+    tabs_from_other_devices_side_panel_coordinator_->RebindProfileForAside(
+        profile, side_panel_registry_.get());
+  } else if (TabsFromOtherDevicesSidePanelCoordinator::IsSupported(profile)) {
+    tabs_from_other_devices_side_panel_coordinator_ =
+        std::make_unique<TabsFromOtherDevicesSidePanelCoordinator>(browser,
+                                                                  profile);
+    tabs_from_other_devices_side_panel_coordinator_->CreateAndRegisterEntry(
+        side_panel_registry_.get());
+  }
+  if (signin_view_controller_) {
+    signin_view_controller_->RebindProfileForAside(profile);
+    if (!weak_browser) {
+      return;
+    }
+  }
+  if (tab_group_deletion_dialog_controller_) {
+    tab_group_deletion_dialog_controller_->RebindProfileForAside(profile);
+    if (!weak_browser) {
+      return;
+    }
+  }
+  RebindExtensionWindowControllerForAside(browser);
+  if (extension_browser_window_helper_) {
+    extension_browser_window_helper_->RebindProfileForAside(profile);
+  }
+  if (bookmarks_service_feature_) {
+    bookmarks_service_feature_->RebindProfileForAside(
+        BookmarkModelFactory::GetForBrowserContext(profile),
+        ManagedBookmarkServiceFactory::GetForProfile(profile));
+  }
+  if (bookmark_bar_controller_) {
+    bookmark_bar_controller_->RebindProfilePrefsForAside();
+  }
+  if (tab_menu_model_delegate_) {
+    tab_menu_model_delegate_->RebindProfileForAside(
+        profile, tab_groups::TabGroupSyncServiceFactory::GetForProfile(profile));
+  }
+  if (live_tab_context_) {
+    live_tab_context_->RebindForAsideProfileSwitch(profile);
+  }
+  if (session_service_tab_group_sync_observer_) {
+    session_service_tab_group_sync_observer_->RebindForAsideProfileSwitch(
+        profile);
+  }
+  if (instant_controller_) {
+    instant_controller_->RebindForAsideProfileSwitch(profile);
+  }
+  if (extension_keybinding_registry_) {
+    extension_keybinding_registry_->RebindForAsideProfileSwitch(profile);
+  }
+  if (ios_promo_controller_) {
+    ios_promo_controller_->RebindProfileForAside();
+  }
+}
+
+void BrowserWindowFeatures::RebindProfileViewServicesForAside(Browser* browser) {
+  CHECK_EQ(browser_, browser);
+  Profile* const profile = browser->GetProfile();
+  const auto weak_browser = browser->GetWeakPtr();
+#if !BUILDFLAG(IS_CHROMEOS)
+  if (download_toolbar_ui_controller_) {
+    download_toolbar_ui_controller_->RebindProfileForAside();
+    if (!weak_browser) {
+      return;
+    }
+  }
+#endif
+  if (vertical_tab_strip_state_controller_) {
+    vertical_tab_strip_state_controller_->RebindForAsideProfileSwitch(profile);
+    if (!weak_browser) {
+      return;
+    }
+  }
+  if (ai_mode_page_action_controller_) {
+    ai_mode_page_action_controller_->RebindProfileForAside(*profile);
+  } else if (auto* view = BrowserView::GetBrowserViewForBrowser(browser)) {
+    if (IsPageActionMigrated(PageActionIconType::kAiMode) &&
+        AiModeButtonServiceFactory::GetForProfile(profile) &&
+        view->GetLocationBarView()) {
+      ai_mode_page_action_controller_ =
+          GetUserDataFactory().CreateInstance<omnibox::AiModePageActionController>(
+              *browser, *browser, *profile, *view->GetLocationBarView());
+    }
+  }
+  if (browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL) {
+    if (BrowserView::GetBrowserViewForBrowser(browser)) {
+      if (auto* service = glic::GlicKeyedService::Get(profile)) {
+        auto* elements = BrowserElementsViews::From(browser);
+        auto* tab_strip = elements->GetViewAs<TabStripActionContainer>(
+            kTabStripActionContainerElementId);
+        auto* toolbar = elements->GetViewAs<ToolbarView>(
+            ToolbarView::kToolbarElementId);
+        if (!glic_button_controller_ && tab_strip && toolbar) {
+          glic_button_controller_ = std::make_unique<glic::GlicButtonController>(
+              profile, *browser, tab_strip, toolbar, service);
+        }
+        if (base::FeatureList::IsEnabled(features::kGlicActor) &&
+            base::FeatureList::IsEnabled(features::kGlicActorUi) &&
+            features::kGlicActorUiTaskIcon.Get() && profile->IsRegularProfile()) {
+          if (!actor_task_list_bubble_controller_) {
+            actor_task_list_bubble_controller_ =
+                GetUserDataFactory().CreateInstance<ActorTaskListBubbleController>(
+                    *browser, browser);
+          }
+          if (!glic_actor_nudge_controller_) {
+            glic_actor_nudge_controller_ =
+                GetUserDataFactory().CreateInstance<glic::GlicActorNudgeController>(
+                    *browser, browser, tab_strip, toolbar);
+          }
+        }
+      }
+    }
+  }
+}
