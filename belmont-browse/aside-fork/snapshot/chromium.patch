+
+std::optional<AsideBookmarksSectionView::DropLocation>
+AsideBookmarksSectionView::GetBookmarkDropLocation(
+    const gfx::Point& point_in_screen) const {
+  gfx::Point local_point = point_in_screen;
+  views::View::ConvertPointFromScreen(this, &local_point);
+  if (!IsDropAvailable() || !GetVisibleBounds().Contains(local_point)) {
+    return std::nullopt;
+  }
+  BookmarkParentFolder parent = BookmarkParentFolder::BookmarkBarFolder();
+  size_t index = bookmark_service_->GetChildrenCount(parent);
+  for (const auto& [row, info] : row_nodes_) {
+    gfx::Point row_point = point_in_screen;
+    views::View::ConvertPointFromScreen(row, &row_point);
+    // A scrolled-out row can still be drawn and have screen bounds under the
+    // header. Only the portion exposed by the viewport accepts drops.
+    if (!row->IsDrawn() || !row->GetVisibleBounds().Contains(row_point)) {
+      continue;
+    }
+    const bookmarks::BookmarkNode* node =
+        bookmarks::GetBookmarkNodeByID(model_, info.node_id);
+    if (!node) {
+      return std::nullopt;
+    }
+    const int offset = row_point.y();
+    if (node->is_folder() && offset >= row->height() / 4 &&
+        offset < 3 * row->height() / 4) {
+      parent = BookmarkParentFolder::FromFolderNode(node);
+      index = bookmark_service_->GetChildrenCount(parent);
+    } else {
+      parent = BookmarkParentFolder::FromFolderNode(node->parent());
+      index = bookmark_service_->GetIndexOf(node) +
+              (offset >= row->height() / 2 ? 1 : 0);
+    }
+    break;
+  }
+  if (bookmark_service_->IsParentFolderManaged(parent)) {
+    return std::nullopt;
+  }
+  return DropLocation{
+      parent.HoldsNonPermanentFolder()
+          ? std::make_optional(parent.as_non_permanent_folder()->id())
+          : std::nullopt,
+      index};
+}
+
+std::optional<BookmarkParentFolder>
+AsideBookmarksSectionView::ResolveDropParent(
+    const DropLocation& location) const {
+  if (!bookmark_service_ || !bookmark_service_->loaded()) {
+    return std::nullopt;
+  }
+  BookmarkParentFolder parent = BookmarkParentFolder::BookmarkBarFolder();
+  if (location.parent_id) {
+    const bookmarks::BookmarkNode* node =
+        bookmarks::GetBookmarkNodeByID(model_, *location.parent_id);
+    if (!node || !node->is_folder() || node->is_root() ||
+        node->is_permanent_node()) {
+      return std::nullopt;
+    }
+    parent = BookmarkParentFolder::FromFolderNode(node);
+  }
+  if (bookmark_service_->IsParentFolderManaged(parent) ||
+      location.index > bookmark_service_->GetChildrenCount(parent)) {
+    return std::nullopt;
+  }
+  return parent;
+}
+
+ui::mojom::DragOperation AsideBookmarksSectionView::GetBookmarkDropOperation(
+    const bookmarks::BookmarkNodeData& data,
+    const DropLocation& location,
+    int source_operations) const {
+  using ui::mojom::DragOperation;
+  if (!IsDropAvailable() || data.size() != 1 ||
+      !IsValidBookmarkElement(data.elements.front())) {
+    return DragOperation::kNone;
+  }
+  const auto parent = ResolveDropParent(location);
+  if (!parent) {
+    return DragOperation::kNone;
+  }
+  // Validate both serialized URL payloads and live node identity. Same-profile
+  // node IDs must still resolve at drop time; never resurrect a deleted node.
+  if (data.IsFromProfilePath(browser_->profile()->GetPath())) {
+    const bookmarks::BookmarkNode* node =
+        data.GetFirstNode(model_, browser_->profile()->GetPath());
+    if (!node || node->is_permanent_node() || node->is_root() ||
+        (node->is_folder() &&
+         parent->HasAncestor(BookmarkParentFolder::FromFolderNode(node)))) {
+      return DragOperation::kNone;
+    }
+    if (parent->HasDirectChildNode(node)) {
+      const size_t old_index = bookmark_service_->GetIndexOf(node);
+      if (location.index == old_index || location.index == old_index + 1) {
+        return DragOperation::kNone;
+      }
+    }
+    if (!model_->client()->IsNodeManaged(node) &&
+        (source_operations & ui::DragDropTypes::DRAG_MOVE)) {
+      return DragOperation::kMove;
+    }
+  }
+  return chrome::GetPreferredBookmarkDropOperation(
+      source_operations,
+      ui::DragDropTypes::DRAG_COPY | ui::DragDropTypes::DRAG_LINK);
+}
+
+int AsideBookmarksSectionView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  gfx::Point point = event.location();
+  views::View::ConvertPointToScreen(this, &point);
+  ScrollRowsForDrag(point);
+  const auto location = GetBookmarkDropLocation(point);
+  bookmarks::BookmarkNodeData data;
+  const auto operation =
+      location && data.Read(event.data())
+          ? GetBookmarkDropOperation(data, *location, event.source_operations())
+          : ui::mojom::DragOperation::kNone;
+  drop_highlighted_ = operation != ui::mojom::DragOperation::kNone;
+  SchedulePaint();
+  return static_cast<int>(operation);
+}
+
+void AsideBookmarksSectionView::ScrollRowsForDrag(
+    const gfx::Point& point_in_screen) {
+  if (!IsDropAvailable() || !rows_scroll_->IsDrawn()) {
+    return;
+  }
+  gfx::Point point = point_in_screen;
+  views::View::ConvertPointFromScreen(rows_scroll_, &point);
+  const gfx::Rect visible = rows_scroll_->GetVisibleBounds();
+  if (!visible.Contains(point)) {
+    return;
+  }
+  const int edge = std::min(kDragScrollEdge, visible.height() / 2);
+  int delta = 0;
+  if (point.y() < visible.y() + edge) {
+    delta = -kDragScrollEdge;
+  } else if (point.y() >= visible.bottom() - edge) {
+    delta = kDragScrollEdge;
+  }
+  if (delta) {
+    // Non-layer scrolling updates view coordinates synchronously, so the
+    // following hit test sees the row now exposed under the drag pointer.
+    rows_scroll_->ScrollToPosition(
+        rows_scroll_->vertical_scroll_bar(),
+        static_cast<int>(rows_scroll_->CurrentOffset().y()) + delta);
+  }
+}
+
+void AsideBookmarksSectionView::OnDragExited() {
+  drop_highlighted_ = false;
+  SchedulePaint();
+}
+
+views::View::DropCallback AsideBookmarksSectionView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  gfx::Point point = event.location();
+  views::View::ConvertPointToScreen(this, &point);
+  const auto location = GetBookmarkDropLocation(point);
+  bookmarks::BookmarkNodeData data;
+  if (!location || !data.Read(event.data()) ||
+      GetBookmarkDropOperation(data, *location, event.source_operations()) ==
+          ui::mojom::DragOperation::kNone) {
+    return base::NullCallback();
+  }
+  OnDragExited();
+  return base::BindOnce(&AsideBookmarksSectionView::PerformBookmarkDrop,
+                        drop_weak_factory_.GetWeakPtr(), std::move(data),
+                        *location, browser_->profile()->GetPath());
+}
+
+void AsideBookmarksSectionView::PerformBookmarkDrop(
+    bookmarks::BookmarkNodeData data,
+    DropLocation location,
+    base::FilePath profile_path,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kNone;
+  if (profile_path != browser_->profile()->GetPath()) {
+    return;
+  }
+  const auto operation =
+      GetBookmarkDropOperation(data, location, event.source_operations());
+  if (operation == ui::mojom::DragOperation::kNone) {
+    return;
+  }
+  const auto parent = ResolveDropParent(location);
+  if (!parent) {
+    return;
+  }
+  output_drag_op =
+      BookmarkUIOperationsHelperMergedSurfaces(bookmark_service_, &*parent)
+          .DropBookmarks(browser_->profile(), data, location.index,
+                         operation != ui::mojom::DragOperation::kMove,
+                         chrome::BookmarkReorderDropTarget::kBookmarkSidePanel,
+                         browser_);
+}
+
+void AsideBookmarksSectionView::OnPaint(gfx::Canvas* canvas) {
+  views::BoxLayoutView::OnPaint(canvas);
+  if (drop_highlighted_) {
+    cc::PaintFlags flags;
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(2.0f);
+    flags.setAntiAlias(true);
+    flags.setColor(
+        GetColorProvider()->GetColor(kColorAsideSurfacePrimaryForeground));
+    gfx::RectF bounds(GetLocalBounds());
+    bounds.Inset(1.0f);
+    canvas->DrawRoundRect(bounds, 6.0f, flags);
+  }
+}
+
+void AsideBookmarksSectionView::WriteDragDataForView(views::View* sender,
+                                                     const gfx::Point& press_pt,
+                                                     ui::OSExchangeData* data) {
+  const auto it = row_nodes_.find(sender);
+  if (!model_ || it == row_nodes_.end()) {
+    return;
+  }
+  const bookmarks::BookmarkNode* node =
+      bookmarks::GetBookmarkNodeByID(model_, it->second.node_id);
+  if (node) {
+    bookmarks::BookmarkNodeData(node).Write(browser_->profile()->GetPath(),
+                                            data);
+  }
+}
+
+int AsideBookmarksSectionView::GetDragOperationsForView(
+    views::View* sender,
+    const gfx::Point& point) {
+  const auto it = row_nodes_.find(sender);
+  if (!model_ || !model_->loaded() || it == row_nodes_.end()) {
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  const bookmarks::BookmarkNode* node =
+      bookmarks::GetBookmarkNodeByID(model_, it->second.node_id);
+  return node ? chrome::GetBookmarkDragOperation(browser_->profile(), node)
+              : ui::DragDropTypes::DRAG_NONE;
+}
+
+bool AsideBookmarksSectionView::CanStartDragForView(views::View* sender,
+                                                    const gfx::Point& press_pt,
+                                                    const gfx::Point& point) {
+  return GetDragOperationsForView(sender, point) !=
+         ui::DragDropTypes::DRAG_NONE;
+}
+
+void AsideBookmarksSectionView::OnTabDragEntered() {}
+
+TabDragContext* AsideBookmarksSectionView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  ScrollRowsForDrag(point_in_screen);
+  tab_drop_location_ = GetBookmarkDropLocation(point_in_screen);
+  drop_highlighted_ = tab_drop_location_.has_value();
+  SchedulePaint();
+  // Passing through other sidebar sections must not tear tabs into a window.
+  // Copy drops retain the attached context until EndDrag restores the source.
+  return const_cast<TabDragContext*>(controller.GetAttachedContext());
+}
+
+void AsideBookmarksSectionView::OnTabDragExited(
+    const gfx::Point& point_in_screen) {
+  OnTabDragEnded();
+}
+
+void AsideBookmarksSectionView::OnTabDragEnded() {
+  tab_drop_location_.reset();
+  drop_highlighted_ = false;
+  SchedulePaint();
+}
+
+bool AsideBookmarksSectionView::CanDropTab() {
+  // This target copies URLs through GetTabCopyDropCallback. It never consumes
+  // or detaches tabs through CompleteDrag's ordinary target path.
+  return false;
+}
+
+void AsideBookmarksSectionView::HandleTabDrop(
+    TabDragTarget::DragController& controller) {}
+
+base::OnceClosure AsideBookmarksSectionView::GetTabCopyDropCallback(
+    const TabDragTarget::DragController& controller) {
+  if (!tab_drop_location_ || !IsDropAvailable()) {
+    return base::NullCallback();
+  }
+  bookmarks::BookmarkNodeData data;
+  for (const auto& item : controller.GetSessionData().tab_drag_data_) {
+    if (item.view_type == TabSlotView::ViewType::kTabGroupHeader ||
+        !item.contents) {
+      continue;
+    }
+    GURL url;
+    std::u16string title;
+    if (!chrome::GetURLAndTitleToBookmark(item.contents, &url, &title) ||
+        !url.is_valid()) {
+      return base::NullCallback();
+    }
+    bookmarks::BookmarkNodeData entry;
+    if (!entry.ReadFromTuple(url, title)) {
+      return base::NullCallback();
+    }
+    data.elements.push_back(entry.elements.front());
+  }
+  if (!data.is_valid()) {
+    return base::NullCallback();
+  }
+  return base::BindOnce(&AsideBookmarksSectionView::PerformTabCopyDrop,
+                        drop_weak_factory_.GetWeakPtr(), std::move(data),
+                        *tab_drop_location_, browser_->profile()->GetPath());
+}
+
+void AsideBookmarksSectionView::PerformTabCopyDrop(
+    bookmarks::BookmarkNodeData data,
+    DropLocation location,
+    base::FilePath profile_path) {
+  if (!IsDropAvailable() || profile_path != browser_->profile()->GetPath()) {
+    return;
+  }
+  const auto parent = ResolveDropParent(location);
+  if (!parent || !data.is_valid()) {
+    return;
+  }
+  for (const auto& entry : data.elements) {
+    if (!entry.is_url || !entry.url.is_valid()) {
+      return;
+    }
+  }
+  BookmarkUIOperationsHelperMergedSurfaces(bookmark_service_, &*parent)
+      .DropBookmarks(browser_->profile(), data, location.index, /*copy=*/true,
+                     chrome::BookmarkReorderDropTarget::kBookmarkSidePanel,
+                     browser_);
+}
+
+base::CallbackListSubscription
+AsideBookmarksSectionView::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return will_destroy_callbacks_.Add(std::move(callback));
+}
