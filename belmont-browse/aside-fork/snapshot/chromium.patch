+// lifecycle, including the existing focus, drag and menu locks.
+class AsideSidebarExpandButton final : public ToolbarButton {
+  METADATA_HEADER(AsideSidebarExpandButton, ToolbarButton)
+
+ public:
+  AsideSidebarExpandButton(Browser* browser, BrowserView* browser_view)
+      : ToolbarButton(base::BindRepeating(
+            [](Browser* browser) {
+              if (auto* action = actions::ActionManager::Get().FindAction(
+                      kActionToggleCollapseVertical,
+                      browser->GetActions()->root_action_item())) {
+                action->InvokeAction();
+              }
+            },
+            base::Unretained(browser))),
+        browser_view_(browser_view) {
+    const auto text = l10n_util::GetStringUTF16(IDS_EXPAND_VERTICAL_TABS);
+    SetTooltipText(text);
+    GetViewAccessibility().SetName(text);
+    SetFocusBehavior(FocusBehavior::ALWAYS);
+    SetVisible(false);
+    UpdateIcon();
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(32, 32);
+  }
+
+  void UpdateIcon() override {
+    const auto icon = ui::ImageModel::FromVectorIcon(
+        kAsideSfSymbolSidebarIcon, kColorToolbarButtonIcon, 16);
+    for (auto state : {STATE_NORMAL, STATE_HOVERED, STATE_PRESSED}) {
+      SetImageModel(state, icon);
+    }
+    SetImageModel(STATE_DISABLED, ui::ImageModel::FromVectorIcon(
+                                      kAsideSfSymbolSidebarIcon,
+                                      kColorToolbarButtonIconDisabled, 16));
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    ToolbarButton::OnMouseEntered(event);
+    browser_view_->OnVerticalTabStripToolbarButtonHoverChanged(true);
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    ToolbarButton::OnMouseExited(event);
+    browser_view_->OnVerticalTabStripToolbarButtonHoverChanged(false);
+  }
+
+  void OnFocus() override {
+    ToolbarButton::OnFocus();
+    browser_view_->OnVerticalTabStripToolbarButtonHoverChanged(true);
+  }
+
+  void OnBlur() override {
+    ToolbarButton::OnBlur();
+    browser_view_->OnVerticalTabStripToolbarButtonHoverChanged(false);
+  }
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+};
