+void AsideBookmarksSectionView::OnBookmarksChanged() {
+  drop_weak_factory_.InvalidateWeakPtrs();
+  OnTabDragEnded();
+  if (extensive_changes_) {
+    rebuild_pending_ = true;
+    return;
+  }
+  if (!rebuild_scheduled_) {
+    // Merged copy operations notify for every element after insertion without
+    // necessarily opening an extensive-change scope. Coalesce those callbacks
+    // as well, while invalidating stale drag destinations synchronously.
+    rebuild_scheduled_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AsideBookmarksSectionView::Rebuild,
+                                  rebuild_weak_factory_.GetWeakPtr()));
+  }
+}
