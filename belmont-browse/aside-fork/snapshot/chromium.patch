+// Tabs is not a collapsing section in the observed original. Its trailing
+// Tidy/Clear controls appear on hover; keyboard focus reveals the same actions.
+class AsideTabsHeaderView : public views::BoxLayoutView,
+                            public views::FocusChangeListener {
+  METADATA_HEADER(AsideTabsHeaderView, views::BoxLayoutView)
+
+ public:
+  AsideTabsHeaderView(base::RepeatingClosure on_tidy,
+                      base::RepeatingClosure on_clear) {
+    SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    SetNotifyEnterExitOnChild(true);
+    SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    GetViewAccessibility().SetName(kTabs);
+    auto* title = AddChildView(std::make_unique<views::Label>(kTabs));
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetFontList(aside::UiFontList(12, gfx::Font::Weight::SEMIBOLD));
+    title->SetEnabledColor(kColorAsideMutedForeground);
+    title->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 8)));
+    SetFlexForView(title, 1);
+    auto actions = std::make_unique<views::BoxLayoutView>();
+    actions->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    auto* tidy = actions->AddChildView(
+        MakeIconTextButton(on_tidy, kTidy, kAsideSparklesTwo2solidIcon));
+    auto* clear = actions->AddChildView(
+        MakeIconTextButton(on_clear, kClear, kAsideArrowDownStrokeIcon));
+    for (AsideTextButton* button : {tidy, clear}) {
+      button->SetCustomPadding(gfx::Insets::VH(4, 6));
+      button->SetImageLabelSpacing(4);
+      button->SetLabelFontList(aside::UiFontList(12));
+      button->SetTextColor(views::Button::STATE_NORMAL,
+                           kColorAsideMutedForeground);
+      button->SetTextColor(views::Button::STATE_HOVERED,
+                           kColorAsideMutedForeground);
+      button->SetTextColor(views::Button::STATE_PRESSED,
+                           kColorAsideMutedForeground);
+    }
+    tidy->SetTooltipText(u"Organize tabs with AI");
+    clear->SetTooltipText(kClear);
+    actions_ = AddChildView(std::move(actions));
+    actions_->SetVisible(false);
+  }
+
+  void AddedToWidget() override {
+    views::BoxLayoutView::AddedToWidget();
+    if (GetFocusManager()) {
+      focus_observation_.Observe(GetFocusManager());
+    }
+  }
+
+  void OnFocusManagerDestroying(views::FocusManager* manager) override {
+    focus_observation_.Reset();
+  }
+
+  void RemovedFromWidget() override {
+    focus_observation_.Reset();
+    views::BoxLayoutView::RemovedFromWidget();
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    views::BoxLayoutView::OnMouseEntered(event);
+    UpdateActions();
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    views::BoxLayoutView::OnMouseExited(event);
+    UpdateActions();
+  }
+
+  void OnDidChangeFocus(views::View* before, views::View* after) override {
+    UpdateActions();
+  }
+
+ private:
+  void UpdateActions() {
+    auto* focused =
+        GetFocusManager() ? GetFocusManager()->GetFocusedView() : nullptr;
+    actions_->SetVisible(IsMouseHovered() || (focused && Contains(focused)));
+  }
+
+  raw_ptr<views::View> actions_ = nullptr;
+  base::ScopedObservation<views::FocusManager, views::FocusChangeListener>
+      focus_observation_{this};
+};
