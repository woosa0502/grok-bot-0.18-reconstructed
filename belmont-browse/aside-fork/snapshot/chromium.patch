+// Both the section title and its disclosure control operate the same state.
+// Use a repeating closure because Button::PressedCallback itself is move-only.
+std::unique_ptr<views::View> MakeSectionHeader(
+    const std::u16string& title,
+    base::RepeatingClosure callback,
+    raw_ptr<views::MdTextButton>* title_out = nullptr,
+    raw_ptr<views::ImageButton>* chevron_out = nullptr) {
+  auto row = std::make_unique<views::BoxLayoutView>();
+  row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  row->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  row->SetInsideBorderInsets(gfx::Insets::TLBR(0, 0, 0, 6));
+  auto button = std::make_unique<AsideTextButton>(
+      callback, title, views::style::CONTEXT_BUTTON_MD);
+  button->SetStyle(ui::ButtonStyle::kText);
+  button->SetCustomPadding(gfx::Insets::VH(4, 8));
+  button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  button->SetTooltipText(title);
+  button->SetLabelStyle(views::style::STYLE_BODY_4_BOLD);
+  button->SetLabelFontList(
+      aside::UiFontList(12, gfx::Font::Weight::SEMIBOLD));
+  button->SetTextColor(views::Button::STATE_NORMAL, kColorAsideMutedForeground);
+  button->SetTextColor(views::Button::STATE_HOVERED, kColorAsideMutedForeground);
+  button->SetTextColor(views::Button::STATE_PRESSED, kColorAsideMutedForeground);
+  auto* label_button = row->AddChildView(std::move(button));
+  row->SetFlexForView(label_button, 1);
+  if (title_out) {
+    *title_out = label_button;
+  }
+  if (callback) {
+    auto chevron = std::make_unique<views::ImageButton>(callback);
+    chevron->SetImageModel(views::Button::STATE_NORMAL,
+                           ui::ImageModel::FromVectorIcon(kAsideExpandLessIcon,
+                                                          ui::kColorIcon, 14));
+    chevron->SetBorder(views::CreateEmptyBorder(gfx::Insets(4)));
+    chevron->SetTooltipText(title);
+    chevron->GetViewAccessibility().SetName(title);
+    auto* chevron_button = row->AddChildView(std::move(chevron));
+    if (chevron_out) {
+      *chevron_out = chevron_button;
+    }
+  } else {
+    label_button->SetFocusBehavior(views::View::FocusBehavior::NEVER);
+  }
+  return row;
+}
+
+void UpdateDisclosure(views::MdTextButton* title,
+                      views::ImageButton* chevron,
+                      bool expanded) {
+  chevron->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          expanded ? kAsideExpandLessIcon : kAsideExpandMoreIcon,
+          ui::kColorIcon, 14));
+  for (views::View* view :
+       {static_cast<views::View*>(title), static_cast<views::View*>(chevron)}) {
+    if (expanded) {
+      view->GetViewAccessibility().SetIsExpanded();
+    } else {
+      view->GetViewAccessibility().SetIsCollapsed();
+    }
+  }
+}
+
+void UpdateActionButton(views::MdTextButton* button,
+                        const std::u16string& title,
+                        bool collapsed) {
+  button->SetText(collapsed ? std::u16string() : title);
+  button->SetHorizontalAlignment(collapsed ? gfx::ALIGN_CENTER
+                                           : gfx::ALIGN_LEFT);
+  button->SetCustomPadding(gfx::Insets::VH(6, collapsed ? 4 : 10));
+  button->SetTooltipText(title);
+  button->GetViewAccessibility().SetName(title);
+}
