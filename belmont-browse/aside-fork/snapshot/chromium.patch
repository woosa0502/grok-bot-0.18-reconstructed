@@ -0,0 +1,160 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/data_sharing/data_sharing_bubble_controller.h"
+
+#include <memory>
+#include <optional>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/browser_window/test/mock_browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/test_tab_strip_model_delegate.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/collaboration/public/collaboration_controller_delegate.h"
+#include "components/data_sharing/public/group_data.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+using Outcome = collaboration::CollaborationControllerDelegate::Outcome;
+
+class DataSharingBubbleControllerUnitTest : public testing::Test {
+ public:
+  void SetUp() override {
+    source_profile_ = TestingProfile::Builder().Build();
+    target_profile_ = TestingProfile::Builder().Build();
+    tab_strip_model_delegate_ = std::make_unique<TestTabStripModelDelegate>();
+    tab_strip_model_ = std::make_unique<TabStripModel>(
+        tab_strip_model_delegate_.get(), source_profile_.get());
+    browser_window_interface_ = std::make_unique<MockBrowserWindowInterface>();
+
+    ON_CALL(*browser_window_interface_, GetProfile())
+        .WillByDefault(::testing::Return(source_profile_.get()));
+    ON_CALL(*browser_window_interface_, GetTabStripModel())
+        .WillByDefault(::testing::Return(tab_strip_model_.get()));
+
+    controller_ = std::make_unique<DataSharingBubbleController>(
+        browser_window_interface_.get(), source_profile_.get(),
+        tab_strip_model_.get());
+  }
+
+ protected:
+  content::BrowserTaskEnvironment task_environment_;
+  std::unique_ptr<TestingProfile> source_profile_;
+  std::unique_ptr<TestingProfile> target_profile_;
+  std::unique_ptr<TestTabStripModelDelegate> tab_strip_model_delegate_;
+  std::unique_ptr<TabStripModel> tab_strip_model_;
+  std::unique_ptr<MockBrowserWindowInterface> browser_window_interface_;
+  std::unique_ptr<DataSharingBubbleController> controller_;
+};
+
+TEST_F(DataSharingBubbleControllerUnitTest,
+       RebindCancelsSourceCallbacksAndIsolatesReentrantCallbacks) {
+  int share_count = 0;
+  int link_count = 0;
+  int source_join_count = 0;
+  int destination_join_count = 0;
+  int close_count = 0;
+  int error_count = 0;
+
+  controller_->SetOnShareLinkRequestedCallback(base::BindOnce(
+      [](int* count, Outcome outcome,
+         std::optional<data_sharing::GroupToken> token) {
+        ++*count;
+        EXPECT_EQ(Outcome::kSuccess, outcome);
+        EXPECT_TRUE(token.has_value());
+      },
+      &share_count));
+  controller_->OnShareLinkRequested(
+      "group", "token",
+      base::BindOnce(
+          [](DataSharingBubbleController* controller, int* count,
+             int* destination_join_count,
+             const std::optional<GURL>& share_url) {
+            ++*count;
+            EXPECT_FALSE(share_url.has_value());
+
+            // Show must be suppressed while the source profile is draining.
+            controller->Show(data_sharing::RequestInfo());
+
+            // A callback installed reentrantly belongs to the destination and
+            // must not be consumed with the source callback batch.
+            controller->SetJoinCallback(base::BindOnce(
+                [](int* count, Outcome outcome) {
+                  ++*count;
+                  EXPECT_EQ(Outcome::kSuccess, outcome);
+                },
+                destination_join_count));
+
+            // A final source WebUI event can arrive synchronously while its
+            // widget and callbacks are being drained. It must not repopulate
+            // destination state.
+            controller->OnGroupAction(
+                data_sharing::mojom::GroupAction::kJoinGroup,
+                data_sharing::mojom::GroupActionProgress::kSuccess);
+          },
+          controller_.get(), &link_count, &destination_join_count));
+  controller_->SetJoinCallback(base::BindOnce(
+      [](int* count, Outcome outcome) {
+        ++*count;
+        EXPECT_EQ(Outcome::kCancel, outcome);
+      },
+      &source_join_count));
+  controller_->SetOnCloseCallback(base::BindOnce(
+      [](int* count,
+         std::optional<data_sharing::mojom::GroupAction> action,
+         std::optional<data_sharing::mojom::GroupActionProgress> progress) {
+        ++*count;
+        EXPECT_FALSE(action.has_value());
+        EXPECT_FALSE(progress.has_value());
+      },
+      &close_count));
+  controller_->SetShowErrorDialogCallback(
+      base::BindOnce([](int* count) { ++*count; }, &error_count));
+
+  controller_->RebindProfileForAside(target_profile_.get());
+
+  EXPECT_EQ(1, share_count);
+  EXPECT_EQ(1, link_count);
+  EXPECT_EQ(1, source_join_count);
+  EXPECT_EQ(0, destination_join_count);
+  EXPECT_EQ(1, close_count);
+  EXPECT_EQ(0, error_count);
+  EXPECT_FALSE(controller_->BubbleViewForTesting());
+  EXPECT_FALSE(controller_->group_action_for_testing().has_value());
+  EXPECT_FALSE(controller_->group_action_progress_for_testing().has_value());
+
+  // The source error callback was discarded, while the callback installed by
+  // the link cancellation remains live for the destination profile.
+  controller_->ShowErrorDialog(/*status_code=*/1);
+  EXPECT_EQ(0, error_count);
+  controller_->OnGroupAction(
+      data_sharing::mojom::GroupAction::kJoinGroup,
+      data_sharing::mojom::GroupActionProgress::kSuccess);
+  EXPECT_EQ(1, destination_join_count);
+}
+
+TEST_F(DataSharingBubbleControllerUnitTest,
+       RebindCallbackMayDestroyController) {
+  int callback_count = 0;
+  controller_->SetOnShareLinkRequestedCallback(base::BindOnce(
+      [](std::unique_ptr<DataSharingBubbleController>* controller, int* count,
+         Outcome outcome, std::optional<data_sharing::GroupToken> token) {
+        ++*count;
+        EXPECT_EQ(Outcome::kCancel, outcome);
+        EXPECT_FALSE(token.has_value());
+        controller->reset();
+      },
+      &controller_, &callback_count));
+
+  auto* controller = controller_.get();
+  controller->RebindProfileForAside(target_profile_.get());
+
+  EXPECT_EQ(1, callback_count);
+  EXPECT_FALSE(controller_);
+}
+
+}  // namespace
