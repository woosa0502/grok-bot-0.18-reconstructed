+TEST(AsideAgentOwnershipTest, PromotedOwnershipCannotSurviveGroupReplacement) {
+  const auto id = tab_groups::TabGroupId::GenerateNew();
+  auto group = std::make_unique<TestAsideGroup>(id);
+  aside::SetAiTabsMetadata(group.get(), {"owner", "https://example.test"});
+  ASSERT_TRUE(aside::IsAgentTabsGroup(group.get()));
+  // Restore/move code can reuse group IDs. Even a concurrent replacement may
+  // not borrow the previous object's authority or its badge metadata.
+  TestAsideGroup replacement(id);
+  EXPECT_FALSE(aside::IsAgentTabsGroup(&replacement));
+  EXPECT_FALSE(aside::GetAiTabsMetadata(&replacement));
+  group.reset();
+  EXPECT_FALSE(aside::IsAgentTabsGroup(&replacement));
+  EXPECT_FALSE(aside::GetAiTabsMetadata(&replacement));
+  aside::ConfirmAgentTabsAssignment(&replacement, aside::kAsideExtensionId,
