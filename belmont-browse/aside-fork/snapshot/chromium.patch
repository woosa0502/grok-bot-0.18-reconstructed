+void AddAsidePostColorMixer(ui::ColorProvider* provider,
+                            const ui::ColorProviderKey& key) {
+  ui::ColorMixer& mixer = provider->AddMixer();
+  // O01: inactive tabs in the vertical strip blend into the neutral-gray
+  // sidebar ground rather than painting the frame color (which is blue-tinted
+  // on the Linux GM3 palette). The active tab keeps its own recipe
+  // (kColorToolbar) so it still reads as a white card.
+  mixer[kColorTabBackgroundInactiveFrameActive] = {kColorAsideSidebarBackground};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {kColorAsideSidebarBackground};
+}
