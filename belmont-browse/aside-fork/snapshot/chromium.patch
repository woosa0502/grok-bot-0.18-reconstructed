+class CookieControlsBubbleCoordinatorUnitTest : public TestWithBrowserView {
+ protected:
+  void SetUp() override {
+    TestWithBrowserView::SetUp();
+    AddTab(browser(), GURL("https://example.com"));
+    controller_ =
+        std::make_unique<content_settings::CookieControlsController>(
+            CookieSettingsFactory::GetForProfile(profile()), nullptr,
+            HostContentSettingsMapFactory::GetForProfile(profile()),
+            /*is_incognito_profile=*/false);
+  }
+
+  std::unique_ptr<content_settings::CookieControlsController> controller_;
+};
+
+TEST_F(CookieControlsBubbleCoordinatorUnitTest,
+       ProfileSwitchCloseSuppressesReentrantSourceBubble) {
+  auto* coordinator = CookieControlsBubbleCoordinator::From(browser());
+  auto* toolbar_button_provider = browser_view()->toolbar_button_provider();
+  auto* web_contents = browser()->tab_strip_model()->GetActiveWebContents();
+  coordinator->ShowBubble(toolbar_button_provider, web_contents,
+                          controller_.get());
+  ASSERT_TRUE(coordinator->GetBubble());
+
+  int closing_callback_count = 0;
+  auto subscription = coordinator->RegisterBubbleClosingCallback(
+      base::BindRepeating(
+          [](CookieControlsBubbleCoordinator* coordinator,
+             ToolbarButtonProvider* toolbar_button_provider,
+             content::WebContents* web_contents,
+             content_settings::CookieControlsController* controller,
+             int* count) {
+            ++*count;
+            coordinator->ShowBubble(toolbar_button_provider, web_contents,
+                                    controller);
+          },
+          coordinator, toolbar_button_provider, web_contents,
+          controller_.get(), &closing_callback_count));
+
+  coordinator->CloseForAsideProfileSwitch();
+
+  EXPECT_EQ(1, closing_callback_count);
+  EXPECT_FALSE(coordinator->GetBubble());
+}
