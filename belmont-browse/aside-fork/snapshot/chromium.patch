+void AsideBookmarksSectionView::BindToProfile() {
+  drop_weak_factory_.InvalidateWeakPtrs();
+  OnTabDragEnded();
+  extensive_changes_ = false;
+  rebuild_pending_ = false;
+  menu_runner_.reset();
+  menu_model_.reset();
+  pending_menu_ = {};
+  if (bookmark_service_) {
+    bookmark_service_->RemoveObserver(this);
+  }
+  bookmark_service_ =
+      BookmarkMergedSurfaceServiceFactory::GetForProfile(browser_->profile());
+  model_ = bookmark_service_ ? bookmark_service_->bookmark_model() : nullptr;
+  if (bookmark_service_) {
+    bookmark_service_->AddObserver(this);
+  }
+  pref_registrar_.Reset();
+  pref_registrar_.Init(browser_->profile()->GetPrefs());
+  auto rebuild = base::BindRepeating(&AsideBookmarksSectionView::Rebuild,
+                                     base::Unretained(this));
+  pref_registrar_.Add(kEnabledPref, rebuild);
+  pref_registrar_.Add(kExpandedPref, rebuild);
+  pref_registrar_.Add(kExpandedFoldersPref, rebuild);
+  tab_representation_ =
+      std::make_unique<AsideBookmarkTabRepresentation>(browser_);
+  tab_representation_subscription_ =
+      tab_representation_->AddChangedCallback(rebuild);
+  Rebuild();
+  rows_scroll_->ScrollToOffset(gfx::PointF());
+}
