diff --git a/chrome/browser/resources/aside_import_data/index.html b/chrome/browser/resources/aside_import_data/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..60b9ff4d5afca725d31b6b6a92081bd7bf86a5dc
--- /dev/null
+++ b/chrome/browser/resources/aside_import_data/index.html
@@ -0,0 +1,590 @@
+<!-- Copyright 2026 At Your Side Inc. -->
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Aside Importer</title>
+    <style>
+      :root {
+        color-scheme: dark;
+        --window-bg: rgba(24, 24, 27, 0.7);
+        --window-base-bg: #18181b;
+        --panel-bg: rgba(255, 255, 255, 0.03);
+        --panel-active-bg: rgba(255, 255, 255, 0.08);
+        --primary-fg: rgba(255, 255, 255, 0.85);
+        --secondary-fg: rgba(255, 255, 255, 0.55);
+        --border-fg: rgba(255, 255, 255, 0.25);
+        --button-bg: #fafafa;
+        --button-fg: #0a0a0a;
+        --font-family: "SF Pro Display", "SF Pro Text", -apple-system,
+          BlinkMacSystemFont, sans-serif;
+      }
+
+      html,
+      body {
+        background: var(--window-base-bg);
+        height: 100%;
+        margin: 0;
+        overflow: hidden;
+        width: 100%;
+      }
+
+      body {
+        font-family: var(--font-family);
+        -webkit-font-smoothing: antialiased;
+        text-rendering: optimizeLegibility;
+        user-select: none;
+      }
+
+      img {
+        display: block;
+        -webkit-user-drag: none;
+        pointer-events: none;
+      }
+
+      main {
+        backdrop-filter: blur(36px);
+        background: var(--window-bg);
+        box-sizing: border-box;
+        box-shadow: 0 16px 36px 3px rgba(0, 0, 0, 0.5);
+        height: 100%;
+        overflow: hidden;
+        position: relative;
+        width: 100%;
+      }
+
+      .drag-strip {
+        -webkit-app-region: drag;
+        left: 0;
+        position: absolute;
+        right: 0;
+        top: 0;
+        height: 28px;
+        z-index: 3;
+      }
+
+      .browser-copy {
+        -webkit-app-region: no-drag;
+        bottom: 0;
+        left: 0;
+        position: absolute;
+        top: 34px;
+        width: 412px;
+      }
+
+      .copy-group {
+        left: 30px;
+        position: absolute;
+        top: 21px;
+        width: 306px;
+      }
+
+      .title {
+        color: var(--primary-fg);
+        font-size: 28px;
+        font-weight: 500;
+        line-height: 30px;
+        margin: 0;
+      }
+
+      .description {
+        color: var(--secondary-fg);
+        font-size: 15px;
+        font-weight: 400;
+        line-height: 22px;
+        margin: 10px 0 0;
+        width: 304px;
+      }
+
+      .import-button {
+        -webkit-appearance: none;
+        -webkit-app-region: no-drag;
+        align-items: center;
+        appearance: none;
+        background: var(--button-bg);
+        border: 0;
+        border-radius: 13px;
+        bottom: 26px;
+        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
+        color: var(--button-fg);
+        cursor: default;
+        display: inline-flex;
+        font-family: var(--font-family);
+        font-size: 15px;
+        font-weight: 400;
+        justify-content: center;
+        line-height: 17px;
+        padding: 8px 20px;
+        position: absolute;
+        right: 26px;
+        transition: none;
+      }
+
+      .import-button:disabled {
+        background: rgba(255, 255, 255, 0.16);
+        box-shadow: none;
+        color: rgba(255, 255, 255, 0.4);
+      }
+
+      .browser-list {
+        -webkit-app-region: no-drag;
+        background: var(--panel-bg);
+        border-radius: 8px;
+        bottom: 12px;
+        box-sizing: border-box;
+        display: flex;
+        flex-direction: column;
+        gap: 4px;
+        justify-content: flex-start;
+        min-height: 0;
+        overflow-x: hidden;
+        overflow-y: auto;
+        padding: 16px 14px;
+        position: absolute;
+        right: 12px;
+        scrollbar-gutter: stable;
+        top: 12px;
+        width: 296px;
+      }
+
+      .safari-guide-host {
+        -webkit-app-region: no-drag;
+        inset: 0;
+        pointer-events: none;
+        position: absolute;
+        z-index: 4;
+      }
+
+      .safari-guide-overlay {
+        align-items: center;
+        background: rgba(9, 10, 14, 0.58);
+        display: flex;
+        inset: 0;
+        justify-content: center;
+        pointer-events: auto;
+        position: absolute;
+      }
+
+      .safari-guide-modal {
+        background: #151519;
+        border: 1px solid rgba(255, 255, 255, 0.08);
+        border-radius: 22px;
+        box-shadow: 0 28px 60px rgba(0, 0, 0, 0.42);
+        box-sizing: border-box;
+        display: grid;
+        gap: 20px;
+        grid-template-columns: 252px minmax(0, 1fr);
+        min-height: 372px;
+        padding: 18px 18px 18px 18px;
+        position: relative;
+        width: 640px;
+      }
+
+      .safari-guide-close {
+        align-items: center;
+        appearance: none;
+        background: rgba(255, 255, 255, 0.07);
+        border: 0;
+        border-radius: 999px;
+        color: rgba(255, 255, 255, 0.78);
+        cursor: default;
+        display: inline-flex;
+        font-family: var(--font-family);
+        font-size: 18px;
+        height: 28px;
+        justify-content: center;
+        line-height: 1;
+        padding: 0;
+        position: absolute;
+        right: 14px;
+        top: 14px;
+        width: 28px;
+      }
+
+      .safari-guide-close span {
+        display: block;
+        line-height: 1;
+        transform: translateY(-1px);
+      }
