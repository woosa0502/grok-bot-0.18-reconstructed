+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr int kAvatarSize = 20;
+
+std::u16string ProfileDisplayName(Browser* browser) {
+  PrefService* prefs = browser->profile()->GetPrefs();
+  std::string name = prefs->GetString("aside.account_display_name");
+  if (name.empty()) {
+    name = prefs->GetString("aside.account_email");
+  }
+  if (name.empty()) {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (manager) {
+      ProfileAttributesEntry* entry =
+          manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+              browser->profile()->GetPath());
+      if (entry) {
+        return entry->GetName();
+      }
+    }
+  }
+  return base::UTF8ToUTF16(name);
+}
+
+}  // namespace
+
+AsideProfileFooterView::AsideProfileFooterView(Browser* browser)
+    : browser_(browser) {
+  SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  SetInsideBorderInsets(gfx::Insets::VH(6, 8));
+  SetBetweenChildSpacing(4);
+
+  auto profile = std::make_unique<AsideTextButton>(
+      base::BindRepeating(&AsideProfileFooterView::OnProfilePressed,
+                          base::Unretained(this)),
+      std::u16string(), views::style::CONTEXT_BUTTON_MD);
+  profile->SetStyle(ui::ButtonStyle::kText);
+  profile->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  profile->SetCustomPadding(gfx::Insets::VH(4, 6));
+  profile->SetImageLabelSpacing(6);
+  profile->SetLabelFontList(aside::UiFontList(13, gfx::Font::Weight::MEDIUM));
+  profile_button_ = AddChildView(std::move(profile));
+  // Aside design restoration (O01): a small disclosure chevron sits just right
+  // of the avatar (the original footer is avatar + chevron, then the search
+  // icon at the far edge).
+  auto chevron = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&AsideProfileFooterView::OnProfilePressed,
+                          base::Unretained(this)),
+      kAsideExpandMoreIcon, 14);
+  chevron->SetTooltipText(u"Profiles");
+  chevron_button_ = AddChildView(std::move(chevron));
+  // Aside design restoration (O01): compact profile chip on the left; a
+  // flexible spacer pushes the search icon to the right edge (the original's
+  // footer is a small avatar + name, not a full-width pill).
+  auto* footer_spacer = AddChildView(std::make_unique<views::View>());
+  SetFlexForView(footer_spacer, 1);
+
+  auto search = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&AsideProfileFooterView::OnSearchPressed,
+                          base::Unretained(this)),
+      kAsideMagnifyingGlassStrokeIcon, 18);
+  search->SetTooltipText(u"Search");
+  search_button_ = AddChildView(std::move(search));
+
+  ObserveProfilePrefs();
+  // The profile pager keeps this window and swaps its profile, so the footer
+  // has to leave the old profile's prefs behind and re-read the name.
+  profile_switched_subscription_ =
+      browser_->RegisterAsideProfileSwitched(base::BindRepeating(
+          &AsideProfileFooterView::OnProfileSwitched, base::Unretained(this)));
+}
+
+void AsideProfileFooterView::ObserveProfilePrefs() {
+  pref_registrar_.Reset();
+  pref_registrar_.Init(browser_->profile()->GetPrefs());
+  auto update = base::BindRepeating(&AsideProfileFooterView::UpdateFromPrefs,
+                                    base::Unretained(this));
+  for (const char* pref : {"aside.account_display_name", "aside.account_email",
+                           "aside.account_auth_paused", "aside.account_id"}) {
+    pref_registrar_.Add(pref, update);
+  }
+  UpdateFromPrefs();
+}
+
+void AsideProfileFooterView::OnProfileSwitched(Browser* browser) {
+  ObserveProfilePrefs();
+}
+
+AsideProfileFooterView::~AsideProfileFooterView() = default;
+
+void AsideProfileFooterView::UpdateFromPrefs() {
+  const bool incognito = browser_->profile()->IsIncognitoProfile();
+  const bool paused =
+      browser_->profile()->GetPrefs()->GetBoolean("aside.account_auth_paused");
+  // Aside design restoration (O01): the footer profile control is avatar-only
+  // (no full display-name label); the name stays in the tooltip.
+  profile_button_->SetText(std::u16string());
+  profile_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          incognito ? kAsideIncognitoRefreshMenuIcon
+                    : vector_icons::kAccountCircleChromeRefreshOldIcon,
+          paused ? ui::kColorAlertMediumSeverityIcon : ui::kColorIcon,
+          kAvatarSize));
+  profile_button_->SetTooltipText(paused ? std::u16string(u"Sign-in paused")
+                                         : ProfileDisplayName(browser_));
+}
+
+void AsideProfileFooterView::OnProfilePressed() {
+  // Original: AsideProfileMenuView (Aside-styled panel) instead of the
+  // Chromium avatar menu.
+  AsideProfileMenuView::Show(profile_button_, browser_);
+}
+
+void AsideProfileFooterView::OnSearchPressed() {
+  // Linux does not automatically flip an off-screen bubble. The footer must
+  // open upward; header callers keep the default downward arrow.
+  AsideTabSearchBubbleContentsView::MaybeShow(
+      search_button_, browser_->profile(), views::BubbleBorder::BOTTOM_LEFT);
+}
+
+BEGIN_METADATA(AsideProfileFooterView)
+END_METADATA
