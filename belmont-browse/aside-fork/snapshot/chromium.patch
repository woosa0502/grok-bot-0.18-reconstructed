+
+void AsideComponentUpdateService::OnComponentReady(
+    AsideComponentKind kind,
+    const base::Version& version,
+    const base::FilePath& install_dir,
+    base::DictValue manifest) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!started_) {
+    return;
+  }
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+  if (kind != AsideComponentKind::kDaemon) {
+    // Validate before replacing a working version. Use the same location and
+    // flags as ComponentLoader, and preserve the signed manifest verbatim.
+    std::u16string error;
+    auto extension = extensions::Extension::Create(
+        install_dir, extensions::mojom::ManifestLocation::kComponent, manifest,
+        extensions::Extension::REQUIRE_KEY, &error);
+    if (!extension || extension->id() != AsideComponentAppId(kind) ||
+        extension->version() != version) {
+      LOG(ERROR) << "Invalid Aside component extension: "
+                 << AsideComponentToken(kind) << ": " << error;
+      return;
+    }
+  }
+#endif
+  Installed& slot = installed_[kind];
+  const bool changed = slot.version != version;
+  slot.version = version;
+  slot.install_dir = install_dir;
+  slot.manifest = std::move(manifest);
+  if (kind != AsideComponentKind::kDaemon) {
+    if (profile_manager_observation_.IsObserving()) {
+      for (Profile* profile :
+           profile_manager_observation_.GetSource()->GetLoadedProfiles()) {
+        LoadComponentExtensionsForProfile(profile);
+      }
+    }
+    return;
+  }
+  if (changed) {
+    RestartDaemonForComponentUpdate(version, install_dir);
+  }
+}
