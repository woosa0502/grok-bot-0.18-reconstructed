+  raw_ptr<views::MdTextButton> take_over_button_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_AGENT_CONTROL_BANNER_H_
diff --git a/chrome/browser/ui/views/frame/aside_bookmark_dialogs.cc b/chrome/browser/ui/views/frame/aside_bookmark_dialogs.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d27043e9639bbad3fb9f8ae38b3b866990984052
--- /dev/null
+++ b/chrome/browser/ui/views/frame/aside_bookmark_dialogs.cc
@@ -0,0 +1,333 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/aside_bookmark_dialogs.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/dialogs/browser_dialogs.h"
+#include "components/bookmarks/browser/bookmark_client.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/browser/bookmark_utils.h"
+#include "components/bookmarks/common/bookmark_metrics.h"
+#include "components/bookmarks/common/bookmark_pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/url_formatter/url_fixer.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/models/dialog_model_field.h"
+#include "url/gurl.h"
+
+namespace aside {
+namespace {
+
+// vertical_tab_bookmarks_view.cc lines 148-150 in the original.
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kRenameFolderFieldId);
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kEditBookmarkNameFieldId);
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kEditBookmarkUrlFieldId);
+
+// Original UTF-16 literals (arm64 0xd77ab0c-0xd77ad8a).
+constexpr char16_t kRename[] = u"Rename";
+constexpr char16_t kDelete[] = u"Delete";
+constexpr char16_t kCancel[] = u"Cancel";
+constexpr char16_t kSave[] = u"Save";
+constexpr char16_t kRenameFolderTitle[] = u"Rename Folder";
+constexpr char16_t kFolderName[] = u"Folder name";
+constexpr char16_t kDeleteFolderTitle[] = u"Delete Folder";
+constexpr char16_t kDeleteThisFolder[] =
+    u"Delete this folder and everything inside it?";
+constexpr char16_t kDeleteQuotePrefix[] = u"Delete \"";
+constexpr char16_t kAndEverythingInside[] = u"\" and everything inside it?";
+constexpr char16_t kEditBookmarkTitle[] = u"Edit Bookmark";
+constexpr char16_t kName[] = u"Name";
+constexpr char16_t kUrl[] = u"URL";
+constexpr char16_t kDeleteThisBookmark[] = u"Delete this bookmark?";
+constexpr char16_t kQuoteQuestion[] = u"\"?";
+constexpr char16_t kDeleteBookmarkTitle[] = u"Delete Bookmark";
+
+bookmarks::BookmarkModel* ModelFor(Browser* browser) {
+  return browser ? BookmarkModelFactory::GetForBrowserContext(
+                       browser->profile())
+                 : nullptr;
+}
+
+const bookmarks::BookmarkNode* NodeFor(Browser* browser, int64_t id) {
+  bookmarks::BookmarkModel* model = ModelFor(browser);
+  if (!model || !model->loaded()) {
+    return nullptr;
+  }
+  return bookmarks::GetBookmarkNodeByID(model, id);
+}
+
+// Both delete dialogs pick between a generic sentence and one that quotes the
+// node title, exactly like the original (RE 0x43c6c58 / 0x43c6fc0: the branch
+// tests the title for emptiness and otherwise concatenates
+// 'Delete "' + title + suffix).
+std::u16string DeleteBody(const std::u16string& title,
+                          const std::u16string& generic,
+                          const std::u16string& suffix) {
+  if (title.empty()) {
+    return generic;
+  }
+  return std::u16string(kDeleteQuotePrefix) + title + suffix;
+}
+
+const bookmarks::BookmarkNode* EditableDialogNode(
+    base::WeakPtr<Browser> browser,
+    base::WeakPtr<Profile> opening_profile,
+    int64_t node_id,
+    const base::Uuid& node_uuid) {
+  if (!browser || !opening_profile ||
+      browser->profile() != opening_profile.get() ||
+      !CanEditBookmark(browser.get(), node_id)) {
+    return nullptr;
+  }
+  const bookmarks::BookmarkNode* node = NodeFor(browser.get(), node_id);
+  return node && node->uuid() == node_uuid ? node : nullptr;
+}
+
+// The Browser can survive a profile pager switch while this model is open.
+// Retain weak opening identity, then resolve the current editable node at each
+// commit so a reused numeric ID cannot select another profile's bookmark.
+class BookmarkDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  BookmarkDialogDelegate(Browser* browser, const bookmarks::BookmarkNode& node)
+      : browser_(browser->AsWeakPtr()),
+        opening_profile_(browser->profile()->GetWeakPtr()),
+        node_id_(node.id()),
+        node_uuid_(node.uuid()) {}
+
+  void OnRenameFolder() {
+    const std::u16string title =
+        dialog_model()->GetTextfieldByUniqueId(kRenameFolderFieldId)->text();
+    const bookmarks::BookmarkNode* node =
+        EditableDialogNode(browser_, opening_profile_, node_id_, node_uuid_);
+    if (!node || !node->is_folder()) {
+      return;
+    }
+    ModelFor(browser_.get())
+        ->SetTitle(node, title, bookmarks::metrics::BookmarkEditSource::kUser);
+  }
+
+  void OnEditBookmark() {
+    // Bookmark observers can run synchronously during SetTitle. Keep only
+    // independent weak identities and field values across that notification,
+    // then recheck permission and node identity before the URL mutation.
+    const auto browser = browser_;
+    const auto opening_profile = opening_profile_;
+    const int64_t node_id = node_id_;
+    const base::Uuid node_uuid = node_uuid_;
+    const std::u16string title =
+        dialog_model()
+            ->GetTextfieldByUniqueId(kEditBookmarkNameFieldId)
+            ->text();
+    const GURL url = url_formatter::FixupURL(
+        base::UTF16ToUTF8(
+            dialog_model()->GetTextfieldByUniqueId(kEditBookmarkUrlFieldId)
+                ->text()),
+        std::string());
+    const bookmarks::BookmarkNode* node =
+        EditableDialogNode(browser, opening_profile, node_id, node_uuid);
+    if (!node || !node->is_url()) {
+      return;
+    }
+    ModelFor(browser.get())
+        ->SetTitle(node, title, bookmarks::metrics::BookmarkEditSource::kUser);
+    node = EditableDialogNode(browser, opening_profile, node_id, node_uuid);
+    if (url.is_valid() && node && node->is_url()) {
+      ModelFor(browser.get())
+          ->SetURL(node, url, bookmarks::metrics::BookmarkEditSource::kUser);
+    }
+  }
+
+  void OnDelete() {
+    const bookmarks::BookmarkNode* node =
+        EditableDialogNode(browser_, opening_profile_, node_id_, node_uuid_);
+    if (!node) {
+      return;
+    }
+    ModelFor(browser_.get())
+        ->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                 FROM_HERE);
+  }
+
+ private:
+  const base::WeakPtr<Browser> browser_;
+  const base::WeakPtr<Profile> opening_profile_;
+  const int64_t node_id_;
+  const base::Uuid node_uuid_;
+};
+
+std::unique_ptr<ui::DialogModel> CreateRenameFolderDialog(Browser* browser,
+                                                          int64_t folder_id) {
+  const bookmarks::BookmarkNode* node = NodeFor(browser, folder_id);
+  if (!node || !node->is_folder()) {
+    return nullptr;
+  }
+  auto delegate = std::make_unique<BookmarkDialogDelegate>(browser, *node);
+  BookmarkDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kRenameFolderTitle)
+          .SetInternalName("VerticalTabBookmarksRenameFolder")
+          .AddTextfield(kRenameFolderFieldId, kFolderName, node->GetTitle())
+          .AddOkButton(
+              base::BindOnce(&BookmarkDialogDelegate::OnRenameFolder,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kRename))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kRenameFolderFieldId)
+          .Build();
+  return model;
+}
+
+std::unique_ptr<ui::DialogModel> CreateDeleteFolderDialog(Browser* browser,
+                                                          int64_t folder_id) {
+  const bookmarks::BookmarkNode* node = NodeFor(browser, folder_id);
+  if (!node || !node->is_folder() || node->is_permanent_node()) {
+    return nullptr;
+  }
+  auto delegate = std::make_unique<BookmarkDialogDelegate>(browser, *node);
+  BookmarkDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteFolderTitle)
+          .SetInternalName("VerticalTabBookmarksDeleteFolder")
+          .AddParagraph(ui::DialogModelLabel(DeleteBody(
+              node->GetTitle(), kDeleteThisFolder, kAndEverythingInside)))
+          .AddOkButton(
+              base::BindOnce(&BookmarkDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  return model;
+}
+
+std::unique_ptr<ui::DialogModel> CreateEditBookmarkDialog(Browser* browser,
+                                                          int64_t node_id) {
+  const bookmarks::BookmarkNode* node = NodeFor(browser, node_id);
+  if (!node || !node->is_url()) {
+    return nullptr;
+  }
+  auto delegate = std::make_unique<BookmarkDialogDelegate>(browser, *node);
+  BookmarkDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kEditBookmarkTitle)
+          .SetInternalName("VerticalTabBookmarksEditBookmark")
+          .AddTextfield(kEditBookmarkNameFieldId, kName, node->GetTitle())
+          .AddTextfield(kEditBookmarkUrlFieldId, kUrl,
+                        base::UTF8ToUTF16(node->url().spec()))
+          .AddOkButton(base::BindOnce(&BookmarkDialogDelegate::OnEditBookmark,
+                                      base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(kSave))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kEditBookmarkNameFieldId)
+          .Build();
+  return model;
+}
+
+std::unique_ptr<ui::DialogModel> CreateDeleteBookmarkDialog(Browser* browser,
+                                                            int64_t node_id) {
+  const bookmarks::BookmarkNode* node = NodeFor(browser, node_id);
+  if (!node || !node->is_url()) {
+    return nullptr;
+  }
+  auto delegate = std::make_unique<BookmarkDialogDelegate>(browser, *node);
+  BookmarkDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteBookmarkTitle)
+          .SetInternalName("VerticalTabBookmarksDeleteBookmark")
+          .AddParagraph(ui::DialogModelLabel(DeleteBody(
+              node->GetTitle(), kDeleteThisBookmark, kQuoteQuestion)))
+          .AddOkButton(
+              base::BindOnce(&BookmarkDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  return model;
+}
+
+}  // namespace
+
+bool CanEditBookmark(Browser* browser, int64_t node_id) {
+  if (!browser || !browser->profile()->GetPrefs()->GetBoolean(
+                      bookmarks::prefs::kEditBookmarksEnabled)) {
+    return false;
+  }
+  bookmarks::BookmarkModel* model = ModelFor(browser);
+  const bookmarks::BookmarkNode* node = NodeFor(browser, node_id);
+  return model && node && !node->is_root() && !node->is_permanent_node() &&
+         !model->client()->IsNodeManaged(node);
+}
+
+std::unique_ptr<ui::DialogModel> CreateBookmarkDialogModel(
+    Browser* browser,
+    int64_t node_id,
+    BookmarkDialogType type) {
+  if (!CanEditBookmark(browser, node_id)) {
+    return nullptr;
+  }
+  switch (type) {
+    case BookmarkDialogType::kRenameFolder:
+      return CreateRenameFolderDialog(browser, node_id);
+    case BookmarkDialogType::kDeleteFolder:
+      return CreateDeleteFolderDialog(browser, node_id);
+    case BookmarkDialogType::kEditBookmark:
+      return CreateEditBookmarkDialog(browser, node_id);
+    case BookmarkDialogType::kDeleteBookmark:
+      return CreateDeleteBookmarkDialog(browser, node_id);
+  }
+  return nullptr;
+}
+
+void ShowRenameFolderDialog(Browser* browser, int64_t folder_id) {
+  if (auto model = CreateBookmarkDialogModel(
+          browser, folder_id, BookmarkDialogType::kRenameFolder)) {
+    chrome::ShowBrowserModal(browser, std::move(model));
+  }
+}
+
+void ShowDeleteFolderDialog(Browser* browser, int64_t folder_id) {
+  if (auto model = CreateBookmarkDialogModel(
+          browser, folder_id, BookmarkDialogType::kDeleteFolder)) {
+    chrome::ShowBrowserModal(browser, std::move(model));
+  }
+}
+
+void ShowEditBookmarkDialog(Browser* browser, int64_t node_id) {
+  if (auto model = CreateBookmarkDialogModel(
+          browser, node_id, BookmarkDialogType::kEditBookmark)) {
+    chrome::ShowBrowserModal(browser, std::move(model));
+  }
+}
+
+void ShowDeleteBookmarkDialog(Browser* browser, int64_t node_id) {
+  if (auto model = CreateBookmarkDialogModel(
+          browser, node_id, BookmarkDialogType::kDeleteBookmark)) {
+    chrome::ShowBrowserModal(browser, std::move(model));
+  }
+}
+
+}  // namespace aside
