+  EXPECT_EQ(observer.call_count(), 1);
+  ASSERT_TRUE(observer.events()[0]->is_added());
+  EXPECT_EQ(observer.events()[0]->get_added()->node->get_url()->title,
+            "Ready event");
+
+  // Restore the fixture-owned model before the local target model is
+  // destroyed; the service's translator must never outlive its model.
+  service_->Rebind(model_.get(), nullptr);
