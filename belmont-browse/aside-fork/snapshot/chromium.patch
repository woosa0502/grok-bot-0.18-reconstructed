+}
+
+void Browser::NotifyAsideProfileSwitchedAfterAdoption() {
+  const auto weak_this = GetWeakPtr();
+  browser_window_features()->RebindProfileServicesForAside(this);
+  if (!weak_this) {
+    return;
+  }
+  aside_profile_switched_callback_list_.Notify(this);
+  if (!weak_this) {
+    return;
+  }
+  browser_window_features()->RebindProfileViewServicesForAside(this);
+}
+
+bool Browser::BeginAsideProfileSwitch(const base::FilePath& path) {
+  if (aside_profile_switch_in_progress_) {
+    aside_pending_profile_switch_ = path;
+    return false;
+  }
+  aside_profile_switch_in_progress_ = true;
+  return true;
+}
+
+void Browser::CompleteAsideProfileSwitch() {
+  if (!aside_pending_profile_switch_) {
+    aside_profile_switch_in_progress_ = false;
+    return;
+  }
+  // Stay busy through the posted drain. Newer clicks replace the pending
+  // destination instead of being overtaken by a stale captured request.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<Browser> browser) {
+                       if (!browser || browser->IsDeleteScheduled()) {
+                         return;
+                       }
+                       base::FilePath next =
+                           std::move(*browser->aside_pending_profile_switch_);
+                       browser->aside_pending_profile_switch_.reset();
+                       browser->aside_profile_switch_in_progress_ = false;
+                       chrome::SwitchProfileInPlaceForAside(browser.get(), next);
+                     },
+                     AsWeakPtr()));
+}
+
+void Browser::ClearTabStripEmptySuppressionForAsideProfileSwitch() {
+  aside_suppress_tab_strip_empty_ = false;
+  if (tab_strip_model_->empty()) {
+    window_->Close();
+  }
+}
