+void ProfileManagementDisclaimerService::OnBrowserRemovedForProfileSwitch(
+    BrowserWindowInterface* browser) {
+  ManagedProfileCreationController* const creation_controller =
+      state_->profile_creation_controller.get();
+  if (!creation_controller) {
+    return;
+  }
+
+  if (!creation_controller->IsManagementDisclaimerShownIn(browser)) {
+    return;
+  }
+
+  SigninViewController* const signin_controller =
+      browser->GetFeatures().signin_view_controller();
+
+  // The modal is attached to the persistent native window, but its flow and
+  // callbacks belong to the source profile. Close it before Browser::profile()
+  // changes, then cancel only the controller that owned that modal. Closing
+  // the dialog can re-enter this service and complete the flow by itself.
+  base::WeakPtr<ProfileManagementDisclaimerService> weak_this =
+      weak_ptr_factory_.GetWeakPtr();
+  signin_controller->CloseModalSignin();
+  if (weak_this &&
+      weak_this->state_->profile_creation_controller.get() ==
+          creation_controller) {
+    weak_this->Reset();
+  }
+}
