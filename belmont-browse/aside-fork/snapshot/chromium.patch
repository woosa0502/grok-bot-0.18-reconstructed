+TEST_F(BrowserUnitTest, AsideParkedWindowSurvivesNativeSessionServiceRecreation) {
+  TabStripModel* model = browser()->tab_strip_model();
+  const std::vector<GURL> urls = {
+      GURL("https://example.test/parked-a"),
+      GURL("https://example.test/parked-b"),
+      GURL("https://example.test/parked-c"),
+      GURL("https://example.test/parked-d"),
+  };
+  std::vector<SessionID> tab_ids;
+  for (const GURL& url : urls) {
+    auto contents = CreateTestWebContents();
+    WebContents* const raw_contents = contents.get();
+    model->AppendWebContents(std::move(contents), model->empty());
+    WebContentsTester::For(raw_contents)->NavigateAndCommit(url);
+    tab_ids.push_back(
+        sessions::SessionTabHelper::FromWebContents(raw_contents)->session_id());
+  }
+  model->SetTabPinned(0, true);
+  const auto group = model->AddToNewGroup({1, 2});
+  const tab_groups::TabGroupVisualData group_visuals(
+      u"Journal group", tab_groups::TabGroupColorId::kBlue);
+  model->ChangeTabGroupVisuals(group, group_visuals);
+  model->ActivateTabAt(1);
+  const split_tabs::SplitTabVisualData split_visuals(
+      split_tabs::SplitTabLayout::kStacked, 0.3);
+  const auto split = model->AddToNewSplit(
+      {2}, split_visuals, split_tabs::SplitTabCreatedSource::kToolbarButton);
+  model->ActivateTabAt(0);
+  model->AddSelectionFromAnchorTo(2);
+
+  // Testing profiles have no factory-owned SessionService. Exercise the real
+  // command writer directly, then destroy it with the live strip still empty.
+  {
+    SessionService service(profile());
+    SessionServiceTestHelper helper(&service);
+    service.ParkWindowForAside(browser());
+    browser()->StashTabsForAsideProfileSwitch();
+    ASSERT_TRUE(model->empty());
+    service.ResetFromCurrentBrowsers();
+    helper.SaveNow();
+  }
+  content::RunAllTasksUntilIdle();
+
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  {
+    SessionService reader(profile());
+    SessionServiceTestHelper helper(&reader);
+    content::RunAllTasksUntilIdle();
+    SessionID active_window = SessionID::InvalidValue();
+    std::string platform_session;
+    std::set<SessionID> discarded_windows;
+    helper.ReadWindows(&windows, &active_window, &platform_session,
+                       &discarded_windows);
+  }
+  content::RunAllTasksUntilIdle();
+
+  ASSERT_EQ(1u, windows.size());
+  const sessions::SessionWindow& saved = *windows.front();
+  EXPECT_EQ(browser()->session_id(), saved.window_id);
+  ASSERT_EQ(urls.size(), saved.tabs.size());
+  EXPECT_EQ(2, saved.selected_tab_index);
+  for (size_t i = 0; i < saved.tabs.size(); ++i) {
+    SCOPED_TRACE(i);
+    const sessions::SessionTab& tab = *saved.tabs[i];
+    EXPECT_EQ(tab_ids[i], tab.tab_id);
+    EXPECT_EQ(saved.window_id, tab.window_id);
+    EXPECT_EQ(static_cast<int>(i), tab.tab_visual_index);
+    EXPECT_EQ(i == 0, tab.pinned);
+    ASSERT_EQ(1u, tab.navigations.size());
+    EXPECT_EQ(urls[i], tab.navigations[0].virtual_url());
+    if (i == 1 || i == 2) {
+      EXPECT_EQ(group, tab.group);
+      EXPECT_EQ(split, tab.split_id);
+    } else {
+      EXPECT_FALSE(tab.group.has_value());
+      EXPECT_FALSE(tab.split_id.has_value());
+    }
+  }
+  ASSERT_EQ(1u, saved.tab_groups.size());
+  EXPECT_EQ(group, saved.tab_groups[0]->id);
+  EXPECT_EQ(group_visuals, saved.tab_groups[0]->visual_data);
+  ASSERT_EQ(1u, saved.split_tabs.size());
+  EXPECT_EQ(split, saved.split_tabs[0]->id_);
+  EXPECT_EQ(split_visuals, saved.split_tabs[0]->split_visual_data_);
+
+  const auto selection_entry = saved.extra_data.find("aside.tab_selection.v1");
+  ASSERT_NE(saved.extra_data.end(), selection_entry);
+  const auto selection = base::JSONReader::ReadDict(
+      selection_entry->second, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(selection.has_value());
+  EXPECT_EQ(1, selection->FindInt("version"));
+  EXPECT_EQ(4, selection->FindInt("count"));
+  EXPECT_EQ(2, selection->FindInt("active"));
+  EXPECT_EQ(0, selection->FindInt("anchor"));
+  const auto* selected = selection->FindList("selected");
+  ASSERT_NE(nullptr, selected);
+  ASSERT_EQ(3u, selected->size());
+  for (size_t i = 0; i < selected->size(); ++i) {
+    EXPECT_EQ(static_cast<int>(i), (*selected)[i].GetIfInt());
+  }
+
+  EXPECT_EQ(4, browser()->RestoreTabsForAsideProfileSwitch());
+  browser()->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+}
