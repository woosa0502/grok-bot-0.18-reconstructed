+//
+// Replica of the original components/aside_adblock AsideAdBlockService:
+// owns filter subscriptions, custom rules and manual filter files under
+// <profile>/AsideAdBlock, compiles them into an aside_adblock::Engine on a
+// worker thread, and serves the chrome://aside-adblock internals page.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_SERVICE_H_
