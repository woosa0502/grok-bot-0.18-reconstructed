+TEST_F(ActorOverlayWebViewTestBase,
+       RebindDrainsPendingCallbacksWithoutCreatingReentrantContents) {
+  auto tab_contents = content::WebContentsTester::CreateTestWebContents(
+      profile_.get(), nullptr);
+  tabs::MockTabInterface tab;
+  ON_CALL(tab, GetContents()).WillByDefault(Return(tab_contents.get()));
+  web_view_->set_web_ui(nullptr);
+
+  auto target_profile = std::make_unique<TestingProfile>();
+  int drained_callbacks = 0;
+  int reentrant_callbacks = 0;
+  web_view_->ShowUI(
+      &tab,
+      base::BindOnce(
+          [](TestActorOverlayWebView* view, tabs::TabInterface* tab,
+             Profile* target_profile, int* drained, int* reentrant) {
+            ++*drained;
+            EXPECT_EQ(target_profile, view->GetBrowserContext());
+            EXPECT_EQ(nullptr, view->web_contents());
+            view->ShowUI(
+                tab, base::BindOnce([](int* count) { ++*count; }, reentrant));
+          },
+          web_view_.get(), &tab, target_profile.get(), &drained_callbacks,
+          &reentrant_callbacks));
+  web_view_->ShowUI(
+      &tab, base::BindOnce([](int* count) { ++*count; }, &drained_callbacks));
+
+  ASSERT_TRUE(web_view_->web_contents());
+  base::WeakPtr<content::WebContents> source_contents =
+      web_view_->web_contents()->GetWeakPtr();
+  EXPECT_TRUE(web_view_->GetVisible());
+  EXPECT_TRUE(tab_contents->ShouldIgnoreInputEventsForTesting());
+  EXPECT_EQ(0, drained_callbacks);
+  EXPECT_EQ(0, reentrant_callbacks);
+
+  web_view_->RebindToProfile(target_profile.get());
+  test_web_ui_.set_web_contents(nullptr);
+
+  EXPECT_EQ(2, drained_callbacks);
+  EXPECT_EQ(1, reentrant_callbacks);
+  EXPECT_FALSE(source_contents);
+  EXPECT_EQ(nullptr, web_view_->web_contents());
+  EXPECT_FALSE(web_view_->GetVisible());
+  EXPECT_FALSE(tab_contents->ShouldIgnoreInputEventsForTesting());
+  EXPECT_EQ(target_profile.get(), web_view_->GetBrowserContext());
+
+  // A second rebind must not redispatch either drained source callback.
+  web_view_->RebindToProfile(profile_.get());
+  EXPECT_EQ(2, drained_callbacks);
+  EXPECT_EQ(1, reentrant_callbacks);
+  EXPECT_EQ(profile_.get(), web_view_->GetBrowserContext());
+}
