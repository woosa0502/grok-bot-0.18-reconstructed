+void AsideComponentUpdateService::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (started_ || !IsEnabled()) {
+    return;
+  }
+  if (!g_browser_process || !g_browser_process->local_state()) {
+    return;
+  }
+  started_ = true;
+  if (auto* profile_manager = g_browser_process->profile_manager()) {
+    profile_manager_observation_.Observe(profile_manager);
+  }
+
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kPinnedVersionSwitch)) {
+    const base::Version version(
+        command_line->GetSwitchValueASCII(kPinnedVersionSwitch));
+    base::FilePath user_data_dir;
+    if (!version.IsValid() ||
+        !base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir)) {
+      LOG(ERROR) << "Invalid pinned Aside component version or profile path";
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&LoadAsidePinnedComponents, user_data_dir, version),
+        base::BindOnce(
+            [](base::WeakPtr<AsideComponentUpdateService> service,
+               base::Version version,
+               std::optional<std::vector<AsidePinnedComponent>> components) {
+              if (!service || !service->started_) {
+                return;
+              }
+              if (!components) {
+                LOG(ERROR) << "Missing or invalid pinned Aside component pair: "
+                           << version.GetString();
+                return;
+              }
+              for (auto& component : *components) {
+                service->OnComponentReady(component.kind, version,
+                                          component.install_dir,
+                                          std::move(component.manifest));
+              }
+            },
+            weak_factory_.GetWeakPtr(), version));
+    return;
+  }
+
+  auto scheduler = std::make_unique<AsideUpdateScheduler>(
+      base::BindRepeating(&AsideComponentUpdateService::RunHealthGate,
+                          weak_factory_.GetWeakPtr()));
+  cus_ = ComponentUpdateServiceFactory(
+      base::MakeRefCounted<AsideConfigurator>(
+          base::CommandLine::ForCurrentProcess(),
+          g_browser_process->local_state()),
+      std::move(scheduler), /*brand=*/std::string());
+
+  RegisterAsideComponents(
+      cus_.get(),
+      base::BindRepeating(&AsideComponentUpdateService::OnComponentReady,
+                          weak_factory_.GetWeakPtr()));
+}
+
+void AsideComponentUpdateService::Shutdown() {
+  profile_manager_observation_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+  activation_timer_.Stop();
+  cus_.reset();
+  installed_.clear();
+  started_ = false;
+}
+
+void AsideComponentUpdateService::CheckNow(
+    base::OnceCallback<void(bool)> callback) {
+  if (!cus_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const std::string app_id =
+      AsideComponentAppId(AsideComponentKind::kDaemon);
+  if (app_id.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  cus_->GetOnDemandUpdater().OnDemandUpdate(
+      app_id, OnDemandUpdater::Priority::FOREGROUND,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> cb, update_client::Error error) {
+            std::move(cb).Run(error == update_client::Error::NONE);
+          },
+          std::move(callback)));
+}
