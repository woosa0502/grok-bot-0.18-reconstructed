+void AsideVerticalTabStripAdditions::OnProfileSwitched(Browser* browser) {
+  // A profile pager reuses this native view. Cancel old-account responses and
+  // bind the next recent-chat request to the newly selected profile.
+  weak_factory_.InvalidateWeakPtrs();
+  menu_runner_.reset();
+  menu_model_.reset();
+  pending_menu_ = {};
+  tasks_client_.reset();
+  recents_in_flight_ = false;
+  recents_rows_->RemoveAllChildViews();
+  tasks_rows_->RemoveAllChildViews();
+  row_menus_.clear();
+  shown_popovers_.clear();
+  UpdateSectionVisibility();
+  FetchRecents();
+}
