+TEST_F(BrowserUnitTest, AsideStashRestorePreservesTabIdentitiesAndCollections) {
+  TabStripModel* model = browser()->tab_strip_model();
+  std::vector<WebContents*> original_contents;
+  std::vector<tabs::TabInterface*> original_tabs;
+  for (int i = 0; i < 8; ++i) {
+    auto contents = CreateTestWebContents();
+    original_contents.push_back(contents.get());
+    model->AppendWebContents(std::move(contents), i == 0);
+    original_tabs.push_back(model->GetTabAtIndex(i));
+  }
+
+  // Include a standalone pinned tab, a pinned split, and a split nested in a
+  // collapsed group. Flattening detached collections must fail this test.
+  for (int i = 0; i < 3; ++i) {
+    model->SetTabPinned(i, true);
+  }
+  model->ActivateTabAt(1);
+  const split_tabs::SplitTabVisualData pinned_visuals(
+      split_tabs::SplitTabLayout::kStacked, 0.3);
+  const auto pinned_split = model->AddToNewSplit(
+      {2}, pinned_visuals, split_tabs::SplitTabCreatedSource::kToolbarButton);
+  const auto group = model->AddToNewGroup({4, 5, 6});
+  model->ActivateTabAt(4);
+  const split_tabs::SplitTabVisualData grouped_visuals(
+      split_tabs::SplitTabLayout::kSideBySide, 0.7);
+  const auto grouped_split = model->AddToNewSplit(
+      {5}, grouped_visuals, split_tabs::SplitTabCreatedSource::kToolbarButton);
+
+  ui::ListSelectionModel expected_selection;
+  for (size_t index : {0u, 1u, 2u, 7u}) {
+    expected_selection.AddIndexToSelection(index);
+  }
+  expected_selection.set_active(2);
+  expected_selection.set_anchor(7);
+  model->SetSelectionFromModel(expected_selection);
+  const tab_groups::TabGroupVisualData group_visuals(
+      u"Parked research", tab_groups::TabGroupColorId::kPurple, true);
+  model->ChangeTabGroupVisuals(group, group_visuals);
+  ASSERT_EQ(expected_selection,
+            model->selection_model().GetListSelectionModel());
+
+  // The second cycle also catches unload work left over from the first empty
+  // strip. Drain posted work before declaring the restored tabs preserved.
+  for (int cycle = 0; cycle < 2; ++cycle) {
+    SCOPED_TRACE(cycle);
+    browser()->StashTabsForAsideProfileSwitch();
+    ASSERT_TRUE(model->empty());
+    ASSERT_EQ(8, browser()->RestoreTabsForAsideProfileSwitch());
+    base::RunLoop().RunUntilIdle();
+    ASSERT_EQ(8, model->count());
+    for (int i = 0; i < model->count(); ++i) {
+      SCOPED_TRACE(i);
+      EXPECT_EQ(original_contents[i], model->GetWebContentsAt(i));
+      EXPECT_EQ(original_tabs[i], model->GetTabAtIndex(i));
+      EXPECT_EQ(i < 3, model->IsTabPinned(i));
+      if (i >= 4 && i <= 6) {
+        EXPECT_EQ(group, model->GetTabGroupForTab(i));
+      } else {
+        EXPECT_FALSE(model->GetTabGroupForTab(i).has_value());
+      }
+    }
+    EXPECT_EQ(pinned_split, model->GetSplitForTab(1));
+    EXPECT_EQ(pinned_split, model->GetSplitForTab(2));
+    EXPECT_EQ(grouped_split, model->GetSplitForTab(4));
+    EXPECT_EQ(grouped_split, model->GetSplitForTab(5));
+    for (int index : {0, 3, 6, 7}) {
+      EXPECT_FALSE(model->GetSplitForTab(index).has_value());
+    }
+    ASSERT_NE(nullptr, model->GetSplitData(pinned_split));
+    ASSERT_NE(nullptr, model->GetSplitData(grouped_split));
+    EXPECT_EQ(pinned_visuals,
+              *model->GetSplitData(pinned_split)->visual_data());
+    EXPECT_EQ(grouped_visuals,
+              *model->GetSplitData(grouped_split)->visual_data());
+    ASSERT_TRUE(model->group_model()->ContainsTabGroup(group));
+    EXPECT_EQ(group_visuals,
+              *model->group_model()->GetTabGroup(group)->visual_data());
+    EXPECT_EQ(expected_selection,
+              model->selection_model().GetListSelectionModel());
+  }
+  EXPECT_EQ(0, browser()->RestoreTabsForAsideProfileSwitch());
+  browser()->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+}
