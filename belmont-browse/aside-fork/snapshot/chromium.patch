diff --git a/chrome/browser/aside_adblock/aside_adblock_cosmetic_request.h b/chrome/browser/aside_adblock/aside_adblock_cosmetic_request.h
new file mode 100644
index 0000000000000000000000000000000000000000..a4d1876bae4f39f422c8cc7a9e61b30a2b50eadf
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_cosmetic_request.h
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_REQUEST_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_REQUEST_H_
+
+#include <cstdint>
+#include <string>
+#include <utility>
+
+#include "base/functional/callback.h"
+
+namespace aside_adblock {
+
+// One outstanding document request, shared by the production Mojo host and
+// deterministic regressions. A loading engine is distinct from disabled or a
+// ready engine with no cosmetic rules. Every completion is generation-bound.
+class PendingCosmeticRequest {
+ public:
+  PendingCosmeticRequest();
+  ~PendingCosmeticRequest();
+  PendingCosmeticRequest(const PendingCosmeticRequest&) = delete;
+  PendingCosmeticRequest& operator=(const PendingCosmeticRequest&) = delete;
+
+  enum class State { kDisabled, kLoading, kReady, kFailed };
+  using Callback = base::OnceCallback<void(bool, const std::string&)>;
+
+  static State Readiness(bool enabled,
+                         bool metadata_loaded,
+                         bool engine_available,
+                         bool initial_downloads_pending,
+                         bool compile_current,
+                         bool compile_failed) {
+    if (!enabled) {
+      return State::kDisabled;
+    }
+    if (compile_failed) {
+      return State::kFailed;
+    }
+    if (!metadata_loaded || !engine_available || initial_downloads_pending ||
+        !compile_current) {
+      return State::kLoading;
+    }
+    return State::kReady;
+  }
+
+  uint64_t Begin(State state, const std::string& payload, Callback callback) {
+    Cancel();
+    if (state != State::kLoading) {
+      std::move(callback).Run(true, state == State::kReady ? payload : std::string());
+      return 0;
+    }
+    callback_ = std::move(callback);
+    return generation_;
+  }
+
+  bool Complete(uint64_t generation, const std::string& payload,
+                bool settled = true) {
+    if (!IsPending(generation)) {
+      return false;
+    }
+    std::move(callback_).Run(settled, payload);
+    return true;
+  }
+
+  void Cancel() {
+    if (callback_) {
+      std::move(callback_).Run(false, std::string());
+    }
+    ++generation_;
+  }
+
+  bool IsPending(uint64_t generation) const {
+    return generation == generation_ && !!callback_;
+  }
+
+ private:
+  uint64_t generation_ = 0;
+  Callback callback_;
+};
+
+}  // namespace aside_adblock
+#endif
diff --git a/chrome/browser/aside_adblock/aside_adblock_engine.cc b/chrome/browser/aside_adblock/aside_adblock_engine.cc
