+TEST_F(ToolbarActionsModelUnitTest, AsideLateComponentsKeepPinChoiceOnUpdate) {
+  Init();
+  for (const char* id : {"clcdgiameigmljcbkkcbjiljinmfkncl",
+                         "fjdhphbdlfjogobdofoaagnlnkoibdge"}) {
+    auto make_extension = [id](const char* version) {
+      return extensions::ExtensionBuilder("Aside component")
+          .SetID(id)
+          .SetVersion(version)
+          .SetAction(extensions::ActionInfo::Type::kBrowser)
+          .SetLocation(ManifestLocation::kComponent)
+          .Build();
+    };
+    ASSERT_TRUE(AddExtension(make_extension("1.0")));
+    EXPECT_TRUE(toolbar_model()->IsActionPinned(id));
+
+    // A component update uses the registrar's UPDATE path, not an uninstall.
+    registrar()->AddComponentExtension(make_extension("2.0").get());
+    EXPECT_TRUE(toolbar_model()->IsActionPinned(id));
+
+    toolbar_model()->SetActionVisibility(id, false);
+    EXPECT_FALSE(toolbar_model()->IsActionPinned(id));
+    registrar()->AddComponentExtension(make_extension("3.0").get());
+    EXPECT_FALSE(toolbar_model()->IsActionPinned(id));
+  }
+}
