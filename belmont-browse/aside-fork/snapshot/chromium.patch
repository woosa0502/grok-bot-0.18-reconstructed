+IN_PROC_BROWSER_TEST_F(AsideBookmarkCorrectnessBrowserTest,
+                       ProfileSwitchCannotRetargetAnOpenDialog) {
+  Profile* opening_profile = browser()->profile();
+  Profile* other_profile = &profiles::testing::CreateProfileSync(
+      g_browser_process->profile_manager(),
+      opening_profile->GetPath().DirName().AppendASCII("AsideBookmarkOther"));
+  BookmarkModel* other_model = ModelFor(other_profile);
+  other_profile->GetPrefs()->SetBoolean(bookmarks::prefs::kEditBookmarksEnabled,
+                                        true);
+  const BookmarkNode* first =
+      AddBookmark(model_, u"First profile", GURL("https://first.example/"));
+  const BookmarkNode* second = AddBookmark(other_model, u"Second profile",
+                                           GURL("https://second.example/"));
+  // Align monotonically allocated node IDs so the test attacks profile
+  // identity, not merely a missing-node early return.
+  for (int attempt = 0; attempt < 100 && first->id() != second->id();
+       ++attempt) {
+    if (first->id() < second->id()) {
+      first =
+          AddBookmark(model_, u"First profile", GURL("https://first.example/"));
+    } else {
+      second = AddBookmark(other_model, u"Second profile",
+                           GURL("https://second.example/"));
+    }
+  }
+  ASSERT_EQ(first->id(), second->id());
+  const int64_t shared_id = first->id();
+  auto edit = Dialog(first->id(), BookmarkDialogType::kEditBookmark);
+  auto remove = Dialog(first->id(), BookmarkDialogType::kDeleteBookmark);
+  ASSERT_TRUE(edit);
+  ASSERT_TRUE(remove);
+  ASSERT_TRUE(DialogTextFields::Set(*edit, u"Name", u"Wrong profile"));
+  ASSERT_TRUE(DialogTextFields::Set(*edit, u"URL", u"https://wrong.example/"));
+
+  chrome::SwitchProfileInPlaceForAside(browser(), other_profile->GetPath());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return browser()->profile() == other_profile; }));
+  Accept(std::move(edit));
+  Accept(std::move(remove));
+  ASSERT_EQ(first, bookmarks::GetBookmarkNodeByID(model_, shared_id));
+  ASSERT_EQ(second, bookmarks::GetBookmarkNodeByID(other_model, shared_id));
+  EXPECT_EQ(u"First profile", first->GetTitle());
+  EXPECT_EQ(u"Second profile", second->GetTitle());
+  EXPECT_EQ(GURL("https://second.example/"), second->url());
+
+  chrome::SwitchProfileInPlaceForAside(browser(), opening_profile->GetPath());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return browser()->profile() == opening_profile; }));
+}
+
+IN_PROC_BROWSER_TEST_F(AsideBookmarkCorrectnessBrowserTest,
+                       ClosedBrowserCannotCommitAnOpenDialog) {
+  const BookmarkNode* node =
+      AddBookmark(model_, u"Original", GURL("https://original.example/"));
+  const int64_t node_id = node->id();
+  Browser* extra_browser = CreateBrowser(browser()->profile());
+  auto edit = aside::CreateBookmarkDialogModel(
+      extra_browser, node->id(), BookmarkDialogType::kEditBookmark);
+  auto remove = aside::CreateBookmarkDialogModel(
+      extra_browser, node->id(), BookmarkDialogType::kDeleteBookmark);
+  ASSERT_TRUE(edit);
+  ASSERT_TRUE(remove);
+  ASSERT_TRUE(DialogTextFields::Set(*edit, u"Name", u"After close"));
+  CloseBrowserSynchronously(extra_browser);
+  Accept(std::move(edit));
+  Accept(std::move(remove));
+  ASSERT_EQ(node, bookmarks::GetBookmarkNodeByID(model_, node_id));
+  EXPECT_EQ(u"Original", node->GetTitle());
+  EXPECT_EQ(GURL("https://original.example/"), node->url());
+}
