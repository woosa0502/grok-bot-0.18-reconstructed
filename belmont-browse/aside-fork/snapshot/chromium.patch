+// static
+std::string SessionServiceBase::SerializeAsideTabSelection(
+    const TabStripModel& model) {
+  const ui::ListSelectionModel& selection =
+      model.selection_model().GetListSelectionModel();
+  base::DictValue data;
+  data.Set("version", 1);
+  data.Set("count", model.count());
+  if (selection.active()) {
+    data.Set("active", static_cast<int>(*selection.active()));
+  }
+  if (selection.anchor()) {
+    data.Set("anchor", static_cast<int>(*selection.anchor()));
+  }
+  base::ListValue selected;
+  for (size_t index : selection.selected_indices()) {
+    selected.Append(static_cast<int>(index));
+  }
+  data.Set("selected", std::move(selected));
+  if (auto focused = model.GetFocusedGroup();
+      focused && model.group_model() &&
+      model.group_model()->ContainsTabGroup(*focused)) {
+    data.Set("focused_group_index",
+             static_cast<int>(model.group_model()
+                                  ->GetTabGroup(*focused)
+                                  ->ListTabs()
+                                  .start()));
+  }
+  return base::WriteJson(data).value_or(std::string());
+}
+
+// static
+bool SessionServiceBase::RestoreAsideTabSelection(
+    TabStripModel& model,
+    std::string_view serialized) {
+  auto data = base::JSONReader::ReadDict(serialized, base::JSON_PARSE_RFC);
+  if (!data || data->FindInt("version") != 1 ||
+      data->FindInt("count") != model.count() || model.empty()) {
+    return false;
+  }
+  const auto active = data->FindInt("active");
+  const auto anchor = data->FindInt("anchor");
+  const auto* selected = data->FindList("selected");
+  if (!active || !anchor || !selected || !model.ContainsIndex(*active) ||
+      !model.ContainsIndex(*anchor)) {
+    return false;
+  }
+  ui::ListSelectionModel selection;
+  for (const auto& entry : *selected) {
+    auto index = entry.GetIfInt();
+    if (!index || !model.ContainsIndex(*index)) {
+      return false;
+    }
+    selection.AddIndexToSelection(*index);
+  }
+  if (!selection.IsSelected(*active) || !selection.IsSelected(*anchor)) {
+    return false;
+  }
+  selection.set_active(*active);
+  selection.set_anchor(*anchor);
+  std::optional<tab_groups::TabGroupId> focused_group;
+  if (data->Find("focused_group_index")) {
+    auto focus_index = data->FindInt("focused_group_index");
+    if (!focus_index || !model.ContainsIndex(*focus_index)) {
+      return false;
+    }
+    focused_group = model.GetTabGroupForTab(*focus_index);
+    if (!focused_group) {
+      return false;
+    }
+    for (size_t index : selection.selected_indices()) {
+      if (model.GetTabGroupForTab(index) != focused_group) {
+        return false;
+      }
+    }
+    if (model.GetTabGroupForTab(*anchor) != focused_group) {
+      return false;
+    }
+  }
+  for (size_t index : selection.selected_indices()) {
+    if (auto split = model.GetSplitForTab(index)) {
+      for (int peer = 0; peer < model.count(); ++peer) {
+        if (model.GetSplitForTab(peer) == split &&
+            !selection.IsSelected(peer)) {
+          return false;
+        }
+      }
+    }
+  }
+  // Changing an already-focused group can auto-close it. Session metadata
+  // must never delete existing tabs while trying to restore a selection.
+  if (model.GetFocusedGroup() && model.GetFocusedGroup() != focused_group) {
+    return false;
+  }
+  if (focused_group &&
+      base::FeatureList::IsEnabled(features::kTabGroupsFocusing)) {
+    model.SetFocusedGroup(focused_group);
+  }
+  model.SetSelectionFromModel(std::move(selection));
+  return true;
+}
