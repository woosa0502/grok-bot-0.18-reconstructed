+void AsideProfileMenuView::BuildProfileRows() {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  Profile* current_profile = browser_->profile()->GetOriginalProfile();
+  const base::FilePath current = current_profile->GetPath();
+  const auto add_profile = [&](const base::FilePath& path,
+                               const std::u16string& name) {
+    auto row = std::make_unique<views::BoxLayoutView>();
+    row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    row->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    row->SetPreferredSize(gfx::Size(kMenuWidth - 16, 32));
+
+    auto select = std::make_unique<AsideMenuRowButton>(
+        base::BindRepeating(&AsideProfileMenuView::OnSwitchProfile,
+                            base::Unretained(this), path));
+    views::InkDrop::Get(select.get())
+        ->SetMode(views::InkDropHost::InkDropMode::ON);
+    views::InkDrop::Get(select.get())
+        ->SetBaseColor(ui::kColorButtonHoverBackgroundText);
+    views::InkDrop::Get(select.get())->SetHighlightOpacity(1);
+    select->SetHasInkDropActionOnClick(true);
+    select->SetShowInkDropWhenHotTracked(true);
+    auto* layout = select->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::TLBR(6, 10, 6, 2), 10));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    select->AddChildView(
+        std::make_unique<ProfileMonogramAvatarView>(path, kIconSize));
+    auto label = std::make_unique<views::Label>(name);
+    label->SetFontList(aside::UiFontList(
+        13, path == current ? gfx::Font::Weight::MEDIUM
+                           : gfx::Font::Weight::NORMAL));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+    label->SetCanProcessEventsWithinSubtree(false);
+    layout->SetFlexForView(select->AddChildView(std::move(label)), 1);
+    select->GetViewAccessibility().SetName(name);
+    if (path == current) {
+      auto check = std::make_unique<views::ImageView>(
+          ui::ImageModel::FromVectorIcon(kAsideCheckMarkIcon, ui::kColorIcon,
+                                        kIconSize));
+      check->SetCanProcessEventsWithinSubtree(false);
+      select->AddChildView(std::move(check));
+      select->GetViewAccessibility().SetDescription(u"Current profile");
+    }
+    views::InstallRoundRectHighlightPathGenerator(select.get(), gfx::Insets(),
+                                                  6);
+    row->SetFlexForView(row->AddChildView(std::move(select)), 1);
+
+    auto actions = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&AsideProfileMenuView::OpenProfileActions,
+                            base::Unretained(this), path),
+        kAsideDotGrid1x3HorizontalStrokeIcon, kIconSize);
+    actions->SetPreferredSize(gfx::Size(28, 28));
+    const std::u16string action_name =
+        base::StrCat({kProfileActions, u": ", name});
+    actions->SetTooltipText(action_name);
+    actions->GetViewAccessibility().SetName(action_name);
+    row->AddChildView(std::move(actions));
+    body_->AddChildView(std::move(row));
+  };
+  bool current_was_listed = false;
+  if (manager) {
+    for (ProfileAttributesEntry* entry :
+         manager->GetProfileAttributesStorage()
+             .GetAllProfilesAttributesSortedForDisplay()) {
+      const base::FilePath path = entry->GetPath();
+      add_profile(path, entry->GetName());
+      current_was_listed |= path == current;
+    }
+  }
+  if (!current_was_listed) {
+    add_profile(current, DisplayName(current_profile));
+  }
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::OnAddProfile,
+                          base::Unretained(this)),
+      kNewProfile, &kAsideAccountAddChromeRefreshIcon));
+}
