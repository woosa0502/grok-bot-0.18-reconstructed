+void SessionService::ParkWindowForAside(Browser* browser) {
+  if (browser->profile() != profile() ||
+      browser->tab_strip_model()->empty() ||
+      !ShouldRestoreWindowOfType(WindowTypeForBrowserType(browser->type()))) {
+    return;
+  }
+  const SessionID id = browser->session_id();
+  aside_parked_windows_[id] = {
+      browser->AsWeakPtr(), CaptureCommandsForAsideWindow(browser)};
+  pending_window_close_ids_.erase(id);
+  window_closing_ids_.erase(id);
+  windows_tracking()->erase(id);
+  last_selected_tab_in_window()->erase(id);
+  if (!is_saving_enabled()) {
+    return;
+  }
+  ScheduleResetCommands();
+  // Save before detachment. The backend's sequenced tasks also preserve this
+  // write when the profile is gracefully destroyed while parked.
+  command_storage_manager()->Save();
+}
+
+void SessionService::ResumeWindowForAside(Browser* browser) {
+  aside_parked_windows_.erase(browser->session_id());
+  SetWindowType(browser->session_id(), browser->type());
+}
