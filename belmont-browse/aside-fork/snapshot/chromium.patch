+void AsideOmniboxSearchboxPage::RegisterWithSearchboxMirror() {
+  if (receiver_.is_bound()) {
+    receiver_.reset();
+  }
+  aside::SearchboxPageMirror::Get().AddPage(
+      receiver_.BindNewPipeAndPassRemote());
+}
+
+void AsideOmniboxSearchboxPage::AutocompleteResultChanged(
+    searchbox::mojom::AutocompleteResultPtr result) {
+  if (!result) {
+    return;
+  }
+  // Same field names the session's own onAutocompleteResultChanged uses, so
+  // the extension does not have to tell the two sources apart by shape.
+  base::ListValue matches;
+  for (const searchbox::mojom::AutocompleteMatchPtr& match : result->matches) {
+    if (!match) {
+      continue;
+    }
+    base::DictValue m;
+    m.Set("contents", base::UTF16ToUTF8(match->contents));
+    m.Set("description", base::UTF16ToUTF8(match->description));
+    m.Set("destinationUrl", match->destination_url.spec());
+    m.Set("fillIntoEdit", base::UTF16ToUTF8(match->fill_into_edit));
+    m.Set("isSearchType", match->is_search_type);
+    m.Set("supportsDeletion", match->supports_deletion);
+    m.Set("type", match->type);
+    matches.Append(std::move(m));
+  }
+  base::DictValue payload;
+  payload.Set("matches", std::move(matches));
+  payload.Set("input", base::UTF16ToUTF8(result->input));
+  payload.Set("resultSequenceId", static_cast<double>(result->sequence_id));
+  payload.Set("queryId", result->query_id);
+  // Marks the copy that came in over the mirrored Page pipe rather than from
+  // this session's own AutocompleteController.
+  payload.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAutocompleteResultChanged",
+                     std::move(payload));
+}
+
+namespace {
+
+base::DictValue SelectionToDict(
+    const searchbox::mojom::OmniboxPopupSelectionPtr& selection) {
+  base::DictValue dict;
+  if (selection) {
+    dict.Set("line", selection->line);
+    dict.Set("state", static_cast<int>(selection->state));
+    dict.Set("actionIndex", selection->action_index);
+  }
+  return dict;
+}
+
+base::DictValue TabToDict(const searchbox::mojom::TabInfoPtr& tab) {
+  base::DictValue dict;
+  if (tab) {
+    dict.Set("tabId", tab->tab_id);
+    dict.Set("title", tab->title);
+    dict.Set("url", tab->url.spec());
+    dict.Set("showInCurrentTabChip", tab->show_in_current_tab_chip);
+    dict.Set("showInPreviousTabChip", tab->show_in_previous_tab_chip);
+  }
+  return dict;
+}
+
+}  // namespace
+
+// Each of the remaining Page methods is the browser-side arrival of one of the
+// events asideOmnibox already declares in its schema, so each one is relayed
+// under the session id rather than dropped.  "source" marks the copy that came
+// in over the mirrored pipe.
+void AsideOmniboxSearchboxPage::UpdateSelection(
+    searchbox::mojom::OmniboxPopupSelectionPtr old_selection,
+    searchbox::mojom::OmniboxPopupSelectionPtr selection) {
+  base::DictValue details;
+  details.Set("oldSelection", SelectionToDict(old_selection));
+  details.Set("selection", SelectionToDict(selection));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onSelectionUpdated", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::StepSelection(
+    searchbox::mojom::SelectionDirection direction,
+    searchbox::mojom::SelectionStep step) {
+  base::DictValue details;
+  details.Set("direction", static_cast<int>(direction));
+  details.Set("step", static_cast<int>(step));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onStepSelection", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::OpenCurrentSelection(
+    ::WindowOpenDisposition disposition) {
+  base::DictValue details;
+  details.Set("disposition", static_cast<int>(disposition));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onOpenCurrentSelection", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::SetAimButtonVisible(bool visible) {
+  base::DictValue details;
+  details.Set("visible", visible);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAimButtonVisibilityChanged",
+                     std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::SetKeywordSelected(bool is_keyword_selected) {
+  base::DictValue details;
+  details.Set("isKeywordSelected", is_keyword_selected);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onKeywordSelectedChanged",
+                     std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::SetInputText(const std::string& input) {
+  base::DictValue details;
+  details.Set("input", input);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onInputTextChanged", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::SetThumbnail(const std::string& thumbnail_url,
+                                             bool is_deletable) {
+  base::DictValue details;
+  details.Set("thumbnailUrl", thumbnail_url);
+  details.Set("isDeletable", is_deletable);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onThumbnailChanged", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::OnContextualInputStatusChanged(
+    const ::base::UnguessableToken& token,
+    ::contextual_search::ContextUploadStatus status,
+    std::optional<::contextual_search::ContextUploadErrorType> error_type) {
+  base::DictValue details;
+  details.Set("contextToken", token.ToString());
+  details.Set("status", static_cast<int>(status));
+  if (error_type) {
+    details.Set("errorType", static_cast<int>(*error_type));
+  }
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onContextualInputStatusChanged",
+                     std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::OnTabStripChanged() {
+  base::DictValue details;
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onTabStripChanged", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::OnInputStateChanged(
+    const ::omnibox::InputState& input_state) {
+  // The scalar part of omnibox::InputState.  The proto-valued lists are left
+  // out rather than half-translated; an extension that needs them can ask for
+  // the state through asideOmnibox.getInputState.
+  base::DictValue details;
+  details.Set("activeTool", static_cast<int>(input_state.active_tool));
+  details.Set("activeModel", static_cast<int>(input_state.active_model));
+  details.Set("maxTotalInputs", input_state.max_total_inputs);
+  details.Set("hintText", input_state.hint_text);
+  details.Set("allowedToolCount",
+              static_cast<int>(input_state.allowed_tools.size()));
+  details.Set("allowedModelCount",
+              static_cast<int>(input_state.allowed_models.size()));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onInputStateChanged", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::AddFileContext(
+    const ::base::UnguessableToken& token,
+    searchbox::mojom::SelectedFileInfoPtr file_info) {
+  if (!file_info) {
+    return;
+  }
+  // The searchbox WebUI attached a file; relay its SelectedFileInfo under the
+  // same key names asideOmnibox.addFileContext accepts, so the extension sees
+  // one vocabulary for files it attached and files the searchbox attached.
+  // Only metadata crosses this pipe - the Page method carries no bytes.
+  base::DictValue payload;
+  payload.Set("contextToken", token.ToString());
+  payload.Set("fileName", file_info->file_name);
+  payload.Set("mimeType", file_info->mime_type);
+  if (file_info->image_data_url) {
+    payload.Set("imageDataUrl", *file_info->image_data_url);
+  }
+  payload.Set("isDeletable", file_info->is_deletable);
+  payload.Set("selectionTimeMs", static_cast<double>(
+      file_info->selection_time.InMillisecondsSinceUnixEpoch()));
+  payload.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onFileContextAdded", std::move(payload));
+}
+void AsideOmniboxSearchboxPage::UpdateAutoSuggestedTabContext(
+    searchbox::mojom::TabInfoPtr tab,
+    const std::optional<std::string>& invocation_source) {
+  base::DictValue details;
+  details.Set("tab", TabToDict(tab));
+  if (invocation_source) {
+    details.Set("invocationSource", *invocation_source);
+  }
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAutoSuggestedTabContextChanged",
+                     std::move(details));
+}
