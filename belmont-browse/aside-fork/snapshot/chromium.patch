+void ActorOverlayWebView::RebindToProfile(Profile* profile) {
+  CHECK(profile);
+  CHECK(!rebinding_profile_);
+  rebinding_profile_ = true;
+  auto pending = std::move(pending_webui_init_callbacks_);
+  pending_webui_init_callbacks_.clear();
+  weak_factory_.InvalidateWeakPtrs();
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  CloseUI();
+  if (!weak_this) {
+    return;
+  }
+  scoped_ignore_input_events_.reset();
+  SetWebContents(nullptr);
+  if (!weak_this) {
+    return;
+  }
+  SetBrowserContext(profile);
+  // Match PrimaryPageChanged's failed-initialization contract: unblock each
+  // waiter now, rather than retaining source callbacks for the next WebUI.
+  // Reentrant ShowUI calls cannot create contents until this drain completes.
+  for (auto& callback : pending) {
+    std::move(callback).Run();
+    if (!weak_this) {
+      return;
+    }
+  }
+  rebinding_profile_ = false;
+}
