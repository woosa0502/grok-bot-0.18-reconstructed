+constexpr int kAvatarSize = 28;
+// Original strings (resources.pak IDS 1184/1185/1187/2382/2379).
+constexpr char16_t kOtherProfiles[] = u"Other Aside Profiles";
+constexpr char16_t kManageProfiles[] = u"Manage Aside Profiles";
+constexpr char16_t kAddProfile[] = u"Add Aside Profile";
+constexpr char16_t kCustomizeProfile[] = u"Customize Profile";
