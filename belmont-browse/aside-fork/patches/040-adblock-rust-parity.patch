+// Original: "/newtab.html#/u/" + "/settings/general" (account index 0).
+constexpr char kSettingsPath[] = "/newtab.html#/u/0/settings/general";
+
+ProfileAttributesEntry* EntryFor(Profile* profile) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return nullptr;
+  }
+  return manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+      profile->GetPath());
+}
+
+std::u16string DisplayName(Profile* profile) {
+  PrefService* prefs = profile->GetPrefs();
+  std::string name = prefs->GetString("aside.account_display_name");
+  if (!name.empty()) {
+    return base::UTF8ToUTF16(name);
+  }
+  if (ProfileAttributesEntry* entry = EntryFor(profile)) {
+    return entry->GetName();
+  }
+  return base::UTF8ToUTF16(prefs->GetString("aside.account_email"));
+}
+
+// AsideMenuItemButton: an icon + label row.
