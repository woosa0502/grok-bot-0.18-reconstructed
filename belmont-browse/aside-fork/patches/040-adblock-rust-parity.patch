+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Interface of the original chrome://aside-adblock page (same module,
+// interface and method names). The explicit ordinals are the original's
+// scrambled message IDs: sha256(//chrome/VERSION + "AdblockInternalsPageHandler"
+// + i) & 0x7fffffff (mojom_bindings_generator.py ScrambleMethodOrdinals with
+// enable_mojom_message_id_scrambling, verified to reproduce all 11), so the
+// original's generated mojom-webui.js is used byte-for-byte.
+module adblock_internals.mojom;
+
+interface AdblockInternalsPageHandler {
+  GetState@1838076500() => (string state_json);
+  SetEnabled@1074947034(bool enabled) => (string state_json, string error);
+  AddSubscription@1482877258(string name, string url) => (string state_json, string error);
+  SetSubscriptionEnabled@2003822836(string subscription_id, bool enabled)
+      => (string state_json, string error);
+  RemoveSubscription@406044674(string subscription_id)
+      => (string state_json, string error);
+  UpdateSubscription@1600987558(string subscription_id)
+      => (string state_json, string error);
+  UpdateAllSubscriptions@638799878() => (string state_json, string error);
+  SaveCustomRules@2144159451(string rules) => (string state_json, string error);
+  ReloadManualFilters@984317154() => (string state_json, string error);
+  ClearEngineCache@90157581() => (string state_json, string error);
+  TestRule@227873382(string url, string initiator, string request_type, string method,
+           bool third_party) => (string result_json, string error);
+};
diff --git a/chrome/browser/ui/webui/aside_adblock/aside_adblock_internals_ui.cc b/chrome/browser/ui/webui/aside_adblock/aside_adblock_internals_ui.cc
