diff --git a/chrome/browser/extensions/api/aside_mini_popup/mini_popup_shortcut.cc b/chrome/browser/extensions/api/aside_mini_popup/mini_popup_shortcut.cc
new file mode 100644
index 0000000000..53d056ce3d
--- /dev/null
+++ b/chrome/browser/extensions/api/aside_mini_popup/mini_popup_shortcut.cc
@@ -0,0 +1,143 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_mini_popup/mini_popup_shortcut.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/extensions/api/aside_mini_popup/mini_popup_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "components/prefs/pref_service.h"
+#include "extensions/common/command.h"
+
+namespace extensions {
+
+namespace {
+
+constexpr char kEnabledPref[] = "aside.mini_popup.enabled";
+constexpr char kShortcutPref[] = "aside.mini_popup.shortcut";
+constexpr char kInvalidShortcut[] = "Invalid mini popup shortcut";
+constexpr char kUnavailable[] = "Aside mini popup global shortcut unavailable";
+constexpr char kInUse[] = "This shortcut is unavailable";
+
+PrefService* LocalState() {
+  return g_browser_process ? g_browser_process->local_state() : nullptr;
+}
+
+}  // namespace
+
+// static
+MiniPopupShortcut* MiniPopupShortcut::GetInstance() {
+  static base::NoDestructor<MiniPopupShortcut> instance;
+  return instance.get();
+}
+
+MiniPopupShortcut::MiniPopupShortcut() {
+  if (PrefService* local_state = LocalState()) {
+    registrar_.Init(local_state);
+    auto apply = base::BindRepeating(
+        [](MiniPopupShortcut* self) { self->Apply(); }, base::Unretained(this));
+    registrar_.Add(kEnabledPref, apply);
+    registrar_.Add(kShortcutPref, apply);
+  }
+}
+
+MiniPopupShortcut::~MiniPopupShortcut() = default;
+
+std::string MiniPopupShortcut::Register(const ui::Accelerator& accelerator) {
+  Unregister();
+  ui::GlobalAcceleratorListener* listener =
+      ui::GlobalAcceleratorListener::GetInstance();
+  if (!listener) {
+    return kUnavailable;
+  }
+  if (!listener->RegisterAccelerator(accelerator, this)) {
+    return kInUse;
+  }
+  registered_ = accelerator;
+  VLOG(1) << "AsideMiniPopup: shortcut registered "
+          << accelerator.GetShortcutText();
+  return std::string();
+}
+
+void MiniPopupShortcut::Unregister() {
+  if (registered_.IsEmpty()) {
+    return;
+  }
+  if (ui::GlobalAcceleratorListener* listener =
+          ui::GlobalAcceleratorListener::GetInstance()) {
+    listener->UnregisterAccelerator(registered_, this);
+  }
+  registered_ = ui::Accelerator();
+}
+
+std::string MiniPopupShortcut::Apply() {
+  PrefService* local_state = LocalState();
+  if (!local_state) {
+    Unregister();
+    return kUnavailable;
+  }
+  if (!local_state->GetBoolean(kEnabledPref)) {
+    Unregister();
+    return std::string();
+  }
+  const ui::Accelerator accelerator =
+      Command::StringToAccelerator(local_state->GetString(kShortcutPref), "");
+  if (accelerator.IsEmpty()) {
+    Unregister();
+    return kInvalidShortcut;
+  }
+  if (accelerator == registered_) {
+    return std::string();
+  }
+  return Register(accelerator);
+}
+
+std::string MiniPopupShortcut::TryShortcut(const std::string& shortcut) {
+  const ui::Accelerator accelerator = Command::StringToAccelerator(shortcut, "");
+  if (accelerator.IsEmpty()) {
+    return kInvalidShortcut;
+  }
+  PrefService* local_state = LocalState();
+  const bool enabled = local_state && local_state->GetBoolean(kEnabledPref);
+  const ui::Accelerator previous = registered_;
+  std::string error = Register(accelerator);
+  if (!error.empty()) {
+    if (!previous.IsEmpty()) {
+      Register(previous);
+    }
+    return error;
+  }
+  if (!enabled) {
+    Unregister();  // only probing availability; Apply() registers on enable
+  }
+  return std::string();
+}
+
+void MiniPopupShortcut::OnKeyPressed(const ui::Accelerator& accelerator) {
+  Profile* profile = nullptr;
+  if (BrowserWindowInterface* browser =
+          GetLastActiveBrowserWindowInterfaceWithAnyProfile()) {
+    profile = browser->GetProfile();
+  }
+  if (!profile && g_browser_process && g_browser_process->profile_manager()) {
+    profile = g_browser_process->profile_manager()->GetLastUsedProfileIfLoaded();
+  }
+  if (!profile) {
+    return;
+  }
+  if (profile->IsOffTheRecord()) {
+    profile = profile->GetOriginalProfile();
+  }
+  if (MiniPopupService* service = MiniPopupService::Get(profile)) {
+    service->ToggleFromShortcut();
+  }
+}
+
+}  // namespace extensions
