+// found in the LICENSE file.
+//
+// Aside's profile menu (replica of the original
+// chrome/browser/ui/views/profiles/aside_profile_menu_view.cc: AsideMenuPanel
+// with AsideMenuItemButton rows, an inline profile-name field
+// (kEditProfileNameFieldId), "Customize Profile" → the extension's settings
+// page, "Other Aside Profiles", "Add Aside Profile", "Manage Aside Profiles",
+// "Open Guest Profile"). Anchored to the vertical strip's profile footer.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/layout/box_layout_view.h"
+
+class Browser;
+
+namespace views {
+class Label;
+class Textfield;
+class Widget;
+}  // namespace views
+
+class AsideProfileMenuView : public views::BoxLayoutView,
+                             public views::TextfieldController {
+  METADATA_HEADER(AsideProfileMenuView, views::BoxLayoutView)
+
+ public:
+  // Shows the menu as a bubble above |anchor|. Self-owned until closed.
+  static void Show(views::View* anchor, Browser* browser);
+
+  explicit AsideProfileMenuView(Browser* browser);
+  AsideProfileMenuView(const AsideProfileMenuView&) = delete;
+  AsideProfileMenuView& operator=(const AsideProfileMenuView&) = delete;
+  ~AsideProfileMenuView() override;
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+ private:
+  void BuildHeader();
+  void BuildItems();
+  void StartEditingName();
+  void CommitName();
+  void CancelEditingName();
+  void CloseBubble();
+
+  void OnCustomizeProfile();
+  void OnSwitchProfile(const base::FilePath& path);
+  void OnAddProfile();
+  void OnManageProfiles();
+  void OnGuestProfile();
+
+  raw_ptr<Browser> browser_;
+  raw_ptr<views::View> header_ = nullptr;
+  raw_ptr<views::Label> name_label_ = nullptr;
+  raw_ptr<views::Textfield> name_field_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
