+void AsideAdBlockService::LoadFromDisk() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadStateFromDisk, data_dir_, subscriptions_dir_,
+                     custom_rules_path_, manual_dir_),
+      base::BindOnce(&AsideAdBlockService::OnLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AsideAdBlockService::OnLoaded(std::unique_ptr<LoadedState> state) {
+  subscriptions_ = std::move(state->subscriptions);
+  custom_rules_ = std::move(state->custom_rules);
+  manual_files_ = std::move(state->manual_files);
+  manual_filter_error_ = std::move(state->manual_error);
+  manual_resources_json_ = std::move(state->resources_json);
+  loaded_ = true;
+  if (!state->had_metadata) {
+    for (const DefaultSubscription& def : kDefaultSubscriptions) {
+      Subscription s;
+      s.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+      s.name = def.name;
+      s.url = def.url;
+      s.status = "idle";
+      subscriptions_.push_back(std::move(s));
+    }
+    PersistMetadata();
+  }
+  RequestCompile();
+  for (const Subscription& s : subscriptions_) {
+    if (s.enabled && (s.text.empty() || s.next_update <= base::Time::Now())) {
+      StartDownload(s.id);
+    }
+  }
+}
+
+void AsideAdBlockService::PersistMetadata() {
+  base::DictValue root;
+  base::ListValue list;
+  for (const Subscription& s : subscriptions_) {
+    list.Append(SubscriptionToDict(s));
+  }
+  root.Set("subscriptions", std::move(list));
+  root.Set("version", 1);
+  std::string json;
+  base::JSONWriter::WriteWithOptions(
+      root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&WriteMetadataOnWorker,
+                     data_dir_.AppendASCII(kMetadataFile), std::move(json)));
+}
+
+// ---- compilation -----------------------------------------------------------
+
+std::vector<FilterSource> AsideAdBlockService::CollectSources() const {
+  std::vector<FilterSource> sources;
+  for (const Subscription& s : subscriptions_) {
+    if (s.enabled && !s.text.empty()) {
+      sources.push_back({s.id, s.name, s.text});
+    }
+  }
+  if (!custom_rules_.empty()) {
+    sources.push_back({"custom", "Custom rules", custom_rules_});
+  }
+  for (const ManualFile& file : manual_files_) {
+    sources.push_back({"manual:" + file.name, file.name, file.text});
+  }
+  return sources;
+}
+
+void AsideAdBlockService::RequestCompile() {
+  ++requested_generation_;
+  if (compiling_) {
+    compile_pending_ = true;
+    return;
+  }
+  StartCompile();
+}
+
+AsideAdBlockService::CompileOutcome::CompileOutcome() = default;
+AsideAdBlockService::CompileOutcome::CompileOutcome(CompileOutcome&&) = default;
+AsideAdBlockService::CompileOutcome::~CompileOutcome() = default;
+
+// Worker-thread: load <cache>/engine{0,1}.dat when one was built from exactly
+// these sources, otherwise compile and store the result in the slot for this
+// generation (the original alternates two cache files).
+// static
+AsideAdBlockService::CompileOutcome AsideAdBlockService::BuildOrLoadEngine(
+    std::vector<FilterSource> sources,
+    EngineOptions options,
+    base::FilePath cache_dir,
+    uint64_t generation) {
+  CompileOutcome outcome;
+  const std::string digest = Engine::SourceDigest(sources, options.resources_json);
+  const char* const kSlots[] = {"engine0.dat", "engine1.dat"};
+  for (const char* slot : kSlots) {
+    std::string bytes;
+    if (!base::ReadFileToString(cache_dir.AppendASCII(slot), &bytes) ||
+        Engine::CachedSourceDigest(bytes) != digest) {
+      continue;
+    }
+    outcome.engine = Engine::Deserialize(bytes, options);
+    if (outcome.engine) {
+      outcome.cache_hit = true;
+      return outcome;
+    }
+  }
+  outcome.engine = Engine::BuildWithOptions(sources, options);
+  if (!outcome.engine) {
+    outcome.error = "Compile failed: engine build returned nothing";
+    return outcome;
+  }
+  base::CreateDirectory(cache_dir);
+  const base::FilePath path = cache_dir.AppendASCII(kSlots[generation % 2]);
+  if (!base::ImportantFileWriter::WriteFileAtomically(
+          path, outcome.engine->Serialize(digest))) {
+    VLOG(1) << "AsideAdBlock: could not write engine cache " << path.value();
+  }
+  return outcome;
+}
+
+void AsideAdBlockService::StartCompile() {
+  compiling_ = true;
+  compile_pending_ = false;
+  const uint64_t generation = requested_generation_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&AsideAdBlockService::BuildOrLoadEngine, CollectSources(),
+                     EngineOptions{kMaxInvalidLinesPerSource,
+                                   manual_resources_json_},
+                     cache_dir_, generation),
+      base::BindOnce(&AsideAdBlockService::OnCompiled,
+                     weak_factory_.GetWeakPtr(), generation,
+                     base::TimeTicks::Now()));
+}
+
+void AsideAdBlockService::OnCompiled(uint64_t generation,
+                                     base::TimeTicks started,
+                                     CompileOutcome outcome) {
+  compiling_ = false;
+  last_compile_duration_ = base::TimeTicks::Now() - started;
+  scoped_refptr<Engine> engine = outcome.engine;
+  if (!engine) {
+    last_compile_error_ =
+        outcome.error.empty()
+            ? "The compiled candidate engine could not be installed."
+            : outcome.error;
+  } else {
+    last_compile_error_.clear();
+    engine_ = engine;
+    active_generation_ = generation;
+    last_engine_install_time_ = base::Time::Now();
+    last_cache_hit_ = outcome.cache_hit;
+    custom_network_rule_count_ = 0;
+    custom_cosmetic_rule_count_ = 0;
+    custom_parse_error_count_ = 0;
+    custom_invalid_lines_.clear();
+    for (const SourceStats& stats : engine->sources()) {
+      if (stats.id == "custom") {
+        custom_network_rule_count_ = stats.network_rule_count;
+        custom_cosmetic_rule_count_ = stats.cosmetic_rule_count;
+        custom_parse_error_count_ = stats.parse_error_count;
+        custom_invalid_lines_ = stats.invalid_lines;
+        continue;
+      }
+      if (Subscription* s = FindSubscription(stats.id)) {
+        s->network_rule_count = stats.network_rule_count;
+        s->cosmetic_rule_count = stats.cosmetic_rule_count;
+        s->parse_error_count = stats.parse_error_count;
+        s->invalid_lines = stats.invalid_lines;
+        s->last_engine_activation = last_engine_install_time_;
+        if (s->status == "idle" || s->status.empty()) {
+          s->status = "ready";
+        }
+      }
+    }
+    PersistMetadata();
+  }
+  if (compile_pending_) {
+    StartCompile();
+  }
+}
