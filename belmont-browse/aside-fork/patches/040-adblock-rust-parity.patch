+
+# Replica of the original components/aside_adblock (browser side).
+source_set("aside_adblock") {
+  sources = [
+    "aside_adblock_cosmetic_filter_host.cc",
+    "aside_adblock_cosmetic_filter_host.h",
+    "aside_adblock_engine.cc",
+    "aside_adblock_engine.h",
+    "aside_adblock_navigation_throttle.cc",
+    "aside_adblock_navigation_throttle.h",
+    "aside_adblock_procedural.cc",
+    "aside_adblock_procedural.h",
+    "aside_adblock_proxying_url_loader_factory.cc",
+    "aside_adblock_proxying_url_loader_factory.h",
+    "aside_adblock_resources.h",
+    "aside_adblock_rule_preprocessor.cc",
+    "aside_adblock_rule_preprocessor.h",
+    "aside_adblock_service.cc",
+    "aside_adblock_service.h",
+    "aside_adblock_service_factory.cc",
+    "aside_adblock_service_factory.h",
+    "aside_adblock_tab_helper.cc",
+    "aside_adblock_tab_helper.h",
+  ]
+  public_deps = [ "//chrome/common/aside_adblock:mojom" ]
+  deps = [
+    "//base",
+    "//chrome/browser/profiles:profile",
+    "//chrome/common",
+    "//components/keyed_service/content",
+    "//components/keyed_service/core",
+    "//components/prefs",
+    "//components/subresource_filter/core/common",
+    "//components/subresource_filter/tools/rule_parser",
+    "//components/url_pattern_index",
+    "//components/url_pattern_index/proto:url_pattern_index",
+    "//content/public/browser",
+    "//crypto",
+    "//mojo/public/cpp/bindings",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//third_party/re2",
+    "//url",
+  ]
+}
+
+# Option pre-pass + procedural parser alone (no chrome deps) for the offline
+# classifier.
+source_set("rule_preprocessor") {
+  sources = [
+    "aside_adblock_procedural.cc",
+    "aside_adblock_procedural.h",
+    "aside_adblock_rule_preprocessor.cc",
+    "aside_adblock_rule_preprocessor.h",
+  ]
+  deps = [ "//base" ]
+}
