+                                          const std::u16string& text,
+                                          const gfx::VectorIcon& icon) {
+  auto button = std::make_unique<AsideTextButton>(
+      std::move(callback), text, views::style::CONTEXT_BUTTON_MD);
+  button->SetStyle(ui::ButtonStyle::kText);
+  button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  button->SetCustomPadding(gfx::Insets::VH(6, 10));
+  button->SetImageLabelSpacing(8);
+  button->SetLabelFontList(aside::UiFontList(13, gfx::Font::Weight::NORMAL));
+  button->SetImageModel(views::Button::STATE_NORMAL,
+                        ui::ImageModel::FromVectorIcon(icon, ui::kColorIcon, 16));
+  button->SetPreferredSize(gfx::Size(kMenuWidth - 16, 32));
+  return button;
+}
+
+std::unique_ptr<views::Label> MakeSectionLabel(const std::u16string& text) {
+  auto label = std::make_unique<views::Label>(
+      text, views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY);
+  label->SetFontList(aside::UiFontList(11, gfx::Font::Weight::MEDIUM));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(8, 12, 2, 12)));
+  return label;
+}
+
+// Owns the delegate and the widget (CLIENT_OWNS_WIDGET) for one bubble and
+// deletes itself when the bubble closes.
+class AsideProfileMenuController {
+ public:
+  AsideProfileMenuController(views::View* anchor, Browser* browser) {
+    delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, views::BubbleBorder::BOTTOM_LEFT);
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetShowCloseButton(false);
+    delegate_->SetShowTitle(false);
+    delegate_->set_margins(gfx::Insets());
+    delegate_->SetContentsView(std::make_unique<AsideProfileMenuView>(browser));
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(),
+        base::BindOnce(&AsideProfileMenuController::OnClosed,
+                       base::Unretained(this)));
+    widget_->Show();
+  }
+
+ private:
+  void OnClosed(views::Widget::ClosedReason) { delete this; }
+
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+};
+
+}  // namespace
+
+// static
+void AsideProfileMenuView::Show(views::View* anchor, Browser* browser) {
+  if (!anchor || !browser) {
+    return;
+  }
+  VLOG(1) << "AsideProfileMenu: show";
+  new AsideProfileMenuController(anchor, browser);  // self-deleting
+}
+
+AsideProfileMenuView::AsideProfileMenuView(Browser* browser)
+    : browser_(browser) {
+  SetOrientation(views::BoxLayout::Orientation::kVertical);
+  SetInsideBorderInsets(gfx::Insets::VH(8, 8));
+  SetBetweenChildSpacing(2);
+  SetMinimumCrossAxisSize(kMenuWidth);  // width; height from content
+  BuildHeader();
+  AddChildView(std::make_unique<views::Separator>());
+  BuildItems();
+}
+
+AsideProfileMenuView::~AsideProfileMenuView() = default;
+
+void AsideProfileMenuView::BuildHeader() {
+  auto header = std::make_unique<views::BoxLayoutView>();
+  header->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  header->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  header->SetInsideBorderInsets(gfx::Insets::VH(6, 8));
+  header->SetBetweenChildSpacing(8);
+
+  const bool incognito = browser_->profile()->IsIncognitoProfile();
+  auto avatar = std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+      incognito ? kAsideIncognitoRefreshMenuIcon
+                : vector_icons::kAccountCircleChromeRefreshOldIcon,
+      ui::kColorIcon, kAvatarSize));
+  header->AddChildView(std::move(avatar));
+
+  auto text = std::make_unique<views::BoxLayoutView>();
+  text->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  auto name = std::make_unique<views::Label>(DisplayName(browser_->profile()));
+  name->SetFontList(aside::UiFontList(13, gfx::Font::Weight::MEDIUM));
+  name->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  name_label_ = text->AddChildView(std::move(name));
+  auto field = std::make_unique<views::Textfield>();
+  field->SetID(1);  // kEditProfileNameFieldId
+  field->set_controller(this);
+  field->SetFontList(aside::UiFontList(13, gfx::Font::Weight::MEDIUM));
+  field->SetVisible(false);
+  name_field_ = text->AddChildView(std::move(field));
+  const std::string email =
+      browser_->profile()->GetPrefs()->GetString("aside.account_email");
+  if (!email.empty()) {
+    auto email_label = std::make_unique<views::Label>(
+        base::UTF8ToUTF16(email), views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY);
+    email_label->SetFontList(aside::UiFontList(11, gfx::Font::Weight::NORMAL));
+    email_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    text->AddChildView(std::move(email_label));
+  }
+  views::View* text_view = header->AddChildView(std::move(text));
+  header->SetFlexForView(text_view, 1);
+
+  // AsideProfileMenuEditProfile: rename inline.
+  auto edit = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&AsideProfileMenuView::StartEditingName,
+                          base::Unretained(this)),
+      kAsidePencil2SolidIcon, 16);
+  edit->SetTooltipText(u"Edit profile name");
+  header->AddChildView(std::move(edit));
+  header_ = AddChildView(std::move(header));
+}
+
+void AsideProfileMenuView::BuildItems() {
+  AddChildView(MakeItem(
+      base::BindRepeating(&AsideProfileMenuView::OnCustomizeProfile,
+                          base::Unretained(this)),
+      kCustomizeProfile, kAsideSettingsChromeRefreshIcon));
+
+  ProfileManager* manager = g_browser_process->profile_manager();
+  std::vector<ProfileAttributesEntry*> entries;
+  if (manager) {
+    entries = manager->GetProfileAttributesStorage()
+                  .GetAllProfilesAttributesSortedForDisplay();
+  }
+  const base::FilePath current = browser_->profile()->GetPath();
+  bool has_others = false;
+  for (ProfileAttributesEntry* entry : entries) {
+    if (entry->GetPath() == current) {
+      continue;
+    }
+    if (!has_others) {
+      AddChildView(MakeSectionLabel(kOtherProfiles));
+      has_others = true;
+    }
+    AddChildView(MakeItem(
+        base::BindRepeating(&AsideProfileMenuView::OnSwitchProfile,
+                            base::Unretained(this), entry->GetPath()),
+        entry->GetName(), vector_icons::kAccountCircleChromeRefreshOldIcon));
+  }
+  AddChildView(std::make_unique<views::Separator>());
+  AddChildView(MakeItem(
+      base::BindRepeating(&AsideProfileMenuView::OnAddProfile,
+                          base::Unretained(this)),
+      kAddProfile, kAsideAccountAddChromeRefreshIcon));
+  AddChildView(MakeItem(
+      base::BindRepeating(&AsideProfileMenuView::OnManageProfiles,
+                          base::Unretained(this)),
+      kManageProfiles, kAsideSettingsSliderHorStrokeIcon));
+  AddChildView(MakeItem(
+      base::BindRepeating(&AsideProfileMenuView::OnGuestProfile,
+                          base::Unretained(this)),
+      kOpenGuest, kAsideIncognitoRefreshMenuIcon));
+}
+
+void AsideProfileMenuView::StartEditingName() {
+  name_field_->SetText(name_label_->GetText());
+  name_label_->SetVisible(false);
+  name_field_->SetVisible(true);
+  name_field_->RequestFocus();
+  name_field_->SelectAll(false);
+  InvalidateLayout();
+}
+
+void AsideProfileMenuView::CommitName() {
+  std::u16string name(name_field_->GetText());
+  if (!name.empty()) {
+    if (ProfileAttributesEntry* entry = EntryFor(browser_->profile())) {
+      entry->SetLocalProfileName(name, /*is_default_name=*/false);
+    }
+    browser_->profile()->GetPrefs()->SetString("aside.account_display_name",
+                                               base::UTF16ToUTF8(name));
+    name_label_->SetText(name);
+  }
+  CancelEditingName();
+}
+
+void AsideProfileMenuView::CancelEditingName() {
+  name_field_->SetVisible(false);
+  name_label_->SetVisible(true);
+  InvalidateLayout();
+}
+
+bool AsideProfileMenuView::HandleKeyEvent(views::Textfield* sender,
+                                          const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    CommitName();
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    CancelEditingName();
+    return true;
+  }
+  return false;
+}
+
+void AsideProfileMenuView::CloseBubble() {
+  if (views::Widget* widget = GetWidget()) {
+    widget->Close();
+  }
+}
+
+void AsideProfileMenuView::OnCustomizeProfile() {
+  const GURL url(std::string(extensions::kExtensionScheme) + "://" +
+                 aside::kAsideExtensionId + kSettingsPath);
+  chrome::AddSelectedTabWithURL(browser_, url, ui::PAGE_TRANSITION_LINK);
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnSwitchProfile(const base::FilePath& path) {
+  profiles::SwitchToProfile(path, /*always_create=*/false);
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnAddProfile() {
+  ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+      ProfilePicker::EntryPoint::kProfileMenuAddNewProfile));
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnManageProfiles() {
+  ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+      ProfilePicker::EntryPoint::kProfileMenuManageProfiles));
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnGuestProfile() {
+  profiles::SwitchToGuestProfile();
+  CloseBubble();
+}
+
+BEGIN_METADATA(AsideProfileMenuView)
+END_METADATA
