+// found in the LICENSE file.
+//
+// URLLoaderFactory proxy that applies Aside's ad-block network rules to
+// sub-resource requests (the original blocks these from its
+// AsideAdBlockService request hook; this proxy is the equivalent insertion
+// point in ChromeContentBrowserClient::WillCreateURLLoaderFactory). Blocked
+// requests either fail with ERR_BLOCKED_BY_CLIENT or, for $redirect rules,
+// are answered with the bundled resource. For navigation factories the proxy
+// only decorates document responses with $csp headers.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROXYING_URL_LOADER_FACTORY_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROXYING_URL_LOADER_FACTORY_H_
+
+#include <optional>
+
+#include "base/memory/weak_ptr.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+#include "services/network/public/mojom/url_loader_factory.mojom.h"
+#include "url/origin.h"
+
+namespace content {
+class BrowserContext;
+class RenderFrameHost;
+}  // namespace content
+
+namespace aside_adblock {
+
+class AsideAdBlockService;
+
+class AsideAdBlockProxyingURLLoaderFactory
+    : public network::mojom::URLLoaderFactory {
+ public:
+  // Inserts a proxy into |factory_builder| when ad blocking applies to
+  // |browser_context|. |frame| may be null (worker / service worker cases).
+  static void MaybeProxy(content::BrowserContext* browser_context,
+                         content::RenderFrameHost* frame,
+                         bool is_navigation,
+                         network::URLLoaderFactoryBuilder& factory_builder);
+
+  AsideAdBlockProxyingURLLoaderFactory(
+      base::WeakPtr<AsideAdBlockService> service,
+      std::optional<url::Origin> frame_origin,
+      bool is_navigation,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target);
+  ~AsideAdBlockProxyingURLLoaderFactory() override;
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override;
+  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
+      override;
+
+ private:
+  class ResourceLoader;
+  class NavigationClient;
+
+  void OnDisconnect();
+
+  base::WeakPtr<AsideAdBlockService> service_;
+  std::optional<url::Origin> frame_origin_;
+  const bool is_navigation_;
+  mojo::ReceiverSet<network::mojom::URLLoaderFactory> receivers_;
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+};
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROXYING_URL_LOADER_FACTORY_H_
