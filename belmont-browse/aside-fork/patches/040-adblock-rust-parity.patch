+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Browser-global registration of the Aside mini popup shortcut (Local State
+// prefs aside.mini_popup.enabled / aside.mini_popup.shortcut, default
+// "Alt+Space"). The original's AsideMiniPopupCoordinator reports
+// "Aside mini popup global shortcut unavailable" when the platform has no
+// global accelerator support; the extension shows "This shortcut is
+// unavailable" when registration fails.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_ASIDE_MINI_POPUP_MINI_POPUP_SHORTCUT_H_
+#define CHROME_BROWSER_EXTENSIONS_API_ASIDE_MINI_POPUP_MINI_POPUP_SHORTCUT_H_
+
+#include <string>
+
+#include "base/no_destructor.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/accelerators/global_accelerator_listener/global_accelerator_listener.h"
+
+namespace extensions {
+
+class MiniPopupShortcut : public ui::GlobalAcceleratorListener::Observer {
+ public:
+  static MiniPopupShortcut* GetInstance();
+
+  MiniPopupShortcut(const MiniPopupShortcut&) = delete;
+  MiniPopupShortcut& operator=(const MiniPopupShortcut&) = delete;
+
+  // Re-registers from the prefs. Returns an error message, empty on success
+  // (also when the feature is disabled).
+  std::string Apply();
+
+  // Checks that |shortcut| parses and can be registered (registering it when
+  // the feature is enabled). Returns an error message, empty on success.
+  std::string TryShortcut(const std::string& shortcut);
+
+  // ui::GlobalAcceleratorListener::Observer:
+  void OnKeyPressed(const ui::Accelerator& accelerator) override;
+  void ExecuteCommand(const std::string& accelerator_group_id,
+                      const std::string& command_id) override {}
+
+ private:
+  MiniPopupShortcut();
+  ~MiniPopupShortcut() override;
+  friend base::NoDestructor<MiniPopupShortcut>;
+
+  std::string Register(const ui::Accelerator& accelerator);
+  void Unregister();
+
+  ui::Accelerator registered_;
+  PrefChangeRegistrar registrar_;
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_ASIDE_MINI_POPUP_MINI_POPUP_SHORTCUT_H_
