+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_FILTER_HOST_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_FILTER_HOST_H_
+
+#include <string>
+#include <vector>
+
+#include "chrome/common/aside_adblock/aside_adblock.mojom.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+
+class GURL;
+
+namespace content {
+class RenderFrameHost;
+}
+
+namespace aside_adblock {
+
+class AsideAdBlockService;
+
+// Per-frame browser end of aside_adblock.mojom.CosmeticFilterHost (replica of
+// the original's CosmeticFilterHost). Self-owned by its receiver.
+class CosmeticFilterHost : public mojom::CosmeticFilterHost {
+ public:
+  static void Bind(content::RenderFrameHost* frame_host,
+                   mojo::PendingReceiver<mojom::CosmeticFilterHost> receiver);
+
+  explicit CosmeticFilterHost(content::GlobalRenderFrameHostId frame_id);
+  CosmeticFilterHost(const CosmeticFilterHost&) = delete;
+  CosmeticFilterHost& operator=(const CosmeticFilterHost&) = delete;
+  ~CosmeticFilterHost() override;
+
+  // mojom::CosmeticFilterHost:
+  void GetCosmeticResources(const GURL& url,
+                            GetCosmeticResourcesCallback callback) override;
+  void GetHiddenSelectors(const std::vector<std::string>& classes,
+                          const std::vector<std::string>& ids,
+                          GetHiddenSelectorsCallback callback) override;
+  void TakePrefetchedResources(
+      TakePrefetchedResourcesCallback callback) override;
+
+ private:
+  AsideAdBlockService* service();
+  content::RenderFrameHost* frame();
+
+  const content::GlobalRenderFrameHostId frame_id_;
+};
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_FILTER_HOST_H_
