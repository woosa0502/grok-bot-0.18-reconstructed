diff --git a/chrome/browser/aside_adblock/aside_adblock_procedural.cc b/chrome/browser/aside_adblock/aside_adblock_procedural.cc
new file mode 100644
index 0000000000..08653c6330
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_procedural.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_procedural.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+
+namespace aside_adblock {
+
+namespace {
+
+struct OperatorSpec {
+  std::string_view name;  // pseudo-class name without the leading ':'
+  bool is_action;
+};
+
+// Longer names first where one is a prefix of another.
+constexpr OperatorSpec kOperators[] = {
+    {"matches-css-before", false}, {"matches-css-after", false},
+    {"matches-css", false},        {"matches-attr", false},
+    {"matches-path", false},       {"min-text-length", false},
+    {"has-text", false},           {"upward", false},
+    {"xpath", false},              {"remove-attr", true},
+    {"remove-class", true},        {"remove", true},
+    {"style", true},
+};
+
+// Index of the closing ')' matching the '(' at |open|, or npos.
+size_t FindClosingParen(std::string_view s, size_t open) {
+  int depth = 0;
+  char quote = 0;
+  for (size_t i = open; i < s.size(); ++i) {
+    const char c = s[i];
+    if (quote) {
+      if (c == '\\' && i + 1 < s.size()) {
+        ++i;
+      } else if (c == quote) {
+        quote = 0;
+      }
+      continue;
+    }
+    if (c == '"' || c == '\'') {
+      quote = c;
+    } else if (c == '(') {
+      ++depth;
+    } else if (c == ')') {
+      if (--depth == 0) {
+        return i;
+      }
+    }
+  }
+  return std::string_view::npos;
+}
+
+}  // namespace
+
+ProceduralParse ParseProceduralSelector(std::string_view selector,
+                                        std::string* normalized,
+                                        std::string* json) {
+  std::string s(selector);
+  base::ReplaceSubstringsAfterOffset(&s, 0, ":-abp-has(", ":has(");
+  base::ReplaceSubstringsAfterOffset(&s, 0, ":-abp-contains(", ":has-text(");
+  *normalized = s;
+  json->clear();
+
+  base::ListValue chain;
+  std::optional<base::DictValue> action;
+  size_t segment_start = 0;
+  int depth = 0;
+  char quote = 0;
+  std::vector<std::string> css_segments;
+  for (size_t i = 0; i < s.size(); ++i) {
+    const char c = s[i];
+    if (quote) {
+      if (c == '\\' && i + 1 < s.size()) {
+        ++i;
+      } else if (c == quote) {
+        quote = 0;
+      }
+      continue;
+    }
+    if (c == '"' || c == '\'') {
+      quote = c;
+      continue;
+    }
+    if (c == '(' || c == '[') {
+      ++depth;
+      continue;
+    }
+    if (c == ')' || c == ']') {
+      --depth;
+      continue;
+    }
+    if (c != ':' || depth != 0) {
+      continue;
+    }
+    std::string_view rest = std::string_view(s).substr(i + 1);
+    const OperatorSpec* spec = nullptr;
+    for (const OperatorSpec& candidate : kOperators) {
+      if (rest.starts_with(candidate.name) &&
+          rest.size() > candidate.name.size() &&
+          rest[candidate.name.size()] == '(') {
+        spec = &candidate;
+        break;
+      }
+    }
+    if (!spec) {
+      continue;
+    }
+    if (action) {
+      return ProceduralParse::kUnsupported;  // operator after an action
+    }
+    const size_t open = i + 1 + spec->name.size();
+    const size_t close = FindClosingParen(s, open);
+    if (close == std::string::npos) {
+      return ProceduralParse::kUnsupported;
+    }
+    std::string css = s.substr(segment_start, i - segment_start);
+    if (!css.empty()) {
+      css_segments.push_back(css);
+      base::DictValue step;
+      step.Set("type", "css-selector");
+      step.Set("arg", css);
+      chain.Append(std::move(step));
+    }
+    std::string arg = s.substr(open + 1, close - open - 1);
+    if (spec->is_action) {
+      base::DictValue a;
+      a.Set("type", std::string(spec->name));
+      if (!(spec->name == "remove" && arg.empty())) {
+        a.Set("arg", arg);
+      }
+      action = std::move(a);
+    } else {
+      base::DictValue step;
+      step.Set("type", std::string(spec->name));
+      step.Set("arg", arg);
+      chain.Append(std::move(step));
+    }
+    i = close;
+    segment_start = close + 1;
+  }
+  std::string tail = s.substr(segment_start);
+  if (chain.empty() && !action) {
+    // No top-level procedural operator: a plain selector, exactly as
+    // adblock-rust's validate_css_selector (0.13.3) decides. Procedural
+    // pseudo-classes nested inside :has()/:not() or :-abp-properties() are
+    // passed through as CSS text; the page's CSS parser drops them (verified
+    // against adblock-rust: all 72 such EasyList lines come back as plain
+    // hide_selectors, none as procedural actions, none rejected).
+    return ProceduralParse::kPlain;
+  }
+  if (!base::TrimWhitespaceASCII(tail, base::TRIM_ALL).empty()) {
+    if (action) {
+      return ProceduralParse::kUnsupported;  // selector text after an action
+    }
+    css_segments.push_back(tail);
+    base::DictValue step;
+    step.Set("type", "css-selector");
+    step.Set("arg", tail);
+    chain.Append(std::move(step));
+  }
+  // Nested procedural operators inside a css-selector step are kept as text
+  // (adblock-rust does the same; querySelectorAll then matches nothing).
+  if (chain.empty()) {
+    return ProceduralParse::kUnsupported;  // action without a selector
+  }
+  base::DictValue rule;
+  rule.Set("selector", std::move(chain));
+  if (action) {
+    rule.Set("action", std::move(*action));
+  }
+  base::JSONWriter::Write(rule, json);
+  return ProceduralParse::kProcedural;
+}
+
+}  // namespace aside_adblock
diff --git a/chrome/browser/aside_adblock/aside_adblock_procedural.h b/chrome/browser/aside_adblock/aside_adblock_procedural.h
new file mode 100644
index 0000000000..0bd4ad2617
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_procedural.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Procedural cosmetic selectors (uBO / ABP extended syntax) → the JSON rule
+// the original's cosmetic script runs:
+//   {"selector":[{"type":"css-selector","arg":".a"},
+//                {"type":"has-text","arg":"/Sponsored/"}],
+//    "action":{"type":"style","arg":"..."}}
+// Operators the script accepts: css-selector, has-text, matches-attr,
+// matches-css, matches-css-before, matches-css-after, matches-path,
+// min-text-length, upward, xpath; actions: remove, style, remove-attr,
+// remove-class. Pure function (//base only), shared with the classifier.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROCEDURAL_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROCEDURAL_H_
+
+#include <string>
+#include <string_view>
+
+namespace aside_adblock {
+
+enum class ProceduralParse {
+  kPlain,        // no procedural operator: use |normalized| as a CSS selector
+  kProcedural,   // |json| holds the rule for the cosmetic script
+  kUnsupported,  // nested procedural operators, :-abp-properties, ...
+};
+
+// |normalized| gets ABP aliases rewritten (:-abp-has → :has,
+// :-abp-contains → :has-text) for the plain case.
+ProceduralParse ParseProceduralSelector(std::string_view selector,
+                                        std::string* normalized,
+                                        std::string* json);
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROCEDURAL_H_
