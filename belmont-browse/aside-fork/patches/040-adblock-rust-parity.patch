+// found in the LICENSE file.
+
+// Browser-side cosmetic filter host for one frame (replica of the original
+// components/aside_adblock CosmeticFilterHost; the renderer's
+// AsideAdBlockRenderFrameObserver drives the embedded cosmetic script).
+module aside_adblock.mojom;
+
+import "url/mojom/url.mojom";
+
+interface CosmeticFilterHost {
+  // Resources for the document at |url| as the cosmetic script's payload:
+  // {"hideSelectors": [...], "proceduralActions": [json, ...],
+  //  "generichide": bool}. Empty when ad blocking is off for the profile.
+  GetCosmeticResources(url.mojom.Url url) => (string payload_json);
+
+  // Generic element-hiding selectors keyed by the classes and ids the
+  // document reported (the script's takePending()).
+  GetHiddenSelectors(array<string> classes, array<string> ids)
+      => (array<string> selectors);
+
+  // Resources for the frame's current document (same payload shape).
+  TakePrefetchedResources() => (string payload_json);
+};
