diff --git a/chrome/browser/profiles/aside_account_password_gate.cc b/chrome/browser/profiles/aside_account_password_gate.cc
new file mode 100644
index 0000000000..2d1a88bb51
--- /dev/null
+++ b/chrome/browser/profiles/aside_account_password_gate.cc
@@ -0,0 +1,250 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/profiles/aside_account_password_gate.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aside/aside_extension_bridge.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/extension.h"
+#include "ui/base/base_window.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kSuppressedPref[] = "aside.automatic_password_gate_suppressed";
+constexpr char kExtensionAvailablePref[] =
+    "aside.account_password_extension_available";
+constexpr char kBootstrapCompletePref[] = "aside.bootstrap_complete";
+constexpr char kAccountIdPref[] = "aside.account_id";
+constexpr char kAuthPausedPref[] = "aside.account_auth_paused";
+// Original strings: popup app name and the onboarding entry route.
+constexpr char kPopupAppName[] = "aside-account-password-popup";
+constexpr char kOnboardingPath[] = "/newtab.html#/onboarding/splash";
+constexpr int kPopupWidth = 560;
+constexpr int kPopupHeight = 720;
+
+}  // namespace
+
+// static
+void AsideAccountPasswordGate::RegisterProfilePrefs(
+    PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kSuppressedPref, false);
+  registry->RegisterBooleanPref(kExtensionAvailablePref, false);
+}
+
+AsideAccountPasswordGate::AsideAccountPasswordGate(Profile* profile)
+    : profile_(profile) {
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile_);
+  if (registry) {
+    registry_observation_.Observe(registry);
+    profile_->GetPrefs()->SetBoolean(
+        kExtensionAvailablePref,
+        registry->GetExtensionById(aside::kAsideExtensionId,
+                                   extensions::ExtensionRegistry::ENABLED) !=
+            nullptr);
+  }
+  registrar_.Init(profile_->GetPrefs());
+  auto refresh =
+      base::BindRepeating(&AsideAccountPasswordGate::RefreshBootstrapState,
+                          base::Unretained(this));
+  for (const char* pref : {kSuppressedPref, kExtensionAvailablePref,
+                           kBootstrapCompletePref, kAccountIdPref,
+                           kAuthPausedPref}) {
+    registrar_.Add(pref, refresh);
+  }
+  RefreshBootstrapState();
+}
+
+AsideAccountPasswordGate::~AsideAccountPasswordGate() = default;
+
+void AsideAccountPasswordGate::Shutdown() {
+  registrar_.RemoveAll();
+  registry_observation_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+bool AsideAccountPasswordGate::IsBootstrapWindowRequired() const {
+  if (profile_->IsOffTheRecord() || profile_->IsGuestSession() ||
+      profile_->IsSystemProfile()) {
+    return false;
+  }
+  const PrefService* prefs = profile_->GetPrefs();
+  if (prefs->GetBoolean(kSuppressedPref) ||
+      !prefs->GetBoolean(kExtensionAvailablePref)) {
+    return false;
+  }
+  if (prefs->GetInteger(kAccountIdPref) < 0 ||
+      prefs->GetBoolean(kAuthPausedPref)) {
+    return false;
+  }
+  return !prefs->GetBoolean(kBootstrapCompletePref);
+}
+
+void AsideAccountPasswordGate::RefreshBootstrapState() {
+  const bool required = IsBootstrapWindowRequired();
+  VLOG(1) << "AsideAccountPasswordGate: refresh required=" << required
+          << " active=" << gate_active_;
+  if (required && !gate_active_) {
+    gate_active_ = true;
+    PostHideNormalBrowsers();
+    PostMaybeShowBootstrapWindow();
+  } else if (!required && gate_active_) {
+    gate_active_ = false;
+    CloseBootstrapPopup();
+    PostMaybeOpenFreshBrowserAfterBootstrapReset();
+  } else if (required && gate_active_ && !popup_) {
+    PostMaybeShowBootstrapWindow();
+  }
+}
+
+void AsideAccountPasswordGate::PostHideNormalBrowsers() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AsideAccountPasswordGate::HideNormalBrowsers,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void AsideAccountPasswordGate::HideNormalBrowsers() {
+  if (!gate_active_) {
+    return;
+  }
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() == profile_ &&
+            browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            browser->GetWindow()->IsVisible()) {
+          browser->GetWindow()->Hide();
+          hidden_browsers_.push_back(browser->GetWeakPtr());
+        }
+        return true;
+      });
+  VLOG(1) << "AsideAccountPasswordGate: hid " << hidden_browsers_.size()
+          << " normal browsers";
+}
+
+void AsideAccountPasswordGate::PostMaybeShowBootstrapWindow() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&AsideAccountPasswordGate::MaybeShowBootstrapWindow,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AsideAccountPasswordGate::MaybeShowBootstrapWindow() {
+  if (!gate_active_ || !IsBootstrapWindowRequired()) {
+    return;
+  }
+  if (popup_) {
+    popup_->GetWindow()->Activate();
+    return;
+  }
+  Browser::CreateParams params = Browser::CreateParams::CreateForAppPopup(
+      kPopupAppName, /*trusted_source=*/true,
+      gfx::Rect(0, 0, kPopupWidth, kPopupHeight), profile_,
+      /*user_gesture=*/false);
+  Browser* browser = Browser::Create(params);
+  if (!browser) {
+    return;
+  }
+  const GURL url(std::string(extensions::kExtensionScheme) + "://" +
+                 aside::kAsideExtensionId + kOnboardingPath);
+  chrome::AddSelectedTabWithURL(browser, url,
+                                ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  browser->window()->Show();
+  popup_ = browser->GetWeakPtr();
+  VLOG(1) << "AsideAccountPasswordGate: bootstrap popup shown " << url.spec();
+}
+
+void AsideAccountPasswordGate::PostCloseStaleBootstrapPopupAfterExtensionReload() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<AsideAccountPasswordGate> self) {
+                       if (!self) {
+                         return;
+                       }
+                       self->CloseBootstrapPopup();
+                       self->RefreshBootstrapState();
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AsideAccountPasswordGate::PostMaybeOpenFreshBrowserAfterBootstrapReset() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &AsideAccountPasswordGate::MaybeOpenFreshBrowserAfterBootstrapReset,
+          weak_factory_.GetWeakPtr()));
+}
+
+void AsideAccountPasswordGate::MaybeOpenFreshBrowserAfterBootstrapReset() {
+  if (gate_active_) {
+    return;
+  }
+  bool shown = false;
+  for (const base::WeakPtr<BrowserWindowInterface>& browser : hidden_browsers_) {
+    if (browser) {
+      browser->GetWindow()->Show();
+      shown = true;
+    }
+  }
+  hidden_browsers_.clear();
+  if (!shown) {
+    bool has_normal = false;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetProfile() == profile_ &&
+              browser->GetType() == BrowserWindowInterface::TYPE_NORMAL) {
+            has_normal = true;
+            return false;
+          }
+          return true;
+        });
+    if (!has_normal) {
+      chrome::NewEmptyWindow(profile_);
+    }
+  }
+}
+
+void AsideAccountPasswordGate::CloseBootstrapPopup() {
+  if (popup_) {
+    popup_->GetWindow()->Close();
+    popup_.reset();
+  }
+}
+
+void AsideAccountPasswordGate::OnExtensionLoaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension) {
+  if (extension->id() != aside::kAsideExtensionId) {
+    return;
+  }
+  profile_->GetPrefs()->SetBoolean(kExtensionAvailablePref, true);
+  RefreshBootstrapState();
+}
+
+void AsideAccountPasswordGate::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UnloadedExtensionReason reason) {
+  if (extension->id() != aside::kAsideExtensionId) {
+    return;
+  }
+  profile_->GetPrefs()->SetBoolean(kExtensionAvailablePref, false);
+  PostCloseStaleBootstrapPopupAfterExtensionReload();
+}
diff --git a/chrome/browser/profiles/aside_account_password_gate.h b/chrome/browser/profiles/aside_account_password_gate.h
new file mode 100644
index 0000000000..73ef67b929
--- /dev/null
+++ b/chrome/browser/profiles/aside_account_password_gate.h
@@ -0,0 +1,76 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Replica of the original chrome/browser/profiles/aside_account_password_gate:
+// while the bound Aside account's local bootstrap is incomplete
+// (accounts.json localBootstraps[id].isComplete == false →
+// aside.bootstrap_complete), the profile's normal browser windows are hidden
+// and a popup window ("aside-account-password-popup") shows the extension's
+// onboarding (newtab.html#/onboarding/splash, which routes to
+// setup-account/password). aside.automatic_password_gate_suppressed turns the
+// gate off; aside.account_password_extension_available tracks whether the
+// extension that hosts the page is installed.
+
+#ifndef CHROME_BROWSER_PROFILES_ASIDE_ACCOUNT_PASSWORD_GATE_H_
+#define CHROME_BROWSER_PROFILES_ASIDE_ACCOUNT_PASSWORD_GATE_H_
+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+
+class BrowserWindowInterface;
+class PrefRegistrySimple;
+class Profile;
+
+class AsideAccountPasswordGate : public KeyedService,
+                                 public extensions::ExtensionRegistryObserver {
+ public:
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  explicit AsideAccountPasswordGate(Profile* profile);
+  AsideAccountPasswordGate(const AsideAccountPasswordGate&) = delete;
+  AsideAccountPasswordGate& operator=(const AsideAccountPasswordGate&) = delete;
+  ~AsideAccountPasswordGate() override;
+
+  bool IsBootstrapWindowRequired() const;
+  void RefreshBootstrapState();
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const extensions::Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override;
+
+ private:
+  void PostHideNormalBrowsers();
+  void HideNormalBrowsers();
+  void PostMaybeShowBootstrapWindow();
+  void MaybeShowBootstrapWindow();
+  void PostCloseStaleBootstrapPopupAfterExtensionReload();
+  void PostMaybeOpenFreshBrowserAfterBootstrapReset();
+  void MaybeOpenFreshBrowserAfterBootstrapReset();
+  void CloseBootstrapPopup();
+
+  raw_ptr<Profile> profile_;
+  PrefChangeRegistrar registrar_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_observation_{this};
+  bool gate_active_ = false;
+  base::WeakPtr<BrowserWindowInterface> popup_;
+  std::vector<base::WeakPtr<BrowserWindowInterface>> hidden_browsers_;
+  base::WeakPtrFactory<AsideAccountPasswordGate> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_PROFILES_ASIDE_ACCOUNT_PASSWORD_GATE_H_
