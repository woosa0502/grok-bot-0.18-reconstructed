+class NavigationThrottleRegistry;
+}
+
+namespace aside_adblock {
+
+// Blocks navigations matched by $document rules (top-level) and by sub-frame
+// rules, rendering the "Page blocked by Aside" page with "Go back" and
+// "Continue once" actions like the original AsideAdBlockNavigationThrottle.
+class AsideAdBlockNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit AsideAdBlockNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~AsideAdBlockNavigationThrottle() override;
