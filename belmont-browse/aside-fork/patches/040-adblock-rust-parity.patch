+#include "components/subresource_filter/core/common/first_party_origin.h"
+#include "components/subresource_filter/core/common/indexed_ruleset.h"
+#include "components/subresource_filter/core/common/load_policy.h"
+#include "components/subresource_filter/tools/rule_parser/rule.h"
+#include "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#include "components/url_pattern_index/flat/url_pattern_index_generated.h"
+#include "crypto/hash.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace aside_adblock {
+
+using url_pattern_index::proto::ElementType;
+using Bucket = PreprocessedRule::Bucket;
+
+// A side index: one RulesetIndexer + matcher for rules whose option was
+// rewritten by the preprocessor.
+struct Engine::SideIndex {
+  explicit SideIndex(uint64_t id)
+      : indexer(std::make_unique<subresource_filter::RulesetIndexer>(id)) {}
+  ~SideIndex() = default;
+
+  bool Add(const url_pattern_index::proto::UrlRule& rule) {
+    if (!indexer->AddUrlRule(rule)) {
+      return false;
+    }
+    ++count;
+    return true;
+  }
+  void Finish() {
+    indexer->Finish();
+    if (count > 0) {
+      matcher = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          indexer->data());
+    }
+  }
+  // Deserialized form: owns the index bytes instead of an indexer.
+  void Load(base::span<const uint8_t> bytes, int rule_count) {
+    indexer.reset();
+    loaded.assign(bytes.begin(), bytes.end());
+    count = rule_count;
+    if (count > 0) {
+      matcher = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          base::span<const uint8_t>(loaded));
+    }
+  }
+  base::span<const uint8_t> data() const {
+    return indexer ? indexer->data() : base::span<const uint8_t>(loaded);
+  }
+  size_t size() const { return data().size(); }
+
+  std::unique_ptr<subresource_filter::RulesetIndexer> indexer;
+  std::vector<uint8_t> loaded;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> matcher;
+  int count = 0;
+};
+
+struct Engine::RegexRule {
+  std::unique_ptr<re2::RE2> re;
+  url_pattern_index::proto::UrlRule proto;  // options only
+  bool document_rule = false;
+  Bucket bucket = Bucket::kMain;
+  std::string redirect;
+  RuleInfo info;
+};
+
+namespace {
+
+// Options that only make sense for whole-document navigations. Rules carrying
+// them are indexed into the document rule set with the option rewritten to
+// "subdocument", which the parser understands.
+bool ExtractDocumentRule(std::string_view line, std::string* rewritten) {
+  size_t dollar = line.rfind('$');
+  if (dollar == std::string_view::npos || line.starts_with("@@")) {
+    return false;
+  }
+  std::string_view options = line.substr(dollar + 1);
+  std::vector<std::string> parts = base::SplitString(
+      options, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  bool has_document = false;
+  for (auto& part : parts) {
+    if (part == "document" || part == "doc") {
+      part = "subdocument";
+      has_document = true;
+    }
+  }
+  if (!has_document) {
+    return false;
+  }
+  *rewritten = std::string(line.substr(0, dollar + 1)) +
+               base::JoinString(parts, ",");
+  return true;
+}
+
+
+std::string PatternOf(const url_pattern_index::flat::UrlRule* rule) {
+  return rule && rule->url_pattern() ? rule->url_pattern()->str()
+                                     : std::string();
+}
+
+bool IsAllowlist(const url_pattern_index::flat::UrlRule* rule) {
+  return rule &&
+         (rule->options() & url_pattern_index::flat::OptionFlag_IS_ALLOWLIST);
+}
+
+std::string DataUrl(const Resource& res) {
+  return "data:" + res.mime + ";base64," + base::Base64Encode(res.body);
+}
+
+}  // namespace
+
+ElementType ElementTypeForDestination(
+    network::mojom::RequestDestination destination) {
+  using D = network::mojom::RequestDestination;
+  switch (destination) {
+    case D::kScript:
+    case D::kServiceWorker:
+    case D::kSharedWorker:
+    case D::kWorker:
+    case D::kAudioWorklet:
+    case D::kPaintWorklet:
+    case D::kJson:
+    case D::kWebBundle:
+    case D::kSpeculationRules:
+      return ElementType::ELEMENT_TYPE_SCRIPT;
+    case D::kImage:
+      return ElementType::ELEMENT_TYPE_IMAGE;
+    case D::kStyle:
+    case D::kXslt:
+      return ElementType::ELEMENT_TYPE_STYLESHEET;
+    case D::kFont:
+      return ElementType::ELEMENT_TYPE_FONT;
+    case D::kAudio:
+    case D::kVideo:
+    case D::kTrack:
+      return ElementType::ELEMENT_TYPE_MEDIA;
+    case D::kObject:
+    case D::kEmbed:
+      return ElementType::ELEMENT_TYPE_OBJECT;
+    case D::kIframe:
+    case D::kFrame:
+    case D::kFencedframe:
+    case D::kDocument:
+      return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+    case D::kReport:
+      return ElementType::ELEMENT_TYPE_PING;
+    case D::kEmpty:
+      return ElementType::ELEMENT_TYPE_XMLHTTPREQUEST;
+    default:
+      return ElementType::ELEMENT_TYPE_OTHER;
+  }
+}
+
+ElementType ElementTypeForName(const std::string& name, bool* is_document) {
+  *is_document = false;
+  std::string n = base::ToLowerASCII(name);
+  if (n == "script") {
+    return ElementType::ELEMENT_TYPE_SCRIPT;
+  }
+  if (n == "image" || n == "img") {
+    return ElementType::ELEMENT_TYPE_IMAGE;
+  }
+  if (n == "stylesheet" || n == "css") {
+    return ElementType::ELEMENT_TYPE_STYLESHEET;
+  }
+  if (n == "font") {
+    return ElementType::ELEMENT_TYPE_FONT;
+  }
+  if (n == "media" || n == "audio" || n == "video") {
+    return ElementType::ELEMENT_TYPE_MEDIA;
+  }
+  if (n == "object") {
+    return ElementType::ELEMENT_TYPE_OBJECT;
+  }
+  if (n == "subdocument" || n == "sub_frame" || n == "frame" || n == "iframe") {
+    return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+  }
+  if (n == "document" || n == "main_frame") {
+    *is_document = true;
+    return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+  }
+  if (n == "xmlhttprequest" || n == "xhr" || n == "fetch") {
+    return ElementType::ELEMENT_TYPE_XMLHTTPREQUEST;
+  }
+  if (n == "websocket") {
+    return ElementType::ELEMENT_TYPE_WEBSOCKET;
+  }
+  if (n == "ping" || n == "beacon") {
+    return ElementType::ELEMENT_TYPE_PING;
+  }
+  return ElementType::ELEMENT_TYPE_OTHER;
+}
+
+Engine::Engine(const EngineOptions& options)
+    : max_invalid_lines_(options.max_invalid_lines_per_source),
+      indexer_(std::make_unique<subresource_filter::RulesetIndexer>(1)),
+      document_indexer_(
+          std::make_unique<subresource_filter::RulesetIndexer>(2)),
+      popup_(std::make_unique<SideIndex>(3)),
+      generichide_(std::make_unique<SideIndex>(4)),
+      elemhide_(std::make_unique<SideIndex>(5)),
+      important_(std::make_unique<SideIndex>(6)),
+      important_document_(std::make_unique<SideIndex>(7)),
+      redirect_rule_(std::make_unique<SideIndex>(8)),
+      csp_(std::make_unique<SideIndex>(9)),
+      method_(std::make_unique<SideIndex>(10)) {
+  LoadResources(options.resources_json);
+}
+
+Engine::~Engine() = default;
+
+// static
+scoped_refptr<Engine> Engine::Build(const std::vector<FilterSource>& sources) {
+  return BuildWithOptions(sources, EngineOptions());
+}
+
+// static
+scoped_refptr<Engine> Engine::BuildWithOptions(
+    const std::vector<FilterSource>& sources,
+    const EngineOptions& options) {
+  scoped_refptr<Engine> engine(new Engine(options));
+  for (const FilterSource& source : sources) {
+    engine->AddSource(source);
+  }
+  engine->Finish();
+  return engine;
+}
+
+void Engine::LoadResources(const std::string& json) {
+  for (const BuiltinResource& r : kBuiltinResources) {
+    resources_[std::string(r.name)] =
+        Resource{std::string(r.mime), std::string(r.body)};
+  }
+  if (json.empty()) {
+    return;
+  }
+  // adblock-rust resources.json: [{name, aliases:[...], kind:{mime},
+  // content:<base64>}]
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_list()) {
+    return;
+  }
+  for (const base::Value& item : parsed->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& d = item.GetDict();
+    const std::string* name = d.FindString("name");
+    const std::string* content = d.FindString("content");
+    if (!name || !content) {
+      continue;
+    }
+    Resource res;
+    if (const base::DictValue* kind = d.FindDict("kind")) {
+      if (const std::string* mime = kind->FindString("mime")) {
+        res.mime = *mime;
+      }
+    }
+    if (res.mime.empty()) {
+      res.mime = "application/octet-stream";
+    }
+    std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*content);
+    res.body = bytes ? std::string(bytes->begin(), bytes->end()) : *content;
+    resources_[*name] = res;
+    if (const base::ListValue* aliases = d.FindList("aliases")) {
+      for (const base::Value& alias : *aliases) {
+        if (alias.is_string()) {
+          resources_[alias.GetString()] = res;
+        }
+      }
+    }
+  }
+}
+
+const Resource* Engine::FindResource(const std::string& name) const {
+  auto it = resources_.find(name);
+  if (it != resources_.end()) {
+    return &it->second;
+  }
+  // Unknown surrogate script: neutral empty script (approximation).
+  if (base::EndsWith(name, ".js") || base::EndsWith(name, "js")) {
+    it = resources_.find("noopjs");
+    return it == resources_.end() ? nullptr : &it->second;
+  }
+  return nullptr;
+}
+
+void Engine::AddSource(const FilterSource& source) {
+  SourceStats stats;
+  stats.id = source.id;
+  stats.title = source.title;
+  std::string source_label =
+      source.id == "custom"
+          ? "custom"
+          : (source.id.starts_with("manual:") ? source.id
+                                              : "subscription:" + source.title);
+  auto invalid = [&](size_t line_no, const std::string& line,
+                     std::string_view why) {
+    ++stats.parse_error_count;
+    if (stats.invalid_lines.size() < max_invalid_lines_) {
+      stats.invalid_lines.push_back(base::NumberToString(line_no) + ": " +
+                                    line + " (" + std::string(why) + ")");
+    }
+  };
+
+  subresource_filter::RuleParser parser;
+  size_t line_no = 0;
+  for (std::string_view raw : base::SplitStringPiece(
+           source.text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    ++line_no;
+    if (raw.empty() || raw[0] == '!' || raw[0] == '[') {
+      continue;
+    }
+    std::string line(raw);
+    std::string cosmetic_line = line;
+    const CosmeticKind cosmetic = NormalizeCosmeticRule(&cosmetic_line);
+    if (cosmetic == CosmeticKind::kUnsupported) {
+      invalid(line_no, line, "unsupported feature");
+      continue;
+    }
+    PreprocessedRule pre;
+    if (cosmetic == CosmeticKind::kNotCosmetic) {
+      pre = PreprocessNetworkRule(line);
+    }
+    std::string rewritten;
+    bool document_rule = false;
+    if (pre.is_network) {
+      document_rule = ExtractDocumentRule(pre.line, &rewritten);
+    }
+    const std::string& to_parse =
+        pre.is_network ? (document_rule ? rewritten : pre.line)
+                       : cosmetic_line;
+    url_pattern_index::proto::RuleType type = parser.Parse(to_parse);
+    switch (type) {
+      case url_pattern_index::proto::RULE_TYPE_URL: {
+        url_pattern_index::proto::UrlRule proto =
+            parser.url_rule().ToProtobuf();
+        const std::string& pattern = parser.url_rule().url_pattern;
+        RuleInfo info{line, source_label};
+        if (pre.is_regex) {
+          if (pre.bucket != Bucket::kMain && pre.bucket != Bucket::kImportant &&
+              pre.bucket != Bucket::kPopup) {
+            invalid(line_no, line, "regex with unsupported option");
+            break;
+          }
+          re2::RE2::Options opts;
+          opts.set_case_sensitive(proto.match_case());
+          opts.set_log_errors(false);
+          auto re = std::make_unique<re2::RE2>(pre.regex, opts);
+          if (!re->ok()) {
+            invalid(line_no, line, "regex unsupported: " + re->error());
+            break;
+          }
+          auto rule = std::make_unique<RegexRule>();
+          rule->re = std::move(re);
+          rule->proto = proto;
+          rule->document_rule = document_rule;
+          rule->bucket = pre.bucket;
+          rule->redirect = pre.redirect;
+          rule->info = info;
+          regex_patterns_.push_back(pre.regex);
+          if (pre.bucket == Bucket::kPopup) {
+            ++popup_rule_count_;
+          }
+          regex_rules_.push_back(std::move(rule));
+          ++stats.network_rule_count;
+          break;
+        }
+        bool ok = false;
+        switch (pre.bucket) {
+          case Bucket::kMain:
+            ok = document_rule ? document_indexer_->AddUrlRule(proto)
+                               : indexer_->AddUrlRule(proto);
+            break;
+          case Bucket::kPopup:
+            ok = popup_->Add(proto);
+            if (ok) {
+              ++popup_rule_count_;
+            }
+            break;
+          case Bucket::kGenericHide:
+            ok = generichide_->Add(proto);
+            break;
+          case Bucket::kElemHide:
+            ok = elemhide_->Add(proto);
+            break;
+          case Bucket::kImportant:
+            ok = document_rule ? important_document_->Add(proto)
+                               : important_->Add(proto);
+            break;
+          case Bucket::kRedirectRule:
+            ok = redirect_rule_->Add(proto);
+            break;
+          case Bucket::kCsp:
+            ok = csp_->Add(proto);
+            if (ok) {
+              ++csp_rule_count_;
+              csp_by_pattern_[pattern] = pre.csp;
+            }
+            break;
+          case Bucket::kMethod:
+            ok = method_->Add(proto);
+            if (ok) {
+              method_by_pattern_[pattern] = pre.method;
+            }
+            break;
+        }
+        if (!ok) {
+          invalid(line_no, line, "not indexable");
+          break;
+        }
+        ++stats.network_rule_count;
+        rules_by_pattern_.emplace(pattern, std::move(info));
+        if (!pre.redirect.empty()) {
+          redirect_by_pattern_[pattern] = pre.redirect;
+        }
+        break;
+      }
+      case url_pattern_index::proto::RULE_TYPE_STYLE: {
+        const subresource_filter::StyleRule& css = parser.style_rule();
+        std::string normalized;
+        std::string procedural_json;
+        const ProceduralParse parse = ParseProceduralSelector(
+            css.selector, &normalized, &procedural_json);
+        if (parse == ProceduralParse::kUnsupported) {
+          invalid(line_no, line, "unsupported selector");
+          break;
+        }
+        if (parse == ProceduralParse::kProcedural) {
+          ++stats.cosmetic_rule_count;
+          if (css.is_allowlist) {
+            break;  // procedural exceptions: not expressible, ignored
+          }
+          ProceduralRule rule;
+          rule.json = std::move(procedural_json);
+          for (const std::string& domain : css.domains) {
+            if (domain.starts_with("~")) {
+              rule.exclude.push_back(domain.substr(1));
+            } else {
+              rule.include.push_back(domain);
+            }
+          }
+          procedural_rules_.push_back(std::move(rule));
+          ++procedural_rule_count_;
+          break;
+        }
+        CosmeticRule rule;
+        rule.selector = normalized;
+        rule.is_exception = css.is_allowlist;
+        for (const std::string& domain : css.domains) {
+          if (domain.starts_with("~")) {
+            rule.exclude.push_back(domain.substr(1));
+          } else {
+            rule.include.push_back(domain);
+          }
+        }
+        ++stats.cosmetic_rule_count;
+        if (!rule.is_exception && rule.include.empty() &&
+            rule.exclude.empty()) {
+          generic_selectors_.push_back(rule.selector);
+        } else {
+          conditional_rules_.push_back(std::move(rule));
+        }
+        break;
+      }
+      case url_pattern_index::proto::RULE_TYPE_COMMENT:
+        break;
+      default: {
+        const auto& err = parser.parse_error();
+        std::string why;
+        switch (err.error_code) {
+          case subresource_filter::RuleParser::ParseError::UNKNOWN_OPTION:
+            why = "unknown option";
+            break;
+          case subresource_filter::RuleParser::ParseError::
+              UNSUPPORTED_FEATURE:
+            why = "unsupported feature";
+            break;
+          case subresource_filter::RuleParser::ParseError::
+              EMPTY_CSS_SELECTOR:
+            why = "empty selector";
+            break;
+          case subresource_filter::RuleParser::ParseError::DEPRECATED_OPTION:
+            why = "deprecated option";
+            break;
+          default:
+            why = "parse error";
+        }
+        invalid(line_no, line, why);
+        break;
+      }
+    }
+  }
+  network_rule_count_ += stats.network_rule_count;
+  cosmetic_rule_count_ += stats.cosmetic_rule_count;
+  parse_error_count_ += stats.parse_error_count;
+  sources_.push_back(std::move(stats));
+}
+
+void Engine::Finish() {
+  FinishIndexes();
+  BuildCosmeticTables();
+}
+
+void Engine::FinishIndexes() {
+  indexer_->Finish();
+  document_indexer_->Finish();
+  flatbuffer_size_ = indexer_->data().size() + document_indexer_->data().size();
+  matcher_ = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+      indexer_->data());
+  document_matcher_ =
+      std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          document_indexer_->data());
+  for (SideIndex* side : {popup_.get(), generichide_.get(), elemhide_.get(),
+                          important_.get(), important_document_.get(),
+                          redirect_rule_.get(), csp_.get(), method_.get()}) {
+    side->Finish();
+    flatbuffer_size_ += side->size();
+  }
+}
+
+void Engine::BuildCosmeticTables() {
+  // Exceptions without domains remove generic selectors outright.
+  base::flat_set<std::string> generic_exceptions;
+  for (const CosmeticRule& rule : conditional_rules_) {
+    if (rule.is_exception && rule.include.empty() && rule.exclude.empty()) {
+      generic_exceptions.insert(rule.selector);
+    }
+  }
+  if (!generic_exceptions.empty()) {
+    std::erase_if(generic_selectors_, [&](const std::string& s) {
+      return generic_exceptions.contains(s);
+    });
+  }
+  generic_stylesheet_.clear();
+  if (!generic_selectors_.empty()) {
+    generic_stylesheet_ =
+        base::JoinString(generic_selectors_, ",\n") + "{display:none!important;}\n";
+  }
+  // Key generic selectors by their leading .class / #id (the cosmetic script
+  // asks for those by the classes/ids it sees); the rest ship with the page.
+  generic_by_class_.clear();
+  generic_by_id_.clear();
+  generic_misc_.clear();
+  for (const std::string& selector : generic_selectors_) {
+    if (selector.size() < 2 || (selector[0] != '.' && selector[0] != '#')) {
+      generic_misc_.push_back(selector);
+      continue;
+    }
+    size_t end = 1;
+    while (end < selector.size()) {
+      const char c = selector[end];
+      if (base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_' ||
+          static_cast<unsigned char>(c) >= 0x80) {
+        ++end;
+      } else if (c == '\\') {
+        end += 2;
+      } else {
+        break;
+      }
+    }
+    if (end > selector.size()) {
+      end = selector.size();
+    }
+    const std::string key = selector.substr(1, end - 1);
+    if (key.empty() || key.find('\\') != std::string::npos) {
+      generic_misc_.push_back(selector);
+    } else if (selector[0] == '.') {
+      generic_by_class_[key].push_back(selector);
+    } else {
+      generic_by_id_[key].push_back(selector);
+    }
+  }
+}
+
+// ---- cache -----------------------------------------------------------------
+
+namespace {
+
+// Bump whenever parsing/indexing changes: the cache digest only covers the
+// inputs, so a stale engine0/1.dat would otherwise be reused by a new build.
+constexpr uint32_t kCacheVersion = 4;
+
+std::string HexSha256(std::string_view data) {
+  return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(data)));
+}
+
+void WriteStrings(base::Pickle* pickle, const std::vector<std::string>& v) {
+  pickle->WriteUInt32(static_cast<uint32_t>(v.size()));
+  for (const std::string& s : v) {
+    pickle->WriteString(s);
+  }
+}
+
+bool ReadStrings(base::PickleIterator* it, std::vector<std::string>* v) {
+  uint32_t n = 0;
+  if (!it->ReadUInt32(&n)) {
+    return false;
+  }
+  v->clear();
+  v->reserve(n);
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string s;
+    if (!it->ReadString(&s)) {
+      return false;
+    }
+    v->push_back(std::move(s));
+  }
+  return true;
+}
+
+void WriteStringMap(base::Pickle* pickle,
+                    const std::unordered_map<std::string, std::string>& m) {
+  pickle->WriteUInt32(static_cast<uint32_t>(m.size()));
+  for (const auto& [k, v] : m) {
+    pickle->WriteString(k);
+    pickle->WriteString(v);
+  }
+}
+
+bool ReadStringMap(base::PickleIterator* it,
+                   std::unordered_map<std::string, std::string>* m) {
+  uint32_t n = 0;
+  if (!it->ReadUInt32(&n)) {
+    return false;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string k, v;
+    if (!it->ReadString(&k) || !it->ReadString(&v)) {
+      return false;
+    }
+    (*m)[k] = v;
+  }
+  return true;
+}
+
+}  // namespace
+
+// static
+std::string Engine::SourceDigest(const std::vector<FilterSource>& sources,
+                                 const std::string& resources_json) {
+  std::string acc;
+  for (const FilterSource& s : sources) {
+    acc += s.id + "\n" + s.title + "\n" + HexSha256(s.text) + "\n";
+  }
+  acc += "resources:" + HexSha256(resources_json) + "\n";
+  acc += "version:" + base::NumberToString(kCacheVersion);
+  return HexSha256(acc);
+}
+
+// static
+std::string Engine::CachedSourceDigest(const std::string& bytes) {
+  base::Pickle pickle = base::Pickle::WithUnownedBuffer(base::as_byte_span(bytes));
+  base::PickleIterator it(pickle);
+  uint32_t version = 0;
+  std::string digest;
+  if (!it.ReadUInt32(&version) || version != kCacheVersion ||
+      !it.ReadString(&digest)) {
+    return std::string();
+  }
+  return digest;
+}
+
+std::string Engine::Serialize(const std::string& source_digest) const {
+  base::Pickle body;
+  // Stats.
+  body.WriteUInt32(static_cast<uint32_t>(sources_.size()));
+  for (const SourceStats& s : sources_) {
+    body.WriteString(s.id);
+    body.WriteString(s.title);
+    body.WriteInt(s.network_rule_count);
+    body.WriteInt(s.cosmetic_rule_count);
+    body.WriteInt(s.parse_error_count);
+    WriteStrings(&body, s.invalid_lines);
+  }
+  body.WriteUInt64(static_cast<uint64_t>(flatbuffer_size_));
+  body.WriteInt(network_rule_count_);
+  body.WriteInt(cosmetic_rule_count_);
+  body.WriteInt(parse_error_count_);
+  body.WriteInt(csp_rule_count_);
+  body.WriteInt(popup_rule_count_);
+  body.WriteInt(procedural_rule_count_);
+  // Indexes.
+  body.WriteData(indexer_ ? indexer_->data()
+                          : base::span<const uint8_t>(loaded_main_));
+  body.WriteData(document_indexer_
+                     ? document_indexer_->data()
+                     : base::span<const uint8_t>(loaded_document_));
+  for (const SideIndex* side :
+       {popup_.get(), generichide_.get(), elemhide_.get(), important_.get(),
+        important_document_.get(), redirect_rule_.get(), csp_.get(),
+        method_.get()}) {
+    body.WriteInt(side->count);
+    body.WriteData(side->data());
+  }
+  // Rule tables.
+  body.WriteUInt32(static_cast<uint32_t>(rules_by_pattern_.size()));
+  for (const auto& [pattern, info] : rules_by_pattern_) {
+    body.WriteString(pattern);
+    body.WriteString(info.text);
+    body.WriteString(info.source);
+  }
+  WriteStringMap(&body, redirect_by_pattern_);
+  WriteStringMap(&body, csp_by_pattern_);
+  WriteStringMap(&body, method_by_pattern_);
+  body.WriteUInt32(static_cast<uint32_t>(regex_rules_.size()));
+  for (size_t i = 0; i < regex_rules_.size(); ++i) {
+    const RegexRule& r = *regex_rules_[i];
+    body.WriteString(regex_patterns_[i]);
+    body.WriteString(r.proto.SerializeAsString());
+    body.WriteBool(r.document_rule);
+    body.WriteInt(static_cast<int>(r.bucket));
+    body.WriteString(r.redirect);
+    body.WriteString(r.info.text);
+    body.WriteString(r.info.source);
+  }
+  body.WriteUInt32(static_cast<uint32_t>(resources_.size()));
+  for (const auto& [name, res] : resources_) {
+    body.WriteString(name);
+    body.WriteString(res.mime);
+    body.WriteString(res.body);
+  }
+  // Cosmetic tables (keyed tables are rebuilt on load).
+  WriteStrings(&body, generic_selectors_);
+  body.WriteUInt32(static_cast<uint32_t>(conditional_rules_.size()));
+  for (const CosmeticRule& r : conditional_rules_) {
+    body.WriteString(r.selector);
+    WriteStrings(&body, r.include);
+    WriteStrings(&body, r.exclude);
+    body.WriteBool(r.is_exception);
+  }
+  body.WriteUInt32(static_cast<uint32_t>(procedural_rules_.size()));
+  for (const ProceduralRule& r : procedural_rules_) {
+    body.WriteString(r.json);
+    WriteStrings(&body, r.include);
+    WriteStrings(&body, r.exclude);
+  }
+
+  const std::string_view payload(reinterpret_cast<const char*>(body.data()),
+                                 body.size());
+  base::Pickle file;
+  file.WriteUInt32(kCacheVersion);
+  file.WriteString(source_digest);
+  file.WriteString(HexSha256(payload));
+  file.WriteData(payload);
+  return std::string(reinterpret_cast<const char*>(file.data()), file.size());
+}
+
+// static
+scoped_refptr<Engine> Engine::Deserialize(const std::string& bytes,
+                                          const EngineOptions& options) {
+  base::Pickle file = base::Pickle::WithUnownedBuffer(base::as_byte_span(bytes));
+  base::PickleIterator head(file);
+  uint32_t version = 0;
+  std::string digest, payload_hash;
+  if (!head.ReadUInt32(&version) || version != kCacheVersion ||
+      !head.ReadString(&digest) || !head.ReadString(&payload_hash)) {
+    return nullptr;
+  }
+  std::optional<base::span<const uint8_t>> payload = head.ReadData();
+  if (!payload) {
+    return nullptr;
+  }
+  const std::string_view payload_view(
+      reinterpret_cast<const char*>(payload->data()), payload->size());
+  if (HexSha256(payload_view) != payload_hash) {
+    return nullptr;
+  }
+  base::Pickle body = base::Pickle::WithUnownedBuffer(*payload);
+  base::PickleIterator it(body);
+
+  scoped_refptr<Engine> engine(new Engine(options));
+  Engine& e = *engine;
+  uint32_t n = 0;
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    SourceStats s;
+    if (!it.ReadString(&s.id) || !it.ReadString(&s.title) ||
+        !it.ReadInt(&s.network_rule_count) ||
+        !it.ReadInt(&s.cosmetic_rule_count) ||
+        !it.ReadInt(&s.parse_error_count) ||
+        !ReadStrings(&it, &s.invalid_lines)) {
+      return nullptr;
+    }
+    e.sources_.push_back(std::move(s));
+  }
+  uint64_t flat = 0;
+  if (!it.ReadUInt64(&flat) || !it.ReadInt(&e.network_rule_count_) ||
+      !it.ReadInt(&e.cosmetic_rule_count_) || !it.ReadInt(&e.parse_error_count_) ||
+      !it.ReadInt(&e.csp_rule_count_) || !it.ReadInt(&e.popup_rule_count_) ||
+      !it.ReadInt(&e.procedural_rule_count_)) {
+    return nullptr;
+  }
+  e.flatbuffer_size_ = static_cast<size_t>(flat);
+  std::optional<base::span<const uint8_t>> main = it.ReadData();
+  std::optional<base::span<const uint8_t>> document = it.ReadData();
+  if (!main || !document) {
+    return nullptr;
+  }
+  e.indexer_.reset();
+  e.document_indexer_.reset();
+  e.loaded_main_.assign(main->begin(), main->end());
+  e.loaded_document_.assign(document->begin(), document->end());
+  e.matcher_ = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+      base::span<const uint8_t>(e.loaded_main_));
+  e.document_matcher_ =
+      std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          base::span<const uint8_t>(e.loaded_document_));
+  for (SideIndex* side :
+       {e.popup_.get(), e.generichide_.get(), e.elemhide_.get(),
+        e.important_.get(), e.important_document_.get(),
+        e.redirect_rule_.get(), e.csp_.get(), e.method_.get()}) {
+    int count = 0;
+    if (!it.ReadInt(&count)) {
+      return nullptr;
+    }
+    std::optional<base::span<const uint8_t>> data = it.ReadData();
+    if (!data) {
+      return nullptr;
+    }
+    side->Load(*data, count);
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string pattern;
+    RuleInfo info;
+    if (!it.ReadString(&pattern) || !it.ReadString(&info.text) ||
+        !it.ReadString(&info.source)) {
+      return nullptr;
+    }
+    e.rules_by_pattern_.emplace(std::move(pattern), std::move(info));
+  }
+  if (!ReadStringMap(&it, &e.redirect_by_pattern_) ||
+      !ReadStringMap(&it, &e.csp_by_pattern_) ||
+      !ReadStringMap(&it, &e.method_by_pattern_)) {
+    return nullptr;
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    auto rule = std::make_unique<RegexRule>();
+    std::string pattern, proto_bytes;
+    int bucket = 0;
+    if (!it.ReadString(&pattern) || !it.ReadString(&proto_bytes) ||
+        !it.ReadBool(&rule->document_rule) || !it.ReadInt(&bucket) ||
+        !it.ReadString(&rule->redirect) || !it.ReadString(&rule->info.text) ||
+        !it.ReadString(&rule->info.source) ||
+        !rule->proto.ParseFromString(proto_bytes)) {
+      return nullptr;
+    }
+    rule->bucket = static_cast<Bucket>(bucket);
+    re2::RE2::Options opts;
+    opts.set_case_sensitive(rule->proto.match_case());
+    opts.set_log_errors(false);
+    rule->re = std::make_unique<re2::RE2>(pattern, opts);
+    if (!rule->re->ok()) {
+      return nullptr;
+    }
+    e.regex_patterns_.push_back(pattern);
+    e.regex_rules_.push_back(std::move(rule));
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  e.resources_.clear();
+  for (uint32_t i = 0; i < n; ++i) {
+    std::string name;
+    Resource res;
+    if (!it.ReadString(&name) || !it.ReadString(&res.mime) ||
+        !it.ReadString(&res.body)) {
+      return nullptr;
+    }
+    e.resources_[name] = std::move(res);
+  }
+  if (!ReadStrings(&it, &e.generic_selectors_) || !it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    CosmeticRule r;
+    if (!it.ReadString(&r.selector) || !ReadStrings(&it, &r.include) ||
+        !ReadStrings(&it, &r.exclude) || !it.ReadBool(&r.is_exception)) {
+      return nullptr;
+    }
+    e.conditional_rules_.push_back(std::move(r));
+  }
+  if (!it.ReadUInt32(&n)) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < n; ++i) {
+    ProceduralRule r;
+    if (!it.ReadString(&r.json) || !ReadStrings(&it, &r.include) ||
+        !ReadStrings(&it, &r.exclude)) {
+      return nullptr;
+    }
+    e.procedural_rules_.push_back(std::move(r));
+  }
+  e.BuildCosmeticTables();
+  return engine;
+}
+
+const Engine::RuleInfo* Engine::FindRuleInfo(
+    const std::string& url_pattern) const {
+  auto it = rules_by_pattern_.find(url_pattern);
+  return it == rules_by_pattern_.end() ? nullptr : &it->second;
+}
+
+// static
+bool Engine::DomainMatches(const std::string& host, const std::string& domain) {
+  if (host == domain) {
+    return true;
+  }
+  return host.size() > domain.size() &&
+         host.ends_with(domain) &&
+         host[host.size() - domain.size() - 1] == '.';
+}
+
+bool Engine::RegexRuleMatches(
+    const RegexRule& rule,
+    const GURL& url,
+    const url::Origin& initiator,
+    const subresource_filter::FirstPartyOrigin& first_party,
+    ElementType element_type,
+    bool is_document) const {
+  if (rule.document_rule != is_document) {
+    return false;
+  }
+  const auto& proto = rule.proto;
+  if (!is_document && !(proto.element_types() & element_type)) {
+    return false;
+  }
+  if (proto.source_type() == url_pattern_index::proto::SOURCE_TYPE_THIRD_PARTY &&
+      !first_party.IsThirdParty(url)) {
+    return false;
+  }
+  if (proto.source_type() == url_pattern_index::proto::SOURCE_TYPE_FIRST_PARTY &&
+      first_party.IsThirdParty(url)) {
+    return false;
+  }
+  if (proto.initiator_domains_size() > 0) {
+    const std::string host = initiator.host();
+    bool has_include = false;
+    bool included = false;
+    for (const auto& item : proto.initiator_domains()) {
+      const bool match = DomainMatches(host, item.domain());
+      if (item.exclude()) {
+        if (match) {
+          return false;
+        }
+      } else {
+        has_include = true;
+        included = included || match;
+      }
+    }
+    if (has_include && !included) {
+      return false;
+    }
+  }
+  return re2::RE2::PartialMatch(url.spec(), *rule.re);
+}
+
+void Engine::FillRedirect(
+    MatchResult* result,
+    const std::string& matched_pattern,
+    const GURL& url,
+    const subresource_filter::FirstPartyOrigin& first_party,
+    ElementType element_type) const {
+  std::string name;
+  auto it = redirect_by_pattern_.find(matched_pattern);
+  if (it != redirect_by_pattern_.end()) {
+    name = it->second;
+  } else if (redirect_rule_->matcher) {
+    const url_pattern_index::flat::UrlRule* rule =
+        redirect_rule_->matcher->MatchedUrlRule(url, first_party, element_type,
+                                                /*disable_generic_rules=*/false);
+    if (rule && !IsAllowlist(rule)) {
+      auto rr = redirect_by_pattern_.find(PatternOf(rule));
+      if (rr != redirect_by_pattern_.end()) {
+        name = rr->second;
+      }
+    }
+  }
+  if (name.empty()) {
+    return;
+  }
+  if (const Resource* res = FindResource(name)) {
+    result->redirect_resource = name;
+    result->rewritten_url = DataUrl(*res);
+  }
+}
+
+MatchResult Engine::Evaluate(const GURL& url,
+                             const url::Origin& initiator,
+                             ElementType element_type,
+                             bool is_document,
+                             const std::string& method) const {
+  MatchResult result;
+  if (!url.is_valid()) {
+    return result;
+  }
+  subresource_filter::FirstPartyOrigin first_party(initiator);
+  const url_pattern_index::flat::UrlRule* rule = nullptr;
+  std::string matched_pattern;
+  auto note_rule = [&](const url_pattern_index::flat::UrlRule* r,
+                       const RuleInfo* info_override) {
+    if (info_override) {
+      result.filter = info_override->text;
+      result.source = info_override->source;
+      return;
+    }
+    std::string pattern = PatternOf(r);
+    matched_pattern = pattern;
+    if (const RuleInfo* info = FindRuleInfo(pattern)) {
+      result.filter = info->text;
+      result.source = info->source;
+    } else {
+      result.filter = pattern;
+    }
+  };
+
+  // 1. $important rules: a block here wins over every exception.
+  const SideIndex* important =
+      is_document ? important_document_.get() : important_.get();
+  if (important->matcher) {
+    subresource_filter::LoadPolicy policy =
+        important->matcher->GetLoadPolicyForResourceLoad(
+            url, first_party, element_type, /*disable_generic_rules=*/false,
+            &rule);
+    if (policy == subresource_filter::LoadPolicy::DISALLOW) {
+      result.should_block = true;
+      result.has_filter = true;
+      note_rule(rule, nullptr);
+      FillRedirect(&result, matched_pattern, url, first_party, element_type);
+      return result;
+    }
+    if (policy == subresource_filter::LoadPolicy::EXPLICITLY_ALLOW) {
+      result.has_exception = true;
+      result.has_filter = rule != nullptr;
+      note_rule(rule, nullptr);
+      return result;
+    }
+  }
+  for (const auto& regex : regex_rules_) {
+    if (regex->bucket == Bucket::kImportant &&
+        RegexRuleMatches(*regex, url, initiator, first_party, element_type,
+                         is_document)) {
+      const bool allow = regex->proto.semantics() ==
+                         url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+      result.has_filter = true;
+      result.has_exception = allow;
+      result.should_block = !allow;
+      note_rule(nullptr, &regex->info);
+      if (!allow && !regex->redirect.empty()) {
+        if (const Resource* res = FindResource(regex->redirect)) {
+          result.redirect_resource = regex->redirect;
+          result.rewritten_url = DataUrl(*res);
+        }
+      }
+      return result;
+    }
+  }
+
+  // 2. Main index.
+  bool block_matched = false;
+  bool exception_matched = false;
+  const subresource_filter::IndexedRulesetMatcher* matcher =
+      is_document ? document_matcher_.get() : matcher_.get();
+  if (matcher) {
+    subresource_filter::LoadPolicy policy =
+        matcher->GetLoadPolicyForResourceLoad(url, first_party, element_type,
+                                              /*disable_generic_rules=*/false,
+                                              &rule);
+    if (policy == subresource_filter::LoadPolicy::DISALLOW) {
+      block_matched = true;
+      note_rule(rule, nullptr);
+    } else if (policy == subresource_filter::LoadPolicy::EXPLICITLY_ALLOW) {
+      exception_matched = true;
+      result.has_filter = rule != nullptr;
+      note_rule(rule, nullptr);
+    }
+  }
+
+  // 3. $method rules.
+  if (!method.empty() && method_->matcher) {
+    const url_pattern_index::flat::UrlRule* m = method_->matcher->MatchedUrlRule(
+        url, first_party, element_type, /*disable_generic_rules=*/false);
+    if (m) {
+      auto it = method_by_pattern_.find(PatternOf(m));
+      if (it != method_by_pattern_.end() &&
+          MethodMatches(it->second, method)) {
+        if (IsAllowlist(m)) {
+          exception_matched = true;
+        } else if (!block_matched) {
+          block_matched = true;
+          note_rule(m, nullptr);
+        }
+      }
+    }
+  }
+
+  // 4. Regex rules (main bucket).
+  for (const auto& regex : regex_rules_) {
+    if (regex->bucket != Bucket::kMain) {
+      continue;
+    }
+    if (!RegexRuleMatches(*regex, url, initiator, first_party, element_type,
+                          is_document)) {
+      continue;
+    }
+    const bool allow = regex->proto.semantics() ==
+                       url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+    if (allow) {
+      exception_matched = true;
+      result.has_filter = true;
+      note_rule(nullptr, &regex->info);
+    } else if (!block_matched) {
+      block_matched = true;
+      matched_pattern.clear();
+      note_rule(nullptr, &regex->info);
+      if (!regex->redirect.empty()) {
+        if (const Resource* res = FindResource(regex->redirect)) {
+          result.redirect_resource = regex->redirect;
+          result.rewritten_url = DataUrl(*res);
+        }
+      }
+    }
+  }
+
+  if (exception_matched) {
+    result.has_exception = true;
+    result.has_filter = result.has_filter || block_matched;
+    result.should_block = false;
+    result.redirect_resource.clear();
+    result.rewritten_url.clear();
+    return result;
+  }
+  if (block_matched) {
+    result.should_block = true;
+    result.has_filter = true;
+    if (result.redirect_resource.empty()) {
+      FillRedirect(&result, matched_pattern, url, first_party, element_type);
+    }
+  }
+  return result;
+}
+
+MatchResult Engine::EvaluatePopup(const GURL& url,
+                                  const url::Origin& opener) const {
+  MatchResult result;
+  if (!url.is_valid()) {
+    return result;
+  }
+  subresource_filter::FirstPartyOrigin first_party(opener);
+  if (popup_->matcher) {
+    const url_pattern_index::flat::UrlRule* rule = nullptr;
+    subresource_filter::LoadPolicy policy =
+        popup_->matcher->GetLoadPolicyForResourceLoad(
+            url, first_party, ElementType::ELEMENT_TYPE_SUBDOCUMENT,
+            /*disable_generic_rules=*/false, &rule);
+    if (rule) {
+      if (const RuleInfo* info = FindRuleInfo(PatternOf(rule))) {
+        result.filter = info->text;
+        result.source = info->source;
+      }
+    }
+    if (policy == subresource_filter::LoadPolicy::EXPLICITLY_ALLOW) {
+      result.has_exception = true;
+      result.has_filter = rule != nullptr;
+      return result;
+    }
+    if (policy == subresource_filter::LoadPolicy::DISALLOW) {
+      result.should_block = true;
+      result.has_filter = true;
+    }
+  }
+  for (const auto& regex : regex_rules_) {
+    if (regex->bucket != Bucket::kPopup ||
+        !RegexRuleMatches(*regex, url, opener, first_party,
+                          ElementType::ELEMENT_TYPE_SUBDOCUMENT,
+                          /*is_document=*/false)) {
+      continue;
+    }
+    const bool allow = regex->proto.semantics() ==
+                       url_pattern_index::proto::RULE_SEMANTICS_ALLOWLIST;
+    result.has_filter = true;
+    result.filter = regex->info.text;
+    result.source = regex->info.source;
+    if (allow) {
+      result.has_exception = true;
+      result.should_block = false;
+      return result;
+    }
+    result.should_block = true;
+  }
+  return result;
+}
+
+std::string Engine::CspForDocument(const GURL& url) const {
+  if (!url.is_valid() || !csp_->matcher) {
+    return std::string();
+  }
+  subresource_filter::FirstPartyOrigin first_party(url::Origin::Create(url));
+  const url_pattern_index::flat::UrlRule* rule = csp_->matcher->MatchedUrlRule(
+      url, first_party, ElementType::ELEMENT_TYPE_SUBDOCUMENT,
+      /*disable_generic_rules=*/false);
+  if (!rule || IsAllowlist(rule)) {
+    return std::string();
+  }
+  auto it = csp_by_pattern_.find(PatternOf(rule));
+  return it == csp_by_pattern_.end() ? std::string() : it->second;
+}
+
+// static
+bool Engine::CosmeticRuleApplies(const std::vector<std::string>& include,
+                                 const std::vector<std::string>& exclude,
+                                 const std::string& host) {
+  bool included = include.empty();
+  for (const std::string& d : include) {
+    if (DomainMatches(host, d)) {
+      included = true;
+      break;
+    }
+  }
+  if (!included) {
+    return false;
+  }
+  for (const std::string& d : exclude) {
+    if (DomainMatches(host, d)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void Engine::CollectSpecific(const std::string& host,
+                             std::vector<std::string>* selectors,
+                             base::flat_set<std::string>* exceptions) const {
+  for (const CosmeticRule& rule : conditional_rules_) {
+    if (!CosmeticRuleApplies(rule.include, rule.exclude, host)) {
+      continue;
+    }
+    if (rule.is_exception) {
+      exceptions->insert(rule.selector);
+    } else {
+      selectors->push_back(rule.selector);
+    }
+  }
+}
+
+bool Engine::ElemhideDisabled(const GURL& url) const {
+  return elemhide_->matcher &&
+         elemhide_->matcher->ShouldDisableFilteringForDocument(
+             url, url::Origin::Create(url),
+             url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT);
+}
+
+bool Engine::GenerichideDisabled(const GURL& url) const {
+  return generichide_->matcher &&
+         generichide_->matcher->ShouldDisableFilteringForDocument(
+             url, url::Origin::Create(url),
+             url_pattern_index::proto::ACTIVATION_TYPE_DOCUMENT);
+}
+
+std::string Engine::CosmeticResourcesJson(const GURL& url) const {
+  base::DictValue payload;
+  base::ListValue hide;
+  base::ListValue procedural;
+  bool generichide = true;
+  if (url.SchemeIsHTTPOrHTTPS() && !ElemhideDisabled(url)) {
+    generichide = GenerichideDisabled(url);
+    const std::string host(url.host());
+    std::vector<std::string> selectors;
+    base::flat_set<std::string> exceptions;
+    CollectSpecific(host, &selectors, &exceptions);
+    base::flat_set<std::string> seen;
+    for (const std::string& s : selectors) {
+      if (!exceptions.contains(s) && seen.insert(s).second) {
+        hide.Append(s);
+      }
+    }
+    if (!generichide) {
+      for (const std::string& s : generic_misc_) {
+        if (!exceptions.contains(s) && seen.insert(s).second) {
+          hide.Append(s);
+        }
+      }
+    }
+    for (const ProceduralRule& rule : procedural_rules_) {
+      if (CosmeticRuleApplies(rule.include, rule.exclude, host)) {
+        procedural.Append(rule.json);
+      }
+    }
+  }
+  payload.Set("hideSelectors", std::move(hide));
+  payload.Set("proceduralActions", std::move(procedural));
+  payload.Set("generichide", generichide);
+  std::string json;
+  base::JSONWriter::Write(payload, &json);
+  return json;
+}
+
+std::vector<std::string> Engine::HiddenClassIdSelectors(
+    const GURL& url,
+    const std::vector<std::string>& classes,
+    const std::vector<std::string>& ids) const {
+  std::vector<std::string> out;
+  if (!url.SchemeIsHTTPOrHTTPS() || ElemhideDisabled(url) ||
+      GenerichideDisabled(url)) {
+    return out;
+  }
+  std::vector<std::string> unused;
+  base::flat_set<std::string> exceptions;
+  CollectSpecific(std::string(url.host()), &unused, &exceptions);
+  base::flat_set<std::string> seen;
+  auto add = [&](const std::unordered_map<std::string, std::vector<std::string>>&
+                     table,
+                 const std::string& key) {
+    auto it = table.find(key);
+    if (it == table.end()) {
+      return;
+    }
+    for (const std::string& s : it->second) {
+      if (!exceptions.contains(s) && seen.insert(s).second) {
+        out.push_back(s);
+      }
+    }
+  };
+  for (const std::string& c : classes) {
+    add(generic_by_class_, c);
+  }
+  for (const std::string& i : ids) {
+    add(generic_by_id_, i);
+  }
+  return out;
+}
+
+std::string Engine::HidingStylesheet(const GURL& url) const {
+  if (!url.SchemeIsHTTPOrHTTPS() || ElemhideDisabled(url)) {
+    return std::string();
+  }
+  const bool generic_disabled = GenerichideDisabled(url);
+  const std::string host(url.host());
+  std::vector<std::string> selectors;
+  base::flat_set<std::string> exceptions;
+  CollectSpecific(host, &selectors, &exceptions);
+  std::string css;
+  if (!generic_disabled && !generic_stylesheet_.empty()) {
+    if (exceptions.empty()) {
+      css = generic_stylesheet_;
+    } else {
+      std::vector<std::string> generic;
+      for (const std::string& s : generic_selectors_) {
+        if (!exceptions.contains(s)) {
+          generic.push_back(s);
+        }
+      }
+      if (!generic.empty()) {
+        css = base::JoinString(generic, ",\n") + "{display:none!important;}\n";
+      }
+    }
+  }
+  if (!selectors.empty()) {
+    std::vector<std::string> kept;
+    for (const std::string& s : selectors) {
+      if (!exceptions.contains(s)) {
+        kept.push_back(s);
+      }
+    }
+    if (!kept.empty()) {
+      css += base::JoinString(kept, ",\n") + "{display:none!important;}\n";
+    }
+  }
+  return css;
+}
+
+}  // namespace aside_adblock
