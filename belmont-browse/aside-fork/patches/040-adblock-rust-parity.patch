+#include "chrome/browser/profiles/aside_account_password_gate_factory.h"
+
+#include "chrome/browser/profiles/aside_account_password_gate.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/extension_registry_factory.h"
+
+// static
+AsideAccountPasswordGate* AsideAccountPasswordGateFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<AsideAccountPasswordGate*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+AsideAccountPasswordGateFactory* AsideAccountPasswordGateFactory::GetInstance() {
+  static base::NoDestructor<AsideAccountPasswordGateFactory> instance;
+  return instance.get();
+}
+
+AsideAccountPasswordGateFactory::AsideAccountPasswordGateFactory()
+    : ProfileKeyedServiceFactory(
+          "AsideAccountPasswordGate",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .WithSystem(ProfileSelection::kNone)
+              .Build()) {
+  DependsOn(extensions::ExtensionRegistryFactory::GetInstance());
+}
+
+AsideAccountPasswordGateFactory::~AsideAccountPasswordGateFactory() = default;
+
+std::unique_ptr<KeyedService>
+AsideAccountPasswordGateFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<AsideAccountPasswordGate>(
+      Profile::FromBrowserContext(context));
+}
+
+bool AsideAccountPasswordGateFactory::ServiceIsCreatedWithBrowserContext()
+    const {
+  return true;
+}
