@@ -0,0 +1,432 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// The original's cosmetic filter script, byte-for-byte as embedded in the
+// shipped binary (14,719 bytes at 0xc79e54b of the arm64 slice). "$1" at the
+// end is replaced with the payload JSON by AsideAdBlockRenderFrameObserver.
+
+#ifndef CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_SCRIPT_H_
+#define CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_SCRIPT_H_
+
+#include <string_view>
+
+namespace aside_adblock {
+
+inline constexpr std::string_view kCosmeticScript = R"ASIDEJS(
+(function(payload) {
+  'use strict';
+  const W = globalThis;
+  const D = document;
+  const MAX_CANDIDATES = 5000;
+  const ALLOWED_OPERATORS = new Set([
+    'css-selector', 'has-text', 'matches-attr', 'matches-css',
+    'matches-css-before', 'matches-css-after', 'matches-path',
+    'min-text-length', 'upward', 'xpath'
+  ]);
+  const ALLOWED_ACTIONS = new Set([
+    'remove', 'style', 'remove-attr', 'remove-class'
+  ]);
+
+  if (W.__asideAdBlock && W.__asideAdBlock.document === D) {
+    W.__asideAdBlock.setGenerichide(!!payload.generichide);
+    W.__asideAdBlock.addHideSelectors(payload.hideSelectors || []);
+    W.__asideAdBlock.addProceduralActions(payload.proceduralActions || []);
+    W.__asideAdBlock.recollect();
+    return;
+  }
+
+  const state = {
+    document: D,
+    active: true,
+    documentObserver: null,
+    mutationObserver: null,
+    pendingClasses: new Set(),
+    pendingIds: new Set(),
+    proceduralRules: [],
+    scheduled: false,
+    timerId: 0,
+    standardSelectors: new Set(),
+    standardSheet: new CSSStyleSheet(),
+    generichide: !!payload.generichide,
+  };
+
+  function boundedRegex(text) {
+    if (typeof text !== 'string' || text.length > 1024 || text[0] !== '/') {
+      return null;
+    }
+    const last = text.lastIndexOf('/');
+    if (last <= 0) return null;
+    const flags = text.slice(last + 1);
+    if (/[^imsu]/.test(flags)) return null;
+    try { return new RegExp(text.slice(1, last), flags); } catch (_) { return null; }
+  }
+
+  function matchesText(rule, value, exact) {
+    if (typeof rule !== 'string') return false;
+    const regex = boundedRegex(rule);
+    if (regex) return regex.test(value);
+    if (rule === '') return value.trim() === '';
+    return exact ? value === rule : value.includes(rule);
+  }
+
+  function unquote(value) {
+    if (value.length >= 2 && value[0] === '"' && value.at(-1) === '"') {
+      return value.slice(1, -1);
+    }
+    return value;
+  }
+
+  function splitKeyValue(value) {
+    let quoted = false;
+    for (let i = 0; i < value.length; ++i) {
+      if (value[i] === '"') quoted = !quoted;
+      if (!quoted && value[i] === '=') {
+        return [unquote(value.slice(0, i)), unquote(value.slice(i + 1))];
+      }
+    }
+    return [unquote(value), undefined];
+  }
+
+  function asElement(node) { return node instanceof HTMLElement ? node : null; }
+
+  function cssStep(arg, element) {
+    if (typeof arg !== 'string') return [];
+    const trimmed = arg.trimStart();
+    try {
+      if (trimmed.startsWith('+')) {
+        const next = element.nextElementSibling;
+        return next && next.matches(trimmed.slice(1).trimStart()) ? [next] : [];
+      }
+      if (trimmed.startsWith('~')) {
+        const selector = trimmed.slice(1).trimStart();
+        const output = [];
+        for (let next = element.nextElementSibling; next; next = next.nextElementSibling) {
+          if (next.matches(selector)) output.push(next);
+          if (output.length >= MAX_CANDIDATES) break;
+        }
+        return output;
+      }
+      if (trimmed.startsWith('>')) {
+        const selector = trimmed.slice(1).trimStart();
+        return Array.from(element.children).filter((x) => x.matches(selector)).slice(0, MAX_CANDIDATES);
+      }
+      if (arg[0] && /\s/.test(arg[0])) {
+        return Array.from(element.querySelectorAll(':scope ' + trimmed)).slice(0, MAX_CANDIDATES);
+      }
+      return element.matches(arg) ? [element] : [];
+    } catch (_) { return []; }
+  }
+
+  function xpath(arg, root) {
+    if (typeof arg !== 'string' || arg.length > 2048) return [];
+    const output = [];
+    try {
+      const result = D.evaluate(arg, root, null, XPathResult.UNORDERED_NODE_ITERATOR_TYPE, null);
+      for (let node = result.iterateNext(); node && output.length < MAX_CANDIDATES;
+           node = result.iterateNext()) {
+        const element = asElement(node);
+        if (element) output.push(element);
+      }
+    } catch (_) {}
+    return output;
+  }
+
+  function applyOperator(operator, element) {
+    const arg = operator.arg;
+    try {
+      switch (operator.type) {
+        case 'css-selector': return cssStep(arg, element);
+        case 'has-text': return matchesText(arg, element.innerText || '', false) ? [element] : [];
+        case 'matches-attr': {
+          const [key, value] = splitKeyValue(arg);
+          for (const name of element.getAttributeNames()) {
+            if (!matchesText(key, name, true)) continue;
+            const attr = element.getAttribute(name);
+            if (attr !== null && (value === undefined || matchesText(value, attr, true))) return [element];
+          }
+          return [];
+        }
+        case 'matches-css':
+        case 'matches-css-before':
+        case 'matches-css-after': {
+          const separator = arg.indexOf(':');
+          if (separator <= 0) return [];
+          const property = arg.slice(0, separator).trim();
+          const expected = arg.slice(separator + 1).trim();
+          const pseudo = operator.type === 'matches-css-before' ? '::before' :
+                         operator.type === 'matches-css-after' ? '::after' : null;
+          const actual = getComputedStyle(element, pseudo).getPropertyValue(property);
+          return matchesText(expected, actual, true) ? [element] : [];
+        }
+        case 'matches-path': {
+          const path = location.pathname + location.search;
+          return matchesText(arg, path, false) ? [element] : [];
+        }
+        case 'min-text-length': {
+          const minimum = Number(arg);
+          return Number.isFinite(minimum) && minimum >= 0 &&
+                 (element.innerText || '').trim().length >= minimum ? [element] : [];
+        }
+        case 'upward': {
+          const count = Number(arg);
+          if (Number.isInteger(count)) {
+            if (count < 1 || count >= 256) return [];
+            let current = element;
+            for (let i = 0; i < count && current; ++i) current = current.parentElement;
+            return current ? [current] : [];
+          }
+          if (typeof arg !== 'string') return [];
+          for (let current = element; current; current = current.parentElement) {
+            if (current.matches(arg)) return [current];
+          }
+          return [];
+        }
+        case 'xpath': return xpath(arg, element);
+      }
+    } catch (_) {}
+    return [];
+  }
+
+  function candidatesFor(rule) {
+    const first = rule.selector[0];
+    try {
+      if (first.type === 'css-selector') {
+        return [1, Array.from(D.querySelectorAll(first.arg)).slice(0, MAX_CANDIDATES)];
+      }
+      if (first.type === 'xpath') return [1, xpath(first.arg, D.documentElement)];
+      return [0, Array.from(D.querySelectorAll('*')).slice(0, MAX_CANDIDATES)];
+    } catch (_) { return [rule.selector.length, []]; }
+  }
+
+  function applyRule(rule) {
+    let [index, candidates] = candidatesFor(rule);
+    for (; index < rule.selector.length && candidates.length; ++index) {
+      const next = [];
+      for (const element of candidates) {
+        for (const match of applyOperator(rule.selector[index], element)) {
+          next.push(match);
+          if (next.length >= MAX_CANDIDATES) break;
+        }
+        if (next.length >= MAX_CANDIDATES) break;
+      }
+      candidates = Array.from(new Set(next));
+    }
+    for (const element of candidates) {
+      if (element === D.documentElement || element === D.head ||
+          element === D.body) continue;
+      const action = rule.action;
+      if (!action) {
+        element.style.setProperty('display', 'none', 'important');
+      } else if (action.type === 'remove') {
+        element.remove();
+      } else if (action.type === 'style' && typeof action.arg === 'string') {
+        element.style.cssText += ';' + action.arg;
+      } else if (action.type === 'remove-attr' && typeof action.arg === 'string') {
+        element.removeAttribute(action.arg);
+      } else if (action.type === 'remove-class' && typeof action.arg === 'string') {
+        element.classList.remove(action.arg);
+      }
+    }
+  }
+
+  function parseRule(raw) {
+    if (typeof raw !== 'string' || raw.length > 65536) return null;
+    try {
+      const rule = JSON.parse(raw);
+      if (!rule || !Array.isArray(rule.selector) || !rule.selector.length ||
+          rule.selector.length > 32) return null;
+      for (const operator of rule.selector) {
+        if (!operator || !ALLOWED_OPERATORS.has(operator.type) ||
+            typeof operator.arg !== 'string' || operator.arg.length > 8192) return null;
+      }
+      if (rule.action && (!ALLOWED_ACTIONS.has(rule.action.type) ||
+          (rule.action.arg !== undefined && typeof rule.action.arg !== 'string'))) return null;
+      return rule;
+    } catch (_) { return null; }
+  }
+
+  function runProcedural() {
+    state.scheduled = false;
+    state.timerId = 0;
+    if (!state.active) return;
+    for (const rule of state.proceduralRules) applyRule(rule);
+    reviewStandardSelectors();
+  }
+
+  function scheduleProcedural() {
+    if (!state.active || state.scheduled) return;
+    state.scheduled = true;
+    state.timerId = setTimeout(runProcedural, 50);
+  }
+
+  function sameSite(url) {
+    try {
+      const target = new URL(url, D.baseURI);
+      if (!/^https?:$/.test(target.protocol)) return false;
+      const a = target.hostname.toLowerCase();
+      const b = location.hostname.toLowerCase();
+      if (a === b || a.endsWith('.' + b) || b.endsWith('.' + a)) return true;
+      const ap = a.split('.');
+      const bp = b.split('.');
+      return ap.length >= 2 && bp.length >= 2 &&
+             ap.slice(-2).join('.') === bp.slice(-2).join('.');
+    } catch (_) { return false; }
+  }
+
+  function containsFirstPartyUrl(element) {
+    const nodes = [element, ...Array.from(element.querySelectorAll('[src],[href],[poster],[data],[srcset]')).slice(0, 100)];
+    for (const node of nodes) {
+      for (const name of ['src', 'href', 'poster', 'data']) {
+        const value = node.getAttribute && node.getAttribute(name);
+        if (value && sameSite(value)) return true;
+      }
+      const srcset = node.getAttribute && node.getAttribute('srcset');
+      if (srcset && srcset.split(',').some((part) => sameSite(part.trim().split(/\s+/)[0]))) return true;
+    }
+    return false;
+  }
+
+  function rebuildStandardSheet() {
+    let css = '';
+    for (const selector of state.standardSelectors) css += selector + '{display:none!important;}';
+    try { state.standardSheet.replaceSync(css); } catch (_) {}
+    if (!D.adoptedStyleSheets.includes(state.standardSheet)) {
+      D.adoptedStyleSheets = [state.standardSheet, ...D.adoptedStyleSheets];
+    }
+  }
+
+  function reviewStandardSelectors() {
+    let changed = false;
+    for (const selector of Array.from(state.standardSelectors)) {
+      try {
+        const matches = Array.from(D.querySelectorAll(selector)).slice(0, 100);
+        if (matches.some(containsFirstPartyUrl)) {
+          state.standardSelectors.delete(selector);
+          changed = true;
+        }
+      } catch (_) {
+        state.standardSelectors.delete(selector);
+        changed = true;
+      }
+    }
+    if (changed) rebuildStandardSheet();
+  }
+
+  function addHideSelectors(selectors) {
+    let changed = false;
+    for (const selector of selectors || []) {
+      if (typeof selector === 'string' && selector.length <= 8192 &&
+          state.standardSelectors.size < 50000 && !state.standardSelectors.has(selector)) {
+        state.standardSelectors.add(selector);
+        changed = true;
+      }
+    }
+    if (changed) rebuildStandardSheet();
+    scheduleProcedural();
+  }
+
+  function addProceduralActions(actions) {
+    for (const raw of actions || []) {
+      const rule = parseRule(raw);
+      if (rule) state.proceduralRules.push(rule);
+      if (state.proceduralRules.length >= 4096) break;
+    }
+    scheduleProcedural();
+  }
+
+  function collect(element) {
+    if (!(element instanceof Element) || state.generichide) return;
+    if (element.id && state.pendingIds.size < 4096) state.pendingIds.add(element.id);
+    for (const name of element.classList || []) {
+      if (name && state.pendingClasses.size < 4096) state.pendingClasses.add(name);
+    }
+  }
+
+  function collectTree(root) {
+    collect(root);
+    if (!root.querySelectorAll) return;
+    for (const element of Array.from(root.querySelectorAll('[id],[class]')).slice(0, 10000)) collect(element);
+  }
+
+  function takePending() {
+    if (!state.pendingClasses.size && !state.pendingIds.size) return '';
+    const value = JSON.stringify({
+      classes: Array.from(state.pendingClasses), ids: Array.from(state.pendingIds)
+    });
+    state.pendingClasses.clear();
+    state.pendingIds.clear();
+    return value;
+  }
+
+  state.addHideSelectors = addHideSelectors;
+  state.addProceduralActions = addProceduralActions;
+  state.scheduleProcedural = scheduleProcedural;
+  state.takePending = takePending;
+  state.setGenerichide = (generichide) => {
+    state.generichide = !!generichide;
+    if (state.generichide) {
+      state.pendingClasses.clear();
+      state.pendingIds.clear();
+    }
+  };
+  state.recollect = () => {
+    if (!state.generichide && D.documentElement) collectTree(D.documentElement);
+  };
+  state.suspend = () => {
+    state.active = false;
+    if (state.timerId) clearTimeout(state.timerId);
+    state.timerId = 0;
+    state.scheduled = false;
+    state.documentObserver?.disconnect();
+    state.mutationObserver?.disconnect();
+  };
+  state.resume = () => {
+    if (state.active) return;
+    state.active = true;
+    observeDocumentElement();
+    scheduleProcedural();
+  };
+  W.__asideAdBlock = state;
+
+  function observeDocumentElement() {
+    if (!D.documentElement) return false;
+    collectTree(D.documentElement);
+    state.mutationObserver?.disconnect();
+    state.mutationObserver = new MutationObserver((mutations) => {
+      for (const mutation of mutations) {
+        if (mutation.type === 'attributes') collect(mutation.target);
+        for (const node of mutation.addedNodes || []) collectTree(node);
+      }
+      scheduleProcedural();
+    });
+    state.mutationObserver.observe(D.documentElement, {
+      subtree: true, childList: true, attributes: true,
+      attributeFilter: ['id', 'class']
+    });
+    return true;
+  }
+
+  if (!observeDocumentElement()) {
+    state.documentObserver = new MutationObserver(() => {
+      if (!observeDocumentElement()) return;
+      state.documentObserver?.disconnect();
+      state.documentObserver = null;
+      scheduleProcedural();
+    });
+    state.documentObserver.observe(D, {subtree: true, childList: true});
+  }
+
+  W.addEventListener('pagehide', state.suspend);
+  W.addEventListener('pageshow', (event) => {
+    if (event.persisted) state.resume();
+  });
+
+  addHideSelectors(payload.hideSelectors || []);
+  addProceduralActions(payload.proceduralActions || []);
+})($1);
+)ASIDEJS";
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_SCRIPT_H_
