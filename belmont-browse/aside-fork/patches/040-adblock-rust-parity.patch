+MiniPopupService::MiniPopupService(Profile* profile) : profile_(profile) {
+  // Registers the global shortcut from Local State (once, browser-wide).
+  MiniPopupShortcut::GetInstance()->Apply();
+}
+
+MiniPopupService::~MiniPopupService() = default;
+
+// static
+MiniPopupService* MiniPopupService::Get(
+    content::BrowserContext* browser_context) {
+  return MiniPopupServiceFactory::GetForBrowserContext(browser_context);
+}
+
+const Extension* MiniPopupService::AsideExtension() const {
+  ExtensionRegistry* registry = ExtensionRegistry::Get(profile_);
+  return registry ? registry->GetExtensionById(kAsideExtensionId,
+                                               ExtensionRegistry::ENABLED)
+                  : nullptr;
+}
+
+bool MiniPopupService::EnsureWindow(const Extension& extension) {
+  if (widget_) {
+    return true;
+  }
+  // Find a browser window on this profile to host + parent the popup.
+  BrowserWindowInterface* browser = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* candidate) {
+        if (candidate->GetProfile() == profile_) {
+          browser = candidate;
+          return false;  // stop iterating
+        }
+        return true;
+      });
+  if (!browser) {
+    return false;
+  }
+
+  const GURL url = extension.GetResourceURL("minipopup.html");
+  std::unique_ptr<ExtensionViewHost> host =
+      ExtensionViewHostFactory::CreatePopupHost(extension, url, browser);
+  if (!host) {
+    return false;
+  }
+
+  auto view = std::make_unique<MiniPopupView>(profile_, std::move(host));
+  view_ = view.get();
+  auto delegate = std::make_unique<MiniPopupWidgetDelegate>(std::move(view));
+
+  widget_ = std::make_unique<views::Widget>();
+  widget_->Init(FramelessFloatingParams(
+      delegate.get(), browser->GetWindow()->GetNativeWindow(),
+      gfx::Rect(0, 0, 420, 220), "AsideMiniPopup"));
+  delegate_ = std::move(delegate);
+  widget_->CenterWindow(gfx::Size(420, 220));
+  widget_->Show();
+  if (view_ && view_->host()) {
+    view_->host()->host_contents()->Focus();
+  }
+  return true;
+}
+
+void MiniPopupService::ResizeTo(int width, int height) {
+  if (widget_) {
+    widget_->SetSize(gfx::Size(width, height));
+  }
+}
+
+void MiniPopupService::SetState(const Extension& extension,
+                                const std::string& state) {
+  if (!EnsureWindow(extension)) {
+    return;
+  }
+  const gfx::Size size = SizeForState(state);
+  ResizeTo(size.width(), size.height());
+}
+
+void MiniPopupService::SetSize(const Extension& extension,
+                               int width,
+                               int height) {
+  if (!EnsureWindow(extension)) {
+    return;
+  }
+  ResizeTo(width, height);
+}
+
+void MiniPopupService::Hide() {
+  CloseOptionsWindow();
+  if (widget_) {
+    widget_->Hide();
+  }
+}
+
+bool MiniPopupService::IsShowing() const {
+  return widget_ && widget_->IsVisible();
+}
+
+void MiniPopupService::ToggleFromShortcut() {
+  if (IsShowing()) {
+    Hide();
+    return;
+  }
+  const Extension* extension = AsideExtension();
+  if (!extension || !EnsureWindow(*extension)) {
+    VLOG(1) << "AsideMiniPopup: shortcut pressed but no window";
+    return;
+  }
+  widget_->Show();
+  widget_->Activate();
+  if (view_ && view_->host()) {
+    view_->host()->host_contents()->Focus();
+  }
+}
+
+// ---- options window ---------------------------------------------------------
+
+// static
+bool MiniPopupService::MaybeOpenOptionsWindow(
+    std::unique_ptr<content::WebContents>& contents,
+    const GURL& target_url,
+    const blink::mojom::WindowFeatures& window_features) {
+  if (!contents || !window_features.is_popup) {
+    return false;
+  }
+  content::RenderFrameHost* opener = contents->GetOpener();
+  if (!opener) {
+    return false;
+  }
+  MiniPopupService* service = Get(contents->GetBrowserContext());
+  if (!service || !service->view_ || !service->view_->host()) {
+    return false;
+  }
+  content::WebContents* popup = service->view_->host()->host_contents();
+  if (!popup || popup->GetPrimaryMainFrame() != opener) {
+    return false;
+  }
+  service->OpenOptionsWindow(std::move(contents), target_url, window_features);
+  return true;
+}
+
+void MiniPopupService::OpenOptionsWindow(
+    std::unique_ptr<content::WebContents> contents,
+    const GURL& target_url,
+    const blink::mojom::WindowFeatures& window_features) {
+  CloseOptionsWindow();
+  options_contents_ = std::move(contents);
+  options_contents_->SetDelegate(this);
+  ChromeExtensionWebContentsObserver::CreateForWebContents(
+      options_contents_.get());
+  // ApplyTransparentWebContentsBackground: the page is data-theme=transparent.
+  options_contents_->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+
+  // The extension passes the geometry in the URL query
+  // (minipopup-options.html?left=&top=&width=&height=), computed from the
+  // popup's screen position; window features only carry popup=yes.
+  gfx::Rect bounds = window_features.bounds;
+  bool has_x = window_features.has_x;
+  bool has_y = window_features.has_y;
+  bool has_width = window_features.has_width;
+  bool has_height = window_features.has_height;
+  if (target_url.has_query()) {
+    for (std::string_view piece :
+         base::SplitStringPiece(target_url.query(), "&",
+                                base::TRIM_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      const size_t eq = piece.find('=');
+      if (eq == std::string_view::npos) {
+        continue;
+      }
+      int value = 0;
+      if (!base::StringToInt(piece.substr(eq + 1), &value)) {
+        continue;
+      }
+      const std::string_view key = piece.substr(0, eq);
+      if (key == "left") {
+        bounds.set_x(value);
+        has_x = true;
+      } else if (key == "top") {
+        bounds.set_y(value);
+        has_y = true;
+      } else if (key == "width") {
+        bounds.set_width(value);
+        has_width = true;
+      } else if (key == "height") {
+        bounds.set_height(value);
+        has_height = true;
+      }
+    }
+  }
+  if (!has_width || bounds.width() <= 0) {
+    bounds.set_width(kDefaultOptionsWidth);
+  }
+  if (!has_height || bounds.height() <= 0) {
+    bounds.set_height(kDefaultOptionsHeight);
+  }
+  if (!has_x || !has_y) {
+    gfx::Rect popup_bounds = widget_->GetWindowBoundsInScreen();
+    bounds.set_origin(gfx::Point(popup_bounds.x(),
+                                 popup_bounds.bottom() + 8));
+  }
+
+  auto web_view = std::make_unique<views::WebView>(profile_);
+  web_view->SetWebContents(options_contents_.get());
+  auto delegate = std::make_unique<MiniPopupWidgetDelegate>(std::move(web_view));
+  options_widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params = FramelessFloatingParams(
+      delegate.get(), widget_->GetNativeWindow(), bounds,
+      "AsideMiniPopupOptions");
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  options_widget_->Init(std::move(params));
+  options_delegate_ = std::move(delegate);
+  options_widget_->Show();
+  options_widget_->Activate();  // ActivateOptionsWindow
+  options_contents_->Focus();
+  VLOG(1) << "AsideMiniPopup: options window " << bounds.ToString();
+}
+
+void MiniPopupService::SetOptionWindowSize(int width, int height) {
+  if (!options_widget_) {
+    return;
+  }
+  gfx::Rect bounds = options_widget_->GetWindowBoundsInScreen();
+  bounds.set_size(gfx::Size(width, height));
+  options_widget_->SetBounds(bounds);
+}
+
+void MiniPopupService::CloseOptionsWindow() {
+  if (options_contents_) {
+    options_contents_->SetDelegate(nullptr);
+  }
+  options_widget_.reset();
+  options_delegate_.reset();
+  options_contents_.reset();
+}
+
+void MiniPopupService::CloseOptionsWindowAndRestoreFocus() {
+  CloseOptionsWindow();
+  if (widget_ && widget_->IsVisible()) {
+    widget_->Activate();
+    if (view_ && view_->host()) {
+      view_->host()->host_contents()->Focus();
+    }
+  }
+}
+
+void MiniPopupService::CloseContents(content::WebContents* source) {
+  if (source != options_contents_.get()) {
+    return;
+  }
+  // window.close() from the page: tear down outside the caller's stack.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&MiniPopupService::CloseOptionsWindowAndRestoreFocus,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void MiniPopupService::SetContentsBounds(content::WebContents* source,
+                                         const gfx::Rect& bounds) {
+  if (source == options_contents_.get() && options_widget_) {
+    options_widget_->SetBounds(bounds);
+  }
+}
+
+void MiniPopupService::ActivateContents(content::WebContents* contents) {
+  if (contents == options_contents_.get() && options_widget_) {
+    options_widget_->Activate();
+  }
+}
+
+void MiniPopupService::Shutdown() {
+  CloseOptionsWindow();
+  view_ = nullptr;
+  widget_.reset();
+  delegate_.reset();
+}
