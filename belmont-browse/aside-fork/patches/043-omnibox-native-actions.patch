+
+// Never apply an action or a keyword to a different result that arrived while
+// the extension was displaying an older list.
+const AutocompleteMatch* MatchFromRequest(AsideOmniboxSession* session,
+                                          const base::DictValue& request) {
+  return FindAsideOmniboxMatch(session->result(), request,
+                               session->result_sequence_id());
+}
+
+std::string ExecuteActionRequest(AsideOmniboxSession* session,
+                                const base::DictValue& request,
+                                WindowOpenDisposition disposition) {
+  const auto* match = MatchFromRequest(session, request);
+  const auto index = request.FindInt("actionIndex");
+  if (!match || !index || *index < 0 ||
+      static_cast<size_t>(*index) >= match->actions.size()) {
+    return "Invalid or stale autocomplete action";
+  }
+  auto* tab = session->target()
+      ? tabs::TabInterface::MaybeGetFromContents(session->target()) : nullptr;
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  auto* location_bar = browser ? browser->GetFeatures().location_bar() : nullptr;
+  auto* controller = location_bar ? location_bar->GetOmniboxController() : nullptr;
+  if (!controller || browser->GetTabStripModel()->GetActiveWebContents() !=
+                         session->target()) {
+    return "Target tab is not active or omnibox actions are unavailable";
+  }
+  return session->ExecuteAction(*request.FindInt("line"), *index, disposition,
+                                controller->client())
+      ? std::string() : "Omnibox action is unavailable";
 }
 
