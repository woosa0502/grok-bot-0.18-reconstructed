+bool OpenUrl(AsideOmniboxSession* session, const GURL& url,
+             WindowOpenDisposition disposition) {
+  if (!url.is_valid() || !session->target()) {
+    return false;
+  }
+  session->target()->OpenURL(
+      content::OpenURLParams(url, content::Referrer(), disposition,
+                             ui::PAGE_TRANSITION_GENERATED, false),
+      /*navigation_handle_callback=*/{});
+  return true;
