+namespace {
+using aside_adblock::Engine;
+using aside_adblock::FilterSource;
+using url_pattern_index::proto::ELEMENT_TYPE_SCRIPT;
+int failures = 0;
+int assertions = 0;
+
+void Expect(bool condition, const char* name) {
+  ++assertions;
+  std::cout << (condition ? "PASS " : "FAIL ") << name << '\n';
+  if (!condition) {
+    ++failures;
+  }
+}
+
+scoped_refptr<Engine> Build(const std::string& text) {
+  auto engine = Engine::Build({{"custom", "test", text}});
+  Expect(engine->parse_error_count() == 0, "fixture parses without ignored rules");
+  return engine;
+}
+
+aside_adblock::MatchResult Request(const Engine& engine,
+                                  const char* url,
+                                  const char* origin,
+                                  const char* method = "GET") {
+  return engine.Evaluate(GURL(url), url::Origin::Create(GURL(origin)),
+                         ELEMENT_TYPE_SCRIPT, false, method);
+}
+
+size_t ProceduralCount(const Engine& engine, const char* url) {
+  auto value = base::JSONReader::Read(engine.CosmeticResourcesJson(GURL(url)),
+                                     base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return 99999;
+  }
+  const auto* actions = value->GetDict().FindList("proceduralActions");
+  return actions ? actions->size() : 99999;
+}
+
+void CheckSemantics(const Engine& engine) {
+  // Identical URL pattern and different document domains: metadata must stay
+  // attached to the rule which actually matched, regardless of input order.
+  Expect(engine.CspForDocument(GURL("https://a.test/page")) ==
+             "img-src 'none',script-src 'none'",
+         "CSP merges all matching policies and preserves domain identity");
+  Expect(engine.CspForDocument(GURL("https://b.test/page")) ==
+             "connect-src 'none'", "CSP does not borrow another domain policy");
+  Expect(engine.CspForDocument(GURL("https://c.test/page")).empty(),
+         "unrelated domain receives no CSP");
+  Expect(engine.CspForDocument(GURL("https://a.test/exempt-script")) ==
+             "img-src 'none'", "CSP exact exception removes only its policy");
+  Expect(engine.CspForDocument(GURL("https://a.test/exempt-all")).empty(),
+         "bare CSP exception suppresses all matching policies");
+
+  Expect(Request(engine, "https://tracker.test/api", "https://a.test", "POST")
+             .should_block, "POST rule survives same-pattern GET rule");
+  Expect(!Request(engine, "https://tracker.test/api", "https://a.test", "GET")
+              .should_block, "GET cannot borrow POST domain metadata");
+  Expect(Request(engine, "https://tracker.test/api", "https://b.test", "GET")
+             .should_block, "GET rule matches its own domain");
+  Expect(!Request(engine, "https://tracker.test/api", "https://b.test", "POST")
+              .should_block, "POST cannot borrow GET domain metadata");
+  Expect(!Request(engine, "https://tracker.test/api", "https://a.test", "HEAD")
+              .should_block, "unlisted HTTP method remains allowed");
+  Expect(!Request(engine, "https://tracker.test/exempt", "https://a.test", "POST")
+              .should_block, "method-scoped exception suppresses its method");
+  Expect(Request(engine, "https://tracker.test/important", "https://a.test", "POST")
+             .should_block, "important method block wins over ordinary exception");
+  Expect(!Request(engine, "https://tracker.test/important", "https://a.test", "GET")
+              .should_block, "important method retains the HTTP condition");
+
+  auto redirect_a = Request(engine, "https://ads.test/shared.js", "https://a.test");
+  auto redirect_b = Request(engine, "https://ads.test/shared.js", "https://b.test");
+  Expect(redirect_a.should_block && redirect_a.redirect_resource == "noop.js",
+         "redirect retains complete domain-qualified identity");
+  Expect(redirect_b.should_block && redirect_b.redirect_resource == "noop.json",
+         "second same-pattern redirect retains its own resource");
+  Expect(Request(engine, "https://ads.test/priority.js", "https://a.test")
+             .redirect_resource == "noop.json",
+         "highest signed redirect priority wins across all matching rules");
+  Expect(Request(engine, "https://ads.test/negative.js", "https://a.test")
+             .redirect_resource == "noop.js", "negative redirect priorities compare as signed integers");
+  Expect(Request(engine, "https://ads.test/exception.js", "https://a.test")
+             .redirect_resource == "noop.js", "redirect-rule exception cancels exact high-priority directive");
+  Expect(!Request(engine, "https://alone.test/rule.js", "https://a.test", "POST")
+              .should_block, "redirect-rule plus method never creates a blocking rule");
+  Expect(Request(engine, "https://ads.test/method.js", "https://a.test", "POST")
+             .redirect_resource == "noop.js", "method-qualified redirect matches POST");
+  Expect(Request(engine, "https://ads.test/method.js", "https://a.test", "GET")
+             .redirect_resource.empty(), "method-qualified redirect cannot leak to GET");
+  Expect(Request(engine, "https://ads.test/missing.js", "https://a.test")
+             .redirect_resource.empty(), "missing highest-priority resource is not silently noop");
+  Expect(ProceduralCount(engine, "https://a.test/") == 0,
+         "domain-scoped procedural exception removes normalized action");
+  Expect(ProceduralCount(engine, "https://b.test/") == 1,
+         "procedural exception does not remove another domain action");
+}
+
+void CheckCosmeticDomainExclusions() {
+  const auto engine = Build(R"RULES(
+example.test,~private.example.test##.advert
+~excluded.test##.generic-excluded
+example.test,~private.example.test#?#.procedural:has-text(Sponsored)
+example.test,~private.example.test#@#.global-exception
+##.global-exception
+@@||no-generic.test^$generichide
+)RULES");
+  auto check = [&](const Engine& candidate) {
+    const std::string included = candidate.HidingStylesheet(GURL("https://example.test/"));
+    const std::string excluded = candidate.HidingStylesheet(GURL("https://private.example.test/"));
+    Expect(included.find(".advert") != std::string::npos,
+           "mixed cosmetic domain rule hides on included domain");
+    Expect(excluded.find(".advert") == std::string::npos,
+           "mixed cosmetic domain rule preserves excluded subdomain");
+    Expect(candidate.HidingStylesheet(GURL("https://unrelated.test/")).find(".advert") == std::string::npos,
+           "mixed cosmetic domain rule does not affect unrelated host");
+    Expect(candidate.HidingStylesheet(GURL("https://example.test/")).find(".generic-excluded") != std::string::npos &&
+               candidate.HidingStylesheet(GURL("https://excluded.test/")).find(".generic-excluded") == std::string::npos,
+           "negative-only cosmetic domain prefix applies everywhere except exclusion");
+    Expect(candidate.HidingStylesheet(GURL("https://no-generic.test/")).find(".generic-excluded") == std::string::npos,
+           "generichide also disables negative-only generic selectors");
+    Expect(included.find(".global-exception") == std::string::npos &&
+               excluded.find(".global-exception") != std::string::npos,
+           "cosmetic exceptions preserve their own excluded domains");
+    Expect(ProceduralCount(candidate, "https://example.test/") == 1 &&
+               ProceduralCount(candidate, "https://private.example.test/") == 0,
+           "procedural rules support positive domains plus excluded subdomains");
+  };
+  check(*engine);
+  auto restored = Engine::Deserialize(engine->Serialize("cosmetic-domains"), {});
+  Expect(!!restored, "cosmetic domain exclusions survive cache load");
+  if (restored) {
+    check(*restored);
+  }
+}
+
+void CheckBadfilterAndRedirectExceptions() {
+  // Separate source files deliberately put cancellation before the target and
+  // reorder options/domains, as actual subscriptions do.
+  const std::vector<FilterSource> sources{
+      {"custom", "cancellations", R"RULES(
+||cancel.test^$badfilter,domain=b.test|a.test,script
+@@||restore.test^$badfilter,script
+||method.test^$badfilter,script,method=post
+||redirect.test^$redirect=noop.js,badfilter,script
+)RULES"},
+      {"manual:targets", "targets", R"RULES(
+||cancel.test^$script,domain=a.test|b.test
+||cancel.test^$image,domain=a.test
+||cancel.test^$script,domain=c.test
+||restore.test^$script
+@@||restore.test^$script
+||remain.test^$script
+||method.test^$method=post,script
+||method.test^$method=get,script
+||redirect.test^$script
+||redirect.test^$script,redirect=noop.js
+||allow-redirect.test^$script
+||allow-redirect.test^$redirect-rule=noop.js:1
+||allow-redirect.test^$redirect-rule=noop.json:8
+@@||allow-redirect.test^$redirect-rule=noop.json:8,domain=a.test
+||method-allow.test^$script
+@@||method-allow.test^$redirect-rule=noop.js,method=post
+)RULES"}};
+  auto engine = Engine::Build(sources);
+  auto check = [&](const Engine& candidate) {
+    Expect(candidate.parse_error_count() == 0, "badfilter is accepted without parse errors");
+    Expect(!Request(candidate, "https://cancel.test/asset", "https://a.test").should_block,
+           "badfilter before target cancels reordered options and domains across sources");
+    Expect(Request(candidate, "https://cancel.test/asset", "https://c.test").should_block,
+           "badfilter preserves different-domain control");
+    Expect(candidate.Evaluate(GURL("https://cancel.test/asset"),
+                             url::Origin::Create(GURL("https://a.test")),
+                             url_pattern_index::proto::ELEMENT_TYPE_IMAGE, false, "GET")
+               .should_block, "badfilter preserves different-type control");
+    Expect(Request(candidate, "https://restore.test/asset", "https://a.test").should_block,
+           "badfilter of exception restores its blocking rule");
+    Expect(Request(candidate, "https://remain.test/asset", "https://a.test").should_block,
+           "badfilter leaves unrelated blocking rule intact");
+    Expect(!Request(candidate, "https://method.test/asset", "https://a.test", "POST").should_block,
+           "badfilter cancels full method-qualified rule identity");
+    Expect(Request(candidate, "https://method.test/asset", "https://a.test", "GET").should_block,
+           "badfilter preserves another method on the same pattern");
+    const auto redirect = Request(candidate, "https://redirect.test/asset", "https://a.test");
+    Expect(redirect.should_block && redirect.redirect_resource.empty(),
+           "badfilter cancels redirect modifier without canceling a plain block");
+    Expect(!Request(candidate, "https://allow-redirect.test/asset", "https://a.test").should_block,
+           "redirect-rule exception allows a non-important block per reference engine");
+    Expect(Request(candidate, "https://allow-redirect.test/asset", "https://b.test").should_block,
+           "redirect exception retains its domain boundary");
+    Expect(!Request(candidate, "https://method-allow.test/asset", "https://a.test", "POST").should_block,
+           "method-qualified redirect exception permits its HTTP method");
+    Expect(Request(candidate, "https://method-allow.test/asset", "https://a.test", "GET").should_block,
+           "method-qualified redirect exception does not permit other methods");
+  };
+  check(*engine);
+  auto restored = Engine::Deserialize(engine->Serialize(Engine::SourceDigest(sources, "")), {});
+  Expect(!!restored, "badfilter-effective indexes survive cache load");
+  if (restored) {
+    check(*restored);
+  }
+}
+
+void CheckReadiness() {
+  using Gate = aside_adblock::PendingCosmeticRequest;
+  Gate request;
+  std::vector<std::string> replies;
+  std::vector<bool> settlements;
+  auto callback = [&]() {
+    return base::BindOnce(
+        [](std::vector<std::string>* out, std::vector<bool>* states,
+           bool settled, const std::string& payload) {
+          out->push_back(payload);
+          states->push_back(settled);
+        }, &replies, &settlements);
+  };
+  Expect(Gate::Readiness(true, false, false, false, true, false) == Gate::State::kLoading,
+         "startup waits for subscription metadata as well as engine creation");
+  Expect(Gate::Readiness(true, true, true, true, true, false) == Gate::State::kLoading,
+         "first compiled empty engine cannot bypass initial downloads in flight");
+  Expect(Gate::Readiness(true, true, true, false, false, false) == Gate::State::kLoading,
+         "download completion still waits for compile of the latest inputs");
+  Expect(Gate::Readiness(true, true, true, false, true, false) == Gate::State::kReady,
+         "settled downloads plus current engine release document readiness");
+  Expect(Gate::Readiness(true, true, false, false, false, true) == Gate::State::kFailed,
+         "terminal compile failure resolves distinctly from an engine still loading");
+  Expect(Gate::Readiness(false, true, true, true, false, false) == Gate::State::kDisabled,
+         "profile disabling overrides pending downloads and compilation");
+  const uint64_t cold = request.Begin(
+      Gate::Readiness(true, true, true, true, true, false), "empty-engine", callback());
+  Expect(cold != 0 && replies.empty(),
+         "empty initial compile keeps the actual request callback pending");
+  const auto full_state = Gate::Readiness(true, true, true, false, true, false);
+  Expect(full_state == Gate::State::kReady && request.Complete(cold, "downloaded-rules") &&
+             replies.back() == "downloaded-rules",
+         "initial download then current compile delivers real rules to queued document");
+  replies.clear();
+  const uint64_t first =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(first != 0 && replies.empty(),
+         "enabled loading engine defers its document response");
+  Expect(request.Complete(first, "late-rules") && replies.size() == 1 &&
+             replies.back() == "late-rules",
+         "delayed engine readiness delivers the original pending response");
+  Expect(!request.Complete(first, "duplicate"),
+         "readiness completion is delivered at most once");
+
+  const uint64_t old_document =
+      request.Begin(Gate::State::kLoading, "", callback());
+  request.Cancel();  // production navigation IPC path
+  Expect(!request.IsPending(old_document) && replies.back().empty(),
+         "navigation cancels old-document readiness and completes its callback");
+  const uint64_t new_document =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(!request.Complete(old_document, "old-document-rules") &&
+             request.IsPending(new_document),
+         "old readiness event cannot complete a new document request");
+  Expect(request.Complete(new_document, "new-document-rules") &&
+             replies.back() == "new-document-rules",
+         "new document receives only its own readiness result");
+
+  const auto before_disabled = replies.size();
+  Expect(request.Begin(Gate::State::kDisabled, "must-not-inject", callback()) == 0 &&
+             replies.size() == before_disabled + 1 && replies.back().empty(),
+         "disabled profile resolves immediately without startup waiting");
+  const auto before_ready = replies.size();
+  Expect(request.Begin(Gate::State::kReady, "no-rules-payload", callback()) == 0 &&
+             replies.size() == before_ready + 1 &&
+             replies.back() == "no-rules-payload",
+         "ready no-rules engine is distinct from enabled-but-loading");
+  const uint64_t deadline =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(request.Complete(deadline, "", false) && !request.IsPending(deadline) &&
+             !settlements.back(),
+         "bounded readiness deadline releases the pending callback");
+  Expect(!request.Complete(deadline, "too-late"),
+         "engine event after timeout cannot inject stale payload");
+  aside_adblock::CosmeticReadinessRetryBudget budget;
+  Expect(budget.TryStart(), "document starts its first bounded readiness wait");
+  const uint64_t slow = request.Begin(Gate::State::kLoading, "", callback());
+  request.Complete(slow, "", false);  //30-second host deadline, download continues
+  Expect(!settlements.back() && budget.CanRetry() && budget.TryStart(),
+         "not-ready deadline permits re-request without marking document applied");
+  const uint64_t later = request.Begin(Gate::State::kLoading, "", callback());
+  Expect(request.Complete(later, "rules-after-35-seconds") && settlements.back() &&
+             replies.back() == "rules-after-35-seconds",
+         "valid first download after initial deadline still supplies document rules");
+  int remaining = 0;
+  while (budget.TryStart()) {
+    ++remaining;
+  }
+  Expect(remaining == 4 && !budget.CanRetry(),
+         "unresolved readiness attempts have a finite per-document budget");
+  budget.Reset();
+  Expect(budget.TryStart(), "navigation grants a fresh readiness budget");
+  request.Begin(Gate::State::kDisabled, "", callback());
+  Expect(settlements.back(), "disabled final-empty result never schedules readiness retry");
+  const uint64_t disable_while_loading =
+      request.Begin(Gate::State::kLoading, "", callback());
+  Expect(request.Complete(disable_while_loading, "") && replies.back().empty(),
+         "disabling during startup resolves the waiting document without injection");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(argc, argv);
+  CheckReadiness();
+  CheckBadfilterAndRedirectExceptions();
+  CheckCosmeticDomainExclusions();
+  const std::string rules = R"RULES(
+*$csp=script-src 'none',domain=a.test
+*$csp=connect-src 'none',domain=b.test
+*$csp=img-src 'none',domain=a.test
+@@/exempt-script$csp=script-src 'none',domain=a.test
+@@/exempt-all$csp,domain=a.test
+||tracker.test/api$method=post,domain=a.test
+||tracker.test/api$method=get,domain=b.test
+||tracker.test/exempt$method=post,domain=a.test
+@@||tracker.test/exempt$method=post,domain=a.test
+||tracker.test/important$method=post,important,domain=a.test
+@@||tracker.test/important$domain=a.test
+||ads.test/shared.js$script,redirect=noop.js,domain=a.test
+||ads.test/shared.js$script,redirect=noop.json,domain=b.test
+||ads.test/priority.js$script
+||ads.test/priority.js$redirect-rule=noop.js:-4
+||ads.test/priority.js$redirect-rule=noop.json:12
+||ads.test/negative.js$script
+||ads.test/negative.js$redirect-rule=noop.js:-1
+||ads.test/negative.js$redirect-rule=noop.json:-9
+||ads.test/exception.js$important,script
+||ads.test/exception.js$redirect-rule=noop.js:1
+||ads.test/exception.js$redirect-rule=noop.json:9
+@@||ads.test/exception.js$redirect-rule=noop.json:9
+||alone.test/rule.js$redirect-rule=noop.js,method=post
+||ads.test/method.js$script
+||ads.test/method.js$method=post,redirect-rule=noop.js
+||ads.test/missing.js$script
+||ads.test/missing.js$redirect-rule=noop.js:1
+||ads.test/missing.js$redirect-rule=unknown-surrogate.js:10
+a.test,b.test#?#.promo:has-text(Sponsored)
+a.test#@?#.promo:has-text(Sponsored)
+)RULES";
+  auto engine = Build(rules);
+  CheckSemantics(*engine);
+  const auto* chartbeat = engine->FindResource("chartbeat.js");
+  Expect(chartbeat && chartbeat->body.find("pSUPERFLY") != std::string::npos,
+         "Chartbeat surrogate provides its public API");
+  const auto* gtm = engine->FindResource("googletagmanager_gtm.js");
+  Expect(gtm && gtm->body.size() > 1000,
+         "Google Tag Manager alias resolves to real analytics surrogate");
+  const auto* mp3 = engine->FindResource("noopmp3-0.1s");
+  Expect(mp3 && !mp3->body.empty(), "audio redirect contains playable bytes");
+  Expect(!engine->FindResource("unimplemented-surrogate.js"),
+         "unknown JavaScript surrogate remains explicitly unavailable");
+
+  const std::vector<FilterSource> sources{{"custom", "test", rules}};
+  std::string serialized = engine->Serialize(Engine::SourceDigest(sources, ""));
+  auto restored = Engine::Deserialize(serialized, {});
+  Expect(!!restored, "versioned metadata and cosmetic exception cache loads");
+  if (restored) {
+    CheckSemantics(*restored);
+    Expect(restored->FindResource("chartbeat.js") &&
+               restored->FindResource("chartbeat.js")->body == chartbeat->body,
+           "bundled surrogate body survives cache roundtrip");
+    auto twice = Engine::Deserialize(restored->Serialize("roundtrip"), {});
+    Expect(!!twice, "deserialized engine serializes again without lost indexes");
+    if (twice) {
+      CheckSemantics(*twice);
+    }
+  }
+  serialized.back() ^= 1;
+  Expect(!Engine::Deserialize(serialized, {}), "damaged cache payload is rejected");
+  std::cout << "SUMMARY " << assertions - failures << '/' << assertions
+            << " assertions passed\n";
+  return failures ? 1 : 0;
+}
