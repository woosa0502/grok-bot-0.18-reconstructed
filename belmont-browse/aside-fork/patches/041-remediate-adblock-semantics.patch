new file mode 100644
index 0000000..60d54b9
--- /dev/null
+++ b/chrome/browser/aside_adblock/resources/generate_redirect_resources.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Regenerate the pinned uBO redirect resource header; no network access."""
+import base64
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+root = Path(__file__).resolve().parent
+manifest = json.loads((root / 'ubol/manifest.json').read_text())
+mimes = {'.js': 'application/javascript', '.html': 'text/html', '.css': 'text/css',
+         '.txt': 'text/plain', '.json': 'application/json', '.xml': 'text/xml',
+         '.gif': 'image/gif', '.png': 'image/png', '.mp3': 'audio/mpeg', '.mp4': 'video/mp4'}
+resources = []
+for item in manifest['resources']:
+    source = root / 'ubol' / item['name']
+    body = source.read_bytes()
+    if hashlib.sha256(body).hexdigest() != item['sha256']:
+        raise SystemExit(f'Resource differs from pinned manifest: {item["name"]}')
+    resources.append({'name': item['name'], 'aliases': item['aliases'],
+                      'kind': {'mime': mimes.get(source.suffix, 'text/plain')},
+                      'content': base64.b64encode(body).decode('ascii')})
+payload = json.dumps(resources, separators=(',', ':'))
+header = '''// Generated from resources/ubol; see its manifest.json and LICENSE.txt.
+// uBlock Origin redirect resource bodies: Copyright Raymond Hill and contributors.
+// Resource bodies are GPL-3.0-or-later, with original source and notices preserved.
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_REDIRECT_RESOURCES_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_REDIRECT_RESOURCES_H_
+#include <string_view>
+namespace aside_adblock {
+inline constexpr std::string_view kBundledRedirectResourcesJson = R"ASIDERES(''' + payload + ''')ASIDERES";
+}  // namespace aside_adblock
+#endif
+'''
+target = root.parent / 'aside_adblock_redirect_resources.h'
+if '--check' in sys.argv:
+    if not target.exists() or target.read_text() != header:
+        raise SystemExit('Generated redirect resource header is out of date')
+elif not target.exists() or target.read_text() != header:
+    target.write_text(header)
+print(f'Generated {len(resources)} pinned redirect resources')
