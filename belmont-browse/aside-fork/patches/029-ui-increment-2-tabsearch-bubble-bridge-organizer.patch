+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_TAB_SEARCH_BUBBLE_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_TAB_SEARCH_BUBBLE_H_
