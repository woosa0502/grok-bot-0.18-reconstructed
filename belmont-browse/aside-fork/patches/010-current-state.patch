+ExtensionFunction::ResponseAction AsideBrowserPreferencesGetBrowserColorSchemeFunction::Run() {
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  std::string scheme = "system";
+  if (ThemeService* theme = ThemeServiceFactory::GetForProfile(profile)) {
+    switch (theme->GetBrowserColorScheme()) {
+      case ThemeService::BrowserColorScheme::kLight: scheme = "light"; break;
+      case ThemeService::BrowserColorScheme::kDark: scheme = "dark"; break;
+      case ThemeService::BrowserColorScheme::kSystem: scheme = "system"; break;
+    }
+  }
+  return RespondNow(WithArguments(scheme));
+}
+
+ExtensionFunction::ResponseAction AsideBrowserPreferencesSetBrowserColorSchemeFunction::Run() {
+  std::optional<api::aside_browser_preferences::SetBrowserColorScheme::Params> params =
+      api::aside_browser_preferences::SetBrowserColorScheme::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  if (ThemeService* theme = ThemeServiceFactory::GetForProfile(profile)) {
+    ThemeService::BrowserColorScheme value =
+        ThemeService::BrowserColorScheme::kSystem;
+    if (params->color_scheme == "light")
+      value = ThemeService::BrowserColorScheme::kLight;
+    else if (params->color_scheme == "dark")
+      value = ThemeService::BrowserColorScheme::kDark;
+    theme->SetBrowserColorScheme(value);
+  }
+  return RespondNow(NoArguments());
+}
