+void SearchboxPageMirror::AutocompleteResultChanged(
+    const searchbox::mojom::AutocompleteResultPtr& result) {
+  if (pages_.empty() || !result) {
+    return;
+  }
+  for (const auto& page : pages_) {
+    page->AutocompleteResultChanged(result->Clone());
+  }
+}
+
+void SearchboxPageMirror::SetInputText(const std::string& input) {
+  for (const auto& page : pages_) {
+    page->SetInputText(input);
+  }
+}
