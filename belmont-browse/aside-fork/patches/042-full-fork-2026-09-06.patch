+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_NAVIGATION_THROTTLE_H_
+
+#include "content/public/browser/navigation_throttle.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}
+
+namespace aside_adblock {
+
+// Blocks navigations matched by $document rules (top-level) and by sub-frame
+// rules, rendering the "Page blocked by Aside" page with "Go back" and
+// "Continue once" actions like the original AsideAdBlockNavigationThrottle.
+class AsideAdBlockNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit AsideAdBlockNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~AsideAdBlockNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult Check();
+
+  // Set once the user chose "Continue once" for this navigation so redirects
+  // (e.g. the https upgrade) of the same navigation pass as well.
+  bool allow_once_ = false;
+};
+
+}  // namespace aside_adblock
