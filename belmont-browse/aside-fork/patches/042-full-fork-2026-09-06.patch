+}
+
+void AsideOmniboxSearchboxPage::SetAimButtonVisible(bool visible) {
+  base::DictValue details;
+  details.Set("visible", visible);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAimButtonVisibilityChanged",
