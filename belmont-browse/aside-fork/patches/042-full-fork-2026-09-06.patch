+}
+
+PendingCosmeticRequest::State AsideAdBlockService::CosmeticReadiness() const {
+  return PendingCosmeticRequest::Readiness(
+      enabled(), loaded_, !!engine_, !initial_downloads_pending_.empty(),
+      active_generation_ == requested_generation_,
+      !last_compile_error_.empty() && !compiling_ && !compile_pending_);
+}
+
+MatchResult AsideAdBlockService::Evaluate(
+    const GURL& url,
+    const url::Origin& initiator,
+    url_pattern_index::proto::ElementType element_type,
+    bool is_document,
+    const std::string& method) const {
+  if (!engine_ || !enabled()) {
+    return MatchResult();
+  }
+  return engine_->Evaluate(url, initiator, element_type, is_document, method);
+}
+
+MatchResult AsideAdBlockService::EvaluatePopup(
+    const GURL& url,
+    const url::Origin& opener) const {
+  if (!engine_ || !enabled()) {
+    return MatchResult();
+  }
