+namespace extensions {
+
+void ShowAsideThemeInstallBlockedDialog(content::WebContents* web_contents,
+                                        base::OnceClosure done_callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  // The original hard-codes these three strings (they are not in the .pak).
+  ui::DialogModel::Builder dialog_builder;
+  dialog_builder.SetTitle(u"Theme installation failed")
+      .AddParagraph(
+          ui::DialogModelLabel(u"Aside browser does not support themes."))
+      .AddOkButton(base::DoNothing(),
+                   ui::DialogModel::Button::Params().SetLabel(u"OK"))
+      .SetDialogDestroyingCallback(std::move(done_callback));
+
+  chrome::ShowTabModal(dialog_builder.Build(), web_contents);
+}
