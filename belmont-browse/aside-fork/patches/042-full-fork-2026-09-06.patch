diff --git a/chrome/browser/ui/views/frame/aside_bookmark_tab_representation.cc b/chrome/browser/ui/views/frame/aside_bookmark_tab_representation.cc
new file mode 100644
index 0000000000..38f77a1a1c
--- /dev/null
+++ b/chrome/browser/ui/views/frame/aside_bookmark_tab_representation.cc
@@ -0,0 +1,129 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/aside_bookmark_tab_representation.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+AsideBookmarkTabRepresentation::AsideBookmarkTabRepresentation(Browser* browser)
+    : browser_(browser) {
+  model_ = BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  if (model_) {
+    model_->AddObserver(this);
+  }
+  browser_->tab_strip_model()->AddObserver(this);
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
+
+AsideBookmarkTabRepresentation::~AsideBookmarkTabRepresentation() {
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+  if (browser_) {
+    browser_->tab_strip_model()->RemoveObserver(this);
+  }
+}
+
+void AsideBookmarkTabRepresentation::
+    ScheduleRefreshTabsRepresentedByBookmarks() {
+  if (refresh_scheduled_) {
+    return;
+  }
+  refresh_scheduled_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &AsideBookmarkTabRepresentation::RefreshTabsRepresentedByBookmarks,
+          weak_factory_.GetWeakPtr()));
+}
+
+void AsideBookmarkTabRepresentation::RefreshTabsRepresentedByBookmarks() {
+  refresh_scheduled_ = false;
+  std::map<int64_t, Representation> next;
+  if (model_ && model_->loaded() && browser_) {
+    TabStripModel* tab_strip_model = browser_->tab_strip_model();
+    for (int i = 0; i < tab_strip_model->count(); ++i) {
+      content::WebContents* contents = tab_strip_model->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      const GURL url = contents->GetLastCommittedURL();
+      if (!url.is_valid() || url.is_empty()) {
+        continue;
+      }
+      for (const bookmarks::BookmarkNode* node : model_->GetNodesByURL(url)) {
+        if (!node) {
+          continue;
+        }
+        // The first tab wins, so a bookmark represents the left-most tab that
+        // is showing it.
+        next.emplace(node->id(),
+                     Representation{node->id(), std::string(url.host()), i});
+      }
+    }
+  }
+  if (next == representations_) {
+    return;
+  }
+  representations_ = std::move(next);
+  changed_callbacks_.Notify();
+}
+
+std::optional<AsideBookmarkTabRepresentation::Representation>
+AsideBookmarkTabRepresentation::RepresentationForNode(int64_t node_id) const {
+  auto it = representations_.find(node_id);
+  if (it == representations_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+bool AsideBookmarkTabRepresentation::IsNodeRepresentingOpenTab(
+    int64_t node_id) const {
+  return representations_.contains(node_id);
+}
+
+base::CallbackListSubscription
+AsideBookmarkTabRepresentation::AddChangedCallback(
+    base::RepeatingClosure callback) {
+  return changed_callbacks_.Add(std::move(callback));
+}
+
+void AsideBookmarkTabRepresentation::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
+
+void AsideBookmarkTabRepresentation::OnTabChangedAt(
+    tabs::TabInterface* tab,
+    int index,
+    TabChangeType change_type) {
+  if (change_type == TabChangeType::kAll) {
+    ScheduleRefreshTabsRepresentedByBookmarks();
+  }
+}
+
+void AsideBookmarkTabRepresentation::BookmarkModelChanged() {
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
+
+void AsideBookmarkTabRepresentation::BookmarkModelLoaded(bool ids_reassigned) {
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
diff --git a/chrome/browser/ui/views/frame/aside_bookmark_tab_representation.h b/chrome/browser/ui/views/frame/aside_bookmark_tab_representation.h
new file mode 100644
index 0000000000..e4e9dd6982
--- /dev/null
+++ b/chrome/browser/ui/views/frame/aside_bookmark_tab_representation.h
@@ -0,0 +1,102 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_BOOKMARK_TAB_REPRESENTATION_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_BOOKMARK_TAB_REPRESENTATION_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/bookmarks/browser/base_bookmark_model_observer.h"
+
+class Browser;
+
+namespace bookmarks {
+class BookmarkModel;
+}
+
+namespace tabs {
+class TabInterface;
+}
+
+// Aside marks a bookmark that points at an open tab, so the bookmarks section
+// of the vertical tab strip can show it as standing in for that tab.  The
+// original records the pairing on the tab's entry under two names,
+// "bookmark_tab_representation_node_id" and
+// "bookmark_tab_representation_host", and recomputes the whole mapping from a
+// coalesced task named ScheduleRefreshTabsRepresentedByBookmarks
+// (vertical_tab_strip_region_view.cc:10515 in Aside 1.0.825.1; RE @0x4cb0e10 —
+// a bool guard at +0x1119 plus one PostTask, and the two key literals at
+// 0xe1a8be0 / 0xe1a8c10 used from @0x4cd6c9f and @0x4cd6ce9).
+//
+// Deviation from the original, recorded on purpose: the original writes the
+// pair into Aside's per-profile tab-entry store (the same store that holds
+// "pinned_tab_entry_url"), which is daemon-backed and outside this fork.  This
+// class keeps the same two fields in memory and hands them to the views that
+// need them.
+class AsideBookmarkTabRepresentation
+    : public TabStripModelObserver,
+      public bookmarks::BaseBookmarkModelObserver {
+ public:
+  // The original's field names.
+  static constexpr char kNodeIdKey[] = "bookmark_tab_representation_node_id";
+  static constexpr char kHostKey[] = "bookmark_tab_representation_host";
+
+  // What the original stores per represented tab.
+  struct Representation {
+    int64_t node_id = 0;
+    std::string host;
+    int tab_index = -1;
+
+    friend bool operator==(const Representation&,
+                           const Representation&) = default;
+  };
+
+  explicit AsideBookmarkTabRepresentation(Browser* browser);
+  AsideBookmarkTabRepresentation(const AsideBookmarkTabRepresentation&) =
+      delete;
+  AsideBookmarkTabRepresentation& operator=(
+      const AsideBookmarkTabRepresentation&) = delete;
+  ~AsideBookmarkTabRepresentation() override;
+
+  // Coalesces to one task per message loop turn, like the original's bool
+  // guard.
+  void ScheduleRefreshTabsRepresentedByBookmarks();
+
+  std::optional<Representation> RepresentationForNode(int64_t node_id) const;
+  bool IsNodeRepresentingOpenTab(int64_t node_id) const;
+
+  base::CallbackListSubscription AddChangedCallback(
+      base::RepeatingClosure callback);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      int index,
+                      TabChangeType change_type) override;
+
+  // bookmarks::BaseBookmarkModelObserver:
+  void BookmarkModelChanged() override;
+  void BookmarkModelLoaded(bool ids_reassigned) override;
+
+ private:
+  void RefreshTabsRepresentedByBookmarks();
+
+  raw_ptr<Browser> browser_;
+  raw_ptr<bookmarks::BookmarkModel> model_ = nullptr;
+  // Bookmark node id -> the open tab it represents.
+  std::map<int64_t, Representation> representations_;
+  bool refresh_scheduled_ = false;
+  base::RepeatingClosureList changed_callbacks_;
+  base::WeakPtrFactory<AsideBookmarkTabRepresentation> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_BOOKMARK_TAB_REPRESENTATION_H_
