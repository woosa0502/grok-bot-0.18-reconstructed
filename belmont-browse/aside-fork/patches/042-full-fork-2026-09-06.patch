+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_ASIDE_ACCOUNT_ASIDE_PROFILE_INDEX_H_
+#define CHROME_BROWSER_EXTENSIONS_API_ASIDE_ACCOUNT_ASIDE_PROFILE_INDEX_H_
+
+#include <vector>
+
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+
+namespace extensions::aside_account {
+
+// profileIndex belongs to this API enumeration, never the drag-reorderable
+// profile menu. All index producers and consumers must use the same ordering.
+inline std::vector<ProfileAttributesEntry*> GetProfilesInApiOrder(
+    ProfileAttributesStorage& storage) {
+  return storage.GetAllProfilesAttributes();
+}
+
+inline ProfileAttributesEntry* ResolveProfileIndex(
+    ProfileAttributesStorage& storage, int index) {
+  const auto entries = GetProfilesInApiOrder(storage);
+  return index >= 0 && static_cast<size_t>(index) < entries.size()
+             ? entries[index]
+             : nullptr;
+}
+
+}  // namespace extensions::aside_account
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_ASIDE_ACCOUNT_ASIDE_PROFILE_INDEX_H_
