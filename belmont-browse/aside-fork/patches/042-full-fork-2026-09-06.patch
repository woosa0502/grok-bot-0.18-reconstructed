+#ifndef CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_UPDATE_SERVICE_H_
+#define CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_UPDATE_SERVICE_H_
+
+#include <map>
