+TEST_F(AsideProfileIndexTest, ReorderingDisplayCannotChangeApiIdentity) {
+  auto* storage = profiles_.profile_attributes_storage();
+  for (const char* name : {"first", "second"}) {
+    ProfileAttributesInitParams params;
+    params.profile_path = profiles_.profile_manager()->user_data_dir().AppendASCII(name);
+    params.profile_name = name == std::string("first") ? u"Zulu" : u"Alpha";
+    storage->AddProfile(std::move(params));
+  }
+  const auto api_entries = extensions::aside_account::GetProfilesInApiOrder(*storage);
+  ASSERT_EQ(2u, api_entries.size());
+  const auto first_path = api_entries[0]->GetPath();
+  const auto second_path = api_entries[1]->GetPath();
+  const auto initial_display = storage->GetAllProfilesAttributesSortedForDisplay();
+  const auto old_first = initial_display[0]->GetPath();
+  storage->UpdateProfilesOrderPref(0, 1);
+  EXPECT_NE(old_first, storage->GetAllProfilesAttributesSortedForDisplay()[0]->GetPath());
+  EXPECT_EQ(first_path, extensions::aside_account::ResolveProfileIndex(*storage, 0)->GetPath());
+  EXPECT_EQ(second_path, extensions::aside_account::ResolveProfileIndex(*storage, 1)->GetPath());
+  EXPECT_EQ(nullptr, extensions::aside_account::ResolveProfileIndex(*storage, -1));
+  EXPECT_EQ(nullptr, extensions::aside_account::ResolveProfileIndex(*storage, 2));
