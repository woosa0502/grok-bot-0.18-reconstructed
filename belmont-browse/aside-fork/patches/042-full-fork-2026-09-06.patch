+//
+// Aside refuses theme installs from the Chrome Web Store. Replica of the
+// original's helper in
+// chrome/browser/extensions/api/webstore_private/webstore_private_api.cc
+// (825.1 framework region 0x07f8e140-0x07f90d30): the tail call at the top of
+// WebstorePrivateBeginInstallWithManifest3Function::ShowInstallDialog() when
+// dummy_extension_->manifest()->type() == Manifest::TYPE_THEME builds a
+// ui::DialogModel with the __ustring literals "Theme installation failed" and
+// "Aside browser does not support themes." plus an "OK" button, shows it with
+// chrome::ShowTabModal(), and answers the API from the dialog-destroying
+// callback.
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
