+ExtensionFunction::ResponseAction AsideOmniboxOnNavigationLikelyFunction::Run() {
+  std::optional<api::aside_omnibox::OnNavigationLikely::Params> params =
+      api::aside_omnibox::OnNavigationLikely::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArguments));
+  }
+  std::string error;
+  AsideOmniboxSession* session = FindSession(this, params->session_id, &error);
+  if (!session) {
+    return RespondNow(Error(error));
+  }
+  // RE 0x405d580 (arm64): {line, url, navigationPredictor}, where
+  // navigationPredictor is the string form of omnibox.mojom's enum -
+  // "mouseDown" / "upOrDownArrowButton" / "touchDown" - and the body then
+  // makes the same call SearchboxHandler::OnNavigationLikely makes.
+  const base::DictValue& request = params->request.additional_properties;
+  const auto* match = MatchFromRequest(session, request);
+  const std::optional<int> line = request.FindInt("line");
+  if (!match || !line || *line < 0) {
+    return RespondNow(Error("Invalid or stale autocomplete match"));
+  }
+  omnibox::mojom::NavigationPredictor predictor =
+      omnibox::mojom::NavigationPredictor::kMouseDown;
+  if (const std::string* name = request.FindString("navigationPredictor")) {
+    if (*name == "upOrDownArrowButton") {
+      predictor = omnibox::mojom::NavigationPredictor::kUpOrDownArrowButton;
+    } else if (*name == "touchDown") {
+      predictor = omnibox::mojom::NavigationPredictor::kTouchDown;
+    } else if (!name->empty() && *name != "mouseDown") {
+      return RespondNow(Error("Invalid navigationPredictor"));
+    }
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  content::WebContents* target = session->target();
+  if (auto* prefetch = SearchPrefetchServiceFactory::GetForProfile(profile)) {
+    prefetch->OnNavigationLikely(static_cast<size_t>(*line), *match, predictor,
+                                 target);
+  }
+  if (auto* preload = SearchPreloadServiceFactory::GetForProfile(profile)) {
+    preload->OnNavigationLikely(static_cast<size_t>(*line), *match, predictor,
+                                target);
+  }
+  return RespondNow(NoArguments());
+}
