+}
+
+void AsideOmniboxSearchboxPage::SetInputText(const std::string& input) {
+  base::DictValue details;
+  details.Set("input", input);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onInputTextChanged", std::move(details));
