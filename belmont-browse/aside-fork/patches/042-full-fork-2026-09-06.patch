+  AsideOmniboxSession* session = FindSession(this, params->session_id, &error);
+  if (!session) {
+    return RespondNow(Error(error));
+  }
+  // searchbox.mojom's SelectedFileInfo.is_deletable means "deletable from the
+  // UI", and deleteContext is that UI path, so a context added with
+  // isDeletable:false stays until the session clears its contexts.
+  const auto* context = session->contexts().Get(params->context_token);
+  if (context && !context->is_deletable) {
+    return RespondNow(Error("Context is not deletable"));
+  }
+  if (!session->contexts().Remove(params->context_token)) {
+    return RespondNow(Error("Invalid contextToken"));
+  }
