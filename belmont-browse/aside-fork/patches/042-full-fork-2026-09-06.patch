+++ b/chrome/browser/ui/aside/aside_ai_tabs_metadata.cc
@@ -0,0 +1,107 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aside/aside_ai_tabs_metadata.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/aside/aside_extension_bridge.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+
+namespace aside {
+
+namespace {
+
+struct RegisteredMetadata {
+  base::WeakPtr<const TabGroup> group;
+  AiTabsMetadata metadata;
+};
+
+std::map<tab_groups::TabGroupId, RegisteredMetadata>& Registry() {
+  static base::NoDestructor<std::map<tab_groups::TabGroupId, RegisteredMetadata>>
+      registry;
+  return *registry;
+}
+
+void PruneRegistry() {
+  std::erase_if(Registry(), [](const auto& entry) {
+    return !entry.second.group;
+  });
+}
+
+struct AssignmentCandidate {
+  base::WeakPtr<const TabGroup> group;
+  base::TimeTicks expires;
+};
+
+std::map<tab_groups::TabGroupId, AssignmentCandidate>& Candidates() {
+  static base::NoDestructor<
+      std::map<tab_groups::TabGroupId, AssignmentCandidate>> candidates;
+  return *candidates;
+}
+
+void PruneCandidates() {
+  const auto now = base::TimeTicks::Now();
+  std::erase_if(Candidates(), [now](const auto& entry) {
+    return !entry.second.group || entry.second.expires <= now;
+  });
+}
+
+}  // namespace
+
+void SetAiTabsMetadata(const TabGroup* group, AiTabsMetadata metadata) {
+  PruneRegistry();
+  if (group) {
+    Registry()[group->id()] = {group->AsWeakPtr(), std::move(metadata)};
+  }
+}
+
+std::optional<AiTabsMetadata> GetAiTabsMetadata(const TabGroup* group) {
+  PruneRegistry();
+  if (!group) return std::nullopt;
+  auto it = Registry().find(group->id());
+  if (it == Registry().end() || it->second.group.get() != group) {
+    return std::nullopt;
+  }
+  return it->second.metadata;
+}
+
+void ClearAiTabsMetadata(const tab_groups::TabGroupId& group) {
+  Registry().erase(group);
+  Candidates().erase(group);
+}
+
+void RecordAgentTabsAssignment(const TabGroup* group,
+                               std::string_view extension_id) {
+  PruneCandidates();
+  if (!group || extension_id != kAsideExtensionId) return;
+  Candidates()[group->id()] = {
+      group->AsWeakPtr(), base::TimeTicks::Now() + base::Seconds(10)};
+}
+
+void ConfirmAgentTabsAssignment(const TabGroup* group,
+                                std::string_view extension_id,
+                                std::u16string_view title) {
+  PruneCandidates();
+  if (!group || extension_id != kAsideExtensionId) return;
+  auto it = Candidates().find(group->id());
+  if (it == Candidates().end()) return;
+  const bool matches = it->second.group.get() == group &&
+                       title == kAgentTabsGroupTitle;
+  Candidates().erase(it);  // A candidate is consumed once, even on rename.
+  if (matches && !GetAiTabsMetadata(group)) {
+    SetAiTabsMetadata(group, {});
+  }
+}
+
+bool IsAgentTabsGroup(const TabGroup* group) {
+  return GetAiTabsMetadata(group).has_value();
+}
+
+}  // namespace aside
