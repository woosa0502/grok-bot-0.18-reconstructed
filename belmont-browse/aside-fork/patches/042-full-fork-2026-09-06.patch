+base::DictValue SubscriptionToDict(const Subscription& s) {
+  base::DictValue d;
+  d.Set("id", s.id);
+  d.Set("name", s.name);
+  d.Set("url", s.url);
+  d.Set("enabled", s.enabled);
+  d.Set("status", s.status);
+  d.Set("contentSize", static_cast<double>(s.content_size));
+  d.Set("digest", s.digest);
+  d.Set("etag", s.etag);
+  d.Set("lastModifiedHeader", s.last_modified_header);
+  d.Set("lastError", s.last_error);
+  d.Set("networkRuleCount", s.network_rule_count);
+  d.Set("cosmeticRuleCount", s.cosmetic_rule_count);
+  d.Set("parseErrorCount", s.parse_error_count);
+  d.Set("invalidLines", ToList(s.invalid_lines));
+  d.Set("lastSuccessfulCheckMs", ToJsTime(s.last_successful_check));
+  d.Set("lastContentChangeMs", ToJsTime(s.last_content_change));
+  d.Set("lastEngineActivationMs", ToJsTime(s.last_engine_activation));
+  d.Set("nextUpdateMs", ToJsTime(s.next_update));
+  return d;
+}
+
+Subscription SubscriptionFromDict(const base::DictValue& d) {
+  Subscription s;
+  s.id = d.FindString("id") ? *d.FindString("id") : "";
+  s.name = d.FindString("name") ? *d.FindString("name") : "";
+  s.url = d.FindString("url") ? *d.FindString("url") : "";
+  s.enabled = d.FindBool("enabled").value_or(true);
+  s.status = d.FindString("status") ? *d.FindString("status") : "idle";
+  s.content_size = static_cast<int64_t>(d.FindDouble("contentSize").value_or(0));
+  s.digest = d.FindString("digest") ? *d.FindString("digest") : "";
+  s.etag = d.FindString("etag") ? *d.FindString("etag") : "";
+  s.last_modified_header = d.FindString("lastModifiedHeader")
+                               ? *d.FindString("lastModifiedHeader")
+                               : "";
+  s.last_error = d.FindString("lastError") ? *d.FindString("lastError") : "";
+  s.last_successful_check =
+      FromJsTime(d.FindDouble("lastSuccessfulCheckMs").value_or(0));
+  s.last_content_change =
+      FromJsTime(d.FindDouble("lastContentChangeMs").value_or(0));
+  s.next_update = FromJsTime(d.FindDouble("nextUpdateMs").value_or(0));
+  if (s.status == "updating") {
+    s.status = "idle";
+  }
+  return s;
+}
+
+std::unique_ptr<AsideAdBlockService::LoadedState> ReadStateFromDisk(
+    base::FilePath data_dir,
+    base::FilePath subscriptions_dir,
+    base::FilePath custom_rules_path,
+    base::FilePath manual_dir) {
+  auto state = std::make_unique<AsideAdBlockService::LoadedState>();
+  base::CreateDirectory(subscriptions_dir);
+  base::CreateDirectory(custom_rules_path.DirName());
+  base::CreateDirectory(manual_dir);
+
+  std::string metadata;
+  if (base::ReadFileToString(data_dir.AppendASCII(kMetadataFile), &metadata)) {
+    state->had_metadata = true;
+    std::optional<base::Value> parsed = base::JSONReader::Read(metadata, base::JSON_PARSE_RFC);
+    if (parsed && parsed->is_dict()) {
+      if (const base::ListValue* list =
+              parsed->GetDict().FindList("subscriptions")) {
+        for (const base::Value& item : *list) {
+          if (!item.is_dict()) {
+            continue;
+          }
+          Subscription s = SubscriptionFromDict(item.GetDict());
+          if (s.id.empty() || s.url.empty()) {
+            continue;
+          }
+          base::ReadFileToString(subscriptions_dir.AppendASCII(s.id + ".txt"),
+                                 &s.text);
+          s.content_size = static_cast<int64_t>(s.text.size());
+          state->subscriptions.push_back(std::move(s));
+        }
+      }
+    }
+  }
+  base::ReadFileToString(custom_rules_path, &state->custom_rules);
+
+  base::FileEnumerator files(manual_dir, false, base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("*.txt"));
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    AsideAdBlockService::ManualFile file;
+    file.name = path.BaseName().AsUTF8Unsafe();
+    if (!base::ReadFileToString(path, &file.text) ||
+        !base::IsStringUTF8(file.text)) {
+      state->manual_error = "failed to read manual adblock file: " + file.name;
+      continue;
+    }
+    state->manual_files.push_back(std::move(file));
+  }
+  base::ReadFileToString(manual_dir.AppendASCII("resources.json"),
+                         &state->resources_json);
+  return state;
+}
+
+void WriteMetadataOnWorker(base::FilePath path, std::string json) {
+  base::CreateDirectory(path.DirName());
+  base::WriteFile(path, json);
+}
+
+void WriteTextOnWorker(base::FilePath path, std::string text) {
+  base::CreateDirectory(path.DirName());
+  base::WriteFile(path, text);
+}
