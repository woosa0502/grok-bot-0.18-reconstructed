diff --git a/chrome/browser/resources/aside_adblock/adblock_internals.css b/chrome/browser/resources/aside_adblock/adblock_internals.css
new file mode 100644
index 0000000000..e424918afa
--- /dev/null
+++ b/chrome/browser/resources/aside_adblock/adblock_internals.css
@@ -0,0 +1,348 @@
+/* Copyright 2026 At Your Side Inc. */
+
+:root {
+  color-scheme: light dark;
+  font-family: system-ui, sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  background: var(--color-aside-window-background);
+  color: var(--color-aside-surface-primary-foreground);
+  margin: 0;
+  min-width: 760px;
+}
+
+.page-header,
+main,
+.page-footer {
+  margin: 0 auto;
+  max-width: 1480px;
+  padding: 24px 32px;
+}
+
+.page-header {
+  align-items: center;
+  display: flex;
+  justify-content: space-between;
+  padding-bottom: 8px;
+}
+
+h1,
+h2,
+h3,
+p {
+  margin-top: 0;
+}
+
+h1 {
+  font-size: 28px;
+  margin-bottom: 6px;
+}
+
+h2 {
+  font-size: 19px;
+  margin-bottom: 5px;
+}
+
+h3 {
+  font-size: 15px;
+}
+
+p,
+td,
+th,
+label,
+button,
+input,
+select,
+textarea {
+  font-size: 13px;
+}
+
+p,
+.muted,
+.empty-state,
+.count-summary,
+.editor-footer {
+  color: var(--color-aside-surface-secondary-foreground);
+}
+
+.master-toggle,
+.check-label {
+  align-items: center;
+  display: flex;
+  font-weight: 600;
+  gap: 9px;
+}
+
+input[type='checkbox'] {
+  accent-color: var(--color-aside-action-accent-foreground);
+  height: 17px;
+  width: 17px;
+}
+
+main {
+  display: grid;
+  gap: 18px;
+  padding-top: 16px;
+}
+
+.page-footer {
+  color: var(--color-aside-surface-secondary-foreground);
+  font-size: 12px;
+  padding-bottom: 32px;
+  padding-top: 6px;
+  text-align: center;
+}
+
+.card {
+  background: var(--color-aside-surface-primary);
+  border: 1px solid var(--color-aside-surface-border);
+  border-radius: 14px;
+  box-shadow: 0 8px 24px var(--color-aside-shadow-subtle);
+  padding: 20px;
+}
+
+.section-heading,
+.editor-footer {
+  align-items: center;
+  display: flex;
+  gap: 16px;
+  justify-content: space-between;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+button,
+input,
+select,
+textarea {
+  background: var(--color-aside-surface-secondary);
+  border: 1px solid var(--color-aside-surface-border-strong);
+  border-radius: 8px;
+  color: var(--color-aside-surface-primary-foreground);
+}
+
+button {
+  cursor: pointer;
+  font-weight: 600;
+  min-height: 34px;
+  padding: 7px 13px;
+}
+
+button:hover {
+  background: var(--color-aside-menu-item-background-hover);
+}
+
+button:disabled {
+  color: var(--color-aside-surface-tertiary-foreground);
+  cursor: default;
+}
+
+input,
+select {
+  min-height: 36px;
+  padding: 7px 10px;
+  width: 100%;
+}
+
+textarea {
+  font-family: ui-monospace, monospace;
+  line-height: 1.5;
+  min-height: 260px;
+  padding: 12px;
+  resize: vertical;
+  width: 100%;
+}
+
+label > span {
+  display: block;
+  margin-bottom: 6px;
+}
+
+.inline-form {
+  align-items: end;
+  display: grid;
+  gap: 10px;
+  grid-template-columns: minmax(140px, 0.7fr) minmax(320px, 2fr) auto;
+  margin: 16px 0;
+}
+
+.data-grid {
+  display: grid;
+  gap: 0;
+  grid-template-columns: minmax(150px, 0.45fr) minmax(220px, 1fr);
+  margin: 12px 0 0;
+}
+
+.data-grid dt,
+.data-grid dd {
+  border-top: 1px solid var(--color-aside-surface-border);
+  margin: 0;
+  overflow-wrap: anywhere;
+  padding: 8px 4px;
+}
+
+.data-grid dt {
+  color: var(--color-aside-surface-secondary-foreground);
+  font-weight: 600;
+}
+
+.notice {
+  background: var(--color-aside-action-accent-background);
+  border-radius: 8px;
+  margin: 14px 0 0;
+  padding: 10px 12px;
+}
+
+.error,
+.row-error {
+  color: var(--color-aside-control-invalid);
+}
+
+.table-scroll {
+  overflow-x: auto;
+}
+
+table {
+  border-collapse: collapse;
+  min-width: 1120px;
+  width: 100%;
+}
+
+th,
+td {
+  border-bottom: 1px solid var(--color-aside-surface-border);
+  padding: 10px 8px;
+  text-align: start;
+  vertical-align: top;
+}
+
+th {
+  color: var(--color-aside-surface-secondary-foreground);
+  font-size: 12px;
+}
+
+.filter-url,
+.mono,
+pre {
+  font-family: ui-monospace, monospace;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.filter-name {
+  font-weight: 650;
+  margin-bottom: 4px;
+}
+
+.status-pill {
+  background: var(--color-aside-surface-tertiary);
+  border-radius: 999px;
+  display: inline-block;
+  font-size: 12px;
+  font-weight: 650;
+  padding: 4px 8px;
+}
+
+.status-pill.error {
+  background: var(--color-aside-control-invalid-subtle-background);
+}
+
+.status-pill.idle {
+  background: var(--color-aside-control-success-subtle-background);
+  color: var(--color-aside-control-success);
+}
+
+.editor-footer {
+  margin-top: 10px;
+}
+
+details {
+  border-top: 1px solid var(--color-aside-surface-border);
+  margin-top: 14px;
+  padding-top: 12px;
+}
+
+summary {
+  cursor: pointer;
+  font-weight: 600;
+}
+
+.test-grid {
+  align-items: end;
+  display: grid;
+  gap: 10px;
+  grid-template-columns: repeat(4, minmax(130px, 1fr));
+}
+
+.test-grid .wide {
+  grid-column: span 2;
+}
+
+.test-grid .check-label span {
+  margin: 0;
+}
+
+.engine-grid {
+  display: grid;
+  gap: 14px;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  margin-top: 14px;
+}
+
+.engine-card {
+  background: var(--color-aside-surface-secondary);
+  border: 1px solid var(--color-aside-surface-border);
+  border-radius: 10px;
+  min-width: 0;
+  padding: 14px;
+}
+
+.engine-card table {
+  min-width: 0;
+}
+
+.empty-state {
+  margin: 18px 0 4px;
+  text-align: center;
+}
+
+#status-message {
+  background: var(--color-aside-tooltip-background);
+  border: 1px solid var(--color-aside-tooltip-border);
+  border-radius: 9px;
+  bottom: 20px;
+  color: var(--color-aside-tooltip-foreground);
+  max-width: 520px;
+  opacity: 0;
+  padding: 10px 14px;
+  pointer-events: none;
+  position: fixed;
+  right: 24px;
+  transform: translateY(8px);
+  transition: opacity 120ms ease, transform 120ms ease;
+}
+
+#status-message.visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+@media (max-width: 980px) {
+  .engine-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .test-grid {
+    grid-template-columns: repeat(2, minmax(160px, 1fr));
+  }
+}
diff --git a/chrome/browser/resources/aside_adblock/adblock_internals.html b/chrome/browser/resources/aside_adblock/adblock_internals.html
new file mode 100644
index 0000000000..6a5346673e
--- /dev/null
+++ b/chrome/browser/resources/aside_adblock/adblock_internals.html
@@ -0,0 +1,149 @@
+<!-- Copyright 2026 At Your Side Inc. -->
+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Adblock Internals</title>
+    <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+    <link rel="stylesheet" href="adblock_internals.css">
+  </head>
+  <body>
+    <header class="page-header">
+      <div>
+        <h1>Adblock Internals</h1>
+        <p>Profile-scoped subscriptions, custom rules, and engine diagnostics.</p>
+      </div>
+      <label class="master-toggle">
+        <input id="adblock-enabled" type="checkbox" role="switch">
+        <span>Ad blocker enabled</span>
+      </label>
+    </header>
+
+    <main>
+      <section class="card overview-card">
+        <div class="section-heading">
+          <div>
+            <h2>Overview</h2>
+            <p>Current profile and active engine generation.</p>
+          </div>
+          <div class="actions">
+            <button id="refresh-button" type="button">Refresh</button>
+            <button id="export-button" type="button">Export debug dump</button>
+          </div>
+        </div>
+        <dl id="overview-grid" class="data-grid"></dl>
+        <p id="compile-error" class="error" hidden></p>
+        <p class="notice">Turning the ad blocker off stops new network and cosmetic decisions immediately. Subscription changes become active after the engine rebuild finishes. Reload open pages after completion to remove already injected cosmetic rules.</p>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Filter subscriptions</h2>
+            <p>HTTPS lists update conditionally with ETag and Last-Modified validators.</p>
+          </div>
+          <button id="update-all-button" type="button">Update all</button>
+        </div>
+        <form id="add-subscription-form" class="inline-form">
+          <label>
+            <span>Name</span>
+            <input id="subscription-name" maxlength="256" placeholder="EasyList">
+          </label>
+          <label class="url-field">
+            <span>HTTPS filter URL</span>
+            <input id="subscription-url" type="url" required placeholder="https://example.com/filter.txt">
+          </label>
+          <button type="submit">Add filter</button>
+        </form>
+        <div class="table-scroll">
+          <table>
+            <thead>
+              <tr>
+                <th>Enabled</th>
+                <th>Filter</th>
+                <th>Status</th>
+                <th>Rules</th>
+                <th>Updated</th>
+                <th>Next update</th>
+                <th>HTTP / content</th>
+                <th>Actions</th>
+              </tr>
+            </thead>
+            <tbody id="subscriptions-body"></tbody>
+          </table>
+        </div>
+        <p id="subscriptions-empty" class="empty-state">No URL subscriptions have been added to this profile.</p>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Custom rules</h2>
+            <p>ABP/uBlock-compatible rules stored only in this profile.</p>
+          </div>
+          <div id="custom-counts" class="count-summary"></div>
+        </div>
+        <textarea id="custom-rules" spellcheck="false" placeholder="||ads.example^&#10;example.com##.sponsored"></textarea>
+        <div class="editor-footer">
+          <span id="custom-size"></span>
+          <button id="save-custom-button" type="button">Validate and save</button>
+        </div>
+        <details id="custom-invalid-details" hidden>
+          <summary>Unsupported or invalid custom rule lines</summary>
+          <pre id="custom-invalid-lines"></pre>
+        </details>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Rule tester</h2>
+            <p>Tests the active profile engine and reports the matching raw rule and source line.</p>
+          </div>
+        </div>
+        <form id="rule-test-form" class="test-grid">
+          <label class="wide"><span>Request URL</span><input id="test-url" type="url" required placeholder="https://ads.example/banner.js"></label>
+          <label class="wide"><span>Initiator URL or hostname</span><input id="test-initiator" placeholder="https://publisher.example/"></label>
+          <label><span>Request type</span><select id="test-type"><option>script</option><option>image</option><option>stylesheet</option><option>xmlhttprequest</option><option>document</option><option>subdocument</option><option>websocket</option><option>other</option></select></label>
+          <label><span>Method</span><input id="test-method" value="GET"></label>
+          <label class="check-label"><input id="test-third-party" type="checkbox" checked><span>Third-party request</span></label>
+          <button type="submit">Test active rules</button>
+        </form>
+        <dl id="test-result" class="data-grid" hidden></dl>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Engine diagnostics</h2>
+            <p>Serialized size, source parse counts, unsupported or invalid lines, and bounded regex diagnostics.</p>
+          </div>
+        </div>
+        <div id="engine-diagnostics" class="engine-grid"></div>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Maintenance</h2>
+            <p>Manual development filters and compiled DAT cache.</p>
+          </div>
+          <div class="actions">
+            <button id="reload-manual-button" type="button">Reload manual filters</button>
+            <button id="clear-cache-button" type="button">Clear engine cache</button>
+          </div>
+        </div>
+        <dl id="maintenance-grid" class="data-grid"></dl>
+      </section>
+    </main>
+
+    <footer id="adblock-rust-attribution" class="page-footer">
+      Powered by <a href="https://github.com/brave/adblock-rust/" target="_blank" rel="noreferrer">adblock-rust</a>
+      · Licensed under the <a href="https://www.mozilla.org/MPL/2.0/" target="_blank" rel="noreferrer">Mozilla Public License 2.0</a>.
+    </footer>
+
+    <div id="status-message" role="status" aria-live="polite"></div>
+    <script type="module" src="adblock_internals.js"></script>
+  </body>
+</html>
