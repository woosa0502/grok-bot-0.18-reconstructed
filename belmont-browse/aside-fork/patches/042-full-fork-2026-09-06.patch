+}
+
+void AsideOmniboxSearchboxPage::SetKeywordSelected(bool is_keyword_selected) {
+  base::DictValue details;
+  details.Set("isKeywordSelected", is_keyword_selected);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onKeywordSelectedChanged",
