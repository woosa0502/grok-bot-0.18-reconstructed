+namespace {
+
+// Options that only make sense for whole-document navigations. Rules carrying
+// them are indexed into the document rule set with the option rewritten to
+// "subdocument", which the parser understands.
+bool ExtractDocumentRule(std::string_view line, std::string* rewritten) {
+  size_t dollar = line.rfind('$');
+  if (dollar == std::string_view::npos || line.starts_with("@@")) {
+    return false;
+  }
+  std::string_view options = line.substr(dollar + 1);
+  std::vector<std::string> parts = base::SplitString(
+      options, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  bool has_document = false;
+  for (auto& part : parts) {
+    if (part == "document" || part == "doc") {
+      part = "subdocument";
+      has_document = true;
+    }
+  }
+  if (!has_document) {
+    return false;
+  }
+  *rewritten = std::string(line.substr(0, dollar + 1)) +
+               base::JoinString(parts, ",");
+  return true;
+}
+
+
+// $badfilter targets the rule with the option removed, independent of source
+// order and option/domain ordering. Keep all other matcher/modifier conditions
+// in the identity; a cancellation for one domain must not disable another.
+std::string NetworkRuleKey(url_pattern_index::proto::UrlRule proto,
+                           const PreprocessedRule& options,
+                           bool document_rule) {
+  auto normalize_domains = [](auto* domains) {
+    std::vector<std::pair<std::string, bool>> ordered;
+    for (const auto& domain : *domains) {
+      ordered.emplace_back(base::ToLowerASCII(domain.domain()), domain.exclude());
+    }
+    std::sort(ordered.begin(), ordered.end());
+    ordered.erase(std::unique(ordered.begin(), ordered.end()), ordered.end());
+    domains->Clear();
+    for (const auto& [name, excluded] : ordered) {
+      auto* domain = domains->Add();
+      domain->set_domain(name);
+      domain->set_exclude(excluded);
+    }
+  };
+  normalize_domains(proto.mutable_initiator_domains());
+  normalize_domains(proto.mutable_request_domains());
+  if (!proto.match_case()) {
+    proto.set_url_pattern(base::ToLowerASCII(proto.url_pattern()));
+  }
+  base::Pickle key;
+  key.WriteString(proto.SerializeAsString());
+  key.WriteInt(static_cast<int>(options.bucket));
+  key.WriteString(options.regex);
+  key.WriteString(options.redirect_directive);
+  key.WriteString(options.csp);
+  key.WriteString(options.method);
+  key.WriteBool(options.important);
+  key.WriteBool(document_rule);
+  return std::string(reinterpret_cast<const char*>(key.data()), key.size());
+}
+
+std::string PatternOf(const url_pattern_index::flat::UrlRule* rule) {
+  return rule && rule->url_pattern() ? rule->url_pattern()->str()
+                                     : std::string();
+}
+
+std::string DataUrl(const Resource& res) {
+  return "data:" + res.mime + ";base64," + base::Base64Encode(res.body);
+}
