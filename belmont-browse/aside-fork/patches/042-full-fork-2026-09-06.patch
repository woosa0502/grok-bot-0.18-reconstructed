+// Aside fork: the status bubble shows the browser's own pages under the
+// product's scheme. The original tests the elided text for the "chrome://"
+// prefix and swaps in "aside://" before painting (arm64 0x4443950-0x444399c
+// and 0x444368c-0x44436a4, both inside StatusBubbleViews::SetURL). Display
+// only — nothing resolves aside:// as a real scheme.
+constexpr char16_t kChromeSchemePrefix[] = u"chrome://";
+constexpr char16_t kAsideSchemePrefix[] = u"aside://";
+
+std::u16string AsideRewriteSchemeForDisplay(std::u16string text) {
+  if (text.starts_with(kChromeSchemePrefix)) {
+    text.replace(0, std::u16string_view(kChromeSchemePrefix).size(),
+                 kAsideSchemePrefix);
+  }
+  return text;
+}
+
