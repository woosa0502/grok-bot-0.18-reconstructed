+ExtensionFunction::ResponseAction AsideOmniboxActivateKeywordFunction::Run() {
+  auto params = api::aside_omnibox::ActivateKeyword::Params::Create(args());
+  if (!params) return RespondNow(Error(kInvalidArguments));
+  std::string error;
+  auto* session = FindSession(this, params->session_id, &error);
+  if (!session) return RespondNow(Error(error));
+  const auto* match = MatchFromRequest(session, params->request.additional_properties);
+  if (!match) return RespondNow(Error("Invalid or stale keyword match"));
+  // RE 0x405e0c0 (arm64): "isMouseEvent" is read out of the request and then
+  // not passed on - the tail call takes only (handler, line, url) - so it is
+  // accepted here and likewise unused.  Rejecting a wrong type keeps the
+  // argument contract, which is the part callers can observe.
+  if (const base::Value* is_mouse_event =
+          params->request.additional_properties.Find("isMouseEvent")) {
+    if (!is_mouse_event->is_bool()) {
+      return RespondNow(Error(kInvalidArguments));
+    }
+  }
+  const auto& keyword = match->associated_keyword.empty()
+      ? match->keyword : match->associated_keyword;
+  if (keyword.empty() || !session->ActivateKeyword(keyword)) {
+    return RespondNow(Error("Keyword search provider is unavailable"));
+  }
+  return RespondNow(NoArguments());
+}
