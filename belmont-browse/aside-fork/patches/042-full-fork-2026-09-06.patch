+// Aside: while a tab is dragged over the contents area, the original browser
+// floats a small card under the pointer showing the tab that would be dropped
+// into the new split pane — the dragged tab's favicon and title on a rounded,
+// shadowed surface. Restores the original browser's FloatingTabDragView
+// (declared in multi_contents_view_drop_target_controller.cc:180, class name
+// @0xe8d694d, constructed from the tab-drag update path @0x04c7edd0).
+class FloatingTabDragView : public views::View {
+  METADATA_HEADER(FloatingTabDragView, views::View)
+
+ public:
+  static constexpr int kIconSize = 16;
+  static constexpr int kCornerRadius = 8;
+  static constexpr int kMaxWidth = 220;
+  // How far above the pointer the card floats.
+  static constexpr int kPointerOffset = 24;
+
+  FloatingTabDragView() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetName("FloatingTabDragView");
+
+    auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(6, 8), 8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    icon_ = AddChildView(std::make_unique<views::ImageView>());
+    title_ = AddChildView(std::make_unique<views::Label>(
+        std::u16string(), views::style::CONTEXT_LABEL,
+        views::style::STYLE_PRIMARY));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_->SetMaximumWidth(kMaxWidth);
+  }
+  FloatingTabDragView(const FloatingTabDragView&) = delete;
+  FloatingTabDragView& operator=(const FloatingTabDragView&) = delete;
+  ~FloatingTabDragView() override = default;
+
+  void SetDraggedContents(content::WebContents* contents) {
+    if (!contents) {
+      title_->SetText(std::u16string());
+      icon_->SetImage(ui::ImageModel());
+      return;
+    }
+    title_->SetText(contents->GetTitle());
+    gfx::Image favicon;
+    if (auto* driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents);
+        driver && !driver->GetFavicon().IsEmpty()) {
+      favicon = driver->GetFavicon();
+    }
+    if (favicon.IsEmpty()) {
+      icon_->SetImage(ui::ImageModel::FromVectorIcon(
+          vector_icons::kGlobeIcon, ui::kColorIcon, kIconSize));
+    } else {
+      icon_->SetImage(ui::ImageModel::FromImage(favicon));
+    }
+  }
+
+  // Centers the card on `point_in_parent`, lifted above the pointer, and keeps
+  // it inside the parent.
+  void MoveToPoint(const gfx::Point& point_in_parent) {
+    const gfx::Size size = GetPreferredSize();
+    gfx::Rect bounds(
+        gfx::Point(point_in_parent.x() - size.width() / 2,
+                   point_in_parent.y() - size.height() - kPointerOffset),
+        size);
+    if (parent()) {
+      bounds.AdjustToFit(parent()->GetLocalBounds());
+    }
+    SetBoundsRect(bounds);
+  }
+
+  // views::View:
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    const ui::ColorProvider* const color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+    SetBackground(views::CreateRoundedRectBackground(
+        color_provider->GetColor(ui::kColorBubbleBackground), kCornerRadius));
+    SetBorder(views::CreateRoundedRectBorder(
+        1, kCornerRadius, color_provider->GetColor(ui::kColorBubbleBorder)));
+  }
+
+ private:
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+};
