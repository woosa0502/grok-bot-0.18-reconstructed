+class RecordingImporterObserver : public importer::ImporterProgressObserver {
+ public:
+  void ImportStarted() override {}
+  void ImportItemStarted(user_data_importer::ImportItem) override {}
+  void ImportItemEnded(user_data_importer::ImportItem) override {}
+  void ImportFailed(const std::string& message) override { failure = message; }
+  void ImportCancelled() override { cancelled = true; }
+  void ImportEnded() override { ended = true; }
+  bool cancelled = false;
+  bool ended = false;
+  std::string failure;
+};
