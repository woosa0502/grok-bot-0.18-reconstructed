+void AsideOmniboxSearchboxPage::StepSelection(
+    searchbox::mojom::SelectionDirection direction,
+    searchbox::mojom::SelectionStep step) {
+  base::DictValue details;
+  details.Set("direction", static_cast<int>(direction));
+  details.Set("step", static_cast<int>(step));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onStepSelection", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::OpenCurrentSelection(
+    ::WindowOpenDisposition disposition) {
+  base::DictValue details;
+  details.Set("disposition", static_cast<int>(disposition));
+  details.Set("source", "searchbox");
