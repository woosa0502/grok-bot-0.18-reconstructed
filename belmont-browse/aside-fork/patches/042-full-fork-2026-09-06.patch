+
+namespace aside_importer {
+
+namespace {
+
+inline constexpr sql::Database::Tag kDatabaseTag{"AsideProfileMigrator"};
+
+// Journals and caches that must not follow a profile into a new directory:
+// a stale write-ahead log or per-extension cookie jar makes the copied
+// database inconsistent with the rows this migration rewrites.
+constexpr auto kSkippedNames = std::to_array<const char*>({
+    "Cookies-journal",
+    "Extension Cookies",
+    "Extension Cookies-journal",
+    "Login Data-journal",
+    "Login Data For Account-journal",
+    "Web Data-journal",
+    "History-journal",
+    "Favicons-journal",
+    "Singleton Lock",
+    "Singleton Cookie",
+    "Singleton Socket",
+    "LOCK",
+});
+
+// Preference subtrees the copy must not carry. The two protection keys are
+// the source installation's MACs over its tracked preferences; keeping them
+// makes every tracked preference here read as tampered with. The extension
+// keys describe a toolbar and command set that belongs to the source.
+constexpr auto kRemovedPreferences = std::to_array<const char*>({
+    "protection.macs",
+    "protection.super_mac",
+    "extensions.commands",
+    "extensions.pinned_extensions",
+    "extensions.toolbar",
+    "extensions.theme.id",
+    "extensions.theme.pack",
+});
+
+// Directory entries under a profile whose name begins with this are the
+// source browser's per-extension storage areas.
+constexpr char kExtensionStoragePrefix[] = "chrome-extension_";
+
+base::FilePath HomeRelative(base::span<const char* const> segments) {
+  base::FilePath dir;
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_APPLE)
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  dir = base::nix::GetXDGDirectory(env.get(), base::nix::kXdgConfigHomeEnvVar,
+                                   base::nix::kDotConfigDir);
+#else
+  if (!base::PathService::Get(base::DIR_HOME, &dir)) {
+    return base::FilePath();
+  }
+#if BUILDFLAG(IS_APPLE)
+  dir = dir.Append(FILE_PATH_LITERAL("Library"))
+            .Append(FILE_PATH_LITERAL("Application Support"));
+#endif
+#endif
+  if (dir.empty()) {
+    return base::FilePath();
+  }
+  for (const char* segment : segments) {
+    dir = dir.AppendASCII(segment);
+  }
+  return dir;
+}
+
+// Reads a source browser's Local State document.
+std::optional<base::DictValue> ReadLocalState(const base::FilePath& dir) {
+  const base::FilePath path = dir.Append(FILE_PATH_LITERAL("Local State"));
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*parsed).TakeDict();
+}
+
+// Deletes `keys` (dotted paths) from `prefs`.
+void RemovePreferences(base::DictValue& prefs) {
+  for (const char* key : kRemovedPreferences) {
+    prefs.RemoveByDottedPath(key);
+  }
+}
+
+// A sealed store this installation could open, and what came of it.
+struct ResealOutcome {
+  bool opened = false;
+  int resealed = 0;
+  int skipped = 0;
+};
+
+// Rewrites one sealed column so its rows are readable here.
+//
+// Chromium-family browsers on this platform seal cookie and password values
+// under a key held by the desktop keyring, with a well-known constant key as
+// the fallback when no keyring is available. Our own key ring carries that
+// fallback key, so a source that used it decrypts here and is resealed under
+// the key this installation encrypts with. A source that used its own keyring
+// secret cannot be read from here at all; those rows are left exactly as they
+// are and counted, so nothing is lost and the count can be reported.
+ResealOutcome ResealColumn(const base::FilePath& db_path,
+                           const char* table,
+                           const char* sealed_column,
+                           const os_crypt_async::Encryptor& encryptor) {
+  ResealOutcome outcome;
+  if (!base::PathExists(db_path)) {
+    return outcome;
+  }
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(db_path)) {
+    return outcome;
+  }
+  outcome.opened = true;
+  const std::string select =
+      base::StrCat({"SELECT rowid, ", sealed_column, " FROM ", table});
+  sql::Statement read(db.GetUniqueStatement(select));
+  if (!read.is_valid()) {
+    return outcome;
+  }
+  std::vector<std::pair<int64_t, std::string>> rewrites;
+  while (read.Step()) {
+    const int64_t rowid = read.ColumnInt64(0);
+    std::string sealed = read.ColumnString(1);
+    if (sealed.empty()) {
+      continue;
+    }
+    std::string plaintext;
+    if (!encryptor.DecryptString(sealed, &plaintext)) {
+      ++outcome.skipped;
+      continue;
+    }
+    std::string resealed;
+    if (!encryptor.EncryptString(plaintext, &resealed)) {
+      ++outcome.skipped;
+      continue;
+    }
+    if (resealed != sealed) {
+      rewrites.emplace_back(rowid, std::move(resealed));
+    }
+    ++outcome.resealed;
+  }
+  read.Clear();
+  if (rewrites.empty()) {
+    return outcome;
+  }
+  sql::Transaction transaction(&db);
+  if (!transaction.Begin()) {
+    outcome.skipped += static_cast<int>(rewrites.size());
+    outcome.resealed -= static_cast<int>(rewrites.size());
+    return outcome;
+  }
+  const std::string update = base::StrCat(
+      {"UPDATE ", table, " SET ", sealed_column, " = ? WHERE rowid = ?"});
+  for (const auto& [rowid, value] : rewrites) {
+    sql::Statement write(db.GetUniqueStatement(update));
+    if (!write.is_valid()) {
+      break;
+    }
+    write.BindString(0, value);
+    write.BindInt64(1, rowid);
+    if (!write.Run()) {
+      ++outcome.skipped;
+      --outcome.resealed;
+    }
+  }
+  if (!transaction.Commit()) {
+    outcome.skipped += static_cast<int>(rewrites.size());
+    outcome.resealed -= static_cast<int>(rewrites.size());
+  }
+  return outcome;
+}
+
+}  // namespace
+
+ChromiumProfileInfo::ChromiumProfileInfo() = default;
+ChromiumProfileInfo::ChromiumProfileInfo(const ChromiumProfileInfo&) = default;
+ChromiumProfileInfo::ChromiumProfileInfo(ChromiumProfileInfo&&) = default;
+ChromiumProfileInfo& ChromiumProfileInfo::operator=(
+    const ChromiumProfileInfo&) = default;
+ChromiumProfileInfo& ChromiumProfileInfo::operator=(ChromiumProfileInfo&&) =
+    default;
+ChromiumProfileInfo::~ChromiumProfileInfo() = default;
+
+std::optional<ChromiumBrowser> ChromiumBrowserFromId(std::string_view id) {
+  if (id == "arc") {
+    return ChromiumBrowser::kArc;
+  }
+  if (id == "brave") {
+    return ChromiumBrowser::kBrave;
+  }
+  if (id == "atlas") {
+    return ChromiumBrowser::kAtlas;
+  }
+  if (id == "chrome") {
+    return ChromiumBrowser::kChrome;
+  }
+  if (id == "comet") {
+    return ChromiumBrowser::kComet;
+  }
+  if (id == "dia") {
+    return ChromiumBrowser::kDia;
+  }
+  if (id == "edge") {
+    return ChromiumBrowser::kEdge;
+  }
+  if (id == "chromium") {
+    return ChromiumBrowser::kChromium;
+  }
+  return std::nullopt;
+}
+
+std::string IdForChromiumBrowser(ChromiumBrowser browser) {
+  switch (browser) {
+    case ChromiumBrowser::kArc:
+      return "arc";
+    case ChromiumBrowser::kBrave:
+      return "brave";
+    case ChromiumBrowser::kAtlas:
+      return "atlas";
+    case ChromiumBrowser::kChrome:
+      return "chrome";
+    case ChromiumBrowser::kComet:
+      return "comet";
+    case ChromiumBrowser::kDia:
+      return "dia";
+    case ChromiumBrowser::kEdge:
+      return "edge";
+    case ChromiumBrowser::kChromium:
+      return "chromium";
+  }
+}
+
+std::string DisplayNameForChromiumBrowser(ChromiumBrowser browser) {
+  switch (browser) {
+    case ChromiumBrowser::kArc:
+      return "Arc";
+    case ChromiumBrowser::kBrave:
+      return "Brave";
+    case ChromiumBrowser::kAtlas:
+      return "ChatGPT Atlas";
+    case ChromiumBrowser::kChrome:
+      return "Chrome";
+    case ChromiumBrowser::kComet:
+      return "Comet";
+    case ChromiumBrowser::kDia:
+      return "Dia";
+    case ChromiumBrowser::kEdge:
+      return "Microsoft Edge";
+    case ChromiumBrowser::kChromium:
+      return "Chromium";
+  }
+}
+
+base::FilePath UserDataDirectoryFor(ChromiumBrowser browser) {
+#if BUILDFLAG(IS_APPLE)
+  // The original's macOS layout, read out of the binary's browser switch.
+  switch (browser) {
+    case ChromiumBrowser::kArc: {
+      const char* segments[] = {"Arc", "User Data"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kBrave: {
+      const char* segments[] = {"BraveSoftware", "Brave-Browser", "User Data"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kAtlas: {
+      const char* segments[] = {"com.openai.atlas", "browser-data", "host"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kChrome: {
+      const char* segments[] = {"Google", "Chrome"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kComet: {
+      const char* segments[] = {"Comet"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kDia: {
+      const char* segments[] = {"Dia", "User Data"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kEdge: {
+      const char* segments[] = {"Microsoft Edge"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kChromium: {
+      const char* segments[] = {"Chromium"};
+      return HomeRelative(segments);
+    }
+  }
+#elif BUILDFLAG(IS_POSIX)
+  // Arc, ChatGPT Atlas, Comet and Dia ship no build for this platform, so
+  // there is no directory to read; the page never lists them here.
+  switch (browser) {
+    case ChromiumBrowser::kChrome: {
+      const char* segments[] = {"google-chrome"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kChromium: {
+      const char* segments[] = {"chromium"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kBrave: {
+      const char* segments[] = {"BraveSoftware", "Brave-Browser"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kEdge: {
+      const char* segments[] = {"microsoft-edge"};
+      return HomeRelative(segments);
+    }
+    case ChromiumBrowser::kArc:
+    case ChromiumBrowser::kAtlas:
+    case ChromiumBrowser::kComet:
+    case ChromiumBrowser::kDia:
+      return base::FilePath();
+  }
+#else
+  return base::FilePath();
+#endif
+}
+
+bool IsChromiumBrowserInstalled(ChromiumBrowser browser) {
+  const base::FilePath dir = UserDataDirectoryFor(browser);
+  if (dir.empty()) {
+    return false;
+  }
+  return base::PathExists(dir.Append(FILE_PATH_LITERAL("Local State"))) ||
+         base::PathExists(dir.Append(FILE_PATH_LITERAL("Default")));
+}
+
+std::vector<std::string> InstalledChromiumBrowserIds() {
+  static constexpr ChromiumBrowser kAll[] = {
+      ChromiumBrowser::kChrome, ChromiumBrowser::kEdge,
+      ChromiumBrowser::kArc,    ChromiumBrowser::kAtlas,
+      ChromiumBrowser::kComet,  ChromiumBrowser::kDia,
+      ChromiumBrowser::kBrave,  ChromiumBrowser::kChromium,
+  };
+  std::vector<std::string> ids;
+  for (ChromiumBrowser browser : kAll) {
+    if (IsChromiumBrowserInstalled(browser)) {
+      ids.push_back(IdForChromiumBrowser(browser));
+    }
+  }
+  return ids;
+}
+
+std::vector<ChromiumProfileInfo> ReadChromiumProfiles(
+    ChromiumBrowser browser) {
+  return ReadChromiumProfilesFromDirectory(UserDataDirectoryFor(browser));
+}
+
+std::vector<ChromiumProfileInfo> ReadChromiumProfilesFromDirectory(
+    const base::FilePath& dir) {
+  std::vector<ChromiumProfileInfo> profiles;
+  if (dir.empty()) {
+    return profiles;
+  }
+  std::optional<base::DictValue> local_state = ReadLocalState(dir);
+  const base::DictValue* cache =
+      local_state ? local_state->FindDictByDottedPath("profile.info_cache")
+                  : nullptr;
+  // A browser that never wrote a Local State still has a Default profile.
+  if (!cache) {
+    const base::FilePath fallback = dir.Append(FILE_PATH_LITERAL("Default"));
+    if (base::PathExists(fallback)) {
+      ChromiumProfileInfo info;
+      info.id = "Default";
+      info.name = "Default";
+      info.path = fallback;
+      profiles.push_back(std::move(info));
+    }
+    return profiles;
+  }
+
+  auto make = [&](const std::string& id,
+                  const base::DictValue& entry) -> ChromiumProfileInfo {
+    ChromiumProfileInfo info;
+    info.id = id;
+    const std::string* gaia_name = entry.FindString("gaia_name");
+    const std::string* name = entry.FindString("name");
+    if (gaia_name && !gaia_name->empty()) {
+      info.name = *gaia_name;
+    } else if (name && !name->empty()) {
+      info.name = *name;
+    } else {
+      info.name = id;
+    }
+    info.path = dir.AppendASCII(id);
+    const std::string* picture = entry.FindString("gaia_picture_file_name");
+    if (picture && !picture->empty()) {
+      info.avatar = info.path.AppendASCII(*picture);
+    }
+    return info;
+  };
+
+  // profile.profiles_order is the order the source browser shows; anything it
+  // does not mention follows in info_cache order.
+  std::set<std::string> seen;
+  if (const base::ListValue* order =
+          local_state->FindListByDottedPath("profile.profiles_order")) {
+    for (const base::Value& value : *order) {
+      if (!value.is_string()) {
+        continue;
+      }
+      const base::DictValue* entry = cache->FindDict(value.GetString());
+      if (!entry) {
+        continue;
+      }
+      seen.insert(value.GetString());
+      profiles.push_back(make(value.GetString(), *entry));
+    }
+  }
+  for (const auto [id, value] : *cache) {
+    if (seen.contains(id) || !value.is_dict()) {
+      continue;
+    }
+    profiles.push_back(make(id, value.GetDict()));
+  }
+  // Only profiles that actually have a directory can be migrated.
+  std::erase_if(profiles, [](const ChromiumProfileInfo& info) {
+    return !base::PathExists(info.path);
+  });
+  return profiles;
+}
+
+MigrationResult MigrateChromiumProfile(
+    ChromiumBrowser browser,
+    const ChromiumProfileInfo& profile,
+    const base::FilePath& target_profile_dir,
+    const std::string& target_profile_name,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  MigrationResult result;
+  const std::string display = DisplayNameForChromiumBrowser(browser);
+
+  if (!base::DirectoryExists(profile.path)) {
+    result.error = display + " profile directory does not exist: " +
+                   profile.path.AsUTF8Unsafe();
+    return result;
+  }
+  if (!base::CreateDirectory(target_profile_dir)) {
+    result.error = "Failed to copy " + display + " profile data from " +
+                   profile.path.AsUTF8Unsafe();
+    return result;
+  }
+
+  // Copy the profile a top-level entry at a time so the skip list applies.
+  std::set<std::string> skipped(std::begin(kSkippedNames),
+                                std::end(kSkippedNames));
+  base::FileEnumerator entries(
+      profile.path, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath entry = entries.Next(); !entry.empty();
+       entry = entries.Next()) {
+    const std::string name = entry.BaseName().AsUTF8Unsafe();
+    if (skipped.contains(name) || name.starts_with(kExtensionStoragePrefix)) {
+      continue;
+    }
+    const base::FilePath destination = target_profile_dir.AppendASCII(name);
+    const bool copied =
+        base::DirectoryExists(entry)
+            ? base::CopyDirectory(entry, destination, /*recursive=*/true)
+            : base::CopyFile(entry, destination);
+    if (!copied) {
+      result.error = "Failed to copy " + display + " profile data from " +
+                     profile.path.AsUTF8Unsafe();
+      return result;
+    }
+  }
+
+  // Scrub the copied preferences. Leaving the source installation's MACs in
+  // place would make every tracked preference read as tampered with, which is
+  // what "reinitialize imported tracked preferences" refers to.
+  const base::FilePath prefs_path =
+      target_profile_dir.Append(FILE_PATH_LITERAL("Preferences"));
+  if (base::PathExists(prefs_path)) {
+    std::string contents;
+    std::optional<base::Value> parsed;
+    if (base::ReadFileToString(prefs_path, &contents)) {
+      parsed = base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+    }
+    if (!parsed || !parsed->is_dict()) {
+      result.error = "Failed to update copied " + display + " preferences.";
+      return result;
+    }
+    base::DictValue prefs = std::move(*parsed).TakeDict();
+    RemovePreferences(prefs);
+    prefs.SetByDottedPath("profile.name", target_profile_name);
+    std::string out;
+    if (!base::JSONWriter::Write(prefs, &out) ||
+        !base::WriteFile(prefs_path, out)) {
+      result.error = "Failed to reinitialize imported tracked preferences for " +
+                     display;
+      return result;
+    }
+  }
+  // Secure Preferences carries the same MACs and is regenerated on first run.
+  const base::FilePath secure_prefs =
+      target_profile_dir.Append(FILE_PATH_LITERAL("Secure Preferences"));
+  if (base::PathExists(secure_prefs)) {
+    std::string contents;
+    std::optional<base::Value> parsed;
+    if (base::ReadFileToString(secure_prefs, &contents)) {
+      parsed = base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+    }
+    if (parsed && parsed->is_dict()) {
+      base::DictValue prefs = std::move(*parsed).TakeDict();
+      RemovePreferences(prefs);
+      std::string out;
+      if (!base::JSONWriter::Write(prefs, &out) ||
+          !base::WriteFile(secure_prefs, out)) {
+        result.error =
+            "Failed to reinitialize imported tracked preferences for " +
+            display;
+        return result;
+      }
+    }
+  }
+
+  // The Google account picture is a file the copied preferences point at; a
+  // profile whose picture did not come across shows the placeholder instead.
+  if (!profile.avatar.empty() && base::PathExists(profile.avatar)) {
+    const base::FilePath destination =
+        target_profile_dir.Append(profile.avatar.BaseName());
+    if (!base::PathExists(destination) &&
+        !base::CopyFile(profile.avatar, destination)) {
+      result.error = "Failed to persist imported " + display +
+                     " profile photo to " + destination.AsUTF8Unsafe();
+      return result;
+    }
+  }
+
+  // Cookies and passwords: reseal what this installation can read, count what
+  // it cannot. A store that opened and yielded nothing readable is reported
+  // separately, because that means the whole store is sealed to another key.
+  if (encryptor) {
+    struct Store {
+      const base::FilePath::CharType* file;
+      const char* table;
+      const char* column;
+    };
+    const Store stores[] = {
+        {FILE_PATH_LITERAL("Cookies"), "cookies", "encrypted_value"},
+        {FILE_PATH_LITERAL("Login Data"), "logins", "password_value"},
+        {FILE_PATH_LITERAL("Login Data For Account"), "logins",
+         "password_value"},
+    };
+    bool opened_any = false;
+    for (const Store& store : stores) {
+      const ResealOutcome outcome =
+          ResealColumn(target_profile_dir.Append(store.file), store.table,
+                       store.column, *encryptor);
+      opened_any = opened_any || outcome.opened;
+      result.resealed_rows += outcome.resealed;
+      result.skipped_encrypted_rows += outcome.skipped;
+    }
+    result.encrypted_store_unreadable =
+        opened_any && result.resealed_rows == 0 &&
+        result.skipped_encrypted_rows > 0;
+  }
+
+  result.ok = true;
+  return result;
+}
+
+}  // namespace aside_importer
