@@ -0,0 +1,203 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_importer/firefox_cookie_importer.h"
+
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "sql/database.h"
+#include "sql/statement.h"
+
+namespace aside_importer {
+
+namespace {
+
+inline constexpr sql::Database::Tag kDatabaseTag{"FirefoxImporter"};
+
+// Firefox stores the file next to its write-ahead log and rollback journal.
+// Copying the database alone would drop everything a running Firefox has
+// written since its last checkpoint.
+constexpr base::FilePath::CharType kCookiesFile[] =
+    FILE_PATH_LITERAL("cookies.sqlite");
+constexpr base::FilePath::CharType kWalSuffix[] = FILE_PATH_LITERAL("-wal");
+constexpr base::FilePath::CharType kJournalSuffix[] =
+    FILE_PATH_LITERAL("-journal");
+
+// Columns the reader needs, and the ones it uses when the schema has them.
+constexpr char kName[] = "name";
+constexpr char kValue[] = "value";
+constexpr char kHost[] = "host";
+constexpr char kPath[] = "path";
+constexpr char kExpiry[] = "expiry";
+constexpr char kLastAccessed[] = "lastAccessed";
+constexpr char kCreationTime[] = "creationTime";
+constexpr char kIsSecure[] = "isSecure";
+constexpr char kIsHttpOnly[] = "isHttpOnly";
+constexpr char kSchemeMap[] = "schemeMap";
+constexpr char kOriginAttributes[] = "originAttributes";
+
+// moz_cookies keeps expiry in whole seconds since the Unix epoch, and
+// lastAccessed / creationTime in microseconds since it.
+base::Time FromUnixSeconds(int64_t seconds) {
+  return seconds <= 0 ? base::Time()
+                      : base::Time::UnixEpoch() + base::Seconds(seconds);
+}
+
+base::Time FromUnixMicroseconds(int64_t microseconds) {
+  return microseconds <= 0
+             ? base::Time()
+             : base::Time::UnixEpoch() + base::Microseconds(microseconds);
+}
+
+// The columns moz_cookies actually has in this profile's Firefox version.
+std::set<std::string> ReadColumnNames(sql::Database& db) {
+  std::set<std::string> names;
+  sql::Statement statement(
+      db.GetUniqueStatement("PRAGMA table_info(moz_cookies)"));
+  if (!statement.is_valid()) {
+    return names;
+  }
+  while (statement.Step()) {
+    names.insert(statement.ColumnString(1));
+  }
+  return names;
+}
+
+bool CopyIfPresent(const base::FilePath& from, const base::FilePath& to) {
+  return !base::PathExists(from) || base::CopyFile(from, to);
+}
+
+}  // namespace
+
+GURL OriginAttributesUrl(const std::string& origin_attributes) {
+  std::string suffix = origin_attributes;
+  if (!suffix.empty() && suffix.front() == '^') {
+    suffix.erase(suffix.begin());
+  }
+  return GURL("https://firefox-origin-attributes.invalid/?" + suffix);
+}
+
+FirefoxCookieResult ReadFirefoxCookies(const base::FilePath& profile_dir) {
+  FirefoxCookieResult result;
+  const base::FilePath source = profile_dir.Append(kCookiesFile);
+  if (!base::PathExists(source)) {
+    // A profile with no cookie store is not an error; it simply has none.
+    result.ok = true;
+    return result;
+  }
+
+  base::ScopedTempDir temp;
+  if (!temp.CreateUniqueTempDir()) {
+    result.error = "Failed to snapshot Firefox cookies database";
+    return result;
+  }
+  const base::FilePath snapshot = temp.GetPath().Append(kCookiesFile);
+  if (!base::CopyFile(source, snapshot) ||
+      !CopyIfPresent(source.AddExtension(kWalSuffix),
+                     snapshot.AddExtension(kWalSuffix)) ||
+      !CopyIfPresent(source.AddExtension(kJournalSuffix),
+                     snapshot.AddExtension(kJournalSuffix))) {
+    result.error = "Failed to snapshot Firefox cookies database";
+    return result;
+  }
+
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(snapshot)) {
+    result.error = "Failed to open Firefox cookies database snapshot";
+    return result;
+  }
+
+  const std::set<std::string> columns = ReadColumnNames(db);
+  // Everything below the optional columns has been in moz_cookies for as long
+  // as the table has existed; a store without one of them is not a cookie
+  // store this reader understands.
+  for (const char* required :
+       {kName, kValue, kHost, kPath, kExpiry, kCreationTime}) {
+    if (!columns.contains(required)) {
+      result.error =
+          base::StrCat({"Firefox cookies database is missing column ",
+                        required});
+      return result;
+    }
+  }
+
+  const bool has_last_accessed = columns.contains(kLastAccessed);
+  const bool has_secure = columns.contains(kIsSecure);
+  const bool has_http_only = columns.contains(kIsHttpOnly);
+  const bool has_scheme_map = columns.contains(kSchemeMap);
+  const bool has_origin_attributes = columns.contains(kOriginAttributes);
+
+  // Built from the columns this schema has, in the original's order, so an
+  // older Firefox is read rather than rejected.
+  std::vector<std::string> select_columns = {kName, kValue, kHost, kPath,
+                                             kExpiry};
+  if (has_last_accessed) {
+    select_columns.push_back(kLastAccessed);
+  }
+  select_columns.push_back(kCreationTime);
+  if (has_secure) {
+    select_columns.push_back(kIsSecure);
+  }
+  if (has_http_only) {
+    select_columns.push_back(kIsHttpOnly);
+  }
+  if (has_scheme_map) {
+    select_columns.push_back(kSchemeMap);
+  }
+  if (has_origin_attributes) {
+    select_columns.push_back(kOriginAttributes);
+  }
+  const std::string query =
+      base::StrCat({"SELECT ", base::JoinString(select_columns, ", "),
+                    " FROM moz_cookies"});
+
+  sql::Statement statement(db.GetUniqueStatement(query));
+  if (!statement.is_valid()) {
+    result.error = "Failed to query Firefox cookies database";
+    return result;
+  }
+  while (statement.Step()) {
+    FirefoxCookie cookie;
+    int column = 0;
+    cookie.name = statement.ColumnString(column++);
+    cookie.value = statement.ColumnString(column++);
+    cookie.host = statement.ColumnString(column++);
+    cookie.path = statement.ColumnString(column++);
+    cookie.expiry = FromUnixSeconds(statement.ColumnInt64(column++));
+    if (has_last_accessed) {
+      cookie.last_accessed =
+          FromUnixMicroseconds(statement.ColumnInt64(column++));
+    }
+    cookie.creation_time =
+        FromUnixMicroseconds(statement.ColumnInt64(column++));
+    if (has_secure) {
+      cookie.is_secure = statement.ColumnInt64(column++) != 0;
+    }
+    if (has_http_only) {
+      cookie.is_http_only = statement.ColumnInt64(column++) != 0;
+    }
+    if (has_scheme_map) {
+      cookie.scheme_map = static_cast<int>(statement.ColumnInt64(column++));
+    }
+    if (has_origin_attributes) {
+      cookie.origin_attributes = statement.ColumnString(column++);
+    }
+    result.cookies.push_back(std::move(cookie));
+  }
+  if (!statement.Succeeded()) {
+    result.error = "Failed while reading Firefox cookies database";
+    return result;
+  }
+  result.ok = true;
+  return result;
+}
+
+}  // namespace aside_importer
diff --git a/chrome/browser/ui/webui/aside_importer/firefox_cookie_importer.h b/chrome/browser/ui/webui/aside_importer/firefox_cookie_importer.h
new file mode 100644
index 0000000000..b4d4efc17a
--- /dev/null
+++ b/chrome/browser/ui/webui/aside_importer/firefox_cookie_importer.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_COOKIE_IMPORTER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_COOKIE_IMPORTER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+namespace aside_importer {
+
+// One row of Firefox's moz_cookies table, in the shape the table stores it.
+struct FirefoxCookie {
+  std::string name;
+  std::string value;
+  std::string host;
+  std::string path;
+  base::Time expiry;
+  base::Time last_accessed;
+  base::Time creation_time;
+  bool is_secure = false;
+  bool is_http_only = false;
+  // Firefox's per-container / per-partition suffix, e.g.
+  // "^userContextId=2&partitionKey=%28https%2Cexample.com%29". Empty for an
+  // ordinary cookie.
+  std::string origin_attributes;
+  // Bit 1 = http, bit 2 = https, bit 4 = file. Zero when the column is absent.
+  int scheme_map = 0;
+};
+
+// Reading a Firefox cookie store either produces rows or an explanation.
+struct FirefoxCookieResult {
+  bool ok = false;
+  std::string error;
+  std::vector<FirefoxCookie> cookies;
+};
+
+// The URL a Firefox originAttributes suffix is parsed as, so its key/value
+// pairs can be read with the ordinary query parsing. Firefox writes the suffix
+// with a leading '^'; this drops it and treats the rest as a query string.
+GURL OriginAttributesUrl(const std::string& origin_attributes);
+
+// Copies <profile>/cookies.sqlite (with its write-ahead log and journal, so
+// the snapshot is not missing a live browser's most recent writes) into a
+// temporary directory and reads moz_cookies out of the copy. Blocking.
+FirefoxCookieResult ReadFirefoxCookies(const base::FilePath& profile_dir);
+
+}  // namespace aside_importer
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_COOKIE_IMPORTER_H_
diff --git a/chrome/browser/ui/webui/aside_importer/firefox_profile_importer.cc b/chrome/browser/ui/webui/aside_importer/firefox_profile_importer.cc
new file mode 100644
index 0000000000..6b6a7b9db3
--- /dev/null
+++ b/chrome/browser/ui/webui/aside_importer/firefox_profile_importer.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_importer/firefox_profile_importer.h"
+
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/strcat.h"
+#include "net/base/url_util.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_inclusion_status.h"
+
+namespace aside_importer {
+
+namespace {
+
+// Firefox's schemeMap bits. A row that was only ever seen over http is
+// restored as an http cookie even when it carries the secure flag, which
+// Firefox tolerates and this store does not.
+constexpr int kSchemeHttp = 1 << 0;
+constexpr int kSchemeHttps = 1 << 1;
+
+// A container cookie belongs to a Firefox container this browser has no
+// equivalent for, so it cannot be carried over.
+bool IsContainerCookie(const std::string& origin_attributes) {
+  if (origin_attributes.empty()) {
+    return false;
+  }
+  const GURL url = OriginAttributesUrl(origin_attributes);
+  std::string user_context;
+  if (!net::GetValueForKeyInQuery(url, "userContextId", &user_context)) {
+    return false;
+  }
+  int value = 0;
+  return base::StringToInt(user_context, &value) && value != 0;
+}
+
+}  // namespace
+
+GURL UrlForFirefoxCookie(const FirefoxCookie& cookie) {
+  if (cookie.host.empty()) {
+    return GURL();
+  }
+  std::string host = cookie.host;
+  // A domain cookie's host starts with a dot in both stores; the URL it is
+  // scoped to is the same host without it.
+  if (host.front() == '.') {
+    host.erase(host.begin());
+  }
+  if (host.empty()) {
+    return GURL();
+  }
+  const bool https = cookie.is_secure ||
+                     (cookie.scheme_map & kSchemeHttps) != 0 ||
+                     (cookie.scheme_map & kSchemeHttp) == 0;
+  const std::string path = cookie.path.empty() ? "/" : cookie.path;
+  return GURL(base::StrCat({https ? "https://" : "http://", host, path}));
+}
+
+std::unique_ptr<net::CanonicalCookie> ConvertFirefoxCookie(
+    const FirefoxCookie& cookie) {
+  if (cookie.name.empty() && cookie.value.empty()) {
+    return nullptr;
+  }
+  if (IsContainerCookie(cookie.origin_attributes)) {
+    return nullptr;
+  }
+  const GURL url = UrlForFirefoxCookie(cookie);
+  if (!url.is_valid()) {
+    return nullptr;
+  }
+  net::CookieInclusionStatus status;
+  // Firefox does not record a SameSite value that maps onto this store's
+  // three-way attribute, so an imported cookie is unspecified, which this
+  // store treats the way it treats a cookie that arrived without the
+  // attribute. The partition key stays empty: Firefox's partitionKey names a
+  // top-level site whose scheme this row does not record.
+  return net::CanonicalCookie::CreateSanitizedCookie(
+      url, cookie.name, cookie.value, cookie.host,
+      cookie.path.empty() ? "/" : cookie.path, cookie.creation_time,
+      cookie.expiry, cookie.last_accessed, cookie.is_secure,
+      cookie.is_http_only, net::CookieSameSite::UNSPECIFIED,
+      net::COOKIE_PRIORITY_DEFAULT, /*partition_key=*/std::nullopt, &status);
+}
+
+PreparedFirefoxCookies PrepareFirefoxCookies(
+    const base::FilePath& profile_dir) {
+  PreparedFirefoxCookies prepared;
+  FirefoxCookieResult read = ReadFirefoxCookies(profile_dir);
+  if (!read.ok) {
+    prepared.error = read.error;
+    return prepared;
+  }
+  for (const FirefoxCookie& cookie : read.cookies) {
+    std::unique_ptr<net::CanonicalCookie> converted =
+        ConvertFirefoxCookie(cookie);
+    if (!converted) {
+      ++prepared.skipped;
+      continue;
+    }
+    prepared.cookies.push_back(std::move(*converted));
+  }
+  return prepared;
+}
+
+std::string SkippedFirefoxCookiesMessage(int skipped) {
+  if (skipped <= 0) {
+    return std::string();
+  }
+  return base::StrCat({"Skipped ", base::NumberToString(skipped),
+                       " unsupported or invalid Firefox cookies"});
+}
+
+}  // namespace aside_importer
