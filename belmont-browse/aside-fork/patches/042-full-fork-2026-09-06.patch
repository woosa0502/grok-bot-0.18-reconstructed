+  std::vector<CosmeticRule> conditional_rules_;  // has include or exclude
+  std::string generic_stylesheet_;
+  // generic_selectors_ split the way the cosmetic script consumes them.
+  std::unordered_map<std::string, std::vector<std::string>> generic_by_class_;
+  std::unordered_map<std::string, std::vector<std::string>> generic_by_id_;
+  std::vector<std::string> generic_misc_;
+  std::vector<ProceduralRule> procedural_rules_;
+  int procedural_rule_count_ = 0;
+
+  std::vector<SourceStats> sources_;
+  size_t flatbuffer_size_ = 0;
+  int network_rule_count_ = 0;
+  int cosmetic_rule_count_ = 0;
+  int parse_error_count_ = 0;
+  int csp_rule_count_ = 0;
+  int popup_rule_count_ = 0;
+};
