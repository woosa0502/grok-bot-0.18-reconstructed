+// --- Aside restoration: omnibox page-load progress -------------------------
+
+void LocationBarView::OnPageLoadProgressMaybeChanged() {
+  content::WebContents* const contents =
+      GetWebContentsForPageActionIconView();
+  if (!contents) {
+    HidePageLoadProgress();
+    return;
+  }
+
+  const double progress =
+      contents->IsLoading() ? contents->GetLoadProgress() : 1.0;
+  page_load_progress_target_ = std::clamp(progress, 0.0, 1.0);
+
+  if (contents->IsLoading() && page_load_progress_target_ < 1.0) {
+    if (!page_load_progress_visible_) {
+      page_load_progress_visible_ = true;
+      page_load_progress_ = 0.0;
+    }
+    page_load_progress_hide_timer_.Stop();
+    StartPageLoadProgressTrickle();
+    UpdatePageLoadProgressView();
+    SchedulePaint();
+    return;
+  }
+
+  if (page_load_progress_visible_) {
+    page_load_progress_ = 1.0;
+    page_load_progress_target_ = 1.0;
+    page_load_progress_trickle_timer_.Stop();
+    StartPageLoadProgressHideTimer();
+    UpdatePageLoadProgressView();
+    SchedulePaint();
+  }
+}
+
+void LocationBarView::StartPageLoadProgressTrickle() {
+  if (page_load_progress_trickle_timer_.IsRunning()) {
+    return;
+  }
+  page_load_progress_trickle_timer_.Start(
+      FROM_HERE, kAsidePageLoadProgressTrickleInterval,
+      base::BindRepeating(&LocationBarView::OnPageLoadProgressTrickle,
+                          base::Unretained(this)));
+}
+
+void LocationBarView::OnPageLoadProgressTrickle() {
+  content::WebContents* const contents =
+      GetWebContentsForPageActionIconView();
+  if (!contents || !contents->IsLoading()) {
+    page_load_progress_trickle_timer_.Stop();
+    OnPageLoadProgressMaybeChanged();
+    return;
+  }
+  page_load_progress_target_ =
+      std::clamp(contents->GetLoadProgress(), 0.0, 1.0);
+  // Never move backwards, and always creep forward a little so a stalled load
+  // still looks alive.
+  const double target = std::max(page_load_progress_target_,
+                                 page_load_progress_ +
+                                     (1.0 - page_load_progress_) *
+                                         kAsidePageLoadProgressTrickleStep);
+  page_load_progress_ = std::clamp(std::max(page_load_progress_, target), 0.0,
+                                   1.0);
+  UpdatePageLoadProgressView();
+  SchedulePaint();
+}
+
+void LocationBarView::StartPageLoadProgressHideTimer() {
+  page_load_progress_hide_timer_.Start(
+      FROM_HERE, kAsidePageLoadProgressHideDelay,
+      base::BindOnce(&LocationBarView::HidePageLoadProgress,
+                     base::Unretained(this)));
+}
+
+void LocationBarView::HidePageLoadProgress() {
+  page_load_progress_trickle_timer_.Stop();
+  page_load_progress_hide_timer_.Stop();
+  if (!page_load_progress_visible_ && page_load_progress_ == 0.0) {
+    return;
+  }
+  page_load_progress_visible_ = false;
+  page_load_progress_ = 0.0;
+  page_load_progress_target_ = 0.0;
+  UpdatePageLoadProgressView();
+  SchedulePaint();
+}
+
+
+void LocationBarView::UpdatePageLoadProgressView() {
+  // The fill lives in `page_load_progress_view_`; this keeps its bounds and
+  // visibility in step with the current progress.
+  if (!page_load_progress_view_) {
+    return;
+  }
+  const bool show = page_load_progress_visible_ && page_load_progress_ > 0.0 &&
+                    !is_popup_mode_ && !GetLocalBounds().IsEmpty();
+  page_load_progress_view_->SetVisible(show);
+  if (!show) {
+    return;
+  }
+  gfx::Rect bounds = GetLocalBounds();
+  bounds.set_width(base::ClampRound(
+      bounds.width() * std::clamp(page_load_progress_, 0.0, 1.0)));
+  page_load_progress_view_->SetCornerRadius(GetBorderRadius());
+  page_load_progress_view_->SetBoundsRect(bounds);
+  // The omnibox text field paints its own opaque background, so the fill has
+  // to sit above it in the layer order.
+  if (ui::Layer* const layer = page_load_progress_view_->layer();
+      layer && layer->parent()) {
+    layer->parent()->StackAtTop(layer);
+  }
 }
 
