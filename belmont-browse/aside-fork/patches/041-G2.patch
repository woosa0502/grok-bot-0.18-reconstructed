+// Aside: the seam between the vertical tab strip and the content pane sitting
+// next to it. While a split is showing, each pane carries its own outline and
+// rounded corners, which leaves a visible notch where the leading pane meets
+// the vertical tab strip; this view fills that notch. Restores the original
+// browser's VerticalTabStripAdjacentPaneDecorationView (browser_view.cc).
+class VerticalTabStripAdjacentPaneDecorationView : public views::View {
+  METADATA_HEADER(VerticalTabStripAdjacentPaneDecorationView, views::View)
+
+ public:
+  VerticalTabStripAdjacentPaneDecorationView() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetVisible(false);
+  }
+  VerticalTabStripAdjacentPaneDecorationView(
+      const VerticalTabStripAdjacentPaneDecorationView&) = delete;
+  VerticalTabStripAdjacentPaneDecorationView& operator=(
+      const VerticalTabStripAdjacentPaneDecorationView&) = delete;
+  ~VerticalTabStripAdjacentPaneDecorationView() override = default;
+
+  void SetCornerRadius(int radius) {
+    if (corner_radius_ == radius) {
+      return;
+    }
+    corner_radius_ = radius;
+    SchedulePaint();
+  }
+
+ protected:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const color_provider = GetColorProvider();
+    if (!color_provider || GetLocalBounds().IsEmpty()) {
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(color_provider->GetColor(kColorToolbar));
+    // Fill the seam, then punch the pane's rounded corner back out of it so the
+    // pane keeps its radius while the notch behind it is filled.
+    canvas->DrawRect(gfx::RectF(GetLocalBounds()), flags);
+
+    flags.setColor(color_provider->GetColor(kColorToolbarSeparatorDefault));
+    canvas->DrawLine(gfx::PointF(width() - 1, corner_radius_),
+                     gfx::PointF(width() - 1, height() - corner_radius_),
+                     flags);
+  }
+
+ private:
+  int corner_radius_ = 12;
+};
+
+BEGIN_METADATA(VerticalTabStripAdjacentPaneDecorationView)
+END_METADATA
+
