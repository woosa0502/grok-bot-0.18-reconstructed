+// --- Aside restoration: split pane decoration, focus and modal handling ----
+
+bool ContentsContainerView::IsBlockedByModal() const {
+  if (!contents_view_ || !contents_view_->holder()) {
+    return false;
+  }
+  return contents_view_->holder()->GetProperty(views::kIsBlockedByModalKey);
+}
+
+void ContentsContainerView::PostFocusAfterActivation() {
+  if (focus_after_activation_pending_) {
+    return;
+  }
+  focus_after_activation_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ContentsContainerView::FocusAfterActivation,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ContentsContainerView::FocusAfterActivation() {
+  focus_after_activation_pending_ = false;
+  if (!is_in_split_ || !contents_view_ || !GetWidget()) {
+    return;
+  }
+  // A tab-modal dialog owns the focus; never pull it back into the page.
+  if (IsBlockedByModal()) {
+    return;
+  }
+  if (!contents_view_->GetVisible() || !contents_view_->web_contents()) {
+    return;
+  }
+  contents_view_->RequestFocus();
+}
+
+void ContentsContainerView::ResampleSplitToolbarColorAfterCommittedNavigation() {
+  if (resample_split_toolbar_color_pending_) {
+    return;
+  }
+  resample_split_toolbar_color_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ContentsContainerView::ResampleSplitToolbarColor,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ContentsContainerView::ResampleSplitToolbarColor() {
+  resample_split_toolbar_color_pending_ = false;
+  if (!is_in_split_ || !mini_toolbar_) {
+    return;
+  }
+  // The mini toolbar derives its colours from the theme and the pane's active
+  // state; re-running the state pass picks up the committed page's colour.
+  mini_toolbar_->UpdateState(split_is_active_, split_is_highlighted_);
+  mini_toolbar_->SchedulePaint();
+  if (container_outline_) {
+    container_outline_->SchedulePaint();
+  }
+}
+
+void ContentsContainerView::UpdateSplitPaneShadow() {
+  if (!is_in_split_) {
+    split_pane_shadow_.reset();
+    if (split_pane_shadow_host_) {
+      RemoveChildViewT(split_pane_shadow_host_.ExtractAsDangling());
+      split_pane_shadow_host_ = nullptr;
+    }
+    return;
+  }
+
+  if (!split_pane_shadow_host_) {
+    // A layer-only, event-transparent child that hosts the shadow layer. It is
+    // added first so it sits behind every other child.
+    auto host = std::make_unique<views::View>();
+    host->SetPaintToLayer(ui::LAYER_NOT_DRAWN);
+    host->layer()->SetFillsBoundsOpaquely(false);
+    host->SetCanProcessEventsWithinSubtree(false);
+    split_pane_shadow_host_ = AddChildViewAt(std::move(host), 0);
+  }
+  split_pane_shadow_host_->SetBoundsRect(GetLocalBounds());
+
+  if (!split_pane_shadow_) {
+    split_pane_shadow_ = std::make_unique<ui::Shadow>();
+    split_pane_shadow_->Init(kSplitPaneShadowElevation);
+    split_pane_shadow_->SetRoundedCornerRadius(kSplitPaneShadowCornerRadius);
+    split_pane_shadow_->layer()->SetName("Split Pane Shadow");
+    split_pane_shadow_host_->layer()->Add(split_pane_shadow_->layer());
+  }
+
+  gfx::Rect content_bounds = GetLocalBounds();
+  content_bounds.Inset(gfx::Insets(kSplitViewContentPadding));
+  split_pane_shadow_->SetContentBounds(content_bounds);
+}
+
