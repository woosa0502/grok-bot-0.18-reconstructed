+// Aside: after the user changes a site permission in the Page Info bubble, the
+// original browser replaces Chromium's permission-change infobar with a small
+// bubble anchored under the page-info icon: "Reload this page to apply your
+// updated settings on this site" plus a "Reload" action button.
+//
+// Restores the original browser's PageInfoReloadBubbleView
+// (chrome/browser/ui/views/page_info/page_info_reload_bubble_view.{h,cc}).
+class PageInfoReloadBubbleView : public views::BubbleDialogDelegateView,
+                                 public content::WebContentsObserver {
+  METADATA_HEADER(PageInfoReloadBubbleView, views::BubbleDialogDelegateView)
+
+ public:
+  // Shows the bubble anchored at `anchor_view` for `web_contents`. Closes any
+  // bubble that is already showing. Does nothing without an anchor or contents.
+  static void ShowBubble(views::View* anchor_view,
+                         content::WebContents* web_contents);
+
+  // Closes the bubble if one is showing.
+  static void HideBubble();
+
+  // The bubble that is currently showing, or nullptr.
+  static PageInfoReloadBubbleView* GetBubbleForTesting();
+
+  PageInfoReloadBubbleView(const PageInfoReloadBubbleView&) = delete;
+  PageInfoReloadBubbleView& operator=(const PageInfoReloadBubbleView&) = delete;
+  ~PageInfoReloadBubbleView() override;
+
+  views::MdTextButton* action_button_for_testing() { return action_button_; }
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+
+ private:
+  PageInfoReloadBubbleView(views::BubbleAnchor anchor,
+                           content::WebContents* web_contents);
+
+  // Reloads the page the bubble was opened for and closes the bubble.
+  void ShowAction();
+
+  raw_ptr<views::MdTextButton> action_button_ = nullptr;
+
+  base::WeakPtrFactory<PageInfoReloadBubbleView> weak_factory_{this};
+};
+
