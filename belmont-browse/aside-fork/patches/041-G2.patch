+
+TabExpandChevronView::TabExpandChevronView() {
+  SetHorizontalAlignment(views::ImageViewBase::Alignment::kTrailing);
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+TabExpandChevronView::~TabExpandChevronView() = default;
+
+void TabExpandChevronView::SetExpanded(bool expanded) {
+  if (expanded_ == expanded) {
+    return;
+  }
+  expanded_ = expanded;
+  RefreshIcon();
+  OnPropertyChanged(&expanded_, views::PropertyEffects::kPaint);
+}
+
+bool TabExpandChevronView::GetExpanded() const {
+  return expanded_;
+}
+
+void TabExpandChevronView::SetIconColor(SkColor color) {
+  if (icon_color_ == color) {
+    return;
+  }
+  icon_color_ = color;
+  RefreshIcon();
+  OnPropertyChanged(&icon_color_, views::PropertyEffects::kPaint);
+}
+
+SkColor TabExpandChevronView::GetIconColor() const {
+  return icon_color_;
+}
+
+void TabExpandChevronView::SetIconSize(int size) {
+  if (icon_size_ == size) {
+    return;
+  }
+  icon_size_ = size;
+  RefreshIcon();
+  OnPropertyChanged(&icon_size_, views::PropertyEffects::kPreferredSizeChanged);
+}
+
+int TabExpandChevronView::GetIconSize() const {
+  return icon_size_;
+}
+
+void TabExpandChevronView::RefreshIcon() {
+  const bool rounded = features::IsRoundedIconsEnabled();
+  const gfx::VectorIcon& icon =
+      expanded_ ? (rounded ? kKeyboardArrowUpIcon
+                           : kKeyboardArrowUpChromeRefreshOldIcon)
+                : (rounded ? kKeyboardArrowDownIcon
+                           : kKeyboardArrowDownChromeRefreshOldIcon);
+  SetImage(ui::ImageModel::FromVectorIcon(icon, icon_color_, icon_size_));
+}
+
+BEGIN_METADATA(TabExpandChevronView)
