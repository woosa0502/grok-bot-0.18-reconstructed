+void MultiContentsViewDropTargetController::HideFloatingTabDragView() {
+  if (!floating_tab_drag_view_) {
+    return;
+  }
+  views::View* const parent = floating_tab_drag_view_->parent();
+  views::View* const view = floating_tab_drag_view_.ExtractAsDangling();
+  if (parent) {
+    parent->RemoveChildViewT(view);
+  }
