+// --- Aside restoration: FloatingTabDragView --------------------------------
+
+void MultiContentsViewDropTargetController::ShowFloatingTabDragView(
+    const DragSessionData& drag_data,
+    const gfx::Point& point_in_parent) {
+  content::WebContents* dragged_contents = nullptr;
+  for (const TabDragData& tab : drag_data.tab_drag_data_) {
+    if (tab.contents) {
+      dragged_contents = tab.contents;
+      break;
+    }
+  }
+  if (!dragged_contents) {
+    HideFloatingTabDragView();
+    return;
+  }
+
+  if (!floating_tab_drag_view_) {
+    floating_tab_drag_view_ = drop_target_parent_view_->AddChildView(
+        std::make_unique<FloatingTabDragView>());
+  }
+  auto* const view =
+      views::AsViewClass<FloatingTabDragView>(floating_tab_drag_view_);
+  view->SetDraggedContents(dragged_contents);
+  view->MoveToPoint(point_in_parent);
+  view->SetVisible(true);
+}
