+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/layout_provider.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The bubble currently on screen, if any. There is at most one.
+PageInfoReloadBubbleView* g_reload_bubble = nullptr;
+
+// The width the original browser gives the reload bubble body.
+constexpr int kBubbleWidth = 320;
+
+}  // namespace
+
+// static
+void PageInfoReloadBubbleView::ShowBubble(views::View* anchor_view,
+                                          content::WebContents* web_contents) {
+  if (!anchor_view || !web_contents) {
+    return;
+  }
+  HideBubble();
+
+  auto* bubble = new PageInfoReloadBubbleView(
+      views::BubbleAnchor(anchor_view), web_contents);
+  g_reload_bubble = bubble;
+  views::Widget* const widget =
+      views::BubbleDialogDelegateView::CreateBubble(bubble);
+  widget->ShowInactive();
+}
+
+// static
+void PageInfoReloadBubbleView::HideBubble() {
+  if (g_reload_bubble && g_reload_bubble->GetWidget()) {
+    g_reload_bubble->GetWidget()->Close();
+  }
+  g_reload_bubble = nullptr;
+}
+
+// static
+PageInfoReloadBubbleView* PageInfoReloadBubbleView::GetBubbleForTesting() {
+  return g_reload_bubble;
+}
+
+PageInfoReloadBubbleView::PageInfoReloadBubbleView(
+    views::BubbleAnchor anchor,
+    content::WebContents* web_contents)
+    : views::BubbleDialogDelegateView(anchor,
+                                      views::BubbleBorder::TOP_LEFT,
+                                      views::BubbleBorder::DIALOG_SHADOW,
+                                      /*autosize=*/false),
+      content::WebContentsObserver(web_contents) {
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  SetShowCloseButton(true);
+  // The location bar takes focus back right after the Page Info bubble closes,
+  // which would deactivate (and so close) this bubble immediately. The prompt
+  // is passive: it stays until the user acts on it or the page navigates.
+  set_close_on_deactivate(false);
+  set_margins(views::LayoutProvider::Get()->GetDialogInsetsForContentType(
+      views::DialogContentType::kText, views::DialogContentType::kControl));
+
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      views::LayoutProvider::Get()->GetDistanceMetric(
+          views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+
+  auto* label = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_PAGE_INFO_INFOBAR_TEXT),
+      views::style::CONTEXT_DIALOG_BODY_TEXT, views::style::STYLE_PRIMARY));
+  label->SetMultiLine(true);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetMaximumWidth(kBubbleWidth);
+
+  // Aside: the original names this child "ActionButton".
+  auto action_button = std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&PageInfoReloadBubbleView::ShowAction,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_PAGE_INFO_INFOBAR_BUTTON));
+  action_button->SetStyle(ui::ButtonStyle::kProminent);
+  action_button_ = AddChildView(std::move(action_button));
+}
+
+PageInfoReloadBubbleView::~PageInfoReloadBubbleView() {
+  if (g_reload_bubble == this) {
+    g_reload_bubble = nullptr;
+  }
+}
+
+void PageInfoReloadBubbleView::ShowAction() {
+  content::WebContents* const contents = web_contents();
+  if (contents) {
+    contents->GetController().Reload(content::ReloadType::NORMAL,
+                                     /*check_for_repost=*/true);
+  }
+  if (GetWidget()) {
+    GetWidget()->CloseWithReason(
+        views::Widget::ClosedReason::kAcceptButtonClicked);
+  }
+}
+
+void PageInfoReloadBubbleView::PrimaryPageChanged(content::Page& page) {
+  // The reason for the prompt is gone once the page navigates.
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void PageInfoReloadBubbleView::WebContentsDestroyed() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+BEGIN_METADATA(PageInfoReloadBubbleView)
+END_METADATA
