+void AsideProfileMenuView::OnDeleteProfile(const base::FilePath& path) {
+  std::u16string name;
+  if (ProfileAttributesEntry* entry = EntryForPath(path)) {
+    name = entry->GetName();
+  }
+  const std::u16string body =
+      name.empty() ? std::u16string(kThisProfileRemoved)
+                   : base::StrCat({kQuote, name, kWillBeRemoved});
+  auto delegate = std::make_unique<ProfileDialogDelegate>(path);
+  ProfileDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteProfileTitle)
+          .SetInternalName("AsideProfileMenuDeleteProfile")
+          .AddParagraph(ui::DialogModelLabel(body))
+          .AddOkButton(
+              base::BindOnce(&ProfileDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  Browser* browser = browser_;
+  CloseBubble();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void AsideProfileMenuView::OnSignOut() {
+  aside::ShowExtensionPage(
+      browser_, aside::ExtensionPageUrl(browser_->profile(), kNewTabPage,
+                                        kSettingsAccountRoute));
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnPickIndicatorIcon(const std::string& icon_name) {
+  if (ProfileAttributesEntry* entry =
+          EntryForPath(browser_->profile()->GetPath())) {
+    // Picking the current icon again clears it (back to the monogram).
+    entry->SetAsideProfileIndicatorIcon(
+        entry->GetAsideProfileIndicatorIcon() == icon_name ? std::string()
+                                                           : icon_name);
+  }
+  if (avatar_) {
+    avatar_->Refresh();
+  }
+  ShowPage(Page::kIconPicker);
+}
+
+void AsideProfileMenuView::OnToggleRemoteDebugging() {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state ||
+      !local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed)) {
+    return;
+  }
+  local_state->SetBoolean(
+      prefs::kDevToolsRemoteDebuggingEnabled,
+      !local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled));
+  ShowPage(Page::kAdvanced);
+}
+
+void AsideProfileMenuView::OnToggleExternalAiControl() {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return;
+  }
+  local_state->SetBoolean(kAllowExternalAiControlPref,
+                          !local_state->GetBoolean(kAllowExternalAiControlPref));
+  ShowPage(Page::kAdvanced);
+}
+
+void AsideProfileMenuView::OnRestoreClosedTab(int session_id) {
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(browser_->profile());
+  if (service) {
+    service->RestoreEntryById(browser_->GetFeatures().live_tab_context(),
+                              SessionID::FromSerializedValue(session_id),
+                              WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  }
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnOpenDownload(uint32_t download_id) {
+  content::DownloadManager* manager =
+      browser_->profile()->GetDownloadManager();
+  if (manager) {
+    if (download::DownloadItem* item = manager->GetDownload(download_id)) {
+      item->OpenDownload();
+    }
+  }
+  CloseBubble();
+}
+
+BEGIN_METADATA(AsideProfileMenuView)
+END_METADATA
