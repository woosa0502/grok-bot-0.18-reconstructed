+
+class ProfileAttributesEntry;
+
+namespace gfx {
+struct VectorIcon;
+}
+
+namespace aside {
+
+// One entry of the "Change icon" grid. `name` is the original English label
+// (also what is written to the profile attribute).
+struct ProfileIndicatorIcon {
+  // RAW_PTR_EXCLUSION: constexpr table of never-freed vector icon singletons.
+  RAW_PTR_EXCLUSION const char* name;
+  RAW_PTR_EXCLUSION const gfx::VectorIcon* icon;
+};
+
+// The 47 indicator icons, in the original's order (Sun … Bubble).
+base::span<const ProfileIndicatorIcon> ProfileIndicatorIcons();
+
+// nullptr when `name` is empty or unknown.
+const gfx::VectorIcon* ProfileIndicatorIconByName(std::string_view name);
+
+}  // namespace aside
+
+class ProfileMonogramAvatarView : public views::View {
+  METADATA_HEADER(ProfileMonogramAvatarView, views::View)
+
+ public:
+  // `size` is the diameter of the circle in DIP.
+  ProfileMonogramAvatarView(const base::FilePath& profile_path, int size);
+  ProfileMonogramAvatarView(const ProfileMonogramAvatarView&) = delete;
+  ProfileMonogramAvatarView& operator=(const ProfileMonogramAvatarView&) =
+      delete;
+  ~ProfileMonogramAvatarView() override;
+
+  // Re-reads the profile's name, colors and indicator icon.
+  void Refresh();
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+
+ private:
+  ProfileAttributesEntry* Entry() const;
+
+  base::FilePath profile_path_;
+  int size_;
+  std::u16string monogram_;
+  std::string indicator_icon_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_PROFILE_MONOGRAM_AVATAR_VIEW_H_
