+ExtensionFunction::ResponseAction AsideBrowserPreferencesGetSyncStatusFunction::Run() {
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  base::DictValue dict;
+  syncer::SyncService* sync = SyncServiceFactory::GetForProfile(profile);
+  dict.Set("isSyncActive", sync && sync->IsSyncFeatureActive());
+  // Kept for the older settings bundle that reads isSyncing.
+  dict.Set("isSyncing", sync && sync->IsSyncFeatureActive());
+  if (!sync) {
+    dict.Set("transportState", "disabled");
+    base::ListValue reasons;
+    reasons.Append("not_signed_in");
+    dict.Set("disableReasons", std::move(reasons));
+    return RespondNow(WithArguments(std::move(dict)));
+  }
+  std::string device_name;
+  if (syncer::DeviceInfoSyncService* device_info_service =
+          DeviceInfoSyncServiceFactory::GetForProfile(profile)) {
+    if (syncer::LocalDeviceInfoProvider* provider =
+            device_info_service->GetLocalDeviceInfoProvider()) {
+      if (const syncer::DeviceInfo* info = provider->GetLocalDeviceInfo()) {
+        device_name = info->client_name();
+      }
+    }
+  }
+  dict.Set("deviceName", device_name);
+  // RE 0x4917bbf: right after deviceName the original writes a "platform" key.
+  // Its value is the literal "macos" because the original browser only ships on
+  // macOS; this build reports the platform it is actually running on so the
+  // settings page hides the rows (dock, keychain) that do not exist here.
+  dict.Set("platform", AsidePlatformToken());
+  dict.Set("transportState",
+           AsideTransportStateToken(sync->GetTransportState()));
+  // RE 0x4918051 / 0x49180c1: the original always writes userActionableError,
+  // using "none" when there is no error and "unknown" for a value it does not
+  // recognise.
+  const char* error =
+      AsideUserActionableErrorToken(sync->GetUserActionableError());
+  dict.Set("userActionableError", error ? error : "unknown");
+  base::ListValue reasons;
+  const syncer::SyncService::DisableReasonSet disable_reasons =
+      sync->GetDisableReasons();
+  if (disable_reasons.Has(
+          syncer::SyncService::DISABLE_REASON_ENTERPRISE_POLICY)) {
+    reasons.Append("enterprise_policy");
+  }
+  if (disable_reasons.Has(syncer::SyncService::DISABLE_REASON_NOT_SIGNED_IN)) {
+    reasons.Append("not_signed_in");
+  }
+  if (disable_reasons.Has(
+          syncer::SyncService::DISABLE_REASON_UNRECOVERABLE_ERROR)) {
+    reasons.Append("unrecoverable_error");
+  }
+  dict.Set("disableReasons", std::move(reasons));
+  const base::Time last_synced = sync->GetLastSyncedTimeForDebugging();
+  if (!last_synced.is_null()) {
+    dict.Set("lastSyncedAt", last_synced.InMillisecondsFSinceUnixEpoch());
+  }
+  return RespondNow(WithArguments(std::move(dict)));
+}
