+// Aside's own account block inside chrome://settings.  The original adds these
+// eight entries between AddOnStartupStrings() and AddPeopleStrings(); the
+// literals are hard-coded English rather than grit strings, so the names and
+// values below are exactly the original's (RE: Aside 1.0.825.1 x86_64
+// @0x4bddbd3..0x4bddf41; the deep link is built from the extension id literal
+// at 0xd9b39a0 and the path literal at 0xe1aad40, with "?accountId=" appended
+// when the profile has a non-negative "aside.account_id" pref).
+void AddAsideAccountStrings(content::WebUIDataSource* html_source,
+                            Profile* profile) {
+  html_source->AddString("asideAccountBadgeLabel", "Aside Account");
+  html_source->AddString("asideAccountSignedInLabel", "Signed in to Aside");
+  html_source->AddString("asideAccountSettingsRowLabel",
+                         "Aside account settings");
+  html_source->AddString("manageAsideAccount", "Manage Aside Account");
+  html_source->AddString("asideAccountNotSyncedYet", "Not synced yet");
+  html_source->AddString("asideAccountWaitingForFirstSync",
+                         "Waiting for first sync...");
+  html_source->AddString("asideAccountSyncErrorPrefix", "Sync Error: $1");
+
+  static constexpr char kAsideExtensionId[] =
+      "fjdhphbdlfjogobdofoaagnlnkoibdge";
+  static constexpr char kAsideAccountSettingsPath[] =
+      "/newtab.html#/settings/account";
+  std::string path(kAsideAccountSettingsPath);
+  if (profile && !profile->IsOffTheRecord()) {
+    PrefService* prefs = profile->GetPrefs();
+    if (prefs && prefs->FindPreference("aside.account_id")) {
+      const int account_id = prefs->GetInteger("aside.account_id");
+      if (account_id >= 0) {
+        path += "?accountId=" + base::NumberToString(account_id);
+      }
+    }
+  }
+  html_source->AddString(
+      "asideAccountSettingsUrl",
+      std::string("chrome-extension://") + kAsideExtensionId + path);
+  // Not one of the original's eight names: the page needs to know which of the
+  // three status strings to show, and the original gets that from the
+  // extension.  Derived here from the same pref the deep link uses.
+  html_source->AddBoolean(
+      "asideAccountSignedIn",
+      profile && !profile->IsOffTheRecord() && profile->GetPrefs() &&
+          profile->GetPrefs()->FindPreference("aside.account_id") &&
+          profile->GetPrefs()->GetInteger("aside.account_id") >= 0);
+}
