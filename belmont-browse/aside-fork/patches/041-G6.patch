+
+void AsideOmniboxSearchboxPage::OnContextualInputStatusChanged(
+    const ::base::UnguessableToken& token,
+    ::contextual_search::ContextUploadStatus status,
+    std::optional<::contextual_search::ContextUploadErrorType> error_type) {
+  base::DictValue details;
+  details.Set("contextToken", token.ToString());
+  details.Set("status", static_cast<int>(status));
+  if (error_type) {
+    details.Set("errorType", static_cast<int>(*error_type));
+  }
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onContextualInputStatusChanged",
+                     std::move(details));
