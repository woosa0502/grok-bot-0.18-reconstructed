+    : browser_(browser) {
+  SetOrientation(views::BoxLayout::Orientation::kVertical);
+  SetInsideBorderInsets(gfx::Insets::VH(8, 8));
+  SetBetweenChildSpacing(2);
+  SetMinimumCrossAxisSize(kMenuWidth);  // width; height from content
+  BuildHeader();
+  AddChildView(std::make_unique<views::Separator>());
+  body_ = AddChildView(std::make_unique<AsideMenuPanel>());
+  ShowPage(Page::kRoot);
+}
