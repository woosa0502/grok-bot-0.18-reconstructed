+// One omnibox autocomplete session: owns an AutocompleteController, drives it,
+// and forwards results to the extension as asideOmnibox.onAutocompleteResultChanged.
+class AsideOmniboxSession : public AutocompleteController::Observer {
+ public:
+  AsideOmniboxSession(Profile* profile,
+                      content::BrowserContext* browser_context,
+                      std::string session_id,
+                      std::string extension_id);
+  AsideOmniboxSession(const AsideOmniboxSession&) = delete;
+  AsideOmniboxSession& operator=(const AsideOmniboxSession&) = delete;
+  ~AsideOmniboxSession() override;
+
+  // `cursor_position` mirrors searchbox.mojom PageHandler::QueryAutocomplete's
+  // parameter of the same name (RE 0x405bb40 reads "cursorPosition").  Like
+  // upstream it is clamped to the input length.
+  void Query(const std::string& input_text, bool prevent_inline = false,
+             std::optional<uint32_t> cursor_position = std::nullopt);
+  void Stop(bool clear_result);
+  void DeleteMatch(size_t line);
+  void SetToolMode(std::string mode);
+  void SetModelMode(std::string mode);
+  void SetSelection(base::DictValue selection);
+  // Records the two flags searchbox.mojom's OpenAutocompleteMatch carries
+  // besides the click state: `are_matches_showing` is the popup-open bit
+  // OmniboxLog calls is_popup_open, and `via_keyboard` says the match was
+  // opened from the keyboard rather than a pointer.  Opening a match also
+  // ends the query, the way OmniboxEditModel::OpenMatch does.
+  void NoteMatchOpened(bool are_matches_showing, bool via_keyboard);
+  bool matches_were_showing() const { return matches_were_showing_; }
+  bool opened_via_keyboard() const { return opened_via_keyboard_; }
+
+  const std::string& last_input() const { return last_input_; }
+  const std::string& extension_id() const { return extension_id_; }
+  const std::string& session_id() const { return session_id_; }
+  int target_tab_id() const { return target_tab_id_; }
+  void SetTarget(content::WebContents* target, int tab_id);
+  content::WebContents* target() const { return target_.get(); }
+  AsideOmniboxContextStore& contexts() { return contexts_; }
+  bool ActivateKeyword(const std::u16string& keyword);
+  const std::u16string& keyword() const { return keyword_; }
+  bool ExecuteAction(size_t line, size_t action_index,
+                     WindowOpenDisposition disposition, OmniboxClient* client);
+  void Dispatch(const std::string& name, base::DictValue details);
+
+  const AutocompleteResult& result() const;
+  double result_sequence_id() const {
+    return static_cast<double>(result_sequence_id_);
+  }
+  const std::string& tool_mode() const { return tool_mode_; }
+  const std::string& model_mode() const { return model_mode_; }
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+
+ private:
+  raw_ptr<Profile> profile_;
+  raw_ptr<content::BrowserContext> browser_context_;
+  std::string session_id_;
+  std::string extension_id_;
+  base::WeakPtr<content::WebContents> target_;
+  std::unique_ptr<AutocompleteController> controller_;
+  std::string last_input_;
+  std::string tool_mode_;
+  std::string model_mode_;
+  base::DictValue selection_;
+  uint64_t result_sequence_id_ = 0;
+  bool matches_were_showing_ = false;
+  bool opened_via_keyboard_ = false;
+  int target_tab_id_ = -1;
+  AsideOmniboxContextStore contexts_;
+  // The browser-side searchbox::mojom::Page endpoint the original binds from
+  // this API (see aside_omnibox_searchbox_page.h).  Mirrors the searchbox
+  // WebUI's autocomplete results into this session.
+  std::unique_ptr<AsideOmniboxSearchboxPage> searchbox_page_;
+  std::u16string keyword_;
+  base::WeakPtrFactory<AsideOmniboxSession> weak_factory_{this};
+};
+
+}  // namespace extensions
