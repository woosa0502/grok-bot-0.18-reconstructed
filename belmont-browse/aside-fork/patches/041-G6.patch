+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_TOOLBAR_COLLAPSE_HOVER_MONITOR_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_TOOLBAR_COLLAPSE_HOVER_MONITOR_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace views {
+class View;
+}
+
+// While the collapsed vertical tab strip is showing its hover preview, the
+// pointer can sit on the collapse button or on the strip's outer edge without
+// the strip receiving another mouse-move.  Upstream then re-evaluates the
+// hover state only on the next event, so the preview closes under the pointer.
+//
+// The original fixes this with a polling timer:
+// VerticalTabStripRegionView::StartToolbarCollapseButtonHoverMonitorTimer
+// (vertical_tab_strip_region_view.cc:11840 in Aside 1.0.825.1; RE @0x4cd8470 —
+// a base::RepeatingTimer started only while the preview flag at +0x99b is set,
+// with a 100000 us period, and left running until the preview goes away).
+//
+// This class is that timer.  It is deliberately standalone so the region view
+// only needs a member and two call sites.
+class AsideToolbarCollapseHoverMonitor {
+ public:
+  // The original's period: 0x186a0 us.
+  static constexpr base::TimeDelta kInterval = base::Milliseconds(100);
+
+  // The original does not close the preview the moment the poll first sees the
+  // pointer outside; it arms a second, one-shot timer and closes only when
+  // that fires -- VerticalTabStripRegionView::
+  // StartToolbarCollapseButtonHoverExitTimer (vertical_tab_strip_region_view.cc
+  // :11817 in Aside 1.0.825.1; RE @0x4cc8e00 -- a timer started with a 0x7a120
+  // us delay, guarded by an "already running" check).  Without it a pointer
+  // crossing a one-pixel gap between the strip and its collapse button closes
+  // the preview.
+  static constexpr base::TimeDelta kExitDelay = base::Milliseconds(500);
+
+  // `on_tick` is run every `kInterval` while the monitor is running.  It is
+  // handed whether the pointer is currently inside `watched` or inside any of
+  // the extra views registered by the owner.
+  using TickCallback = base::RepeatingCallback<void(bool pointer_inside)>;
+
+  AsideToolbarCollapseHoverMonitor();
+  AsideToolbarCollapseHoverMonitor(const AsideToolbarCollapseHoverMonitor&) =
+      delete;
+  AsideToolbarCollapseHoverMonitor& operator=(
+      const AsideToolbarCollapseHoverMonitor&) = delete;
+  ~AsideToolbarCollapseHoverMonitor();
+
+  // Starts the timer if it is not already running.  A second call while the
+  // timer runs is a no-op, matching the original's IsRunning() early return.
+  void Start(const views::View* region, const views::View* collapse_button,
+             TickCallback on_tick);
+  void Stop();
+  bool IsRunning() const;
+
+  // Arms the exit timer if it is not already armed; `on_exit` runs once,
+  // `kExitDelay` later, unless CancelExit() gets there first.  A second call
+  // while it is armed is a no-op, matching the original's early return.
+  void StartExit(base::OnceClosure on_exit);
+  void CancelExit();
+  bool IsExitPending() const;
+
+  // Whether the pointer is inside `region` or `collapse_button` right now.
+  // Exposed for the region view's own hover computation and for tests.
+  static bool IsPointerInside(const views::View* region,
+                              const views::View* collapse_button);
+
+ private:
+  void OnTick();
+
+  base::RepeatingTimer timer_;
+  base::OneShotTimer exit_timer_;
+  raw_ptr<const views::View> region_ = nullptr;
+  raw_ptr<const views::View> collapse_button_ = nullptr;
+  TickCallback on_tick_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_TOOLBAR_COLLAPSE_HOVER_MONITOR_H_
