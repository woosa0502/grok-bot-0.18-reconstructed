+// Adds a "◀ <title>" row that walks back to `parent`.
+views::View* AddBackRow(views::View* body,
+                        const std::u16string& title,
+                        views::Button::PressedCallback callback) {
+  auto back = std::make_unique<AsideMenuItemButton>(
+      std::move(callback), title, &kAsideBackArrowChromeRefreshIcon);
+  back->SetLabelFontList(aside::UiFontList(13, gfx::Font::Weight::MEDIUM));
+  views::View* view = body->AddChildView(std::move(back));
+  body->AddChildView(std::make_unique<views::Separator>());
+  return view;
+}
