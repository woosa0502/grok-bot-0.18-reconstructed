+
+namespace {
+
+constexpr char kEnabledPref[] = "aside.vertical_tabs.bookmarks_section_enabled";
+constexpr char kExpandedPref[] =
+    "aside.vertical_tabs.bookmarks_section_expanded";
+constexpr char kExpandedFoldersPref[] =
+    "aside.vertical_tabs.expanded_bookmark_folder_ids";
+constexpr char16_t kBookmarksTitle[] = u"Bookmarks";
+// Original UTF-16 literal 0xd77adaa: the empty-state row under the header.
+constexpr char16_t kEmptyState[] = u"Drag tabs here to add bookmarks";
+constexpr int kIndent = 14;
+constexpr int kMaxRows = 40;
+
+// Folder row menu (RE 0x43c2700: AddItem(1,"Rename"), AddItem(2,"Delete"),
+// AddSeparator(NORMAL), AddItem(3,"Manage Bookmarks")).
+enum FolderMenuCommand {
+  kFolderRename = 1,
+  kFolderDelete = 2,
+  kManageBookmarks = 3,
+};
+
+// Bookmark row menu (RE 0x43c2b80-0x43c2ee0: command ids 0x64..0x6a in this
+// order, with one separator after "Delete").
+enum BookmarkMenuCommand {
+  kBookmarkEdit = 0x64,
+  kBookmarkDelete = 0x65,
+  kBookmarkOpenIncognito = 0x66,
+  kBookmarkOpenNewTabGroup = 0x67,
+  kBookmarkOpenNewTab = 0x68,
+  kBookmarkOpenNewWindow = 0x69,
+  kBookmarkOpenSplitView = 0x6a,
+};
+
+// Original UTF-16 literals, arm64 0xd77ab0c-0xd77abf8.
+constexpr char16_t kRename[] = u"Rename";
+constexpr char16_t kDelete[] = u"Delete";
+constexpr char16_t kManageBookmarksLabel[] = u"Manage Bookmarks";
+constexpr char16_t kEdit[] = u"Edit";
+constexpr char16_t kOpenInIncognitoWindow[] = u"Open in Incognito window";
+constexpr char16_t kOpenInNewTabGroup[] = u"Open in new tab group";
+constexpr char16_t kOpenInNewTab[] = u"Open in new tab";
+constexpr char16_t kOpenInNewWindow[] = u"Open in new window";
+constexpr char16_t kOpenInSplitView[] = u"Open in split view";
+
+}  // namespace
+
+AsideBookmarksSectionView::AsideBookmarksSectionView(Browser* browser)
+    : browser_(browser) {
+  SetOrientation(views::BoxLayout::Orientation::kVertical);
+  SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+
+  header_ = AddChildView(std::make_unique<AsideTextButton>(
+      base::BindRepeating(&AsideBookmarksSectionView::ToggleSection,
+                          base::Unretained(this)),
+      kBookmarksTitle, views::style::CONTEXT_BUTTON_MD));
+  header_->SetStyle(ui::ButtonStyle::kText);
+  header_->SetCustomPadding(gfx::Insets::VH(4, 8));
+  header_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  header_->SetLabelStyle(views::style::STYLE_BODY_4_BOLD);
+  header_->SetImageLabelSpacing(4);
+  header_->SetLabelFontList(
+      aside::UiFontList(12, gfx::Font::Weight::SEMIBOLD));
+
+  auto rows = std::make_unique<views::BoxLayoutView>();
+  rows->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  rows->SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+  rows_ = AddChildView(std::move(rows));
+
+  auto empty = std::make_unique<views::Label>(kEmptyState);
+  empty->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  empty->SetMultiLine(true);
+  empty->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+  empty->SetFontList(aside::UiFontList(12));
+  empty->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(2, 10, 6, 8)));
+  empty_label_ = AddChildView(std::move(empty));
+
+  model_ = BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  if (model_) {
+    model_->AddObserver(this);
+  }
+  pref_registrar_.Init(browser_->profile()->GetPrefs());
+  auto rebuild = base::BindRepeating(&AsideBookmarksSectionView::Rebuild,
+                                     base::Unretained(this));
+  pref_registrar_.Add(kEnabledPref, rebuild);
+  pref_registrar_.Add(kExpandedPref, rebuild);
+  pref_registrar_.Add(kExpandedFoldersPref, rebuild);
+  tab_representation_ =
+      std::make_unique<AsideBookmarkTabRepresentation>(browser_);
+  tab_representation_subscription_ =
+      tab_representation_->AddChangedCallback(rebuild);
+  Rebuild();
+}
+
+AsideBookmarksSectionView::~AsideBookmarksSectionView() {
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+}
+
+void AsideBookmarksSectionView::BookmarkModelChanged() {
+  Rebuild();
+}
+
+std::set<std::string> AsideBookmarksSectionView::ExpandedFolderIds() const {
+  std::set<std::string> ids;
+  for (const base::Value& v :
+       browser_->profile()->GetPrefs()->GetList(kExpandedFoldersPref)) {
+    if (v.is_string()) {
+      ids.insert(v.GetString());
+    }
+  }
+  return ids;
+}
+
+bool AsideBookmarksSectionView::IsFolderExpanded(int64_t folder_id) const {
+  return ExpandedFolderIds().contains(base::NumberToString(folder_id));
+}
+
+void AsideBookmarksSectionView::Rebuild() {
+  PrefService* prefs = browser_->profile()->GetPrefs();
+  const bool enabled = prefs->GetBoolean(kEnabledPref);
+  const bool expanded = prefs->GetBoolean(kExpandedPref);
+  SetVisible(enabled && model_ && model_->loaded());
+  header_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(expanded ? kAsideExpandMoreIcon
+                                              : kAsideChevronRightMediumStrokeIcon,
+                                     ui::kColorIcon, 14));
+  rows_->RemoveAllChildViews();
+  row_nodes_.clear();
+  rows_->SetVisible(expanded);
+  if (enabled && expanded && model_ && model_->loaded()) {
+    AddNodeRows(model_->bookmark_bar_node(), 0);
+  }
+  // The original shows "Drag tabs here to add bookmarks" only while the section
+  // is open and holds nothing.
+  empty_label_->SetVisible(expanded && rows_->children().empty());
+  InvalidateLayout();
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
+
+void AsideBookmarksSectionView::AddNodeRows(const bookmarks::BookmarkNode* node,
+                                            int depth) {
+  if (!node) {
+    return;
+  }
+  for (const auto& child : node->children()) {
+    if (rows_->children().size() >= kMaxRows) {
+      return;
+    }
+    const bool folder = child->is_folder();
+    const bool open = folder && IsFolderExpanded(child->id());
+    auto* row = rows_->AddChildView(std::make_unique<AsideTextButton>(
+        folder ? base::BindRepeating(&AsideBookmarksSectionView::ToggleFolder,
+                                     base::Unretained(this), child->id())
+               : base::BindRepeating(&AsideBookmarksSectionView::OpenBookmark,
+                                     base::Unretained(this), child->id()),
+        child->GetTitle()));
+    row->SetStyle(ui::ButtonStyle::kText);
+    row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    row->SetCustomPadding(gfx::Insets::TLBR(3, 8 + depth * kIndent, 3, 8));
+    row->SetImageLabelSpacing(6);
+    row->SetLabelFontList(aside::UiFontList(13));
+    row->SetTooltipText(folder ? child->GetTitle()
+                               : base::UTF8ToUTF16(child->url().spec()));
+    row->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(
+            folder ? (open ? kAsideExpandMoreIcon : kAsideBookmarkFolderIcon)
+                   : kAsideBookmarkSolidIcon,
+            ui::kColorIcon, 14));
+    // VerticalBookmarkRowView: right click opens the folder or bookmark menu.
+    row->set_context_menu_controller(this);
+    // Aside: a bookmark that points at an open tab represents that tab.  The
+    // original records the pairing under bookmark_tab_representation_node_id /
+    // bookmark_tab_representation_host; here the row shows it and clicking it
+    // activates the tab instead of navigating again.
+    if (!folder && tab_representation_ &&
+        tab_representation_->IsNodeRepresentingOpenTab(child->id())) {
+      // The original tinted this row with a colour id spelled
+      // "kColorIconActive", which Chromium 151 does not define.  Colour ids are
+      // compile-time enum values, so the binary carries no evidence of the
+      // value itself; the one "…IconActive" id Chromium does define
+      // (ui::kColorHelpIconActive) resolves to kColorPrimaryForeground, so
+      // that is what an "active" icon means in this tree - full-strength
+      // foreground against the accent the other rows use.
+      //
+      // The colour has to go through the text colour: these rows are
+      // MdTextButtons, and MdTextButton::UpdateIconColor() re-rasterises any
+      // vector-icon image model with the button's own text colour, so a colour
+      // id passed to SetImageModel() alone is thrown away (which is why the
+      // earlier SetImageModel-only version of this made no visible
+      // difference).
+      row->SetEnabledTextColors(ui::ColorVariant(ui::kColorPrimaryForeground));
+      row->SetTooltipText(base::UTF8ToUTF16(
+          child->url().spec() + "  (" +
+          std::string(AsideBookmarkTabRepresentation::kHostKey) + ": " +
+          tab_representation_->RepresentationForNode(child->id())->host + ")"));
+    }
+    row_nodes_[row] = RowInfo{child->id(), folder};
+    if (open) {
+      AddNodeRows(child.get(), depth + 1);
+    }
+  }
+}
+
+void AsideBookmarksSectionView::ToggleSection() {
+  PrefService* prefs = browser_->profile()->GetPrefs();
+  prefs->SetBoolean(kExpandedPref, !prefs->GetBoolean(kExpandedPref));
+}
+
+void AsideBookmarksSectionView::ToggleFolder(int64_t folder_id) {
+  ScopedListPrefUpdate update(browser_->profile()->GetPrefs(),
+                              kExpandedFoldersPref);
+  const std::string id = base::NumberToString(folder_id);
+  base::ListValue& list = update.Get();
+  if (!list.EraseValue(base::Value(id))) {
+    list.Append(id);
+  }
+}
+
+void AsideBookmarksSectionView::OpenBookmark(int64_t node_id) {
+  OpenBookmarkWith(node_id, WindowOpenDisposition::CURRENT_TAB);
+}
+
+void AsideBookmarksSectionView::OpenBookmarkWith(
+    int64_t node_id,
+    WindowOpenDisposition disposition) {
+  if (!model_) {
+    return;
+  }
+  const bookmarks::BookmarkNode* node =
+      bookmarks::GetBookmarkNodeByID(model_, node_id);
+  if (!node || !node->is_url()) {
+    return;
+  }
+  // Aside: if this bookmark represents an open tab, activate that tab.
+  if (disposition == WindowOpenDisposition::CURRENT_TAB &&
+      tab_representation_) {
+    const std::optional<AsideBookmarkTabRepresentation::Representation>
+        representation = tab_representation_->RepresentationForNode(node_id);
+    if (representation.has_value() && representation->tab_index >= 0 &&
+        representation->tab_index < browser_->tab_strip_model()->count()) {
+      browser_->tab_strip_model()->ActivateTabAt(representation->tab_index);
+      return;
+    }
+  }
+  NavigateParams params(browser_, node->url(),
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = disposition;
+  Navigate(&params);
+}
+
+void AsideBookmarksSectionView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto it = row_nodes_.find(source);
+  if (it == row_nodes_.end()) {
+    return;
+  }
+  pending_menu_ = it->second;
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  if (pending_menu_.is_folder) {
+    menu_model_->AddItem(kFolderRename, kRename);
+    menu_model_->AddItem(kFolderDelete, kDelete);
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItem(kManageBookmarks, kManageBookmarksLabel);
+  } else {
+    menu_model_->AddItem(kBookmarkEdit, kEdit);
+    menu_model_->AddItem(kBookmarkDelete, kDelete);
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    menu_model_->AddItem(kBookmarkOpenIncognito, kOpenInIncognitoWindow);
+    menu_model_->AddItem(kBookmarkOpenNewTabGroup, kOpenInNewTabGroup);
+    menu_model_->AddItem(kBookmarkOpenNewTab, kOpenInNewTab);
+    menu_model_->AddItem(kBookmarkOpenNewWindow, kOpenInNewWindow);
+    menu_model_->AddItem(kBookmarkOpenSplitView, kOpenInSplitView);
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+bool AsideBookmarksSectionView::IsCommandIdChecked(int command_id) const {
+  return false;
+}
+
+bool AsideBookmarksSectionView::IsCommandIdEnabled(int command_id) const {
+  return true;
+}
+
+void AsideBookmarksSectionView::ExecuteCommand(int command_id,
+                                               int event_flags) {
+  const int64_t id = pending_menu_.node_id;
+  switch (command_id) {
+    case kFolderRename:
+      aside::ShowRenameFolderDialog(browser_, id);
+      break;
+    case kFolderDelete:
+      aside::ShowDeleteFolderDialog(browser_, id);
+      break;
+    case kManageBookmarks:
+      chrome::ExecuteCommand(browser_, IDC_SHOW_BOOKMARK_MANAGER);
+      break;
+    case kBookmarkEdit:
+      aside::ShowEditBookmarkDialog(browser_, id);
+      break;
+    case kBookmarkDelete:
+      aside::ShowDeleteBookmarkDialog(browser_, id);
+      break;
+    case kBookmarkOpenIncognito:
+      OpenBookmarkWith(id, WindowOpenDisposition::OFF_THE_RECORD);
+      break;
+    case kBookmarkOpenNewTabGroup: {
+      TabStripModel* model = browser_->tab_strip_model();
+      const int before = model->count();
+      OpenBookmarkWith(id, WindowOpenDisposition::NEW_BACKGROUND_TAB);
+      if (model->count() > before) {
+        model->AddToNewGroup({model->count() - 1});
+      }
+      break;
+    }
+    case kBookmarkOpenNewTab:
+      OpenBookmarkWith(id, WindowOpenDisposition::NEW_FOREGROUND_TAB);
+      break;
+    case kBookmarkOpenNewWindow:
+      OpenBookmarkWith(id, WindowOpenDisposition::NEW_WINDOW);
+      break;
+    case kBookmarkOpenSplitView: {
+      TabStripModel* model = browser_->tab_strip_model();
+      const int before = model->count();
+      OpenBookmarkWith(id, WindowOpenDisposition::NEW_BACKGROUND_TAB);
+      if (model->count() > before) {
+        model->AddToNewSplit({model->count() - 1},
+                             split_tabs::SplitTabVisualData(),
+                             split_tabs::SplitTabCreatedSource::
+                                 kBookmarkContextMenu);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+BEGIN_METADATA(AsideBookmarksSectionView)
+END_METADATA
