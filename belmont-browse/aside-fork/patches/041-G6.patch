+
+void AsideOmniboxSearchboxPage::OnInputStateChanged(
+    const ::omnibox::InputState& input_state) {
+  // The scalar part of omnibox::InputState.  The proto-valued lists are left
+  // out rather than half-translated; an extension that needs them can ask for
+  // the state through asideOmnibox.getInputState.
+  base::DictValue details;
+  details.Set("activeTool", static_cast<int>(input_state.active_tool));
+  details.Set("activeModel", static_cast<int>(input_state.active_model));
+  details.Set("maxTotalInputs", input_state.max_total_inputs);
+  details.Set("hintText", input_state.hint_text);
+  details.Set("allowedToolCount",
+              static_cast<int>(input_state.allowed_tools.size()));
+  details.Set("allowedModelCount",
+              static_cast<int>(input_state.allowed_models.size()));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onInputStateChanged", std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::AddFileContext(
+    const ::base::UnguessableToken& token,
+    searchbox::mojom::SelectedFileInfoPtr file_info) {
+  if (!file_info) {
+    return;
+  }
+  // The searchbox WebUI attached a file; relay its SelectedFileInfo under the
+  // same key names asideOmnibox.addFileContext accepts, so the extension sees
+  // one vocabulary for files it attached and files the searchbox attached.
+  // Only metadata crosses this pipe - the Page method carries no bytes.
+  base::DictValue payload;
+  payload.Set("contextToken", token.ToString());
+  payload.Set("fileName", file_info->file_name);
+  payload.Set("mimeType", file_info->mime_type);
+  if (file_info->image_data_url) {
+    payload.Set("imageDataUrl", *file_info->image_data_url);
+  }
+  payload.Set("isDeletable", file_info->is_deletable);
+  payload.Set("selectionTimeMs", static_cast<double>(
+      file_info->selection_time.InMillisecondsSinceUnixEpoch()));
+  payload.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onFileContextAdded", std::move(payload));
+}
+void AsideOmniboxSearchboxPage::UpdateAutoSuggestedTabContext(
+    searchbox::mojom::TabInfoPtr tab,
+    const std::optional<std::string>& invocation_source) {
+  base::DictValue details;
+  details.Set("tab", TabToDict(tab));
+  if (invocation_source) {
+    details.Set("invocationSource", *invocation_source);
+  }
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAutoSuggestedTabContextChanged",
+                     std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::UpdateLensSearchEligibility(bool eligible) {
+  base::DictValue details;
+  details.Set("eligible", eligible);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onLensSearchEligibilityChanged",
+                     std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::UpdateContentSharingPolicy(bool enabled) {
+  base::DictValue details;
+  details.Set("enabled", enabled);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onContentSharingPolicyChanged",
+                     std::move(details));
+}
+
+void AsideOmniboxSearchboxPage::UpdateAimPopupEligibility(bool eligible) {
+  base::DictValue details;
+  details.Set("eligible", eligible);
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAimEligibilityChanged",
