+ExtensionFunction::ResponseAction AsideOmniboxOpenAutocompleteMatchFunction::Run() {
+  std::optional<api::aside_omnibox::OpenAutocompleteMatch::Params> params =
+      api::aside_omnibox::OpenAutocompleteMatch::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArguments));
+  }
+  std::string error;
+  AsideOmniboxSession* session = FindSession(this, params->session_id, &error);
+  if (!session) {
+    return RespondNow(Error(error));
+  }
+  // RE 0x405c300 (arm64): the body ends in a nine-argument call shaped exactly
+  // like SearchboxHandler::OpenAutocompleteMatch(line, url, areMatchesShowing,
+  // mouseButton, altKey, ctrlKey, metaKey, shiftKey, viaKeyboard).  Upstream's
+  // handler ignores `are_matches_showing` and hands `via_keyboard` to its own
+  // OmniboxEditModel; this session drives its own AutocompleteController and
+  // owns no edit model, so both are recorded on the session instead of being
+  // dropped on the floor.
+  const base::DictValue& request = params->request.additional_properties;
+  const auto* match = MatchFromRequest(session, request);
+  const bool are_matches_showing =
+      request.FindBool("areMatchesShowing").value_or(false);
+  const bool via_keyboard = request.FindBool("viaKeyboard").value_or(false);
+  if (!match) {
+    return RespondNow(Error("Invalid or stale autocomplete match"));
+  }
+  session->NoteMatchOpened(are_matches_showing, via_keyboard);
+  if (!OpenUrl(session, match->destination_url,
+               DispositionFromRequest(request))) {
+    return RespondNow(Error("Invalid or stale autocomplete match"));
+  }
+  return RespondNow(NoArguments());
+}
