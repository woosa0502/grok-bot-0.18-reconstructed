+void ContentsWebView::ScheduleTargetExtensionBodyBackgroundProbe(
+    content::GlobalRenderFrameHostId frame_id) {
+  if (std::ranges::find(pending_background_probes_, frame_id) !=
+      pending_background_probes_.end()) {
+    return;
+  }
+  pending_background_probes_.push_back(frame_id);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ContentsWebView::RunTargetExtensionBodyBackgroundProbe,
+                     weak_factory_.GetWeakPtr(), frame_id),
+      base::Milliseconds(50));
+}
+
+void ContentsWebView::RunTargetExtensionBodyBackgroundProbe(
+    content::GlobalRenderFrameHostId frame_id) {
+  std::erase(pending_background_probes_, frame_id);
+  if (!web_contents()) {
+    return;
+  }
+  content::RenderFrameHost* rfh = web_contents()->GetPrimaryMainFrame();
+  if (!rfh || rfh->GetGlobalId() != frame_id ||
+      !rfh->GetLastCommittedURL().SchemeIs("chrome-extension")) {
+    return;
+  }
+  content::RenderWidgetHostView* rwhv = web_contents()->GetRenderWidgetHostView();
+  if (!rwhv) {
+    return;
+  }
+  const std::optional<SkColor> measured = rwhv->GetBackgroundColor();
+  if (!measured.has_value() || SkColorGetA(*measured) != SK_AlphaOPAQUE) {
+    return;
+  }
+  if (extension_body_background_color_ == measured) {
+    return;
+  }
+  extension_body_background_color_ = measured;
+  if (GetWidget()) {
+    UpdateBackgroundColor();
+  }
+}
