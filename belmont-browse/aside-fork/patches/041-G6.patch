+// Owns the delegate and the widget (CLIENT_OWNS_WIDGET) for one bubble and
+// deletes itself when the bubble closes.
+class AsideProfileMenuController {
+ public:
+  AsideProfileMenuController(views::View* anchor, Browser* browser) {
+    delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, views::BubbleBorder::BOTTOM_LEFT);
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetShowCloseButton(false);
+    delegate_->SetShowTitle(false);
+    delegate_->set_margins(gfx::Insets());
+    delegate_->SetContentsView(std::make_unique<AsideProfileMenuView>(browser));
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(),
+        base::BindOnce(&AsideProfileMenuController::OnClosed,
+                       base::Unretained(this)));
+    widget_->Show();
+  }
+
+ private:
+  void OnClosed(views::Widget::ClosedReason) { delete this; }
+
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+};
