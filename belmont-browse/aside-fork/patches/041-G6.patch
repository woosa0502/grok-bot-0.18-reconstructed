+// found in the LICENSE file.
+//
+// Aside's profile menu (replica of the original
+// chrome/browser/ui/views/profiles/aside_profile_menu_view.cc): an
+// AsideMenuPanel of AsideMenuItemButton rows anchored to the vertical strip's
+// profile footer, with the original's pages —
+//   root          Profiles / Extensions / Bookmarks / Downloads / History /
+//                 Developers / Settings / New Tab / Incognito Window
+//   Profiles      the other profiles + "New profile"
+//   Extensions    "Installed extensions" (or "No installed extensions"),
+//                 "Manage all extensions", "Import extensions"
+//   extension     "Extension settings" / "Manage extension" / "No options"
+//   Bookmarks     "All bookmarks", "Bookmark this tab"
+//   Downloads     recent DownloadItemTextView rows (or "No recent downloads"),
+//                 "Show all downloads"
+//   History       "Recent tabs" (or "No recent tabs"), "All history"
+//   Developers    "Performance", "Task manager", "Developer tools", "Advanced"
+//   Advanced      "Remote debugging", "Allow external AI to control browser"
+//   Profile
+//   actions       "Edit", "Change Icon", "Sign Out"
+//   Change icon   ProfileIndicatorIconPickerPanel (47 ProfileIndicatorIconButtons)
+// plus the "Edit profile" and "Delete profile?" dialogs.
+// RE: regions 0x04bd8b00, 0x04bf8a90, 0x04bf5120 of the 825.1 framework.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
+
