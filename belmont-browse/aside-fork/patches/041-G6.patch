+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_PINNED_ENTRIES_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_PINNED_ENTRIES_VIEW_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/context_menu_controller.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/views/view.h"
+
+class Browser;
+
+// The strip of pinned-tab chips the original puts above the tab list
+// (VerticalPinnedTabEntriesView in vertical_pinned_tab_entries_view.cc and
+// HorizontalPinnedTabEntriesView in horizontal_tab_strip_region_view.cc; each
+// chip is an `EntryView`).
+//
+// Reproduced behaviour and strings, all from the original's UTF-16 literals
+// (arm64 0xd77b0dc-0xd77b1c8):
+//   * click a chip -> "Switch to <title>"
+//   * a discarded tab reads "Paused" / "<title>, Paused"
+//   * context menu: "Remove from pin", then "Add bookmark" / "Remove bookmark"
+//     with the accessible forms "Remove from pin: <title>",
+//     "Add to bookmarks: <title>" and "Remove bookmark: <title>".
+//
+// Chip drag-to-reorder is reproduced from the original's own code:
+// dense region 0x04c65910-0x04c6a320 in the Aside 1.0.825.1 x86_64 slice is the
+// body of HorizontalPinnedTabEntriesView, sitting in the same object file as
+// the metadata block at 0x04c6a630 ("HorizontalPinnedTabEntriesView" and
+// "HorizontalPinnedTabEntriesView::EntryView") and calling that file's
+// FinishEntryDrag four times; the region also calls the pinned-tab service and
+// TabStripModel::ActivateTabAt.  The matching callback names for the vertical
+// twin are PinnedEntryDragGhost, HideEntryDragGhostAfterCaptureLoss and
+// CancelEntryDragFromCaptureLoss (literals at 0xe8d6f22-0xe8d6fc1, filed under
+// vertical_pinned_tab_entries_view.cc), which name the three moving parts: a
+// ghost chip under the pointer, a drop applied on release, and a cancel when
+// the capture is lost.
+//
+// Still not reproduced: bookmark drop onto the strip
+// (OnBookmarkDroppedOnPinnedEntries, BookmarkDragPreview - literals at
+// 0xe8d7590, owned by vertical_tab_strip_region_view.cc).
+class AsidePinnedEntriesView : public views::View,
+                               public TabStripModelObserver,
+                               public views::ContextMenuController,
+                               public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(AsidePinnedEntriesView, views::View)
+
+ public:
+  enum class Orientation { kHorizontal, kVertical };
+
+  AsidePinnedEntriesView(Browser* browser, Orientation orientation);
+  AsidePinnedEntriesView(const AsidePinnedEntriesView&) = delete;
+  AsidePinnedEntriesView& operator=(const AsidePinnedEntriesView&) = delete;
+  ~AsidePinnedEntriesView() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  // Pinning a tab that is already in place does not change the model, so the
+  // chips have to follow the pin flag and the tab's title/favicon separately.
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      int index,
+                      TabChangeType change_type) override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  void Rebuild();
+
+  // Chip drag, driven by the EntryView chips (see the .cc).  Coordinates are
+  // in this view's space.
+  void OnEntryMousePressed(views::View* entry, const gfx::Point& location);
+  void OnEntryMouseDragged(views::View* entry, const gfx::Point& location);
+  void OnEntryMouseReleased(views::View* entry);
+  // The original's CancelEntryDragFromCaptureLoss: drop the drag without
+  // moving anything when the chip loses capture.
+  void CancelEntryDragFromCaptureLoss();
+
+ private:
+  void ActivateEntry(int tab_handle_index);
+  bool IsEntryBookmarked(int index) const;
+  // The original's FinishEntryDrag: apply the pending move, then tear the
+  // ghost down.
+  void FinishEntryDrag();
+  void EndEntryDrag();
+  // Index the dragged chip would land on for a pointer at `location`.
+  int DropIndexForPoint(const gfx::Point& location) const;
+  void UpdateGhostPosition(const gfx::Point& location);
+
+  raw_ptr<Browser> browser_;
+  const Orientation orientation_;
+  std::map<views::View*, int> entry_indices_;
+  int pending_index_ = -1;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+
+  // Drag state.  `drag_entry_` is non-null between mouse press and release on
+  // a chip; `dragging_` turns on once the pointer passes the drag threshold.
+  raw_ptr<views::View> drag_entry_ = nullptr;
+  raw_ptr<views::View> drag_ghost_ = nullptr;
+  gfx::Point drag_origin_;
+  gfx::Vector2d ghost_offset_;
+  int drag_from_index_ = -1;
+  int drag_to_index_ = -1;
+  bool dragging_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_PINNED_ENTRIES_VIEW_H_
