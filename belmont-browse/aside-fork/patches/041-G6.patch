+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_ASIDE_OMNIBOX_ASIDE_OMNIBOX_CONTEXT_STORE_H_
+#define CHROME_BROWSER_EXTENSIONS_API_ASIDE_OMNIBOX_ASIDE_OMNIBOX_CONTEXT_STORE_H_
+
+#include <map>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace extensions {
+
+// Session-local, in-memory attachments. A token owns its payload; deleting or
+// clearing it releases the bytes. Nothing is uploaded when adding an attachment.
+class AsideOmniboxContextStore {
+ public:
+  static constexpr size_t kMaxFileBytes = 20 * 1024 * 1024;
+  static constexpr size_t kMaxTotalBytes = 40 * 1024 * 1024;
+  static constexpr size_t kMaxContexts = 16;
+  struct Context {
+    enum class Kind { kFile, kTab };
+    Kind kind = Kind::kFile;
+    std::string file_name;
+    std::string mime_type;
+    std::string bytes;
+    // searchbox.mojom SelectedFileInfo's remaining fields, which the original's
+    // asideOmnibox.addFileContext reads alongside fileName/mimeType/bytesBase64
+    // (RE 0x405ffc0: "imageDataUrl", "isDeletable", "selectionTimeMs").
+    // image_data_url mirrors SelectedFileInfo.image_data_url (optional),
+    // is_deletable mirrors SelectedFileInfo.is_deletable and selection_time
+    // mirrors SelectedFileInfo.selection_time (a JSTime, i.e. ms since the
+    // Unix epoch).
+    std::string image_data_url;
+    bool is_deletable = true;
+    base::Time selection_time;
+    int tab_id = -1;
+    GURL tab_url;
+    std::string tab_title;
+  };
+
+  AsideOmniboxContextStore();
+  ~AsideOmniboxContextStore();
+  base::expected<std::string, std::string> AddFile(
+      const base::DictValue& request);
+  base::expected<std::string, std::string> AddTab(
+      int tab_id, const GURL& url, std::string title);
+  const Context* Get(const std::string& token) const;
+  // Exactly one attached image is required by the single-image search path.
+  const std::pair<const std::string, Context>* GetSingleImage() const;
+  bool Remove(const std::string& token);
+  void Clear();
+  void ClearImages();
+  bool empty() const { return contexts_.empty(); }
+  size_t size() const { return contexts_.size(); }
+  size_t total_bytes() const { return total_bytes_; }
+
+ private:
+  std::string Insert(Context context);
+  std::map<std::string, Context> contexts_;
+  size_t total_bytes_ = 0;
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_ASIDE_OMNIBOX_ASIDE_OMNIBOX_CONTEXT_STORE_H_
diff --git a/chrome/browser/extensions/api/aside_omnibox/aside_omnibox_context_store_unittest.cc b/chrome/browser/extensions/api/aside_omnibox/aside_omnibox_context_store_unittest.cc
new file mode 100644
index 0000000000..e3aadb12cb
--- /dev/null
+++ b/chrome/browser/extensions/api/aside_omnibox/aside_omnibox_context_store_unittest.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_omnibox/aside_omnibox_context_store.h"
+
+#include "base/base64.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace extensions {
+namespace {
+
+base::DictValue File(std::string bytes, std::string mime = "image/png") {
+  return base::DictValue()
+      .Set("bytesBase64", base::Base64Encode(bytes))
+      .Set("fileName", "local-test.png")
+      .Set("mimeType", std::move(mime));
+}
+
+TEST(AsideOmniboxContextStoreTest, PreservesExactBinaryPayloadUntilRemoval) {
+  AsideOmniboxContextStore store;
+  const std::string bytes("\x89PNG\0\r\n", 7);
+  auto token = store.AddFile(File(bytes));
+  ASSERT_TRUE(token.has_value());
+  EXPECT_EQ(token->size(), 32u);
+  ASSERT_TRUE(store.Get(*token));
+  EXPECT_EQ(store.Get(*token)->bytes, bytes);
+  EXPECT_EQ(store.Get(*token)->mime_type, "image/png");
+  EXPECT_EQ(store.Get(*token)->file_name, "local-test.png");
+  EXPECT_EQ(store.total_bytes(), bytes.size());
+  EXPECT_TRUE(store.Remove(*token));
+  EXPECT_FALSE(store.Get(*token));
+  EXPECT_FALSE(store.Remove(*token));
+  EXPECT_EQ(store.total_bytes(), 0u);
+}
+
+TEST(AsideOmniboxContextStoreTest, TokensCannotAccessAnotherSession) {
+  AsideOmniboxContextStore first, second;
+  auto a = first.AddFile(File("first"));
+  auto b = second.AddFile(File("second"));
+  ASSERT_TRUE(a.has_value());
+  ASSERT_TRUE(b.has_value());
+  EXPECT_NE(*a, *b);
+  EXPECT_FALSE(second.Get(*a));
+  EXPECT_FALSE(second.Remove(*a));
+  EXPECT_EQ(second.Get(*b)->bytes, "second");
+  first.Clear();
+  EXPECT_TRUE(first.empty());
+  EXPECT_EQ(second.Get(*b)->bytes, "second");
+}
+
+TEST(AsideOmniboxContextStoreTest, KeepsTabIdentitySeparateFromImage) {
+  AsideOmniboxContextStore store;
+  auto tab = store.AddTab(42, GURL("https://example.test/source"), "Source");
+  auto image = store.AddFile(File("image"));
+  ASSERT_TRUE(tab.has_value());
+  ASSERT_TRUE(image.has_value());
+  EXPECT_EQ(store.Get(*tab)->tab_id, 42);
+  EXPECT_EQ(store.Get(*tab)->tab_url, GURL("https://example.test/source"));
+  EXPECT_EQ(store.Get(*tab)->tab_title, "Source");
+  EXPECT_FALSE(store.GetSingleImage());
+  store.ClearImages();
+  EXPECT_FALSE(store.Get(*image));
+  EXPECT_TRUE(store.Get(*tab));
+  EXPECT_EQ(store.total_bytes(), 0u);
+}
+
+TEST(AsideOmniboxContextStoreTest, SingleImageSelectionRejectsAmbiguousPayloads) {
+  AsideOmniboxContextStore store;
+  auto first = store.AddFile(File("one"));
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(store.GetSingleImage());
+  EXPECT_EQ(store.GetSingleImage()->first, *first);
+  auto second = store.AddFile(File("two"));
+  ASSERT_TRUE(second.has_value());
+  EXPECT_FALSE(store.GetSingleImage());
+  store.Remove(*second);
+  ASSERT_TRUE(store.GetSingleImage());
+  store.Clear();
+  EXPECT_FALSE(store.GetSingleImage());
+  ASSERT_TRUE(store.AddFile(File("plain", "text/plain")).has_value());
+  EXPECT_FALSE(store.GetSingleImage());
+}
+
+TEST(AsideOmniboxContextStoreTest, RejectsInvalidPayloadWithoutKeepingBytes) {
+  AsideOmniboxContextStore store;
+  EXPECT_FALSE(store.AddFile(base::DictValue()).has_value());
+  EXPECT_FALSE(store.AddFile(File("")).has_value());
+  auto malformed = File("data");
+  malformed.Set("bytesBase64", "%%%malformed%%%=");
+  EXPECT_FALSE(store.AddFile(malformed).has_value());
+  EXPECT_FALSE(store.AddFile(File("data", "image/png\r\nInjected: yes")).has_value());
+  EXPECT_FALSE(store.AddFile(File("data", "image")).has_value());
+  EXPECT_FALSE(store.AddTab(-1, GURL("https://example.test"), "").has_value());
+  EXPECT_FALSE(store.AddTab(1, GURL("chrome://settings"), "").has_value());
+  EXPECT_TRUE(store.empty());
+  EXPECT_EQ(store.total_bytes(), 0u);
+}
+
+TEST(AsideOmniboxContextStoreTest, ReleasedStorageCanBeReused) {
+  AsideOmniboxContextStore store;
+  const std::string full(AsideOmniboxContextStore::kMaxFileBytes, 'x');
+  auto first = store.AddFile(File(full));
+  auto second = store.AddFile(File(full));
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  EXPECT_FALSE(store.AddFile(File("overflow")).has_value());
+  EXPECT_FALSE(store.AddFile(File(full + "x")).has_value());
+  EXPECT_TRUE(store.Remove(*first));
+  EXPECT_TRUE(store.AddFile(File("replacement")).has_value());
+  store.Clear();
+  EXPECT_EQ(store.total_bytes(), 0u);
+  EXPECT_TRUE(store.AddFile(File(full)).has_value());
+}
+
+TEST(AsideOmniboxContextStoreTest, TabContextsCannotGrowWithoutBound) {
+  AsideOmniboxContextStore store;
+  for (size_t i = 0; i < AsideOmniboxContextStore::kMaxContexts; ++i) {
+    ASSERT_TRUE(store.AddTab(i, GURL("https://example.test"), "tab").has_value());
+  }
+  EXPECT_FALSE(store.AddTab(100, GURL("https://example.test"), "tab").has_value());
+  store.Clear();
+  EXPECT_TRUE(store.AddTab(100, GURL("https://example.test"), "tab").has_value());
+}
+
