+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_ASIDE_OMNIBOX_ASIDE_OMNIBOX_SEARCHBOX_PAGE_H_
+#define CHROME_BROWSER_EXTENSIONS_API_ASIDE_OMNIBOX_ASIDE_OMNIBOX_SEARCHBOX_PAGE_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "components/omnibox/browser/searchbox.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+namespace extensions {
+
+class AsideOmniboxSession;
+
+// The browser-side searchbox::mojom::Page endpoint the asideOmnibox API binds.
+//
+// RE (Aside 1.0.825.1 x86_64): the private extension API region 0x048f2710
+// binds a Page endpoint twice - at 0x048ffcbc and 0x04901890 - and the receive
+// half of the generated Page bindings (the Page stub plus the readers for
+// AutocompleteResult / AutocompleteMatch) is linked into the image at
+// 0x0474dd80.  Upstream Chrome for Testing 151.0.7922.171 links only the send
+// half, which is why that block shows up as an Aside-only region.  A Page
+// receiver in the browser process can only be a listener, so this is the
+// asideOmnibox API listening in on the results the searchbox WebUI receives.
+//
+// Results are relayed to the extension under the owning session's id, in the
+// same shape asideOmnibox.onAutocompleteResultChanged already uses.  The other
+// Page methods are accepted and dropped, as a results-only listener would.
+class AsideOmniboxSearchboxPage : public searchbox::mojom::Page {
+ public:
+  explicit AsideOmniboxSearchboxPage(AsideOmniboxSession* session);
+  AsideOmniboxSearchboxPage(const AsideOmniboxSearchboxPage&) = delete;
+  AsideOmniboxSearchboxPage& operator=(const AsideOmniboxSearchboxPage&) =
+      delete;
+  ~AsideOmniboxSearchboxPage() override;
+
+  // Binds a fresh pipe and hands the remote end to the searchbox mirror.
+  void RegisterWithSearchboxMirror();
+
+  // searchbox::mojom::Page:
+  void AutocompleteResultChanged(
+      searchbox::mojom::AutocompleteResultPtr result) override;
+  void UpdateSelection(
+      searchbox::mojom::OmniboxPopupSelectionPtr old_selection,
+      searchbox::mojom::OmniboxPopupSelectionPtr selection) override;
+  void StepSelection(searchbox::mojom::SelectionDirection direction,
+                     searchbox::mojom::SelectionStep step) override;
+  void OpenCurrentSelection(::WindowOpenDisposition disposition) override;
+  void SetAimButtonVisible(bool visible) override;
+  void SetKeywordSelected(bool is_keyword_selected) override;
+  void SetInputText(const std::string& input) override;
+  void SetThumbnail(const std::string& thumbnail_url,
+                    bool is_deletable) override;
+  void OnContextualInputStatusChanged(
+      const ::base::UnguessableToken& token,
+      ::contextual_search::ContextUploadStatus status,
+      std::optional<::contextual_search::ContextUploadErrorType> error_type)
+      override;
+  void OnTabStripChanged() override;
+  void OnInputStateChanged(const ::omnibox::InputState& input_state) override;
+  void AddFileContext(
+      const ::base::UnguessableToken& token,
+      searchbox::mojom::SelectedFileInfoPtr file_info) override;
+  void UpdateAutoSuggestedTabContext(
+      searchbox::mojom::TabInfoPtr tab,
+      const std::optional<std::string>& invocation_source) override;
+  void UpdateLensSearchEligibility(bool eligible) override;
+  void UpdateContentSharingPolicy(bool enabled) override;
+  void UpdateAimPopupEligibility(bool eligible) override;
+  void UpdateSmartTabSharingActive(bool active) override;
+  void OnPermissionPromptChanged(bool is_showing,
+                                 const ::gfx::Size& prompt_size) override;
+  void SetRestoredTabIds(const std::vector<int32_t>& ids) override;
+  void SetAimThreadRestoredTabs(
+      std::vector<searchbox::mojom::TabInfoPtr> tabs) override;
+
+ private:
+  const raw_ptr<AsideOmniboxSession> session_;
+  mojo::Receiver<searchbox::mojom::Page> receiver_{this};
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_ASIDE_OMNIBOX_ASIDE_OMNIBOX_SEARCHBOX_PAGE_H_
