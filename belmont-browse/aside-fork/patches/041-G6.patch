+void AsideProfileMenuView::BuildHistoryPage() {
+  AddBackRow(body_, kHistory,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+
+  body_->AddChildView(MakeSectionLabel(kRecentTabs));
+  size_t shown = 0;
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(browser_->profile());
+  if (service) {
+    service->LoadTabsFromLastSession();
+    for (const auto& entry : service->entries()) {
+      if (shown >= kRecentTabCount) {
+        break;
+      }
+      if (entry->type != sessions::tab_restore::Type::TAB) {
+        continue;
+      }
+      const auto* tab =
+          static_cast<const sessions::tab_restore::Tab*>(entry.get());
+      if (tab->navigations.empty()) {
+        continue;
+      }
+      const sessions::SerializedNavigationEntry& nav =
+          tab->navigations[tab->normalized_navigation_index()];
+      ++shown;
+      body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+          base::BindRepeating(&AsideProfileMenuView::OnRestoreClosedTab,
+                              base::Unretained(this), entry->id.id()),
+          nav.title().empty() ? base::UTF8ToUTF16(nav.virtual_url().spec())
+                              : nav.title(),
+          &kAsideGlobeIcon));
+    }
+  }
+  if (shown == 0) {
+    body_->AddChildView(MakeSectionLabel(kNoRecentTabs));
+  }
+
+  body_->AddChildView(std::make_unique<views::Separator>());
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ShowHistory(browser);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kAllHistory, &kAsideHistoryIcon));
+}
