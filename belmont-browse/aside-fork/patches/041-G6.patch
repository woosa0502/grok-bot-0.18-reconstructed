+// RE 0xe56b956-0xe56bb53: the field names and the transport-state /
+// user-actionable-error / disable-reason token spellings the original's
+// getSyncStatus returns.
+// RE 0x4917bbf: the original writes the literal "macos" here.  It is a mac-only
+// browser; this build answers with the platform it runs on.
+const char* AsidePlatformToken() {
+#if BUILDFLAG(IS_MAC)
+  return "macos";
+#elif BUILDFLAG(IS_WIN)
+  return "windows";
+#else
+  return "linux";
+#endif
+}
