+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_provider_client.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_scheme_classifier.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "components/omnibox/browser/actions/omnibox_action.h"
+#include "components/omnibox/browser/omnibox_client.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/browser/web_contents.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/omnibox/browser/autocomplete_controller_config.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_match_type.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_event_histogram_value.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+
+namespace extensions {
+
+namespace {
+constexpr char kEventName[] = "asideOmnibox.onAutocompleteResultChanged";
+}  // namespace
+
+AsideOmniboxSession::AsideOmniboxSession(
+    Profile* profile,
+    content::BrowserContext* browser_context,
+    std::string session_id,
+    std::string extension_id)
+    : profile_(profile),
+      browser_context_(browser_context),
+      session_id_(std::move(session_id)),
+      extension_id_(std::move(extension_id)),
+      controller_(std::make_unique<AutocompleteController>(
+          std::make_unique<ChromeAutocompleteProviderClient>(
+              profile, base::BindRepeating(&AsideOmniboxSession::target,
+                                          base::Unretained(this))),
+          AutocompleteControllerConfig{
+              .provider_types =
+                  AutocompleteClassifier::DefaultOmniboxProviders()})) {
+  controller_->AddObserver(this);
+  // RE 0x048ffcbc / 0x04901890: the original binds a browser-side
+  // searchbox::mojom::Page from this API.  Bind one per session so the results
+  // the searchbox WebUI receives reach the extension under this session's id.
+  searchbox_page_ = std::make_unique<AsideOmniboxSearchboxPage>(this);
+  searchbox_page_->RegisterWithSearchboxMirror();
+}
+
+AsideOmniboxSession::~AsideOmniboxSession() {
+  controller_->RemoveObserver(this);
+}
+
+void AsideOmniboxSession::Query(const std::string& input_text,
+                               bool prevent_inline,
+                               std::optional<uint32_t> cursor_position) {
+  ++result_sequence_id_;
+  ChromeAutocompleteSchemeClassifier scheme_classifier(profile_);
+  last_input_ = input_text;
+  std::u16string text = base::UTF8ToUTF16(input_text);
+  if (!keyword_.empty()) {
+    const std::u16string prefix = keyword_ + u" ";
+    if (!base::StartsWith(text, prefix)) {
+      text = prefix + text;
+    }
+  }
+  // Same clamp as SearchboxHandler::QueryAutocomplete: a caret past the end of
+  // the text would otherwise reach AutocompleteInput out of range.  When a
+  // keyword prefix was prepended above, the caret moves with the text.
+  // npos is AutocompleteInput's "not from the user's typing" value, which is
+  // what the no-caret constructor uses.
+  size_t caret = std::u16string::npos;
+  if (cursor_position) {
+    const size_t offset = text.length() - base::UTF8ToUTF16(input_text).length();
+    caret = std::min(static_cast<size_t>(*cursor_position) + offset,
+                     text.length());
+  }
+  AutocompleteInput input(text, caret,
+                          metrics::OmniboxEventProto::OTHER, scheme_classifier);
+  input.set_in_keyword_mode(!keyword_.empty());
+  input.set_prevent_inline_autocomplete(prevent_inline);
+  controller_->Start(input);
+}
+
+void AsideOmniboxSession::NoteMatchOpened(bool are_matches_showing,
+                                          bool via_keyboard) {
+  matches_were_showing_ = are_matches_showing;
+  opened_via_keyboard_ = via_keyboard;
+  // Upstream stops autocomplete when a match is opened; without this the
+  // controller keeps producing results for a query the user has left.
+  controller_->Stop(AutocompleteStopReason::kInteraction);
+}
+
+void AsideOmniboxSession::Stop(bool clear_result) {
+  if (clear_result) {
+    ++result_sequence_id_;
+  }
+  controller_->Stop(clear_result ? AutocompleteStopReason::kClobbered
+                                  : AutocompleteStopReason::kInteraction);
+  if (clear_result && !keyword_.empty()) {
+    keyword_.clear();
+    base::DictValue details;
+    details.Set("isKeywordSelected", false);
+    Dispatch("asideOmnibox.onKeywordSelectedChanged", std::move(details));
+  }
+}
+
+void AsideOmniboxSession::DeleteMatch(size_t line) {
+  const AutocompleteResult& result = controller_->result();
+  if (line < result.size()) {
+    controller_->DeleteMatch(result.match_at(line));
+  }
+}
+
+void AsideOmniboxSession::SetTarget(content::WebContents* target, int tab_id) {
+  target_ = target->GetWeakPtr();
+  target_tab_id_ = tab_id;
+}
+
+bool AsideOmniboxSession::ActivateKeyword(const std::u16string& keyword) {
+  auto* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  const TemplateURL* provider = service
+      ? service->GetTemplateURLForKeyword(keyword) : nullptr;
+  if (!provider || !provider->SupportsReplacement(service->search_terms_data())) {
+    return false;
+  }
+  keyword_ = keyword;
+  base::DictValue details;
+  details.Set("isKeywordSelected", true);
+  details.Set("keyword", base::UTF16ToUTF8(keyword_));
+  details.Set("shortName", base::UTF16ToUTF8(provider->short_name()));
+  details.Set("keywordPlaceholder", base::UTF16ToUTF8(
+      AutocompleteMatch::GetKeywordPlaceholder(provider, false)));
+  Dispatch("asideOmnibox.onKeywordSelectedChanged", std::move(details));
+  Query("");
+  return true;
+}
+
+bool AsideOmniboxSession::ExecuteAction(size_t line, size_t action_index,
+                                      WindowOpenDisposition disposition,
+                                      OmniboxClient* client) {
+  if (!client || line >= result().size() ||
+      action_index >= result().match_at(line).actions.size()) {
+    return false;
+  }
+  auto weak_this = weak_factory_.GetWeakPtr();
+  OmniboxAction::ExecutionContext context(
+      *controller_->autocomplete_provider_client(),
+      base::BindOnce(&OmniboxClient::OnAutocompleteAccept, client->AsWeakPtr()),
+      base::TimeTicks::Now(), disposition);
+  if (!ExecuteAsideOmniboxAction(result(), line, action_index, context)) {
+    return false;
+  }
+  const int starter_pack = context.enter_starter_pack_id_;
+  if (!weak_this) {
+    return true;
+  }
+  if (starter_pack) {
+    auto* service = TemplateURLServiceFactory::GetForProfile(profile_);
+    const TemplateURL* provider = service ? service->FindStarterPackTemplateURL(
+        static_cast<template_url_starter_pack_data::StarterPackId>(starter_pack))
+        : nullptr;
+    if (provider) {
+      ActivateKeyword(provider->keyword());
+    }
+  }
+  return true;
+}
+
+void AsideOmniboxSession::Dispatch(const std::string& name,
+                                  base::DictValue details) {
+  EventRouter* router = EventRouter::Get(browser_context_);
+  if (!router || !router->ExtensionHasEventListener(extension_id_, name)) {
+    return;
+  }
+  base::ListValue args;
+  args.Append(session_id_);
+  args.Append(std::move(details));
+  events::HistogramValue histogram = events::ASIDE_OMNIBOX_ON_SELECTION_UPDATED;
+  if (name == "asideOmnibox.onKeywordSelectedChanged") {
+    histogram = events::ASIDE_OMNIBOX_ON_KEYWORD_SELECTED_CHANGED;
+  } else if (name == "asideOmnibox.onAutocompleteResultChanged") {
+    histogram = events::ASIDE_OMNIBOX_ON_AUTOCOMPLETE_RESULT_CHANGED;
+  }
+  router->DispatchEventToExtension(extension_id_, std::make_unique<Event>(
+      histogram, name, std::move(args), profile_));
+}
+
+const AutocompleteResult& AsideOmniboxSession::result() const {
+  return controller_->result();
+}
+
+void AsideOmniboxSession::SetToolMode(std::string mode) {
+  tool_mode_ = std::move(mode);
+}
+
+void AsideOmniboxSession::SetModelMode(std::string mode) {
+  model_mode_ = std::move(mode);
+}
+
+void AsideOmniboxSession::SetSelection(base::DictValue selection) {
+  if (selection_ == selection) {
+    return;
+  }
+  selection_ = std::move(selection);
+  base::DictValue details;
+  details.Set("selection", selection_.Clone());
+  Dispatch("asideOmnibox.onSelectionUpdated", std::move(details));
+}
+
+void AsideOmniboxSession::OnResultChanged(AutocompleteController* controller,
+                                          bool default_match_changed) {
+  ++result_sequence_id_;
+  EventRouter* router = EventRouter::Get(browser_context_);
+  if (!router || !router->ExtensionHasEventListener(extension_id_, kEventName)) {
+    return;
+  }
+  // Result contract (extension reads .matches[].{contents,destinationUrl,
+  // fillIntoEdit,isSearchType}).
+  base::ListValue matches;
+  for (const AutocompleteMatch& match : controller->result()) {
+    base::DictValue m;
+    m.Set("resultSequenceId", result_sequence_id());
+    m.Set("contents", base::UTF16ToUTF8(match.contents));
+    m.Set("description", base::UTF16ToUTF8(match.description));
+    m.Set("destinationUrl", match.destination_url.spec());
+    m.Set("fillIntoEdit", base::UTF16ToUTF8(match.fill_into_edit));
+    m.Set("isSearchType", AutocompleteMatch::IsSearchType(match.type));
+    m.Set("relevance", match.relevance);
+    m.Set("supportsDeletion", match.SupportsDeletion());
+    m.Set("keyword", base::UTF16ToUTF8(match.keyword));
+    m.Set("fromKeyword", match.from_keyword);
+    m.Set("actions", AsideOmniboxActionDescriptions(match));
+    m.Set("type", AutocompleteMatchType::ToString(match.type));
+    matches.Append(std::move(m));
+  }
+  base::DictValue result;
+  result.Set("matches", std::move(matches));
+  result.Set("resultSequenceId", result_sequence_id());
+  result.Set("input", base::UTF16ToUTF8(controller->input().text()));
+
+  base::ListValue args;
+  args.Append(session_id_);
+  args.Append(std::move(result));
+  auto event = std::make_unique<Event>(
+      events::ASIDE_OMNIBOX_ON_AUTOCOMPLETE_RESULT_CHANGED, kEventName,
+      std::move(args), profile_);
+  router->DispatchEventToExtension(extension_id_, std::move(event));
+}
+
+}  // namespace extensions
