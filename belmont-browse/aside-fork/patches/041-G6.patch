@@ -0,0 +1,151 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_omnibox/aside_omnibox_context_store.h"
+
+#include <cmath>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/strings/string_util.h"
+#include "base/rand_util.h"
+#include "base/strings/stringprintf.h"
+
+namespace extensions {
+
+AsideOmniboxContextStore::AsideOmniboxContextStore() = default;
+AsideOmniboxContextStore::~AsideOmniboxContextStore() = default;
+
+base::expected<std::string, std::string> AsideOmniboxContextStore::AddFile(
+    const base::DictValue& request) {
+  if (contexts_.size() >= kMaxContexts) {
+    return base::unexpected("Too many contexts");
+  }
+  const std::string* encoded = request.FindString("bytesBase64");
+  Context context;
+  // Bound before decoding too, so an oversized request cannot allocate an
+  // unbounded duplicate of its payload.
+  if (!encoded || encoded->size() > ((kMaxFileBytes + 2) / 3) * 4 ||
+      !base::Base64Decode(*encoded, &context.bytes) || context.bytes.empty()) {
+    // The original's wording (RE 0x405ffc0).
+    return base::unexpected("Invalid bytesBase64 payload");
+  }
+  if (context.bytes.size() > kMaxFileBytes ||
+      context.bytes.size() > kMaxTotalBytes - total_bytes_) {
+    return base::unexpected("Context storage limit exceeded");
+  }
+  const std::string* mime = request.FindString("mimeType");
+  if (!mime || mime->empty() || mime->size() > 128 ||
+      mime->find('/') == std::string::npos ||
+      mime->find_first_of("\r\n\0", 0, 3) != std::string::npos) {
+    return base::unexpected("Invalid mimeType");
+  }
+  context.mime_type = base::ToLowerASCII(*mime);
+  if (const std::string* name = request.FindString("fileName")) {
+    if (name->size() > 4096) {
+      return base::unexpected("Invalid fileName");
+    }
+    context.file_name = *name;
+  }
+  // The rest of searchbox.mojom's SelectedFileInfo, which the original reads
+  // from the same request dict (RE 0x405ffc0: "imageDataUrl", "isDeletable",
+  // "selectionTimeMs").  imageDataUrl is only meaningful for an image and is
+  // bounded like the payload it describes; a non-data: URL is rejected rather
+  // than stored, so nothing here can turn into a network fetch.
+  if (const std::string* data_url = request.FindString("imageDataUrl")) {
+    if (!data_url->empty()) {
+      if (data_url->size() > ((kMaxFileBytes + 2) / 3) * 4 + 64 ||
+          !base::StartsWith(*data_url, "data:image/",
+                            base::CompareCase::INSENSITIVE_ASCII)) {
+        return base::unexpected("Invalid imageDataUrl");
+      }
+      context.image_data_url = *data_url;
+    }
+  }
+  context.is_deletable = request.FindBool("isDeletable").value_or(true);
+  // JSTime: milliseconds since the Unix epoch.  Absent or non-finite means
+  // "now", which is what the original's default-constructed field records.
+  const std::optional<double> selection_time_ms =
+      request.FindDouble("selectionTimeMs");
+  context.selection_time =
+      (selection_time_ms && std::isfinite(*selection_time_ms))
+          ? base::Time::UnixEpoch() + base::Milliseconds(*selection_time_ms)
+          : base::Time::Now();
+  return base::ok(Insert(std::move(context)));
+}
+
+base::expected<std::string, std::string> AsideOmniboxContextStore::AddTab(
+    int tab_id, const GURL& url, std::string title) {
+  if (contexts_.size() >= kMaxContexts) {
+    return base::unexpected("Too many contexts");
+  }
+  if (tab_id < 0 || !url.SchemeIsHTTPOrHTTPS()) {
+    return base::unexpected("Tab context requires an HTTP or HTTPS page");
+  }
+  Context context;
+  context.kind = Context::Kind::kTab;
+  context.tab_id = tab_id;
+  context.tab_url = url;
+  context.tab_title = std::move(title);
+  return base::ok(Insert(std::move(context)));
+}
+
+std::string AsideOmniboxContextStore::Insert(Context context) {
+  std::string token;
+  do {
+    token = base::StringPrintf("%016llX%016llX",
+        static_cast<unsigned long long>(base::RandUint64()),
+        static_cast<unsigned long long>(base::RandUint64()));
+  } while (contexts_.contains(token));
+  total_bytes_ += context.bytes.size();
+  contexts_.emplace(token, std::move(context));
+  return token;
+}
+
+const AsideOmniboxContextStore::Context* AsideOmniboxContextStore::Get(
+    const std::string& token) const {
+  auto it = contexts_.find(token);
+  return it == contexts_.end() ? nullptr : &it->second;
+}
+
+const std::pair<const std::string, AsideOmniboxContextStore::Context>*
+AsideOmniboxContextStore::GetSingleImage() const {
+  if (contexts_.size() != 1) {
+    return nullptr;
+  }
+  const auto& entry = *contexts_.begin();
+  return entry.second.kind == Context::Kind::kFile &&
+                 base::StartsWith(entry.second.mime_type, "image/")
+             ? &entry
+             : nullptr;
+}
+
+bool AsideOmniboxContextStore::Remove(const std::string& token) {
+  auto it = contexts_.find(token);
+  if (it == contexts_.end()) {
+    return false;
+  }
+  total_bytes_ -= it->second.bytes.size();
+  contexts_.erase(it);
+  return true;
+}
+
+void AsideOmniboxContextStore::Clear() {
+  contexts_.clear();
+  total_bytes_ = 0;
+}
+
+void AsideOmniboxContextStore::ClearImages() {
+  for (auto it = contexts_.begin(); it != contexts_.end();) {
+    if (it->second.kind == Context::Kind::kFile &&
+        base::StartsWith(it->second.mime_type, "image/")) {
+      total_bytes_ -= it->second.bytes.size();
+      it = contexts_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+}  // namespace extensions
