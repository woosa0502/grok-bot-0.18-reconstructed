+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/profiles/profile_monogram_avatar_view.h"
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include "base/i18n/case_conversion.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/aside/aside_fonts.h"
+#include "chrome/browser/ui/profiles/profile_colors_util.h"
+#include "chrome/browser/ui/views/aside/icons/vector_icons.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/monogram_utils.h"
+#include "ui/gfx/paint_vector_icon.h"
+
+namespace aside {
+
+namespace {
+
+// Original order, read from the 825.1 framework's __ustring block
+// 0xd77a164–0xd77a3f4 (Sun, Moon, Cloud, … Console, Bubble).
+constexpr auto kIndicatorIcons = std::to_array<ProfileIndicatorIcon>({
+    {"Sun", &kAsideSunSolidIcon},
+    {"Moon", &kAsideMoonSolidIcon},
+    {"Cloud", &kAsideCloud2SolidIcon},
+    {"Zap", &kAsideZapSolidIcon},
+    {"Heart", &kAsideHeartSolidIcon},
+    {"Flame", &kAsideFire3SolidIcon},
+    {"Star", &kAsideStarSolidIcon},
+    {"Magic wand", &kAsideMagicWand2SolidIcon},
+    {"Thumbs up", &kAsideThumbsUpSolidIcon},
+    {"Diamond", &kAsideDiamondSolidIcon},
+    {"Book", &kAsideBookSolidIcon},
+    {"Magic book", &kAsideMagicBookSolidIcon},
+    {"Hourglass", &kAsideHourglassSolidIcon},
+    {"Clock", &kAsideClock3OClockSolidIcon},
+    {"Smile", &kAsideEmojiSmileSolidIcon},
+    {"Slime", &kAsideOfficialBrandSlimeSolidIcon},
+    {"Lock", &kAsideLockSolidIcon},
+    {"Map pin", &kAsideMapPinSolidIcon},
+    {"Pin", &kAsidePinSolidIcon},
+    {"Tag", &kAsideTagSolidIcon},
+    {"Flag", &kAsideFlag2SolidIcon},
+    {"Shopping bag", &kAsideShoppingBag4SolidIcon},
+    {"Suitcase", &kAsideSuitcaseSolidIcon},
+    {"Banknote", &kAsideBanknote2SolidIcon},
+    {"Telescope", &kAsideTelescopeSolidIcon},
+    {"Trophy", &kAsideTrophySolidIcon},
+    {"Rocket", &kAsideRocketSolidIcon},
+    {"Ticket", &kAsideTicketSolidIcon},
+    {"Camera", &kAsideCamera2SolidIcon},
+    {"Folder", &kAsideFolder1SolidIcon},
+    {"Bookmark", &kAsideBookmarkSolidIcon},
+    {"Pencil", &kAsidePencil2SolidIcon},
+    {"Write", &kAsideWrite2SolidIcon},
+    {"Brush", &kAsideBrushSolidIcon},
+    {"Palette", &kAsideColorPalette2SolidIcon},
+    {"Half circle", &kAsideCircleHalfFillStrokeIcon},
+    {"Atom", &kAsideAtomSolidIcon},
+    {"Headphones", &kAsideHeadphonesSolidIcon},
+    {"Bell", &kAsideBell2SolidIcon},
+    {"Email", &kAsideEmail2SolidIcon},
+    {"Chart", &kAsideChart1SolidIcon},
+    {"Circle", &kAsideFormCircleSolidIcon},
+    {"Square", &kAsideFormSquareSolidIcon},
+    {"Flower", &kAsideFormFlowerSolidIcon},
+    {"Cursor", &kAsideCursor1SolidIcon},
+    {"Console", &kAsideConsoleSolidIcon},
+    {"Bubble", &kAsideBubble3SolidIcon},
+});
+
+}  // namespace
+
+base::span<const ProfileIndicatorIcon> ProfileIndicatorIcons() {
+  return base::span<const ProfileIndicatorIcon>(kIndicatorIcons);
+}
+
+const gfx::VectorIcon* ProfileIndicatorIconByName(std::string_view name) {
+  if (name.empty()) {
+    return nullptr;
+  }
+  for (const ProfileIndicatorIcon& entry : kIndicatorIcons) {
+    if (name == entry.name) {
+      return entry.icon;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace aside
+
+namespace {
+
+// The first grapheme of the profile name, upper-cased ("Aside" → "A").
+std::u16string MonogramFor(const std::u16string& name) {
+  for (size_t i = 0; i < name.size(); ++i) {
+    if (!base::IsUnicodeWhitespace(name[i])) {
+      return base::i18n::ToUpper(name.substr(i, 1));
+    }
+  }
+  return u"?";
+}
+
+}  // namespace
+
+ProfileMonogramAvatarView::ProfileMonogramAvatarView(
+    const base::FilePath& profile_path,
+    int size)
+    : profile_path_(profile_path), size_(size) {
+  SetCanProcessEventsWithinSubtree(false);
+  Refresh();
+}
+
+ProfileMonogramAvatarView::~ProfileMonogramAvatarView() = default;
+
+ProfileAttributesEntry* ProfileMonogramAvatarView::Entry() const {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return nullptr;
+  }
+  return manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+      profile_path_);
+}
+
+void ProfileMonogramAvatarView::Refresh() {
+  monogram_ = u"?";
+  indicator_icon_.clear();
+  if (ProfileAttributesEntry* entry = Entry()) {
+    monogram_ = MonogramFor(entry->GetName());
+    indicator_icon_ = entry->GetAsideProfileIndicatorIcon();
+  }
+  SchedulePaint();
+}
+
+gfx::Size ProfileMonogramAvatarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(size_, size_);
+}
+
+void ProfileMonogramAvatarView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+
+  SkColor background = SK_ColorTRANSPARENT;
+  SkColor foreground = SK_ColorWHITE;
+  if (ProfileAttributesEntry* entry = Entry()) {
+    const ProfileThemeColors colors = entry->GetProfileThemeColors();
+    background = colors.profile_highlight_color;
+    foreground = color_utils::GetColorWithMaxContrast(background);
+  }
+
+  const gfx::VectorIcon* icon =
+      aside::ProfileIndicatorIconByName(indicator_icon_);
+  if (icon) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(background);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    canvas->DrawCircle(gfx::Point(size_ / 2, size_ / 2), size_ / 2.0f, flags);
+    const int glyph = std::max(8, size_ * 5 / 8);
+    const gfx::ImageSkia image =
+        gfx::CreateVectorIcon(*icon, glyph, foreground);
+    canvas->DrawImageInt(image, (size_ - glyph) / 2, (size_ - glyph) / 2);
+    return;
+  }
+
+  gfx::DrawMonogramInCanvas(canvas, size_, size_, monogram_,
+                            {aside::PreferredUiFontFamily()}, foreground,
+                            background);
+}
+
+BEGIN_METADATA(ProfileMonogramAvatarView)
+END_METADATA
