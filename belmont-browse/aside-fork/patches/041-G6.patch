+
+namespace {
+
+// Original UTF-16 literals, arm64 0xd77b0dc-0xd77b1c8.
+constexpr char16_t kRemoveBookmark[] = u"Remove bookmark";
+constexpr char16_t kRemoveBookmarkPrefix[] = u"Remove bookmark: ";
+constexpr char16_t kAddBookmark[] = u"Add bookmark";
+constexpr char16_t kAddToBookmarksPrefix[] = u"Add to bookmarks: ";
+constexpr char16_t kRemoveFromPin[] = u"Remove from pin";
+constexpr char16_t kRemoveFromPinPrefix[] = u"Remove from pin: ";
+constexpr char16_t kSwitchToPrefix[] = u"Switch to ";
+constexpr char16_t kPaused[] = u"Paused";
+constexpr char16_t kPausedSuffix[] = u", Paused";
+
+constexpr int kEntryIconSize = 16;
+
+enum PinnedEntryCommand {
+  kRemoveFromPinCommand = 1,
+  kToggleBookmarkCommand = 2,
+};
+
+// The original names each chip "…PinnedTabEntriesView::EntryView"
+// (0xe8d6efa).  It is an image button that also forwards its mouse events to
+// the strip so the strip can run the drag.
+class EntryView : public views::ImageButton {
+  METADATA_HEADER(EntryView, views::ImageButton)
+
+ public:
+  EntryView(PressedCallback callback, AsidePinnedEntriesView* owner)
+      : views::ImageButton(std::move(callback)), owner_(owner) {}
+  EntryView(const EntryView&) = delete;
+  EntryView& operator=(const EntryView&) = delete;
+  ~EntryView() override = default;
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    const bool handled = views::ImageButton::OnMousePressed(event);
+    if (event.IsOnlyLeftMouseButton()) {
+      owner_->OnEntryMousePressed(this, ConvertPointToOwner(event));
+    }
+    return handled || event.IsOnlyLeftMouseButton();
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    views::ImageButton::OnMouseDragged(event);
+    owner_->OnEntryMouseDragged(this, ConvertPointToOwner(event));
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    views::ImageButton::OnMouseReleased(event);
+    owner_->OnEntryMouseReleased(this);
+  }
+
+  void OnMouseCaptureLost() override {
+    views::ImageButton::OnMouseCaptureLost();
+    owner_->CancelEntryDragFromCaptureLoss();
+  }
+
+ private:
+  gfx::Point ConvertPointToOwner(const ui::MouseEvent& event) const {
+    gfx::Point point = event.location();
+    views::View::ConvertPointToTarget(this, owner_, &point);
+    return point;
+  }
+
+  const raw_ptr<AsidePinnedEntriesView> owner_;
+};
+
+BEGIN_METADATA(EntryView)
+END_METADATA
+
+}  // namespace
+
+AsidePinnedEntriesView::AsidePinnedEntriesView(Browser* browser,
+                                               Orientation orientation)
+    : browser_(browser), orientation_(orientation) {
+  auto* layout = SetLayoutManager(std::make_unique<views::FlexLayout>());
+  layout->SetOrientation(orientation_ == Orientation::kHorizontal
+                             ? views::LayoutOrientation::kHorizontal
+                             : views::LayoutOrientation::kVertical);
+  layout->SetCollapseMargins(true);
+  layout->SetDefault(views::kMarginsKey, gfx::Insets::VH(2, 2));
+  if (browser_) {
+    browser_->tab_strip_model()->AddObserver(this);
+  }
+  Rebuild();
+}
+
+AsidePinnedEntriesView::~AsidePinnedEntriesView() {
+  if (browser_) {
+    browser_->tab_strip_model()->RemoveObserver(this);
+  }
+}
+
+void AsidePinnedEntriesView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  Rebuild();
+}
+
+void AsidePinnedEntriesView::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                     int index) {
+  // Pinning a tab that already sits in the leading run moves nothing, so
+  // OnTabStripModelChanged never fires for it.
+  Rebuild();
+}
+
+void AsidePinnedEntriesView::OnTabChangedAt(tabs::TabInterface* tab,
+                                            int index,
+                                            TabChangeType change_type) {
+  if (change_type == TabChangeType::kAll) {
+    Rebuild();
+  }
+}
+
+bool AsidePinnedEntriesView::IsEntryBookmarked(int index) const {
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  content::WebContents* contents =
+      browser_->tab_strip_model()->GetWebContentsAt(index);
+  if (!model || !model->loaded() || !contents) {
+    return false;
+  }
+  return !model->GetNodesByURL(contents->GetLastCommittedURL()).empty();
+}
+
+void AsidePinnedEntriesView::Rebuild() {
+  RemoveAllChildViews();
+  entry_indices_.clear();
+  if (!browser_) {
+    SetVisible(false);
+    return;
+  }
+  TabStripModel* model = browser_->tab_strip_model();
+  for (int i = 0; i < model->count(); ++i) {
+    if (!model->IsTabPinned(i)) {
+      break;  // Pinned tabs are always the leading run.
+    }
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (!contents) {
+      continue;
+    }
+    ui::ImageModel favicon =
+        ui::ImageModel::FromVectorIcon(kAsideGlobeIcon, ui::kColorIcon,
+                                       kEntryIconSize);
+    if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents);
+        driver && !driver->GetFavicon().IsEmpty()) {
+      favicon = ui::ImageModel::FromImage(driver->GetFavicon());
+    }
+    const std::u16string title = contents->GetTitle();
+    const bool paused = contents->WasDiscarded();
+    auto entry = std::make_unique<EntryView>(
+        base::BindRepeating(&AsidePinnedEntriesView::ActivateEntry,
+                            base::Unretained(this), i),
+        this);
+    views::ConfigureVectorImageButton(entry.get());
+    entry->SetImageModel(views::Button::STATE_NORMAL, favicon);
+    entry->SetPreferredSize(gfx::Size(kEntryIconSize * 2, kEntryIconSize * 2));
+    // "Switch to <title>", with ", Paused" appended for a discarded tab; a tab
+    // with no title at all falls back to the bare "Paused" label.
+    std::u16string tooltip = title.empty() && paused
+                                 ? std::u16string(kPaused)
+                                 : std::u16string(kSwitchToPrefix) + title;
+    if (paused && !title.empty()) {
+      tooltip += kPausedSuffix;
+    }
+    entry->SetTooltipText(tooltip);
+    entry->GetViewAccessibility().SetName(tooltip);
+    entry->set_context_menu_controller(this);
+    views::View* added = AddChildView(std::move(entry));
+    entry_indices_[added] = i;
+  }
+  SetVisible(!children().empty());
+  InvalidateLayout();
+}
+
+void AsidePinnedEntriesView::ActivateEntry(int index) {
+  TabStripModel* model = browser_->tab_strip_model();
+  if (index >= 0 && index < model->count()) {
+    model->ActivateTabAt(index);
+  }
+}
+
+void AsidePinnedEntriesView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto it = entry_indices_.find(source);
+  if (it == entry_indices_.end()) {
+    return;
+  }
+  pending_index_ = it->second;
+  content::WebContents* contents =
+      browser_->tab_strip_model()->GetWebContentsAt(pending_index_);
+  const std::u16string title = contents ? contents->GetTitle() : u"";
+  const bool bookmarked = IsEntryBookmarked(pending_index_);
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kRemoveFromPinCommand, kRemoveFromPin);
+  menu_model_->SetAccessibleNameAt(
+      menu_model_->GetItemCount() - 1,
+      std::u16string(kRemoveFromPinPrefix) + title);
+  menu_model_->AddItem(kToggleBookmarkCommand,
+                       bookmarked ? kRemoveBookmark : kAddBookmark);
+  menu_model_->SetAccessibleNameAt(
+      menu_model_->GetItemCount() - 1,
+      (bookmarked ? std::u16string(kRemoveBookmarkPrefix)
+                  : std::u16string(kAddToBookmarksPrefix)) +
+          title);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+bool AsidePinnedEntriesView::IsCommandIdChecked(int command_id) const {
+  return false;
+}
+
+bool AsidePinnedEntriesView::IsCommandIdEnabled(int command_id) const {
+  return true;
+}
+
+void AsidePinnedEntriesView::ExecuteCommand(int command_id, int event_flags) {
+  TabStripModel* model = browser_->tab_strip_model();
+  if (pending_index_ < 0 || pending_index_ >= model->count()) {
+    return;
+  }
+  switch (command_id) {
+    case kRemoveFromPinCommand:
+      model->SetTabPinned(pending_index_, false);
+      break;
+    case kToggleBookmarkCommand: {
+      bookmarks::BookmarkModel* bookmarks =
+          BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+      content::WebContents* contents = model->GetWebContentsAt(pending_index_);
+      if (!bookmarks || !bookmarks->loaded() || !contents) {
+        break;
+      }
+      const GURL url = contents->GetLastCommittedURL();
+      auto existing = bookmarks->GetNodesByURL(url);
+      if (existing.empty()) {
+        bookmarks->AddURL(bookmarks->bookmark_bar_node(),
+                          bookmarks->bookmark_bar_node()->children().size(),
+                          contents->GetTitle(), url);
+      } else {
+        for (const bookmarks::BookmarkNode* node : existing) {
+          bookmarks->Remove(node,
+                            bookmarks::metrics::BookmarkEditSource::kUser,
+                            FROM_HERE);
+        }
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+BEGIN_METADATA(AsidePinnedEntriesView)
+END_METADATA
+
+// -- Chip drag ---------------------------------------------------------------
+//
+// RE: dense region 0x04c65910-0x04c6a320 (18,336 B) is this view's body in the
+// original; it calls the horizontal_tab_strip_region_view.cc block that holds
+// FinishEntryDrag (0x04c6b500, 0x04c6b800, 0x04c6b960, 0x04c6ba10) as well as
+// the pinned tab service (0x0485d300) and TabStripModel::ActivateTabAt.  The
+// three moving parts named by the original's callback literals are reproduced
+// below: a ghost chip under the pointer (PinnedEntryDragGhost), the move
+// applied on release (FinishEntryDrag) and the silent drop when capture is
+// lost (CancelEntryDragFromCaptureLoss).
+
+void AsidePinnedEntriesView::OnEntryMousePressed(views::View* entry,
+                                                 const gfx::Point& location) {
+  auto it = entry_indices_.find(entry);
+  if (it == entry_indices_.end()) {
+    return;
+  }
+  drag_entry_ = entry;
+  drag_from_index_ = it->second;
+  drag_to_index_ = it->second;
+  drag_origin_ = location;
+  ghost_offset_ = location - entry->bounds().origin();
+  dragging_ = false;
+}
+
+void AsidePinnedEntriesView::OnEntryMouseDragged(views::View* entry,
+                                                 const gfx::Point& location) {
+  if (drag_entry_ != entry) {
+    return;
+  }
+  if (!dragging_) {
+    if (!views::View::ExceededDragThreshold(location - drag_origin_)) {
+      return;
+    }
+    dragging_ = true;
+    // PinnedEntryDragGhost: a half-transparent copy of the chip that follows
+    // the pointer while the chip itself stays in place.
+    auto ghost = std::make_unique<views::ImageView>();
+    if (auto* button = views::AsViewClass<views::ImageButton>(entry)) {
+      ghost->SetImage(ui::ImageModel::FromImageSkia(
+          button->GetImage(views::Button::STATE_NORMAL)));
+    }
+    ghost->SetSize(entry->size());
+    ghost->SetPaintToLayer();
+    ghost->layer()->SetFillsBoundsOpaquely(false);
+    ghost->layer()->SetOpacity(0.6f);
+    ghost->SetCanProcessEventsWithinSubtree(false);
+    drag_ghost_ = AddChildView(std::move(ghost));
+  }
+  UpdateGhostPosition(location);
+  drag_to_index_ = DropIndexForPoint(location);
+}
+
+void AsidePinnedEntriesView::OnEntryMouseReleased(views::View* entry) {
+  if (drag_entry_ != entry) {
+    return;
+  }
+  FinishEntryDrag();
+}
+
+void AsidePinnedEntriesView::CancelEntryDragFromCaptureLoss() {
+  if (!drag_entry_) {
+    return;
+  }
+  drag_to_index_ = drag_from_index_;
+  EndEntryDrag();
+}
+
+void AsidePinnedEntriesView::FinishEntryDrag() {
+  const bool moved = dragging_ && drag_to_index_ >= 0 &&
+                     drag_to_index_ != drag_from_index_;
+  const int from = drag_from_index_;
+  const int to = drag_to_index_;
+  EndEntryDrag();
+  if (!moved || !browser_) {
+    return;
+  }
+  TabStripModel* model = browser_->tab_strip_model();
+  if (from < 0 || from >= model->count() || to < 0 || to >= model->count() ||
+      !model->IsTabPinned(from) || !model->IsTabPinned(to)) {
+    return;
+  }
+  model->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+  Rebuild();
+}
+
+void AsidePinnedEntriesView::EndEntryDrag() {
+  if (drag_ghost_) {
+    RemoveChildViewT(drag_ghost_.ExtractAsDangling());
+  }
+  drag_entry_ = nullptr;
+  dragging_ = false;
+  drag_from_index_ = -1;
+  drag_to_index_ = -1;
+}
+
+void AsidePinnedEntriesView::UpdateGhostPosition(const gfx::Point& location) {
+  if (!drag_ghost_) {
+    return;
+  }
+  gfx::Rect bounds(drag_ghost_->size());
+  bounds.set_origin(location - ghost_offset_);
+  bounds.AdjustToFit(GetLocalBounds());
+  drag_ghost_->SetBoundsRect(bounds);
+}
+
+int AsidePinnedEntriesView::DropIndexForPoint(const gfx::Point& location) const {
+  int best = drag_from_index_;
+  for (const auto& [view, index] : entry_indices_) {
+    if (!view || view == drag_entry_) {
+      continue;
+    }
+    const gfx::Rect bounds = view->bounds();
+    // Past a neighbour's midpoint along the strip's own axis, the dragged chip
+    // takes that neighbour's slot.
+    const bool past_middle =
+        orientation_ == Orientation::kHorizontal
+            ? location.x() > bounds.CenterPoint().x()
+            : location.y() > bounds.CenterPoint().y();
+    if (index > drag_from_index_ && past_middle) {
+      best = std::max(best, index);
+    } else if (index < drag_from_index_ && !past_middle) {
+      best = std::min(best, index);
+    }
+  }
+  return best;
+}
