@@ -0,0 +1,129 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/aside_bookmark_tab_representation.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+AsideBookmarkTabRepresentation::AsideBookmarkTabRepresentation(Browser* browser)
+    : browser_(browser) {
+  model_ = BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  if (model_) {
+    model_->AddObserver(this);
+  }
+  browser_->tab_strip_model()->AddObserver(this);
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
+
+AsideBookmarkTabRepresentation::~AsideBookmarkTabRepresentation() {
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+  if (browser_) {
+    browser_->tab_strip_model()->RemoveObserver(this);
+  }
+}
+
+void AsideBookmarkTabRepresentation::
+    ScheduleRefreshTabsRepresentedByBookmarks() {
+  if (refresh_scheduled_) {
+    return;
+  }
+  refresh_scheduled_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &AsideBookmarkTabRepresentation::RefreshTabsRepresentedByBookmarks,
+          weak_factory_.GetWeakPtr()));
+}
+
+void AsideBookmarkTabRepresentation::RefreshTabsRepresentedByBookmarks() {
+  refresh_scheduled_ = false;
+  std::map<int64_t, Representation> next;
+  if (model_ && model_->loaded() && browser_) {
+    TabStripModel* tab_strip_model = browser_->tab_strip_model();
+    for (int i = 0; i < tab_strip_model->count(); ++i) {
+      content::WebContents* contents = tab_strip_model->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      const GURL url = contents->GetLastCommittedURL();
+      if (!url.is_valid() || url.is_empty()) {
+        continue;
+      }
+      for (const bookmarks::BookmarkNode* node : model_->GetNodesByURL(url)) {
+        if (!node) {
+          continue;
+        }
+        // The first tab wins, so a bookmark represents the left-most tab that
+        // is showing it.
+        next.emplace(node->id(),
+                     Representation{node->id(), std::string(url.host()), i});
+      }
+    }
+  }
+  if (next == representations_) {
+    return;
+  }
+  representations_ = std::move(next);
+  changed_callbacks_.Notify();
+}
+
+std::optional<AsideBookmarkTabRepresentation::Representation>
+AsideBookmarkTabRepresentation::RepresentationForNode(int64_t node_id) const {
+  auto it = representations_.find(node_id);
+  if (it == representations_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+bool AsideBookmarkTabRepresentation::IsNodeRepresentingOpenTab(
+    int64_t node_id) const {
+  return representations_.contains(node_id);
+}
+
+base::CallbackListSubscription
+AsideBookmarkTabRepresentation::AddChangedCallback(
+    base::RepeatingClosure callback) {
+  return changed_callbacks_.Add(std::move(callback));
+}
+
+void AsideBookmarkTabRepresentation::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
+
+void AsideBookmarkTabRepresentation::OnTabChangedAt(
+    tabs::TabInterface* tab,
+    int index,
+    TabChangeType change_type) {
+  if (change_type == TabChangeType::kAll) {
+    ScheduleRefreshTabsRepresentedByBookmarks();
+  }
+}
+
+void AsideBookmarkTabRepresentation::BookmarkModelChanged() {
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
+
+void AsideBookmarkTabRepresentation::BookmarkModelLoaded(bool ids_reassigned) {
+  ScheduleRefreshTabsRepresentedByBookmarks();
+}
