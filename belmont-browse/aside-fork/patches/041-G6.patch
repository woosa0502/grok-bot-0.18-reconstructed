+
+AsideToolbarCollapseHoverMonitor::AsideToolbarCollapseHoverMonitor() = default;
+
+AsideToolbarCollapseHoverMonitor::~AsideToolbarCollapseHoverMonitor() = default;
+
+// static
+bool AsideToolbarCollapseHoverMonitor::IsPointerInside(
+    const views::View* region,
+    const views::View* collapse_button) {
+  display::Screen* screen = display::Screen::Get();
+  if (!screen) {
+    return false;
+  }
+  const gfx::Point cursor = screen->GetCursorScreenPoint();
+  for (const views::View* view : {region, collapse_button}) {
+    if (view && view->GetVisible() && view->GetWidget() &&
+        view->GetBoundsInScreen().Contains(cursor)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void AsideToolbarCollapseHoverMonitor::Start(const views::View* region,
+                                             const views::View* collapse_button,
+                                             TickCallback on_tick) {
+  region_ = region;
+  collapse_button_ = collapse_button;
+  on_tick_ = std::move(on_tick);
+  if (timer_.IsRunning()) {
+    return;
+  }
+  timer_.Start(FROM_HERE, kInterval,
+               base::BindRepeating(&AsideToolbarCollapseHoverMonitor::OnTick,
+                                   base::Unretained(this)));
+}
+
+void AsideToolbarCollapseHoverMonitor::Stop() {
+  timer_.Stop();
+  exit_timer_.Stop();
+  region_ = nullptr;
+  collapse_button_ = nullptr;
+  on_tick_.Reset();
+}
+
+void AsideToolbarCollapseHoverMonitor::StartExit(base::OnceClosure on_exit) {
+  if (exit_timer_.IsRunning()) {
+    return;
+  }
+  exit_timer_.Start(FROM_HERE, kExitDelay, std::move(on_exit));
+}
+
+void AsideToolbarCollapseHoverMonitor::CancelExit() {
+  exit_timer_.Stop();
+}
+
+bool AsideToolbarCollapseHoverMonitor::IsExitPending() const {
+  return exit_timer_.IsRunning();
+}
+
+bool AsideToolbarCollapseHoverMonitor::IsRunning() const {
+  return timer_.IsRunning();
+}
+
+void AsideToolbarCollapseHoverMonitor::OnTick() {
+  if (on_tick_.is_null()) {
+    return;
+  }
+  // Copy first: the callback may Stop() us, which clears `on_tick_`.
+  TickCallback callback = on_tick_;
+  callback.Run(IsPointerInside(region_, collapse_button_));
+}
