@@ -0,0 +1,58 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_CR_COMPONENTS_SEARCHBOX_ASIDE_SEARCHBOX_PAGE_MIRROR_H_
+#define CHROME_BROWSER_UI_WEBUI_CR_COMPONENTS_SEARCHBOX_ASIDE_SEARCHBOX_PAGE_MIRROR_H_
+
+#include "base/no_destructor.h"
+#include "components/omnibox/browser/searchbox.mojom.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote_set.h"
+
+namespace aside {
+
+// Aside binds a *second* searchbox::mojom::Page endpoint in the browser
+// process, on top of the one the searchbox WebUI owns.  RE of Aside 1.0.825.1
+// x86_64: the extension-API image carries the receive half of the generated
+// Page bindings - the Page stub plus the AutocompleteResult / AutocompleteMatch
+// *readers* at 0x0474dd80 (9 references to "searchbox.mojom.Page" in that
+// block; upstream Chrome for Testing 151.0.7922.171 has only the 10 send-half
+// references) - and the two binds themselves sit inside the private extension
+// API region at 0x048ffcbc and 0x04901890.  A browser-side Page receiver only
+// makes sense as a listener, so the asideOmnibox API is a second consumer of
+// the same autocomplete results the searchbox WebUI receives.
+//
+// This class is that fan-out point: SearchboxHandler pushes each result here as
+// well as to its own page, and anything that wants a copy (the asideOmnibox
+// extension API) adds a Page remote.
+class SearchboxPageMirror {
+ public:
+  static SearchboxPageMirror& Get();
+
+  SearchboxPageMirror(const SearchboxPageMirror&) = delete;
+  SearchboxPageMirror& operator=(const SearchboxPageMirror&) = delete;
+
+  // Adds a listener.  The remote is dropped automatically when it disconnects.
+  void AddPage(mojo::PendingRemote<searchbox::mojom::Page> page);
+
+  bool empty() const { return pages_.empty(); }
+
+  // Fan-out of the Page calls the mirror forwards.  No-ops when nothing is
+  // listening, so the common case costs one branch.
+  void AutocompleteResultChanged(
+      const searchbox::mojom::AutocompleteResultPtr& result);
+  void SetInputText(const std::string& input);
+
+ private:
+  friend class base::NoDestructor<SearchboxPageMirror>;
+
+  SearchboxPageMirror();
+  ~SearchboxPageMirror();
+
+  mojo::RemoteSet<searchbox::mojom::Page> pages_;
+};
+
+}  // namespace aside
+
+#endif  // CHROME_BROWSER_UI_WEBUI_CR_COMPONENTS_SEARCHBOX_ASIDE_SEARCHBOX_PAGE_MIRROR_H_
