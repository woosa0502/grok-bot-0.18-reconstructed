+namespace extensions {
+
+AsideOmniboxSearchboxPage::AsideOmniboxSearchboxPage(
+    AsideOmniboxSession* session)
+    : session_(session) {}
+
+AsideOmniboxSearchboxPage::~AsideOmniboxSearchboxPage() = default;
+
+void AsideOmniboxSearchboxPage::RegisterWithSearchboxMirror() {
+  if (receiver_.is_bound()) {
+    receiver_.reset();
+  }
+  aside::SearchboxPageMirror::Get().AddPage(
+      receiver_.BindNewPipeAndPassRemote());
+}
+
+void AsideOmniboxSearchboxPage::AutocompleteResultChanged(
+    searchbox::mojom::AutocompleteResultPtr result) {
+  if (!result) {
+    return;
+  }
+  // Same field names the session's own onAutocompleteResultChanged uses, so
+  // the extension does not have to tell the two sources apart by shape.
+  base::ListValue matches;
+  for (const searchbox::mojom::AutocompleteMatchPtr& match : result->matches) {
+    if (!match) {
+      continue;
+    }
+    base::DictValue m;
+    m.Set("contents", base::UTF16ToUTF8(match->contents));
+    m.Set("description", base::UTF16ToUTF8(match->description));
+    m.Set("destinationUrl", match->destination_url.spec());
+    m.Set("fillIntoEdit", base::UTF16ToUTF8(match->fill_into_edit));
+    m.Set("isSearchType", match->is_search_type);
+    m.Set("supportsDeletion", match->supports_deletion);
+    m.Set("type", match->type);
+    matches.Append(std::move(m));
+  }
+  base::DictValue payload;
+  payload.Set("matches", std::move(matches));
+  payload.Set("input", base::UTF16ToUTF8(result->input));
+  payload.Set("resultSequenceId", static_cast<double>(result->sequence_id));
+  payload.Set("queryId", result->query_id);
+  // Marks the copy that came in over the mirrored Page pipe rather than from
+  // this session's own AutocompleteController.
+  payload.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onAutocompleteResultChanged",
+                     std::move(payload));
+}
+
+namespace {
+
+base::DictValue SelectionToDict(
+    const searchbox::mojom::OmniboxPopupSelectionPtr& selection) {
+  base::DictValue dict;
+  if (selection) {
+    dict.Set("line", selection->line);
+    dict.Set("state", static_cast<int>(selection->state));
+    dict.Set("actionIndex", selection->action_index);
+  }
+  return dict;
+}
+
+base::DictValue TabToDict(const searchbox::mojom::TabInfoPtr& tab) {
+  base::DictValue dict;
+  if (tab) {
+    dict.Set("tabId", tab->tab_id);
+    dict.Set("title", tab->title);
+    dict.Set("url", tab->url.spec());
+    dict.Set("showInCurrentTabChip", tab->show_in_current_tab_chip);
+    dict.Set("showInPreviousTabChip", tab->show_in_previous_tab_chip);
+  }
+  return dict;
+}
+
+}  // namespace
+
+// Each of the remaining Page methods is the browser-side arrival of one of the
+// events asideOmnibox already declares in its schema, so each one is relayed
+// under the session id rather than dropped.  "source" marks the copy that came
+// in over the mirrored pipe.
+void AsideOmniboxSearchboxPage::UpdateSelection(
+    searchbox::mojom::OmniboxPopupSelectionPtr old_selection,
+    searchbox::mojom::OmniboxPopupSelectionPtr selection) {
+  base::DictValue details;
+  details.Set("oldSelection", SelectionToDict(old_selection));
+  details.Set("selection", SelectionToDict(selection));
+  details.Set("source", "searchbox");
+  session_->Dispatch("asideOmnibox.onSelectionUpdated", std::move(details));
+}
