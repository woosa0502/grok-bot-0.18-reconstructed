+#include "base/memory/weak_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/layout/box_layout_view.h"
+
+class Browser;
+class ProfileMonogramAvatarView;
+
+namespace views {
+class Label;
+}  // namespace views
+
+class AsideProfileMenuView : public views::BoxLayoutView {
+  METADATA_HEADER(AsideProfileMenuView, views::BoxLayoutView)
+
+ public:
+  // The pages the panel walks through. The original names the accessible
+  // roles of three of them "Profile submenu", "Extension submenu" and
+  // "Profile indicator menu".
+  enum class Page {
+    kRoot,
+    kProfiles,
+    kExtensions,
+    kExtensionActions,
+    kBookmarks,
+    kDownloads,
+    kHistory,
+    kDevelopers,
+    kAdvanced,
+    kProfileActions,
+    kIconPicker,
+  };
+
+  // Shows the menu as a bubble above |anchor|. Self-owned until closed.
+  static void Show(views::View* anchor, Browser* browser);
+
+  explicit AsideProfileMenuView(Browser* browser);
+  AsideProfileMenuView(const AsideProfileMenuView&) = delete;
+  AsideProfileMenuView& operator=(const AsideProfileMenuView&) = delete;
+  ~AsideProfileMenuView() override;
+
+  // Closes the bubble after a row ran a browser command.
+  void CloseBubbleForCommand();
+  // Opens the "Extension submenu" for `id`.
+  void OpenExtensionActions(const std::string& id);
+
+ private:
+  void BuildHeader();
+  void ShowPage(Page page);
+
+  void BuildRootPage();
+  void BuildProfilesPage();
+  void BuildExtensionsPage();
+  void BuildExtensionActionsPage();
+  void BuildBookmarksPage();
+  void BuildDownloadsPage();
+  void BuildHistoryPage();
+  void BuildDevelopersPage();
+  void BuildAdvancedPage();
+  void BuildProfileActionsPage();
+  void BuildIconPickerPage();
+
+  void CloseBubble();
+
+  void OpenExtensionRoute(const std::string& route);
+  void OnSwitchProfile(const base::FilePath& path);
+  void OnAddProfile();
+  void OnGuestProfile();
+  void OnEditProfile();
+  void OnDeleteProfile(const base::FilePath& path);
+  void OnSignOut();
+  void OnPickIndicatorIcon(const std::string& icon_name);
+  void OnToggleRemoteDebugging();
+  void OnToggleExternalAiControl();
+  void OnRestoreClosedTab(int session_id);
+  void OnOpenDownload(uint32_t download_id);
+
+  raw_ptr<Browser> browser_;
+  Page page_ = Page::kRoot;
+  // The extension whose "Extension submenu" is open.
+  std::string extension_id_;
+
+  raw_ptr<views::View> header_ = nullptr;
+  raw_ptr<ProfileMonogramAvatarView> avatar_ = nullptr;
+  raw_ptr<views::Label> name_label_ = nullptr;
+  raw_ptr<views::View> body_ = nullptr;
+
+  base::WeakPtrFactory<AsideProfileMenuView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
