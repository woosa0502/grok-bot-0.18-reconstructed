+      ++column;
+      row->AddChildView(std::make_unique<ProfileIndicatorIconButton>(
+          base::BindRepeating(on_pick, std::string(entry.name)), entry,
+          selected == entry.name));
+    }
+  }
+  ~ProfileIndicatorIconPickerPanel() override = default;
+};
