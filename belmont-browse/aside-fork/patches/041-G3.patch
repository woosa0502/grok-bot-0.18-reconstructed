+void AsideProfileMenuView::OnEditProfile() {
+  const base::FilePath path = browser_->profile()->GetPath();
+  std::u16string current;
+  if (ProfileAttributesEntry* entry = EntryForPath(path)) {
+    current = entry->GetName();
+  }
+  auto delegate = std::make_unique<ProfileDialogDelegate>(path);
+  ProfileDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kEditProfileTitle)
+          .SetInternalName("AsideProfileMenuEditProfile")
+          .AddParagraph(ui::DialogModelLabel(kShortRecognizableName))
+          .AddTextfield(kEditProfileNameFieldId, kProfileName, current)
+          .AddOkButton(base::BindOnce(&ProfileDialogDelegate::OnRename,
+                                      base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(kSave))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kEditProfileNameFieldId)
+          .Build();
+  Browser* browser = browser_;
+  CloseBubble();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void AsideProfileMenuView::OnDeleteProfile(const base::FilePath& path) {
+  std::u16string name;
+  if (ProfileAttributesEntry* entry = EntryForPath(path)) {
+    name = entry->GetName();
+  }
+  const std::u16string body =
+      name.empty() ? std::u16string(kThisProfileRemoved)
+                   : base::StrCat({kQuote, name, kWillBeRemoved});
+  auto delegate = std::make_unique<ProfileDialogDelegate>(path);
+  ProfileDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteProfileTitle)
+          .SetInternalName("AsideProfileMenuDeleteProfile")
+          .AddParagraph(ui::DialogModelLabel(body))
+          .AddOkButton(
+              base::BindOnce(&ProfileDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  Browser* browser = browser_;
+  CloseBubble();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
