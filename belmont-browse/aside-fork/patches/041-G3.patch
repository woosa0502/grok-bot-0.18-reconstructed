+void AsideProfileMenuView::BuildDownloadsPage() {
+  AddBackRow(body_, kDownloads,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+
+  content::DownloadManager* manager =
+      browser_->profile()->GetDownloadManager();
+  std::vector<raw_ptr<download::DownloadItem, VectorExperimental>> items;
+  if (manager) {
+    manager->GetAllDownloads(&items);
+  }
+  std::sort(items.begin(), items.end(),
+            [](const download::DownloadItem* a,
+               const download::DownloadItem* b) {
+              return a->GetStartTime() > b->GetStartTime();
+            });
+  size_t shown = 0;
+  for (download::DownloadItem* item : items) {
+    if (shown >= kRecentDownloadCount) {
+      break;
+    }
+    std::u16string state;
+    switch (item->GetState()) {
+      case download::DownloadItem::COMPLETE:
+        state = kDownloaded;
+        break;
+      case download::DownloadItem::INTERRUPTED:
+        state = kFailed;
+        break;
+      case download::DownloadItem::CANCELLED:
+        state = kCancelled;
+        break;
+      default:
+        continue;
+    }
+    ++shown;
+    body_->AddChildView(MakeDownloadRow(
+        base::BindRepeating(&AsideProfileMenuView::OnOpenDownload,
+                            base::Unretained(this), item->GetId()),
+        item->GetFileNameToReportUser().LossyDisplayName(),
+        base::StrCat({state, kSlash,
+                      base::UTF8ToUTF16(item->GetURL().host())})));
+  }
+  if (shown == 0) {
+    body_->AddChildView(MakeSectionLabel(kNoRecentDownloads));
+  }
+
+  body_->AddChildView(std::make_unique<views::Separator>());
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ShowDownloads(browser);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kShowAllDownloads, &kAsideDownloadMenuIcon));
+}
