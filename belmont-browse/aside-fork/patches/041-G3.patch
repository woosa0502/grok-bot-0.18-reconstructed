+          views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(
+              icon ? *icon : vector_icons::kAccountCircleChromeRefreshOldIcon,
+              path == current ? ui::kColorButtonBackgroundProminent
+                              : ui::kColorIcon,
+              kIconSize));
+      body_->AddChildView(std::move(row));
