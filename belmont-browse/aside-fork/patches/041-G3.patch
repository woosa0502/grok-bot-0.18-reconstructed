+  body_->AddChildView(MakeSectionLabel(kInstalledExtensions));
+  int shown = 0;
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(browser_->profile());
+  if (registry) {
+    for (const auto& extension : registry->enabled_extensions()) {
+      if (extensions::Manifest::IsComponentLocation(extension->location()) ||
+          extension->id() == aside::kAsideExtensionId) {
+        continue;
+      }
+      ++shown;
+      body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+          base::BindRepeating(
+              [](AsideProfileMenuView* self, std::string id) {
