+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Aside's profile menu (replica of the original
+// chrome/browser/ui/views/profiles/aside_profile_menu_view.cc): an
+// AsideMenuPanel of AsideMenuItemButton rows anchored to the vertical strip's
+// profile footer, with the original's pages —
+//   root          Profiles / Extensions / Bookmarks / Downloads / History /
+//                 Developers / Settings / New Tab / Incognito Window
+//   Profiles      the other profiles + "New profile"
+//   Extensions    "Installed extensions" (or "No installed extensions"),
+//                 "Manage all extensions", "Import extensions"
+//   extension     "Extension settings" / "Manage extension" / "No options"
+//   Bookmarks     "All bookmarks", "Bookmark this tab"
+//   Downloads     recent DownloadItemTextView rows (or "No recent downloads"),
+//                 "Show all downloads"
+//   History       "Recent tabs" (or "No recent tabs"), "All history"
+//   Developers    "Performance", "Task manager", "Developer tools", "Advanced"
+//   Advanced      "Remote debugging", "Allow external AI to control browser"
+//   Profile
+//   actions       "Edit", "Change Icon", "Sign Out"
+//   Change icon   ProfileIndicatorIconPickerPanel (47 ProfileIndicatorIconButtons)
+// plus the "Edit profile" and "Delete profile?" dialogs.
+// RE: regions 0x04bd8b00, 0x04bf8a90, 0x04bf5120 of the 825.1 framework.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/layout/box_layout_view.h"
+
+class Browser;
+class ProfileMonogramAvatarView;
+
+namespace views {
+class Label;
+}  // namespace views
+
+class AsideProfileMenuView : public views::BoxLayoutView {
+  METADATA_HEADER(AsideProfileMenuView, views::BoxLayoutView)
+
+ public:
+  // The pages the panel walks through. The original names the accessible
+  // roles of three of them "Profile submenu", "Extension submenu" and
+  // "Profile indicator menu".
+  enum class Page {
+    kRoot,
+    kProfiles,
+    kExtensions,
+    kExtensionActions,
+    kBookmarks,
+    kDownloads,
+    kHistory,
+    kDevelopers,
+    kAdvanced,
+    kProfileActions,
+    kIconPicker,
+  };
+
+  // Shows the menu as a bubble above |anchor|. Self-owned until closed.
+  static void Show(views::View* anchor, Browser* browser);
+
+  explicit AsideProfileMenuView(Browser* browser);
+  AsideProfileMenuView(const AsideProfileMenuView&) = delete;
+  AsideProfileMenuView& operator=(const AsideProfileMenuView&) = delete;
+  ~AsideProfileMenuView() override;
+
+  // Closes the bubble after a row ran a browser command.
+  void CloseBubbleForCommand();
+  // Opens the "Extension submenu" for `id`.
+  void OpenExtensionActions(const std::string& id);
+
+ private:
+  void BuildHeader();
+  void ShowPage(Page page);
+
+  void BuildRootPage();
+  void BuildProfilesPage();
+  void BuildExtensionsPage();
+  void BuildExtensionActionsPage();
+  void BuildBookmarksPage();
+  void BuildDownloadsPage();
+  void BuildHistoryPage();
+  void BuildDevelopersPage();
+  void BuildAdvancedPage();
+  void BuildProfileActionsPage();
+  void BuildIconPickerPage();
+
+  void CloseBubble();
+
+  void OpenExtensionRoute(const std::string& route);
+  void OnSwitchProfile(const base::FilePath& path);
+  void OnAddProfile();
+  void OnGuestProfile();
+  void OnEditProfile();
+  void OnDeleteProfile(const base::FilePath& path);
+  void OnSignOut();
+  void OnPickIndicatorIcon(const std::string& icon_name);
+  void OnToggleRemoteDebugging();
+  void OnToggleExternalAiControl();
+  void OnRestoreClosedTab(int session_id);
+  void OnOpenDownload(uint32_t download_id);
+
+  raw_ptr<Browser> browser_;
+  Page page_ = Page::kRoot;
+  // The extension whose "Extension submenu" is open.
+  std::string extension_id_;
+
+  raw_ptr<views::View> header_ = nullptr;
+  raw_ptr<ProfileMonogramAvatarView> avatar_ = nullptr;
+  raw_ptr<views::Label> name_label_ = nullptr;
+  raw_ptr<views::View> body_ = nullptr;
+
+  base::WeakPtrFactory<AsideProfileMenuView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_ASIDE_PROFILE_MENU_VIEW_H_
diff --git a/chrome/browser/ui/views/profiles/profile_monogram_avatar_view.cc b/chrome/browser/ui/views/profiles/profile_monogram_avatar_view.cc
