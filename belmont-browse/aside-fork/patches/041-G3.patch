+///////////////////////////////////////////////////////////////////////////////
+// Browser, Aside profile pager:
+
+void Browser::StashTabsForAsideProfileSwitch() {
+  TRACE_EVENT1("ui", "Browser::StashTabsForAsideProfileSwitch", "tab_count",
+               tab_strip_model_->count());
+  aside_suppress_tab_strip_empty_ = true;
+
+  std::vector<std::unique_ptr<tabs::TabModel>> stash;
+  // MoveTabsPreservingCollections in the original: detach from the back so no
+  // index shifts, then reverse to keep the original left-to-right order.
+  {
+    TRACE_EVENT0("ui", "Browser::MoveTabsPreservingCollections.DetachAll");
+    while (tab_strip_model_->count() > 0) {
+      stash.push_back(tab_strip_model_->DetachTabAtForInsertion(
+          tab_strip_model_->count() - 1));
+    }
+  }
+  std::reverse(stash.begin(), stash.end());
+  // Emptying the strip made UnloadController latch "this browser is closing"
+  // (UnloadController::TabStripEmpty). The window is staying, so drop it —
+  // otherwise the next stash posts ProcessPendingTabs(), which closes the tabs
+  // this pager restores and then the window.
+  if (UnloadController* unload_controller = UnloadController::From(this)) {
+    unload_controller->ResetForAsideProfileSwitch();
+  }
+  if (stash.empty()) {
+    TRACE_EVENT1("ui", "Browser::StashTabsForAsideProfileSwitch.Fallback",
+                 "tab_count", 0);
+    return;
+  }
+  const base::FilePath path = profile_->GetPath();
+  // The stashed WebContents still belong to this profile, so hold it open
+  // until they are restored or the window closes.
+  if (!profile_->IsOffTheRecord() &&
+      !aside_stashed_profile_keep_alives_.contains(path)) {
+    aside_stashed_profile_keep_alives_[path] =
+        std::make_unique<ScopedProfileKeepAlive>(
+            profile_->GetOriginalProfile(),
+            ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+  aside_stashed_tabs_[path] = std::move(stash);
+}
+
+int Browser::RestoreTabsForAsideProfileSwitch() {
+  auto it = aside_stashed_tabs_.find(profile_->GetPath());
+  if (it == aside_stashed_tabs_.end()) {
+    TRACE_EVENT1("ui", "Browser::RestoreTabsForAsideProfileSwitch.Fallback",
+                 "tab_count", 0);
+    return 0;
+  }
+  std::vector<std::unique_ptr<tabs::TabModel>> stash = std::move(it->second);
+  aside_stashed_tabs_.erase(it);
+  aside_stashed_profile_keep_alives_.erase(profile_->GetPath());
+  TRACE_EVENT1("ui", "Browser::RestoreTabsForAsideProfileSwitch", "tab_count",
+               static_cast<int>(stash.size()));
+  int restored = 0;
+  {
+    TRACE_EVENT0("ui", "Browser::MoveTabsPreservingCollections.InsertAll");
+    for (std::unique_ptr<tabs::TabModel>& tab : stash) {
+      tab_strip_model_->InsertDetachedTabAt(
+          tab_strip_model_->count(), std::move(tab),
+          restored == 0 ? ADD_ACTIVE : ADD_NONE);
+      ++restored;
+    }
+  }
+  return restored;
+}
+
+void Browser::SetProfileForAsideProfileSwitch(Profile* profile) {
+  CHECK(profile);
+  CHECK(aside_suppress_tab_strip_empty_)
+      << "SetProfileForAsideProfileSwitch outside a stash/restore pair";
+  if (profile == profile_) {
+    return;
+  }
+  profile_ = profile;
+  tab_strip_model_->SetProfileForAsideProfileSwitch(profile);
+
+  profile_keep_alive_.reset();
+  if (!profile_->IsOffTheRecord()) {
+    profile_keep_alive_ = std::make_unique<ScopedProfileKeepAlive>(
+        profile_->GetOriginalProfile(),
+        ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+
+  profile_pref_registrar_.Reset();
+  profile_pref_registrar_.Init(profile_->GetPrefs());
+  profile_pref_registrar_.Add(
+      prefs::kDevToolsAvailability,
+      base::BindRepeating(&Browser::OnDevToolsAvailabilityChanged,
+                          base::Unretained(this)));
+
+  aside_profile_switched_callback_list_.Notify(this);
+}
+
+base::CallbackListSubscription Browser::RegisterAsideProfileSwitched(
+    AsideProfileSwitchedCallbackList::CallbackType callback) {
+  return aside_profile_switched_callback_list_.Add(std::move(callback));
+}
+
+void Browser::ClearTabStripEmptySuppressionForAsideProfileSwitch() {
+  aside_suppress_tab_strip_empty_ = false;
+  if (tab_strip_model_->empty()) {
+    window_->Close();
+  }
+}
