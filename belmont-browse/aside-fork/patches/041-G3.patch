+void AsideProfileMenuView::BuildProfilesPage() {
+  AddBackRow(body_, kProfiles,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+  body_->GetViewAccessibility().SetName(std::u16string(kProfileSubmenu));
