+namespace {
+
+// Second half of the pager, once the target profile is on disk and loaded.
+void FinishAsideProfileSwitch(base::WeakPtr<Browser> weak_browser,
+                              Profile* profile) {
+  Browser* browser = weak_browser.get();
+  if (!browser) {
+    return;
+  }
+  if (!profile) {
+    // Nothing to page to: put this window back the way it was.
+    browser->RestoreTabsForAsideProfileSwitch();
+    browser->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+    return;
+  }
+  Profile* const old_profile = browser->profile();
+  if (profile == old_profile) {
+    browser->RestoreTabsForAsideProfileSwitch();
+    browser->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+    return;
+  }
+
+  // Hand the Browser over to the target profile's manager service; the window
+  // itself is untouched.
+  std::unique_ptr<Browser> owned =
+      BrowserManagerServiceFactory::GetForProfile(old_profile)
+          ->ReleaseBrowserForAsideProfileSwitch(browser);
+  if (!owned) {
+    browser->RestoreTabsForAsideProfileSwitch();
+    browser->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+    return;
+  }
+  if (SessionServiceBase* old_session =
+          SessionServiceFactory::GetForProfileIfExisting(old_profile)) {
+    old_session->WindowClosed(browser->session_id());
+  }
+
+  browser->SetProfileForAsideProfileSwitch(profile);
+  BrowserManagerServiceFactory::GetForProfile(profile)
+      ->AddBrowserForAsideProfileSwitch(std::move(owned));
+
+  if (browser->RestoreTabsForAsideProfileSwitch() == 0) {
+    AddTabAt(browser, GURL(), /*index=*/-1, /*foreground=*/true);
+  }
+  // PostClearTabStripEmptySuppressionForAsideProfileSwitch in the original:
+  // the suppression is lifted from a posted task, not from inside the profile
+  // creation callback, so an empty strip never closes the window while the
+  // switch is still unwinding.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<Browser> weak) {
+            if (Browser* b = weak.get()) {
+              b->ClearTabStripEmptySuppressionForAsideProfileSwitch();
+            }
+          },
+          browser->AsWeakPtr()));
+
+  // ScheduleSessionRebuildAfterAsideProfileSwitch: the window now belongs to
+  // another profile's session, so re-announce it there and rebuild that
+  // profile's session commands from the live browsers.
+  //
+  // Deliberately not SessionService::WindowOpened(): that calls
+  // RestoreIfNecessary(), and because WindowClosed() above left this profile
+  // with no tracked window it would restore the profile's last session *on
+  // top of* the tabs the pager just put back, doubling them.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<Browser> weak) {
+                       Browser* b = weak.get();
+                       if (!b) {
+                         return;
+                       }
+                       if (SessionService* session =
+                               SessionServiceFactory::GetForProfile(
+                                   b->profile())) {
+                         session->SetWindowType(b->session_id(), b->type());
+                         session->SetSelectedTabInWindow(
+                             b->session_id(),
+                             b->tab_strip_model()->active_index());
+                         session->ResetFromCurrentBrowsers();
+                       }
+                     },
+                     browser->AsWeakPtr()));
+
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    if (local_state->FindPreference("aside.last_active_profile")) {
+      local_state->SetString("aside.last_active_profile",
+                             profile->GetBaseName().AsUTF8Unsafe());
+    }
+  }
+}
+
+}  // namespace
+
+void SwitchProfileInPlaceForAside(Browser* browser,
+                                  const base::FilePath& profile_path) {
+  if (!browser || profile_path.empty()) {
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager || profile_path == browser->profile()->GetPath()) {
+    return;
+  }
+  base::RecordAction(UserMetricsAction("Aside_SwitchProfileInPlace"));
+  browser->StashTabsForAsideProfileSwitch();
+  manager->CreateProfileAsync(
+      profile_path,
+      base::BindOnce(&FinishAsideProfileSwitch, browser->AsWeakPtr()));
+}
