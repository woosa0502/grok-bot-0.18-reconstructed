+// Aside: the viewport that agent ("AI") tabs are rendered into while the agent
+// is working in them.  An agent tab is not the visible tab, so its renderer has
+// no size of its own and would keep whatever size it last had (or none at all).
+// The original browser therefore hands such a tab the size of the visible
+// contents area: it resizes the WebContents to this view's bounds and pushes
+// Emulation.setDeviceMetricsOverride over the tab's own DevTools session,
+// clearing the override again when the tab stops being driven.
+//
+// Restores the original browser's AsideAiTabsViewport, declared in
+// multi_contents_view.h (class name @0xe8d67d9; the update path that resizes
+// the contents and sends the override is @0x04c78900, the two protocol helpers
+// are @0x04c7dbd0 "Emulation.clearDeviceMetricsOverride" and @0x04c7dee0
+// "Emulation.setDeviceMetricsOverride" with width / height /
+// deviceScaleFactor / mobile / scale / screenWidth / screenHeight / positionX /
+// positionY / dontSetVisibleSize).
+class AsideAiTabsViewport : public views::View,
+                            public content::WebContentsObserver,
+                            public content::DevToolsAgentHostClient {
+  METADATA_HEADER(AsideAiTabsViewport, views::View)
+
+ public:
+  AsideAiTabsViewport();
+  AsideAiTabsViewport(const AsideAiTabsViewport&) = delete;
+  AsideAiTabsViewport& operator=(const AsideAiTabsViewport&) = delete;
+  ~AsideAiTabsViewport() override;
+
+  // Starts sizing `web_contents` to this viewport, or stops doing so when
+  // given nullptr. Passing the contents that is already being sized is a
+  // no-op.
+  void SetSizedWebContents(content::WebContents* web_contents);
+  content::WebContents* sized_web_contents() const {
+    return sized_web_contents_;
+  }
+
+  bool has_metrics_override_for_testing() const {
+    return metrics_override_applied_;
+  }
+  const gfx::Size& applied_size_for_testing() const { return applied_size_; }
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override;
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+  bool IsTrusted() override;
+
+ private:
+  // Resizes the sized contents and (re-)applies the metrics override for the
+  // current bounds. Does nothing while the bounds are empty.
+  void ApplyViewportToContents();
+  void SendDeviceMetricsOverride(const gfx::Size& size);
+  void ClearDeviceMetricsOverride();
+  // Serializes {"id":<n>,"method":<method>,"params":<params>} and sends it on
+  // the attached session.
+  void SendCommand(std::string_view method, base::DictValue params);
+  bool EnsureAttached();
+  void Detach();
+
+  raw_ptr<content::WebContents> sized_web_contents_ = nullptr;
+  scoped_refptr<content::DevToolsAgentHost> agent_host_;
+  int next_command_id_ = 1;
+  bool metrics_override_applied_ = false;
+  gfx::Size applied_size_;
+};
