+// --- Aside restoration: AsideAiTabsViewport --------------------------------
+
+AsideAiTabsViewport::AsideAiTabsViewport() {
+  // The viewport carries bounds only. It never paints and never takes events.
+  SetVisible(false);
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+AsideAiTabsViewport::~AsideAiTabsViewport() {
+  SetSizedWebContents(nullptr);
+}
+
+void AsideAiTabsViewport::SetSizedWebContents(
+    content::WebContents* web_contents) {
+  if (sized_web_contents_ == web_contents) {
+    return;
+  }
+  if (sized_web_contents_) {
+    ClearDeviceMetricsOverride();
+    Detach();
+  }
+  sized_web_contents_ = web_contents;
+  Observe(web_contents);
+  if (sized_web_contents_) {
+    ApplyViewportToContents();
+  }
+}
+
+void AsideAiTabsViewport::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::View::OnBoundsChanged(previous_bounds);
+  ApplyViewportToContents();
+}
+
+void AsideAiTabsViewport::WebContentsDestroyed() {
+  // The session is gone with the contents; drop it without talking to it.
+  sized_web_contents_ = nullptr;
+  Observe(nullptr);
+  metrics_override_applied_ = false;
+  applied_size_ = gfx::Size();
+  Detach();
+}
+
+void AsideAiTabsViewport::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+  // The viewport only sends; replies and events are of no interest.
+}
+
+void AsideAiTabsViewport::AgentHostClosed(
+    content::DevToolsAgentHost* agent_host) {
+  agent_host_ = nullptr;
+  metrics_override_applied_ = false;
+  applied_size_ = gfx::Size();
+}
+
+bool AsideAiTabsViewport::IsTrusted() {
+  // A browser-internal client: the Emulation domain is only reachable from a
+  // trusted session.
+  return true;
+}
+
+void AsideAiTabsViewport::ApplyViewportToContents() {
+  if (!sized_web_contents_) {
+    return;
+  }
+  const gfx::Rect bounds = GetLocalBounds();
+  if (bounds.IsEmpty()) {
+    return;
+  }
+  sized_web_contents_->Resize(bounds);
+  if (metrics_override_applied_ && applied_size_ == bounds.size()) {
+    return;
+  }
+  SendDeviceMetricsOverride(bounds.size());
+}
+
+void AsideAiTabsViewport::SendDeviceMetricsOverride(const gfx::Size& size) {
+  if (!EnsureAttached()) {
+    return;
+  }
+  float device_scale_factor = 1.0f;
+  if (const views::Widget* const widget = GetWidget()) {
+    if (const ui::Compositor* const compositor = widget->GetCompositor()) {
+      device_scale_factor = compositor->device_scale_factor();
+    }
+  }
+
+  base::DictValue params;
+  params.Set("width", size.width());
+  params.Set("height", size.height());
+  params.Set("deviceScaleFactor", static_cast<double>(device_scale_factor));
+  params.Set("mobile", false);
+  params.Set("scale", 1.0);
+  params.Set("screenWidth", size.width());
+  params.Set("screenHeight", size.height());
+  params.Set("positionX", 0);
+  params.Set("positionY", 0);
+  params.Set("dontSetVisibleSize", false);
+  SendCommand("Emulation.setDeviceMetricsOverride", std::move(params));
+
+  metrics_override_applied_ = true;
+  applied_size_ = size;
+}
+
+void AsideAiTabsViewport::ClearDeviceMetricsOverride() {
+  if (!metrics_override_applied_) {
+    return;
+  }
+  if (agent_host_) {
+    SendCommand("Emulation.clearDeviceMetricsOverride", base::DictValue());
+  }
+  metrics_override_applied_ = false;
+  applied_size_ = gfx::Size();
+}
+
+void AsideAiTabsViewport::SendCommand(std::string_view method,
+                                      base::DictValue params) {
+  if (!agent_host_) {
+    return;
+  }
+  base::DictValue command;
+  command.Set("id", next_command_id_++);
+  command.Set("method", std::string(method));
+  command.Set("params", std::move(params));
+
+  std::string json;
+  if (!base::JSONWriter::Write(command, &json)) {
+    return;
+  }
+  agent_host_->DispatchProtocolMessage(this, base::as_byte_span(json));
+}
+
+bool AsideAiTabsViewport::EnsureAttached() {
+  if (agent_host_) {
+    return true;
+  }
+  if (!sized_web_contents_) {
+    return false;
+  }
+  scoped_refptr<content::DevToolsAgentHost> host =
+      content::DevToolsAgentHost::GetOrCreateFor(sized_web_contents_);
+  if (!host || !host->AttachClient(this)) {
+    return false;
+  }
+  agent_host_ = std::move(host);
+  return true;
+}
+
+void AsideAiTabsViewport::Detach() {
+  if (!agent_host_) {
+    return;
+  }
+  agent_host_->DetachClient(this);
+  agent_host_ = nullptr;
+}
+
+BEGIN_METADATA(AsideAiTabsViewport)
+END_METADATA
+
+void MultiContentsView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  UpdateAiTabsViewport();
+}
+
+void MultiContentsView::OnTabGroupChanged(const TabGroupChange& change) {
+  UpdateAiTabsViewport();
+}
+
+void MultiContentsView::UpdateAiTabsViewport() {
+  if (!ai_tabs_viewport_) {
+    return;
+  }
+  content::WebContents* agent_contents = nullptr;
+
+  Browser* const browser = browser_view_ ? browser_view_->browser() : nullptr;
+  TabStripModel* const model = browser ? browser->tab_strip_model() : nullptr;
+  if (model && model->SupportsTabGroups()) {
+    content::WebContents* const shown[] = {
+        contents_container_views_[0]->contents_view()->web_contents(),
+        contents_container_views_[1]->GetVisible()
+            ? contents_container_views_[1]->contents_view()->web_contents()
+            : nullptr};
+    for (int i = 0; i < model->count() && !agent_contents; ++i) {
+      const std::optional<tab_groups::TabGroupId> group_id =
+          model->GetTabGroupForTab(i);
+      if (!group_id.has_value()) {
+        continue;
+      }
+      const TabGroup* const group =
+          model->group_model()->GetTabGroup(group_id.value());
+      if (!aside::IsAgentTabsGroup(group)) {
+        continue;
+      }
+      content::WebContents* const contents = model->GetWebContentsAt(i);
+      // Only a tab that is not on screen needs a viewport of its own.
+      if (contents && contents != shown[0] && contents != shown[1]) {
+        agent_contents = contents;
+      }
+    }
+  }
+
+  ai_tabs_viewport_->SetSizedWebContents(agent_contents);
+}
+
 BEGIN_METADATA(MultiContentsView)
 END_METADATA
