diff --git a/chrome/browser/aside_adblock/aside_adblock_tab_helper.cc b/chrome/browser/aside_adblock/aside_adblock_tab_helper.cc
new file mode 100644
index 0000000000..eacf16fcd8
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_tab_helper.cc
@@ -0,0 +1,80 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_tab_helper.h"
+
+#include "base/json/json_writer.h"
+#include "base/strings/string_split.h"
+#include "base/values.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/aside_adblock/aside_adblock_service.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace aside_adblock {
+
+AsideAdBlockTabHelper::AsideAdBlockTabHelper(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<AsideAdBlockTabHelper>(*contents) {}
+
+AsideAdBlockTabHelper::~AsideAdBlockTabHelper() = default;
+
+void AsideAdBlockTabHelper::DOMContentLoaded(
+    content::RenderFrameHost* render_frame_host) {
+  AsideAdBlockService* service =
+      AsideAdBlockService::Get(web_contents()->GetBrowserContext());
+  if (!service) {
+    return;
+  }
+  const GURL& url = render_frame_host->GetLastCommittedURL();
+  std::string css = service->HidingStylesheet(url);
+  if (css.empty()) {
+    return;
+  }
+  // |css| is "sel1,\nsel2,...{display:none!important;}\n" blocks; hand the
+  // selectors to the frame, drop the ones this engine cannot parse (one bad
+  // selector would otherwise void a whole rule) and apply them in chunks.
+  std::vector<std::string> selectors;
+  for (std::string_view block : base::SplitStringPiece(
+           css, "}", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    size_t brace = block.find('{');
+    if (brace == std::string_view::npos) {
+      continue;
+    }
+    for (std::string_view sel : base::SplitStringPiece(
+             block.substr(0, brace), ",\n", base::TRIM_WHITESPACE,
+             base::SPLIT_WANT_NONEMPTY)) {
+      selectors.emplace_back(sel);
+    }
+  }
+  base::ListValue list;
+  for (const std::string& sel : selectors) {
+    list.Append(sel);
+  }
+  std::string json;
+  base::JSONWriter::Write(list, &json);
+  std::string script =
+      "(function(){try{var all=" + json +
+      ";var ok=[];for(var i=0;i<all.length;i++){var q=all[i];"
+      "try{if(CSS.supports('selector('+q+')'))ok.push(q);}catch(e){}}"
+      "var s=document.getElementById('__aside_adblock_hide');"
+      "if(!s){s=document.createElement('style');s.id='__aside_adblock_hide';"
+      "(document.head||document.documentElement).appendChild(s);}"
+      "var css='';for(var j=0;j<ok.length;j+=200){"
+      "css+=ok.slice(j,j+200).join(',')+'{display:none!important;}\\n';}"
+      "s.textContent=css;"
+      "globalThis.__asideAdBlock={addHideSelectors:function(l){"
+      "s.textContent+=l.join(',')+'{display:none!important;}';},"
+      "scheduleProcedural:function(){},takePending:function(){return [];},"
+      "applied:ok.length,dropped:all.length-ok.length};"
+      "}catch(e){}})();";
+  render_frame_host->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::NullCallback(),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AsideAdBlockTabHelper);
+
+}  // namespace aside_adblock
