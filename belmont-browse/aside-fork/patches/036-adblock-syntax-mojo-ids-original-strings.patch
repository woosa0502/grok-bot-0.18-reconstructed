diff --git a/components/subresource_filter/tools/aside_rule_classifier_main.cc b/components/subresource_filter/tools/aside_rule_classifier_main.cc
new file mode 100644
index 0000000000..e783f98481
--- /dev/null
+++ b/components/subresource_filter/tools/aside_rule_classifier_main.cc
@@ -0,0 +1,256 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Offline classifier for Aside ad-block filter lists. Runs every line of the
+// given files through exactly the path chrome/browser/aside_adblock's Engine
+// uses (RuleParser + RulesetIndexer, with the engine's document-rule rewrite
+// and unsupported-selector screen) and prints one TSV row per rule line:
+//   file  line_no  verdict  reason  token  line
+// verdict: url | style | err.  reason (err only): the engine's bucket plus
+// the RuleParser error code; token: the option/selector piece that failed.
+
+#include <iostream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h"
+#include "components/subresource_filter/core/common/indexed_ruleset.h"
+#include "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#include "components/url_pattern_index/proto/rules.pb.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace {
+
+// Copy of aside_adblock_engine.cc's ExtractDocumentRule.
+bool ExtractDocumentRule(std::string_view line, std::string* rewritten) {
+  size_t dollar = line.rfind('$');
+  if (dollar == std::string_view::npos || line.starts_with("@@")) {
+    return false;
+  }
+  std::string_view options = line.substr(dollar + 1);
+  std::vector<std::string> parts = base::SplitString(
+      options, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  bool has_document = false;
+  for (auto& part : parts) {
+    if (part == "document" || part == "doc") {
+      part = "subdocument";
+      has_document = true;
+    }
+  }
+  if (!has_document) {
+    return false;
+  }
+  *rewritten = std::string(line.substr(0, dollar + 1)) +
+               base::JoinString(parts, ",");
+  return true;
+}
+
+// Copy of aside_adblock_engine.cc's IsUnsupportedSelector, returning the
+// matching token instead of a bool.
+std::string_view UnsupportedSelectorToken(std::string_view selector) {
+  static constexpr std::string_view kUnsupported[] = {
+      ":-abp-", ":style(", ":remove(", ":matches-path(", ":upward(",
+      ":xpath(", ":has-text(", ":matches-css", ":min-text-length(",
+      ":watch-attr(", ":remove-attr(", ":remove-class(", ":others(",
+      ":matches-media(", ":matches-prop(", ":matches-attr(", ":if(",
+      ":if-not(", ":nth-ancestor(", ":shadow("};
+  for (std::string_view token : kUnsupported) {
+    if (selector.find(token) != std::string_view::npos) {
+      return token;
+    }
+  }
+  return std::string_view();
+}
+
+const char* ErrorCodeName(subresource_filter::RuleParser::ParseError::ErrorCode code) {
+  using E = subresource_filter::RuleParser::ParseError;
+  switch (code) {
+    case E::NONE: return "NONE";
+    case E::EMPTY_RULE: return "EMPTY_RULE";
+    case E::BAD_ALLOWLIST_SYNTAX: return "BAD_ALLOWLIST_SYNTAX";
+    case E::UNKNOWN_OPTION: return "UNKNOWN_OPTION";
+    case E::NOT_A_TRISTATE_OPTION: return "NOT_A_TRISTATE_OPTION";
+    case E::DEPRECATED_OPTION: return "DEPRECATED_OPTION";
+    case E::ALLOWLIST_ONLY_OPTION: return "ALLOWLIST_ONLY_OPTION";
+    case E::NO_VALUE_PROVIDED: return "NO_VALUE_PROVIDED";
+    case E::WRONG_CSS_RULE_DELIM: return "WRONG_CSS_RULE_DELIM";
+    case E::EMPTY_CSS_SELECTOR: return "EMPTY_CSS_SELECTOR";
+    case E::UNSUPPORTED_FEATURE: return "UNSUPPORTED_FEATURE";
+  }
+  return "?";
+}
+
+const char* BucketName(aside_adblock::PreprocessedRule::Bucket bucket) {
+  using B = aside_adblock::PreprocessedRule::Bucket;
+  switch (bucket) {
+    case B::kMain: return "main";
+    case B::kPopup: return "popup";
+    case B::kGenericHide: return "generichide";
+    case B::kElemHide: return "elemhide";
+    case B::kImportant: return "important";
+    case B::kRedirectRule: return "redirect-rule";
+    case B::kCsp: return "csp";
+    case B::kMethod: return "method";
+  }
+  return "?";
+}
+
+std::string TokenAt(const std::string& line, size_t index) {
+  if (index == std::string::npos || index >= line.size()) {
+    return std::string();
+  }
+  size_t end = line.find_first_of(",=", index);
+  std::string token = line.substr(index, end == std::string::npos
+                                             ? std::string::npos
+                                             : end - index);
+  if (token.size() > 60) {
+    token.resize(60);
+  }
+  return token;
+}
+
+void Emit(const std::string& file, size_t line_no, const char* verdict,
+          const std::string& reason, const std::string& token,
+          const std::string& line) {
+  const std::string row =
+      base::StrCat({file, "\t", base::NumberToString(line_no), "\t", verdict,
+                    "\t", reason, "\t", token, "\t", line, "\n"});
+  std::cout << row;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::AtExitManager exit_manager;
+  base::CommandLine::Init(argc, argv);
+  const base::CommandLine::StringVector args =
+      base::CommandLine::ForCurrentProcess()->GetArgs();
+  if (args.empty()) {
+    std::cerr << "usage: aside_rule_classifier <filter list>...\n";
+    return 2;
+  }
+  for (const auto& arg : args) {
+    base::FilePath path(arg);
+    std::string text;
+    if (!base::ReadFileToString(path, &text)) {
+      std::cerr << "cannot read " << path.value() << "\n";
+      return 1;
+    }
+    const std::string file = path.BaseName().RemoveExtension().value();
+    subresource_filter::RulesetIndexer indexer(1);
+    subresource_filter::RulesetIndexer document_indexer(2);
+    subresource_filter::RuleParser parser;
+    size_t line_no = 0, url_ok = 0, style_ok = 0, errors = 0;
+    for (std::string_view raw : base::SplitStringPiece(
+             text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+      ++line_no;
+      if (raw.empty() || raw[0] == '!' || raw[0] == '[') {
+        continue;
+      }
+      std::string line(raw);
+      std::string cosmetic_line = line;
+      const aside_adblock::CosmeticKind cosmetic =
+          aside_adblock::NormalizeCosmeticRule(&cosmetic_line);
+      if (cosmetic == aside_adblock::CosmeticKind::kUnsupported) {
+        ++errors;
+        Emit(file, line_no, "err", "UNSUPPORTED_FEATURE", "snippet/injection",
+             line);
+        continue;
+      }
+      aside_adblock::PreprocessedRule pre;
+      if (cosmetic == aside_adblock::CosmeticKind::kNotCosmetic) {
+        pre = aside_adblock::PreprocessNetworkRule(line);
+      }
+      std::string rewritten;
+      bool document_rule = false;
+      if (pre.is_network) {
+        document_rule = ExtractDocumentRule(pre.line, &rewritten);
+      }
+      const std::string& parsed =
+          pre.is_network ? (document_rule ? rewritten : pre.line)
+                         : cosmetic_line;
+      url_pattern_index::proto::RuleType type = parser.Parse(parsed);
+      switch (type) {
+        case url_pattern_index::proto::RULE_TYPE_URL: {
+          url_pattern_index::proto::UrlRule proto =
+              parser.url_rule().ToProtobuf();
+          const char* bucket = BucketName(pre.bucket);
+          if (pre.is_regex) {
+            if (pre.bucket != aside_adblock::PreprocessedRule::Bucket::kMain &&
+                pre.bucket !=
+                    aside_adblock::PreprocessedRule::Bucket::kImportant &&
+                pre.bucket != aside_adblock::PreprocessedRule::Bucket::kPopup) {
+              ++errors;
+              Emit(file, line_no, "err", "regex with unsupported option",
+                   bucket, line);
+              break;
+            }
+            re2::RE2::Options opts;
+            opts.set_case_sensitive(proto.match_case());
+            opts.set_log_errors(false);
+            re2::RE2 re(pre.regex, opts);
+            if (!re.ok()) {
+              ++errors;
+              Emit(file, line_no, "err", "regex unsupported", re.error(),
+                   line);
+            } else {
+              ++url_ok;
+              Emit(file, line_no, "url", "regex", bucket, line);
+            }
+            break;
+          }
+          // Side buckets get their own indexer in the engine; here one
+          // scratch indexer per bucket is enough to reproduce indexability.
+          bool ok = document_rule ? document_indexer.AddUrlRule(proto)
+                                  : indexer.AddUrlRule(proto);
+          if (ok) {
+            ++url_ok;
+            Emit(file, line_no, "url", document_rule ? "document" : bucket,
+                 pre.redirect.empty() ? pre.csp : pre.redirect, line);
+          } else {
+            ++errors;
+            Emit(file, line_no, "err", "not indexable", bucket, line);
+          }
+          break;
+        }
+        case url_pattern_index::proto::RULE_TYPE_STYLE: {
+          std::string_view token =
+              UnsupportedSelectorToken(parser.style_rule().selector);
+          if (!token.empty()) {
+            ++errors;
+            Emit(file, line_no, "err", "unsupported selector",
+                 std::string(token), line);
+          } else {
+            ++style_ok;
+            Emit(file, line_no, "style",
+                 parser.style_rule().is_allowlist ? "exception" : "",
+                 std::string(), line);
+          }
+          break;
+        }
+        case url_pattern_index::proto::RULE_TYPE_COMMENT:
+          break;
+        default: {
+          ++errors;
+          const auto& err = parser.parse_error();
+          Emit(file, line_no, "err", ErrorCodeName(err.error_code),
+               TokenAt(err.line, err.error_index), line);
+          break;
+        }
+      }
+    }
+    std::cerr << file << ": url=" << url_ok << " style=" << style_ok
+              << " errors=" << errors << "\n";
+  }
+  return 0;
+}
