+inline constexpr size_t kMaxSubscriptionBytes = 64 * 1024 * 1024;
+
+struct Subscription {
+  Subscription();
+  Subscription(const Subscription&);
+  ~Subscription();
+
+  std::string id;
+  std::string name;
+  std::string url;
+  bool enabled = true;
+  std::string status;  // "idle" | "updating" | "ready" | "error"
+  int64_t content_size = 0;
+  std::string digest;  // SHA-256 hex of the list text
+  std::string etag;
+  std::string last_modified_header;
+  std::string last_error;
+  int network_rule_count = 0;
+  int cosmetic_rule_count = 0;
+  int parse_error_count = 0;
+  std::vector<std::string> invalid_lines;
+  base::Time last_successful_check;
+  base::Time last_content_change;
+  base::Time last_engine_activation;
+  base::Time next_update;
+  std::string text;  // loaded filter list text (empty until fetched)
+};
+
+class AsideAdBlockService : public KeyedService {
+ public:
+  struct LoadedState;
+  struct ManualFile {
+    std::string name;
+    std::string text;
+  };
+  explicit AsideAdBlockService(Profile* profile);
+  ~AsideAdBlockService() override;
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+  static AsideAdBlockService* Get(content::BrowserContext* context);
+
+  bool enabled() const;
+  scoped_refptr<Engine> engine() const { return engine_; }
+
+  // Request filtering (empty result when disabled or no engine yet).
+  MatchResult Evaluate(const GURL& url,
+                       const url::Origin& initiator,
+                       url_pattern_index::proto::ElementType element_type,
+                       bool is_document,
+                       const std::string& method = std::string()) const;
+  // $popup rules for a new window/tab opened by a document at |opener|.
+  MatchResult EvaluatePopup(const GURL& url, const url::Origin& opener) const;
+  // $csp value for the document at |url| (empty when none / disabled).
+  std::string CspForDocument(const GURL& url) const;
+  bool HasCspRules() const;
+  const Resource* FindResource(const std::string& name) const;
+  std::string HidingStylesheet(const GURL& url) const;
+
+  // Internals page operations. Return an error message, empty on success.
+  std::string SetEnabled(bool enabled);
+  std::string AddSubscription(const std::string& name, const std::string& url);
+  std::string SetSubscriptionEnabled(const std::string& id, bool enabled);
+  std::string RemoveSubscription(const std::string& id);
+  std::string UpdateSubscription(const std::string& id);
+  std::string UpdateAllSubscriptions();
+  std::string SaveCustomRules(const std::string& rules);
+  std::string ReloadManualFilters();
+  std::string ClearEngineCache();
+  base::DictValue TestRule(const std::string& url,
+                             const std::string& initiator,
+                             const std::string& request_type,
+                             const std::string& method,
+                             bool third_party) const;
+  base::DictValue State() const;
+
+  const base::FilePath& data_directory() const { return data_dir_; }
+  base::WeakPtr<AsideAdBlockService> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+
+  void LoadFromDisk();
+  void OnLoaded(std::unique_ptr<LoadedState> state);
+  void PersistMetadata();
+  void RequestCompile();
+  void StartCompile();
+  void OnCompiled(uint64_t generation,
+                  base::TimeTicks started,
+                  scoped_refptr<Engine> engine);
+  void StartDownload(const std::string& id);
+  void OnDownloadRedirect(const std::string& id,
+                          const GURL& url_before_redirect,
+                          const net::RedirectInfo& redirect_info,
+                          const network::mojom::URLResponseHead& response_head,
+                          std::vector<std::string>* removed_headers);
+  void CancelDownload(const std::string& id, const std::string& why);
+  void OnDownloadComplete(const std::string& id,
+                          std::optional<std::string> body);
+  void OnAutomaticUpdateTick();
+  Subscription* FindSubscription(const std::string& id);
+  std::vector<FilterSource> CollectSources() const;
+
+  raw_ptr<Profile> profile_;
+  base::FilePath data_dir_;
+  base::FilePath subscriptions_dir_;
+  base::FilePath custom_rules_path_;
+  base::FilePath manual_dir_;
+  base::FilePath cache_dir_;
+
+  bool loaded_ = false;
+  std::vector<Subscription> subscriptions_;
+  std::string custom_rules_;
+  std::string pending_custom_rules_;
+  int custom_network_rule_count_ = 0;
+  int custom_cosmetic_rule_count_ = 0;
+  int custom_parse_error_count_ = 0;
+  std::vector<std::string> custom_invalid_lines_;
+  std::vector<ManualFile> manual_files_;
+  std::string manual_filter_error_;
+  std::string manual_resources_json_;  // <manual dir>/resources.json
+  std::map<std::string, int> redirect_counts_;  // per download id
+
+  scoped_refptr<Engine> engine_;
+  bool compiling_ = false;
+  bool compile_pending_ = false;
+  uint64_t requested_generation_ = 0;
+  uint64_t active_generation_ = 0;
+  base::TimeDelta last_compile_duration_;
+  base::Time last_engine_install_time_;
+  std::string last_compile_error_;
+  bool last_cache_hit_ = false;
+
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  base::RepeatingTimer update_timer_;
+
+  base::WeakPtrFactory<AsideAdBlockService> weak_factory_{this};
+};
