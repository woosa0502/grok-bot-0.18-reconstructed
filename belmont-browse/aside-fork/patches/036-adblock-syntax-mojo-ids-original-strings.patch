@@ -0,0 +1,209 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Aside ad-block engine (replica of the adblock-rust based engine of the
+// original components/aside_adblock). Filter lists in EasyList syntax are
+// parsed with //components/subresource_filter's rule parser and indexed with
+// //components/url_pattern_index; options that index cannot carry ($popup,
+// $generichide/$elemhide, $important, $redirect/$rewrite, $csp, $method) go
+// through aside_adblock_rule_preprocessor into side indexes, /regex/ rules
+// into an RE2 table, and element hiding rules are kept as selector tables.
+// An Engine is immutable once built and can be shared across threads.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/memory/ref_counted.h"
+#include "chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h"
+#include "components/url_pattern_index/proto/rules.pb.h"
+#include "services/network/public/mojom/fetch_api.mojom-forward.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace re2 {
+class RE2;
+}
+
+namespace subresource_filter {
+class FirstPartyOrigin;
+class IndexedRulesetMatcher;
+class RulesetIndexer;
+}  // namespace subresource_filter
+
+namespace aside_adblock {
+
+struct FilterSource {
+  std::string id;     // subscription id, "custom" or "manual:<file>"
+  std::string title;  // human readable title
+  std::string text;   // filter list text (UTF-8)
+};
+
+struct SourceStats {
+  std::string id;
+  std::string title;
+  int network_rule_count = 0;
+  int cosmetic_rule_count = 0;
+  int parse_error_count = 0;
+  std::vector<std::string> invalid_lines;  // "<line>: <error>", capped
+};
+
+struct Resource {
+  std::string mime;
+  std::string body;
+};
+
+struct MatchResult {
+  bool should_block = false;
+  bool has_filter = false;     // a blocking filter matched
+  bool has_exception = false;  // an exception (@@) filter matched
+  std::string filter;          // matched filter text (best effort)
+  std::string source;          // "subscription:<name>" / "custom" / "manual:<f>"
+  std::string redirect_resource;  // $redirect resource name when blocked
+  std::string rewritten_url;      // data: URL of that resource
+};
+
+struct EngineOptions {
+  size_t max_invalid_lines_per_source = 200;
+  std::string resources_json;  // adblock-rust resources.json (may be empty)
+};
+
+// Maps a fetch destination to the EasyList resource type used for matching.
+url_pattern_index::proto::ElementType ElementTypeForDestination(
+    network::mojom::RequestDestination destination);
+
+// Parses a request type name as used by the internals page / TestRule
+// ("script", "image", "stylesheet", "subdocument", "document", "xmlhttprequest",
+// "font", "media", "websocket", "ping", "object", "other").
+url_pattern_index::proto::ElementType ElementTypeForName(
+    const std::string& name,
+    bool* is_document);
+
+class Engine : public base::RefCountedThreadSafe<Engine> {
+ public:
+  // Builds an engine from |sources|. Safe to call on a worker thread.
+  static scoped_refptr<Engine> Build(const std::vector<FilterSource>& sources);
+  static scoped_refptr<Engine> BuildWithOptions(
+      const std::vector<FilterSource>& sources,
+      const EngineOptions& options);
+
+  Engine(const Engine&) = delete;
+  Engine& operator=(const Engine&) = delete;
+
+  // Network filtering. |is_document| selects the top-level document rule set
+  // ($document filters) instead of the sub-resource rule set. |method| is the
+  // HTTP method ("GET"...) for $method rules; empty skips them.
+  MatchResult Evaluate(const GURL& url,
+                       const url::Origin& initiator,
+                       url_pattern_index::proto::ElementType element_type,
+                       bool is_document,
+                       const std::string& method = std::string()) const;
+
+  // $popup rules: a new window/tab navigation to |url| opened by a document at
+  // |opener|.
+  MatchResult EvaluatePopup(const GURL& url, const url::Origin& opener) const;
+
+  // $csp rules: the Content-Security-Policy value to add to the document at
+  // |url|, or empty.
+  std::string CspForDocument(const GURL& url) const;
+
+  // Element hiding: CSS text ("sel1,sel2{display:none!important}") for the
+  // document at |url|, or empty when nothing applies ($elemhide exceptions
+  // disable everything, $generichide the generic selectors).
+  std::string HidingStylesheet(const GURL& url) const;
+
+  // Redirect resource by name (built-in table + resources.json).
+  const Resource* FindResource(const std::string& name) const;
+
+  const std::vector<SourceStats>& sources() const { return sources_; }
+  size_t flatbuffer_size() const { return flatbuffer_size_; }
+  int network_rule_count() const { return network_rule_count_; }
+  int cosmetic_rule_count() const { return cosmetic_rule_count_; }
+  int parse_error_count() const { return parse_error_count_; }
+  int csp_rule_count() const { return csp_rule_count_; }
+  int popup_rule_count() const { return popup_rule_count_; }
+  // Compiled regex patterns (for the internals page).
+  const std::vector<std::string>& regex_patterns() const {
+    return regex_patterns_;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Engine>;
+  struct RuleInfo {
+    std::string text;
+    std::string source;
+  };
+  struct CosmeticRule {
+    std::string selector;
+    std::vector<std::string> include;
+    std::vector<std::string> exclude;
+    bool is_exception = false;
+  };
+  struct SideIndex;
+  struct RegexRule;
+
+  explicit Engine(const EngineOptions& options);
+  ~Engine();
+
+  void AddSource(const FilterSource& source);
+  void Finish();
+  void LoadResources(const std::string& json);
+  const RuleInfo* FindRuleInfo(const std::string& url_pattern) const;
+  static bool DomainMatches(const std::string& host, const std::string& domain);
+  bool RegexRuleMatches(const RegexRule& rule,
+                        const GURL& url,
+                        const url::Origin& initiator,
+                        const subresource_filter::FirstPartyOrigin& first_party,
+                        url_pattern_index::proto::ElementType element_type,
+                        bool is_document) const;
+  void FillRedirect(MatchResult* result,
+                    const std::string& matched_pattern,
+                    const GURL& url,
+                    const subresource_filter::FirstPartyOrigin& first_party,
+                    url_pattern_index::proto::ElementType element_type) const;
+
+  const size_t max_invalid_lines_;
+  std::unique_ptr<subresource_filter::RulesetIndexer> indexer_;
+  std::unique_ptr<subresource_filter::RulesetIndexer> document_indexer_;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> matcher_;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> document_matcher_;
+  // Side indexes for options url_pattern_index cannot carry.
+  std::unique_ptr<SideIndex> popup_;
+  std::unique_ptr<SideIndex> generichide_;
+  std::unique_ptr<SideIndex> elemhide_;
+  std::unique_ptr<SideIndex> important_;
+  std::unique_ptr<SideIndex> important_document_;
+  std::unique_ptr<SideIndex> redirect_rule_;
+  std::unique_ptr<SideIndex> csp_;
+  std::unique_ptr<SideIndex> method_;
+  std::unordered_multimap<std::string, RuleInfo> rules_by_pattern_;
+  std::unordered_map<std::string, std::string> redirect_by_pattern_;
+  std::unordered_map<std::string, std::string> csp_by_pattern_;
+  std::unordered_map<std::string, std::string> method_by_pattern_;
+  std::vector<std::unique_ptr<RegexRule>> regex_rules_;
+  std::vector<std::string> regex_patterns_;
+  std::map<std::string, Resource> resources_;
+
+  std::vector<std::string> generic_selectors_;  // no include, no exclude
+  std::vector<CosmeticRule> conditional_rules_;  // has include or exclude
+  std::string generic_stylesheet_;
+
+  std::vector<SourceStats> sources_;
+  size_t flatbuffer_size_ = 0;
+  int network_rule_count_ = 0;
+  int cosmetic_rule_count_ = 0;
+  int parse_error_count_ = 0;
+  int csp_rule_count_ = 0;
+  int popup_rule_count_ = 0;
+};
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
