+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult Check();
+
+  // Set once the user chose "Continue once" for this navigation so redirects
+  // (e.g. the https upgrade) of the same navigation pass as well.
+  bool allow_once_ = false;
+};
