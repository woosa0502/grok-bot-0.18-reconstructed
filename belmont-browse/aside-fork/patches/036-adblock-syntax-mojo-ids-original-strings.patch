+double ToJsTime(base::Time t) {
+  return t.is_null() ? 0 : t.InMillisecondsFSinceUnixEpoch();
+}
+
+base::Time FromJsTime(double ms) {
+  return ms <= 0 ? base::Time()
+                 : base::Time::FromMillisecondsSinceUnixEpoch(ms);
+}
+
+std::string Sha256Hex(const std::string& text) {
+  return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(text)));
+}
+
+base::ListValue ToList(const std::vector<std::string>& v) {
+  base::ListValue list;
+  for (const std::string& s : v) {
+    list.Append(s);
+  }
+  return list;
+}
+
+// Messages are the original's (strings of AsideAdBlockService in the shipped
+// binary); the check order is inferred.
+std::string ValidateSubscriptionUrl(const std::string& spec) {
+  GURL url(spec);
+  if (!url.is_valid() || !url.SchemeIs("https")) {
+    return "Filter subscriptions must use a valid HTTPS URL.";
+  }
+  if (url.has_username() || url.has_password() || url.has_ref()) {
+    return "Filter URLs cannot contain credentials or fragments.";
+  }
+  const std::string host(url.host());
+  if (url.HostIsIPAddress()) {
+    net::IPAddress address;
+    if (net::ParseURLHostnameToAddress(host, &address)) {
+      if (address.IsLoopback()) {
+        return "Local and loopback filter hosts are not allowed.";
+      }
+      if (!address.IsPubliclyRoutable()) {
+        return "Private, local, and reserved IP addresses are not allowed.";
+      }
+    }
+  } else if (host == "localhost" || host.ends_with(".localhost") ||
+             host.ends_with(".local") || host.find('.') == std::string::npos) {
+    return "Local and loopback filter hosts are not allowed.";
+  }
+  return std::string();
+}
