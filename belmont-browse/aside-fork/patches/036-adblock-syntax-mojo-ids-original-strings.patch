+namespace {
+
+constexpr char kAsideAdblockHost[] = "aside-adblock";
+constexpr char kAdblockInternalsHost[] = "adblock-internals";
+
+base::FilePath ResourceDir() {
+  base::FilePath dir;
+  base::PathService::Get(base::DIR_EXE, &dir);
+  return dir.AppendASCII("aside_resources").AppendASCII("adblock");
+}
+
+bool ShouldHandleRequest(const std::string& path) {
+  return path.empty() || path == "adblock_internals.html" ||
+         path == "adblock_internals.css" || path == "adblock_internals.js" ||
+         path == "adblock_internals.mojom-webui.js";
+}
+
+scoped_refptr<base::RefCountedMemory> ReadResource(std::string path) {
+  if (path.empty()) {
+    path = "adblock_internals.html";
+  }
+  std::string data;
+  if (!base::ReadFileToString(ResourceDir().AppendASCII(path), &data)) {
+    return base::MakeRefCounted<base::RefCountedString>(std::string());
+  }
+  if (path.ends_with(".html")) {
+    base::ReplaceSubstringsAfterOffset(&data, 0, "$i18n{textdirection}", "ltr");
+    base::ReplaceSubstringsAfterOffset(&data, 0, "$i18n{language}", "en");
+  }
+  return base::MakeRefCounted<base::RefCountedString>(std::move(data));
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&ReadResource, path), std::move(callback));
+}
+
+void ConfigureSource(content::WebUIDataSource* source) {
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandleRequest),
+                           base::BindRepeating(&HandleRequest));
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src chrome://theme chrome://resources 'self' 'unsafe-inline';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes,
+      "trusted-types static-types adblock-internals lit-html;");
+  source->DisableTrustedTypesCSP();
+}
+
+}  // namespace
