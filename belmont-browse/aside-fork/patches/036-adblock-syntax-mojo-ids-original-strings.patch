+std::string AsideAdBlockService::SetEnabled(bool enabled) {
+  profile_->GetPrefs()->SetBoolean(kEnabledPref, enabled);
+  return std::string();
+}
+
+std::string AsideAdBlockService::AddSubscription(const std::string& name,
+                                                 const std::string& url) {
+  if (subscriptions_.size() >= kMaxSubscriptions) {
+    return "A maximum of " + base::NumberToString(kMaxSubscriptions) +
+           " filter subscriptions is supported.";
+  }
+  std::string trimmed_url;
+  base::TrimWhitespaceASCII(url, base::TRIM_ALL, &trimmed_url);
+  std::string error = ValidateSubscriptionUrl(trimmed_url);
+  if (!error.empty()) {
+    return error;
+  }
+  for (const Subscription& s : subscriptions_) {
+    if (s.url == trimmed_url) {
+      return "This filter URL has already been added.";
+    }
+  }
+  Subscription s;
+  s.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::TrimWhitespaceASCII(name, base::TRIM_ALL, &s.name);
+  if (s.name.size() > kMaxFilterNameLength) {
+    return "Filter name is too long.";
+  }
+  if (s.name.empty()) {
+    s.name = GURL(trimmed_url).host();
+  }
+  s.url = trimmed_url;
+  s.status = "idle";
+  subscriptions_.push_back(std::move(s));
+  PersistMetadata();
+  StartDownload(subscriptions_.back().id);
+  return std::string();
+}
+
+std::string AsideAdBlockService::SetSubscriptionEnabled(const std::string& id,
+                                                        bool enabled) {
+  Subscription* s = FindSubscription(id);
+  if (!s) {
+    return "Filter subscription was not found.";
+  }
+  if (s->enabled == enabled) {
+    return std::string();
+  }
+  s->enabled = enabled;
+  PersistMetadata();
+  RequestCompile();
+  if (enabled && s->text.empty()) {
+    StartDownload(id);
+  }
+  return std::string();
+}
+
+std::string AsideAdBlockService::RemoveSubscription(const std::string& id) {
+  auto it = std::find_if(subscriptions_.begin(), subscriptions_.end(),
+                         [&](const Subscription& s) { return s.id == id; });
+  if (it == subscriptions_.end()) {
+    return "Filter subscription was not found.";
+  }
+  loaders_.erase(id);
+  subscriptions_.erase(it);
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(base::IgnoreResult(&base::DeleteFile),
+                     subscriptions_dir_.AppendASCII(id + ".txt")));
+  PersistMetadata();
+  RequestCompile();
+  return std::string();
+}
+
+std::string AsideAdBlockService::UpdateSubscription(const std::string& id) {
+  if (!FindSubscription(id)) {
+    return "Filter subscription was not found.";
+  }
+  StartDownload(id);
+  return std::string();
+}
+
+std::string AsideAdBlockService::UpdateAllSubscriptions() {
+  for (const Subscription& s : subscriptions_) {
+    if (s.enabled) {
+      StartDownload(s.id);
+    }
+  }
+  return std::string();
+}
+
+void AsideAdBlockService::StartDownload(const std::string& id) {
+  Subscription* s = FindSubscription(id);
+  if (!s || loaders_.contains(id)) {
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(s->url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->method = net::HttpRequestHeaders::kGetMethod;
+  if (!s->etag.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kIfNoneMatch, s->etag);
+  }
+  if (!s->last_modified_header.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kIfModifiedSince,
+                               s->last_modified_header);
+  }
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess();
+  if (!factory) {
+    s->status = "error";
+    s->last_error = "The profile network service is not available.";
+    PersistMetadata();
+    return;
+  }
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(base::Minutes(2));
+  loader->SetOnRedirectCallback(
+      base::BindRepeating(&AsideAdBlockService::OnDownloadRedirect,
+                          weak_factory_.GetWeakPtr(), id));
+  network::SimpleURLLoader* raw = loader.get();
+  loaders_[id] = std::move(loader);
+  redirect_counts_[id] = 0;
+  s->status = "updating";
+  raw->DownloadToString(
+      factory.get(),
+      base::BindOnce(&AsideAdBlockService::OnDownloadComplete,
+                     weak_factory_.GetWeakPtr(), id),
+      kMaxSubscriptionBytes);
+}
+
+void AsideAdBlockService::OnDownloadRedirect(
+    const std::string& id,
+    const GURL& url_before_redirect,
+    const net::RedirectInfo& redirect_info,
+    const network::mojom::URLResponseHead& response_head,
+    std::vector<std::string>* removed_headers) {
+  std::string why;
+  if (++redirect_counts_[id] > kMaxDownloadRedirects) {
+    why = "Filter download exceeded five redirects.";
+  } else {
+    const std::string error =
+        ValidateSubscriptionUrl(redirect_info.new_url.spec());
+    if (!error.empty()) {
+      why = "Unsafe redirect rejected: " + redirect_info.new_url.spec();
+    }
+  }
+  if (why.empty()) {
+    return;
+  }
+  // The loader must not be destroyed from its own callback.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AsideAdBlockService::CancelDownload,
+                                weak_factory_.GetWeakPtr(), id, why));
+}
+
+void AsideAdBlockService::CancelDownload(const std::string& id,
+                                         const std::string& why) {
+  if (!loaders_.erase(id)) {
+    return;
+  }
+  redirect_counts_.erase(id);
+  if (Subscription* s = FindSubscription(id)) {
+    s->status = "error";
+    s->last_error = why;
+    s->next_update = base::Time::Now() + kUpdateInterval;
+    PersistMetadata();
+  }
+}
+
+void AsideAdBlockService::OnDownloadComplete(const std::string& id,
+                                             std::optional<std::string> body) {
+  auto loader_it = loaders_.find(id);
+  if (loader_it == loaders_.end()) {
+    return;
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader = std::move(loader_it->second);
+  loaders_.erase(loader_it);
+  redirect_counts_.erase(id);
+  Subscription* s = FindSubscription(id);
+  if (!s) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  s->next_update = now + kUpdateInterval;
+
+  int status = 0;
+  const network::mojom::URLResponseHead* head = loader->ResponseInfo();
+  if (head && head->headers) {
+    status = head->headers->response_code();
+  }
+  auto fail = [&](const std::string& why) {
+    s->status = "error";
+    s->last_error = why;
+    PersistMetadata();
+  };
+  if (loader->NetError() != net::OK && loader->NetError() != net::ERR_FAILED) {
+    fail(std::string("Network error: ") + net::ErrorToShortString(loader->NetError()));
+    return;
+  }
+  if (status == 304) {
+    s->status = "ready";
+    s->last_error.clear();
+    s->last_successful_check = now;
+    PersistMetadata();
+    return;
+  }
+  if (status != 200 || !body) {
+    fail("Filter server returned HTTP " + base::NumberToString(status) + ".");
+    return;
+  }
+  if (body->empty() || !base::IsStringUTF8(*body) ||
+      body->find('\0') != std::string::npos) {
+    fail("Downloaded content is not a valid UTF-8 filter list.");
+    return;
+  }
+  if (head && head->headers) {
+    s->etag = head->headers->GetNormalizedHeader("ETag").value_or("");
+    s->last_modified_header =
+        head->headers->GetNormalizedHeader("Last-Modified").value_or("");
+  }
+  s->status = "ready";
+  s->last_error.clear();
+  s->last_successful_check = now;
+  const std::string digest = Sha256Hex(*body);
+  if (digest != s->digest) {
+    s->digest = digest;
+    s->text = std::move(*body);
+    s->content_size = static_cast<int64_t>(s->text.size());
+    s->last_content_change = now;
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&WriteTextOnWorker,
+                       subscriptions_dir_.AppendASCII(id + ".txt"), s->text));
+    if (s->enabled) {
+      RequestCompile();
+    }
+  }
+  PersistMetadata();
+}
+
+void AsideAdBlockService::OnAutomaticUpdateTick() {
+  if (!loaded_) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  for (const Subscription& s : subscriptions_) {
+    if (s.enabled && s.next_update <= now) {
+      StartDownload(s.id);
+    }
+  }
+}
+
+// ---- custom / manual / cache ------------------------------------------------
+
+std::string AsideAdBlockService::SaveCustomRules(const std::string& rules) {
+  if (rules.size() > kMaxCustomRulesBytes) {
+    return "Custom rules exceed the 4 MiB limit.";
+  }
+  if (!base::IsStringUTF8(rules) || rules.find('\0') != std::string::npos) {
+    return "Custom rules must be valid UTF-8 text without NUL bytes.";
+  }
+  custom_rules_ = rules;
+  pending_custom_rules_.clear();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WriteTextOnWorker, custom_rules_path_, rules));
+  RequestCompile();
+  return std::string();
+}
+
+std::string AsideAdBlockService::ReloadManualFilters() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath manual_dir) {
+            auto state = std::make_unique<LoadedState>();
+            base::FileEnumerator files(manual_dir, false,
+                                       base::FileEnumerator::FILES,
+                                       FILE_PATH_LITERAL("*.txt"));
+            for (base::FilePath path = files.Next(); !path.empty();
+                 path = files.Next()) {
+              ManualFile file;
+              file.name = path.BaseName().AsUTF8Unsafe();
+              if (!base::ReadFileToString(path, &file.text) ||
+                  !base::IsStringUTF8(file.text)) {
+                state->manual_error =
+                    "failed to read manual adblock file: " + file.name;
+                continue;
+              }
+              state->manual_files.push_back(std::move(file));
+            }
+            base::ReadFileToString(manual_dir.AppendASCII("resources.json"),
+                                   &state->resources_json);
+            return state;
+          },
+          manual_dir_),
+      base::BindOnce(
+          [](base::WeakPtr<AsideAdBlockService> self,
+             std::unique_ptr<LoadedState> state) {
+            if (!self) {
+              return;
+            }
+            self->manual_files_ = std::move(state->manual_files);
+            self->manual_filter_error_ = std::move(state->manual_error);
+            self->manual_resources_json_ = std::move(state->resources_json);
+            self->RequestCompile();
+          },
+          weak_factory_.GetWeakPtr()));
+  return std::string();
+}
+
+std::string AsideAdBlockService::ClearEngineCache() {
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(base::IgnoreResult(&base::DeletePathRecursively),
+                     cache_dir_));
+  last_cache_hit_ = false;
+  RequestCompile();
+  return std::string();
+}
+
+// ---- diagnostics -----------------------------------------------------------
+
+base::DictValue AsideAdBlockService::TestRule(const std::string& url_spec,
+                                                const std::string& initiator,
+                                                const std::string& request_type,
+                                                const std::string& method,
+                                                bool third_party) const {
+  base::DictValue out;
+  GURL url(url_spec);
+  out.Set("url", url_spec);
+  out.Set("requestType", request_type);
+  out.Set("method", method);
+  out.Set("thirdParty", third_party);
+  if (!url.is_valid()) {
+    out.Set("error", "Invalid URL");
+    return out;
+  }
+  url::Origin origin;
+  GURL initiator_url(initiator);
+  if (initiator_url.is_valid()) {
+    origin = url::Origin::Create(initiator_url);
+  } else if (!third_party) {
+    origin = url::Origin::Create(url);
+  }
+  bool is_document = false;
+  url_pattern_index::proto::ElementType type =
+      ElementTypeForName(request_type, &is_document);
+  MatchResult r;
+  if (engine_) {
+    r = engine_->Evaluate(url, origin, type, is_document, method);
+  }
+  out.Set("engineAvailable", engine_ != nullptr);
+  out.Set("enabled", enabled());
+  out.Set("shouldBlock", r.should_block);
+  out.Set("hasFilter", r.has_filter);
+  out.Set("hasException", r.has_exception);
+  out.Set("filter", r.filter);
+  out.Set("source", r.source);
+  out.Set("rewrittenUrl", r.rewritten_url);
+  out.Set("redirectResource", r.redirect_resource);
+  out.Set("initiator", origin.Serialize());
+  return out;
+}
+
+base::DictValue AsideAdBlockService::State() const {
+  base::DictValue d;
+  d.Set("enabled", enabled());
+  d.Set("loaded", loaded_);
+  d.Set("compiling", compiling_);
+  d.Set("requestedGeneration", static_cast<double>(requested_generation_));
+  d.Set("activeGeneration", static_cast<double>(active_generation_));
+  d.Set("lastCompileDurationMs",
+        static_cast<double>(last_compile_duration_.InMilliseconds()));
+  d.Set("lastEngineInstallTime", ToJsTime(last_engine_install_time_));
+  d.Set("lastEngineInstallTimeMs", ToJsTime(last_engine_install_time_));
+  d.Set("lastCompileError", last_compile_error_);
+  d.Set("networkAvailable", true);
+  d.Set("dataDirectory", data_dir_.AsUTF8Unsafe());
+  d.Set("cacheDirectory", cache_dir_.AsUTF8Unsafe());
+  d.Set("manualFilterDirectory", manual_dir_.AsUTF8Unsafe());
+  d.Set("manualFilterError", manual_filter_error_);
+  d.Set("manualFilterCount", static_cast<int>(manual_files_.size()));
+
+  base::ListValue subs;
+  for (const Subscription& s : subscriptions_) {
+    subs.Append(SubscriptionToDict(s));
+  }
+  d.Set("subscriptions", std::move(subs));
+
+  base::DictValue custom;
+  custom.Set("rules", custom_rules_);
+  custom.Set("pendingRules", pending_custom_rules_);
+  custom.Set("networkRuleCount", custom_network_rule_count_);
+  custom.Set("cosmeticRuleCount", custom_cosmetic_rule_count_);
+  custom.Set("parseErrorCount", custom_parse_error_count_);
+  custom.Set("invalidLines", ToList(custom_invalid_lines_));
+  custom.Set("contentSize", static_cast<double>(custom_rules_.size()));
+  custom.Set("maxSize", static_cast<double>(kMaxCustomRulesBytes));
+  d.Set("custom", std::move(custom));
+
+  base::ListValue engines;
+  if (engine_) {
+    base::DictValue e;
+    e.Set("kind", "active");
+    e.Set("generation", static_cast<double>(active_generation_));
+    e.Set("flatbufferSize", static_cast<double>(engine_->flatbuffer_size()));
+    e.Set("cacheHit", last_cache_hit_);
+    e.Set("networkRuleCount", engine_->network_rule_count());
+    e.Set("cosmeticRuleCount", engine_->cosmetic_rule_count());
+    e.Set("parseErrorCount", engine_->parse_error_count());
+    const std::vector<std::string>& patterns = engine_->regex_patterns();
+    e.Set("compiledRegexCount", static_cast<int>(patterns.size()));
+    base::ListValue regexes;
+    constexpr size_t kMaxListedRegexes = 100;
+    for (size_t i = 0; i < patterns.size() && i < kMaxListedRegexes; ++i) {
+      base::DictValue r;
+      r.Set("regex", patterns[i]);
+      r.Set("usageCount", 0);
+      regexes.Append(std::move(r));
+    }
+    e.Set("regexes", std::move(regexes));
+    e.Set("regexesTruncated", patterns.size() > kMaxListedRegexes);
+    e.Set("popupRuleCount", engine_->popup_rule_count());
+    e.Set("cspRuleCount", engine_->csp_rule_count());
+    base::ListValue sources;
+    for (const SourceStats& stats : engine_->sources()) {
+      base::DictValue s;
+      s.Set("id", stats.id);
+      s.Set("title", stats.title);
+      s.Set("networkRuleCount", stats.network_rule_count);
+      s.Set("cosmeticRuleCount", stats.cosmetic_rule_count);
+      s.Set("parseErrorCount", stats.parse_error_count);
+      sources.Append(std::move(s));
+    }
+    e.Set("sources", std::move(sources));
+    engines.Append(std::move(e));
+  }
+  d.Set("engines", std::move(engines));
+  return d;
+}
+
+}  // namespace aside_adblock
