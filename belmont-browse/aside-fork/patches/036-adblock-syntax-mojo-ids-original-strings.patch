+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_TAB_HELPER_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_TAB_HELPER_H_
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace aside_adblock {
+
+// Applies element hiding (cosmetic) filters to every frame once its DOM is
+// available. The original performs this in AsideAdBlockRenderFrameObserver via
+// the aside_adblock.mojom.CosmeticFilterHost interface; the fork injects the
+// same hide-selector stylesheet from the browser process instead.
+class AsideAdBlockTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<AsideAdBlockTabHelper> {
+ public:
