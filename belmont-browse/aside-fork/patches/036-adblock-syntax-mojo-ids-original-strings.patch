+// ---- subscriptions ---------------------------------------------------------
+
+Subscription* AsideAdBlockService::FindSubscription(const std::string& id) {
+  for (Subscription& s : subscriptions_) {
+    if (s.id == id) {
+      return &s;
+    }
+  }
+  return nullptr;
+}
