+TEST(AsideImportJobTest, CancellationCannotBeRevivedByLateCallbacks) {
+  ImportJob job;
+  job.requested_items = user_data_importer::FAVORITES;
+  job.Cancelled();
+  job.Started();
+  job.ItemStarted("bookmarks");
+  job.ItemEnded(user_data_importer::FAVORITES);
+  job.Failed("late utility error");
+  job.Ended();
+  EXPECT_EQ("cancelled", job.state);
