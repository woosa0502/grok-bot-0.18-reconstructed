+
+bool DevToolsAgentHostImpl::HasSecureRemoteDebuggingSession() {
+  return std::ranges::any_of(sessions_, [](const auto& session) {
+    return session->GetClient()->IsSecureRemoteDebuggingSession();
+  });
+}
+
+void DevToolsAgentHostImpl::ForceDetachSecureRemoteDebuggingSessions() {
+  scoped_refptr<DevToolsAgentHost> retain_this(this);
+  // Detaching may destroy a child Target session and mutate sessions_. Search
+  // afresh each time, retaining this host through the callbacks.
+  for (;;) {
+    auto it = std::ranges::find_if(sessions_, [](const auto& session) {
+      return session->GetClient()->IsSecureRemoteDebuggingSession();
+    });
+    if (it == sessions_.end()) return;
+    DevToolsAgentHostClient* client = (*it)->GetClient();
+    DetachClient(client);
+    client->AgentHostClosed(this);
+  }
 }
 
