+TEST(AsideImportJobTest, FailureIsNotReportedAsSuccessOrCancellation) {
+  ImportJob job;
+  job.requested_items = user_data_importer::FAVORITES;
+  job.Started();
+  job.Failed("utility disconnected");
+  job.Cancelled();
+  job.ItemEnded(user_data_importer::FAVORITES);
+  job.Ended();
+  EXPECT_EQ("failed", job.state);
+  EXPECT_EQ("utility disconnected", job.error_message);
