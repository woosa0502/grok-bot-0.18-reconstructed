+class AsideSessionObserver : public DevToolsAgentHostObserver {
+ public:
+  explicit AsideSessionObserver(DevToolsAgentHost* tracked) : tracked_(tracked) {}
+  void DevToolsAgentHostAttached(DevToolsAgentHost* host) override {
+    if (host == tracked_) ++attached;
+  }
+  void DevToolsAgentHostDetached(DevToolsAgentHost* host) override {
+    if (host == tracked_) ++detached;
+  }
+  void DevToolsAgentHostSecureSessionsChanged(DevToolsAgentHost* host) override {
+    if (host == tracked_) ++secure_changes;
+  }
+  int attached = 0;
+  int detached = 0;
+  int secure_changes = 0;
+ private:
+  raw_ptr<DevToolsAgentHost> tracked_;
+};
