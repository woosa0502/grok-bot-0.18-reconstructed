+TEST(AsideSafariArchiveTest, PendingUnpackAndActiveImportRejectSecondSelection) {
+  aside::PendingSafariArchive gate;
+  ASSERT_TRUE(gate.CanPick(false));
+  const auto first = gate.Begin(false);
+  ASSERT_TRUE(first);
+  EXPECT_FALSE(gate.CanPick(false));
+  EXPECT_FALSE(gate.Begin(false));
+  EXPECT_TRUE(gate.Complete(*first, false));
+  // Archive one is now used by an import: a second archive cannot replace it.
+  EXPECT_FALSE(gate.CanPick(true));
+  EXPECT_FALSE(gate.Begin(true));
+}
+
+TEST(AsideSafariArchiveTest, ActiveImportPreventsArchiveReplacementOnCompletion) {
+  aside::PendingSafariArchive gate;
+  const auto token = gate.Begin(false);
+  ASSERT_TRUE(token);
+  std::string active_archive = "archive-one";
+  if (gate.Complete(*token, true)) active_archive = "archive-two";
+  EXPECT_EQ("archive-one", active_archive);
+}
+
+TEST(AsideSafariArchiveTest, CancelRevokesOldCompletionWithoutStealingNewWork) {
+  aside::PendingSafariArchive gate;
+  const auto old_token = gate.Begin(false);
+  ASSERT_TRUE(old_token);
+  gate.Cancel();
+  const auto new_token = gate.Begin(false);
+  ASSERT_TRUE(new_token);
+  EXPECT_NE(*old_token, *new_token);
+  EXPECT_FALSE(gate.Complete(*old_token, false));
+  EXPECT_FALSE(gate.CanPick(false));
+  EXPECT_TRUE(gate.Complete(*new_token, false));
+  EXPECT_FALSE(gate.Complete(*new_token, false));
+}
