+++ b/chrome/browser/extensions/api/aside_browser_import/import_job_unittest.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_browser_import/import_job.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+using extensions::aside_import::ImportJob;
+
+TEST(AsideImportStateTest, CancellationIsTerminalUnderEveryLateCallback) {
+  ImportJob job;
+  job.requested_items = 3;
+  job.Cancelled();
+  job.Started();
+  job.ItemStarted("bookmarks");
+  job.ItemEnded(3);
+  job.Failed("late failure");
+  job.Ended();
+  EXPECT_EQ("cancelled", job.state);
+  EXPECT_EQ(0.0, job.progress);
+  EXPECT_TRUE(job.current_data_kind.empty());
+}
+
+TEST(AsideImportStateTest, FailureSurvivesTheHostCancellationPath) {
+  ImportJob job;
+  job.requested_items = 1;
+  job.Started();
+  job.Failed("utility disconnected");
+  job.Cancelled();
+  job.ItemEnded(1);
+  job.Ended();
+  EXPECT_EQ("failed", job.state);
+  EXPECT_EQ("utility disconnected", job.error_message);
+}
+
+TEST(AsideImportStateTest, DuplicateAndUnrequestedItemsCannotInflateProgress) {
+  ImportJob job;
+  job.requested_items = 3;
+  job.Started();
+  job.ItemEnded(1);
+  job.ItemEnded(1);
+  job.ItemEnded(8);
+  EXPECT_EQ(0.5, job.progress);
+  job.ItemEnded(2);
+  job.Ended();
+  EXPECT_EQ("succeeded", job.state);
+  EXPECT_EQ(1.0, job.progress);
+  job.Cancelled();
+  EXPECT_EQ("succeeded", job.state);
+}
+
+TEST(AsideImportStateTest, EarlyEndDoesNotManufactureSuccess) {
+  ImportJob job;
+  job.requested_items = 3;
+  job.ItemEnded(1);
+  job.Ended();
+  EXPECT_EQ("failed", job.state);
+  EXPECT_EQ(0.5, job.progress);
+  EXPECT_FALSE(job.error_message.empty());
+}
+
+TEST(AsideImportStateTest, EmptyFailureStillHasActionableError) {
+  ImportJob job;
+  job.Failed("");
+  EXPECT_EQ("failed", job.state);
+  EXPECT_FALSE(job.error_message.empty());
+}
+
+int main(int argc, char** argv) {
+  testing::InitGoogleTest(&argc, argv);
+  return RUN_ALL_TESTS();
+}
