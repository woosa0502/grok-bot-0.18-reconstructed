+  int callbacks = 0;
+  auto* host = new ExternalProcessImporterHost();
+  aside::ImportDataSession session(
+      host, user_data_importer::FAVORITES | user_data_importer::HISTORY,
+      "firefox", base::BindLambdaForTesting([&callbacks](aside::ImportDataResult result) {
+        ++callbacks;
+        EXPECT_EQ(aside::ImportDataResult::State::kSucceeded, result.state);
+      }));
+  host->NotifyImportItemEnded(user_data_importer::FAVORITES);
+  host->NotifyImportItemEnded(user_data_importer::FAVORITES);
+  host->NotifyImportItemEnded(user_data_importer::HISTORY);
+  host->NotifyImportEnded();
+  session.ImportEnded();
+  EXPECT_EQ(1, callbacks);
+}
+
+TEST(AsideImportWebUiSessionTest, IncompleteImportIsFailure) {
+  content::BrowserTaskEnvironment environment;
+  std::optional<aside::ImportDataResult> result;
+  auto* host = new ExternalProcessImporterHost();
+  aside::ImportDataSession session(
+      host, user_data_importer::FAVORITES, "firefox",
+      base::BindLambdaForTesting([&result](aside::ImportDataResult value) {
+        result = std::move(value);
+      }));
+  host->NotifyImportEnded();
+  ASSERT_TRUE(result);
+  EXPECT_EQ(aside::ImportDataResult::State::kFailed, result->state);
+}
+
+TEST(AsideImportWebUiSessionTest, PageDestructionDetachesBeforeCancellation) {
+  content::BrowserTaskEnvironment environment;
+  int callbacks = 0;
+  {
+    auto* host = new ExternalProcessImporterHost();
+    aside::ImportDataSession session(
+        host, user_data_importer::FAVORITES, "firefox",
+        base::BindLambdaForTesting([&callbacks](aside::ImportDataResult) { ++callbacks; }));
+    EXPECT_TRUE(session.importing());
+  }  // Cancels the real host without allowing callbacks into a dying page.
+  EXPECT_EQ(0, callbacks);
+}
+
+TEST(AsideImportWebUiSessionTest, CompletionMayDestroyThePageSession) {
+  content::BrowserTaskEnvironment environment;
+  auto* host = new ExternalProcessImporterHost();
+  std::unique_ptr<aside::ImportDataSession> session;
+  session = std::make_unique<aside::ImportDataSession>(
+      host, user_data_importer::FAVORITES, "safari",
+      base::BindLambdaForTesting([&session](aside::ImportDataResult result) {
+        EXPECT_EQ(aside::ImportDataResult::State::kSucceeded, result.state);
+        session.reset();
+      }));
+  host->NotifyImportItemEnded(user_data_importer::FAVORITES);
+  host->NotifyImportEnded();
+  EXPECT_FALSE(session);
+}
