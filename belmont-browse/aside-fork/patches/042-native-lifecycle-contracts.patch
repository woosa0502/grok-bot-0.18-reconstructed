+  job.requested_items = user_data_importer::FAVORITES | user_data_importer::HISTORY;
+  job.Started();
+  job.ItemEnded(user_data_importer::FAVORITES);
+  job.ItemEnded(user_data_importer::FAVORITES);
+  job.ItemEnded(user_data_importer::PASSWORDS);
