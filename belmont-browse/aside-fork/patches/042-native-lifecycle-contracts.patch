+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_ASIDE_BROWSER_IMPORT_IMPORT_JOB_H_
+#define CHROME_BROWSER_EXTENSIONS_API_ASIDE_BROWSER_IMPORT_IMPORT_JOB_H_
+
+#include <bit>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+namespace extensions::aside_import {
+
+// Terminal outcomes are monotonic, including when utility callbacks race
+// cancellation. Progress counts selected kinds, not duplicated notifications.
+struct ImportJob {
+  std::string source_id;
+  std::string state = "queued";
+  double progress = 0.0;
+  std::string current_data_kind;
+  std::string error_message;
+  uint16_t requested_items = 0;
+  uint16_t finished_items = 0;
+
+  bool IsActive() const { return state == "queued" || state == "importing"; }
+  void Started() {
+    if (IsActive()) state = "importing";
+  }
+  void ItemStarted(std::string kind) {
+    if (IsActive()) current_data_kind = std::move(kind);
+  }
+  void ItemEnded(uint16_t item) {
+    if (!IsActive()) return;
+    finished_items |= item & requested_items;
+    if (requested_items) {
+      progress = static_cast<double>(std::popcount(finished_items)) /
+                 std::popcount(requested_items);
+    }
+  }
+  void Failed(const std::string& message) {
+    if (!IsActive()) return;
+    state = "failed";
+    error_message = message.empty() ? "Import failed" : message;
+    current_data_kind.clear();
+  }
+  void Cancelled() {
+    if (!IsActive()) return;
+    state = "cancelled";
+    current_data_kind.clear();
+  }
+  void Ended() {
+    if (!IsActive()) return;
+    if (!requested_items || finished_items != requested_items) {
+      Failed("Import ended before all selected data types completed");
+      return;
+    }
+    state = "succeeded";
+    progress = 1.0;
+    current_data_kind.clear();
+  }
+};
+
+}  // namespace extensions::aside_import
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_ASIDE_BROWSER_IMPORT_IMPORT_JOB_H_
