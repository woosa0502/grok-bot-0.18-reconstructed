+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sync/aside_sync_auth_manager.h"
+#include "chrome/browser/sync/aside_sync_auth_manager_factory.h"
+#include "chrome/browser/sync/sync_service_factory.h"
+#include "components/sync/base/data_type.h"
+
+namespace {
+
+constexpr base::TimeDelta kWatchdogInterval = base::Minutes(2);
+
+bool IsTransient(syncer::SyncService::TransportState state) {
+  switch (state) {
+    case syncer::SyncService::TransportState::START_DEFERRED:
+    case syncer::SyncService::TransportState::INITIALIZING:
+    case syncer::SyncService::TransportState::PENDING_DESIRED_CONFIGURATION:
+    case syncer::SyncService::TransportState::CONFIGURING:
+      return true;
+    case syncer::SyncService::TransportState::DISABLED:
+    case syncer::SyncService::TransportState::PAUSED:
+    case syncer::SyncService::TransportState::ACTIVE:
+      return false;
+  }
+}
+
+}  // namespace
+
+AsideSyncRefreshWatchdog::AsideSyncRefreshWatchdog(Profile* profile)
+    : profile_(profile) {
+  if (syncer::SyncService* sync = SyncServiceFactory::GetForProfile(profile_)) {
+    sync_observation_.Observe(sync);
+  }
+}
+
+AsideSyncRefreshWatchdog::~AsideSyncRefreshWatchdog() = default;
+
+void AsideSyncRefreshWatchdog::Shutdown() {
+  watchdog_.Stop();
+  sync_observation_.Reset();
+}
+
+void AsideSyncRefreshWatchdog::OnStateChanged(syncer::SyncService* sync) {
+  if (!IsTransient(sync->GetTransportState())) {
+    watchdog_.Stop();
+    return;
+  }
+  if (watchdog_.IsRunning()) {
+    return;
+  }
+  watchdog_.Start(FROM_HERE, kWatchdogInterval,
+                  base::BindOnce(&AsideSyncRefreshWatchdog::OnWatchdogFired,
+                                 weak_factory_.GetWeakPtr()));
+}
+
+void AsideSyncRefreshWatchdog::OnSyncShutdown(syncer::SyncService* sync) {
+  watchdog_.Stop();
+  sync_observation_.Reset();
+}
+
+void AsideSyncRefreshWatchdog::OnWatchdogFired() {
+  syncer::SyncService* sync = SyncServiceFactory::GetForProfile(profile_);
+  if (!sync || !IsTransient(sync->GetTransportState())) {
+    return;
+  }
+  VLOG(1) << "Aside sync refresh watchdog: sync stalled in transport state "
+          << static_cast<int>(sync->GetTransportState())
+          << "; asking the daemon for a fresh access token";
+  if (AsideSyncAuthManager* auth =
+          AsideSyncAuthManagerFactory::GetForProfile(profile_)) {
+    auth->RequestAccessToken(/*force_refresh=*/true, base::DoNothing());
+  }
+  sync->TriggerRefresh(syncer::SyncService::TriggerRefreshSource::kUnknown,
+                       syncer::DataTypeSet::All());
+}
