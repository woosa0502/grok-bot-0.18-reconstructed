@@ -0,0 +1,171 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/component_updater/aside_component_update_service_helpers.h"
+
+#include <signal.h>
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/strcat.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace component_updater {
+
+namespace {
+
+// RE: "aside_component_update.log" (0xe5720dd).
+constexpr base::FilePath::CharType kLogFileName[] =
+    FILE_PATH_LITERAL("aside_component_update.log");
+
+// RE: "Aside Daemon.app" / "Contents" / "MacOS" / "aside-daemon".
+constexpr base::FilePath::CharType kMacBundleName[] =
+    FILE_PATH_LITERAL("Aside Daemon.app");
+constexpr base::FilePath::CharType kMacContents[] =
+    FILE_PATH_LITERAL("Contents");
+constexpr base::FilePath::CharType kMacExecutableDir[] =
+    FILE_PATH_LITERAL("MacOS");
+constexpr base::FilePath::CharType kDaemonExecutable[] =
+    FILE_PATH_LITERAL("aside-daemon");
+
+}  // namespace
+
+void AppendAsideComponentUpdateLog(const std::string& line) {
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &dir) || dir.empty()) {
+    // RE: "Failed to resolve Aside component update log directory".
+    LOG(WARNING) << "Failed to resolve Aside component update log directory";
+    return;
+  }
+  const base::FilePath path = dir.Append(kLogFileName);
+  const std::string entry = base::StrCat({line, "\n"});
+  // base::AppendToFile opens with FLAG_OPEN, which fails while the log does
+  // not exist yet, so the first line written in a fresh profile would be lost.
+  if (!base::PathExists(path)) {
+    if (!base::WriteFile(path, entry)) {
+      LOG(WARNING) << "Failed to create Aside component update log at "
+                   << path.value();
+    }
+    return;
+  }
+  if (!base::AppendToFile(path, entry)) {
+    // RE: "Failed to append Aside component update log to ".
+    LOG(WARNING) << "Failed to append Aside component update log to "
+                 << path.value();
+  }
+}
+
+std::vector<base::FilePath> AsideDaemonExecutableCandidates(
+    const base::FilePath& install_dir) {
+  std::vector<base::FilePath> candidates;
+  if (install_dir.empty()) {
+    return candidates;
+  }
+  // The macOS layout that ships in the published CRX.
+  candidates.push_back(install_dir.Append(kMacBundleName)
+                           .Append(kMacContents)
+                           .Append(kMacExecutableDir)
+                           .Append(kDaemonExecutable));
+  // The layouts a POSIX component can use.
+  candidates.push_back(install_dir.Append(kDaemonExecutable));
+  candidates.push_back(
+      install_dir.Append(FILE_PATH_LITERAL("bin")).Append(kDaemonExecutable));
+  return candidates;
+}
+
+bool RepairAsideDaemonExecutablePermissions(const base::FilePath& executable,
+                                            std::string* error) {
+  int mode = 0;
+  if (!base::GetPosixFilePermissions(executable, &mode)) {
+    // RE: "Failed to read Aside Daemon executable permissions: ".
+    if (error) {
+      *error = "Failed to read Aside Daemon executable permissions: " +
+               executable.value();
+    }
+    return false;
+  }
+  const int wanted = mode | base::FILE_PERMISSION_EXECUTE_BY_USER;
+  if (wanted == mode) {
+    return true;
+  }
+  if (!base::SetPosixFilePermissions(executable, wanted)) {
+    // RE: "Failed to repair Aside Daemon executable permissions: ".
+    if (error) {
+      *error = "Failed to repair Aside Daemon executable permissions: " +
+               executable.value();
+    }
+    return false;
+  }
+  return true;
+}
+
+int ForceKillAsideDaemonProcesses(const std::vector<base::FilePath>& candidates,
+                                  int* matched) {
+  int matched_count = 0;
+  int killed = 0;
+  if (candidates.empty()) {
+    // RE: "Skipped Aside Daemon force-kill because expected executable path
+    // list is empty".
+    LOG(WARNING) << "Skipped Aside Daemon force-kill because expected "
+                    "executable path list is empty";
+    if (matched) {
+      *matched = 0;
+    }
+    return 0;
+  }
+  for (const base::FilePath& candidate : candidates) {
+    // RE: "Aside Daemon force-kill expected executable candidate: ".
+    VLOG(1) << "Aside Daemon force-kill expected executable candidate: "
+            << candidate.value();
+  }
+
+  base::FileEnumerator processes(base::FilePath(FILE_PATH_LITERAL("/proc")),
+                                 /*recursive=*/false,
+                                 base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath entry = processes.Next(); !entry.empty();
+       entry = processes.Next()) {
+    int pid = 0;
+    if (!base::StringToInt(entry.BaseName().value(), &pid) || pid <= 0) {
+      continue;
+    }
+    base::FilePath exe;
+    if (!base::ReadSymbolicLink(entry.Append(FILE_PATH_LITERAL("exe")), &exe)) {
+      // Almost every process here belongs to somebody else; only complain
+      // about the ones we were asked about.
+      continue;
+    }
+    bool is_candidate = false;
+    for (const base::FilePath& candidate : candidates) {
+      if (exe == candidate) {
+        is_candidate = true;
+        break;
+      }
+    }
+    if (!is_candidate) {
+      continue;
+    }
+    ++matched_count;
+    if (kill(pid, SIGKILL) == 0) {
+      // RE: "Force-killed Aside Daemon PID ".
+      VLOG(1) << "Force-killed Aside Daemon PID " << pid;
+      ++killed;
+    } else {
+      // RE: "Failed to force-kill Aside Daemon PID ".
+      LOG(WARNING) << "Failed to force-kill Aside Daemon PID " << pid;
+    }
+  }
+  if (matched) {
+    *matched = matched_count;
+  }
+  return killed;
+}
+
+}  // namespace component_updater
