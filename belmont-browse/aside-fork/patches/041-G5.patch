+
+#ifndef CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_UPDATE_SERVICE_HELPERS_H_
+#define CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_UPDATE_SERVICE_HELPERS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+
+// Blocking-thread helpers shared by the Aside component installer and the
+// Aside component update service.
+// RE: chrome/browser/component_updater/aside_component_update_service_helpers.cc
+// (Aside Framework 1.0.825.1, region 0x0491e180 / 0x04a357a0).
+namespace component_updater {
+
+// Appends `line` to <user data dir>/aside_component_update.log. Runs on a
+// blocking sequence.
+void AppendAsideComponentUpdateLog(const std::string& line);
+
+// Every path the Aside Daemon executable can live at inside `install_dir`.
+// The macOS original looks inside "Aside Daemon.app/Contents/MacOS"; the
+// Linux layout keeps the executable at the top of the component or under
+// bin/. All candidates are returned so a force-kill can match any of them.
+std::vector<base::FilePath> AsideDaemonExecutableCandidates(
+    const base::FilePath& install_dir);
+
+// Gives `executable` the owner-execute bit if it does not have it. Returns
+// false and fills `error` when the permissions could not be read or written.
+bool RepairAsideDaemonExecutablePermissions(const base::FilePath& executable,
+                                            std::string* error);
+
+// Kills every running process whose executable is one of `candidates`.
+// `matched` receives the number of processes that matched. Returns the number
+// actually killed. Never touches a process outside `candidates`.
+int ForceKillAsideDaemonProcesses(
+    const std::vector<base::FilePath>& candidates,
+    int* matched);
+
+}  // namespace component_updater
+
+#endif  // CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_UPDATE_SERVICE_HELPERS_H_
