+++ b/chrome/browser/component_updater/aside_component_installer.cc
@@ -0,0 +1,223 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/component_updater/aside_component_installer.h"
+
+#include <array>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/memory/scoped_refptr.h"
+#include "chrome/browser/component_updater/aside_component_update_service_helpers.h"
+#include "components/component_updater/component_updater_service.h"
+#include "components/crx_file/id_util.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace component_updater {
+
+namespace {
+
+// SHA-256 of the SubjectPublicKeyInfo that signs the published Aside Daemon
+// CRX. Recovered from the CRX3 header of
+// AsideDaemon-1.26.905.904.crx; the first sixteen bytes fold to the Omaha app
+// id "kbbaihbiiohdfpocgkpkmngpjcpddbhh" used in the original update request.
+constexpr std::array<uint8_t, 32> kAsideDaemonPublicKeySHA256 = {
+    0xa1, 0x10, 0x87, 0x18, 0x8e, 0x73, 0x5f, 0xe2, 0x6a, 0xfa, 0xcd,
+    0x6f, 0x92, 0xf3, 0x31, 0x77, 0x58, 0xb6, 0x51, 0x8b, 0x88, 0x4e,
+    0x5e, 0x69, 0xd8, 0x35, 0x03, 0x71, 0xa0, 0x41, 0x92, 0xae};
+
+// Same, for AsideAgentManager-1.26.905.904.crx; app id
+// "fjdhphbdlfjogobdofoaagnlnkoibdge".
+constexpr std::array<uint8_t, 32> kAsideAgentManagerPublicKeySHA256 = {
+    0x59, 0x37, 0xf7, 0x13, 0xb5, 0x9e, 0x6e, 0x13, 0xe5, 0xe0, 0x06,
+    0xdb, 0xda, 0xe8, 0x13, 0x64, 0x5e, 0xcc, 0x89, 0xb0, 0xc5, 0x57,
+    0xb1, 0xce, 0x78, 0xa2, 0x17, 0x3c, 0x2a, 0x3e, 0xf0, 0x59};
+
+// Aside Password Manager. No published CRX was ever captured for this
+// component, but the original keeps the three key hashes in one table in
+// __DATA_CONST: "AsidePasswordManager" (0xd9c1cd8) is immediately followed by
+// this 32-byte hash at 0xd9c1cf8 (arm64: 0xc799758), exactly the way
+// "AsideAgentManager"/"Aside Daemon" are followed by the two hashes that the
+// published CRX3 headers confirm byte for byte. Folds to the app id
+// "clcdgiameigmljcbkkcbjiljinmfkncl".
+constexpr std::array<uint8_t, 32> kAsidePasswordManagerPublicKeySHA256 = {
+    0x2b, 0x23, 0x68, 0x0c, 0x48, 0x6c, 0xb9, 0x21, 0xaa, 0x21, 0x98,
+    0xb9, 0x8d, 0xc5, 0xad, 0x2b, 0xa6, 0xb2, 0x56, 0x32, 0x35, 0x17,
+    0xed, 0x00, 0x1e, 0xe9, 0x26, 0x78, 0xd4, 0x2a, 0x6e, 0x4b};
+
+// RE: "aside_component" (0xe5709ce) — the root every component installs under.
+constexpr base::FilePath::CharType kAsideComponentDir[] =
+    FILE_PATH_LITERAL("aside_component");
+
+constexpr base::FilePath::CharType kManifestFileName[] =
+    FILE_PATH_LITERAL("manifest.json");
+
+}  // namespace
+
+std::string AsideComponentToken(AsideComponentKind kind) {
+  switch (kind) {
+    case AsideComponentKind::kDaemon:
+      return "aside-daemon";
+    case AsideComponentKind::kPasswordManager:
+      return "password-manager";
+    case AsideComponentKind::kAgentManager:
+      return "agent-manager";
+  }
+}
+
+std::string AsideComponentName(AsideComponentKind kind) {
+  switch (kind) {
+    case AsideComponentKind::kDaemon:
+      return "Aside Daemon";
+    case AsideComponentKind::kPasswordManager:
+      return "Aside Password Manager";
+    case AsideComponentKind::kAgentManager:
+      return "Aside Agent Manager";
+  }
+}
+
+std::vector<uint8_t> AsideComponentPublicKeyHash(AsideComponentKind kind) {
+  switch (kind) {
+    case AsideComponentKind::kDaemon:
+      return std::vector<uint8_t>(kAsideDaemonPublicKeySHA256.begin(),
+                                  kAsideDaemonPublicKeySHA256.end());
+    case AsideComponentKind::kAgentManager:
+      return std::vector<uint8_t>(kAsideAgentManagerPublicKeySHA256.begin(),
+                                  kAsideAgentManagerPublicKeySHA256.end());
+    case AsideComponentKind::kPasswordManager:
+      return std::vector<uint8_t>(kAsidePasswordManagerPublicKeySHA256.begin(),
+                                  kAsidePasswordManagerPublicKeySHA256.end());
+  }
+}
+
+std::string AsideComponentAppId(AsideComponentKind kind) {
+  const std::vector<uint8_t> hash = AsideComponentPublicKeyHash(kind);
+  if (hash.empty()) {
+    return std::string();
+  }
+  return crx_file::id_util::GenerateIdFromHash(hash);
+}
+
+AsideComponentInstallerPolicy::AsideComponentInstallerPolicy(
+    AsideComponentKind kind,
+    AsideComponentReadyCallback ready_callback)
+    : kind_(kind), ready_callback_(std::move(ready_callback)) {}
+
+AsideComponentInstallerPolicy::~AsideComponentInstallerPolicy() = default;
+
+bool AsideComponentInstallerPolicy::
+    SupportsGroupPolicyEnabledComponentUpdates() const {
+  return false;
+}
+
+bool AsideComponentInstallerPolicy::RequiresNetworkEncryption() const {
+  // Not recoverable from the original binary. CRX3 signature verification
+  // against the pinned key above is what actually gates installation, and the
+  // published URLs are https either way.
+  return false;
+}
+
+update_client::CrxInstaller::Result
+AsideComponentInstallerPolicy::OnCustomInstall(
+    const base::DictValue& manifest,
+    const base::FilePath& install_dir) {
+  if (kind_ == AsideComponentKind::kDaemon) {
+    for (const base::FilePath& candidate :
+         AsideDaemonExecutableCandidates(install_dir)) {
+      if (!base::PathExists(candidate)) {
+        continue;
+      }
+      std::string error;
+      if (!RepairAsideDaemonExecutablePermissions(candidate, &error)) {
+        LOG(WARNING) << error;
+      }
+    }
+  }
+  return update_client::CrxInstaller::Result(update_client::InstallError::NONE);
+}
+
+void AsideComponentInstallerPolicy::OnCustomUninstall() {}
+
+bool AsideComponentInstallerPolicy::VerifyInstallation(
+    const base::DictValue& manifest,
+    const base::FilePath& install_dir) const {
+  if (kind_ == AsideComponentKind::kDaemon) {
+    for (const base::FilePath& candidate :
+         AsideDaemonExecutableCandidates(install_dir)) {
+      if (base::PathExists(candidate)) {
+        return true;
+      }
+    }
+    // RE: "Aside Daemon executable is missing: ".
+    LOG(WARNING) << "Aside Daemon executable is missing: "
+                 << install_dir.value();
+    return false;
+  }
+  // The extension-shaped components (agent manager, password manager) ship a
+  // Chrome extension manifest at their root.
+  return base::PathExists(install_dir.Append(kManifestFileName));
+}
+
+void AsideComponentInstallerPolicy::ComponentReady(
+    const base::Version& version,
+    const base::FilePath& install_dir,
+    base::DictValue manifest) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!install_dir.IsAbsolute()) {
+    // RE: "Aside component extension install directory is not absolute: ".
+    LOG(WARNING) << "Aside component extension install directory is not "
+                    "absolute: "
+                 << install_dir.value();
+    return;
+  }
+  if (ready_callback_) {
+    ready_callback_.Run(kind_, version, install_dir);
+  }
+}
+
+base::FilePath AsideComponentInstallerPolicy::GetRelativeInstallDir() const {
+  return base::FilePath(kAsideComponentDir)
+      .AppendASCII(AsideComponentToken(kind_));
+}
+
+void AsideComponentInstallerPolicy::GetHash(std::vector<uint8_t>* hash) const {
+  *hash = AsideComponentPublicKeyHash(kind_);
+}
+
+std::string AsideComponentInstallerPolicy::GetName() const {
+  return AsideComponentName(kind_);
+}
+
+update_client::InstallerAttributes
+AsideComponentInstallerPolicy::GetInstallerAttributes() const {
+  return update_client::InstallerAttributes();
+}
+
+void RegisterAsideComponents(ComponentUpdateService* cus,
+                             AsideComponentReadyCallback ready_callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  for (AsideComponentKind kind :
+       {AsideComponentKind::kDaemon, AsideComponentKind::kPasswordManager,
+        AsideComponentKind::kAgentManager}) {
+    if (AsideComponentPublicKeyHash(kind).empty()) {
+      // RE: "A bundled Aside component was not found after component
+      // registration completed".
+      VLOG(1) << "A bundled Aside component was not found after component "
+                 "registration completed: "
+              << AsideComponentToken(kind);
+      continue;
+    }
+    auto installer = base::MakeRefCounted<ComponentInstaller>(
+        std::make_unique<AsideComponentInstallerPolicy>(kind, ready_callback));
+    installer->Register(cus, base::DoNothing());
+  }
+}
+
+}  // namespace component_updater
