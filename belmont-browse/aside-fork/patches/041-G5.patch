new file mode 100644
index 0000000000..05fc26a4b8
--- /dev/null
+++ b/chrome/browser/sync/aside_sync_encryption_controller.cc
@@ -0,0 +1,277 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/sync/aside_sync_encryption_controller.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/signin/aside_daemon_authorizer.h"
+#include "chrome/browser/sync/sync_service_factory.h"
+#include "components/prefs/pref_service.h"
+#include "components/sync/service/sync_user_settings.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kDiagnosticPref[] = "aside.sync_encryption_diagnostic_message";
+constexpr char kAccountIdPref[] = "aside.account_id";
+
+// Original diagnostic strings, 0xe4bbdcf - 0xe4bc0a6.
+constexpr char kWaitingForEncryptionState[] =
+    "Daemon key: waiting for sync encryption state.";
+constexpr char kWaitingForCachedKey[] =
+    "Daemon key: waiting for Chromium to apply the cached sync encryption key.";
+constexpr char kWaitingForEnable[] =
+    "Daemon key: waiting for sync encryption to finish enabling.";
+constexpr char kWaitingForStart[] =
+    "Daemon key: waiting for sync encryption to start.";
+constexpr char kRequestingKey[] =
+    "Daemon key: requesting sync encryption key...";
+constexpr char kFailedToAuthorize[] =
+    "Daemon key: failed to authorize daemon request.";
+constexpr char kCannotReachDaemon[] =
+    "Daemon key: can't reach the local Aside daemon.";
+constexpr char kLocalSecurityUnavailable[] =
+    "Daemon key: local account security is not available yet.";
+constexpr char kNoKeyReturned[] =
+    "Daemon key: failed to return a sync encryption key.";
+constexpr char kMalformedData[] =
+    "Daemon key: returned malformed sync encryption data.";
+constexpr char kKeyRejected[] =
+    "Chromium rejected the local sync encryption key.";
+constexpr char kEnabling[] = "Daemon key: enabling sync encryption...";
+
+// Original request format string, 0xe4bbf14.
+constexpr char kPassphrasePathFormat[] = "%s/auth/sync-passphrase?accountId=%d";
+constexpr char kPassphraseKey[] = "passphrase";
+
+constexpr size_t kMaxBody = 256 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aside_sync_encryption_controller", R"(
+        semantics {
+          sender: "Aside sync encryption controller"
+          description: "Asks the local Aside daemon for the passphrase that "
+                       "decrypts the account's synced data."
+          trigger: "The sync engine reports that a passphrase is required."
+          data: "Aside account id."
+          destination: LOCAL
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not user controllable."
+          policy_exception_justification: "Loopback only."
+        })");
+
+}  // namespace
+
+AsideSyncEncryptionController::AsideSyncEncryptionController(Profile* profile)
+    : profile_(profile) {
+  if (syncer::SyncService* sync = SyncServiceFactory::GetForProfile(profile_)) {
+    sync_observation_.Observe(sync);
+  }
+  SetDiagnostic(kWaitingForEncryptionState);
+}
+
+AsideSyncEncryptionController::~AsideSyncEncryptionController() = default;
+
+void AsideSyncEncryptionController::Shutdown() {
+  sync_observation_.Reset();
+}
+
+int AsideSyncEncryptionController::AccountId() const {
+  PrefService* prefs = profile_ ? profile_->GetPrefs() : nullptr;
+  if (!prefs || !prefs->FindPreference(kAccountIdPref)) {
+    return -1;
+  }
+  return prefs->GetInteger(kAccountIdPref);
+}
+
+void AsideSyncEncryptionController::SetDiagnostic(const std::string& message) {
+  diagnostic_message_ = message;
+  if (PrefService* prefs = profile_ ? profile_->GetPrefs() : nullptr) {
+    prefs->SetString(kDiagnosticPref, message);
+  }
+  VLOG(1) << message;
+}
+
+void AsideSyncEncryptionController::OnStateChanged(syncer::SyncService* sync) {
+  if (state_ == State::kDone) {
+    return;
+  }
+  if (!sync->IsEngineInitialized()) {
+    state_ = State::kWaitingForEncryptionState;
+    SetDiagnostic(kWaitingForEncryptionState);
+    return;
+  }
+  syncer::SyncUserSettings* settings = sync->GetUserSettings();
+  if (!settings) {
+    state_ = State::kWaitingForEncryptionState;
+    SetDiagnostic(kWaitingForEncryptionState);
+    return;
+  }
+  if (settings->IsPassphraseRequired()) {
+    if (state_ == State::kApplyingKey) {
+      // Chromium has the key but has not finished applying it.
+      SetDiagnostic(kWaitingForCachedKey);
+      return;
+    }
+    FetchPassphrase();
+    return;
+  }
+  if (state_ == State::kApplyingKey || state_ == State::kRequestingKey) {
+    state_ = State::kWaitingForEnableToFinish;
+    SetDiagnostic(kWaitingForEnable);
+    return;
+  }
+  if (state_ == State::kWaitingForEnableToFinish) {
+    state_ = State::kDone;
+    SetDiagnostic(std::string());
+    return;
+  }
+  if (!settings->IsUsingExplicitPassphrase()) {
+    // Encryption has not been switched on for this account yet.
+    SetDiagnostic(kWaitingForStart);
+  }
+}
+
+void AsideSyncEncryptionController::OnSyncShutdown(syncer::SyncService* sync) {
+  sync_observation_.Reset();
+}
+
+void AsideSyncEncryptionController::FetchPassphrase() {
+  if (request_in_flight_) {
+    return;
+  }
+  if (AccountId() < 0) {
+    SetDiagnostic(kLocalSecurityUnavailable);
+    return;
+  }
+  request_in_flight_ = true;
+  state_ = State::kRequestingKey;
+  SetDiagnostic(kRequestingKey);
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess();
+  AsideDaemonAuthorizer::GetInstance()->GetAuthorization(
+      factory,
+      base::BindOnce(
+          &AsideSyncEncryptionController::FetchPassphraseWithAuthorization,
+          weak_factory_.GetWeakPtr()));
+}
+
+void AsideSyncEncryptionController::FetchPassphraseWithAuthorization(
+    std::optional<std::string> authorization) {
+  if (!authorization) {
+    request_in_flight_ = false;
+    state_ = State::kFailed;
+    SetDiagnostic(kFailedToAuthorize);
+    return;
+  }
+  const std::string url = base::StringPrintf(
+      kPassphrasePathFormat, AsideDaemonAuthorizer::DaemonBaseUrl().c_str(),
+      AccountId());
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(url);
+  request->method = "GET";
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                             *authorization);
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&AsideSyncEncryptionController::OnPassphraseFetched,
+                     weak_factory_.GetWeakPtr(), std::move(loader)),
+      kMaxBody);
+}
+
+void AsideSyncEncryptionController::OnPassphraseFetched(
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    std::optional<std::string> body) {
+  request_in_flight_ = false;
+  const int response_code =
+      loader->ResponseInfo() && loader->ResponseInfo()->headers
+          ? loader->ResponseInfo()->headers->response_code()
+          : 0;
+  if (!body) {
+    state_ = State::kFailed;
+    SetDiagnostic(kCannotReachDaemon);
+    return;
+  }
+  if (response_code == 401) {
+    state_ = State::kFailed;
+    SetDiagnostic(kLocalSecurityUnavailable);
+    return;
+  }
+  if (response_code != 200) {
+    state_ = State::kFailed;
+    SetDiagnostic(kNoKeyReturned);
+    return;
+  }
+  std::optional<base::Value> json =
+      base::JSONReader::Read(*body, base::JSON_PARSE_RFC);
+  if (!json || !json->is_dict()) {
+    state_ = State::kFailed;
+    SetDiagnostic(kMalformedData);
+    return;
+  }
+  const std::string* passphrase = json->GetDict().FindString(kPassphraseKey);
+  if (!passphrase || passphrase->empty()) {
+    state_ = State::kFailed;
+    SetDiagnostic(kMalformedData);
+    return;
+  }
+  ApplyPassphrase(*passphrase);
+}
+
+void AsideSyncEncryptionController::ApplyPassphrase(
+    const std::string& passphrase) {
+  syncer::SyncService* sync = SyncServiceFactory::GetForProfile(profile_);
+  syncer::SyncUserSettings* settings =
+      sync ? sync->GetUserSettings() : nullptr;
+  if (!settings) {
+    state_ = State::kFailed;
+    SetDiagnostic(kCannotReachDaemon);
+    return;
+  }
+  if (settings->IsPassphraseRequired()) {
+    state_ = State::kApplyingKey;
+    SetDiagnostic(kWaitingForCachedKey);
+    if (!settings->SetDecryptionPassphrase(passphrase)) {
+      state_ = State::kFailed;
+      SetDiagnostic(kKeyRejected);
+    }
+    return;
+  }
+  if (!settings->IsUsingExplicitPassphrase() &&
+      settings->IsCustomPassphraseAllowed()) {
+    state_ = State::kWaitingForEnableToFinish;
+    SetDiagnostic(kEnabling);
+    settings->SetEncryptionPassphrase(passphrase);
+    return;
+  }
+  state_ = State::kDone;
+  SetDiagnostic(std::string());
+}
