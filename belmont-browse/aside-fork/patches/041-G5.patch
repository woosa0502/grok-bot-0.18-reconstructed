+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/sync/aside_website_storage_kinds.h"
+
+namespace aside {
+
+std::string_view WebsiteStorageKindToken(WebsiteStorageKind kind) {
+  switch (kind) {
+    case WebsiteStorageKind::kLocal:
+      return "local";
+    case WebsiteStorageKind::kSession:
+      return "session";
+    case WebsiteStorageKind::kExtensionLocal:
+      return "extension-local";
+    case WebsiteStorageKind::kExtensionSession:
+      return "extension-session";
+  }
+}
+
+std::string_view WebsiteStorageClientTagPrefix(WebsiteStorageKind kind) {
+  switch (kind) {
+    case WebsiteStorageKind::kLocal:
+      return "local:";
+    case WebsiteStorageKind::kSession:
+      return "session:";
+    case WebsiteStorageKind::kExtensionLocal:
+      return "extension-local:";
+    case WebsiteStorageKind::kExtensionSession:
+      return "extension-session:";
+  }
+}
+
+std::optional<WebsiteStorageKind> WebsiteStorageKindFromToken(
+    std::string_view token) {
+  if (token == "local") {
+    return WebsiteStorageKind::kLocal;
+  }
+  if (token == "session") {
+    return WebsiteStorageKind::kSession;
+  }
+  if (token == "extension-local") {
+    return WebsiteStorageKind::kExtensionLocal;
+  }
+  if (token == "extension-session") {
+    return WebsiteStorageKind::kExtensionSession;
+  }
+  return std::nullopt;
+}
+
+bool WebsiteStorageKindIsSessionScoped(WebsiteStorageKind kind) {
+  return kind == WebsiteStorageKind::kSession ||
+         kind == WebsiteStorageKind::kExtensionSession;
+}
+
+}  // namespace aside
