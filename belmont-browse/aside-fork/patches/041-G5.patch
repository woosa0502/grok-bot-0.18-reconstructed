@@ -0,0 +1,297 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/sync/aside_sync_auth_manager.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/signin/aside_daemon_authorizer.h"
+#include "chrome/browser/sync/sync_service_factory.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/storage_partition.h"
+#include "google_apis/gaia/google_service_auth_error.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The pref the Aside settings page reads (registered in browser_prefs.cc).
+constexpr char kDiagnosticPref[] = "aside.sync_auth_diagnostic_message";
+constexpr char kAccountIdPref[] = "aside.account_id";
+
+// Original diagnostic strings, 0xe4bba12 - 0xe4bbd6d.
+constexpr char kSyncServerAuthError[] =
+    "Sync server auth error. Refreshing access token...";
+constexpr char kSyncServerUnavailable[] =
+    "Sync server unavailable or request rejected.";
+constexpr char kSessionRejected[] =
+    "Daemon auth: local Aside session was rejected. Sign in again.";
+constexpr char kWaitingForSession[] =
+    "Chromium is waiting for an Aside session.";
+constexpr char kWaitingForLocalAccountSecurity[] =
+    "Chromium is waiting for local account security.";
+constexpr char kProfileBindingIncomplete[] =
+    "Chromium Aside profile binding is incomplete.";
+constexpr char kRequestingAccessToken[] =
+    "Daemon auth: requesting sync access token...";
+constexpr char kWaitingForAccessToken[] =
+    "Daemon auth: waiting for sync access token...";
+constexpr char kRequestingDaemonAuthorization[] =
+    "Daemon auth: requesting daemon authorization...";
+constexpr char kFailedToAuthorize[] =
+    "Daemon auth: failed to authorize local daemon request.";
+constexpr char kDaemonAuthorizationFailed[] =
+    "Aside daemon authorization failed.";
+constexpr char kCannotReachDaemon[] =
+    "Daemon auth: can't reach the local Aside daemon.";
+constexpr char kNoAccessTokenReturned[] =
+    "Daemon auth: failed to return a sync access token.";
+constexpr char kAccessTokenRequestFailed[] =
+    "Aside daemon access token request failed.";
+constexpr char kMalformedTokenData[] =
+    "Daemon auth: returned malformed sync access token data.";
+constexpr char kMalformedTokenResponse[] =
+    "Malformed Aside daemon access token response.";
+
+// Original request format strings, 0xe4bbd9b / 0xe4bbdbf.
+constexpr char kAccessTokenPathFormat[] = "%s/auth/access-token?accountId=%d%s";
+constexpr char kForceRefreshSuffix[] = "&forceRefresh=1";
+
+constexpr char kAccessTokenKey[] = "accessToken";
+constexpr char kExpiresAtKey[] = "expiresAt";
+
+constexpr base::TimeDelta kExpiryMargin = base::Seconds(60);
+constexpr base::TimeDelta kRetryDelay = base::Seconds(30);
+constexpr size_t kMaxBody = 256 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aside_sync_auth_manager", R"(
+        semantics {
+          sender: "Aside sync auth manager"
+          description: "Asks the local Aside daemon for the access token the "
+                       "sync engine uses against the Aside sync server."
+          trigger: "Sync engine start-up or an auth error from the server."
+          data: "Aside account id."
+          destination: LOCAL
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not user controllable."
+          policy_exception_justification: "Loopback only."
+        })");
+
+}  // namespace
+
+AsideSyncAuthManager::AsideSyncAuthManager(Profile* profile)
+    : profile_(profile) {
+  if (syncer::SyncService* sync =
+          SyncServiceFactory::GetForProfile(profile_)) {
+    sync_observation_.Observe(sync);
+  }
+}
+
+AsideSyncAuthManager::~AsideSyncAuthManager() = default;
+
+void AsideSyncAuthManager::Shutdown() {
+  sync_observation_.Reset();
+  retry_timer_.Stop();
+}
+
+int AsideSyncAuthManager::AccountId() const {
+  PrefService* prefs = profile_ ? profile_->GetPrefs() : nullptr;
+  if (!prefs || !prefs->FindPreference(kAccountIdPref)) {
+    return -1;
+  }
+  return prefs->GetInteger(kAccountIdPref);
+}
+
+void AsideSyncAuthManager::SetDiagnostic(const std::string& message) {
+  diagnostic_message_ = message;
+  if (PrefService* prefs = profile_ ? profile_->GetPrefs() : nullptr) {
+    prefs->SetString(kDiagnosticPref, message);
+  }
+  VLOG(1) << message;
+}
+
+void AsideSyncAuthManager::RequestAccessToken(bool force_refresh,
+                                              AccessTokenCallback callback) {
+  if (!force_refresh && !cached_access_token_.empty() &&
+      base::Time::Now() + kExpiryMargin < cached_expires_at_) {
+    std::move(callback).Run(cached_access_token_, cached_expires_at_);
+    return;
+  }
+  const int account_id = AccountId();
+  if (account_id < 0) {
+    // The profile has no bound Aside account yet.
+    SetDiagnostic(profile_->GetPrefs()->GetString("aside.account_user_id")
+                          .empty()
+                      ? kWaitingForSession
+                      : kProfileBindingIncomplete);
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  if (request_in_flight_) {
+    SetDiagnostic(kWaitingForAccessToken);
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  request_in_flight_ = true;
+  SetDiagnostic(kRequestingDaemonAuthorization);
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess();
+  AsideDaemonAuthorizer::GetInstance()->GetAuthorization(
+      factory,
+      base::BindOnce(
+          &AsideSyncAuthManager::RequestAccessTokenWithAuthorization,
+          weak_factory_.GetWeakPtr(), force_refresh, std::move(callback)));
+}
+
+void AsideSyncAuthManager::RequestAccessTokenWithAuthorization(
+    bool force_refresh,
+    AccessTokenCallback callback,
+    std::optional<std::string> authorization) {
+  if (!authorization) {
+    request_in_flight_ = false;
+    SetDiagnostic(kFailedToAuthorize);
+    LOG(WARNING) << kDaemonAuthorizationFailed;
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  SetDiagnostic(kRequestingAccessToken);
+
+  const std::string url = base::StringPrintf(
+      kAccessTokenPathFormat, AsideDaemonAuthorizer::DaemonBaseUrl().c_str(),
+      AccountId(), force_refresh ? kForceRefreshSuffix : "");
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(url);
+  request->method = "GET";
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                             *authorization);
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&AsideSyncAuthManager::OnAccessTokenFetched,
+                     weak_factory_.GetWeakPtr(), std::move(callback),
+                     std::move(loader)),
+      kMaxBody);
+}
+
+void AsideSyncAuthManager::OnAccessTokenFetched(
+    AccessTokenCallback callback,
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    std::optional<std::string> body) {
+  request_in_flight_ = false;
+  const int response_code =
+      loader->ResponseInfo() && loader->ResponseInfo()->headers
+          ? loader->ResponseInfo()->headers->response_code()
+          : 0;
+  if (!body) {
+    SetDiagnostic(kCannotReachDaemon);
+    LOG(WARNING) << kAccessTokenRequestFailed;
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  if (response_code == 401) {
+    // The daemon answers 401 once the local Aside session is revoked.
+    SetDiagnostic(kSessionRejected);
+    cached_access_token_.clear();
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  if (response_code != 200) {
+    SetDiagnostic(kNoAccessTokenReturned);
+    LOG(WARNING) << kAccessTokenRequestFailed;
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  std::optional<base::Value> json =
+      base::JSONReader::Read(*body, base::JSON_PARSE_RFC);
+  if (!json || !json->is_dict()) {
+    SetDiagnostic(kMalformedTokenData);
+    LOG(WARNING) << kMalformedTokenResponse;
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  const std::string* token = json->GetDict().FindString(kAccessTokenKey);
+  if (!token || token->empty()) {
+    SetDiagnostic(kMalformedTokenData);
+    LOG(WARNING) << kMalformedTokenResponse;
+    std::move(callback).Run(std::nullopt, base::Time());
+    return;
+  }
+  base::Time expires_at;
+  if (const std::string* expires =
+          json->GetDict().FindString(kExpiresAtKey)) {
+    if (!base::Time::FromString(expires->c_str(), &expires_at)) {
+      expires_at = base::Time();
+    }
+  } else if (std::optional<double> seconds =
+                 json->GetDict().FindDouble(kExpiresAtKey)) {
+    expires_at = base::Time::UnixEpoch() + base::Seconds(*seconds);
+  }
+  cached_access_token_ = *token;
+  cached_expires_at_ = expires_at;
+  SetDiagnostic(std::string());
+  std::move(callback).Run(cached_access_token_, cached_expires_at_);
+}
+
+void AsideSyncAuthManager::ScheduleAccessTokenRequest(bool force_refresh) {
+  if (retry_timer_.IsRunning()) {
+    return;
+  }
+  retry_timer_.Start(
+      FROM_HERE, kRetryDelay,
+      base::BindOnce(
+          [](base::WeakPtr<AsideSyncAuthManager> self, bool force) {
+            if (self) {
+              self->RequestAccessToken(force, base::DoNothing());
+            }
+          },
+          weak_factory_.GetWeakPtr(), force_refresh));
+}
+
+void AsideSyncAuthManager::OnStateChanged(syncer::SyncService* sync) {
+  const GoogleServiceAuthError error = sync->GetAuthError();
+  if (error.state() ==
+      GoogleServiceAuthError::State::INVALID_GAIA_CREDENTIALS) {
+    SetDiagnostic(kSyncServerAuthError);
+    cached_access_token_.clear();
+    ScheduleAccessTokenRequest(/*force_refresh=*/true);
+    return;
+  }
+  if (error.state() != GoogleServiceAuthError::State::NONE) {
+    SetDiagnostic(kSyncServerUnavailable);
+    return;
+  }
+  if (sync->GetTransportState() ==
+      syncer::SyncService::TransportState::PAUSED) {
+    SetDiagnostic(kWaitingForLocalAccountSecurity);
+  }
+}
+
+void AsideSyncAuthManager::OnSyncShutdown(syncer::SyncService* sync) {
+  sync_observation_.Reset();
+}
