+class ComponentUpdateService;
+
+// Drives the bundled Aside components: it runs its own component update
+// service against the Aside Omaha endpoint, keeps the Aside Daemon running,
+// and restarts the daemon when a new build is installed.
+// RE: chrome/browser/component_updater/aside_component_update_service.cc
+// (Aside Framework 1.0.825.1, region 0x0491e180).
+class AsideComponentUpdateService {
+ public:
+  static AsideComponentUpdateService* GetInstance();
+
+  AsideComponentUpdateService(const AsideComponentUpdateService&) = delete;
+  AsideComponentUpdateService& operator=(const AsideComponentUpdateService&) =
+      delete;
+
+  // True unless --disable-bundled-aside-component was passed.
+  static bool IsEnabled();
+
+  // The Omaha update endpoint. Defaults to the original's endpoint and can be
+  // pointed at a replay server with --aside-component-update-url.
+  static std::string UpdateUrl();
+
+  // Creates the Aside component update service and registers the bundled
+  // components. Safe to call more than once.
+  void Start();
+
+  // Stops the scheduler; called on browser shutdown.
+  void Shutdown();
+
+  // Runs one update check now. `callback` gets the on-demand result of the
+  // daemon component (or false when the service is not running).
+  void CheckNow(base::OnceCallback<void(bool)> callback);
+
+  // Install directory of `kind`, or an empty path when it is not installed.
+  base::FilePath InstallDirFor(AsideComponentKind kind) const;
+  base::Version VersionFor(AsideComponentKind kind) const;
+
+  ComponentUpdateService* component_update_service() { return cus_.get(); }
+
+ private:
+  friend class base::NoDestructor<AsideComponentUpdateService>;
+
+  struct Installed {
+    base::Version version;
+    base::FilePath install_dir;
+  };
+
+  AsideComponentUpdateService();
+  ~AsideComponentUpdateService();
+
+  void OnComponentReady(AsideComponentKind kind,
+                        const base::Version& version,
+                        const base::FilePath& install_dir);
+
+  // Health gate in front of every scheduled update task.
+  void RunHealthGate(base::OnceCallback<void(bool)> allowed);
+  void OnHealthGateResult(base::OnceCallback<void(bool)> allowed,
+                          std::unique_ptr<network::SimpleURLLoader> loader,
+                          std::optional<std::string> body);
+
+  // Daemon lifecycle.
+  void RestartDaemonForComponentUpdate(const base::Version& version,
+                                       const base::FilePath& install_dir);
+  void OnDaemonShutdownRequested(const base::Version& version,
+                                 const base::FilePath& install_dir,
+                                 std::optional<std::string> response);
+  void ForceKillAndLaunch(const base::Version& version,
+                          const base::FilePath& install_dir);
+  void LaunchPendingDaemon(const base::Version& version,
+                           const base::FilePath& install_dir);
+  void ScheduleDaemonActivationVerification(const base::Version& version,
+                                            const base::FilePath& install_dir);
+  void VerifyDaemonActivation(const base::Version& version,
+                              const base::FilePath& install_dir,
+                              int attempts_left);
+  void OnActivationHealthResult(const base::Version& version,
+                                const base::FilePath& install_dir,
+                                int attempts_left,
+                                std::unique_ptr<network::SimpleURLLoader> loader,
+                                std::optional<std::string> body);
+
+  scoped_refptr<network::SharedURLLoaderFactory> LoaderFactory() const;
+
+  std::unique_ptr<ComponentUpdateService> cus_;
+  std::map<AsideComponentKind, Installed> installed_;
+  int consecutive_health_failures_ = 0;
+  bool started_ = false;
+  base::OneShotTimer activation_timer_;
+  base::WeakPtrFactory<AsideComponentUpdateService> weak_factory_{this};
+};
+
