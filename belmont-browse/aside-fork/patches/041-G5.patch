+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/sync/service/sync_service.h"
+#include "components/sync/service/sync_service_observer.h"
+
+class Profile;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+// Feeds the sync engine with access tokens minted by the local Aside daemon
+// instead of by GAIA, and mirrors its own progress into the profile pref
+// "aside.sync_auth_diagnostic_message" that the Aside settings page reads.
+//
+// GET <daemon>/auth/access-token?accountId=<id>[&forceRefresh=1]
+//   -> {accountId, accessToken, expiresAt}
+// A 401 means the local Aside session was revoked.
+//
+// RE: chrome/browser/sync/aside_sync_auth_manager.cc (Aside Framework
+// 1.0.825.1, region 0x04768830).
+class AsideSyncAuthManager : public KeyedService,
+                             public syncer::SyncServiceObserver {
+ public:
+  using AccessTokenCallback =
+      base::OnceCallback<void(std::optional<std::string> access_token,
+                              base::Time expires_at)>;
+
+  explicit AsideSyncAuthManager(Profile* profile);
+  ~AsideSyncAuthManager() override;
+
+  AsideSyncAuthManager(const AsideSyncAuthManager&) = delete;
+  AsideSyncAuthManager& operator=(const AsideSyncAuthManager&) = delete;
+
+  // Asks the daemon for a sync access token. Cached until shortly before it
+  // expires unless `force_refresh` is set.
+  void RequestAccessToken(bool force_refresh, AccessTokenCallback callback);
+
+  // The last message written to aside.sync_auth_diagnostic_message.
+  std::string diagnostic_message() const { return diagnostic_message_; }
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // syncer::SyncServiceObserver:
+  void OnStateChanged(syncer::SyncService* sync) override;
+  void OnSyncShutdown(syncer::SyncService* sync) override;
+
+ private:
+  // RE: "ScheduleAccessTokenRequest".
+  void ScheduleAccessTokenRequest(bool force_refresh);
+  // RE: "RequestAccessTokenWithAuthorization".
+  void RequestAccessTokenWithAuthorization(
+      bool force_refresh,
+      AccessTokenCallback callback,
+      std::optional<std::string> authorization);
+  void OnAccessTokenFetched(AccessTokenCallback callback,
+                            std::unique_ptr<network::SimpleURLLoader> loader,
+                            std::optional<std::string> body);
+  void SetDiagnostic(const std::string& message);
+  int AccountId() const;
+
+  const raw_ptr<Profile> profile_;
+  std::string diagnostic_message_;
+  std::string cached_access_token_;
+  base::Time cached_expires_at_;
+  bool request_in_flight_ = false;
+  base::OneShotTimer retry_timer_;
+  base::ScopedObservation<syncer::SyncService, syncer::SyncServiceObserver>
+      sync_observation_{this};
+  base::WeakPtrFactory<AsideSyncAuthManager> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_SYNC_ASIDE_SYNC_AUTH_MANAGER_H_
