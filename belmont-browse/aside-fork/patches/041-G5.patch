@@ -0,0 +1,84 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SYNC_ASIDE_SYNC_ENCRYPTION_CONTROLLER_H_
+#define CHROME_BROWSER_SYNC_ASIDE_SYNC_ENCRYPTION_CONTROLLER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/sync/service/sync_service.h"
+#include "components/sync/service/sync_service_observer.h"
+
+class Profile;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+// Waits for the sync engine to reach a state where an encryption key can be
+// applied, fetches that key from the local Aside daemon
+// (GET <daemon>/auth/sync-passphrase?accountId=<id> -> {passphrase}) and hands
+// it to Chromium. Its progress goes into the profile pref
+// "aside.sync_encryption_diagnostic_message".
+//
+// RE: chrome/browser/sync/aside_sync_encryption_controller.cc (Aside Framework
+// 1.0.825.1, region 0x04768830).
+class AsideSyncEncryptionController : public KeyedService,
+                                      public syncer::SyncServiceObserver {
+ public:
+  // The state machine the original's diagnostic strings describe.
+  enum class State {
+    kWaitingForEncryptionState,
+    kWaitingForEncryptionToStart,
+    kRequestingKey,
+    kApplyingKey,
+    kWaitingForEnableToFinish,
+    kDone,
+    kFailed,
+  };
+
+  explicit AsideSyncEncryptionController(Profile* profile);
+  ~AsideSyncEncryptionController() override;
+
+  AsideSyncEncryptionController(const AsideSyncEncryptionController&) = delete;
+  AsideSyncEncryptionController& operator=(
+      const AsideSyncEncryptionController&) = delete;
+
+  State state() const { return state_; }
+  std::string diagnostic_message() const { return diagnostic_message_; }
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // syncer::SyncServiceObserver:
+  void OnStateChanged(syncer::SyncService* sync) override;
+  void OnSyncShutdown(syncer::SyncService* sync) override;
+
+ private:
+  // RE: "FetchPassphraseWithAuthorization".
+  void FetchPassphrase();
+  void FetchPassphraseWithAuthorization(
+      std::optional<std::string> authorization);
+  void OnPassphraseFetched(std::unique_ptr<network::SimpleURLLoader> loader,
+                           std::optional<std::string> body);
+  void ApplyPassphrase(const std::string& passphrase);
+  void SetDiagnostic(const std::string& message);
+  int AccountId() const;
+
+  const raw_ptr<Profile> profile_;
+  State state_ = State::kWaitingForEncryptionState;
+  std::string diagnostic_message_;
+  bool request_in_flight_ = false;
+  base::ScopedObservation<syncer::SyncService, syncer::SyncServiceObserver>
+      sync_observation_{this};
+  base::WeakPtrFactory<AsideSyncEncryptionController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_SYNC_ASIDE_SYNC_ENCRYPTION_CONTROLLER_H_
