+namespace {
+
+// RE: "https://ptqgesmtzwdmeiknncqc.supabase.co/functions/v1/omaha" (0xd9c1de0).
+constexpr char kAsideOmahaUrl[] =
+    "https://ptqgesmtzwdmeiknncqc.supabase.co/functions/v1/omaha";
+// RE: "http://127.0.0.1:21420/health" (0xd9c1e20) and
+// "http://127.0.0.1:21420/shutdown" (0xd9c1e50). Both are derived from the
+// daemon base URL so ASIDE_DAEMON_BASE_URL redirects them together.
+constexpr char kHealthPath[] = "/health";
+constexpr char kShutdownPath[] = "/shutdown";
+// RE: "aside_component_crx_cache" (0xe570ab4).
+constexpr char kAsideCrxCacheDir[] = "aside_component_crx_cache";
+// RE: the NSUserDefaults key "disableBundledAsideComponent" (0xe4a908e).
+constexpr char kDisableSwitch[] = "disable-bundled-aside-component";
+// Ours, so a replay server can stand in for the Omaha endpoint in tests.
+constexpr char kUpdateUrlSwitch[] = "aside-component-update-url";
+
+constexpr base::TimeDelta kInitialDelay = base::Seconds(30);
+constexpr base::TimeDelta kNextCheckDelay = base::Hours(5);
+constexpr base::TimeDelta kHealthTimeout = base::Seconds(2);
+// RE: "Aside component update health gate reached fallback threshold; running
+// update task anyway".
+constexpr int kHealthGateFallbackThreshold = 3;
+constexpr int kActivationVerificationAttempts = 20;
+constexpr base::TimeDelta kActivationVerificationInterval = base::Seconds(1);
+
+constexpr net::NetworkTrafficAnnotationTag kDaemonTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aside_component_daemon", R"(
+        semantics {
+          sender: "Aside component update service"
+          description: "Checks that the local Aside daemon is alive and asks "
+                       "it to shut down before a component update replaces it."
+          trigger: "Aside component update task."
+          data: "None."
+          destination: LOCAL
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not user controllable."
+          policy_exception_justification: "Loopback only."
+        })");
+
+std::string DaemonUrl(const char* path) {
+  return base::StrCat({AsideDaemonAuthorizer::DaemonBaseUrl(), path});
+}
+
+std::unique_ptr<network::SimpleURLLoader> MakeDaemonLoader(
+    const std::string& url,
+    const std::string& method,
+    const std::optional<std::string>& authorization) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(url);
+  request->method = method;
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  if (authorization) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                               *authorization);
+  }
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kDaemonTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(kHealthTimeout);
+  return loader;
+}
+
+// The Aside components use their own Omaha endpoint and their own CRX cache,
+// so they run on their own configurator rather than on Chrome's (two
+// update_client::CrxCache instances must never share a cache root).
+class AsideConfigurator : public update_client::Configurator {
+ public:
+  AsideConfigurator(const base::CommandLine* cmdline, PrefService* pref_service)
+      : configurator_impl_(ComponentUpdaterCommandLineConfigPolicy(cmdline),
+                           /*require_encryption=*/false),
+        pref_service_(pref_service),
+        persisted_data_(update_client::CreatePersistedData(
+            base::BindRepeating(
+                [](PrefService* prefs) { return prefs; },
+                pref_service),
+            nullptr)) {
+    CHECK(pref_service_);
+    base::FilePath path;
+    const bool have_path =
+        base::PathService::Get(chrome::DIR_USER_DATA, &path);
+    crx_cache_ = base::MakeRefCounted<update_client::CrxCache>(
+        have_path ? std::optional<base::FilePath>(
+                        path.AppendASCII(kAsideCrxCacheDir))
+                  : std::nullopt);
+  }
+
+  base::TimeDelta InitialDelay() const override { return kInitialDelay; }
+  base::TimeDelta NextCheckDelay() const override { return kNextCheckDelay; }
+  base::TimeDelta OnDemandDelay() const override {
+    return configurator_impl_.OnDemandDelay();
+  }
+  base::TimeDelta UpdateDelay() const override {
+    return configurator_impl_.UpdateDelay();
+  }
+  std::vector<GURL> UpdateUrl() const override {
+    return {GURL(AsideComponentUpdateService::UpdateUrl())};
+  }
+  std::vector<GURL> PingUrl() const override { return {}; }
+  std::string GetProdId() const override {
+    return update_client::UpdateQueryParams::GetProdIdString(
+        update_client::UpdateQueryParams::ProdId::CHROME);
+  }
+  base::Version GetBrowserVersion() const override {
+    return configurator_impl_.GetBrowserVersion();
+  }
+  std::string GetChannel() const override {
+    return chrome::GetChannelName(chrome::WithExtendedStable(true));
+  }
+  std::string GetLang() const override {
+    return ChromeUpdateQueryParamsDelegate::GetLang();
+  }
+  std::string GetOSLongName() const override {
+    return configurator_impl_.GetOSLongName();
+  }
+  base::flat_map<std::string, std::string> ExtraRequestParams() const override {
+    return configurator_impl_.ExtraRequestParams();
+  }
+  std::string GetDownloadPreference() const override { return std::string(); }
+  scoped_refptr<update_client::NetworkFetcherFactory> GetNetworkFetcherFactory()
+      override {
+    if (!network_fetcher_factory_) {
+      network_fetcher_factory_ =
+          base::MakeRefCounted<update_client::NetworkFetcherChromiumFactory>(
+              g_browser_process->system_network_context_manager()
+                  ->GetSharedURLLoaderFactory(),
+              base::BindRepeating([](const GURL& url) { return false; }));
+    }
+    return network_fetcher_factory_;
+  }
+  scoped_refptr<update_client::CrxDownloaderFactory> GetCrxDownloaderFactory()
+      override {
+    if (!crx_downloader_factory_) {
+      crx_downloader_factory_ = update_client::MakeCrxDownloaderFactory(
+          GetNetworkFetcherFactory(), std::nullopt);
+    }
+    return crx_downloader_factory_;
+  }
+  scoped_refptr<update_client::UnzipperFactory> GetUnzipperFactory() override {
+    if (!unzip_factory_) {
+      unzip_factory_ = base::MakeRefCounted<update_client::UnzipChromiumFactory>(
+          base::BindRepeating(&unzip::LaunchUnzipper));
+    }
+    return unzip_factory_;
+  }
+  scoped_refptr<update_client::PatcherFactory> GetPatcherFactory() override {
+    if (!patch_factory_) {
+      patch_factory_ = base::MakeRefCounted<update_client::PatchChromiumFactory>(
+          base::BindRepeating(&patch::LaunchFilePatcher));
+    }
+    return patch_factory_;
+  }
+  bool EnabledBackgroundDownloader() const override { return false; }
+  bool EnabledCupSigning() const override { return false; }
+  PrefService* GetPrefService() const override { return pref_service_; }
+  update_client::PersistedData* GetPersistedData() const override {
+    return persisted_data_.get();
+  }
+  bool IsPerUserInstall() const override {
+    return component_updater::IsPerUserInstall();
+  }
+  std::unique_ptr<update_client::ProtocolHandlerFactory>
+  GetProtocolHandlerFactory() const override {
+    return configurator_impl_.GetProtocolHandlerFactory();
+  }
+  std::optional<bool> IsMachineExternallyManaged() const override {
+    return configurator_impl_.IsMachineExternallyManaged();
+  }
+  update_client::UpdaterStateProvider GetUpdaterStateProvider() const override {
+    return configurator_impl_.GetUpdaterStateProvider();
+  }
+  scoped_refptr<update_client::CrxCache> GetCrxCache() const override {
+    return crx_cache_;
+  }
+#if BUILDFLAG(CHROME_FOR_TESTING)
+  std::vector<std::string> GetRequiredComponents() const override {
+    return {};
+  }
+#endif
+  bool IsConnectionMetered() const override {
+    return configurator_impl_.IsConnectionMetered();
+  }
+
+ private:
+  ~AsideConfigurator() override = default;
+
+  ConfiguratorImpl configurator_impl_;
+  raw_ptr<PrefService, LeakedDanglingUntriaged> pref_service_;
+  std::unique_ptr<update_client::PersistedData> persisted_data_;
+  scoped_refptr<update_client::NetworkFetcherFactory> network_fetcher_factory_;
+  scoped_refptr<update_client::CrxDownloaderFactory> crx_downloader_factory_;
+  scoped_refptr<update_client::UnzipperFactory> unzip_factory_;
+  scoped_refptr<update_client::PatcherFactory> patch_factory_;
+  scoped_refptr<update_client::CrxCache> crx_cache_;
+};
+
+// RE: "Aside component update scheduler started; initial_delay_ms=",
+// ", delay_ms=", "ScheduleNext", "Aside component update task started",
+// "Aside component update task finished",
+// "Aside component update scheduler stopped".
+class AsideUpdateScheduler : public UpdateScheduler {
+ public:
+  // Runs before each scheduled pass; the callback says whether the pass may
+  // proceed. RE: the health gate in front of "Aside component update task
+  // started".
+  using HealthGate =
+      base::RepeatingCallback<void(base::OnceCallback<void(bool)>)>;
+
+  explicit AsideUpdateScheduler(HealthGate gate) : gate_(std::move(gate)) {}
+  ~AsideUpdateScheduler() override = default;
+
+  void Schedule(base::TimeDelta initial_delay,
+                base::TimeDelta delay,
+                const UserTask& user_task,
+                const OnStopTaskCallback& on_stop) override {
+    user_task_ = user_task;
+    delay_ = delay;
+    VLOG(1) << "Aside component update scheduler started; initial_delay_ms="
+            << initial_delay.InMilliseconds()
+            << ", delay_ms=" << delay.InMilliseconds();
+    timer_.Start(FROM_HERE, initial_delay,
+                 base::BindOnce(&AsideUpdateScheduler::RunTask,
+                                weak_factory_.GetWeakPtr()));
+  }
+
+  void Stop() override {
+    timer_.Stop();
+    user_task_.Reset();
+    VLOG(1) << "Aside component update scheduler stopped";
+  }
+
+ private:
+  void RunTask() {
+    if (!user_task_) {
+      return;
+    }
+    if (!gate_) {
+      StartTask(true);
+      return;
+    }
+    gate_.Run(base::BindOnce(&AsideUpdateScheduler::StartTask,
+                             weak_factory_.GetWeakPtr()));
+  }
+
+  void StartTask(bool allowed) {
+    if (!user_task_) {
+      return;
+    }
+    if (!allowed) {
+      ScheduleNext();
+      return;
+    }
+    VLOG(1) << "Aside component update task started";
+    user_task_.Run(base::BindOnce(&AsideUpdateScheduler::ScheduleNext,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  // RE: "ScheduleNext" (0xe570b16).
+  void ScheduleNext() {
+    VLOG(1) << "Aside component update task finished";
+    if (delay_.is_zero() || !user_task_) {
+      return;
+    }
+    timer_.Start(FROM_HERE, delay_,
+                 base::BindOnce(&AsideUpdateScheduler::RunTask,
+                                weak_factory_.GetWeakPtr()));
+  }
+
+  HealthGate gate_;
+  UserTask user_task_;
+  base::TimeDelta delay_;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<AsideUpdateScheduler> weak_factory_{this};
+};
+
+}  // namespace
