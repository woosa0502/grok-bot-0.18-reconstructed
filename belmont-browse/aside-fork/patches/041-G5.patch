+// static
+AsideComponentUpdateService* AsideComponentUpdateService::GetInstance() {
+  static base::NoDestructor<AsideComponentUpdateService> instance;
+  return instance.get();
+}
+
+// static
+bool AsideComponentUpdateService::IsEnabled() {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(kDisableSwitch);
+}
+
+// static
+std::string AsideComponentUpdateService::UpdateUrl() {
+  const std::string override =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kUpdateUrlSwitch);
+  return override.empty() ? std::string(kAsideOmahaUrl) : override;
+}
+
+AsideComponentUpdateService::AsideComponentUpdateService() = default;
+AsideComponentUpdateService::~AsideComponentUpdateService() = default;
+
+void AsideComponentUpdateService::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (started_ || !IsEnabled()) {
+    return;
+  }
+  if (!g_browser_process || !g_browser_process->local_state()) {
+    return;
+  }
+  started_ = true;
+
+  auto scheduler = std::make_unique<AsideUpdateScheduler>(
+      base::BindRepeating(&AsideComponentUpdateService::RunHealthGate,
+                          weak_factory_.GetWeakPtr()));
+  cus_ = ComponentUpdateServiceFactory(
+      base::MakeRefCounted<AsideConfigurator>(
+          base::CommandLine::ForCurrentProcess(),
+          g_browser_process->local_state()),
+      std::move(scheduler), /*brand=*/std::string());
+
+  RegisterAsideComponents(
+      cus_.get(),
+      base::BindRepeating(&AsideComponentUpdateService::OnComponentReady,
+                          weak_factory_.GetWeakPtr()));
+}
+
+void AsideComponentUpdateService::Shutdown() {
+  activation_timer_.Stop();
+  cus_.reset();
+  started_ = false;
+}
+
+void AsideComponentUpdateService::CheckNow(
+    base::OnceCallback<void(bool)> callback) {
+  if (!cus_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const std::string app_id =
+      AsideComponentAppId(AsideComponentKind::kDaemon);
+  if (app_id.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  cus_->GetOnDemandUpdater().OnDemandUpdate(
+      app_id, OnDemandUpdater::Priority::FOREGROUND,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> cb, update_client::Error error) {
+            std::move(cb).Run(error == update_client::Error::NONE);
+          },
+          std::move(callback)));
+}
+
+base::FilePath AsideComponentUpdateService::InstallDirFor(
+    AsideComponentKind kind) const {
+  auto it = installed_.find(kind);
+  return it == installed_.end() ? base::FilePath() : it->second.install_dir;
+}
+
+base::Version AsideComponentUpdateService::VersionFor(
+    AsideComponentKind kind) const {
+  auto it = installed_.find(kind);
+  return it == installed_.end() ? base::Version() : it->second.version;
+}
+
+scoped_refptr<network::SharedURLLoaderFactory>
+AsideComponentUpdateService::LoaderFactory() const {
+  return g_browser_process ? g_browser_process->shared_url_loader_factory()
+                           : nullptr;
+}
+
+void AsideComponentUpdateService::OnComponentReady(
+    AsideComponentKind kind,
+    const base::Version& version,
+    const base::FilePath& install_dir) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  Installed& slot = installed_[kind];
+  const bool changed = slot.version != version;
+  slot.version = version;
+  slot.install_dir = install_dir;
+  if (kind == AsideComponentKind::kAgentManager) {
+    // RE: "Loaded Aside component extension id ".
+    VLOG(1) << "Loaded Aside component extension id "
+            << AsideComponentAppId(kind);
+    return;
+  }
+  if (kind == AsideComponentKind::kDaemon && changed) {
+    RestartDaemonForComponentUpdate(version, install_dir);
+  }
+}
+
+void AsideComponentUpdateService::RunHealthGate(
+    base::OnceCallback<void(bool)> allowed) {
+  scoped_refptr<network::SharedURLLoaderFactory> factory = LoaderFactory();
+  if (!factory) {
+    // RE: "Aside component update health gate skipped because URL loader
+    // factory is unavailable; running update task".
+    VLOG(1) << "Aside component update health gate skipped because URL loader "
+               "factory is unavailable; running update task";
+    std::move(allowed).Run(true);
+    return;
+  }
+  // RE: "CreateAsideDaemonHealthLoader".
+  auto loader = MakeDaemonLoader(DaemonUrl(kHealthPath), "GET", std::nullopt);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      factory.get(),
+      base::BindOnce(&AsideComponentUpdateService::OnHealthGateResult,
+                     weak_factory_.GetWeakPtr(), std::move(allowed),
+                     std::move(loader)),
+      /*max_body_size=*/64 * 1024);
+}
+
+void AsideComponentUpdateService::OnHealthGateResult(
+    base::OnceCallback<void(bool)> allowed,
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    std::optional<std::string> body) {
+  const int net_error = loader->NetError();
+  // RE: "Aside component update health gate result: net_error=",
+  // ", has_body=".
+  VLOG(1) << "Aside component update health gate result: net_error="
+          << net_error << ", has_body=" << body.has_value();
+  if (net_error == 0 && body) {
+    consecutive_health_failures_ = 0;
+    std::move(allowed).Run(true);
+    return;
+  }
+  if (++consecutive_health_failures_ >= kHealthGateFallbackThreshold) {
+    // RE: "Aside component update health gate reached fallback threshold;
+    // running update task anyway".
+    VLOG(1) << "Aside component update health gate reached fallback threshold; "
+               "running update task anyway";
+    consecutive_health_failures_ = 0;
+    std::move(allowed).Run(true);
+    return;
+  }
+  std::move(allowed).Run(false);
+}
+
+void AsideComponentUpdateService::RestartDaemonForComponentUpdate(
+    const base::Version& version,
+    const base::FilePath& install_dir) {
+  // RE: "Restarting Aside Daemon for component update; launch_dir=".
+  VLOG(1) << "Restarting Aside Daemon for component update; launch_dir="
+          << install_dir.value();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          &AppendAsideComponentUpdateLog,
+          base::StrCat(
+              {"Restarting Aside Daemon for component update; launch_dir=",
+               install_dir.value()})));
+  scoped_refptr<network::SharedURLLoaderFactory> factory = LoaderFactory();
+  if (!factory) {
+    ForceKillAndLaunch(version, install_dir);
+    return;
+  }
+  // RE: "Sending Aside Daemon graceful shutdown request for component
+  // restart" / "CreateAsideDaemonShutdownLoader".
+  VLOG(1) << "Sending Aside Daemon graceful shutdown request for component "
+             "restart";
+  AsideDaemonAuthorizer::GetInstance()->PostJsonWithAuthorization(
+      factory, kShutdownPath, "{}",
+      base::BindOnce(&AsideComponentUpdateService::OnDaemonShutdownRequested,
+                     weak_factory_.GetWeakPtr(), version, install_dir));
+}
+
+void AsideComponentUpdateService::OnDaemonShutdownRequested(
+    const base::Version& version,
+    const base::FilePath& install_dir,
+    std::optional<std::string> response) {
+  if (!response) {
+    // RE: "Failed to authorize Aside Daemon shutdown request during restart;
+    // falling back to force-kill".
+    LOG(WARNING) << "Failed to authorize Aside Daemon shutdown request during "
+                    "restart; falling back to force-kill";
+  } else {
+    // RE: "Aside Daemon graceful shutdown request succeeded during restart".
+    VLOG(1) << "Aside Daemon graceful shutdown request succeeded during "
+               "restart";
+  }
+  ForceKillAndLaunch(version, install_dir);
+}
+
+void AsideComponentUpdateService::ForceKillAndLaunch(
+    const base::Version& version,
+    const base::FilePath& install_dir) {
+  // RE: "QueueForceKillAsideDaemonProcessesForInstallDir" /
+  // "ScheduleLaunchPendingDaemonAfterForceKill".
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath dir) {
+            int matched = 0;
+            const int killed = ForceKillAsideDaemonProcesses(
+                AsideDaemonExecutableCandidates(dir), &matched);
+            AppendAsideComponentUpdateLog(base::StrCat(
+                {"Aside Daemon force-kill for ", dir.value(), " matched ",
+                 base::NumberToString(matched), " process(es), killed ",
+                 base::NumberToString(killed)}));
+            return killed;
+          },
+          install_dir),
+      base::BindOnce(
+          [](base::WeakPtr<AsideComponentUpdateService> self,
+             base::Version version, base::FilePath dir, int killed) {
+            if (!self) {
+              return;
+            }
+            VLOG(1) << "Aside Daemon force-kill for " << dir.value()
+                    << " killed " << killed;
+            self->LaunchPendingDaemon(version, dir);
+          },
+          weak_factory_.GetWeakPtr(), version, install_dir));
+}
+
+void AsideComponentUpdateService::LaunchPendingDaemon(
+    const base::Version& version,
+    const base::FilePath& install_dir) {
+  // RE: "Launching pending Aside Daemon version ".
+  VLOG(1) << "Launching pending Aside Daemon version " << version.GetString();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath dir) {
+            for (const base::FilePath& exe :
+                 AsideDaemonExecutableCandidates(dir)) {
+              if (!base::PathExists(exe)) {
+                continue;
+              }
+              std::string error;
+              if (!RepairAsideDaemonExecutablePermissions(exe, &error)) {
+                // RE: "Aside Daemon launch failed because permissions could
+                // not be repaired: ".
+                LOG(WARNING) << "Aside Daemon launch failed because "
+                                "permissions could not be repaired: "
+                             << exe.value();
+                return false;
+              }
+              base::LaunchOptions options;
+              options.current_directory = dir;
+              base::Process process =
+                  base::LaunchProcess(base::CommandLine(exe), options);
+              if (!process.IsValid()) {
+                // RE: "Failed to launch Aside Daemon from ".
+                LOG(WARNING) << "Failed to launch Aside Daemon from "
+                             << dir.value();
+                return false;
+              }
+              // RE: "Aside Daemon launch succeeded from ".
+              VLOG(1) << "Aside Daemon launch succeeded from " << dir.value();
+              return true;
+            }
+            // RE: "Aside Daemon launch failed because executable is missing: ".
+            LOG(WARNING) << "Aside Daemon launch failed because executable is "
+                            "missing: "
+                         << dir.value();
+            return false;
+          },
+          install_dir),
+      base::BindOnce(
+          [](base::WeakPtr<AsideComponentUpdateService> self,
+             base::Version version, base::FilePath dir, bool launched) {
+            if (!self || !launched) {
+              return;
+            }
+            self->ScheduleDaemonActivationVerification(version, dir);
+          },
+          weak_factory_.GetWeakPtr(), version, install_dir));
+}
+
+void AsideComponentUpdateService::ScheduleDaemonActivationVerification(
+    const base::Version& version,
+    const base::FilePath& install_dir) {
+  if (!version.IsValid() || install_dir.empty()) {
+    // RE: "Skipped Aside Daemon activation verification because the expected
+    // version or install dir is invalid".
+    LOG(WARNING) << "Skipped Aside Daemon activation verification because the "
+                    "expected version or install dir is invalid";
+    return;
+  }
+  // RE: "Started Aside Daemon activation verification; expected_version=".
+  VLOG(1) << "Started Aside Daemon activation verification; expected_version="
+          << version.GetString();
+  VerifyDaemonActivation(version, install_dir,
+                         kActivationVerificationAttempts);
+}
+
+void AsideComponentUpdateService::VerifyDaemonActivation(
+    const base::Version& version,
+    const base::FilePath& install_dir,
+    int attempts_left) {
+  if (attempts_left <= 0) {
+    // RE: "Aside Daemon activation verification timed out; expected_version=".
+    LOG(WARNING) << "Aside Daemon activation verification timed out; "
+                    "expected_version="
+                 << version.GetString();
+    return;
+  }
+  scoped_refptr<network::SharedURLLoaderFactory> factory = LoaderFactory();
+  if (!factory) {
+    return;
+  }
+  auto loader = MakeDaemonLoader(DaemonUrl(kHealthPath), "GET", std::nullopt);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      factory.get(),
+      base::BindOnce(&AsideComponentUpdateService::OnActivationHealthResult,
+                     weak_factory_.GetWeakPtr(), version, install_dir,
+                     attempts_left, std::move(loader)),
+      /*max_body_size=*/64 * 1024);
+}
+
+void AsideComponentUpdateService::OnActivationHealthResult(
+    const base::Version& version,
+    const base::FilePath& install_dir,
+    int attempts_left,
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    std::optional<std::string> body) {
+  if (body) {
+    std::optional<base::Value> json =
+        base::JSONReader::Read(*body, base::JSON_PARSE_RFC);
+    if (json && json->is_dict()) {
+      const std::string* reported = json->GetDict().FindString("version");
+      if (reported && base::Version(*reported) == version) {
+        // RE: "Verified active Aside Daemon version ".
+        VLOG(1) << "Verified active Aside Daemon version "
+                << version.GetString();
+        base::ThreadPool::PostTask(
+            FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+            base::BindOnce(&AppendAsideComponentUpdateLog,
+                           base::StrCat({"Verified active Aside Daemon version ",
+                                         version.GetString()})));
+        return;
+      }
+    }
+  }
+  activation_timer_.Start(
+      FROM_HERE, kActivationVerificationInterval,
+      base::BindOnce(&AsideComponentUpdateService::VerifyDaemonActivation,
+                     weak_factory_.GetWeakPtr(), version, install_dir,
+                     attempts_left - 1));
+}
+
+}  // namespace component_updater
