+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SYNC_ASIDE_WEBSITE_STORAGE_KINDS_H_
+#define CHROME_BROWSER_SYNC_ASIDE_WEBSITE_STORAGE_KINDS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+// The four kinds of website storage area that sync_pb::AsideWebsiteStorage-
+// Specifics::storage_kind can name, and the client-tag prefix each one uses.
+//
+// RE: the prefix mapper at 0x4776ed8-0x4776feb in Aside Framework 1.0.825.1
+// (inside the daemon-auth / sync region 0x04768830), which holds exactly the
+// four literals "local:", "session:", "extension-local:" and
+// "extension-session:" next to the AsideWebsiteStorageSyncService factory name.
+namespace aside {
+
+enum class WebsiteStorageKind {
+  kLocal,
+  kSession,
+  kExtensionLocal,
+  kExtensionSession,
+};
+
+// "local" / "session" / "extension-local" / "extension-session"; the value
+// that goes into AsideWebsiteStorageSpecifics::storage_kind.
+std::string_view WebsiteStorageKindToken(WebsiteStorageKind kind);
+
+// The same token followed by ':', which is how the original prefixes a
+// storage area's client tag.
+std::string_view WebsiteStorageClientTagPrefix(WebsiteStorageKind kind);
+
+// Parses a storage_kind token back into a kind; nullopt for anything else.
+std::optional<WebsiteStorageKind> WebsiteStorageKindFromToken(
+    std::string_view token);
+
+// True for the two kinds that are scoped to a DOM storage namespace, and so
+// carry AsideWebsiteStorageSpecifics::namespace_id.
+bool WebsiteStorageKindIsSessionScoped(WebsiteStorageKind kind);
+
+}  // namespace aside
+
+#endif  // CHROME_BROWSER_SYNC_ASIDE_WEBSITE_STORAGE_KINDS_H_
