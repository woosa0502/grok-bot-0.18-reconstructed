+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_INSTALLER_H_
+#define CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_INSTALLER_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "base/version.h"
+#include "components/component_updater/component_installer.h"
+
+namespace component_updater {
+
+class ComponentUpdateService;
+
+// The bundled Aside components, in the order the original registers them.
+// RE: "aside-daemon", "password-manager", "agent-manager" (0xe5709c1).
+enum class AsideComponentKind {
+  kDaemon,
+  kPasswordManager,
+  kAgentManager,
+};
+
+// "aside-daemon" / "password-manager" / "agent-manager".
+std::string AsideComponentToken(AsideComponentKind kind);
+// "Aside Daemon" / "Aside Password Manager" / "Aside Agent Manager".
+std::string AsideComponentName(AsideComponentKind kind);
+// The Omaha app id, derived from the signing key hash. Empty when the key for
+// that component is not known to this build.
+std::string AsideComponentAppId(AsideComponentKind kind);
+// The 32-byte SHA-256 of the component's signing key, or an empty vector.
+std::vector<uint8_t> AsideComponentPublicKeyHash(AsideComponentKind kind);
+
+// Called on the UI thread each time a bundled Aside component becomes ready.
+using AsideComponentReadyCallback =
+    base::RepeatingCallback<void(AsideComponentKind kind,
+                                 const base::Version& version,
+                                 const base::FilePath& install_dir)>;
+
+class AsideComponentInstallerPolicy : public ComponentInstallerPolicy {
+ public:
+  AsideComponentInstallerPolicy(AsideComponentKind kind,
+                                AsideComponentReadyCallback ready_callback);
+  ~AsideComponentInstallerPolicy() override;
+
+  AsideComponentInstallerPolicy(const AsideComponentInstallerPolicy&) = delete;
+  AsideComponentInstallerPolicy& operator=(
+      const AsideComponentInstallerPolicy&) = delete;
+
+  // ComponentInstallerPolicy:
+  bool VerifyInstallation(const base::DictValue& manifest,
+                          const base::FilePath& install_dir) const override;
+  void ComponentReady(const base::Version& version,
+                      const base::FilePath& install_dir,
+                      base::DictValue manifest) override;
+  update_client::InstallerAttributes GetInstallerAttributes() const override;
+
+ private:
+  bool SupportsGroupPolicyEnabledComponentUpdates() const override;
+  bool RequiresNetworkEncryption() const override;
+  update_client::CrxInstaller::Result OnCustomInstall(
+      const base::DictValue& manifest,
+      const base::FilePath& install_dir) override;
+  void OnCustomUninstall() override;
+  base::FilePath GetRelativeInstallDir() const override;
+  void GetHash(std::vector<uint8_t>* hash) const override;
+  std::string GetName() const override;
+
+  const AsideComponentKind kind_;
+  const AsideComponentReadyCallback ready_callback_;
+};
+
+// Registers every bundled Aside component whose signing key this build knows,
+// against `cus` (the Aside-specific component update service, not Chrome's).
+void RegisterAsideComponents(ComponentUpdateService* cus,
+                             AsideComponentReadyCallback ready_callback);
+
+}  // namespace component_updater
+
+#endif  // CHROME_BROWSER_COMPONENT_UPDATER_ASIDE_COMPONENT_INSTALLER_H_
