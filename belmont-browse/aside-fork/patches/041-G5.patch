diff --git a/components/sync/protocol/aside_website_storage_specifics.proto b/components/sync/protocol/aside_website_storage_specifics.proto
new file mode 100644
index 0000000000..c87d4438f9
--- /dev/null
+++ b/components/sync/protocol/aside_website_storage_specifics.proto
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+syntax = "proto2";
+
+option java_multiple_files = true;
+option java_package = "org.chromium.components.sync.protocol";
+
+option optimize_for = LITE_RUNTIME;
+
+package sync_pb;
+
+// One key/value pair inside a synced website storage area.
+// RE: sync_pb.AsideWebsiteStorageEntrySpecifics (Aside 1.0.825.1).
+message AsideWebsiteStorageEntrySpecifics {
+  // The storage area key, as seen by the page.
+  optional string key = 1;
+
+  // The storage area value. DOM storage values are UTF-16 strings that may
+  // contain unpaired surrogates, so they travel as bytes.
+  optional bytes value = 2;
+}
+
+// A whole website storage area (one origin x one namespace), synced as a
+// single entity. Always encrypted (see kDataTypeInfoMap).
+// RE: sync_pb.AsideWebsiteStorageSpecifics (Aside 1.0.825.1).
+message AsideWebsiteStorageSpecifics {
+  // Which kind of storage area this is. One of the AsideWebsiteStorageKind
+  // tokens: "local", "session", "extension-local", "extension-session".
+  optional string storage_kind = 1;
+
+  // The serialized blink::StorageKey (origin plus partitioning) that owns the
+  // area. Used together with `storage_kind` to form the client tag.
+  optional bytes serialized_storage_key = 2;
+
+  // The DOM storage namespace id for session storage areas; empty for the
+  // local storage kinds.
+  optional string namespace_id = 3;
+
+  // Every key/value pair currently in the area.
+  repeated AsideWebsiteStorageEntrySpecifics entries = 4;
+
+  // When the area was last written locally.
+  optional int64 updated_at_windows_epoch_micros = 5;
+}
