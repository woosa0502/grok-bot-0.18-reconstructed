+void AsideVerticalTabStripAdditions::RunTaskCommand(const std::string& path,
+                                                    std::string body) {
+  if (!tasks_client_) {
+    return;
+  }
+  tasks_client_->PostJson(
+      path, std::move(body),
+      base::BindOnce(&AsideVerticalTabStripAdditions::OnTaskCommandDone,
+                     weak_factory_.GetWeakPtr()));
