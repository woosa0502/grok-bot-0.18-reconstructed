diff --git a/chrome/browser/ui/views/frame/aside_pinned_entries_view.cc b/chrome/browser/ui/views/frame/aside_pinned_entries_view.cc
new file mode 100644
index 0000000000..f5d24bd47a
--- /dev/null
+++ b/chrome/browser/ui/views/frame/aside_pinned_entries_view.cc
@@ -0,0 +1,241 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/aside_pinned_entries_view.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/aside/icons/vector_icons.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/common/bookmark_metrics.h"
+#include "components/favicon/content/content_favicon_driver.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/flex_layout.h"
+
+namespace {
+
+// Original UTF-16 literals, arm64 0xd77b0dc-0xd77b1c8.
+constexpr char16_t kRemoveBookmark[] = u"Remove bookmark";
+constexpr char16_t kRemoveBookmarkPrefix[] = u"Remove bookmark: ";
+constexpr char16_t kAddBookmark[] = u"Add bookmark";
+constexpr char16_t kAddToBookmarksPrefix[] = u"Add to bookmarks: ";
+constexpr char16_t kRemoveFromPin[] = u"Remove from pin";
+constexpr char16_t kRemoveFromPinPrefix[] = u"Remove from pin: ";
+constexpr char16_t kSwitchToPrefix[] = u"Switch to ";
+constexpr char16_t kPaused[] = u"Paused";
+constexpr char16_t kPausedSuffix[] = u", Paused";
+
+constexpr int kEntryIconSize = 16;
+
+enum PinnedEntryCommand {
+  kRemoveFromPinCommand = 1,
+  kToggleBookmarkCommand = 2,
+};
+
+}  // namespace
+
+AsidePinnedEntriesView::AsidePinnedEntriesView(Browser* browser,
+                                               Orientation orientation)
+    : browser_(browser), orientation_(orientation) {
+  auto* layout = SetLayoutManager(std::make_unique<views::FlexLayout>());
+  layout->SetOrientation(orientation_ == Orientation::kHorizontal
+                             ? views::LayoutOrientation::kHorizontal
+                             : views::LayoutOrientation::kVertical);
+  layout->SetCollapseMargins(true);
+  layout->SetDefault(views::kMarginsKey, gfx::Insets::VH(2, 2));
+  if (browser_) {
+    browser_->tab_strip_model()->AddObserver(this);
+  }
+  Rebuild();
+}
+
+AsidePinnedEntriesView::~AsidePinnedEntriesView() {
+  if (browser_) {
+    browser_->tab_strip_model()->RemoveObserver(this);
+  }
+}
+
+void AsidePinnedEntriesView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  Rebuild();
+}
+
+void AsidePinnedEntriesView::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                     int index) {
+  // Pinning a tab that already sits in the leading run moves nothing, so
+  // OnTabStripModelChanged never fires for it.
+  Rebuild();
+}
+
+void AsidePinnedEntriesView::OnTabChangedAt(tabs::TabInterface* tab,
+                                            int index,
+                                            TabChangeType change_type) {
+  if (change_type == TabChangeType::kAll) {
+    Rebuild();
+  }
+}
+
+bool AsidePinnedEntriesView::IsEntryBookmarked(int index) const {
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  content::WebContents* contents =
+      browser_->tab_strip_model()->GetWebContentsAt(index);
+  if (!model || !model->loaded() || !contents) {
+    return false;
+  }
+  return !model->GetNodesByURL(contents->GetLastCommittedURL()).empty();
+}
+
+void AsidePinnedEntriesView::Rebuild() {
+  RemoveAllChildViews();
+  entry_indices_.clear();
+  if (!browser_) {
+    SetVisible(false);
+    return;
+  }
+  TabStripModel* model = browser_->tab_strip_model();
+  for (int i = 0; i < model->count(); ++i) {
+    if (!model->IsTabPinned(i)) {
+      break;  // Pinned tabs are always the leading run.
+    }
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (!contents) {
+      continue;
+    }
+    ui::ImageModel favicon =
+        ui::ImageModel::FromVectorIcon(kAsideGlobeIcon, ui::kColorIcon,
+                                       kEntryIconSize);
+    if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents);
+        driver && !driver->GetFavicon().IsEmpty()) {
+      favicon = ui::ImageModel::FromImage(driver->GetFavicon());
+    }
+    const std::u16string title = contents->GetTitle();
+    const bool paused = contents->WasDiscarded();
+    auto entry = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&AsidePinnedEntriesView::ActivateEntry,
+                            base::Unretained(this), i),
+        kAsideGlobeIcon, kEntryIconSize);
+    entry->SetImageModel(views::Button::STATE_NORMAL, favicon);
+    // "Switch to <title>", with ", Paused" appended for a discarded tab; a tab
+    // with no title at all falls back to the bare "Paused" label.
+    std::u16string tooltip = title.empty() && paused
+                                 ? std::u16string(kPaused)
+                                 : std::u16string(kSwitchToPrefix) + title;
+    if (paused && !title.empty()) {
+      tooltip += kPausedSuffix;
+    }
+    entry->SetTooltipText(tooltip);
+    entry->GetViewAccessibility().SetName(tooltip);
+    entry->set_context_menu_controller(this);
+    views::View* added = AddChildView(std::move(entry));
+    entry_indices_[added] = i;
+  }
+  SetVisible(!children().empty());
+  InvalidateLayout();
+}
+
+void AsidePinnedEntriesView::ActivateEntry(int index) {
+  TabStripModel* model = browser_->tab_strip_model();
+  if (index >= 0 && index < model->count()) {
+    model->ActivateTabAt(index);
+  }
+}
+
+void AsidePinnedEntriesView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto it = entry_indices_.find(source);
+  if (it == entry_indices_.end()) {
+    return;
+  }
+  pending_index_ = it->second;
+  content::WebContents* contents =
+      browser_->tab_strip_model()->GetWebContentsAt(pending_index_);
+  const std::u16string title = contents ? contents->GetTitle() : u"";
+  const bool bookmarked = IsEntryBookmarked(pending_index_);
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kRemoveFromPinCommand, kRemoveFromPin);
+  menu_model_->SetAccessibleNameAt(
+      menu_model_->GetItemCount() - 1,
+      std::u16string(kRemoveFromPinPrefix) + title);
+  menu_model_->AddItem(kToggleBookmarkCommand,
+                       bookmarked ? kRemoveBookmark : kAddBookmark);
+  menu_model_->SetAccessibleNameAt(
+      menu_model_->GetItemCount() - 1,
+      (bookmarked ? std::u16string(kRemoveBookmarkPrefix)
+                  : std::u16string(kAddToBookmarksPrefix)) +
+          title);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+bool AsidePinnedEntriesView::IsCommandIdChecked(int command_id) const {
+  return false;
+}
+
+bool AsidePinnedEntriesView::IsCommandIdEnabled(int command_id) const {
+  return true;
+}
+
+void AsidePinnedEntriesView::ExecuteCommand(int command_id, int event_flags) {
+  TabStripModel* model = browser_->tab_strip_model();
+  if (pending_index_ < 0 || pending_index_ >= model->count()) {
+    return;
+  }
+  switch (command_id) {
+    case kRemoveFromPinCommand:
+      model->SetTabPinned(pending_index_, false);
+      break;
+    case kToggleBookmarkCommand: {
+      bookmarks::BookmarkModel* bookmarks =
+          BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+      content::WebContents* contents = model->GetWebContentsAt(pending_index_);
+      if (!bookmarks || !bookmarks->loaded() || !contents) {
+        break;
+      }
+      const GURL url = contents->GetLastCommittedURL();
+      auto existing = bookmarks->GetNodesByURL(url);
+      if (existing.empty()) {
+        bookmarks->AddURL(bookmarks->bookmark_bar_node(),
+                          bookmarks->bookmark_bar_node()->children().size(),
+                          contents->GetTitle(), url);
+      } else {
+        for (const bookmarks::BookmarkNode* node : existing) {
+          bookmarks->Remove(node,
+                            bookmarks::metrics::BookmarkEditSource::kUser,
+                            FROM_HERE);
+        }
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+BEGIN_METADATA(AsidePinnedEntriesView)
+END_METADATA
