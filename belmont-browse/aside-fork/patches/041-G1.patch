+void ShowArchiveConfirm(Browser* browser,
+                        const std::u16string& title,
+                        const std::u16string& body,
+                        const std::string& internal_name,
+                        base::OnceClosure on_accept) {
+  if (!browser) {
+    return;
+  }
+  auto model =
+      ui::DialogModel::Builder()
+          .SetTitle(title)
+          .SetInternalName(internal_name)
+          .AddParagraph(ui::DialogModelLabel(body))
+          .AddOkButton(
+              std::move(on_accept),
+              ui::DialogModel::Button::Params().SetLabel(kArchive).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+}  // namespace
+
+void ShowAsideRenameChatDialog(
+    Browser* browser,
+    const std::u16string& initial_title,
+    base::OnceCallback<void(const std::u16string&)> on_submit) {
+  if (!browser) {
+    return;
+  }
+  auto delegate = std::make_unique<RenameChatDelegate>(std::move(on_submit));
+  RenameChatDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kNewChatName)
+          .SetSubtitle(kChooseShortName)
+          .SetInternalName("VerticalTabStripRenameChat")
+          .AddTextfield(kRenameChatFieldId, kNewChatName, initial_title)
+          .AddOkButton(base::BindOnce(&RenameChatDelegate::OnAccept,
+                                      base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(kSave))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kRenameChatFieldId)
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void ShowAsideArchiveSessionDialog(Browser* browser,
+                                   base::OnceClosure on_accept) {
+  ShowArchiveConfirm(browser, kArchiveSessionTitle, kArchiveSessionBody,
+                     "VerticalTabStripArchiveSession", std::move(on_accept));
+}
+
+void ShowAsideArchiveAllChatsDialog(Browser* browser,
+                                    base::OnceClosure on_accept) {
+  ShowArchiveConfirm(browser, kArchiveAllTitle, kArchiveAllBody,
+                     "VerticalTabStripArchiveAllChats", std::move(on_accept));
+}
+
+namespace {
+
+// Self-owned: deletes itself when its widget closes.
+class ToastController {
+ public:
+  ToastController(views::View* anchor, const std::u16string& text) {
+    delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, views::BubbleBorder::LEFT_TOP);
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetShowTitle(false);
+    delegate_->SetShowCloseButton(false);
+    delegate_->set_margins(gfx::Insets::VH(8, 12));
+    auto label = std::make_unique<views::Label>(text);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    delegate_->SetContentsView(std::move(label));
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(),
+        base::BindOnce(&ToastController::OnClosed, base::Unretained(this)));
+    widget_->Show();
+    timer_.Start(FROM_HERE, base::Seconds(2),
+                 base::BindOnce(&ToastController::Dismiss,
+                                base::Unretained(this)));
+  }
+
+ private:
+  void Dismiss() {
+    if (widget_) {
+      widget_->Close();
+    }
+  }
+  void OnClosed(views::Widget::ClosedReason) { delete this; }
+
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  base::OneShotTimer timer_;
+};
+
+}  // namespace
+
+void ShowAsideToast(views::View* anchor, const std::u16string& text) {
+  if (!anchor || !anchor->GetWidget()) {
+    return;
+  }
+  new ToastController(anchor, text);  // self-owned
+}
+
+void ShowAsideTaskPopover(
+    views::View* anchor,
+    const base::DictValue& popover,
+    base::RepeatingCallback<void(const std::string&)> on_action) {
+  if (!anchor) {
+    return;
+  }
+  new PopoverController(anchor, popover, std::move(on_action));  // self-owned
+}
