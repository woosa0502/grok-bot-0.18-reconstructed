+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_BOOKMARK_DIALOGS_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_BOOKMARK_DIALOGS_H_
+
+#include <cstdint>
+
+class Browser;
+
+// The four bookmark dialogs the original opens from the vertical tab strip's
+// bookmarks section (RE of vertical_tab_bookmarks_view.cc, Aside 1.0.825.1:
+// VerticalTabBookmarksRenameFolder / DeleteFolderById /
+// VerticalTabBookmarksEditBookmark / DeleteBookmarkById; the textfield element
+// ids kRenameFolderFieldId, kEditBookmarkNameFieldId and
+// kEditBookmarkUrlFieldId are declared at lines 148-150 of that file, so the
+// original builds these with ui::DialogModel too).
+//
+// Strings are the original's UTF-16 literals (x86_64 slice 0xe9a7530-0xe9a76bc,
+// arm64 0xd77ac1e-0xd77ad8a).
+namespace aside {
+
+// "Rename Folder" — textfield labelled "Folder name", accept button "Rename".
+void ShowRenameFolderDialog(Browser* browser, int64_t folder_id);
+
+// "Delete Folder" — body 'Delete "<name>" and everything inside it?' (or
+// "Delete this folder and everything inside it?" when the name is empty),
+// accept button "Delete".
+void ShowDeleteFolderDialog(Browser* browser, int64_t folder_id);
+
+// "Edit Bookmark" — textfields "Name" and "URL", accept button "Save".
+void ShowEditBookmarkDialog(Browser* browser, int64_t node_id);
+
+// "Delete Bookmark" — body 'Delete "<name>"?' (or "Delete this bookmark?"),
+// accept button "Delete".
+void ShowDeleteBookmarkDialog(Browser* browser, int64_t node_id);
+
+}  // namespace aside
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ASIDE_BOOKMARK_DIALOGS_H_
