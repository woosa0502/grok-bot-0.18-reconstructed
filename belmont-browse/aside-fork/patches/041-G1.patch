+
+void AsideVerticalTabStripAdditions::CopySessionId(
+    const std::string& session_id) {
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(session_id));
+  // The original confirms with a short "Session ID Copied!" bubble
+  // (arm64 0xd77b0b6, xrefs 0x43dc25c / 0x43dc298).
+  ShowAsideToast(this, kSessionIdCopied);
+}
+
+void AsideVerticalTabStripAdditions::BookmarkSession(
+    const std::string& session_id,
+    const std::string& title) {
+  if (!browser_) {
+    return;
+  }
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(browser_->profile());
+  if (!model || !model->loaded()) {
+    return;
+  }
+  const GURL url = aside::ExtensionPageUrl(browser_->profile(), "main.html",
+                                           "/tasks/" + session_id);
+  model->AddURL(model->bookmark_bar_node(),
+                model->bookmark_bar_node()->children().size(),
+                title.empty() ? std::u16string(kUntitledTask)
+                              : base::UTF8ToUTF16(title),
+                url);
+}
+
+void AsideVerticalTabStripAdditions::OpenSession(const std::string& session_id) {
+  if (!browser_) {
+    return;
+  }
+  // RE 0x43d8e40: "main.html" + "/tasks" + "/" + id via the account-scoped
+  // extension URL builder ("#/u/<aside.account_id>").
+  aside::ShowExtensionPage(
+      browser_, aside::ExtensionPageUrl(browser_->profile(), "main.html",
+                                        "/tasks/" + session_id));
+}
+
+void AsideVerticalTabStripAdditions::OpenRecentsList() {
+  if (!browser_) {
+    return;
+  }
+  // RE 0x43d2000: section header opens the full task list.
+  aside::ShowExtensionPage(
+      browser_,
+      aside::ExtensionPageUrl(browser_->profile(), "main.html",
+                              "/tasks?view=list&filter=all&order=desc"));
+}
