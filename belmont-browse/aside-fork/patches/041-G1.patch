+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteFolderTitle)
+          .SetInternalName("VerticalTabBookmarksDeleteFolder")
+          .AddParagraph(ui::DialogModelLabel(DeleteBody(
+              node->GetTitle(), kDeleteThisFolder, kAndEverythingInside)))
+          .AddOkButton(
+              base::BindOnce(&BookmarkDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void ShowEditBookmarkDialog(Browser* browser, int64_t node_id) {
+  const bookmarks::BookmarkNode* node = NodeFor(browser, node_id);
+  if (!node || !node->is_url()) {
+    return;
+  }
+  auto delegate = std::make_unique<BookmarkDialogDelegate>(browser, node_id);
+  BookmarkDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kEditBookmarkTitle)
+          .SetInternalName("VerticalTabBookmarksEditBookmark")
+          .AddTextfield(kEditBookmarkNameFieldId, kName, node->GetTitle())
+          .AddTextfield(kEditBookmarkUrlFieldId, kUrl,
+                        base::UTF8ToUTF16(node->url().spec()))
+          .AddOkButton(base::BindOnce(&BookmarkDialogDelegate::OnEditBookmark,
+                                      base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(kSave))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kEditBookmarkNameFieldId)
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void ShowDeleteBookmarkDialog(Browser* browser, int64_t node_id) {
+  const bookmarks::BookmarkNode* node = NodeFor(browser, node_id);
+  if (!node || !node->is_url()) {
+    return;
+  }
+  auto delegate = std::make_unique<BookmarkDialogDelegate>(browser, node_id);
+  BookmarkDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteBookmarkTitle)
+          .SetInternalName("VerticalTabBookmarksDeleteBookmark")
+          .AddParagraph(ui::DialogModelLabel(DeleteBody(
+              node->GetTitle(), kDeleteThisBookmark, kQuoteQuestion)))
+          .AddOkButton(
+              base::BindOnce(&BookmarkDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+}  // namespace aside
