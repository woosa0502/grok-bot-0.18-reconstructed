+// Two URLs belong to the same site when their registrable domains match; a
+// pinned tab is allowed to move freely inside its own site.
+bool SameSite(const GURL& a, const GURL& b) {
+  if (!a.is_valid() || !b.is_valid()) {
+    return true;
+  }
+  if (a.SchemeIs(url::kAboutScheme) || b.SchemeIs(url::kAboutScheme)) {
+    return true;
+  }
+  return net::registry_controlled_domains::SameDomainOrHost(
+      a, b, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+}
+
