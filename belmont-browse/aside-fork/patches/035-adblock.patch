+                          UpdateSubscriptionCallback callback) override;
+  void UpdateAllSubscriptions(UpdateAllSubscriptionsCallback callback) override;
+  void SaveCustomRules(const std::string& rules,
+                       SaveCustomRulesCallback callback) override;
+  void ReloadManualFilters(ReloadManualFiltersCallback callback) override;
+  void ClearEngineCache(ClearEngineCacheCallback callback) override;
+  void TestRule(const std::string& url,
+                const std::string& initiator,
+                const std::string& request_type,
+                const std::string& method,
+                bool third_party,
+                TestRuleCallback callback) override;
+
+ private:
+  std::string StateJson();
+
+  mojo::ReceiverSet<adblock_internals::mojom::AdblockInternalsPageHandler>
+      receivers_;
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+class AsideAdblockInternalsUIConfig
+    : public content::DefaultWebUIConfig<AsideAdblockInternalsUI> {
+ public:
+  AsideAdblockInternalsUIConfig();
+};
