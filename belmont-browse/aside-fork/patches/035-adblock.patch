+// ---- custom / manual / cache ------------------------------------------------
+
+std::string AsideAdBlockService::SaveCustomRules(const std::string& rules) {
+  if (rules.size() > kMaxCustomRulesBytes) {
+    return "Custom rules exceed the 4 MiB limit.";
+  }
+  if (!base::IsStringUTF8(rules) || rules.find('\0') != std::string::npos) {
+    return "Custom rules must be UTF-8 text.";
+  }
+  custom_rules_ = rules;
+  pending_custom_rules_.clear();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WriteTextOnWorker, custom_rules_path_, rules));
+  RequestCompile();
+  return std::string();
+}
+
+std::string AsideAdBlockService::ReloadManualFilters() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath manual_dir) {
+            auto state = std::make_unique<LoadedState>();
+            base::FileEnumerator files(manual_dir, false,
+                                       base::FileEnumerator::FILES,
+                                       FILE_PATH_LITERAL("*.txt"));
+            for (base::FilePath path = files.Next(); !path.empty();
+                 path = files.Next()) {
+              ManualFile file;
+              file.name = path.BaseName().AsUTF8Unsafe();
+              if (!base::ReadFileToString(path, &file.text) ||
+                  !base::IsStringUTF8(file.text)) {
+                state->manual_error = "Could not read " + file.name;
+                continue;
+              }
+              state->manual_files.push_back(std::move(file));
+            }
+            return state;
+          },
+          manual_dir_),
+      base::BindOnce(
+          [](base::WeakPtr<AsideAdBlockService> self,
+             std::unique_ptr<LoadedState> state) {
+            if (!self) {
+              return;
+            }
+            self->manual_files_ = std::move(state->manual_files);
+            self->manual_filter_error_ = std::move(state->manual_error);
+            self->RequestCompile();
+          },
+          weak_factory_.GetWeakPtr()));
+  return std::string();
+}
+
+std::string AsideAdBlockService::ClearEngineCache() {
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(base::IgnoreResult(&base::DeletePathRecursively),
+                     cache_dir_));
+  last_cache_hit_ = false;
+  RequestCompile();
+  return std::string();
+}
