+constexpr base::TimeDelta kUpdateInterval = base::Hours(24);
+constexpr base::TimeDelta kUpdateTick = base::Minutes(30);
+constexpr char kMetadataFile[] = "subscriptions.json";
+
+// Default subscriptions installed on first run (the original ships the
+// list selection through its extension settings; EasyList + EasyPrivacy are
+// the lists it exposes by default).
+struct DefaultSubscription {
+  const char* name;
+  const char* url;
+};
+constexpr DefaultSubscription kDefaultSubscriptions[] = {
+    {"EasyList", "https://easylist.to/easylist/easylist.txt"},
+    {"EasyPrivacy", "https://easylist.to/easylist/easyprivacy.txt"},
+};
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("aside_adblock_subscription", R"(
+        semantics {
+          sender: "Aside ad blocker"
+          description: "Downloads ad-block filter lists the user subscribed."
+          trigger: "Adding a subscription or the daily update."
+          data: "None."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "chrome://aside-adblock"
+          policy_exception_justification: "Not implemented."
+        })");
+
+double ToJsTime(base::Time t) {
+  return t.is_null() ? 0 : t.InMillisecondsFSinceUnixEpoch();
+}
+
+base::Time FromJsTime(double ms) {
+  return ms <= 0 ? base::Time()
+                 : base::Time::FromMillisecondsSinceUnixEpoch(ms);
+}
+
+std::string Sha256Hex(const std::string& text) {
+  return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(text)));
+}
+
+base::ListValue ToList(const std::vector<std::string>& v) {
+  base::ListValue list;
+  for (const std::string& s : v) {
+    list.Append(s);
+  }
+  return list;
+}
+
+std::string ValidateSubscriptionUrl(const std::string& spec) {
+  GURL url(spec);
+  if (!url.is_valid()) {
+    return "Subscription URL is not valid.";
+  }
+  if (!url.SchemeIs("https") && !url.SchemeIs("http")) {
+    return "Subscription URL must use http or https.";
+  }
+  if (url.has_username() || url.has_password()) {
+    return "Subscription URL must not contain credentials.";
+  }
+  if (url.has_ref()) {
+    return "Subscription URL must not contain a fragment.";
+  }
+  if (url.HostIsIPAddress() && url.host() == "127.0.0.1") {
+    return "Subscription URL must not point at localhost.";
+  }
+  if (url.host() == "localhost") {
+    return "Subscription URL must not point at localhost.";
+  }
+  return std::string();
+}
