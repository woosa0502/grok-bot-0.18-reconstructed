@@ -0,0 +1,212 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_adblock/aside_adblock_internals_ui.h"
+
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/path_service.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/aside_adblock/aside_adblock_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/url_constants.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kAsideAdblockHost[] = "aside-adblock";
+constexpr char kAdblockInternalsHost[] = "adblock-internals";
+
+base::FilePath ResourceDir() {
+  base::FilePath dir;
+  base::PathService::Get(base::DIR_EXE, &dir);
+  return dir.AppendASCII("aside_resources").AppendASCII("adblock");
+}
+
+bool ShouldHandleRequest(const std::string& path) {
+  return path.empty() || path == "adblock_internals.html" ||
+         path == "adblock_internals.css" || path == "adblock_internals.js" ||
+         path == "adblock_internals.mojom-webui.js";
+}
+
+scoped_refptr<base::RefCountedMemory> ReadResource(std::string path) {
+  if (path.empty()) {
+    path = "adblock_internals.html";
+  }
+  std::string data;
+  if (!base::ReadFileToString(ResourceDir().AppendASCII(path), &data)) {
+    return base::MakeRefCounted<base::RefCountedString>(std::string());
+  }
+  if (path.ends_with(".html")) {
+    base::ReplaceSubstringsAfterOffset(&data, 0, "$i18n{textdirection}", "ltr");
+    base::ReplaceSubstringsAfterOffset(&data, 0, "$i18n{language}", "en");
+  }
+  return base::MakeRefCounted<base::RefCountedString>(std::move(data));
+}
+
+void HandleRequest(const std::string& path,
+                   content::WebUIDataSource::GotDataCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&ReadResource, path), std::move(callback));
+}
+
+void ConfigureSource(content::WebUIDataSource* source) {
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandleRequest),
+                           base::BindRepeating(&HandleRequest));
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::StyleSrc,
+      "style-src chrome://theme chrome://resources 'self' 'unsafe-inline';");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::TrustedTypes,
+      "trusted-types static-types adblock-internals lit-html;");
+  source->DisableTrustedTypesCSP();
+}
+
+}  // namespace
+
+AsideAdblockInternalsUIConfig::AsideAdblockInternalsUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kAsideAdblockHost) {}
+
+AsideAdblockInternalsAliasUIConfig::AsideAdblockInternalsAliasUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kAdblockInternalsHost) {}
+
+AsideAdblockInternalsUI::AsideAdblockInternalsUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui, /*enable_chrome_send=*/false) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  const std::string host(web_ui->GetWebContents()->GetVisibleURL().host());
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, host == kAdblockInternalsHost ? kAdblockInternalsHost
+                                             : kAsideAdblockHost);
+  ConfigureSource(source);
+}
+
+AsideAdblockInternalsUI::~AsideAdblockInternalsUI() = default;
+
+void AsideAdblockInternalsUI::BindInterface(
+    mojo::PendingReceiver<adblock_internals::mojom::AdblockInternalsPageHandler>
+        receiver) {
+  receivers_.Add(this, std::move(receiver));
+}
+
+std::string AsideAdblockInternalsUI::StateJson() {
+  aside_adblock::AsideAdBlockService* service =
+      aside_adblock::AsideAdBlockService::Get(Profile::FromWebUI(web_ui()));
+  std::string json;
+  if (service) {
+    base::JSONWriter::Write(service->State(), &json);
+  } else {
+    json = "{}";
+  }
+  return json;
+}
+
+#define ASIDE_ADBLOCK_SERVICE_OR_RETURN(service, callback, ...)              \
+  aside_adblock::AsideAdBlockService* service =                              \
+      aside_adblock::AsideAdBlockService::Get(Profile::FromWebUI(web_ui())); \
+  if (!service) {                                                            \
+    std::move(callback).Run(__VA_ARGS__);                                    \
+    return;                                                                  \
+  }
+
+void AsideAdblockInternalsUI::GetState(GetStateCallback callback) {
+  std::move(callback).Run(StateJson());
+}
+
+void AsideAdblockInternalsUI::SetEnabled(bool enabled,
+                                         SetEnabledCallback callback) {
+  ASIDE_ADBLOCK_SERVICE_OR_RETURN(service, callback, "{}", "No service");
+  std::string error = service->SetEnabled(enabled);
+  std::move(callback).Run(StateJson(), error);
+}
+
+void AsideAdblockInternalsUI::AddSubscription(const std::string& name,
+                                              const std::string& url,
+                                              AddSubscriptionCallback callback) {
+  ASIDE_ADBLOCK_SERVICE_OR_RETURN(service, callback, "{}", "No service");
