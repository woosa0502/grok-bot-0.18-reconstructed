+namespace aside_adblock {
+
+// static
+void AsideAdBlockProxyingURLLoaderFactory::MaybeProxy(
+    content::BrowserContext* browser_context,
+    content::RenderFrameHost* frame,
+    network::URLLoaderFactoryBuilder& factory_builder) {
+  AsideAdBlockService* service = AsideAdBlockService::Get(browser_context);
+  if (!service) {
+    return;
+  }
+  std::optional<url::Origin> frame_origin;
+  if (frame) {
+    frame_origin = frame->GetLastCommittedOrigin();
+  }
+  auto [proxied_receiver, target_remote] = factory_builder.Append();
+  VLOG(1) << "AsideAdBlock: proxying URLLoaderFactory for "
+          << (frame ? frame->GetLastCommittedURL().spec() : "(no frame)")
+          << " origin="
+          << (frame_origin ? frame_origin->Serialize() : "(none)");
+  // Self-owned; deleted on disconnect of all receivers or the target.
+  new AsideAdBlockProxyingURLLoaderFactory(
+      service->GetWeakPtr(), std::move(frame_origin),
+      std::move(proxied_receiver), std::move(target_remote));
+}
+
+AsideAdBlockProxyingURLLoaderFactory::AsideAdBlockProxyingURLLoaderFactory(
+    base::WeakPtr<AsideAdBlockService> service,
+    std::optional<url::Origin> frame_origin,
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target)
+    : service_(std::move(service)), frame_origin_(std::move(frame_origin)) {
+  target_.Bind(std::move(target));
+  target_.set_disconnect_handler(
+      base::BindOnce(&AsideAdBlockProxyingURLLoaderFactory::OnDisconnect,
+                     base::Unretained(this)));
+  receivers_.Add(this, std::move(receiver));
+  receivers_.set_disconnect_handler(
+      base::BindRepeating(&AsideAdBlockProxyingURLLoaderFactory::OnDisconnect,
+                          base::Unretained(this)));
+}
+
+AsideAdBlockProxyingURLLoaderFactory::~AsideAdBlockProxyingURLLoaderFactory() =
+    default;
+
+void AsideAdBlockProxyingURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  if (!service_) {
+    VLOG(2) << "AsideAdBlock: no service for " << request.url.spec();
+  }
+  // Note: |is_outermost_main_frame| marks requests *made by* the top-level
+  // document (used for client hints), not navigations, so it must not be used
+  // to skip requests here. Document navigations never reach this factory.
+  if (service_ && request.url.SchemeIsHTTPOrHTTPS() &&
+      request.destination != network::mojom::RequestDestination::kDocument) {
+    url::Origin initiator;
+    if (request.request_initiator) {
+      initiator = *request.request_initiator;
+    } else if (frame_origin_) {
+      initiator = *frame_origin_;
+    }
+    MatchResult result = service_->Evaluate(
+        request.url, initiator,
+        ElementTypeForDestination(request.destination),
+        /*is_document=*/false);
+    VLOG(2) << "AsideAdBlock: " << request.url.spec() << " initiator="
+            << initiator.Serialize() << " dest="
+            << static_cast<int>(request.destination) << " -> "
+            << (result.should_block ? "BLOCK " + result.filter : "allow");
+    if (result.should_block) {
+      mojo::Remote<network::mojom::URLLoaderClient> remote(std::move(client));
+      remote->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+  }
+  target_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                request, std::move(client),
+                                traffic_annotation);
+}
+
+void AsideAdBlockProxyingURLLoaderFactory::Clone(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+  receivers_.Add(this, std::move(receiver));
+}
+
+void AsideAdBlockProxyingURLLoaderFactory::OnDisconnect() {
+  if (!target_.is_connected() || receivers_.empty()) {
+    delete this;
+  }
+}
+
+}  // namespace aside_adblock
