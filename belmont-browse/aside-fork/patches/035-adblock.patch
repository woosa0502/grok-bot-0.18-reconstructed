+
+namespace aside_adblock {
+
+namespace {
+
+std::string BlockPageHtml(const GURL& url, const MatchResult& result) {
+  const std::string escaped_url = base::EscapeForHTML(url.spec());
+  const std::string escaped_filter = base::EscapeForHTML(result.filter);
+  return base::StrCat(
+      {"<!doctype html><html><head><meta charset=\"utf-8\">"
+       "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
+       "<title>Page blocked by Aside</title><style>"
+       "body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',"
+       "Roboto,sans-serif;background:#0f0f10;color:#e8e8e8;display:flex;"
+       "align-items:center;justify-content:center;min-height:100vh}"
+       ".card{max-width:520px;padding:32px;background:#1b1b1d;border-radius:16px;"
+       "box-shadow:0 12px 40px rgba(0,0,0,.4)}h1{font-size:22px;margin:0 0 8px}"
+       "p{margin:0 0 16px;color:#b8b8b8;line-height:1.5}code{display:block;"
+       "padding:10px 12px;background:#111;border-radius:8px;color:#d0d0d0;"
+       "word-break:break-all;font-size:12px;margin-bottom:8px}"
+       ".actions{display:flex;gap:12px;margin-top:20px}button{font:inherit;"
+       "padding:10px 16px;border-radius:10px;border:1px solid #3a3a3d;"
+       "background:#242427;color:#fff;cursor:pointer;text-decoration:none;"
+       "display:inline-block}a.button{font:inherit;padding:10px 16px;"
+       "border-radius:10px;border:1px solid #3a3a3d;background:#242427;"
+       "color:#fff;cursor:pointer;text-decoration:none;display:inline-block}"
+       "button.primary{"
+       "background:#fff;color:#111;border-color:#fff}</style></head><body>"
+       "<div class=\"card\" role=\"main\"><h1>Aside blocked this page</h1>"
+       "<p>A content filter matched this address before it was loaded.</p>"
+       "<code>", escaped_url, "</code>",
+       escaped_filter.empty()
+           ? ""
+           : base::StrCat({"<code>", escaped_filter, "</code>"}),
+       "<div class=\"actions\">"
+       "<button class=\"primary\" id=\"back\">Go back</button>"
+       "<a class=\"button\" id=\"continue\" href=\"", escaped_url,
+       "\">Continue once</a>"
+       "</div></div><script>"
+       "document.getElementById('back').onclick=function(){history.back();};"
+       "</script></body></html>"});
+}
+
+}  // namespace
+
+// static
+void AsideAdBlockNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  if (!AsideAdBlockService::Get(handle.GetWebContents()->GetBrowserContext())) {
+    return;
+  }
+  registry.AddThrottle(
+      std::make_unique<AsideAdBlockNavigationThrottle>(registry));
+}
+
+AsideAdBlockNavigationThrottle::AsideAdBlockNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+AsideAdBlockNavigationThrottle::~AsideAdBlockNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+AsideAdBlockNavigationThrottle::WillStartRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AsideAdBlockNavigationThrottle::WillRedirectRequest() {
+  return Check();
+}
+
+const char* AsideAdBlockNavigationThrottle::GetNameForLogging() {
+  return "AsideAdBlockNavigationThrottle";
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+AsideAdBlockNavigationThrottle::Check() {
+  content::NavigationHandle* handle = navigation_handle();
+  content::WebContents* contents = handle->GetWebContents();
+  AsideAdBlockService* service =
+      AsideAdBlockService::Get(contents->GetBrowserContext());
+  const GURL& url = handle->GetURL();
+  if (!service || !url.SchemeIsHTTPOrHTTPS()) {
+    return PROCEED;
+  }
+
+  if (handle->IsInPrimaryMainFrame()) {
+    if (allow_once_) {
+      return PROCEED;
+    }
+    // "Continue once": a user-gesture navigation from our own block page
+    // (an error document at the same URL) back to that URL.
+    content::RenderFrameHost* current = contents->GetPrimaryMainFrame();
+    content::NavigationEntry* entry =
+        contents->GetController().GetLastCommittedEntry();
+    const bool from_own_block_page =
+        current && current->IsErrorDocument() &&
+        ((entry && entry->GetURL() == url) ||
+         current->GetLastCommittedURL() == url);
+    VLOG(1) << "AsideAdBlock nav: " << url.spec() << " error_doc="
+            << (current && current->IsErrorDocument()) << " entry="
+            << (entry ? entry->GetURL().spec() : "(none)") << " gesture="
+            << handle->HasUserGesture() << " renderer="
+            << handle->IsRendererInitiated();
+    if (from_own_block_page && handle->HasUserGesture() &&
+        handle->IsRendererInitiated()) {
+      VLOG(1) << "AsideAdBlock nav: continue once for " << url.spec();
+      allow_once_ = true;
+      return PROCEED;
+    }
+    url::Origin initiator =
+        handle->GetInitiatorOrigin().value_or(url::Origin());
+    MatchResult result = service->Evaluate(
+        url, initiator, url_pattern_index::proto::ELEMENT_TYPE_SUBDOCUMENT,
+        /*is_document=*/true);
+    if (result.should_block) {
+      return ThrottleCheckResult(CANCEL, net::ERR_BLOCKED_BY_CLIENT,
+                                 BlockPageHtml(url, result));
+    }
+    return PROCEED;
+  }
+
+  if (handle->IsInMainFrame()) {
+    return PROCEED;  // fenced frames / portals: leave alone.
+  }
+  content::RenderFrameHost* parent = handle->GetParentFrame();
+  url::Origin initiator = parent ? parent->GetLastCommittedOrigin()
+                                 : url::Origin();
+  MatchResult result = service->Evaluate(
+      url, initiator, url_pattern_index::proto::ELEMENT_TYPE_SUBDOCUMENT,
+      /*is_document=*/false);
+  if (result.should_block) {
+    return ThrottleCheckResult(CANCEL, net::ERR_BLOCKED_BY_CLIENT);
+  }
+  return PROCEED;
+}
+
+}  // namespace aside_adblock
