+// ---- diagnostics -----------------------------------------------------------
+
+base::DictValue AsideAdBlockService::TestRule(const std::string& url_spec,
+                                                const std::string& initiator,
+                                                const std::string& request_type,
+                                                const std::string& method,
+                                                bool third_party) const {
+  base::DictValue out;
+  GURL url(url_spec);
+  out.Set("url", url_spec);
+  out.Set("requestType", request_type);
+  out.Set("method", method);
+  out.Set("thirdParty", third_party);
+  if (!url.is_valid()) {
+    out.Set("error", "Invalid URL");
+    return out;
+  }
+  url::Origin origin;
+  GURL initiator_url(initiator);
+  if (initiator_url.is_valid()) {
+    origin = url::Origin::Create(initiator_url);
+  } else if (!third_party) {
+    origin = url::Origin::Create(url);
+  }
+  bool is_document = false;
+  url_pattern_index::proto::ElementType type =
+      ElementTypeForName(request_type, &is_document);
+  MatchResult r;
+  if (engine_) {
+    r = engine_->Evaluate(url, origin, type, is_document);
+  }
+  out.Set("engineAvailable", engine_ != nullptr);
+  out.Set("enabled", enabled());
+  out.Set("shouldBlock", r.should_block);
+  out.Set("hasFilter", r.has_filter);
+  out.Set("hasException", r.has_exception);
+  out.Set("filter", r.filter);
+  out.Set("source", r.source);
+  out.Set("rewrittenUrl", r.rewritten_url);
+  out.Set("initiator", origin.Serialize());
+  return out;
+}
+
+base::DictValue AsideAdBlockService::State() const {
+  base::DictValue d;
+  d.Set("enabled", enabled());
+  d.Set("loaded", loaded_);
+  d.Set("compiling", compiling_);
+  d.Set("requestedGeneration", static_cast<double>(requested_generation_));
+  d.Set("activeGeneration", static_cast<double>(active_generation_));
+  d.Set("lastCompileDurationMs",
+        static_cast<double>(last_compile_duration_.InMilliseconds()));
+  d.Set("lastEngineInstallTime", ToJsTime(last_engine_install_time_));
+  d.Set("lastEngineInstallTimeMs", ToJsTime(last_engine_install_time_));
+  d.Set("lastCompileError", last_compile_error_);
+  d.Set("networkAvailable", true);
+  d.Set("dataDirectory", data_dir_.AsUTF8Unsafe());
+  d.Set("cacheDirectory", cache_dir_.AsUTF8Unsafe());
+  d.Set("manualFilterDirectory", manual_dir_.AsUTF8Unsafe());
+  d.Set("manualFilterError", manual_filter_error_);
+  d.Set("manualFilterCount", static_cast<int>(manual_files_.size()));
+
+  base::ListValue subs;
+  for (const Subscription& s : subscriptions_) {
+    subs.Append(SubscriptionToDict(s));
+  }
+  d.Set("subscriptions", std::move(subs));
+
+  base::DictValue custom;
+  custom.Set("rules", custom_rules_);
+  custom.Set("pendingRules", pending_custom_rules_);
+  custom.Set("networkRuleCount", custom_network_rule_count_);
+  custom.Set("cosmeticRuleCount", custom_cosmetic_rule_count_);
+  custom.Set("parseErrorCount", custom_parse_error_count_);
+  custom.Set("invalidLines", ToList(custom_invalid_lines_));
+  custom.Set("contentSize", static_cast<double>(custom_rules_.size()));
+  custom.Set("maxSize", static_cast<double>(kMaxCustomRulesBytes));
+  d.Set("custom", std::move(custom));
+
+  base::ListValue engines;
+  if (engine_) {
+    base::DictValue e;
+    e.Set("kind", "active");
+    e.Set("generation", static_cast<double>(active_generation_));
+    e.Set("flatbufferSize", static_cast<double>(engine_->flatbuffer_size()));
+    e.Set("cacheHit", last_cache_hit_);
+    e.Set("networkRuleCount", engine_->network_rule_count());
+    e.Set("cosmeticRuleCount", engine_->cosmetic_rule_count());
+    e.Set("parseErrorCount", engine_->parse_error_count());
+    e.Set("compiledRegexCount", 0);
+    e.Set("regexes", base::ListValue());
+    e.Set("regexesTruncated", false);
+    base::ListValue sources;
+    for (const SourceStats& stats : engine_->sources()) {
+      base::DictValue s;
+      s.Set("id", stats.id);
+      s.Set("title", stats.title);
+      s.Set("networkRuleCount", stats.network_rule_count);
+      s.Set("cosmeticRuleCount", stats.cosmetic_rule_count);
+      s.Set("parseErrorCount", stats.parse_error_count);
+      sources.Append(std::move(s));
+    }
+    e.Set("sources", std::move(sources));
+    engines.Append(std::move(e));
+  }
+  d.Set("engines", std::move(engines));
+  return d;
+}
+
+}  // namespace aside_adblock
