@@ -0,0 +1,149 @@
+<!-- Copyright 2026 At Your Side Inc. -->
+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Adblock Internals</title>
+    <link rel="stylesheet" href="chrome://theme/colors.css?sets=ui,chrome">
+    <link rel="stylesheet" href="adblock_internals.css">
+  </head>
+  <body>
+    <header class="page-header">
+      <div>
+        <h1>Adblock Internals</h1>
+        <p>Profile-scoped subscriptions, custom rules, and engine diagnostics.</p>
+      </div>
+      <label class="master-toggle">
+        <input id="adblock-enabled" type="checkbox" role="switch">
+        <span>Ad blocker enabled</span>
+      </label>
+    </header>
+
+    <main>
+      <section class="card overview-card">
+        <div class="section-heading">
+          <div>
+            <h2>Overview</h2>
+            <p>Current profile and active engine generation.</p>
+          </div>
+          <div class="actions">
+            <button id="refresh-button" type="button">Refresh</button>
+            <button id="export-button" type="button">Export debug dump</button>
+          </div>
+        </div>
+        <dl id="overview-grid" class="data-grid"></dl>
+        <p id="compile-error" class="error" hidden></p>
+        <p class="notice">Turning the ad blocker off stops new network and cosmetic decisions immediately. Subscription changes become active after the engine rebuild finishes. Reload open pages after completion to remove already injected cosmetic rules.</p>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Filter subscriptions</h2>
+            <p>HTTPS lists update conditionally with ETag and Last-Modified validators.</p>
+          </div>
+          <button id="update-all-button" type="button">Update all</button>
+        </div>
+        <form id="add-subscription-form" class="inline-form">
+          <label>
+            <span>Name</span>
+            <input id="subscription-name" maxlength="256" placeholder="EasyList">
+          </label>
+          <label class="url-field">
+            <span>HTTPS filter URL</span>
+            <input id="subscription-url" type="url" required placeholder="https://example.com/filter.txt">
+          </label>
+          <button type="submit">Add filter</button>
+        </form>
+        <div class="table-scroll">
+          <table>
+            <thead>
+              <tr>
+                <th>Enabled</th>
+                <th>Filter</th>
+                <th>Status</th>
+                <th>Rules</th>
+                <th>Updated</th>
+                <th>Next update</th>
+                <th>HTTP / content</th>
+                <th>Actions</th>
+              </tr>
+            </thead>
+            <tbody id="subscriptions-body"></tbody>
+          </table>
+        </div>
+        <p id="subscriptions-empty" class="empty-state">No URL subscriptions have been added to this profile.</p>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Custom rules</h2>
+            <p>ABP/uBlock-compatible rules stored only in this profile.</p>
+          </div>
+          <div id="custom-counts" class="count-summary"></div>
+        </div>
+        <textarea id="custom-rules" spellcheck="false" placeholder="||ads.example^&#10;example.com##.sponsored"></textarea>
+        <div class="editor-footer">
+          <span id="custom-size"></span>
+          <button id="save-custom-button" type="button">Validate and save</button>
+        </div>
+        <details id="custom-invalid-details" hidden>
+          <summary>Unsupported or invalid custom rule lines</summary>
+          <pre id="custom-invalid-lines"></pre>
+        </details>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Rule tester</h2>
+            <p>Tests the active profile engine and reports the matching raw rule and source line.</p>
+          </div>
+        </div>
+        <form id="rule-test-form" class="test-grid">
+          <label class="wide"><span>Request URL</span><input id="test-url" type="url" required placeholder="https://ads.example/banner.js"></label>
+          <label class="wide"><span>Initiator URL or hostname</span><input id="test-initiator" placeholder="https://publisher.example/"></label>
+          <label><span>Request type</span><select id="test-type"><option>script</option><option>image</option><option>stylesheet</option><option>xmlhttprequest</option><option>document</option><option>subdocument</option><option>websocket</option><option>other</option></select></label>
+          <label><span>Method</span><input id="test-method" value="GET"></label>
+          <label class="check-label"><input id="test-third-party" type="checkbox" checked><span>Third-party request</span></label>
+          <button type="submit">Test active rules</button>
+        </form>
+        <dl id="test-result" class="data-grid" hidden></dl>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Engine diagnostics</h2>
+            <p>Serialized size, source parse counts, unsupported or invalid lines, and bounded regex diagnostics.</p>
+          </div>
+        </div>
+        <div id="engine-diagnostics" class="engine-grid"></div>
+      </section>
+
+      <section class="card">
+        <div class="section-heading">
+          <div>
+            <h2>Maintenance</h2>
+            <p>Manual development filters and compiled DAT cache.</p>
+          </div>
+          <div class="actions">
+            <button id="reload-manual-button" type="button">Reload manual filters</button>
+            <button id="clear-cache-button" type="button">Clear engine cache</button>
+          </div>
+        </div>
+        <dl id="maintenance-grid" class="data-grid"></dl>
+      </section>
+    </main>
+
+    <footer id="adblock-rust-attribution" class="page-footer">
+      Powered by <a href="https://github.com/brave/adblock-rust/" target="_blank" rel="noreferrer">adblock-rust</a>
+      · Licensed under the <a href="https://www.mozilla.org/MPL/2.0/" target="_blank" rel="noreferrer">Mozilla Public License 2.0</a>.
+    </footer>
+
+    <div id="status-message" role="status" aria-live="polite"></div>
+    <script type="module" src="adblock_internals.js"></script>
+  </body>
+</html>
