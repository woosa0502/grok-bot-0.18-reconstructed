+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Interface of the original chrome://aside-adblock page (same module,
+// interface and method names, so the original's generated JS bindings match).
+module adblock_internals.mojom;
+
+interface AdblockInternalsPageHandler {
+  GetState() => (string state_json);
+  SetEnabled(bool enabled) => (string state_json, string error);
+  AddSubscription(string name, string url) => (string state_json, string error);
+  SetSubscriptionEnabled(string subscription_id, bool enabled)
+      => (string state_json, string error);
+  RemoveSubscription(string subscription_id)
+      => (string state_json, string error);
+  UpdateSubscription(string subscription_id)
+      => (string state_json, string error);
+  UpdateAllSubscriptions() => (string state_json, string error);
+  SaveCustomRules(string rules) => (string state_json, string error);
+  ReloadManualFilters() => (string state_json, string error);
+  ClearEngineCache() => (string state_json, string error);
+  TestRule(string url, string initiator, string request_type, string method,
+           bool third_party) => (string result_json, string error);
+};
