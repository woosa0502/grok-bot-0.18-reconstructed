+  gap: 10px;
+  grid-template-columns: repeat(4, minmax(130px, 1fr));
+}
+
+.test-grid .wide {
+  grid-column: span 2;
+}
+
+.test-grid .check-label span {
+  margin: 0;
+}
+
+.engine-grid {
+  display: grid;
+  gap: 14px;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  margin-top: 14px;
+}
+
+.engine-card {
+  background: var(--color-aside-surface-secondary);
+  border: 1px solid var(--color-aside-surface-border);
+  border-radius: 10px;
+  min-width: 0;
+  padding: 14px;
+}
+
+.engine-card table {
+  min-width: 0;
+}
+
+.empty-state {
+  margin: 18px 0 4px;
+  text-align: center;
+}
+
+#status-message {
+  background: var(--color-aside-tooltip-background);
+  border: 1px solid var(--color-aside-tooltip-border);
+  border-radius: 9px;
+  bottom: 20px;
+  color: var(--color-aside-tooltip-foreground);
+  max-width: 520px;
+  opacity: 0;
+  padding: 10px 14px;
+  pointer-events: none;
+  position: fixed;
+  right: 24px;
+  transform: translateY(8px);
+  transition: opacity 120ms ease, transform 120ms ease;
+}
+
+#status-message.visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+@media (max-width: 980px) {
+  .engine-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .test-grid {
+    grid-template-columns: repeat(2, minmax(160px, 1fr));
+  }
+}
diff --git a/chrome/browser/resources/aside_adblock/adblock_internals.html b/chrome/browser/resources/aside_adblock/adblock_internals.html
new file mode 100644
index 0000000000..6a5346673e
