diff --git a/chrome/browser/aside_adblock/aside_adblock_engine.cc b/chrome/browser/aside_adblock/aside_adblock_engine.cc
new file mode 100644
index 0000000000..215ea31d04
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_engine.cc
@@ -0,0 +1,431 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_engine.h"
+
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "components/subresource_filter/core/common/first_party_origin.h"
+#include "components/subresource_filter/core/common/indexed_ruleset.h"
+#include "components/subresource_filter/core/common/load_policy.h"
+#include "components/subresource_filter/tools/rule_parser/rule.h"
+#include "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#include "components/url_pattern_index/flat/url_pattern_index_generated.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+
+namespace aside_adblock {
+
+namespace {
+
+constexpr size_t kMaxInvalidLinesPerSource = 200;
+
+using url_pattern_index::proto::ElementType;
+
+// Options that only make sense for whole-document navigations. Rules carrying
+// them are indexed into the document rule set with the option rewritten to
+// "subdocument", which the parser understands.
+bool ExtractDocumentRule(std::string_view line, std::string* rewritten) {
+  size_t dollar = line.rfind('$');
+  if (dollar == std::string_view::npos || line.starts_with("@@")) {
+    return false;
+  }
+  std::string_view options = line.substr(dollar + 1);
+  std::vector<std::string> parts = base::SplitString(
+      options, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  bool has_document = false;
+  for (auto& part : parts) {
+    if (part == "document" || part == "doc") {
+      part = "subdocument";
+      has_document = true;
+    }
+  }
+  if (!has_document) {
+    return false;
+  }
+  *rewritten = std::string(line.substr(0, dollar + 1)) +
+               base::JoinString(parts, ",");
+  return true;
+}
+
+bool IsUnsupportedSelector(std::string_view selector) {
+  static constexpr std::string_view kUnsupported[] = {
+      ":-abp-", ":style(", ":remove(", ":matches-path(", ":upward(",
+      ":xpath(", ":has-text(", ":matches-css", ":min-text-length(",
+      ":watch-attr(", ":remove-attr(", ":remove-class(", ":others(",
+      ":matches-media(", ":matches-prop(", ":matches-attr(", ":if(",
+      ":if-not(", ":nth-ancestor(", ":shadow("};
+  for (std::string_view marker : kUnsupported) {
+    if (selector.find(marker) != std::string_view::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+ElementType ElementTypeForDestination(
+    network::mojom::RequestDestination destination) {
+  using D = network::mojom::RequestDestination;
+  switch (destination) {
+    case D::kScript:
+    case D::kServiceWorker:
+    case D::kSharedWorker:
+    case D::kWorker:
+    case D::kAudioWorklet:
+    case D::kPaintWorklet:
+    case D::kJson:
+    case D::kWebBundle:
+    case D::kSpeculationRules:
+      return ElementType::ELEMENT_TYPE_SCRIPT;
+    case D::kImage:
+      return ElementType::ELEMENT_TYPE_IMAGE;
+    case D::kStyle:
+    case D::kXslt:
+      return ElementType::ELEMENT_TYPE_STYLESHEET;
+    case D::kFont:
+      return ElementType::ELEMENT_TYPE_FONT;
+    case D::kAudio:
+    case D::kVideo:
+    case D::kTrack:
+      return ElementType::ELEMENT_TYPE_MEDIA;
+    case D::kObject:
+    case D::kEmbed:
+      return ElementType::ELEMENT_TYPE_OBJECT;
+    case D::kIframe:
+    case D::kFrame:
+    case D::kFencedframe:
+    case D::kDocument:
+      return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+    case D::kReport:
+      return ElementType::ELEMENT_TYPE_PING;
+    case D::kEmpty:
+      return ElementType::ELEMENT_TYPE_XMLHTTPREQUEST;
+    default:
+      return ElementType::ELEMENT_TYPE_OTHER;
+  }
+}
+
+ElementType ElementTypeForName(const std::string& name, bool* is_document) {
+  *is_document = false;
+  std::string n = base::ToLowerASCII(name);
+  if (n == "script") {
+    return ElementType::ELEMENT_TYPE_SCRIPT;
+  }
+  if (n == "image" || n == "img") {
+    return ElementType::ELEMENT_TYPE_IMAGE;
+  }
+  if (n == "stylesheet" || n == "css") {
+    return ElementType::ELEMENT_TYPE_STYLESHEET;
+  }
+  if (n == "font") {
+    return ElementType::ELEMENT_TYPE_FONT;
+  }
+  if (n == "media" || n == "audio" || n == "video") {
+    return ElementType::ELEMENT_TYPE_MEDIA;
+  }
+  if (n == "object") {
+    return ElementType::ELEMENT_TYPE_OBJECT;
+  }
+  if (n == "subdocument" || n == "sub_frame" || n == "frame" || n == "iframe") {
+    return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+  }
+  if (n == "document" || n == "main_frame") {
+    *is_document = true;
+    return ElementType::ELEMENT_TYPE_SUBDOCUMENT;
+  }
+  if (n == "xmlhttprequest" || n == "xhr" || n == "fetch") {
+    return ElementType::ELEMENT_TYPE_XMLHTTPREQUEST;
+  }
+  if (n == "websocket") {
+    return ElementType::ELEMENT_TYPE_WEBSOCKET;
+  }
+  if (n == "ping" || n == "beacon") {
+    return ElementType::ELEMENT_TYPE_PING;
+  }
+  return ElementType::ELEMENT_TYPE_OTHER;
+}
+
+Engine::Engine()
+    : indexer_(std::make_unique<subresource_filter::RulesetIndexer>(1)),
+      document_indexer_(
+          std::make_unique<subresource_filter::RulesetIndexer>(2)) {}
+
+Engine::~Engine() = default;
+
+// static
+scoped_refptr<Engine> Engine::Build(const std::vector<FilterSource>& sources) {
+  scoped_refptr<Engine> engine(new Engine());
+  for (const FilterSource& source : sources) {
+    engine->AddSource(source);
+  }
+  engine->Finish();
+  return engine;
+}
+
+void Engine::AddSource(const FilterSource& source) {
+  SourceStats stats;
+  stats.id = source.id;
+  stats.title = source.title;
+  std::string source_label =
+      source.id == "custom"
+          ? "custom"
+          : (source.id.starts_with("manual:") ? source.id
+                                              : "subscription:" + source.title);
+
+  subresource_filter::RuleParser parser;
+  size_t line_no = 0;
+  for (std::string_view raw : base::SplitStringPiece(
+           source.text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    ++line_no;
+    if (raw.empty() || raw[0] == '!' || raw[0] == '[') {
+      continue;
+    }
+    std::string line(raw);
+    std::string rewritten;
+    bool document_rule = ExtractDocumentRule(line, &rewritten);
+    url_pattern_index::proto::RuleType type =
+        parser.Parse(document_rule ? rewritten : line);
+    switch (type) {
+      case url_pattern_index::proto::RULE_TYPE_URL: {
+        url_pattern_index::proto::UrlRule proto =
+            parser.url_rule().ToProtobuf();
+        bool ok = document_rule ? document_indexer_->AddUrlRule(proto)
+                                : indexer_->AddUrlRule(proto);
+        if (ok) {
+          ++stats.network_rule_count;
+          rules_by_pattern_.emplace(
+              parser.url_rule().url_pattern,
+              RuleInfo{line, source_label});
+        } else {
+          ++stats.parse_error_count;
+          if (stats.invalid_lines.size() < kMaxInvalidLinesPerSource) {
+            stats.invalid_lines.push_back(
+                base::NumberToString(line_no) + ": " + line +
+                " (not indexable)");
+          }
+        }
+        break;
+      }
+      case url_pattern_index::proto::RULE_TYPE_STYLE: {
+        const subresource_filter::StyleRule& css = parser.style_rule();
+        if (IsUnsupportedSelector(css.selector)) {
+          ++stats.parse_error_count;
+          if (stats.invalid_lines.size() < kMaxInvalidLinesPerSource) {
+            stats.invalid_lines.push_back(base::NumberToString(line_no) +
+                                          ": " + line +
+                                          " (unsupported selector)");
+          }
+          break;
+        }
+        CosmeticRule rule;
+        rule.selector = css.selector;
+        rule.is_exception = css.is_allowlist;
+        for (const std::string& domain : css.domains) {
+          if (domain.starts_with("~")) {
+            rule.exclude.push_back(domain.substr(1));
+          } else {
+            rule.include.push_back(domain);
+          }
+        }
+        ++stats.cosmetic_rule_count;
+        if (!rule.is_exception && rule.include.empty() &&
+            rule.exclude.empty()) {
+          generic_selectors_.push_back(rule.selector);
+        } else {
+          conditional_rules_.push_back(std::move(rule));
+        }
+        break;
+      }
+      case url_pattern_index::proto::RULE_TYPE_COMMENT:
+        break;
+      default: {
+        ++stats.parse_error_count;
+        if (stats.invalid_lines.size() < kMaxInvalidLinesPerSource) {
+          const auto& err = parser.parse_error();
+          std::string why;
+          switch (err.error_code) {
+            case subresource_filter::RuleParser::ParseError::UNKNOWN_OPTION:
+              why = "unknown option";
+              break;
+            case subresource_filter::RuleParser::ParseError::
+                UNSUPPORTED_FEATURE:
+              why = "unsupported feature";
+              break;
+            case subresource_filter::RuleParser::ParseError::
+                EMPTY_CSS_SELECTOR:
+              why = "empty selector";
+              break;
+            case subresource_filter::RuleParser::ParseError::
+                DEPRECATED_OPTION:
+              why = "deprecated option";
+              break;
+            default:
+              why = "parse error";
+          }
+          stats.invalid_lines.push_back(base::NumberToString(line_no) + ": " +
+                                        line + " (" + why + ")");
+        }
+        break;
+      }
+    }
+  }
+  network_rule_count_ += stats.network_rule_count;
+  cosmetic_rule_count_ += stats.cosmetic_rule_count;
+  parse_error_count_ += stats.parse_error_count;
+  sources_.push_back(std::move(stats));
+}
+
+void Engine::Finish() {
+  indexer_->Finish();
+  document_indexer_->Finish();
+  flatbuffer_size_ = indexer_->data().size() + document_indexer_->data().size();
+  matcher_ = std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+      indexer_->data());
+  document_matcher_ =
+      std::make_unique<subresource_filter::IndexedRulesetMatcher>(
+          document_indexer_->data());
+
+  // Exceptions without domains remove generic selectors outright.
+  base::flat_set<std::string> generic_exceptions;
+  for (const CosmeticRule& rule : conditional_rules_) {
+    if (rule.is_exception && rule.include.empty() && rule.exclude.empty()) {
+      generic_exceptions.insert(rule.selector);
+    }
+  }
+  if (!generic_exceptions.empty()) {
+    std::erase_if(generic_selectors_, [&](const std::string& s) {
+      return generic_exceptions.contains(s);
+    });
+  }
+  if (!generic_selectors_.empty()) {
+    generic_stylesheet_ =
+        base::JoinString(generic_selectors_, ",\n") + "{display:none!important;}\n";
+  }
+}
+
+const Engine::RuleInfo* Engine::FindRuleInfo(
+    const std::string& url_pattern) const {
+  auto it = rules_by_pattern_.find(url_pattern);
+  return it == rules_by_pattern_.end() ? nullptr : &it->second;
+}
+
+MatchResult Engine::Evaluate(const GURL& url,
+                             const url::Origin& initiator,
+                             ElementType element_type,
+                             bool is_document) const {
+  MatchResult result;
+  const subresource_filter::IndexedRulesetMatcher* matcher =
+      is_document ? document_matcher_.get() : matcher_.get();
+  if (!matcher || !url.is_valid()) {
+    return result;
+  }
+  subresource_filter::FirstPartyOrigin first_party(initiator);
+  const url_pattern_index::flat::UrlRule* rule = nullptr;
+  subresource_filter::LoadPolicy policy =
+      matcher->GetLoadPolicyForResourceLoad(url, first_party, element_type,
+                                            /*disable_generic_rules=*/false,
+                                            &rule);
+  if (rule) {
+    std::string pattern = rule->url_pattern() ? rule->url_pattern()->str() : "";
+    if (const RuleInfo* info = FindRuleInfo(pattern)) {
+      result.filter = info->text;
+      result.source = info->source;
+    } else {
+      result.filter = pattern;
+    }
+  }
+  switch (policy) {
+    case subresource_filter::LoadPolicy::DISALLOW:
+      result.should_block = true;
+      result.has_filter = true;
+      break;
+    case subresource_filter::LoadPolicy::EXPLICITLY_ALLOW:
+      result.has_exception = true;
+      result.has_filter = rule != nullptr;
+      break;
+    default:
+      break;
+  }
+  return result;
+}
+
+// static
+bool Engine::DomainMatches(const std::string& host, const std::string& domain) {
+  if (host == domain) {
+    return true;
+  }
+  return host.size() > domain.size() &&
+         host.ends_with(domain) &&
+         host[host.size() - domain.size() - 1] == '.';
+}
+
+std::string Engine::HidingStylesheet(const GURL& url) const {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  const std::string host(url.host());
+  std::vector<std::string> selectors;
+  base::flat_set<std::string> exceptions;
+  for (const CosmeticRule& rule : conditional_rules_) {
+    bool included = rule.include.empty();
+    for (const std::string& d : rule.include) {
+      if (DomainMatches(host, d)) {
+        included = true;
+        break;
+      }
+    }
+    if (!included) {
+      continue;
+    }
+    bool excluded = false;
+    for (const std::string& d : rule.exclude) {
+      if (DomainMatches(host, d)) {
+        excluded = true;
+        break;
+      }
+    }
+    if (excluded) {
+      continue;
+    }
+    if (rule.is_exception) {
+      exceptions.insert(rule.selector);
+    } else {
+      selectors.push_back(rule.selector);
+    }
+  }
+  std::string css;
+  if (!generic_stylesheet_.empty()) {
+    if (exceptions.empty()) {
+      css = generic_stylesheet_;
+    } else {
+      std::vector<std::string> generic;
+      for (const std::string& s : generic_selectors_) {
+        if (!exceptions.contains(s)) {
+          generic.push_back(s);
+        }
+      }
+      if (!generic.empty()) {
+        css = base::JoinString(generic, ",\n") + "{display:none!important;}\n";
+      }
+    }
+  }
+  if (!selectors.empty()) {
+    std::vector<std::string> kept;
+    for (const std::string& s : selectors) {
+      if (!exceptions.contains(s)) {
+        kept.push_back(s);
+      }
+    }
+    if (!kept.empty()) {
+      css += base::JoinString(kept, ",\n") + "{display:none!important;}\n";
+    }
+  }
+  return css;
+}
+
+}  // namespace aside_adblock
diff --git a/chrome/browser/aside_adblock/aside_adblock_engine.h b/chrome/browser/aside_adblock/aside_adblock_engine.h
new file mode 100644
index 0000000000..1c78f44907
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_engine.h
@@ -0,0 +1,135 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Aside ad-block engine (replica of the adblock-rust based engine of the
+// original components/aside_adblock). Filter lists in EasyList syntax are
+// parsed with //components/subresource_filter's rule parser and indexed with
+// //components/url_pattern_index; element hiding rules are kept as plain
+// selector tables. An Engine is immutable once built and can be shared across
+// threads.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/memory/ref_counted.h"
+#include "components/url_pattern_index/proto/rules.pb.h"
+#include "services/network/public/mojom/fetch_api.mojom-forward.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace subresource_filter {
+class IndexedRulesetMatcher;
+class RulesetIndexer;
+}  // namespace subresource_filter
+
+namespace aside_adblock {
+
+struct FilterSource {
+  std::string id;     // subscription id, "custom" or "manual:<file>"
+  std::string title;  // human readable title
+  std::string text;   // filter list text (UTF-8)
+};
+
+struct SourceStats {
+  std::string id;
+  std::string title;
+  int network_rule_count = 0;
+  int cosmetic_rule_count = 0;
+  int parse_error_count = 0;
+  std::vector<std::string> invalid_lines;  // "<line>: <error>", capped
+};
+
+struct MatchResult {
+  bool should_block = false;
+  bool has_filter = false;     // a blocking filter matched
+  bool has_exception = false;  // an exception (@@) filter matched
+  std::string filter;          // matched filter text (best effort)
+  std::string source;          // "subscription:<name>" / "custom" / "manual:<f>"
+  std::string rewritten_url;   // always empty (redirect rules unsupported)
+};
+
+// Maps a fetch destination to the EasyList resource type used for matching.
+url_pattern_index::proto::ElementType ElementTypeForDestination(
+    network::mojom::RequestDestination destination);
+
+// Parses a request type name as used by the internals page / TestRule
+// ("script", "image", "stylesheet", "subdocument", "document", "xmlhttprequest",
+// "font", "media", "websocket", "ping", "object", "other").
+url_pattern_index::proto::ElementType ElementTypeForName(
+    const std::string& name,
+    bool* is_document);
+
+class Engine : public base::RefCountedThreadSafe<Engine> {
+ public:
+  // Builds an engine from |sources|. Safe to call on a worker thread.
+  static scoped_refptr<Engine> Build(const std::vector<FilterSource>& sources);
+
+  Engine(const Engine&) = delete;
+  Engine& operator=(const Engine&) = delete;
+
+  // Network filtering. |is_document| selects the top-level document rule set
+  // ($document filters) instead of the sub-resource rule set.
+  MatchResult Evaluate(const GURL& url,
+                       const url::Origin& initiator,
+                       url_pattern_index::proto::ElementType element_type,
+                       bool is_document) const;
+
+  // Element hiding: CSS text ("sel1,sel2{display:none!important}") for the
+  // document at |url|, or empty when nothing applies.
+  std::string HidingStylesheet(const GURL& url) const;
+
+  const std::vector<SourceStats>& sources() const { return sources_; }
+  size_t flatbuffer_size() const { return flatbuffer_size_; }
+  int network_rule_count() const { return network_rule_count_; }
+  int cosmetic_rule_count() const { return cosmetic_rule_count_; }
+  int parse_error_count() const { return parse_error_count_; }
+
+ private:
+  friend class base::RefCountedThreadSafe<Engine>;
+  struct RuleInfo {
+    std::string text;
+    std::string source;
+  };
+  struct CosmeticRule {
+    std::string selector;
+    std::vector<std::string> include;
+    std::vector<std::string> exclude;
+    bool is_exception = false;
+  };
+
+  Engine();
+  ~Engine();
+
+  void AddSource(const FilterSource& source);
+  void Finish();
+  const RuleInfo* FindRuleInfo(const std::string& url_pattern) const;
+  static bool DomainMatches(const std::string& host, const std::string& domain);
+
+  std::unique_ptr<subresource_filter::RulesetIndexer> indexer_;
+  std::unique_ptr<subresource_filter::RulesetIndexer> document_indexer_;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> matcher_;
+  std::unique_ptr<subresource_filter::IndexedRulesetMatcher> document_matcher_;
+  std::unordered_multimap<std::string, RuleInfo> rules_by_pattern_;
+
+  std::vector<std::string> generic_selectors_;  // no include, no exclude
+  std::vector<CosmeticRule> conditional_rules_;  // has include or exclude
+  std::string generic_stylesheet_;
+
+  std::vector<SourceStats> sources_;
+  size_t flatbuffer_size_ = 0;
+  int network_rule_count_ = 0;
+  int cosmetic_rule_count_ = 0;
+  int parse_error_count_ = 0;
+};
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_ENGINE_H_
