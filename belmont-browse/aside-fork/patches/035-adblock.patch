+std::string AsideAdBlockService::SetEnabled(bool enabled) {
+  profile_->GetPrefs()->SetBoolean(kEnabledPref, enabled);
+  return std::string();
+}
+
+std::string AsideAdBlockService::AddSubscription(const std::string& name,
+                                                 const std::string& url) {
+  if (subscriptions_.size() >= kMaxSubscriptions) {
+    return "At most " + base::NumberToString(kMaxSubscriptions) +
+           " subscriptions are supported.";
+  }
+  std::string trimmed_url;
+  base::TrimWhitespaceASCII(url, base::TRIM_ALL, &trimmed_url);
+  std::string error = ValidateSubscriptionUrl(trimmed_url);
+  if (!error.empty()) {
+    return error;
+  }
+  for (const Subscription& s : subscriptions_) {
+    if (s.url == trimmed_url) {
+      return "This subscription URL is already present.";
+    }
+  }
+  Subscription s;
+  s.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::TrimWhitespaceASCII(name, base::TRIM_ALL, &s.name);
+  if (s.name.empty()) {
+    s.name = GURL(trimmed_url).host();
+  }
+  s.url = trimmed_url;
+  s.status = "idle";
+  subscriptions_.push_back(std::move(s));
+  PersistMetadata();
+  StartDownload(subscriptions_.back().id);
+  return std::string();
+}
+
+std::string AsideAdBlockService::SetSubscriptionEnabled(const std::string& id,
+                                                        bool enabled) {
+  Subscription* s = FindSubscription(id);
+  if (!s) {
+    return "Unknown subscription.";
+  }
+  if (s->enabled == enabled) {
+    return std::string();
+  }
+  s->enabled = enabled;
+  PersistMetadata();
+  RequestCompile();
+  if (enabled && s->text.empty()) {
+    StartDownload(id);
+  }
+  return std::string();
+}
+
+std::string AsideAdBlockService::RemoveSubscription(const std::string& id) {
+  auto it = std::find_if(subscriptions_.begin(), subscriptions_.end(),
+                         [&](const Subscription& s) { return s.id == id; });
+  if (it == subscriptions_.end()) {
+    return "Unknown subscription.";
+  }
+  loaders_.erase(id);
+  subscriptions_.erase(it);
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(base::IgnoreResult(&base::DeleteFile),
+                     subscriptions_dir_.AppendASCII(id + ".txt")));
+  PersistMetadata();
+  RequestCompile();
+  return std::string();
+}
+
+std::string AsideAdBlockService::UpdateSubscription(const std::string& id) {
+  if (!FindSubscription(id)) {
+    return "Unknown subscription.";
+  }
+  StartDownload(id);
+  return std::string();
+}
+
+std::string AsideAdBlockService::UpdateAllSubscriptions() {
+  for (const Subscription& s : subscriptions_) {
+    if (s.enabled) {
+      StartDownload(s.id);
+    }
+  }
+  return std::string();
+}
+
+void AsideAdBlockService::StartDownload(const std::string& id) {
+  Subscription* s = FindSubscription(id);
+  if (!s || loaders_.contains(id)) {
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(s->url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->method = net::HttpRequestHeaders::kGetMethod;
+  if (!s->etag.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kIfNoneMatch, s->etag);
+  }
+  if (!s->last_modified_header.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kIfModifiedSince,
+                               s->last_modified_header);
+  }
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kTrafficAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(base::Minutes(2));
+  network::SimpleURLLoader* raw = loader.get();
+  loaders_[id] = std::move(loader);
+  s->status = "updating";
+  raw->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&AsideAdBlockService::OnDownloadComplete,
+                     weak_factory_.GetWeakPtr(), id),
+      kMaxSubscriptionBytes);
+}
+
+void AsideAdBlockService::OnDownloadComplete(const std::string& id,
+                                             std::optional<std::string> body) {
+  auto loader_it = loaders_.find(id);
+  if (loader_it == loaders_.end()) {
+    return;
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader = std::move(loader_it->second);
+  loaders_.erase(loader_it);
+  Subscription* s = FindSubscription(id);
+  if (!s) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  s->next_update = now + kUpdateInterval;
+
+  int status = 0;
+  const network::mojom::URLResponseHead* head = loader->ResponseInfo();
+  if (head && head->headers) {
+    status = head->headers->response_code();
+  }
+  auto fail = [&](const std::string& why) {
+    s->status = "error";
+    s->last_error = why;
+    PersistMetadata();
+  };
+  if (loader->NetError() != net::OK && loader->NetError() != net::ERR_FAILED) {
+    fail(std::string("Network error: ") + net::ErrorToShortString(loader->NetError()));
+    return;
+  }
+  if (status == 304) {
+    s->status = "ready";
+    s->last_error.clear();
+    s->last_successful_check = now;
+    PersistMetadata();
+    return;
+  }
+  if (status != 200 || !body) {
+    fail("HTTP status " + base::NumberToString(status));
+    return;
+  }
+  if (body->empty()) {
+    fail("Empty response");
+    return;
+  }
+  if (!base::IsStringUTF8(*body) ||
+      body->find('\0') != std::string::npos) {
+    fail("Response is not valid UTF-8 text");
+    return;
+  }
+  if (head && head->headers) {
+    s->etag = head->headers->GetNormalizedHeader("ETag").value_or("");
+    s->last_modified_header =
+        head->headers->GetNormalizedHeader("Last-Modified").value_or("");
+  }
+  s->status = "ready";
+  s->last_error.clear();
+  s->last_successful_check = now;
+  const std::string digest = Sha256Hex(*body);
+  if (digest != s->digest) {
+    s->digest = digest;
+    s->text = std::move(*body);
+    s->content_size = static_cast<int64_t>(s->text.size());
+    s->last_content_change = now;
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&WriteTextOnWorker,
+                       subscriptions_dir_.AppendASCII(id + ".txt"), s->text));
+    if (s->enabled) {
+      RequestCompile();
+    }
+  }
+  PersistMetadata();
+}
+
+void AsideAdBlockService::OnAutomaticUpdateTick() {
+  if (!loaded_) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  for (const Subscription& s : subscriptions_) {
+    if (s.enabled && s.next_update <= now) {
+      StartDownload(s.id);
+    }
+  }
+}
