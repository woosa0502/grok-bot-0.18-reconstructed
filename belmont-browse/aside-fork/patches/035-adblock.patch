+}
+
+AsideAdBlockService::AsideAdBlockService(Profile* profile)
+    : profile_(profile) {
+  data_dir_ = profile->GetPath().AppendASCII("AsideAdBlock");
+  subscriptions_dir_ = data_dir_.AppendASCII("Subscriptions");
+  custom_rules_path_ = data_dir_.AppendASCII("Custom").AppendASCII("rules.txt");
+  manual_dir_ = data_dir_.AppendASCII("Manual");
+  cache_dir_ = data_dir_.AppendASCII("Cache");
+  LoadFromDisk();
+  update_timer_.Start(FROM_HERE, kUpdateTick, this,
+                      &AsideAdBlockService::OnAutomaticUpdateTick);
+}
+
+AsideAdBlockService::~AsideAdBlockService() = default;
+
+bool AsideAdBlockService::enabled() const {
+  return profile_->GetPrefs()->GetBoolean(kEnabledPref);
+}
+
+MatchResult AsideAdBlockService::Evaluate(
+    const GURL& url,
+    const url::Origin& initiator,
+    url_pattern_index::proto::ElementType element_type,
+    bool is_document) const {
+  if (!engine_ || !enabled()) {
+    return MatchResult();
+  }
+  return engine_->Evaluate(url, initiator, element_type, is_document);
+}
