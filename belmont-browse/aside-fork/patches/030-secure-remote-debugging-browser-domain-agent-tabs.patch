+bool DevToolsHttpHandler::IsAuthorized(
+    const net::HttpServerRequestInfo& info) const {
+  if (mode_ != DevToolsAgentHost::RemoteDebuggingServerMode::kSecure) {
+    return true;
+  }
+  auto it = info.headers.find("authorization");
+  if (it == info.headers.end()) {
+    return false;
+  }
+  const std::string prefix = std::string(kSecureSessionTokenType) + " ";
+  std::string_view value = it->second;
+  if (!base::StartsWith(value, prefix, base::CompareCase::SENSITIVE)) {
+    return false;
+  }
+  auto token = secure_session_tokens_.find(std::string(value.substr(prefix.size())));
+  return token != secure_session_tokens_.end() &&
+         base::TimeTicks::Now() <= token->second;
+}
+
+void DevToolsHttpHandler::PruneSecureState() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  std::erase_if(secure_challenges_,
+                [now](const auto& entry) { return now > entry.second.expires; });
+  std::erase_if(secure_session_tokens_,
+                [now](const auto& entry) { return now > entry.second; });
+}
+
+void DevToolsHttpHandler::OnSecureChallengeRequest(int connection_id) {
+  PruneSecureState();
+  const std::string challenge_id =
+      base::Base64Encode(crypto::RandBytesAsVector(16));
+  PendingChallenge pending;
+  pending.bytes = crypto::RandBytesAsVector(32);
+  pending.expires = base::TimeTicks::Now() + kSecureChallengeTtl;
+  const std::string challenge = base::Base64Encode(pending.bytes);
+  secure_challenges_[challenge_id] = std::move(pending);
+
+  base::DictValue response;
+  response.Set("headerName", "Authorization");
+  response.Set("scheme", kSecureChallengeScheme);
+  response.Set("challengeId", challenge_id);
+  response.Set("challenge", challenge);
+  response.Set("expiresInSeconds",
+               static_cast<int>(kSecureChallengeTtl.InSeconds()));
+  SendJson(connection_id, net::HTTP_OK, response, "");
+}
+
+void DevToolsHttpHandler::OnSecureSessionRequest(
+    int connection_id,
+    const net::HttpServerRequestInfo& info) {
+  if (!base::EqualsCaseInsensitiveASCII(info.method,
+                                        net::HttpRequestHeaders::kPostMethod)) {
+    SendJson(connection_id, net::HTTP_METHOD_NOT_ALLOWED, std::nullopt,
+             "Using unsafe HTTP verb to invoke /json/auth/session. This "
+             "action supports only POST verb.");
+    return;
+  }
+  std::optional<base::Value> body =
+      base::JSONReader::Read(info.data, base::JSON_PARSE_RFC);
+  if (!body || !body->is_dict()) {
+    SendJson(connection_id, net::HTTP_BAD_REQUEST, std::nullopt,
+             "Malformed request body.");
+    return;
+  }
+  const std::string* challenge_id = body->GetDict().FindString("challengeId");
+  const std::string* signed_challenge =
+      body->GetDict().FindString("signedChallenge");
+  if (!challenge_id || !signed_challenge) {
+    SendJson(connection_id, net::HTTP_BAD_REQUEST, std::nullopt,
+             "Missing challengeId or signedChallenge.");
+    return;
+  }
+  PruneSecureState();
+  auto it = secure_challenges_.find(*challenge_id);
+  if (it == secure_challenges_.end()) {
+    SendJson(connection_id, net::HTTP_FORBIDDEN, std::nullopt,
+             "Invalid or expired challenge.");
+    return;
+  }
+  PendingChallenge pending = std::move(it->second);
+  secure_challenges_.erase(it);
+  std::string signature_bytes;
+  if (!base::Base64Decode(*signed_challenge, &signature_bytes) || !delegate_ ||
+      !delegate_->VerifySecureRemoteDebuggingSignature(
+          pending.bytes, base::as_byte_span(signature_bytes))) {
+    SendJson(connection_id, net::HTTP_FORBIDDEN, std::nullopt,
+             "Invalid or expired challenge.");
+    return;
+  }
+  const std::string token = base::Base64Encode(crypto::RandBytesAsVector(32));
+  secure_session_tokens_[token] = base::TimeTicks::Now() + kSecureSessionTtl;
+
+  base::DictValue response;
+  response.Set("headerName", "Authorization");
+  response.Set("token_type", kSecureSessionTokenType);
+  response.Set("scheme", kSecureSessionTokenType);
+  response.Set("access_token", token);
+  response.Set("expiresInSeconds",
+               static_cast<int>(kSecureSessionTtl.InSeconds()));
+  SendJson(connection_id, net::HTTP_OK, response, "");
+}
