+
+  void LoadFromDisk();
+  void OnLoaded(std::unique_ptr<LoadedState> state);
+  void PersistMetadata();
+  void RequestCompile();
+  void StartCompile();
+  struct CompileOutcome {
+    CompileOutcome();
+    CompileOutcome(CompileOutcome&&);
+    ~CompileOutcome();
+    scoped_refptr<Engine> engine;
+    bool cache_hit = false;
+    std::string error;
