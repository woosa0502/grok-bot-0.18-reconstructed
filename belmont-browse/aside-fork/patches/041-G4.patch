+ExtensionFunction::ResponseAction AsideOmniboxSetPopupSelectionFunction::Run() {
+  std::optional<api::aside_omnibox::SetPopupSelection::Params> params =
+      api::aside_omnibox::SetPopupSelection::Params::Create(args());
+  if (!params) {
