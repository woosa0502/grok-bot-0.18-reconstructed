+    state.mutationObserver = new MutationObserver((mutations) => {
+      for (const mutation of mutations) {
+        if (mutation.type === 'attributes') collect(mutation.target);
+        for (const node of mutation.addedNodes || []) collectTree(node);
+      }
+      scheduleProcedural();
+    });
+    state.mutationObserver.observe(D.documentElement, {
+      subtree: true, childList: true, attributes: true,
+      attributeFilter: ['id', 'class']
+    });
+    return true;
+  }
+
+  if (!observeDocumentElement()) {
+    state.documentObserver = new MutationObserver(() => {
+      if (!observeDocumentElement()) return;
+      state.documentObserver?.disconnect();
+      state.documentObserver = null;
+      scheduleProcedural();
+    });
+    state.documentObserver.observe(D, {subtree: true, childList: true});
+  }
+
+  W.addEventListener('pagehide', state.suspend);
+  W.addEventListener('pageshow', (event) => {
+    if (event.persisted) state.resume();
+  });
+
+  addHideSelectors(payload.hideSelectors || []);
+  addProceduralActions(payload.proceduralActions || []);
+})($1);
+)ASIDEJS";
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_COSMETIC_SCRIPT_H_
diff --git a/chrome/renderer/aside_adblock/aside_adblock_render_frame_observer.cc b/chrome/renderer/aside_adblock/aside_adblock_render_frame_observer.cc
new file mode 100644
index 0000000000..a0d25041ff
--- /dev/null
+++ b/chrome/renderer/aside_adblock/aside_adblock_render_frame_observer.cc
@@ -0,0 +1,343 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/renderer/aside_adblock/aside_adblock_render_frame_observer.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "chrome/renderer/aside_adblock/aside_adblock_cosmetic_script.h"
+#include "content/public/renderer/render_frame.h"
+#include "gin/converter.h"
+#include "gin/function_template.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/scheduler/web_agent_group_scheduler.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document_loader.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+#include "url/gurl.h"
+#include "v8/include/v8-context.h"
+#include "v8/include/v8-function.h"
+#include "v8/include/v8-isolate.h"
+#include "v8/include/v8-local-handle.h"
+#include "v8/include/v8-primitive.h"
+#include "v8/include/v8-value.h"
+
+namespace aside_adblock {
+
+namespace {
+
+constexpr base::TimeDelta kPollInterval = base::Milliseconds(300);
+
+constexpr char kScheduleProcedural[] =
+    "globalThis.__asideAdBlock?.scheduleProcedural();";
+constexpr char kTakePending[] =
+    "globalThis.__asideAdBlock?.takePending() || '';";
+constexpr char kAddHideSelectors[] =
+    "globalThis.__asideAdBlock?.addHideSelectors(";
+
+}  // namespace
+
+AsideAdBlockRenderFrameObserver::AsideAdBlockRenderFrameObserver(
+    content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame),
+      content::RenderFrameObserverTracker<AsideAdBlockRenderFrameObserver>(
+          render_frame) {}
+
+AsideAdBlockRenderFrameObserver::~AsideAdBlockRenderFrameObserver() = default;
+
+mojom::CosmeticFilterHost* AsideAdBlockRenderFrameObserver::host() {
+  if (!host_) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        host_.BindNewPipeAndPassReceiver());
+    host_.set_disconnect_handler(base::BindOnce(
+        &AsideAdBlockRenderFrameObserver::OnHostDisconnected,
+        weak_factory_.GetWeakPtr()));
+  }
+  return host_.get();
+}
+
+void AsideAdBlockRenderFrameObserver::ReadyToCommitNavigation(
+    blink::WebDocumentLoader* document_loader) {
+  poll_timer_.Stop();
+  readiness_retry_timer_.Stop();
+  readiness_budget_.Reset();
+  requested_url_ = GURL();
+  payload_.clear();
+  payload_ready_ = false;
+  document_created_ = false;
+  scripts_allowed_ = false;
+  applied_ = false;
+  ++request_id_;
+  if (host_) {
+    host_->CancelPendingCosmeticResources();
+  }
+  const GURL url(document_loader->GetUrl());
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  requested_url_ = url;
+  RequestCosmeticResources(request_id_);
+}
+
+void AsideAdBlockRenderFrameObserver::RequestCosmeticResources(uint64_t request_id) {
+  if (request_id != request_id_ || !requested_url_.SchemeIsHTTPOrHTTPS() ||
+      applied_ || !readiness_budget_.TryStart()) {
+    return;
+  }
+  host()->GetCosmeticResources(
+      requested_url_,
+      base::BindOnce(&AsideAdBlockRenderFrameObserver::OnCosmeticResources,
+                     weak_factory_.GetWeakPtr(), request_id));
+}
+
+void AsideAdBlockRenderFrameObserver::OnHostDisconnected() {
+  host_.reset();
+  if (!applied_) {
+    OnCosmeticResources(request_id_, false, std::string());
+  }
+}
+
+void AsideAdBlockRenderFrameObserver::OnCosmeticResources(
+    uint64_t request_id,
+    bool settled,
+    const std::string& payload_json) {
+  if (request_id != request_id_) {
+    return;
+  }
+  if (!settled) {
+    // A 30-second host wait can expire while a valid initial download (up to
+    // two minutes) is still running. Retry within the per-document budget,
+    // never mark this response applied/ready and never retry disabled results.
+    if (readiness_budget_.CanRetry() && !readiness_retry_timer_.IsRunning()) {
+      readiness_retry_timer_.Start(
+          FROM_HERE, base::Seconds(1),
+          base::BindOnce(&AsideAdBlockRenderFrameObserver::RequestCosmeticResources,
+                         weak_factory_.GetWeakPtr(), request_id));
+    }
+    return;
+  }
+  readiness_retry_timer_.Stop();
+  payload_ = payload_json;
+  payload_ready_ = true;
+  VLOG(1) << "AsideAdBlock renderer: resources arrived (" << payload_.size()
+          << " bytes) document_created=" << document_created_
+          << " scripts_allowed=" << scripts_allowed_;
+  MaybeApplyCosmeticResources();
+}
+
+void AsideAdBlockRenderFrameObserver::DidCreateScriptContext(
+    v8::Local<v8::Context> context,
+    int32_t world_id) {
+  if (!render_frame() || world_id != ISOLATED_WORLD_ID_CHROME_INTERNAL ||
+      context.IsEmpty()) {
+    return;
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+  v8::Isolate* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Context::Scope context_scope(context);
+  // This function exists only in Chromium's isolated world. The page cannot
+  // call it, and WeakPtr plus the navigation id reject stale document calls.
+  context->Global()
+      ->Set(context, gin::StringToSymbol(isolate, "__asideAdBlockPending"),
+            gin::CreateFunctionTemplate(
+                isolate,
+                base::BindRepeating(
+                    &AsideAdBlockRenderFrameObserver::SchedulePending,
+                    weak_factory_.GetWeakPtr(), request_id_))
+                ->GetFunction(context)
+                .ToLocalChecked())
+      .Check();
+}
+
+void AsideAdBlockRenderFrameObserver::DidCreateDocumentElement() {
+  document_created_ = true;
+  VLOG(1) << "AsideAdBlock renderer: document element, payload_ready="
+          << payload_ready_;
+  // No injection here on purpose: Blink drops script execution requested from
+  // inside this callback -- the call returns without an exception and without
+  // running anything, which silently loses every document whose resources
+  // arrived before its document element. RunScriptsAtDocumentStart is the
+  // point Chromium itself uses for document-start injection.
+  MaybeApplyCosmeticResources();
+}
+
+void AsideAdBlockRenderFrameObserver::RunScriptsAtDocumentStart() {
+  scripts_allowed_ = true;
+  MaybeApplyCosmeticResources();
+}
+
+void AsideAdBlockRenderFrameObserver::MaybeApplyCosmeticResources() {
+  if (applied_ || !payload_ready_ || !document_created_ || !scripts_allowed_) {
+    return;
+  }
+  ApplyCosmeticResources();
+}
+
+void AsideAdBlockRenderFrameObserver::ApplyCosmeticResources() {
+  applied_ = true;
+  if (payload_.empty()) {
+    return;  // ad blocking off for this profile / document
+  }
+  std::string script(kCosmeticScript);
+  const size_t placeholder = script.rfind("($1);");
+  if (placeholder == std::string::npos) {
+    return;
+  }
+  script.replace(placeholder, 5, "(" + payload_ + ");");
+  VLOG(1) << "AsideAdBlock renderer: inject script (" << script.size()
+          << " bytes)";
+  Execute(script);
+  SchedulePending(request_id_);
+}
+
+void AsideAdBlockRenderFrameObserver::SchedulePending(uint64_t request_id) {
+  if (request_id != request_id_ || !applied_ || !render_frame()) {
+    return;
+  }
+  if (!poll_timer_.IsRunning()) {
+    poll_timer_.Start(FROM_HERE, kPollInterval,
+                     base::BindOnce(
+                         &AsideAdBlockRenderFrameObserver::PollPending,
+                         weak_factory_.GetWeakPtr()));
+  }
+}
+
+void AsideAdBlockRenderFrameObserver::PollPending() {
+  if (!applied_ || !render_frame()) {
+    poll_timer_.Stop();
+    return;
+  }
+  const std::string pending = ExecuteAndReturnString(kTakePending);
+  if (pending.empty()) {
+    return;
+  }
+  VLOG(2) << "AsideAdBlock renderer: pending " << pending.size() << " bytes";
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(pending, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  std::vector<std::string> classes;
+  std::vector<std::string> ids;
+  if (const base::ListValue* list = parsed->GetDict().FindList("classes")) {
+    for (const base::Value& v : *list) {
+      if (v.is_string()) {
+        classes.push_back(v.GetString());
+      }
+    }
+  }
+  if (const base::ListValue* list = parsed->GetDict().FindList("ids")) {
+    for (const base::Value& v : *list) {
+      if (v.is_string()) {
+        ids.push_back(v.GetString());
+      }
+    }
+  }
+  if (classes.empty() && ids.empty()) {
+    return;
+  }
+  host()->GetHiddenSelectors(
+      classes, ids,
+      base::BindOnce(&AsideAdBlockRenderFrameObserver::OnHiddenSelectors,
+                     weak_factory_.GetWeakPtr(), request_id_));
+}
+
+void AsideAdBlockRenderFrameObserver::OnHiddenSelectors(
+    uint64_t request_id,
+    const std::vector<std::string>& selectors) {
+  if (request_id != request_id_ || selectors.empty() || !applied_ ||
+      !render_frame()) {
+    return;
+  }
+  base::ListValue list;
+  for (const std::string& s : selectors) {
+    list.Append(s);
+  }
+  std::string json;
+  base::JSONWriter::Write(list, &json);
+  Execute(std::string(kAddHideSelectors) + json + ");");
+}
+
+void AsideAdBlockRenderFrameObserver::DidDispatchDOMContentLoadedEvent() {
+  // A document that never reached RunScriptsAtDocumentStart still has to get
+  // its hiding rules; by this point scripts certainly run.
+  scripts_allowed_ = true;
+  MaybeApplyCosmeticResources();
+  if (applied_) {
+    PollPending();
+    SchedulePending(request_id_);
+  }
+}
+
+void AsideAdBlockRenderFrameObserver::DidFinishLoad() {
+  scripts_allowed_ = true;
+  MaybeApplyCosmeticResources();
+  if (applied_) {
+    PollPending();
+    SchedulePending(request_id_);
+  }
+}
+
+void AsideAdBlockRenderFrameObserver::WasShown() {
+  if (applied_) {
+    Execute(kScheduleProcedural);
+    SchedulePending(request_id_);
+  }
+}
+
+void AsideAdBlockRenderFrameObserver::DidSetPageLifecycleState(
+    blink::BFCacheStateChange bfcache_change) {
+  if (applied_) {
+    Execute(kScheduleProcedural);
+    SchedulePending(request_id_);
+  }
+}
+
+void AsideAdBlockRenderFrameObserver::Execute(const std::string& script) {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+  frame->ExecuteScriptInIsolatedWorld(
+      ISOLATED_WORLD_ID_CHROME_INTERNAL,
+      blink::WebScriptSource(blink::WebString::FromUtf8(script)),
+      blink::BackForwardCacheAware::kAllow);
+}
+
+std::string AsideAdBlockRenderFrameObserver::ExecuteAndReturnString(
+    const std::string& script) {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return std::string();
+  }
+  v8::Isolate* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Value> value = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+      ISOLATED_WORLD_ID_CHROME_INTERNAL,
+      blink::WebScriptSource(blink::WebString::FromUtf8(script)),
+      blink::BackForwardCacheAware::kAllow);
+  if (value.IsEmpty() || !value->IsString()) {
+    return std::string();
+  }
+  v8::String::Utf8Value utf8(isolate, value);
+  return std::string(*utf8, static_cast<size_t>(utf8.length()));
+}
+
+void AsideAdBlockRenderFrameObserver::OnDestruct() {
+  delete this;
+}
+
+}  // namespace aside_adblock
