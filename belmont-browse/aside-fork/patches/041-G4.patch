@@ -0,0 +1,284 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace aside_adblock {
+
+namespace {
+
+// "##", "#@#", "#?#", "#$#", "#@$#", "#%#", "#@%#", "#$?#", "#@?#" ...
+bool LooksLikeCosmeticRule(std::string_view line) {
+  size_t pos = 0;
+  while ((pos = line.find('#', pos)) != std::string_view::npos) {
+    size_t end = pos + 1;
+    while (end < line.size() && end - pos <= 3 &&
+           (line[end] == '@' || line[end] == '?' || line[end] == '$' ||
+            line[end] == '%')) {
+      ++end;
+    }
+    if (end < line.size() && line[end] == '#') {
+      return true;
+    }
+    pos = end;
+  }
+  return false;
+}
+
+}  // namespace
+
+PreprocessedRule PreprocessNetworkRule(std::string_view line) {
+  PreprocessedRule out;
+  out.line = std::string(line);
+  if (line.empty() || line[0] == '!' || line[0] == '[' ||
+      LooksLikeCosmeticRule(line)) {
+    return out;
+  }
+  out.is_network = true;
+
+  std::string_view body = line;
+  const bool is_allowlist = body.starts_with("@@");
+  if (is_allowlist) {
+    body.remove_prefix(2);
+  }
+
+  std::string_view pattern;
+  std::string_view options;
+  bool has_options = false;
+  if (!body.empty() && body[0] == '/') {
+    // Regex rule: /pattern/ or /pattern/$options.
+    size_t opt = body.rfind("/$");
+    if (opt != std::string_view::npos && opt > 0) {
+      out.is_regex = true;
+      out.regex = std::string(body.substr(1, opt - 1));
+      options = body.substr(opt + 2);
+      has_options = true;
+    } else if (body.size() >= 2 && body.back() == '/') {
+      out.is_regex = true;
+      out.regex = std::string(body.substr(1, body.size() - 2));
+    }
+  }
+  if (!out.is_regex) {
+    size_t dollar = body.rfind('$');
+    if (dollar != std::string_view::npos) {
+      pattern = body.substr(0, dollar);
+      options = body.substr(dollar + 1);
+      has_options = true;
+    } else {
+      pattern = body;
+    }
+  }
+
+  std::vector<std::string> kept;
+  bool negated_subdocument = false;
+  if (has_options) {
+    for (std::string_view piece : base::SplitStringPiece(
+             options, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      std::string_view name = piece;
+      const bool negated = name.starts_with("~");
+      if (negated) {
+        name.remove_prefix(1);
+      }
+      size_t eq = name.find('=');
+      std::string_view value;
+      if (eq != std::string_view::npos) {
+        value = name.substr(eq + 1);
+        name = name.substr(0, eq);
+      }
+      const std::string lower = base::ToLowerASCII(name);
+      if (lower == "important") {
+        out.important = true;
+        continue;
+      }
+      // Negated frame types. adblock-rust rejects "~document"
+      // (NegatedDocument), so that option is left for RuleParser to reject as
+      // well; "~subdocument" is "every type except sub-frames" and becomes the
+      // explicit list of the other types (RuleParser has no negation there).
+      if (negated && lower == "subdocument") {
+        negated_subdocument = true;
+        continue;
+      }
+      if (lower == "popup") {
+        if (negated) {
+          continue;
+        }
+        out.bucket = PreprocessedRule::Bucket::kPopup;
+        kept.push_back("subdocument");
+        continue;
+      }
+      if (lower == "generichide" || lower == "elemhide") {
+        out.bucket = lower == "generichide"
+                         ? PreprocessedRule::Bucket::kGenericHide
+                         : PreprocessedRule::Bucket::kElemHide;
+        kept.push_back("document");
+        continue;
+      }
+      if (lower == "badfilter" && !negated) {
+        out.badfilter = true;
+        continue;
+      }
+      if (lower == "redirect" || lower == "redirect-rule" ||
+          lower == "rewrite") {
+        std::string resource(value);
+        if (base::StartsWith(resource, "abp-resource:")) {
+          resource = resource.substr(std::string_view("abp-resource:").size());
+        }
+        out.redirect_directive = resource;
+        // uBO priorities are signed; exceptions compare the complete directive.
+        size_t colon = resource.rfind(':');
+        if (colon != std::string::npos && colon > 0 &&
+            base::StringToInt(std::string_view(resource).substr(colon + 1),
+                              &out.redirect_priority)) {
+          resource.resize(colon);
+        }
+        out.redirect = resource;
+        if (lower == "redirect-rule") {
+          out.redirect_only = true;
+          out.bucket = PreprocessedRule::Bucket::kRedirectRule;
+        }
+        continue;
+      }
+      if (lower == "csp") {
+        out.csp = std::string(value);
+        out.bucket = PreprocessedRule::Bucket::kCsp;
+        continue;
+      }
+      if (lower == "method") {
+        out.method = base::ToLowerASCII(value);
+        out.bucket = PreprocessedRule::Bucket::kMethod;
+        continue;
+      }
+      kept.emplace_back(piece);
+    }
+  }
+  if (negated_subdocument) {
+    bool has_positive_type = false;
+    static constexpr std::string_view kTypes[] = {
+        "script", "image",   "stylesheet", "object", "xmlhttprequest",
+        "other",  "ping",    "media",      "font",   "websocket",
+        "subdocument", "popup"};
+    for (const std::string& k : kept) {
+      for (std::string_view type : kTypes) {
+        if (base::ToLowerASCII(k) == type) {
+          has_positive_type = true;
+        }
+      }
+    }
+    if (!has_positive_type) {
+      for (std::string_view type : kTypes) {
+        if (type != "subdocument" && type != "popup") {
+          kept.emplace_back(type);
+        }
+      }
+    }
+  }
+  if (out.redirect_only && out.bucket == PreprocessedRule::Bucket::kMethod) {
+    out.bucket = PreprocessedRule::Bucket::kRedirectRule;
+  }
+  if (out.important && out.bucket == PreprocessedRule::Bucket::kMain) {
+    out.bucket = PreprocessedRule::Bucket::kImportant;
+  }
+  if (out.bucket == PreprocessedRule::Bucket::kCsp) {
+    // $csp rules apply to documents; give the parser a resource type so the
+    // rule indexes (queried with subdocument).
+    bool has_type = false;
+    for (const std::string& k : kept) {
+      if (k == "subdocument" || k == "document") {
+        has_type = true;
+      }
+    }
+    if (!has_type) {
+      kept.push_back("subdocument");
+    }
+  }
+
+  std::string rebuilt;
+  if (is_allowlist) {
+    rebuilt += "@@";
+  }
+  rebuilt += out.is_regex ? std::string(kRegexPlaceholder)
+                          : std::string(pattern);
+  if (!kept.empty()) {
+    rebuilt += "$" + base::JoinString(kept, ",");
+  }
+  out.line = std::move(rebuilt);
+  return out;
+}
+
+CosmeticKind NormalizeCosmeticRule(std::string* line) {
+  static constexpr struct {
+    std::string_view delimiter;
+    std::string_view replacement;  // empty: unsupported
+    CosmeticKind kind;
+  } kDelimiters[] = {
+      {"#@?#", "#@#", CosmeticKind::kProcedural},
+      {"#?#", "##", CosmeticKind::kProcedural},
+      {"#@$?#", "", CosmeticKind::kUnsupported},
+      {"#$?#", "", CosmeticKind::kUnsupported},
+      {"#@$#", "", CosmeticKind::kUnsupported},
+      {"#$#", "", CosmeticKind::kUnsupported},
+      {"#@%#", "", CosmeticKind::kUnsupported},
+      {"#%#", "", CosmeticKind::kUnsupported},
+      {"#@#", "#@#", CosmeticKind::kStandard},
+      {"##", "##", CosmeticKind::kStandard},
+  };
+  for (const auto& d : kDelimiters) {
+    size_t pos = line->find(d.delimiter);
+    if (pos == std::string::npos) {
+      continue;
+    }
+    if (d.kind == CosmeticKind::kProcedural) {
+      line->replace(pos, d.delimiter.size(), d.replacement);
+    }
+    return d.kind;
+  }
+  return CosmeticKind::kNotCosmetic;
+}
+
+bool ExtractCosmeticDomains(std::string* line,
+                            std::vector<std::string>* domains) {
+  const size_t delimiter = line->find('#');
+  if (delimiter == std::string::npos) {
+    return false;
+  }
+  *domains = base::SplitString(
+      base::ToLowerASCII(line->substr(0, delimiter)), ",",
+      base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (std::find(domains->begin(), domains->end(), "~") != domains->end()) {
+    return false;
+  }
+  line->erase(0, delimiter);
+  return true;
+}
+
+bool MethodMatches(std::string_view method_option,
+                   std::string_view request_method) {
+  const std::string method = base::ToLowerASCII(request_method);
+  bool any_positive = false;
+  bool positive_hit = false;
+  for (std::string_view piece : base::SplitStringPiece(
+           method_option, "|", base::TRIM_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    if (piece.starts_with("~")) {
+      if (base::ToLowerASCII(piece.substr(1)) == method) {
+        return false;
+      }
+    } else {
+      any_positive = true;
+      if (base::ToLowerASCII(piece) == method) {
+        positive_hit = true;
+      }
+    }
+  }
+  return !any_positive || positive_hit;
+}
+
+}  // namespace aside_adblock
diff --git a/chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h b/chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h
new file mode 100644
index 0000000000..0c868ffb30
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_rule_preprocessor.h
@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Option pre-pass for EasyList network rules. //components/subresource_filter's
+// RuleParser + url_pattern_index cover the classic syntax but drop or reject
+// the options adblock-rust (the original engine) understands: $popup,
+// $generichide/$elemhide, $important, $redirect/$redirect-rule/$rewrite,
+// $csp, $method and /regex/ patterns. This pass rewrites a line into a
+// parser-accepted spelling and reports what was taken out so the engine can
+// route the rule to a side index or a regex table. Pure function, no
+// Chromium dependencies beyond //base (shared with the offline classifier).
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_RULE_PREPROCESSOR_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_RULE_PREPROCESSOR_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace aside_adblock {
+
+struct PreprocessedRule {
+  // Which index the rule belongs to once parsed.
+  enum class Bucket {
+    kMain,          // regular block / exception rule
+    kPopup,         // $popup (popup rewritten to subdocument)
+    kGenericHide,   // $generichide exception (rewritten to $document)
+    kElemHide,      // $elemhide exception (rewritten to $document)
+    kImportant,     // $important (option removed; evaluated before others)
+    kRedirectRule,  // $redirect-rule (does not block by itself)
+    kCsp,           // $csp=... (document rule; value in |csp|)
+    kMethod,        // $method=... (value in |method|)
+  };
+
+  // False for cosmetic rules and comments: |line| is the input unchanged.
+  bool is_network = false;
+  // Line for RuleParser. For regex rules the pattern is replaced by
+  // kRegexPlaceholder so the options still parse.
+  std::string line;
+  Bucket bucket = Bucket::kMain;
+  bool is_regex = false;
+  std::string regex;     // pattern between the slashes (regex rules)
+  std::string redirect;  // resource name ($redirect=, $redirect-rule=,
+                         // $rewrite=abp-resource:)
+  bool redirect_only = false;  // $redirect-rule never implies a block
+  int redirect_priority = 0;  // signed priority suffix, preserved for selection
+  std::string redirect_directive;  // full value, for exact redirect exceptions
+  std::string csp;       // $csp value
+  std::string method;    // raw $method value, e.g. "post" or "~get|~head"
+  bool important = false;
+  bool badfilter = false;  // disables the identical rule without this option
+};
+
+inline constexpr char kRegexPlaceholder[] = "aside-regex-placeholder";
+
+// Cosmetic-rule delimiters beyond the parser's "##" / "#@#".
+enum class CosmeticKind {
+  kNotCosmetic,
+  kStandard,     // "##" or "#@#": unchanged
+  kProcedural,   // "#?#" / "#@?#": rewritten to "##" / "#@#" (the engine
+                 // then screens procedural pseudo-classes it cannot run)
+  kUnsupported,  // "#$#", "#@$#", "#%#", "#@%#", "#$?#": snippet / CSS / JS
+                 // injection, not supported
+};
+CosmeticKind NormalizeCosmeticRule(std::string* line);
+
+// Removes and returns a normalized cosmetic rule's include/exclude domains.
+// Shared by Engine and the offline classifier because Chromium's style parser
+// rejects negative domains. False for a malformed exclusion or missing delimiter.
+bool ExtractCosmeticDomains(std::string* line,
+                            std::vector<std::string>* domains);
+
+PreprocessedRule PreprocessNetworkRule(std::string_view line);
+
+// True if |request_method| (e.g. "POST") satisfies a $method value.
+bool MethodMatches(std::string_view method_option,
+                   std::string_view request_method);
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_RULE_PREPROCESSOR_H_
