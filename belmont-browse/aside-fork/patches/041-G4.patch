+namespace aside_importer {
+
+namespace {
+
+inline constexpr sql::Database::Tag kDatabaseTag{"FirefoxImporter"};
+
+// Firefox stores the file next to its write-ahead log and rollback journal.
+// Copying the database alone would drop everything a running Firefox has
+// written since its last checkpoint.
+constexpr base::FilePath::CharType kCookiesFile[] =
+    FILE_PATH_LITERAL("cookies.sqlite");
+constexpr base::FilePath::CharType kWalSuffix[] = FILE_PATH_LITERAL("-wal");
+constexpr base::FilePath::CharType kJournalSuffix[] =
+    FILE_PATH_LITERAL("-journal");
+
+// Columns the reader needs, and the ones it uses when the schema has them.
+constexpr char kName[] = "name";
+constexpr char kValue[] = "value";
+constexpr char kHost[] = "host";
+constexpr char kPath[] = "path";
+constexpr char kExpiry[] = "expiry";
+constexpr char kLastAccessed[] = "lastAccessed";
+constexpr char kCreationTime[] = "creationTime";
+constexpr char kIsSecure[] = "isSecure";
+constexpr char kIsHttpOnly[] = "isHttpOnly";
+constexpr char kSchemeMap[] = "schemeMap";
+constexpr char kOriginAttributes[] = "originAttributes";
+
+// moz_cookies keeps expiry in whole seconds since the Unix epoch, and
+// lastAccessed / creationTime in microseconds since it.
+base::Time FromUnixSeconds(int64_t seconds) {
+  return seconds <= 0 ? base::Time()
+                      : base::Time::UnixEpoch() + base::Seconds(seconds);
+}
+
+base::Time FromUnixMicroseconds(int64_t microseconds) {
+  return microseconds <= 0
+             ? base::Time()
+             : base::Time::UnixEpoch() + base::Microseconds(microseconds);
+}
+
+// The columns moz_cookies actually has in this profile's Firefox version.
+std::set<std::string> ReadColumnNames(sql::Database& db) {
+  std::set<std::string> names;
+  sql::Statement statement(
+      db.GetUniqueStatement("PRAGMA table_info(moz_cookies)"));
+  if (!statement.is_valid()) {
+    return names;
+  }
+  while (statement.Step()) {
+    names.insert(statement.ColumnString(1));
+  }
+  return names;
+}
+
+bool CopyIfPresent(const base::FilePath& from, const base::FilePath& to) {
+  return !base::PathExists(from) || base::CopyFile(from, to);
+}
+
+}  // namespace
+
+GURL OriginAttributesUrl(const std::string& origin_attributes) {
+  std::string suffix = origin_attributes;
+  if (!suffix.empty() && suffix.front() == '^') {
+    suffix.erase(suffix.begin());
+  }
+  return GURL("https://firefox-origin-attributes.invalid/?" + suffix);
+}
+
+FirefoxCookieResult ReadFirefoxCookies(const base::FilePath& profile_dir) {
+  FirefoxCookieResult result;
+  const base::FilePath source = profile_dir.Append(kCookiesFile);
+  if (!base::PathExists(source)) {
+    // A profile with no cookie store is not an error; it simply has none.
+    result.ok = true;
+    return result;
+  }
+
+  base::ScopedTempDir temp;
+  if (!temp.CreateUniqueTempDir()) {
+    result.error = "Failed to snapshot Firefox cookies database";
+    return result;
+  }
+  const base::FilePath snapshot = temp.GetPath().Append(kCookiesFile);
+  if (!base::CopyFile(source, snapshot) ||
+      !CopyIfPresent(source.AddExtension(kWalSuffix),
+                     snapshot.AddExtension(kWalSuffix)) ||
+      !CopyIfPresent(source.AddExtension(kJournalSuffix),
+                     snapshot.AddExtension(kJournalSuffix))) {
+    result.error = "Failed to snapshot Firefox cookies database";
+    return result;
+  }
+
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(snapshot)) {
+    result.error = "Failed to open Firefox cookies database snapshot";
+    return result;
+  }
+
+  const std::set<std::string> columns = ReadColumnNames(db);
+  // Everything below the optional columns has been in moz_cookies for as long
+  // as the table has existed; a store without one of them is not a cookie
+  // store this reader understands.
+  for (const char* required :
+       {kName, kValue, kHost, kPath, kExpiry, kCreationTime}) {
+    if (!columns.contains(required)) {
+      result.error =
+          base::StrCat({"Firefox cookies database is missing column ",
+                        required});
+      return result;
+    }
+  }
+
+  const bool has_last_accessed = columns.contains(kLastAccessed);
+  const bool has_secure = columns.contains(kIsSecure);
+  const bool has_http_only = columns.contains(kIsHttpOnly);
+  const bool has_scheme_map = columns.contains(kSchemeMap);
+  const bool has_origin_attributes = columns.contains(kOriginAttributes);
+
+  // Built from the columns this schema has, in the original's order, so an
+  // older Firefox is read rather than rejected.
+  std::vector<std::string> select_columns = {kName, kValue, kHost, kPath,
+                                             kExpiry};
+  if (has_last_accessed) {
+    select_columns.push_back(kLastAccessed);
+  }
+  select_columns.push_back(kCreationTime);
+  if (has_secure) {
+    select_columns.push_back(kIsSecure);
+  }
+  if (has_http_only) {
+    select_columns.push_back(kIsHttpOnly);
+  }
+  if (has_scheme_map) {
+    select_columns.push_back(kSchemeMap);
+  }
+  if (has_origin_attributes) {
+    select_columns.push_back(kOriginAttributes);
+  }
+  const std::string query =
+      base::StrCat({"SELECT ", base::JoinString(select_columns, ", "),
+                    " FROM moz_cookies"});
+
+  sql::Statement statement(db.GetUniqueStatement(query));
+  if (!statement.is_valid()) {
+    result.error = "Failed to query Firefox cookies database";
+    return result;
+  }
+  while (statement.Step()) {
+    FirefoxCookie cookie;
+    int column = 0;
+    cookie.name = statement.ColumnString(column++);
+    cookie.value = statement.ColumnString(column++);
+    cookie.host = statement.ColumnString(column++);
+    cookie.path = statement.ColumnString(column++);
+    cookie.expiry = FromUnixSeconds(statement.ColumnInt64(column++));
+    if (has_last_accessed) {
+      cookie.last_accessed =
+          FromUnixMicroseconds(statement.ColumnInt64(column++));
+    }
+    cookie.creation_time =
+        FromUnixMicroseconds(statement.ColumnInt64(column++));
+    if (has_secure) {
+      cookie.is_secure = statement.ColumnInt64(column++) != 0;
+    }
+    if (has_http_only) {
+      cookie.is_http_only = statement.ColumnInt64(column++) != 0;
+    }
+    if (has_scheme_map) {
+      cookie.scheme_map = static_cast<int>(statement.ColumnInt64(column++));
+    }
+    if (has_origin_attributes) {
+      cookie.origin_attributes = statement.ColumnString(column++);
+    }
+    result.cookies.push_back(std::move(cookie));
+  }
+  if (!statement.Succeeded()) {
+    result.error = "Failed while reading Firefox cookies database";
+    return result;
+  }
+  result.ok = true;
+  return result;
+}
+
+}  // namespace aside_importer
