+ExtensionFunction::ResponseAction AsideOmniboxOpenLensSearchFunction::Run() {
+  auto params = api::aside_omnibox::OpenLensSearch::Params::Create(args());
+  if (!params) return RespondNow(Error(kInvalidArguments));
+  std::string error;
+  auto* session = FindSession(this, params->session_id, &error);
+  if (!session) return RespondNow(Error(error));
+  const auto* image = session->contexts().GetSingleImage();
+  if (!image) return RespondNow(Error("Image search requires exactly one image context"));
+  auto* provider_service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(browser_context()));
+  const auto* provider = provider_service ? provider_service->GetDefaultSearchProvider() : nullptr;
+  if (!provider || !provider->image_url_ref().IsValid(provider_service->search_terms_data())) {
+    return RespondNow(Error("The current search provider does not support image search"));
+  }
+  if (!session->target() || !CoreTabHelper::FromWebContents(session->target())) {
+    return RespondNow(Error("Image search target tab is unavailable"));
+  }
+  // Decode through Chromium's isolated decoder, accepting its supported image
+  // formats. MIME or data-URL claims alone do not establish a valid image.
+  data_decoder::DecodeImageIsolated(base::as_byte_span(image->second.bytes),
+      data_decoder::mojom::ImageCodec::kDefault, true,
+      data_decoder::kDefaultMaxSizeInBytes, gfx::Size(),
+      base::BindOnce(&AsideOmniboxOpenLensSearchFunction::OnImageDecoded,
+                     base::RetainedRef(this), params->session_id, image->first));
+  return RespondLater();
+}
+
+void AsideOmniboxOpenLensSearchFunction::OnImageDecoded(
+    std::string session_id, std::string token, const SkBitmap& bitmap) {
+  std::string error;
+  auto* session = FindSession(this, session_id, &error);
+  if (!session) { Respond(Error(error)); return; }
+  // A user can remove a file, abandon/destroy the session, or close its tab
+  // while the isolated decoder is working. None may initiate a later upload.
+  const auto* image = session->contexts().GetSingleImage();
+  if (!image || image->first != token) {
+    Respond(Error("Image context was removed or changed")); return;
+  }
+  if (bitmap.drawsNothing()) {
+    Respond(Error("Invalid or unsupported image payload")); return;
+  }
+  auto* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(browser_context()));
+  const auto* provider = service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!provider || !provider->image_url_ref().IsValid(service->search_terms_data())) {
+    Respond(Error("The current search provider does not support image search")); return;
+  }
+  auto* helper = session->target() ? CoreTabHelper::FromWebContents(session->target()) : nullptr;
+  if (!helper) { Respond(Error("Image search target tab is unavailable")); return; }
+  // Same native path as Chromium's image context-menu action. It prepares the
+  // provider's image URL and POST body; no endpoint is invented by this API.
+  helper->SearchByImage(gfx::Image::CreateFrom1xBitmap(bitmap));
+  session->contexts().Remove(token);
+  Respond(NoArguments());
+}
