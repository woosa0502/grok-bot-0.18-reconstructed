diff --git a/chrome/browser/extensions/api/aside_browser_import/import_job.h b/chrome/browser/extensions/api/aside_browser_import/import_job.h
new file mode 100644
index 0000000000..2dd33207a5
--- /dev/null
+++ b/chrome/browser/extensions/api/aside_browser_import/import_job.h
@@ -0,0 +1,66 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_API_ASIDE_BROWSER_IMPORT_IMPORT_JOB_H_
+#define CHROME_BROWSER_EXTENSIONS_API_ASIDE_BROWSER_IMPORT_IMPORT_JOB_H_
+
+#include <bit>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+namespace extensions::aside_import {
+
+// Terminal outcomes are monotonic, including when utility callbacks race
+// cancellation. Progress counts selected kinds, not duplicated notifications.
+struct ImportJob {
+  std::string source_id;
+  std::string state = "queued";
+  double progress = 0.0;
+  std::string current_data_kind;
+  std::string error_message;
+  uint16_t requested_items = 0;
+  uint16_t finished_items = 0;
+
+  bool IsActive() const { return state == "queued" || state == "importing"; }
+  void Started() {
+    if (IsActive()) state = "importing";
+  }
+  void ItemStarted(std::string kind) {
+    if (IsActive()) current_data_kind = std::move(kind);
+  }
+  void ItemEnded(uint16_t item) {
+    if (!IsActive()) return;
+    finished_items |= item & requested_items;
+    if (requested_items) {
+      progress = static_cast<double>(std::popcount(finished_items)) /
+                 std::popcount(requested_items);
+    }
+  }
+  void Failed(const std::string& message) {
+    if (!IsActive()) return;
+    state = "failed";
+    error_message = message.empty() ? "Import failed" : message;
+    current_data_kind.clear();
+  }
+  void Cancelled() {
+    if (!IsActive()) return;
+    state = "cancelled";
+    current_data_kind.clear();
+  }
+  void Ended() {
+    if (!IsActive()) return;
+    if (!requested_items || finished_items != requested_items) {
+      Failed("Import ended before all selected data types completed");
+      return;
+    }
+    state = "succeeded";
+    progress = 1.0;
+    current_data_kind.clear();
+  }
+};
+
+}  // namespace extensions::aside_import
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_ASIDE_BROWSER_IMPORT_IMPORT_JOB_H_
diff --git a/chrome/browser/extensions/api/aside_browser_import/import_job_unittest.cc b/chrome/browser/extensions/api/aside_browser_import/import_job_unittest.cc
new file mode 100644
index 0000000000..2201279fd9
--- /dev/null
+++ b/chrome/browser/extensions/api/aside_browser_import/import_job_unittest.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_browser_import/import_job.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+using extensions::aside_import::ImportJob;
+
+TEST(AsideImportStateTest, CancellationIsTerminalUnderEveryLateCallback) {
+  ImportJob job;
+  job.requested_items = 3;
+  job.Cancelled();
+  job.Started();
+  job.ItemStarted("bookmarks");
+  job.ItemEnded(3);
+  job.Failed("late failure");
+  job.Ended();
+  EXPECT_EQ("cancelled", job.state);
+  EXPECT_EQ(0.0, job.progress);
+  EXPECT_TRUE(job.current_data_kind.empty());
+}
+
+TEST(AsideImportStateTest, FailureSurvivesTheHostCancellationPath) {
+  ImportJob job;
+  job.requested_items = 1;
+  job.Started();
+  job.Failed("utility disconnected");
+  job.Cancelled();
+  job.ItemEnded(1);
+  job.Ended();
+  EXPECT_EQ("failed", job.state);
+  EXPECT_EQ("utility disconnected", job.error_message);
+}
+
+TEST(AsideImportStateTest, DuplicateAndUnrequestedItemsCannotInflateProgress) {
+  ImportJob job;
+  job.requested_items = 3;
+  job.Started();
+  job.ItemEnded(1);
+  job.ItemEnded(1);
+  job.ItemEnded(8);
+  EXPECT_EQ(0.5, job.progress);
+  job.ItemEnded(2);
+  job.Ended();
+  EXPECT_EQ("succeeded", job.state);
+  EXPECT_EQ(1.0, job.progress);
+  job.Cancelled();
+  EXPECT_EQ("succeeded", job.state);
+}
+
+TEST(AsideImportStateTest, EarlyEndDoesNotManufactureSuccess) {
+  ImportJob job;
+  job.requested_items = 3;
+  job.ItemEnded(1);
+  job.Ended();
+  EXPECT_EQ("failed", job.state);
+  EXPECT_EQ(0.5, job.progress);
+  EXPECT_FALSE(job.error_message.empty());
+}
+
+TEST(AsideImportStateTest, EmptyFailureStillHasActionableError) {
+  ImportJob job;
+  job.Failed("");
+  EXPECT_EQ("failed", job.state);
+  EXPECT_FALSE(job.error_message.empty());
+}
+
+int main(int argc, char** argv) {
+  testing::InitGoogleTest(&argc, argv);
+  return RUN_ALL_TESTS();
+}
