+  std::string error;
+  AsideOmniboxSession* session = FindSession(this, params->session_id, &error);
+  if (!session) {
+    return RespondNow(Error(error));
+  }
+  const auto& selection = params->selection.additional_properties;
+  const auto line = selection.FindInt("line");
+  if (!IsAsideOmniboxResultCurrent(selection, session->result_sequence_id()) || !line || *line < -1 || (*line >= 0 &&
+      static_cast<size_t>(*line) >= session->result().size())) {
+    return RespondNow(Error("Invalid or stale popup selection"));
