+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_SAFARI_ARCHIVE_H_
+#define CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_SAFARI_ARCHIVE_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "components/user_data_importer/common/importer_url_row.h"
+
+namespace aside_importer {
+
+// What a Safari data export ZIP turned out to hold.
+//
+// Safari names the files inside after the account rather than by a fixed
+// name, so each one is recognised by its extension and, for the two JSON
+// files, by the array its top level carries. This is the same rule the
+// upstream Safari importer applies (components/user_data_importer/utility/
+// parsing_ffi: bookmarks are .html, history and payment cards are .json under
+// the "history" and "payment_cards" keys, passwords are .csv), and it is why
+// matching the literal name "Bookmarks.html" finds nothing in a real export.
+struct SafariArchive {
+  SafariArchive();
+  SafariArchive(SafariArchive&&);
+  SafariArchive& operator=(SafariArchive&&);
+  ~SafariArchive();
+
+  // Keeps the unpacked files alive for as long as the caller holds this.
+  std::unique_ptr<base::ScopedTempDir> dir;
+
+  base::FilePath bookmarks_html;
+  base::FilePath history_json;
+  base::FilePath passwords_csv;
+  base::FilePath payment_cards_json;
+
+  // True when the ZIP opened and held at least one file this browser can read.
+  bool IsValid() const;
+};
+
+// Unpacks `zip` and classifies what is inside. Blocking.
+SafariArchive UnpackSafariArchive(const base::FilePath& zip);
+
+// Reads a Safari history export into one row per URL, keeping the latest visit
+// time and counting repeat visits. Redirect targets that Safari records
+// separately are folded into the row for their own URL. Blocking.
+std::vector<user_data_importer::ImporterURLRow> ReadSafariHistory(
+    const base::FilePath& history_json);
+
+}  // namespace aside_importer
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_SAFARI_ARCHIVE_H_
