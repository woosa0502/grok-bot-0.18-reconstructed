+std::vector<ChromiumProfileInfo> ReadChromiumProfiles(
+    ChromiumBrowser browser) {
+  return ReadChromiumProfilesFromDirectory(UserDataDirectoryFor(browser));
+}
+
+std::vector<ChromiumProfileInfo> ReadChromiumProfilesFromDirectory(
+    const base::FilePath& dir) {
+  std::vector<ChromiumProfileInfo> profiles;
+  if (dir.empty()) {
+    return profiles;
+  }
+  std::optional<base::DictValue> local_state = ReadLocalState(dir);
+  const base::DictValue* cache =
+      local_state ? local_state->FindDictByDottedPath("profile.info_cache")
+                  : nullptr;
+  // A browser that never wrote a Local State still has a Default profile.
+  if (!cache) {
+    const base::FilePath fallback = dir.Append(FILE_PATH_LITERAL("Default"));
+    if (base::PathExists(fallback)) {
+      ChromiumProfileInfo info;
+      info.id = "Default";
+      info.name = "Default";
+      info.path = fallback;
+      profiles.push_back(std::move(info));
+    }
+    return profiles;
+  }
+
+  auto make = [&](const std::string& id,
+                  const base::DictValue& entry) -> ChromiumProfileInfo {
+    ChromiumProfileInfo info;
+    info.id = id;
+    const std::string* gaia_name = entry.FindString("gaia_name");
+    const std::string* name = entry.FindString("name");
+    if (gaia_name && !gaia_name->empty()) {
+      info.name = *gaia_name;
+    } else if (name && !name->empty()) {
+      info.name = *name;
+    } else {
+      info.name = id;
+    }
+    info.path = dir.AppendASCII(id);
+    const std::string* picture = entry.FindString("gaia_picture_file_name");
+    if (picture && !picture->empty()) {
+      info.avatar = info.path.AppendASCII(*picture);
+    }
+    return info;
+  };
+
+  // profile.profiles_order is the order the source browser shows; anything it
+  // does not mention follows in info_cache order.
+  std::set<std::string> seen;
+  if (const base::ListValue* order =
+          local_state->FindListByDottedPath("profile.profiles_order")) {
+    for (const base::Value& value : *order) {
+      if (!value.is_string()) {
+        continue;
+      }
+      const base::DictValue* entry = cache->FindDict(value.GetString());
+      if (!entry) {
+        continue;
+      }
+      seen.insert(value.GetString());
+      profiles.push_back(make(value.GetString(), *entry));
+    }
+  }
+  for (const auto [id, value] : *cache) {
+    if (seen.contains(id) || !value.is_dict()) {
+      continue;
+    }
+    profiles.push_back(make(id, value.GetDict()));
+  }
+  // Only profiles that actually have a directory can be migrated.
+  std::erase_if(profiles, [](const ChromiumProfileInfo& info) {
+    return !base::PathExists(info.path);
+  });
+  return profiles;
+}
+
+MigrationResult MigrateChromiumProfile(
+    ChromiumBrowser browser,
+    const ChromiumProfileInfo& profile,
+    const base::FilePath& target_profile_dir,
+    const std::string& target_profile_name,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  MigrationResult result;
+  const std::string display = DisplayNameForChromiumBrowser(browser);
+
+  if (!base::DirectoryExists(profile.path)) {
+    result.error = display + " profile directory does not exist: " +
+                   profile.path.AsUTF8Unsafe();
+    return result;
+  }
+  if (!base::CreateDirectory(target_profile_dir)) {
+    result.error = "Failed to copy " + display + " profile data from " +
+                   profile.path.AsUTF8Unsafe();
+    return result;
+  }
+
+  // Copy the profile a top-level entry at a time so the skip list applies.
+  std::set<std::string> skipped(std::begin(kSkippedNames),
+                                std::end(kSkippedNames));
+  base::FileEnumerator entries(
+      profile.path, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath entry = entries.Next(); !entry.empty();
+       entry = entries.Next()) {
+    const std::string name = entry.BaseName().AsUTF8Unsafe();
+    if (skipped.contains(name) || name.starts_with(kExtensionStoragePrefix)) {
+      continue;
+    }
+    const base::FilePath destination = target_profile_dir.AppendASCII(name);
+    const bool copied =
+        base::DirectoryExists(entry)
+            ? base::CopyDirectory(entry, destination, /*recursive=*/true)
+            : base::CopyFile(entry, destination);
+    if (!copied) {
+      result.error = "Failed to copy " + display + " profile data from " +
+                     profile.path.AsUTF8Unsafe();
+      return result;
+    }
+  }
+
+  // Scrub the copied preferences. Leaving the source installation's MACs in
+  // place would make every tracked preference read as tampered with, which is
+  // what "reinitialize imported tracked preferences" refers to.
+  const base::FilePath prefs_path =
+      target_profile_dir.Append(FILE_PATH_LITERAL("Preferences"));
+  if (base::PathExists(prefs_path)) {
+    std::string contents;
+    std::optional<base::Value> parsed;
+    if (base::ReadFileToString(prefs_path, &contents)) {
+      parsed = base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+    }
+    if (!parsed || !parsed->is_dict()) {
+      result.error = "Failed to update copied " + display + " preferences.";
+      return result;
+    }
+    base::DictValue prefs = std::move(*parsed).TakeDict();
+    RemovePreferences(prefs);
+    prefs.SetByDottedPath("profile.name", target_profile_name);
+    std::string out;
+    if (!base::JSONWriter::Write(prefs, &out) ||
+        !base::WriteFile(prefs_path, out)) {
+      result.error = "Failed to reinitialize imported tracked preferences for " +
+                     display;
+      return result;
+    }
+  }
+  // Secure Preferences carries the same MACs and is regenerated on first run.
+  const base::FilePath secure_prefs =
+      target_profile_dir.Append(FILE_PATH_LITERAL("Secure Preferences"));
+  if (base::PathExists(secure_prefs)) {
+    std::string contents;
+    std::optional<base::Value> parsed;
+    if (base::ReadFileToString(secure_prefs, &contents)) {
+      parsed = base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+    }
+    if (parsed && parsed->is_dict()) {
+      base::DictValue prefs = std::move(*parsed).TakeDict();
+      RemovePreferences(prefs);
+      std::string out;
+      if (!base::JSONWriter::Write(prefs, &out) ||
+          !base::WriteFile(secure_prefs, out)) {
+        result.error =
+            "Failed to reinitialize imported tracked preferences for " +
+            display;
+        return result;
+      }
+    }
+  }
+
+  // The Google account picture is a file the copied preferences point at; a
+  // profile whose picture did not come across shows the placeholder instead.
+  if (!profile.avatar.empty() && base::PathExists(profile.avatar)) {
+    const base::FilePath destination =
+        target_profile_dir.Append(profile.avatar.BaseName());
+    if (!base::PathExists(destination) &&
+        !base::CopyFile(profile.avatar, destination)) {
+      result.error = "Failed to persist imported " + display +
+                     " profile photo to " + destination.AsUTF8Unsafe();
+      return result;
+    }
+  }
+
+  // Cookies and passwords: reseal what this installation can read, count what
+  // it cannot. A store that opened and yielded nothing readable is reported
+  // separately, because that means the whole store is sealed to another key.
+  if (encryptor) {
+    struct Store {
+      const base::FilePath::CharType* file;
+      const char* table;
+      const char* column;
+    };
+    const Store stores[] = {
+        {FILE_PATH_LITERAL("Cookies"), "cookies", "encrypted_value"},
+        {FILE_PATH_LITERAL("Login Data"), "logins", "password_value"},
+        {FILE_PATH_LITERAL("Login Data For Account"), "logins",
+         "password_value"},
+    };
+    bool opened_any = false;
+    for (const Store& store : stores) {
+      const ResealOutcome outcome =
+          ResealColumn(target_profile_dir.Append(store.file), store.table,
+                       store.column, *encryptor);
+      opened_any = opened_any || outcome.opened;
+      result.resealed_rows += outcome.resealed;
+      result.skipped_encrypted_rows += outcome.skipped;
+    }
+    result.encrypted_store_unreadable =
+        opened_any && result.resealed_rows == 0 &&
+        result.skipped_encrypted_rows > 0;
+  }
+
+  result.ok = true;
+  return result;
+}
+
+}  // namespace aside_importer
