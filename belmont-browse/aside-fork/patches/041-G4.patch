+ExtensionFunction::ResponseAction AsideOmniboxOpenPopupSelectionFunction::Run() {
+  std::optional<api::aside_omnibox::OpenPopupSelection::Params> params =
+      api::aside_omnibox::OpenPopupSelection::Params::Create(args());
+  if (!params) {
+    return RespondNow(Error(kInvalidArguments));
+  }
+  std::string error;
+  AsideOmniboxSession* session = FindSession(this, params->session_id, &error);
+  if (!session) {
+    return RespondNow(Error(error));
+  }
+  // RE 0x405ce40: {selection{line,state}, disposition, currentTab,
+  // resultSequenceId, actionIndex}.
+  const base::DictValue& request = params->request.additional_properties;
+  const base::DictValue* selection = request.FindDict("selection");
+  base::DictValue action_request = selection ? selection->Clone() : request.Clone();
+  if (const auto sequence = request.FindDouble("resultSequenceId")) {
+    if (const auto selected_sequence = action_request.FindDouble("resultSequenceId");
+        selected_sequence && *selected_sequence != *sequence) {
+      return RespondNow(Error("Conflicting resultSequenceId values"));
+    }
+    action_request.Set("resultSequenceId", *sequence);
+  }
+  if (const auto* url = request.FindString("url")) {
+    action_request.Set("url", *url);
+  }
+  WindowOpenDisposition disposition = DispositionFromRequest(request);
+  if (const auto d = request.FindInt("disposition")) {
+    if (*d < static_cast<int>(WindowOpenDisposition::UNKNOWN) ||
+        *d > static_cast<int>(WindowOpenDisposition::MAX_VALUE)) {
+      return RespondNow(Error("Invalid disposition"));
+    }
+    disposition = static_cast<WindowOpenDisposition>(*d);
+  } else if (!request.FindBool("currentTab").value_or(true)) {
+    disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+  const std::string* state = action_request.FindString("state");
+  if (state && (*state == "actionButton" || *state == "focusedButtonAction")) {
+    if (const auto index = request.FindInt("actionIndex")) {
+      action_request.Set("actionIndex", *index);
+    }
+    error = ExecuteActionRequest(session, action_request, disposition);
+    if (!error.empty()) {
+      return RespondNow(Error(error));
+    }
+  } else {
+    const auto* match = MatchFromRequest(session, action_request);
+    if (!match || !OpenUrl(session, match->destination_url, disposition)) {
+      return RespondNow(Error("Invalid or stale autocomplete selection"));
+    }
+  }
+  return RespondNow(NoArguments());
+}
