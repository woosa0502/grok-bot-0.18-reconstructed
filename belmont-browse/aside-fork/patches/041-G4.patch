diff --git a/chrome/browser/aside_adblock/aside_adblock_cosmetic_filter_host.cc b/chrome/browser/aside_adblock/aside_adblock_cosmetic_filter_host.cc
new file mode 100644
index 0000000000..8a53555c22
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_cosmetic_filter_host.cc
@@ -0,0 +1,132 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_cosmetic_filter_host.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/aside_adblock/aside_adblock_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "url/gurl.h"
+
+namespace aside_adblock {
+
+// static
+void CosmeticFilterHost::Bind(
+    content::RenderFrameHost* frame_host,
+    mojo::PendingReceiver<mojom::CosmeticFilterHost> receiver) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<CosmeticFilterHost>(frame_host->GetGlobalId()),
+      std::move(receiver));
+}
+
+CosmeticFilterHost::CosmeticFilterHost(content::GlobalRenderFrameHostId frame_id)
+    : frame_id_(frame_id) {}
+
+CosmeticFilterHost::~CosmeticFilterHost() = default;
+
+content::RenderFrameHost* CosmeticFilterHost::frame() {
+  return content::RenderFrameHost::FromID(frame_id_);
+}
+
+AsideAdBlockService* CosmeticFilterHost::service() {
+  content::RenderFrameHost* rfh = frame();
+  return rfh ? AsideAdBlockService::Get(rfh->GetBrowserContext()) : nullptr;
+}
+
+void CosmeticFilterHost::GetCosmeticResources(
+    const GURL& url,
+    GetCosmeticResourcesCallback callback) {
+  CancelPendingCosmeticResources();
+  AsideAdBlockService* s = service();
+  using State = PendingCosmeticRequest::State;
+  const State state = s ? s->CosmeticReadiness() : State::kDisabled;
+  const std::string payload =
+      state == State::kReady ? s->CosmeticResourcesJson(url) : std::string();
+  const uint64_t generation =
+      pending_request_.Begin(state, payload, std::move(callback));
+  if (!generation) {
+    return;
+  }
+  pending_url_ = url;
+  availability_subscription_ = s->ObserveCosmeticAvailability(
+      base::BindRepeating(&CosmeticFilterHost::OnCosmeticAvailability,
+                          weak_factory_.GetWeakPtr(), generation));
+  // Startup waits are event-driven and bounded. There is at most one pending
+  // request per frame and navigation explicitly cancels it through Mojo.
+  readiness_timer_.Start(
+      FROM_HERE, base::Seconds(30),
+      base::BindOnce(&CosmeticFilterHost::OnCosmeticTimeout,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+
+void CosmeticFilterHost::CancelPendingCosmeticResources() {
+  availability_subscription_ = {};
+  readiness_timer_.Stop();
+  pending_url_ = GURL();
+  pending_request_.Cancel();
+}
+
+void CosmeticFilterHost::OnCosmeticAvailability(uint64_t generation) {
+  if (!pending_request_.IsPending(generation)) {
+    return;
+  }
+  AsideAdBlockService* s = service();
+  const auto state = s ? s->CosmeticReadiness()
+                       : PendingCosmeticRequest::State::kDisabled;
+  if (state == PendingCosmeticRequest::State::kReady) {
+    FinishCosmeticRequest(generation, s->CosmeticResourcesJson(pending_url_));
+  } else if (state != PendingCosmeticRequest::State::kLoading) {
+    FinishCosmeticRequest(generation, std::string());
+  }
+}
+
+void CosmeticFilterHost::OnCosmeticTimeout(uint64_t generation) {
+  VLOG(1) << "AsideAdBlock cosmetic: engine readiness deadline reached";
+  FinishCosmeticRequest(generation, std::string(), false);
+}
+
+void CosmeticFilterHost::FinishCosmeticRequest(
+    uint64_t generation, const std::string& payload, bool settled) {
+  if (!pending_request_.IsPending(generation)) {
+    return;
+  }
+  availability_subscription_ = {};
+  readiness_timer_.Stop();
+  pending_request_.Complete(generation, payload, settled);
+  pending_url_ = GURL();
+}
+
+void CosmeticFilterHost::GetHiddenSelectors(
+    const std::vector<std::string>& classes,
+    const std::vector<std::string>& ids,
+    GetHiddenSelectorsCallback callback) {
+  AsideAdBlockService* s = service();
+  content::RenderFrameHost* rfh = frame();
+  if (!s || !rfh) {
+    std::move(callback).Run({});
+    return;
+  }
+  std::vector<std::string> selectors =
+      s->HiddenClassIdSelectors(rfh->GetLastCommittedURL(), classes, ids);
+  VLOG(1) << "AsideAdBlock cosmetic: " << classes.size() << " classes / "
+          << ids.size() << " ids for " << rfh->GetLastCommittedURL().spec()
+          << " -> " << selectors.size() << " selectors";
+  std::move(callback).Run(std::move(selectors));
+}
+
+void CosmeticFilterHost::TakePrefetchedResources(
+    TakePrefetchedResourcesCallback callback) {
+  AsideAdBlockService* s = service();
+  content::RenderFrameHost* rfh = frame();
+  std::move(callback).Run(
+      s && rfh ? s->CosmeticResourcesJson(rfh->GetLastCommittedURL())
+               : std::string());
+}
+
+}  // namespace aside_adblock
