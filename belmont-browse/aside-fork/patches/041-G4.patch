+        backdrop-filter: blur(36px);
+        background: var(--window-bg);
+        box-sizing: border-box;
+        box-shadow: 0 16px 36px 3px rgba(0, 0, 0, 0.5);
+        height: 100%;
+        overflow: hidden;
+        position: relative;
+        width: 100%;
+      }
