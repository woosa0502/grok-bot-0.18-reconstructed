+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# The parts of chrome://aside-import-data that read another browser's profile
+# directly rather than through the utility-process importer: the Chromium
+# family profile migrator and Firefox's cookie store.
+source_set("aside_importer") {
+  sources = [
+    "chromium_profile_migrator.cc",
+    "chromium_profile_migrator.h",
+    "firefox_cookie_importer.cc",
+    "firefox_cookie_importer.h",
+    "firefox_profile_importer.cc",
+    "firefox_profile_importer.h",
+    "safari_archive.cc",
+    "safari_archive.h",
+  ]
+  public_deps = [
+    "//base",
+    "//components/os_crypt/async/common",
+    "//components/user_data_importer/common",
+    "//net",
+    "//url",
+  ]
+  deps = [
+    "//sql",
+    "//third_party/zlib/google:zip",
+  ]
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "aside_importer_unittest.cc" ]
+  deps = [
+    ":aside_importer",
+    "//base",
+    "//base/test:test_support",
+    "//testing/gtest",
+  ]
+}
+
+# The same regressions as a runnable binary: the Chromium-family profile
+# migrator, Firefox's cookie store and the Safari archive classifier read
+# fixture files on disk; no browser, profile or network is started.
+executable("aside_importer_tests") {
+  testonly = true
+  deps = [
+    ":unit_tests",
+    "//base/test:run_all_unittests",
+  ]
+}
