+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_PROFILE_IMPORTER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_PROFILE_IMPORTER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "chrome/browser/ui/webui/aside_importer/firefox_cookie_importer.h"
+#include "net/cookies/canonical_cookie.h"
+#include "url/gurl.h"
+
+namespace aside_importer {
+
+// The cookies a Firefox profile can hand over, and what had to be left out.
+struct PreparedFirefoxCookies {
+  std::vector<net::CanonicalCookie> cookies;
+  // Rows this browser has no equivalent for: a container cookie, a row whose
+  // host or name this cookie store would reject, an expired row.
+  int skipped = 0;
+  // Set when the store itself could not be read.
+  std::string error;
+};
+
+// The URL a moz_cookies row describes, or an invalid GURL when the row cannot
+// name one. Firefox stores a leading dot on a domain cookie's host, the same
+// way this browser's store does.
+GURL UrlForFirefoxCookie(const FirefoxCookie& cookie);
+
+// Turns one moz_cookies row into a cookie this browser's store accepts, or
+// nothing when it cannot be represented here.
+std::unique_ptr<net::CanonicalCookie> ConvertFirefoxCookie(
+    const FirefoxCookie& cookie);
+
+// Reads the profile's cookie store and converts every row it can. Blocking.
+PreparedFirefoxCookies PrepareFirefoxCookies(const base::FilePath& profile_dir);
+
+// The message the original reports when a Firefox import finished but had to
+// leave rows behind, e.g. "Skipped 12 unsupported or invalid Firefox cookies".
+std::string SkippedFirefoxCookiesMessage(int skipped);
+
+}  // namespace aside_importer
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_PROFILE_IMPORTER_H_
diff --git a/chrome/browser/ui/webui/aside_importer/safari_archive.cc b/chrome/browser/ui/webui/aside_importer/safari_archive.cc
new file mode 100644
index 0000000000..cbcf7ac593
--- /dev/null
+++ b/chrome/browser/ui/webui/aside_importer/safari_archive.cc
@@ -0,0 +1,170 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_importer/safari_archive.h"
+
+#include <map>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "third_party/zlib/google/zip.h"
+#include "url/gurl.h"
+
+namespace aside_importer {
+
+namespace {
+
+// A history export is a JSON object whose "history" member is the array of
+// visits; a payment card export uses "payment_cards" the same way. Reading the
+// top-level key is what tells the two .json files apart.
+constexpr char kHistoryKey[] = "history";
+constexpr char kPaymentCardsKey[] = "payment_cards";
+
+bool IsHiddenName(const base::FilePath& path) {
+  const std::string name = path.BaseName().AsUTF8Unsafe();
+  return name.empty() || name.front() == '.';
+}
+
+bool HasExtension(const base::FilePath& path, std::string_view extension) {
+  return base::EqualsCaseInsensitiveASCII(path.Extension(), extension);
+}
+
+// Which of the two JSON exports this file is, by its top-level array.
+std::string ClassifyJson(const base::FilePath& path) {
+  std::string contents;
+  // A history export can be large; only the head is needed to see which array
+  // the object opens with.
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, 64 * 1024) &&
+      contents.empty()) {
+    return std::string();
+  }
+  if (contents.find("\"" + std::string(kHistoryKey) + "\"") !=
+      std::string::npos) {
+    return kHistoryKey;
+  }
+  if (contents.find("\"" + std::string(kPaymentCardsKey) + "\"") !=
+      std::string::npos) {
+    return kPaymentCardsKey;
+  }
+  return std::string();
+}
+
+}  // namespace
+
+SafariArchive::SafariArchive() = default;
+SafariArchive::SafariArchive(SafariArchive&&) = default;
+SafariArchive& SafariArchive::operator=(SafariArchive&&) = default;
+SafariArchive::~SafariArchive() = default;
+
+bool SafariArchive::IsValid() const {
+  return !bookmarks_html.empty() || !history_json.empty() ||
+         !passwords_csv.empty() || !payment_cards_json.empty();
+}
+
+SafariArchive UnpackSafariArchive(const base::FilePath& zip) {
+  SafariArchive archive;
+  archive.dir = std::make_unique<base::ScopedTempDir>();
+  if (!archive.dir->CreateUniqueTempDir() ||
+      !zip::Unzip(zip, archive.dir->GetPath())) {
+    return archive;
+  }
+  base::FileEnumerator files(archive.dir->GetPath(), /*recursive=*/true,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    if (IsHiddenName(file)) {
+      continue;
+    }
+    if (HasExtension(file, ".html") && archive.bookmarks_html.empty()) {
+      archive.bookmarks_html = file;
+      continue;
+    }
+    if (HasExtension(file, ".csv") && archive.passwords_csv.empty()) {
+      archive.passwords_csv = file;
+      continue;
+    }
+    if (HasExtension(file, ".json")) {
+      const std::string kind = ClassifyJson(file);
+      if (kind == kHistoryKey && archive.history_json.empty()) {
+        archive.history_json = file;
+      } else if (kind == kPaymentCardsKey &&
+                 archive.payment_cards_json.empty()) {
+        archive.payment_cards_json = file;
+      }
+    }
+  }
+  return archive;
+}
+
+std::vector<user_data_importer::ImporterURLRow> ReadSafariHistory(
+    const base::FilePath& history_json) {
+  std::vector<user_data_importer::ImporterURLRow> rows;
+  if (history_json.empty()) {
+    return rows;
+  }
+  std::string contents;
+  if (!base::ReadFileToString(history_json, &contents)) {
+    return rows;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return rows;
+  }
+  const base::ListValue* history = parsed->GetDict().FindList(kHistoryKey);
+  if (!history) {
+    return rows;
+  }
+
+  // Safari records one entry per visit; this browser's history stores one row
+  // per URL with a visit count, so the entries are folded together here.
+  std::map<GURL, user_data_importer::ImporterURLRow> by_url;
+  for (const base::Value& value : *history) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const base::DictValue& entry = value.GetDict();
+    const std::string* url_string = entry.FindString("url");
+    if (!url_string) {
+      continue;
+    }
+    GURL url(*url_string);
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    auto [it, inserted] = by_url.try_emplace(url, url);
+    user_data_importer::ImporterURLRow& row = it->second;
+    if (const std::string* title = entry.FindString("title");
+        title && row.title.empty()) {
+      row.title = base::UTF8ToUTF16(*title);
+    }
+    ++row.visit_count;
+    // time_usec is microseconds since the Unix epoch and can exceed the range
+    // of an int, so it is read as a double the way JSON carries it.
+    std::optional<double> time_usec = entry.FindDouble("time_usec");
+    if (!time_usec) {
+      if (std::optional<int> as_int = entry.FindInt("time_usec")) {
+        time_usec = *as_int;
+      }
+    }
+    if (time_usec && *time_usec > 0) {
+      const base::Time visit =
+          base::Time::UnixEpoch() + base::Microseconds(*time_usec);
+      if (visit > row.last_visit) {
+        row.last_visit = visit;
+      }
+    }
+  }
+  rows.reserve(by_url.size());
+  for (auto& [url, row] : by_url) {
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
+
+}  // namespace aside_importer
