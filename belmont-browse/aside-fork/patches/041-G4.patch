+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_importer/chromium_profile_migrator.h"
+#include "chrome/browser/ui/webui/aside_importer/firefox_cookie_importer.h"
+#include "chrome/browser/ui/webui/aside_importer/firefox_profile_importer.h"
+
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+// Destroying the null scoped_refptr the migration takes needs the complete
+// Encryptor type at this call site.
+#include "components/os_crypt/async/common/encryptor.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aside_importer {
+namespace {
+
+// The page's browser ids and the enumeration round-trip.
+TEST(AsideImporterBrowserIdTest, RoundTrips) {
+  for (const char* id : {"arc", "brave", "atlas", "chrome", "comet", "dia",
+                         "edge", "chromium"}) {
+    std::optional<ChromiumBrowser> browser = ChromiumBrowserFromId(id);
+    ASSERT_TRUE(browser.has_value()) << id;
+    EXPECT_EQ(id, IdForChromiumBrowser(*browser));
+    EXPECT_FALSE(DisplayNameForChromiumBrowser(*browser).empty());
+  }
+  EXPECT_FALSE(ChromiumBrowserFromId("safari").has_value());
+  EXPECT_FALSE(ChromiumBrowserFromId("firefox").has_value());
+}
+
+class ChromiumProfileReadTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  void WriteLocalState(const base::DictValue& dict) {
+    std::string json;
+    ASSERT_TRUE(base::JSONWriter::Write(dict, &json));
+    ASSERT_TRUE(
+        base::WriteFile(dir_.GetPath().AppendASCII("Local State"), json));
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+// The display order is the source browser's, and a profile whose directory is
+// gone is not offered.
+TEST_F(ChromiumProfileReadTest, OrdersByProfilesOrderAndDropsMissingDirs) {
+  base::DictValue cache;
+  base::DictValue work;
+  work.Set("name", "Work");
+  work.Set("gaia_name", "Ada Lovelace");
+  cache.Set("Profile 1", std::move(work));
+  base::DictValue personal;
+  personal.Set("name", "Personal");
+  cache.Set("Default", std::move(personal));
+  base::DictValue gone;
+  gone.Set("name", "Deleted");
+  cache.Set("Profile 9", std::move(gone));
+
+  base::ListValue order;
+  order.Append("Profile 1");
+  order.Append("Default");
+  order.Append("Profile 9");
+
+  base::DictValue profile;
+  profile.Set("info_cache", std::move(cache));
+  profile.Set("profiles_order", std::move(order));
+  base::DictValue local_state;
+  local_state.Set("profile", std::move(profile));
+  WriteLocalState(local_state);
+
+  ASSERT_TRUE(base::CreateDirectory(dir_.GetPath().AppendASCII("Profile 1")));
+  ASSERT_TRUE(base::CreateDirectory(dir_.GetPath().AppendASCII("Default")));
+
+  std::vector<ChromiumProfileInfo> profiles =
+      ReadChromiumProfilesFromDirectory(dir_.GetPath());
+  ASSERT_EQ(2u, profiles.size());
+  EXPECT_EQ("Profile 1", profiles[0].id);
+  EXPECT_EQ("Ada Lovelace", profiles[0].name);
+  EXPECT_EQ(dir_.GetPath().AppendASCII("Profile 1"), profiles[0].path);
+  EXPECT_EQ("Default", profiles[1].id);
+  EXPECT_EQ("Personal", profiles[1].name);
+}
+
+// A Firefox originAttributes suffix parses as a query string.
+TEST(FirefoxOriginAttributesTest, ParsesAsQuery) {
+  const GURL url = OriginAttributesUrl("^userContextId=3&privateBrowsingId=0");
+  EXPECT_TRUE(url.is_valid());
+  EXPECT_EQ("firefox-origin-attributes.invalid", url.host());
+  EXPECT_EQ("userContextId=3&privateBrowsingId=0", url.query());
+}
+
+// A container cookie has no equivalent here and is left behind rather than
+// silently landing in the default jar.
+TEST(FirefoxCookieConversionTest, SkipsContainerCookies) {
+  FirefoxCookie cookie;
+  cookie.name = "sid";
+  cookie.value = "1";
+  cookie.host = "example.com";
+  cookie.path = "/";
+  cookie.expiry = base::Time::Now() + base::Days(1);
+  cookie.origin_attributes = "^userContextId=4";
+  EXPECT_EQ(nullptr, ConvertFirefoxCookie(cookie));
+
+  cookie.origin_attributes = "^userContextId=0";
+  EXPECT_NE(nullptr, ConvertFirefoxCookie(cookie));
+}
+
+// A domain cookie's leading dot names the same URL as the bare host.
+TEST(FirefoxCookieConversionTest, DomainCookieUrl) {
+  FirefoxCookie cookie;
+  cookie.host = ".example.com";
+  cookie.path = "/app";
+  cookie.is_secure = true;
+  EXPECT_EQ(GURL("https://example.com/app"), UrlForFirefoxCookie(cookie));
+
+  cookie.is_secure = false;
+  cookie.scheme_map = 1;  // http only
+  EXPECT_EQ(GURL("http://example.com/app"), UrlForFirefoxCookie(cookie));
+}
+
+TEST(FirefoxCookieConversionTest, SkippedMessage) {
+  EXPECT_EQ("", SkippedFirefoxCookiesMessage(0));
+  EXPECT_EQ("Skipped 12 unsupported or invalid Firefox cookies",
+            SkippedFirefoxCookiesMessage(12));
+}
+
+// A profile with no cookie store is not a failure.
+TEST(FirefoxCookieReadTest, MissingStoreIsNotAnError) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  FirefoxCookieResult result = ReadFirefoxCookies(dir.GetPath());
+  EXPECT_TRUE(result.ok);
+  EXPECT_TRUE(result.error.empty());
+  EXPECT_TRUE(result.cookies.empty());
+}
+
+// The migration refuses a source directory that is not there, in the wording
+// the page shows.
+TEST(ChromiumProfileMigrationTest, MissingSourceDirectory) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ChromiumProfileInfo profile;
+  profile.id = "Default";
+  profile.name = "Personal";
+  profile.path = dir.GetPath().AppendASCII("not-there");
+  MigrationResult result = MigrateChromiumProfile(
+      ChromiumBrowser::kChrome, profile, dir.GetPath().AppendASCII("target"),
+      "Personal", nullptr);
+  EXPECT_FALSE(result.ok);
+  EXPECT_EQ("Chrome profile directory does not exist: " +
+                profile.path.AsUTF8Unsafe(),
+            result.error);
+}
+
+// The copy leaves journals and per-extension storage behind and scrubs the
+// source installation's preference MACs.
+TEST(ChromiumProfileMigrationTest, CopiesAndScrubs) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath source = dir.GetPath().AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(source));
+  ASSERT_TRUE(base::WriteFile(source.AppendASCII("Bookmarks"), "{}"));
+  ASSERT_TRUE(base::WriteFile(source.AppendASCII("Cookies-journal"), "junk"));
+  ASSERT_TRUE(base::CreateDirectory(
+      source.AppendASCII("chrome-extension_abc_0.indexeddb.leveldb")));
+
+  base::DictValue prefs;
+  prefs.SetByDottedPath("protection.super_mac", "deadbeef");
+  prefs.SetByDottedPath("extensions.toolbar", base::ListValue());
+  prefs.SetByDottedPath("profile.name", "Old Name");
+  prefs.SetByDottedPath("browser.show_home_button", true);
+  std::string json;
+  ASSERT_TRUE(base::JSONWriter::Write(prefs, &json));
+  ASSERT_TRUE(base::WriteFile(source.AppendASCII("Preferences"), json));
+
+  ChromiumProfileInfo profile;
+  profile.id = "Default";
+  profile.name = "Personal";
+  profile.path = source;
+  const base::FilePath target = dir.GetPath().AppendASCII("target");
+  MigrationResult result = MigrateChromiumProfile(
+      ChromiumBrowser::kChrome, profile, target, "Imported Chrome", nullptr);
+  ASSERT_TRUE(result.ok) << result.error;
+
+  EXPECT_TRUE(base::PathExists(target.AppendASCII("Bookmarks")));
+  EXPECT_FALSE(base::PathExists(target.AppendASCII("Cookies-journal")));
+  EXPECT_FALSE(base::PathExists(
+      target.AppendASCII("chrome-extension_abc_0.indexeddb.leveldb")));
+
+  std::string copied;
+  ASSERT_TRUE(
+      base::ReadFileToString(target.AppendASCII("Preferences"), &copied));
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(copied, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed && parsed->is_dict());
+  const base::DictValue& out = parsed->GetDict();
+  EXPECT_EQ(nullptr, out.FindStringByDottedPath("protection.super_mac"));
+  EXPECT_EQ(nullptr, out.FindListByDottedPath("extensions.toolbar"));
+  EXPECT_EQ("Imported Chrome", *out.FindStringByDottedPath("profile.name"));
+  EXPECT_EQ(true, out.FindBoolByDottedPath("browser.show_home_button"));
+}
+
+}  // namespace
+}  // namespace aside_importer
