@@ -0,0 +1,194 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_omnibox/aside_omnibox_match_utils.h"
+
+#include "base/functional/bind.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace extensions {
+namespace {
+
+class LocalActionClient : public OmniboxAction::Client {
+ public:
+  void OpenSharingHub() override {}
+  void NewIncognitoWindow() override { ++incognito_requests; }
+  void OpenIncognitoClearBrowsingDataDialog() override {}
+  void CloseIncognitoWindows() override {}
+  void PromptPageTranslation() override {}
+  void OpenLensOverlay(bool show) override {}
+  void IssueContextualSearchRequest(const GURL&,
+                                   AutocompleteMatchType::Type,
+                                   bool) override {}
+  int incognito_requests = 0;
+};
+
+struct Navigation {
+  void Open(const GURL& destination, TemplateURLRef::PostContent*,
+            WindowOpenDisposition requested_disposition, ui::PageTransition,
+            AutocompleteMatchType::Type, base::TimeTicks, bool, bool,
+            const std::u16string&, const AutocompleteMatch&,
+            const AutocompleteMatch&) {
+    ++calls;
+    url = destination;
+    disposition = requested_disposition;
+  }
+  int calls = 0;
+  GURL url;
+  WindowOpenDisposition disposition = WindowOpenDisposition::UNKNOWN;
+};
+
+class IncognitoAction : public OmniboxAction {
+ public:
+  IncognitoAction() : OmniboxAction(LabelStrings(), GURL()) {}
+  void Execute(ExecutionContext& context) const override {
+    context.client_->NewIncognitoWindow();
+  }
+ private:
+  ~IncognitoAction() override = default;
+};
+
+class MutatingAction : public OmniboxAction {
+ public:
+  MutatingAction(base::RepeatingClosure mutation, bool* destroyed)
+      : OmniboxAction(LabelStrings(), GURL()),
+        mutation_(std::move(mutation)), destroyed_(destroyed) {}
+  void Execute(ExecutionContext& context) const override {
+    mutation_.Run();
+    EXPECT_FALSE(*destroyed_);
+    context.client_->NewIncognitoWindow();
+  }
+ private:
+  ~MutatingAction() override { *destroyed_ = true; }
+  base::RepeatingClosure mutation_;
+  raw_ptr<bool> destroyed_;
+};
+
+AutocompleteMatch Match() {
+  AutocompleteMatch match;
+  match.destination_url = GURL("https://suggestion.test/match");
+  match.actions.push_back(base::MakeRefCounted<OmniboxAction>(
+      OmniboxAction::LabelStrings(u"First", u"First action", u"", u""),
+      GURL("https://action.test/first")));
+  match.actions.push_back(base::MakeRefCounted<OmniboxAction>(
+      OmniboxAction::LabelStrings(u"Second", u"Second action", u"", u""),
+      GURL("https://action.test/second")));
+  return match;
+}
+
+TEST(AsideOmniboxActionsTest, ExecutesChosenActionInsteadOfMatchUrl) {
+  AutocompleteResult result;
+  result.AppendMatches({Match()});
+  LocalActionClient client;
+  Navigation navigation;
+  OmniboxAction::ExecutionContext context(client,
+      base::BindOnce(&Navigation::Open, base::Unretained(&navigation)),
+      base::TimeTicks::Now(), WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  ASSERT_TRUE(ExecuteAsideOmniboxAction(result, 0, 1, context));
+  EXPECT_EQ(navigation.calls, 1);
+  EXPECT_EQ(navigation.url, GURL("https://action.test/second"));
+  EXPECT_EQ(navigation.disposition, WindowOpenDisposition::NEW_BACKGROUND_TAB);
+}
+
+TEST(AsideOmniboxActionsTest, NonNavigationActionInvokesNativeClientCapability) {
+  auto match = Match();
+  match.actions[1] = base::MakeRefCounted<IncognitoAction>();
+  AutocompleteResult result;
+  result.AppendMatches({match});
+  LocalActionClient client;
+  Navigation navigation;
+  OmniboxAction::ExecutionContext context(client,
+      base::BindOnce(&Navigation::Open, base::Unretained(&navigation)),
+      base::TimeTicks::Now(), WindowOpenDisposition::CURRENT_TAB);
+  ASSERT_TRUE(ExecuteAsideOmniboxAction(result, 0, 1, context));
+  EXPECT_EQ(client.incognito_requests, 1);
+  EXPECT_EQ(navigation.calls, 0);
+}
+
+TEST(AsideOmniboxActionsTest, InvalidIndexesProduceNoAction) {
+  AutocompleteResult result;
+  result.AppendMatches({Match()});
+  LocalActionClient client;
+  Navigation navigation;
+  OmniboxAction::ExecutionContext context(client,
+      base::BindOnce(&Navigation::Open, base::Unretained(&navigation)),
+      base::TimeTicks::Now(), WindowOpenDisposition::CURRENT_TAB);
+  EXPECT_FALSE(ExecuteAsideOmniboxAction(result, 1, 0, context));
+  EXPECT_FALSE(ExecuteAsideOmniboxAction(result, 0, 2, context));
+  EXPECT_FALSE(ExecuteAsideOmniboxAction(result, 0, static_cast<size_t>(-1), context));
+  EXPECT_EQ(navigation.calls, 0);
+  EXPECT_EQ(client.incognito_requests, 0);
+}
+
+TEST(AsideOmniboxActionsTest, RejectsStaleUrlAndOutOfRangeLine) {
+  AutocompleteResult result;
+  result.AppendMatches({Match()});
+  auto request = base::DictValue().Set("line", 0).Set(
+      "url", "https://suggestion.test/match").Set("resultSequenceId", 7);
+  EXPECT_TRUE(FindAsideOmniboxMatch(result, request, 7));
+  request.Set("url", "https://suggestion.test/replaced");
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, request, 7));
+  request.Remove("url");
+  request.Set("line", -1);
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, request, 7));
+  request.Set("line", 1);
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, request, 7));
+  request.Remove("line");
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, request, 7));
+}
+
+TEST(AsideOmniboxActionsTest, RejectsOldSelectionAfterSameUrlActionReordering) {
+  AutocompleteResult result;
+  auto match = Match();
+  result.AppendMatches({match});
+  auto selection = base::DictValue().Set("line", 0).Set("resultSequenceId", 10);
+  EXPECT_TRUE(FindAsideOmniboxMatch(result, selection, 10));
+  // New results have the same URL and number of actions, but reverse meaning.
+  std::swap(match.actions[0], match.actions[1]);
+  result.Reset();
+  result.AppendMatches({match});
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, selection, 11));
+  selection.Set("url", match.destination_url.spec());
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, selection, 11));
+  selection.Set("resultSequenceId", 11);
+  EXPECT_TRUE(FindAsideOmniboxMatch(result, selection, 11));
+  selection.Remove("resultSequenceId");
+  EXPECT_FALSE(FindAsideOmniboxMatch(result, selection, 11));
+}
+
+TEST(AsideOmniboxActionsTest, RetainsActionWhenExecutionDestroysResults) {
+  AutocompleteResult result;
+  bool destroyed = false;
+  AutocompleteMatch match;
+  match.actions.push_back(base::MakeRefCounted<MutatingAction>(
+      base::BindRepeating(&AutocompleteResult::Reset, base::Unretained(&result)),
+      &destroyed));
+  result.AppendMatches({match});
+  match.actions.clear();
+  LocalActionClient client;
+  OmniboxAction::ExecutionContext context(client, {}, base::TimeTicks::Now(),
+                                         WindowOpenDisposition::CURRENT_TAB);
+  ASSERT_TRUE(ExecuteAsideOmniboxAction(result, 0, 0, context));
+  EXPECT_TRUE(destroyed);
+  EXPECT_TRUE(result.empty());
+  EXPECT_EQ(client.incognito_requests, 1);
+}
+
+TEST(AsideOmniboxActionsTest, ActionDescriptionsPreserveIndexAndOriginalUiLabels) {
+  auto match = Match();
+  auto descriptions = AsideOmniboxActionDescriptions(match);
+  ASSERT_EQ(descriptions.size(), 2u);
+  EXPECT_EQ(*descriptions[0].GetDict().FindString("hint"), "First");
+  EXPECT_EQ(*descriptions[1].GetDict().FindString("hint"), "Second");
+  match.actions[0] = nullptr;
+  descriptions = AsideOmniboxActionDescriptions(match);
+  ASSERT_EQ(descriptions.size(), 2u);
+  EXPECT_TRUE(descriptions[0].GetDict().empty());
+  EXPECT_EQ(*descriptions[1].GetDict().FindString("hint"), "Second");
+}
+
+}  // namespace
+}  // namespace extensions
