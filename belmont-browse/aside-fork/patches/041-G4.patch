+
+constexpr char kSafariInvalidZip[] = "This is not a valid Safari data ZIP file.";
+constexpr char kChromiumImportFailed[] = "Chromium browser import failed";
+
+// The page's ids for the two sources the utility-process importer handles.
+const char* BrowserIdForType(user_data_importer::ImporterType type) {
+  switch (type) {
+    case user_data_importer::TYPE_FIREFOX:
+      return "firefox";
+#if BUILDFLAG(IS_MAC)
+    case user_data_importer::TYPE_SAFARI:
+      return "safari";
+#endif
+#if BUILDFLAG(IS_WIN)
+    case user_data_importer::TYPE_EDGE:
+      return "edge";
+#endif
+    default:
+      return nullptr;
+  }
+}
+
+// Everything the source's picker needs, read off the disk in one blocking hop.
+struct ChromiumProfileList {
+  std::vector<aside_importer::ChromiumProfileInfo> profiles;
+};
+
+ChromiumProfileList ReadProfilesBlocking(
+    aside_importer::ChromiumBrowser browser) {
+  ChromiumProfileList list;
+  list.profiles = aside_importer::ReadChromiumProfiles(browser);
+  return list;
+}
+
+class AsideImportDataHandler : public content::WebUIMessageHandler,
+                               public ui::SelectFileDialog::Listener,
+                               public ui::SimpleMenuModel::Delegate {
+ public:
+  AsideImportDataHandler() = default;
+  ~AsideImportDataHandler() override { CancelPendingWork(); }
+
+  void OnJavascriptDisallowed() override { CancelPendingWork(); }
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "importFirefoxData",
+        base::BindRepeating(&AsideImportDataHandler::HandleImportFirefox,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "showProfilePicker",
+        base::BindRepeating(&AsideImportDataHandler::HandleShowProfilePicker,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "selectSafariExportZipFile",
+        base::BindRepeating(&AsideImportDataHandler::HandleSelectSafariZip,
+                            base::Unretained(this)));
+  }
+
+  // Detection has two halves: the utility-process importer finds Firefox (and
+  // Safari on macOS), and the Chromium-family browsers are found by looking
+  // for their user data directories, which is blocking work.
+  void DetectSources(base::OnceCallback<void(base::ListValue)> done) {
+    importer_list_ = std::make_unique<ImporterList>();
+    importer_list_->DetectSourceProfiles(
+        g_browser_process->GetApplicationLocale(),
+        /*include_interactive_profiles=*/false,
+        base::BindOnce(&AsideImportDataHandler::OnImporterListDetected,
+                       weak_factory_.GetWeakPtr(), std::move(done)));
+  }
+
+ private:
+  void CancelPendingWork() {
+    weak_factory_.InvalidateWeakPtrs();
+    pending_safari_archive_.Cancel();
+    if (select_file_dialog_) {
+      select_file_dialog_->ListenerDestroyed();
+      select_file_dialog_.reset();
+    }
+    menu_runner_.reset();
+    import_session_.reset();
+    safari_archive_ = aside_importer::SafariArchive();
+    migrating_ = false;
+  }
+
+  void OnImporterListDetected(base::OnceCallback<void(base::ListValue)> done) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&aside_importer::InstalledChromiumBrowserIds),
+        base::BindOnce(&AsideImportDataHandler::OnSourcesDetected,
+                       weak_factory_.GetWeakPtr(), std::move(done)));
+  }
+
+  void OnSourcesDetected(base::OnceCallback<void(base::ListValue)> done,
+                         std::vector<std::string> chromium_ids) {
+    base::ListValue ids;
+    for (size_t i = 0; importer_list_ && i < importer_list_->count(); ++i) {
+      if (const char* id = BrowserIdForType(
+              importer_list_->GetSourceProfileAt(i).importer_type)) {
+        ids.Append(id);
+      }
+    }
+    for (const std::string& id : chromium_ids) {
+      // Edge can be found by both halves on Windows; the page's list is a set.
+      bool duplicate = false;
+      for (const base::Value& value : ids) {
+        duplicate = duplicate || (value.is_string() && value.GetString() == id);
+      }
+      if (!duplicate) {
+        ids.Append(id);
+      }
+    }
+    std::move(done).Run(std::move(ids));
+  }
+
+  Profile* profile() { return Profile::FromWebUI(web_ui()); }
+
+  void Fail(const std::string& id, const std::string& message) {
+    if (IsJavascriptAllowed()) {
+      FireWebUIListener("browser-import-failed", base::Value(id),
+                        base::Value(message));
+    }
+  }
+
+  // --- Firefox -------------------------------------------------------------
+
+  void HandleImportFirefox(const base::ListValue& args) {
+    AllowJavascript();
+    StartImportOfType(user_data_importer::TYPE_FIREFOX, "firefox");
+  }
+
+  // --- Chromium family -----------------------------------------------------
+
+  void HandleShowProfilePicker(const base::ListValue& args) {
+    AllowJavascript();
+    const std::string id =
+        !args.empty() && args[0].is_string() ? args[0].GetString() : "chrome";
+    // The page passes the import button's bounds so the picker can sit under
+    // it, the way the original's popover does.
+    anchor_ = gfx::Rect();
+    if (args.size() >= 5) {
+      auto number = [&args](size_t index) {
+        return args[index].is_double() || args[index].is_int()
+                   ? static_cast<int>(args[index].GetDouble())
+                   : 0;
+      };
+      anchor_ = gfx::Rect(number(1), number(2), number(3), number(4));
+    }
+    std::optional<aside_importer::ChromiumBrowser> browser =
+        aside_importer::ChromiumBrowserFromId(id);
+    if (!browser) {
+      Fail(id, kChromiumImportFailed);
+      return;
+    }
+    if (migrating_ || (import_session_ && import_session_->importing())) {
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&ReadProfilesBlocking, *browser),
+        base::BindOnce(&AsideImportDataHandler::OnChromiumProfilesRead,
+                       weak_factory_.GetWeakPtr(), *browser));
+  }
+
+  void OnChromiumProfilesRead(aside_importer::ChromiumBrowser browser,
+                              ChromiumProfileList list) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    const std::string id = aside_importer::IdForChromiumBrowser(browser);
+    const std::string name =
+        aside_importer::DisplayNameForChromiumBrowser(browser);
+    if (list.profiles.empty()) {
+      Fail(id, base::StrCat({"No ", name,
+                             " profiles were found on this computer."}));
+      return;
+    }
+    if (list.profiles.size() == 1) {
+      OnChromiumImportTargetSelected(browser, list.profiles.front());
+      return;
+    }
+    ShowProfilePicker(browser, std::move(list.profiles));
+  }
+
+  // The original opens a native popover anchored to the import button. This
+  // is the same interaction: a native menu at the same place, listing the
+  // source's profiles in the source's own order.
+  void ShowProfilePicker(
+      aside_importer::ChromiumBrowser browser,
+      std::vector<aside_importer::ChromiumProfileInfo> profiles) {
+    content::WebContents* contents = web_ui()->GetWebContents();
+    views::Widget* widget =
+        contents ? views::Widget::GetTopLevelWidgetForNativeView(
+                       contents->GetNativeView())
+                 : nullptr;
+    if (!widget) {
+      // With no window to anchor to there is nothing to choose from, so the
+      // first profile is the one the source lists first.
+      OnChromiumImportTargetSelected(browser, profiles.front());
+      return;
+    }
+    picker_browser_ = browser;
+    picker_profiles_ = std::move(profiles);
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    for (size_t i = 0; i < picker_profiles_.size(); ++i) {
+      menu_model_->AddItem(static_cast<int>(i),
+                           base::UTF8ToUTF16(picker_profiles_[i].name));
+    }
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::COMBOBOX);
+    gfx::Rect anchor = anchor_;
+    anchor.Offset(contents->GetContainerBounds().OffsetFromOrigin());
+    menu_runner_->RunMenuAt(widget, /*button_controller=*/nullptr, anchor,
+                            views::MenuAnchorPosition::kTopLeft,
+                            ui::mojom::MenuSourceType::kNone);
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override { return false; }
+  bool IsCommandIdEnabled(int command_id) const override { return true; }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    const size_t index = static_cast<size_t>(command_id);
+    if (index >= picker_profiles_.size()) {
+      return;
+    }
+    OnChromiumImportTargetSelected(picker_browser_, picker_profiles_[index]);
+  }
+
+  void OnChromiumImportTargetSelected(
+      aside_importer::ChromiumBrowser browser,
+      const aside_importer::ChromiumProfileInfo& source) {
+    const std::string id = aside_importer::IdForChromiumBrowser(browser);
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (migrating_ || !manager) {
+      Fail(id, kChromiumImportFailed);
+      return;
+    }
+    migrating_ = true;
+    FireWebUIListener("browser-import-started", base::Value(id));
+    // A migration writes into a profile directory before anything loads it,
+    // so the path is reserved here and only opened once the copy is done.
+    const base::FilePath target = manager->GenerateNextProfileDirectoryPath();
+    g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+        &AsideImportDataHandler::OnEncryptorReady, weak_factory_.GetWeakPtr(),
+        browser, source, target));
+  }
+
+  void OnEncryptorReady(aside_importer::ChromiumBrowser browser,
+                        aside_importer::ChromiumProfileInfo source,
+                        base::FilePath target,
+                        scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+    const std::string name =
+        aside_importer::DisplayNameForChromiumBrowser(browser) + " - " +
+        source.name;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&aside_importer::MigrateChromiumProfile, browser,
+                       source, target, name, std::move(encryptor)),
+        base::BindOnce(&AsideImportDataHandler::OnChromiumProfileMigrated,
+                       weak_factory_.GetWeakPtr(), browser, target));
+  }
+
+  void OnChromiumProfileMigrated(aside_importer::ChromiumBrowser browser,
+                                 base::FilePath target,
+                                 aside_importer::MigrationResult result) {
+    const std::string id = aside_importer::IdForChromiumBrowser(browser);
+    if (!result.ok) {
+      DeleteTargetProfileIfNeeded(target);
+      migrating_ = false;
+      Fail(id, result.error);
+      return;
+    }
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (!manager) {
+      DeleteTargetProfileIfNeeded(target);
+      migrating_ = false;
+      Fail(id, kChromiumImportFailed);
+      return;
+    }
+    manager->CreateProfileAsync(
+        target,
+        base::BindOnce(&AsideImportDataHandler::MaybeSwitchToTargetProfile,
+                       weak_factory_.GetWeakPtr(), browser, target));
+  }
+
+  void MaybeSwitchToTargetProfile(aside_importer::ChromiumBrowser browser,
+                                  base::FilePath target,
+                                  Profile* imported) {
+    migrating_ = false;
+    const std::string id = aside_importer::IdForChromiumBrowser(browser);
+    if (!imported) {
+      DeleteTargetProfileIfNeeded(target);
+      Fail(id, kChromiumImportFailed);
+      return;
+    }
+    if (IsJavascriptAllowed()) {
+      FireWebUIListener("browser-import-succeeded", base::Value(id));
+    }
+    profiles::OpenBrowserWindowForProfile(base::OnceCallback<void(Browser*)>(),
+                                          /*always_create=*/true,
+                                          /*is_new_profile=*/true,
+                                          /*open_command_line_urls=*/false,
+                                          imported);
+  }
+
+  // A half-written profile directory must not be left behind for the profile
+  // picker to offer.
+  void DeleteTargetProfileIfNeeded(const base::FilePath& target) {
+    if (target.empty()) {
+      return;
+    }
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (manager && manager->GetProfileByPath(target)) {
+      manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+          target, base::OnceCallback<void(Profile*)>(),
+          ProfileMetrics::DELETE_PROFILE_ABORTED);
+      return;
+    }
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::GetDeletePathRecursivelyCallback(target));
+  }
+
+  // --- Safari --------------------------------------------------------------
+
+  void HandleSelectSafariZip(const base::ListValue& args) {
+    AllowJavascript();
+    if (select_file_dialog_ ||
+        !pending_safari_archive_.CanPick(import_session_ &&
+                                         import_session_->importing())) {
+      return;
+    }
+    select_file_dialog_ = ui::SelectFileDialog::Create(
+        this,
+        std::make_unique<ChromeSelectFilePolicy>(web_ui()->GetWebContents()));
+    ui::SelectFileDialog::FileTypeInfo types;
+    types.extensions = {{FILE_PATH_LITERAL("zip")}};
+    select_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+        base::FilePath(), &types, 0, FILE_PATH_LITERAL("zip"),
+        web_ui()->GetWebContents()->GetTopLevelNativeWindow());
+  }
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override {
+    select_file_dialog_.reset();
+    const auto generation = pending_safari_archive_.Begin(
+        import_session_ && import_session_->importing());
+    if (!generation) {
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&aside_importer::UnpackSafariArchive, file.path()),
+        base::BindOnce(&AsideImportDataHandler::OnSafariZipUnpacked,
+                       weak_factory_.GetWeakPtr(), *generation));
+  }
+  void FileSelectionCanceled() override { select_file_dialog_.reset(); }
+
+  void OnSafariZipUnpacked(uint64_t generation,
+                           aside_importer::SafariArchive archive) {
+    // Do not replace the storage backing an existing import. A stale or
+    // cancelled completion owns only its local temporary archive and drops it.
+    if (!pending_safari_archive_.Complete(
+            generation, import_session_ && import_session_->importing()) ||
+        !IsJavascriptAllowed()) {
+      return;
+    }
+    if (!archive.IsValid()) {
+      FireWebUIListener("safari-import-invalid-file",
+                        base::Value(kSafariInvalidZip));
+      return;
+    }
+    // History comes out of the export's JSON directly; bookmarks go through
+    // the bookmarks-file importer, which parses the same HTML this browser
+    // writes on export.
+    const base::FilePath history_json = archive.history_json;
+    safari_archive_ = std::move(archive);
+    if (!history_json.empty()) {
+      base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce(&aside_importer::ReadSafariHistory, history_json),
+          base::BindOnce(&AsideImportDataHandler::OnSafariHistoryRead,
+                         weak_factory_.GetWeakPtr()));
+    }
+    if (safari_archive_.bookmarks_html.empty()) {
+      // Nothing else to run through the importer; the history hop above (if
+      // any) reports on its own.
+      if (history_json.empty()) {
+        FireWebUIListener("safari-import-invalid-file",
+                          base::Value(kSafariInvalidZip));
+      }
+      return;
+    }
+    user_data_importer::SourceProfile source;
+    source.importer_type = user_data_importer::TYPE_BOOKMARKS_FILE;
+    source.source_path = safari_archive_.bookmarks_html;
+    StartImport(source, user_data_importer::FAVORITES, "safari");
+  }
+
+  void OnSafariHistoryRead(
+      std::vector<user_data_importer::ImporterURLRow> rows) {
+    if (rows.empty() || !profile()) {
+      return;
+    }
+    history::URLRows history_rows;
+    history_rows.reserve(rows.size());
+    for (const user_data_importer::ImporterURLRow& row : rows) {
+      history::URLRow entry(row.url);
+      entry.set_title(row.title);
+      entry.set_visit_count(row.visit_count);
+      entry.set_typed_count(row.typed_count);
+      entry.set_last_visit(row.last_visit);
+      entry.set_hidden(row.hidden);
+      history_rows.push_back(std::move(entry));
+    }
+    base::MakeRefCounted<ProfileWriter>(profile())->AddHistoryPage(
+        history_rows, history::SOURCE_SAFARI_IMPORTED);
+  }
+
+  // --- Utility-process importer --------------------------------------------
+
+  void StartImportOfType(user_data_importer::ImporterType type,
+                         const std::string& id) {
+    if (!importer_list_) {
+      Fail(id, kChromiumImportFailed);
+      return;
+    }
+    for (size_t i = 0; i < importer_list_->count(); ++i) {
+      const user_data_importer::SourceProfile& source =
+          importer_list_->GetSourceProfileAt(i);
+      if (source.importer_type == type) {
+        firefox_profile_path_ = type == user_data_importer::TYPE_FIREFOX
+                                    ? source.source_path
+                                    : base::FilePath();
+        StartImport(source,
+                    source.services_supported &
+                        (user_data_importer::HISTORY |
+                         user_data_importer::FAVORITES |
+                         user_data_importer::PASSWORDS |
+                         user_data_importer::SEARCH_ENGINES |
+                         user_data_importer::AUTOFILL_FORM_DATA),
+                    id);
+        return;
+      }
+    }
+    Fail(id, "No profile found for " + id);
+  }
+
+  void StartImport(const user_data_importer::SourceProfile& source,
+                   uint16_t items,
+                   const std::string& id) {
+    if (import_session_ && import_session_->importing()) {
+      return;
+    }
+    if (!items || !profile()) {
+      Fail(id, kChromiumImportFailed);
+      return;
+    }
+    FireWebUIListener("browser-import-started", base::Value(id));
+    // The session retains a non-owning host handle and cancels it when this
+    // page goes away. The host deletes itself on every terminal path.
+    auto* host = new ExternalProcessImporterHost();
+    import_session_ = std::make_unique<aside::ImportDataSession>(
+        host, items, id,
+        base::BindOnce(&AsideImportDataHandler::OnImportCompleted,
+                       weak_factory_.GetWeakPtr()));
+    host->StartImportSettings(source, profile(), items,
+                              new ProfileWriter(profile()));
+  }
+
+  void OnImportCompleted(aside::ImportDataResult result) {
+    safari_archive_ = aside_importer::SafariArchive();
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    if (result.state != aside::ImportDataResult::State::kSucceeded) {
+      FireWebUIListener("browser-import-failed", base::Value(result.source_id),
+                        base::Value(result.error_message));
+      return;
+    }
+    // The utility-process importer has no cookie step, so Firefox's cookie
+    // store is read here once the rest of the profile has landed.
+    if (result.source_id == "firefox" && !firefox_profile_path_.empty()) {
+      base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce(&aside_importer::PrepareFirefoxCookies,
+                         firefox_profile_path_),
+          base::BindOnce(&AsideImportDataHandler::OnFirefoxCookiesPrepared,
+                         weak_factory_.GetWeakPtr()));
+      return;
+    }
+    FireWebUIListener("browser-import-succeeded", base::Value(result.source_id));
+  }
+
+  void OnFirefoxCookiesPrepared(aside_importer::PreparedFirefoxCookies
+                                    prepared) {
+    if (profile() && !prepared.cookies.empty()) {
+      network::mojom::CookieManager* manager =
+          profile()->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+      net::CookieOptions options;
+      options.set_include_httponly();
+      options.set_same_site_cookie_context(
+          net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+      for (const net::CanonicalCookie& cookie : prepared.cookies) {
+        manager->SetCanonicalCookie(
+            cookie,
+            net::cookie_util::CookieOriginToURL(cookie.Domain(),
+                                                cookie.SecureAttribute()),
+            options, base::DoNothing());
+      }
+    }
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    // Cookies that could not be carried are reported alongside the success:
+    // the import did finish, but not everything came across.
+    FireWebUIListener("browser-import-succeeded", base::Value("firefox"));
+  }
+
+  std::unique_ptr<ImporterList> importer_list_;
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+  aside_importer::SafariArchive safari_archive_;
+  aside::PendingSafariArchive pending_safari_archive_;
+  std::unique_ptr<aside::ImportDataSession> import_session_;
+  base::FilePath firefox_profile_path_;
+
+  // Chromium-family picker state.
+  gfx::Rect anchor_;
+  bool migrating_ = false;
+  aside_importer::ChromiumBrowser picker_browser_ =
+      aside_importer::ChromiumBrowser::kChrome;
+  std::vector<aside_importer::ChromiumProfileInfo> picker_profiles_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+
+  base::WeakPtrFactory<AsideImportDataHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+AsideImportDataUI::AsideImportDataUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, kChromeUIAsideImportDataHost);
+  // Original packaging: the page, its script and its glyphs come out of
+  // resources.pak (825.1 aside_resources entries 16130-16141), not off disk.
+  webui::SetupWebUIDataSource(source, kAsideImportDataResources,
+                              IDR_ASIDE_IMPORT_DATA_INDEX_HTML);
+  source->UseStringsJs();
+  source->DisableTrustedTypesCSP();
+
+  auto handler = std::make_unique<AsideImportDataHandler>();
+  AsideImportDataHandler* raw = handler.get();
+  web_ui->AddMessageHandler(std::move(handler));
+  // installedBrowsers is read synchronously by the page; detection is async,
+  // so the page is served after detection through the data source's strings.
+  raw->DetectSources(base::BindOnce(
+      [](content::WebUIDataSource* source, base::ListValue ids) {
+        std::string json;
+        base::JSONWriter::Write(ids, &json);
+        source->AddString("installedBrowsers", json);
+      },
+      source));
+}
+
+AsideImportDataUI::~AsideImportDataUI() = default;
