new file mode 100644
index 0000000000..07b5db949a
--- /dev/null
+++ b/chrome/browser/resources/aside_import_data/BUILD.gn
@@ -0,0 +1,51 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# chrome://aside-import-data page assets. These are the original 825.1
+# aside_resources.pak entries 16130-16141 (index.html, app.js, the browser
+# glyphs and the Safari export guide), kept byte for byte and packed into
+# resources.pak the way the original does, so the page is served from the
+# resource bundle instead of files next to the binary.
+
+import("//chrome/common/features.gni")
+import("//tools/grit/grit_rule.gni")
+import("//ui/webui/resources/tools/generate_grd.gni")
+
+grit("resources") {
+  defines = chrome_grit_defines
+
+  enable_input_discovery_for_gn_analyze = false
+  source = "$target_gen_dir/resources.grd"
+  deps = [ ":build_grd" ]
+  outputs = [
+    "grit/aside_import_data_resources.h",
+    "grit/aside_import_data_resources_map.h",
+    "grit/aside_import_data_resources_map.cc",
+    "aside_import_data_resources.pak",
+  ]
+  output_dir = "$root_gen_dir/chrome"
+}
+
+generate_grd("build_grd") {
+  grd_prefix = "aside_import_data"
+  out_grd = "$target_gen_dir/resources.grd"
+
+  # Paths are the ones the original page requests: the icons under icons/ and
+  # the Safari walkthrough under images/.
+  input_files = [
+    "app.js",
+    "icons/arc.svg",
+    "icons/atlas.png",
+    "icons/check.svg",
+    "icons/chrome.svg",
+    "icons/comet.png",
+    "icons/dia.png",
+    "icons/edge.svg",
+    "icons/firefox.svg",
+    "icons/safari.png",
+    "images/safari_import_guide.png",
+    "index.html",
+  ]
+  input_files_base_dir = rebase_path(".", "//")
+}
