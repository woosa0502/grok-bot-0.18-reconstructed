+#include "url/gurl.h"
+
+class Profile;
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace views {
+class Widget;
+class WidgetDelegate;
+}  // namespace views
+
+namespace extensions {
+
+class Extension;
+class MiniPopupView;
+
+// Per-profile owner of the Aside mini popup window (replica of the original
+// AsideMiniPopupCoordinator: frameless always-on-top window hosting the
+// extension's minipopup.html, an options window the popup opens with
+// window.open(minipopup-options.html, "popup=yes"), the global shortcut that
+// toggles the popup, and a folder picker). The window is created on demand
+// (first SetState/SetSize/shortcut press).
+class MiniPopupService : public KeyedService,
+                         public content::WebContentsDelegate {
+ public:
+  explicit MiniPopupService(Profile* profile);
+  MiniPopupService(const MiniPopupService&) = delete;
+  MiniPopupService& operator=(const MiniPopupService&) = delete;
+  ~MiniPopupService() override;
+
+  static MiniPopupService* Get(content::BrowserContext* browser_context);
+
+  // Takes |contents| (a window.open child) when its opener is this profile's
+  // mini popup and hosts it in the options window. Returns false to let the
+  // regular extension tab path handle it.
+  static bool MaybeOpenOptionsWindow(
+      std::unique_ptr<content::WebContents>& contents,
+      const GURL& target_url,
+      const blink::mojom::WindowFeatures& window_features);
+
+  // Extension-API surface (asideMiniPopup.*):
+  void SetState(const Extension& extension, const std::string& state);
+  void SetSize(const Extension& extension, int width, int height);
+  void SetOptionWindowSize(int width, int height);
+  void Hide();
+
+  // Global shortcut: shows (creating if needed) or hides the popup.
+  void ToggleFromShortcut();
+  bool IsShowing() const;
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // content::WebContentsDelegate (options window contents):
+  void CloseContents(content::WebContents* source) override;
+  void SetContentsBounds(content::WebContents* source,
+                         const gfx::Rect& bounds) override;
+  void ActivateContents(content::WebContents* contents) override;
+
+ private:
+  // Creates and shows the window if not present. Returns false on failure.
+  bool EnsureWindow(const Extension& extension);
+  void ResizeTo(int width, int height);
+  void OpenOptionsWindow(std::unique_ptr<content::WebContents> contents,
+                         const GURL& target_url,
+                         const blink::mojom::WindowFeatures& window_features);
+  void CloseOptionsWindow();
+  void CloseOptionsWindowAndRestoreFocus();
+  const Extension* AsideExtension() const;
+
+  raw_ptr<Profile> profile_;
+  std::unique_ptr<views::WidgetDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<MiniPopupView> view_ = nullptr;
+
+  std::unique_ptr<content::WebContents> options_contents_;
+  std::unique_ptr<views::WidgetDelegate> options_delegate_;
+  std::unique_ptr<views::Widget> options_widget_;
+
+  base::WeakPtrFactory<MiniPopupService> weak_factory_{this};
+};
+
+}  // namespace extensions
