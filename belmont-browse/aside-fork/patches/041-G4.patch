+// static
+SecureRemoteDebuggingCredentials* SecureRemoteDebuggingCredentials::GetInstance() {
+  static base::NoDestructor<SecureRemoteDebuggingCredentials> instance;
+  return instance.get();
+}
+
+SecureRemoteDebuggingCredentials::SecureRemoteDebuggingCredentials() = default;
+SecureRemoteDebuggingCredentials::~SecureRemoteDebuggingCredentials() = default;
+
+std::optional<base::FilePath> SecureRemoteDebuggingCredentials::ResolveKeyPath()
+    const {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> env_path = env->GetVar("ASIDE_INSTALLATION_KEY");
+  if (env_path && !env_path->empty()) {
+    return base::FilePath::FromUTF8Unsafe(*env_path);
+  }
+  base::FilePath user_data_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir)) {
+    return std::nullopt;
+  }
+  const base::FilePath candidates[] = {
+      user_data_dir.Append(FILE_PATH_LITERAL("AsideInstallationKey")),
+      user_data_dir.Append(FILE_PATH_LITERAL("Default"))
+          .Append(FILE_PATH_LITERAL("AsideInstallationKey")),
+  };
+  for (const base::FilePath& path : candidates) {
+    if (base::PathExists(path)) {
+      return path;
+    }
+  }
+  return std::nullopt;
+}
+
+// Reads <key path>.meta, the portable stand-in for the aside.install.meta
+// Keychain item. Absent metadata means the default installation document.
+bool SecureRemoteDebuggingCredentials::LoadMetadata(
+    const base::FilePath& key_path) {
+  const base::FilePath meta_path = key_path.AddExtensionASCII("meta");
+  std::string contents;
+  if (!base::PathExists(meta_path)) {
+    scheme_ = kSchemeP256V1;
+    key_storage_ = kKeyStorageFile;
+    return true;
+  }
+  if (!base::ReadFileToString(meta_path, &contents)) {
+    error_ = "Unable to load installation verification key: " +
+             meta_path.AsUTF8Unsafe();
+    status_ = LoadStatus::kMetadataInvalid;
+    return false;
+  }
+  std::optional<base::Value> parsed = base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    error_ = "Failed to parse installation metadata.";
+    status_ = LoadStatus::kMetadataInvalid;
+    return false;
+  }
+  const base::DictValue& dict = parsed->GetDict();
+  const std::string* scheme = dict.FindString("scheme");
+  if (!scheme || scheme->empty()) {
+    error_ = "Installation metadata is missing scheme.";
+    status_ = LoadStatus::kMetadataIncomplete;
+    return false;
+  }
+  scheme_ = *scheme;
+  const std::string* key_storage = dict.FindString("key_storage");
+  key_storage_ = key_storage && !key_storage->empty() ? *key_storage
+                                                      : kKeyStorageFile;
+  // pq_v1 is the macOS 26 ML-DSA scheme; its keys live in the Keychain and are
+  // signed by the system, so it cannot be honoured here.
+  if (scheme_ == kSchemePqV1) {
+    error_ = "pq_v1 installation signatures require macOS 26 or newer";
+    status_ = LoadStatus::kSchemeUnsupported;
+    return false;
+  }
+  if (scheme_ != kSchemeP256V1) {
+    error_ = "Unsupported installation scheme.";
+    status_ = LoadStatus::kSchemeUnsupported;
+    return false;
+  }
+  if (key_storage_ != kKeyStorageFile) {
+    error_ = "Unsupported installation key storage.";
+    status_ = LoadStatus::kKeyStorageUnsupported;
+    return false;
+  }
+  return true;
+}
+
+bool SecureRemoteDebuggingCredentials::EnsureLoaded() {
+  if (load_attempted_) {
+    return private_key_der_.has_value();
+  }
+  load_attempted_ = true;
+  std::optional<base::FilePath> path = ResolveKeyPath();
+  if (!path) {
+    error_ = "Installation security is not initialized.";
+    status_ = LoadStatus::kNotInitialized;
+    return false;
+  }
+  if (!LoadMetadata(*path)) {
+    return false;
+  }
+  std::string contents;
+  if (!base::ReadFileToString(*path, &contents)) {
+    error_ = "Unable to load installation private key: " +
+             path->AsUTF8Unsafe();
+    status_ = LoadStatus::kKeyUnreadable;
+    return false;
+  }
+  std::vector<uint8_t> der(contents.begin(), contents.end());
+  if (!crypto::keypair::PrivateKey::FromPrivateKeyInfo(der)) {
+    error_ = "Unable to load installation signing key: " + path->AsUTF8Unsafe();
+    status_ = LoadStatus::kKeyUnreadable;
+    return false;
+  }
+  private_key_der_ = std::move(der);
+  status_ = LoadStatus::kOk;
+  return true;
+}
+
+std::string SecureRemoteDebuggingCredentials::scheme() {
+  EnsureLoaded();
+  return scheme_;
+}
+
+std::string SecureRemoteDebuggingCredentials::key_storage() {
+  EnsureLoaded();
+  return key_storage_;
+}
+
+std::string SecureRemoteDebuggingCredentials::StatusError() {
+  if (EnsureLoaded()) {
+    return std::string();
+  }
+  switch (status_) {
+    case LoadStatus::kOk:
+      return std::string();
+    case LoadStatus::kMetadataInvalid:
+      return "Installation security metadata is invalid.";
+    case LoadStatus::kMetadataIncomplete:
+      return "Installation security metadata is incomplete.";
+    case LoadStatus::kSchemeUnsupported:
+      return "Installation security scheme is unsupported.";
+    case LoadStatus::kKeyStorageUnsupported:
+      return "Installation security key storage is unsupported.";
+    case LoadStatus::kNotInitialized:
+    case LoadStatus::kKeyUnreadable:
+      return "Installation security is not initialized.";
+  }
+}
+
+bool SecureRemoteDebuggingCredentials::IsInitialized() {
+  return EnsureLoaded();
+}
+
+bool SecureRemoteDebuggingCredentials::Verify(
+    base::span<const uint8_t> challenge,
+    base::span<const uint8_t> signature) {
+  if (!EnsureLoaded()) {
+    return false;
+  }
+  std::optional<crypto::keypair::PrivateKey> key =
+      crypto::keypair::PrivateKey::FromPrivateKeyInfo(*private_key_der_);
+  if (!key) {
+    return false;
+  }
+  crypto::keypair::PublicKey public_key =
+      crypto::keypair::PublicKey::FromPrivateKey(*key);
+  std::vector<uint8_t> der_signature;
+  if (signature.size() == 64) {
+    der_signature = RawEcdsaToDer(signature.first<64>());
+    signature = der_signature;
+  }
+  return crypto::sign::Verify(crypto::sign::ECDSA_SHA256, public_key, challenge,
+                              signature);
+}
+
+std::optional<std::vector<uint8_t>> SecureRemoteDebuggingCredentials::Sign(
+    base::span<const uint8_t> data) {
+  if (!EnsureLoaded()) {
+    return std::nullopt;
+  }
+  std::optional<crypto::keypair::PrivateKey> key =
+      crypto::keypair::PrivateKey::FromPrivateKeyInfo(*private_key_der_);
+  if (!key) {
+    return std::nullopt;
+  }
+  return crypto::sign::Sign(crypto::sign::ECDSA_SHA256, *key, data);
+}
+
+std::optional<std::vector<uint8_t>>
+SecureRemoteDebuggingCredentials::ExportPublicKey() {
+  if (!EnsureLoaded()) {
+    return std::nullopt;
+  }
+  std::optional<crypto::keypair::PrivateKey> key =
+      crypto::keypair::PrivateKey::FromPrivateKeyInfo(*private_key_der_);
+  if (!key) {
+    error_ = "Failed to export installation public key.";
+    return std::nullopt;
+  }
+  return crypto::keypair::PublicKey::FromPrivateKey(*key)
+      .ToSubjectPublicKeyInfo();
+}
diff --git a/chrome/browser/devtools/secure_remote_debugging_credentials.h b/chrome/browser/devtools/secure_remote_debugging_credentials.h
new file mode 100644
index 0000000000..7fb7095c51
--- /dev/null
+++ b/chrome/browser/devtools/secure_remote_debugging_credentials.h
@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_SECURE_REMOTE_DEBUGGING_CREDENTIALS_H_
+#define CHROME_BROWSER_DEVTOOLS_SECURE_REMOTE_DEBUGGING_CREDENTIALS_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/no_destructor.h"
+
+// The installation identity used by Aside's secure remote debugging handshake.
+//
+// RE (chrome/browser/devtools/secure_remote_debugging_credentials_mac.mm and
+// the SecureRemoteDebugging log target): the original keeps three Keychain
+// items in access group 8CPD4K4TBB.at.studio.AsideBrowser.cryptography --
+// aside.install (the private key), aside.install.sig (the signature) and
+// aside.install.meta (a metadata document naming the signature scheme and the
+// key storage). Two schemes exist: p256_v1 (ECDSA P-256 / SHA-256, what the
+// daemon's native helper produces) and pq_v1, the macOS 26 ML-DSA scheme.
+//
+// This portable implementation keeps the file-key approach: the P-256 key is a
+// PKCS#8 DER file at $ASIDE_INSTALLATION_KEY, else <user data dir>/
+// AsideInstallationKey, else <user data dir>/Default/AsideInstallationKey (the
+// same file the asideAccount.signDaemonAuthChallenge API reads for the default
+// profile). The metadata document is the JSON file <key path>.meta; when it is
+// absent the installation is read as {version: 1, scheme: "p256_v1",
+// key_storage: "file"}.
+//
+// Keychain storage and pq_v1 signing are macOS-only and are reported here with
+// the original's wording rather than emulated.
+class SecureRemoteDebuggingCredentials {
+ public:
+  // Signature schemes the original knows about.
+  static constexpr char kSchemeP256V1[] = "p256_v1";
+  static constexpr char kSchemePqV1[] = "pq_v1";
+  // Key storage backends. "keychain" is the original's macOS storage.
+  static constexpr char kKeyStorageFile[] = "file";
+  static constexpr char kKeyStorageKeychain[] = "keychain";
+
+  static SecureRemoteDebuggingCredentials* GetInstance();
+
+  SecureRemoteDebuggingCredentials(const SecureRemoteDebuggingCredentials&) =
+      delete;
+  SecureRemoteDebuggingCredentials& operator=(
+      const SecureRemoteDebuggingCredentials&) = delete;
+
+  // The installation's signature scheme, from the metadata document. Empty
+  // when the installation could not be read.
+  std::string scheme();
+
+  // The installation's key storage backend, from the metadata document.
+  std::string key_storage();
+
+  // True once the installation key could be loaded under a supported scheme
+  // and key storage.
+  bool IsInitialized();
+
+  // Verifies a signature over `challenge` under the installation's scheme.
+  // For p256_v1 this is ECDSA P-256/SHA-256, accepting both the 64-byte raw
+  // r||s form (CryptoKit rawRepresentation) and DER.
+  bool Verify(base::span<const uint8_t> challenge,
+              base::span<const uint8_t> signature);
+
+  // Signs `data` with the installation private key (DER signature).
+  std::optional<std::vector<uint8_t>> Sign(base::span<const uint8_t> data);
+
+  // SubjectPublicKeyInfo of the installation verification key.
+  std::optional<std::vector<uint8_t>> ExportPublicKey();
+
+  // Last load error, in the loader's wording ("Unable to load installation
+  // private key: ...", "Failed to parse installation metadata." etc.).
+  const std::string& error() const { return error_; }
+
+  // The same condition in the wording the handshake reports to a client
+  // ("Installation security is not initialized.", "Installation security
+  // scheme is unsupported." etc.). Empty when the installation is usable.
+  std::string StatusError();
+
+ private:
+  friend class base::NoDestructor<SecureRemoteDebuggingCredentials>;
+
+  // Why the installation could not be used, mapped to the two wordings above.
+  enum class LoadStatus {
+    kOk,
+    kNotInitialized,
+    kMetadataInvalid,
+    kMetadataIncomplete,
+    kSchemeUnsupported,
+    kKeyStorageUnsupported,
+    kKeyUnreadable,
+  };
+
+  SecureRemoteDebuggingCredentials();
+  ~SecureRemoteDebuggingCredentials();
+
+  bool EnsureLoaded();
+  bool LoadMetadata(const base::FilePath& key_path);
+  std::optional<base::FilePath> ResolveKeyPath() const;
+
+  bool load_attempted_ = false;
+  LoadStatus status_ = LoadStatus::kNotInitialized;
+  std::string scheme_;
+  std::string key_storage_;
+  std::optional<std::vector<uint8_t>> private_key_der_;
+  std::string error_;
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_SECURE_REMOTE_DEBUGGING_CREDENTIALS_H_
