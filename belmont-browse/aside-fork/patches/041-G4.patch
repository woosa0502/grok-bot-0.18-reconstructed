+bool IsChromiumBrowserInstalled(ChromiumBrowser browser) {
+  const base::FilePath dir = UserDataDirectoryFor(browser);
+  if (dir.empty()) {
+    return false;
+  }
+  return base::PathExists(dir.Append(FILE_PATH_LITERAL("Local State"))) ||
+         base::PathExists(dir.Append(FILE_PATH_LITERAL("Default")));
+}
+
+std::vector<std::string> InstalledChromiumBrowserIds() {
+  static constexpr ChromiumBrowser kAll[] = {
+      ChromiumBrowser::kChrome, ChromiumBrowser::kEdge,
+      ChromiumBrowser::kArc,    ChromiumBrowser::kAtlas,
+      ChromiumBrowser::kComet,  ChromiumBrowser::kDia,
+      ChromiumBrowser::kBrave,  ChromiumBrowser::kChromium,
+  };
+  std::vector<std::string> ids;
+  for (ChromiumBrowser browser : kAll) {
+    if (IsChromiumBrowserInstalled(browser)) {
+      ids.push_back(IdForChromiumBrowser(browser));
+    }
+  }
+  return ids;
+}
