+TEST_F(DevToolsAgentHostImplTest, AsideTakeoverPreservesOrdinaryDeveloperTools) {
+  auto agent = DevToolsAgentHost::GetOrCreateFor(web_contents());
+  AsideSessionTestClient developer(false);
+  AsideSessionTestClient aside(true);
+  AsideSessionObserver observer(agent.get());
+  DevToolsAgentHost::AddObserver(&observer);
+  ASSERT_TRUE(agent->AttachClient(&developer));
+  EXPECT_FALSE(agent->HasSecureRemoteDebuggingSession());
+  EXPECT_EQ(1, observer.attached);
+  EXPECT_EQ(0, observer.secure_changes);
+  ASSERT_TRUE(agent->AttachClient(&aside));
+  EXPECT_TRUE(agent->HasSecureRemoteDebuggingSession());
+  EXPECT_EQ(1, observer.attached);
+  EXPECT_EQ(1, observer.secure_changes);
+  agent->ForceDetachSecureRemoteDebuggingSessions();
+  EXPECT_TRUE(aside.closed);
+  EXPECT_FALSE(developer.closed);
+  EXPECT_FALSE(agent->HasSecureRemoteDebuggingSession());
+  EXPECT_TRUE(agent->IsAttached());
+  EXPECT_EQ(0, observer.detached);
+  EXPECT_EQ(2, observer.secure_changes);
+  EXPECT_TRUE(agent->DetachClient(&developer));
+  EXPECT_FALSE(agent->IsAttached());
+  EXPECT_EQ(1, observer.detached);
+  EXPECT_EQ(2, observer.secure_changes);
+  DevToolsAgentHost::RemoveObserver(&observer);
+}
