diff --git a/chrome/browser/aside_adblock/aside_adblock_procedural.cc b/chrome/browser/aside_adblock/aside_adblock_procedural.cc
new file mode 100644
index 0000000000..08653c6330
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_procedural.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_procedural.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+
+namespace aside_adblock {
+
+namespace {
+
+struct OperatorSpec {
+  std::string_view name;  // pseudo-class name without the leading ':'
+  bool is_action;
+};
+
+// Longer names first where one is a prefix of another.
+constexpr OperatorSpec kOperators[] = {
+    {"matches-css-before", false}, {"matches-css-after", false},
+    {"matches-css", false},        {"matches-attr", false},
+    {"matches-path", false},       {"min-text-length", false},
+    {"has-text", false},           {"upward", false},
+    {"xpath", false},              {"remove-attr", true},
+    {"remove-class", true},        {"remove", true},
+    {"style", true},
+};
+
+// Index of the closing ')' matching the '(' at |open|, or npos.
+size_t FindClosingParen(std::string_view s, size_t open) {
+  int depth = 0;
+  char quote = 0;
+  for (size_t i = open; i < s.size(); ++i) {
+    const char c = s[i];
+    if (quote) {
+      if (c == '\\' && i + 1 < s.size()) {
+        ++i;
+      } else if (c == quote) {
+        quote = 0;
+      }
+      continue;
+    }
+    if (c == '"' || c == '\'') {
+      quote = c;
+    } else if (c == '(') {
+      ++depth;
+    } else if (c == ')') {
+      if (--depth == 0) {
+        return i;
+      }
+    }
+  }
+  return std::string_view::npos;
+}
+
+}  // namespace
+
+ProceduralParse ParseProceduralSelector(std::string_view selector,
+                                        std::string* normalized,
+                                        std::string* json) {
+  std::string s(selector);
+  base::ReplaceSubstringsAfterOffset(&s, 0, ":-abp-has(", ":has(");
+  base::ReplaceSubstringsAfterOffset(&s, 0, ":-abp-contains(", ":has-text(");
+  *normalized = s;
+  json->clear();
+
+  base::ListValue chain;
+  std::optional<base::DictValue> action;
+  size_t segment_start = 0;
+  int depth = 0;
+  char quote = 0;
+  std::vector<std::string> css_segments;
+  for (size_t i = 0; i < s.size(); ++i) {
+    const char c = s[i];
+    if (quote) {
+      if (c == '\\' && i + 1 < s.size()) {
+        ++i;
+      } else if (c == quote) {
+        quote = 0;
+      }
+      continue;
+    }
+    if (c == '"' || c == '\'') {
+      quote = c;
+      continue;
+    }
+    if (c == '(' || c == '[') {
+      ++depth;
+      continue;
+    }
+    if (c == ')' || c == ']') {
+      --depth;
+      continue;
+    }
+    if (c != ':' || depth != 0) {
+      continue;
+    }
+    std::string_view rest = std::string_view(s).substr(i + 1);
+    const OperatorSpec* spec = nullptr;
+    for (const OperatorSpec& candidate : kOperators) {
+      if (rest.starts_with(candidate.name) &&
+          rest.size() > candidate.name.size() &&
+          rest[candidate.name.size()] == '(') {
+        spec = &candidate;
+        break;
+      }
+    }
+    if (!spec) {
+      continue;
+    }
+    if (action) {
+      return ProceduralParse::kUnsupported;  // operator after an action
+    }
+    const size_t open = i + 1 + spec->name.size();
+    const size_t close = FindClosingParen(s, open);
+    if (close == std::string::npos) {
+      return ProceduralParse::kUnsupported;
+    }
+    std::string css = s.substr(segment_start, i - segment_start);
+    if (!css.empty()) {
+      css_segments.push_back(css);
+      base::DictValue step;
+      step.Set("type", "css-selector");
+      step.Set("arg", css);
+      chain.Append(std::move(step));
+    }
+    std::string arg = s.substr(open + 1, close - open - 1);
+    if (spec->is_action) {
+      base::DictValue a;
+      a.Set("type", std::string(spec->name));
+      if (!(spec->name == "remove" && arg.empty())) {
+        a.Set("arg", arg);
+      }
+      action = std::move(a);
+    } else {
+      base::DictValue step;
+      step.Set("type", std::string(spec->name));
+      step.Set("arg", arg);
+      chain.Append(std::move(step));
+    }
+    i = close;
+    segment_start = close + 1;
+  }
+  std::string tail = s.substr(segment_start);
+  if (chain.empty() && !action) {
+    // No top-level procedural operator: a plain selector, exactly as
+    // adblock-rust's validate_css_selector (0.13.3) decides. Procedural
+    // pseudo-classes nested inside :has()/:not() or :-abp-properties() are
+    // passed through as CSS text; the page's CSS parser drops them (verified
+    // against adblock-rust: all 72 such EasyList lines come back as plain
+    // hide_selectors, none as procedural actions, none rejected).
+    return ProceduralParse::kPlain;
+  }
+  if (!base::TrimWhitespaceASCII(tail, base::TRIM_ALL).empty()) {
+    if (action) {
+      return ProceduralParse::kUnsupported;  // selector text after an action
+    }
+    css_segments.push_back(tail);
+    base::DictValue step;
+    step.Set("type", "css-selector");
+    step.Set("arg", tail);
+    chain.Append(std::move(step));
+  }
+  // Nested procedural operators inside a css-selector step are kept as text
+  // (adblock-rust does the same; querySelectorAll then matches nothing).
+  if (chain.empty()) {
+    return ProceduralParse::kUnsupported;  // action without a selector
+  }
+  base::DictValue rule;
+  rule.Set("selector", std::move(chain));
+  if (action) {
+    rule.Set("action", std::move(*action));
+  }
+  base::JSONWriter::Write(rule, json);
+  return ProceduralParse::kProcedural;
+}
+
+}  // namespace aside_adblock
diff --git a/chrome/browser/aside_adblock/aside_adblock_procedural.h b/chrome/browser/aside_adblock/aside_adblock_procedural.h
new file mode 100644
index 0000000000..0bd4ad2617
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_procedural.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Procedural cosmetic selectors (uBO / ABP extended syntax) → the JSON rule
+// the original's cosmetic script runs:
+//   {"selector":[{"type":"css-selector","arg":".a"},
+//                {"type":"has-text","arg":"/Sponsored/"}],
+//    "action":{"type":"style","arg":"..."}}
+// Operators the script accepts: css-selector, has-text, matches-attr,
+// matches-css, matches-css-before, matches-css-after, matches-path,
+// min-text-length, upward, xpath; actions: remove, style, remove-attr,
+// remove-class. Pure function (//base only), shared with the classifier.
+
+#ifndef CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROCEDURAL_H_
+#define CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROCEDURAL_H_
+
+#include <string>
+#include <string_view>
+
+namespace aside_adblock {
+
+enum class ProceduralParse {
+  kPlain,        // no procedural operator: use |normalized| as a CSS selector
+  kProcedural,   // |json| holds the rule for the cosmetic script
+  kUnsupported,  // nested procedural operators, :-abp-properties, ...
+};
+
+// |normalized| gets ABP aliases rewritten (:-abp-has → :has,
+// :-abp-contains → :has-text) for the plain case.
+ProceduralParse ParseProceduralSelector(std::string_view selector,
+                                        std::string* normalized,
+                                        std::string* json);
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_BROWSER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_PROCEDURAL_H_
diff --git a/chrome/browser/aside_adblock/aside_adblock_proxying_url_loader_factory.cc b/chrome/browser/aside_adblock/aside_adblock_proxying_url_loader_factory.cc
new file mode 100644
index 0000000000..f4896f051e
--- /dev/null
+++ b/chrome/browser/aside_adblock/aside_adblock_proxying_url_loader_factory.cc
@@ -0,0 +1,297 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/aside_adblock/aside_adblock_proxying_url_loader_factory.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/aside_adblock/aside_adblock_service.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/render_frame_host.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_version.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/parsed_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/mojom/early_hints.mojom.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace aside_adblock {
+
+// Answers a blocked request with a $redirect resource. Self-owned; goes away
+// when either end disconnects.
+class AsideAdBlockProxyingURLLoaderFactory::ResourceLoader
+    : public network::mojom::URLLoader {
+ public:
+  ResourceLoader(mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+                 mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+                 const Resource& resource)
+      : receiver_(this, std::move(receiver)), client_(std::move(client)) {
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &ResourceLoader::OnDisconnect, base::Unretained(this)));
+    client_.set_disconnect_handler(base::BindOnce(
+        &ResourceLoader::OnDisconnect, base::Unretained(this)));
+
+    const size_t size = resource.body.size();
+    auto head = network::mojom::URLResponseHead::New();
+    head->headers =
+        net::HttpResponseHeaders::Builder(net::HttpVersion(1, 1), "200 OK")
+            .AddHeader("Content-Type", resource.mime)
+            .AddHeader("Content-Length", base::NumberToString(size))
+            .AddHeader("Access-Control-Allow-Origin", "*")
+            .AddHeader("Cache-Control", "no-store")
+            .Build();
+    head->mime_type = resource.mime;
+    head->content_length = static_cast<int64_t>(size);
+    head->request_start = base::TimeTicks::Now();
+    head->response_start = head->request_start;
+    head->response_time = base::Time::Now();
+    head->original_response_time = head->response_time;
+
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    const uint32_t capacity =
+        static_cast<uint32_t>(std::max<size_t>(size, 64u));
+    if (mojo::CreateDataPipe(capacity, producer, consumer) !=
+        MOJO_RESULT_OK) {
+      client_->OnComplete(network::URLLoaderCompletionStatus(net::ERR_FAILED));
+      return;
+    }
+    if (size > 0) {
+      producer->WriteAllData(base::as_byte_span(resource.body));
+    }
+    producer.reset();
+    client_->OnReceiveResponse(std::move(head), std::move(consumer),
+                               std::nullopt);
+    network::URLLoaderCompletionStatus status(net::OK);
+    status.encoded_data_length = static_cast<int64_t>(size);
+    status.encoded_body_length = static_cast<int64_t>(size);
+    status.decoded_body_length = static_cast<int64_t>(size);
+    client_->OnComplete(status);
+  }
+  ResourceLoader(const ResourceLoader&) = delete;
+  ResourceLoader& operator=(const ResourceLoader&) = delete;
+  ~ResourceLoader() override = default;
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams,
+                      const std::optional<GURL>&) override {}
+  void SetPriority(net::RequestPriority, int32_t) override {}
+
+ private:
+  void OnDisconnect() { delete this; }
+
+  mojo::Receiver<network::mojom::URLLoader> receiver_;
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+};
+
+// Forwards a navigation's URLLoaderClient traffic, adding the $csp header to
+// the document response. Self-owned.
+class AsideAdBlockProxyingURLLoaderFactory::NavigationClient
+    : public network::mojom::URLLoaderClient {
+ public:
+  NavigationClient(
+      base::WeakPtr<AsideAdBlockService> service,
+      const GURL& url,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> original,
+      mojo::PendingReceiver<network::mojom::URLLoaderClient> receiver)
+      : service_(std::move(service)),
+        url_(url),
+        original_(std::move(original)),
+        receiver_(this, std::move(receiver)) {
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &NavigationClient::OnDisconnect, base::Unretained(this)));
+    original_.set_disconnect_handler(base::BindOnce(
+        &NavigationClient::OnDisconnect, base::Unretained(this)));
+  }
+  NavigationClient(const NavigationClient&) = delete;
+  NavigationClient& operator=(const NavigationClient&) = delete;
+  ~NavigationClient() override = default;
+
+  // network::mojom::URLLoaderClient:
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    original_->OnReceiveEarlyHints(std::move(hints));
+  }
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> cached_metadata) override {
+    if (service_ && head && head->headers) {
+      const std::string csp = service_->CspForDocument(url_);
+      if (!csp.empty()) {
+        VLOG(1) << "AsideAdBlock: $csp for " << url_.spec() << ": " << csp;
+        head->headers->AddHeader("Content-Security-Policy", csp);
+        head->parsed_headers =
+            network::PopulateParsedHeaders(head->headers.get(), url_);
+      }
+    }
+    original_->OnReceiveResponse(std::move(head), std::move(body),
+                                 std::move(cached_metadata));
+  }
+  void OnReceiveRedirect(const net::RedirectInfo& redirect_info,
+                         network::mojom::URLResponseHeadPtr head) override {
+    url_ = redirect_info.new_url;
+    original_->OnReceiveRedirect(redirect_info, std::move(head));
+  }
+  void OnUploadProgress(int64_t current_position,
+                        int64_t total_size,
+                        OnUploadProgressCallback callback) override {
+    original_->OnUploadProgress(current_position, total_size,
+                                std::move(callback));
+  }
+  void OnTransferSizeUpdated(int32_t transfer_size_diff) override {
+    original_->OnTransferSizeUpdated(transfer_size_diff);
+  }
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    original_->OnComplete(status);
+  }
+
+ private:
+  void OnDisconnect() { delete this; }
+
+  base::WeakPtr<AsideAdBlockService> service_;
+  GURL url_;
+  mojo::Remote<network::mojom::URLLoaderClient> original_;
+  mojo::Receiver<network::mojom::URLLoaderClient> receiver_;
+};
+
+// static
+void AsideAdBlockProxyingURLLoaderFactory::MaybeProxy(
+    content::BrowserContext* browser_context,
+    content::RenderFrameHost* frame,
+    bool is_navigation,
+    network::URLLoaderFactoryBuilder& factory_builder) {
+  AsideAdBlockService* service = AsideAdBlockService::Get(browser_context);
+  if (!service) {
+    return;
+  }
+  std::optional<url::Origin> frame_origin;
+  if (frame) {
+    frame_origin = frame->GetLastCommittedOrigin();
+  }
+  auto [proxied_receiver, target_remote] = factory_builder.Append();
+  VLOG(1) << "AsideAdBlock: proxying URLLoaderFactory"
+          << (is_navigation ? " (navigation)" : "") << " for "
+          << (frame ? frame->GetLastCommittedURL().spec() : "(no frame)")
+          << " origin="
+          << (frame_origin ? frame_origin->Serialize() : "(none)");
+  // Self-owned; deleted on disconnect of all receivers or the target.
+  new AsideAdBlockProxyingURLLoaderFactory(
+      service->GetWeakPtr(), std::move(frame_origin), is_navigation,
+      std::move(proxied_receiver), std::move(target_remote));
+}
+
+AsideAdBlockProxyingURLLoaderFactory::AsideAdBlockProxyingURLLoaderFactory(
+    base::WeakPtr<AsideAdBlockService> service,
+    std::optional<url::Origin> frame_origin,
+    bool is_navigation,
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target)
+    : service_(std::move(service)),
+      frame_origin_(std::move(frame_origin)),
+      is_navigation_(is_navigation) {
+  target_.Bind(std::move(target));
+  target_.set_disconnect_handler(
+      base::BindOnce(&AsideAdBlockProxyingURLLoaderFactory::OnDisconnect,
+                     base::Unretained(this)));
+  receivers_.Add(this, std::move(receiver));
+  receivers_.set_disconnect_handler(
+      base::BindRepeating(&AsideAdBlockProxyingURLLoaderFactory::OnDisconnect,
+                          base::Unretained(this)));
+}
+
+AsideAdBlockProxyingURLLoaderFactory::~AsideAdBlockProxyingURLLoaderFactory() =
+    default;
+
+void AsideAdBlockProxyingURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  if (!service_) {
+    VLOG(2) << "AsideAdBlock: no service for " << request.url.spec();
+  }
+  if (is_navigation_) {
+    // Blocking happens in AsideAdBlockNavigationThrottle; here only $csp.
+    if (service_ && service_->HasCspRules() &&
+        request.url.SchemeIsHTTPOrHTTPS()) {
+      mojo::PendingRemote<network::mojom::URLLoaderClient> proxy_client;
+      auto receiver = proxy_client.InitWithNewPipeAndPassReceiver();
+      new NavigationClient(service_, request.url, std::move(client),
+                           std::move(receiver));
+      client = std::move(proxy_client);
+    }
+    target_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                  request, std::move(client),
+                                  traffic_annotation);
+    return;
+  }
+  // Note: |is_outermost_main_frame| marks requests *made by* the top-level
+  // document (used for client hints), not navigations, so it must not be used
+  // to skip requests here. Document navigations never reach this factory.
+  if (service_ && request.url.SchemeIsHTTPOrHTTPS() &&
+      request.destination != network::mojom::RequestDestination::kDocument) {
+    url::Origin initiator;
+    if (request.request_initiator) {
+      initiator = *request.request_initiator;
+    } else if (frame_origin_) {
+      initiator = *frame_origin_;
+    }
+    MatchResult result = service_->Evaluate(
+        request.url, initiator,
+        ElementTypeForDestination(request.destination),
+        /*is_document=*/false, request.method);
+    VLOG(2) << "AsideAdBlock: " << request.url.spec() << " initiator="
+            << initiator.Serialize() << " dest="
+            << static_cast<int>(request.destination) << " -> "
+            << (result.should_block ? "BLOCK " + result.filter : "allow")
+            << (result.redirect_resource.empty()
+                    ? ""
+                    : " redirect=" + result.redirect_resource);
+    if (result.should_block) {
+      if (!result.redirect_resource.empty()) {
+        if (const Resource* resource =
+                service_->FindResource(result.redirect_resource)) {
+          new ResourceLoader(std::move(loader), std::move(client), *resource);
+          return;
+        }
+      }
+      mojo::Remote<network::mojom::URLLoaderClient> remote(std::move(client));
+      remote->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+  }
+  target_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                request, std::move(client),
+                                traffic_annotation);
+}
+
+void AsideAdBlockProxyingURLLoaderFactory::Clone(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+  receivers_.Add(this, std::move(receiver));
+}
+
+void AsideAdBlockProxyingURLLoaderFactory::OnDisconnect() {
+  if (!target_.is_connected() || receivers_.empty()) {
+    delete this;
+  }
+}
+
+}  // namespace aside_adblock
