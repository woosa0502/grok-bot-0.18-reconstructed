+std::string BlockPageHtml(const GURL& url, const MatchResult& result) {
+  const std::string escaped_url = base::EscapeForHTML(url.spec());
+  const std::string escaped_filter = base::EscapeForHTML(result.filter);
+  return base::StrCat(
+      {"<!doctype html><html><head><meta charset=\"utf-8\">"
+       "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
+       "<title>Page blocked by Aside</title><style>"
+       "body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',"
+       "Roboto,sans-serif;background:#0f0f10;color:#e8e8e8;display:flex;"
+       "align-items:center;justify-content:center;min-height:100vh}"
+       ".card{max-width:520px;padding:32px;background:#1b1b1d;border-radius:16px;"
+       "box-shadow:0 12px 40px rgba(0,0,0,.4)}h1{font-size:22px;margin:0 0 8px}"
+       "p{margin:0 0 16px;color:#b8b8b8;line-height:1.5}code{display:block;"
+       "padding:10px 12px;background:#111;border-radius:8px;color:#d0d0d0;"
+       "word-break:break-all;font-size:12px;margin-bottom:8px}"
+       ".actions{display:flex;gap:12px;margin-top:20px}button{font:inherit;"
+       "padding:10px 16px;border-radius:10px;border:1px solid #3a3a3d;"
+       "background:#242427;color:#fff;cursor:pointer;text-decoration:none;"
+       "display:inline-block}a.button{font:inherit;padding:10px 16px;"
+       "border-radius:10px;border:1px solid #3a3a3d;background:#242427;"
+       "color:#fff;cursor:pointer;text-decoration:none;display:inline-block}"
+       "button.primary{"
+       "background:#fff;color:#111;border-color:#fff}"
+       "p.note{margin:16px 0 0;font-size:12px;color:#8a8a8a}</style></head><body>"
+       "<div class=\"card\" role=\"main\"><h1>Aside blocked this page</h1>"
+       "<p>A content filter matched this address before it was loaded.</p>"
+       "<code>", escaped_url, "</code>",
+       escaped_filter.empty()
+           ? ""
+           : base::StrCat({"<code>", escaped_filter, "</code>"}),
+       "<div class=\"actions\">"
+       "<button class=\"primary\" id=\"back\">Go back</button>"
+       "<a class=\"button\" id=\"continue\" href=\"", escaped_url,
+       "\">Continue once</a>"
+       "</div><p class=\"note\">Continuing allows only this navigation in the "
+       "current tab.</p></div><script>"
+       "document.getElementById('back').onclick=function(){history.back();};"
+       "</script></body></html>"});
