+
+inline constexpr sql::Database::Tag kDatabaseTag{"AsideProfileMigrator"};
+
+// Journals and caches that must not follow a profile into a new directory:
+// a stale write-ahead log or per-extension cookie jar makes the copied
+// database inconsistent with the rows this migration rewrites.
+constexpr auto kSkippedNames = std::to_array<const char*>({
+    "Cookies-journal",
+    "Extension Cookies",
+    "Extension Cookies-journal",
+    "Login Data-journal",
+    "Login Data For Account-journal",
+    "Web Data-journal",
+    "History-journal",
+    "Favicons-journal",
+    "Singleton Lock",
+    "Singleton Cookie",
+    "Singleton Socket",
+    "LOCK",
+});
+
+// Preference subtrees the copy must not carry. The two protection keys are
+// the source installation's MACs over its tracked preferences; keeping them
+// makes every tracked preference here read as tampered with. The extension
+// keys describe a toolbar and command set that belongs to the source.
+constexpr auto kRemovedPreferences = std::to_array<const char*>({
+    "protection.macs",
+    "protection.super_mac",
+    "extensions.commands",
+    "extensions.pinned_extensions",
+    "extensions.toolbar",
+    "extensions.theme.id",
+    "extensions.theme.pack",
+});
+
+// Directory entries under a profile whose name begins with this are the
+// source browser's per-extension storage areas.
+constexpr char kExtensionStoragePrefix[] = "chrome-extension_";
+
+base::FilePath HomeRelative(base::span<const char* const> segments) {
+  base::FilePath dir;
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_APPLE)
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  dir = base::nix::GetXDGDirectory(env.get(), base::nix::kXdgConfigHomeEnvVar,
+                                   base::nix::kDotConfigDir);
+#else
+  if (!base::PathService::Get(base::DIR_HOME, &dir)) {
+    return base::FilePath();
+  }
+#if BUILDFLAG(IS_APPLE)
+  dir = dir.Append(FILE_PATH_LITERAL("Library"))
+            .Append(FILE_PATH_LITERAL("Application Support"));
+#endif
+#endif
+  if (dir.empty()) {
+    return base::FilePath();
+  }
+  for (const char* segment : segments) {
+    dir = dir.AppendASCII(segment);
+  }
+  return dir;
+}
+
+// Reads a source browser's Local State document.
+std::optional<base::DictValue> ReadLocalState(const base::FilePath& dir) {
+  const base::FilePath path = dir.Append(FILE_PATH_LITERAL("Local State"));
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(contents, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*parsed).TakeDict();
+}
+
+// Deletes `keys` (dotted paths) from `prefs`.
+void RemovePreferences(base::DictValue& prefs) {
+  for (const char* key : kRemovedPreferences) {
+    prefs.RemoveByDottedPath(key);
+  }
+}
+
+// A sealed store this installation could open, and what came of it.
+struct ResealOutcome {
+  bool opened = false;
+  int resealed = 0;
+  int skipped = 0;
+};
+
+// Rewrites one sealed column so its rows are readable here.
+//
+// Chromium-family browsers on this platform seal cookie and password values
+// under a key held by the desktop keyring, with a well-known constant key as
+// the fallback when no keyring is available. Our own key ring carries that
+// fallback key, so a source that used it decrypts here and is resealed under
+// the key this installation encrypts with. A source that used its own keyring
+// secret cannot be read from here at all; those rows are left exactly as they
+// are and counted, so nothing is lost and the count can be reported.
+ResealOutcome ResealColumn(const base::FilePath& db_path,
+                           const char* table,
+                           const char* sealed_column,
+                           const os_crypt_async::Encryptor& encryptor) {
+  ResealOutcome outcome;
+  if (!base::PathExists(db_path)) {
+    return outcome;
+  }
+  sql::Database db(kDatabaseTag);
+  if (!db.Open(db_path)) {
+    return outcome;
+  }
+  outcome.opened = true;
+  const std::string select =
+      base::StrCat({"SELECT rowid, ", sealed_column, " FROM ", table});
+  sql::Statement read(db.GetUniqueStatement(select));
+  if (!read.is_valid()) {
+    return outcome;
+  }
+  std::vector<std::pair<int64_t, std::string>> rewrites;
+  while (read.Step()) {
+    const int64_t rowid = read.ColumnInt64(0);
+    std::string sealed = read.ColumnString(1);
+    if (sealed.empty()) {
+      continue;
+    }
+    std::string plaintext;
+    if (!encryptor.DecryptString(sealed, &plaintext)) {
+      ++outcome.skipped;
+      continue;
+    }
+    std::string resealed;
+    if (!encryptor.EncryptString(plaintext, &resealed)) {
+      ++outcome.skipped;
+      continue;
+    }
+    if (resealed != sealed) {
+      rewrites.emplace_back(rowid, std::move(resealed));
+    }
+    ++outcome.resealed;
+  }
+  read.Clear();
+  if (rewrites.empty()) {
+    return outcome;
+  }
+  sql::Transaction transaction(&db);
+  if (!transaction.Begin()) {
+    outcome.skipped += static_cast<int>(rewrites.size());
+    outcome.resealed -= static_cast<int>(rewrites.size());
+    return outcome;
+  }
+  const std::string update = base::StrCat(
+      {"UPDATE ", table, " SET ", sealed_column, " = ? WHERE rowid = ?"});
+  for (const auto& [rowid, value] : rewrites) {
+    sql::Statement write(db.GetUniqueStatement(update));
+    if (!write.is_valid()) {
+      break;
+    }
+    write.BindString(0, value);
+    write.BindInt64(1, rowid);
+    if (!write.Run()) {
+      ++outcome.skipped;
+      --outcome.resealed;
+    }
+  }
+  if (!transaction.Commit()) {
+    outcome.skipped += static_cast<int>(rewrites.size());
+    outcome.resealed -= static_cast<int>(rewrites.size());
+  }
+  return outcome;
+}
