+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Renderer side of Aside's element hiding (replica of the original
+// components/aside_adblock/content/renderer/aside_adblock_render_frame_observer):
+// asks the browser's CosmeticFilterHost for the document's cosmetic resources
+// when a navigation is about to commit, runs the original's cosmetic script
+// (aside_adblock_cosmetic_script.h) as soon as the document element exists,
+// then feeds the classes/ids the script collects back to the browser for the
+// generic selectors that apply.
+
+#ifndef CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_RENDER_FRAME_OBSERVER_H_
+#define CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_RENDER_FRAME_OBSERVER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/common/aside_adblock/aside_adblock.mojom.h"
+#include "chrome/common/aside_adblock/aside_adblock_readiness.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/public/renderer/render_frame_observer_tracker.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "url/gurl.h"
+
+namespace aside_adblock {
+
+class AsideAdBlockRenderFrameObserver
+    : public content::RenderFrameObserver,
+      public content::RenderFrameObserverTracker<
+          AsideAdBlockRenderFrameObserver> {
+ public:
+  explicit AsideAdBlockRenderFrameObserver(content::RenderFrame* render_frame);
+  AsideAdBlockRenderFrameObserver(const AsideAdBlockRenderFrameObserver&) =
+      delete;
+  AsideAdBlockRenderFrameObserver& operator=(
+      const AsideAdBlockRenderFrameObserver&) = delete;
+  ~AsideAdBlockRenderFrameObserver() override;
+
+  // content::RenderFrameObserver:
+  void ReadyToCommitNavigation(
+      blink::WebDocumentLoader* document_loader) override;
+  void DidCreateDocumentElement() override;
+  void DidCreateScriptContext(v8::Local<v8::Context> context,
+                              int32_t world_id) override;
+  void DidDispatchDOMContentLoadedEvent() override;
+  void DidFinishLoad() override;
+  void WasShown() override;
+  void DidSetPageLifecycleState(
+      blink::BFCacheStateChange bfcache_change) override;
+  void OnDestruct() override;
+
+  // Called from ChromeContentRendererClient::RunScriptsAtDocumentStart, the
+  // point at which Chromium runs its own document-start injections. Script
+  // execution asked for earlier -- from inside DidCreateDocumentElement -- is
+  // dropped by Blink without an error, so the cosmetic script waits for this.
+  void RunScriptsAtDocumentStart();
+
+ private:
+  mojom::CosmeticFilterHost* host();
+  void RequestCosmeticResources(uint64_t request_id);
+  void OnHostDisconnected();
+  void OnCosmeticResources(uint64_t request_id, bool settled,
+                           const std::string& payload_json);
+  void ApplyCosmeticResources();
+  void MaybeApplyCosmeticResources();
+  void SchedulePending(uint64_t request_id);
+  void PollPending();
+  void OnHiddenSelectors(uint64_t request_id,
+                         const std::vector<std::string>& selectors);
+  void Execute(const std::string& script);
+  std::string ExecuteAndReturnString(const std::string& script);
+
+  mojo::Remote<mojom::CosmeticFilterHost> host_;
+  uint64_t request_id_ = 0;
+  std::string payload_;
+  GURL requested_url_;
+  CosmeticReadinessRetryBudget readiness_budget_;
+  base::OneShotTimer readiness_retry_timer_;
+  bool payload_ready_ = false;
+  bool document_created_ = false;
+  bool scripts_allowed_ = false;
+  bool applied_ = false;
+  // Mutation-triggered and coalesced; an idle document schedules no wakeups.
+  base::OneShotTimer poll_timer_;
+  base::WeakPtrFactory<AsideAdBlockRenderFrameObserver> weak_factory_{this};
+};
+
+}  // namespace aside_adblock
+
+#endif  // CHROME_RENDERER_ASIDE_ADBLOCK_ASIDE_ADBLOCK_RENDER_FRAME_OBSERVER_H_
