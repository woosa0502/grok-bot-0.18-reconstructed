index 0000000000..75b28b44c1
--- /dev/null
+++ b/chrome/common/aside_adblock/aside_adblock.mojom
@@ -0,0 +1,30 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Browser-side cosmetic filter host for one frame (replica of the original
+// components/aside_adblock CosmeticFilterHost; the renderer's
+// AsideAdBlockRenderFrameObserver drives the embedded cosmetic script).
+module aside_adblock.mojom;
+
+import "url/mojom/url.mojom";
+
+interface CosmeticFilterHost {
+  // Resources for the document at |url| as the cosmetic script's payload:
+  // {"hideSelectors": [...], "proceduralActions": [json, ...],
+  //  "generichide": bool}. Empty when ad blocking is off for the profile.
+  // settled=false is an expired readiness wait, not an empty ready ruleset.
+  GetCosmeticResources(url.mojom.Url url)
+      => (bool settled, string payload_json);
+
+  // Generic element-hiding selectors keyed by the classes and ids the
+  // document reported (the script's takePending()).
+  GetHiddenSelectors(array<string> classes, array<string> ids)
+      => (array<string> selectors);
+
+  // A navigation invalidates outstanding readiness waits for the old document.
+  CancelPendingCosmeticResources();
+
+  // Resources for the frame's current document (same payload shape).
+  TakePrefetchedResources() => (string payload_json);
+};
diff --git a/chrome/common/aside_adblock/aside_adblock_readiness.h b/chrome/common/aside_adblock/aside_adblock_readiness.h
new file mode 100644
index 0000000000..1398a563d6
--- /dev/null
+++ b/chrome/common/aside_adblock/aside_adblock_readiness.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_COMMON_ASIDE_ADBLOCK_ASIDE_ADBLOCK_READINESS_H_
+#define CHROME_COMMON_ASIDE_ADBLOCK_ASIDE_ADBLOCK_READINESS_H_
+
+namespace aside_adblock {
+
+// Six event-driven waits of at most 30 seconds each, with a short retry delay,
+// cover the service's two-minute initial-download deadline plus compilation.
+// A navigation starts a fresh budget; an unresolved timeout never means that
+// a document has received an empty, ready ruleset.
+class CosmeticReadinessRetryBudget {
+ public:
+  static constexpr int kMaxRequests = 6;
+  bool TryStart() {
+    if (!CanRetry()) {
+      return false;
+    }
+    ++requests_;
+    return true;
+  }
+  bool CanRetry() const { return requests_ < kMaxRequests; }
+  void Reset() { requests_ = 0; }
+
+ private:
+  int requests_ = 0;
+};
+
+}  // namespace aside_adblock
+#endif
