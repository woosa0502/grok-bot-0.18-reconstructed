+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_COOKIE_IMPORTER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_COOKIE_IMPORTER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+namespace aside_importer {
+
+// One row of Firefox's moz_cookies table, in the shape the table stores it.
+struct FirefoxCookie {
+  std::string name;
+  std::string value;
+  std::string host;
+  std::string path;
+  base::Time expiry;
+  base::Time last_accessed;
+  base::Time creation_time;
+  bool is_secure = false;
+  bool is_http_only = false;
+  // Firefox's per-container / per-partition suffix, e.g.
+  // "^userContextId=2&partitionKey=%28https%2Cexample.com%29". Empty for an
+  // ordinary cookie.
+  std::string origin_attributes;
+  // Bit 1 = http, bit 2 = https, bit 4 = file. Zero when the column is absent.
+  int scheme_map = 0;
+};
+
+// Reading a Firefox cookie store either produces rows or an explanation.
+struct FirefoxCookieResult {
+  bool ok = false;
+  std::string error;
+  std::vector<FirefoxCookie> cookies;
+};
+
+// The URL a Firefox originAttributes suffix is parsed as, so its key/value
+// pairs can be read with the ordinary query parsing. Firefox writes the suffix
+// with a leading '^'; this drops it and treats the rest as a query string.
+GURL OriginAttributesUrl(const std::string& origin_attributes);
+
+// Copies <profile>/cookies.sqlite (with its write-ahead log and journal, so
+// the snapshot is not missing a live browser's most recent writes) into a
+// temporary directory and reads moz_cookies out of the copy. Blocking.
+FirefoxCookieResult ReadFirefoxCookies(const base::FilePath& profile_dir);
+
+}  // namespace aside_importer
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_FIREFOX_COOKIE_IMPORTER_H_
diff --git a/chrome/browser/ui/webui/aside_importer/firefox_profile_importer.cc b/chrome/browser/ui/webui/aside_importer/firefox_profile_importer.cc
new file mode 100644
index 0000000000..6b6a7b9db3
--- /dev/null
+++ b/chrome/browser/ui/webui/aside_importer/firefox_profile_importer.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_importer/firefox_profile_importer.h"
+
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/strcat.h"
+#include "net/base/url_util.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_inclusion_status.h"
+
+namespace aside_importer {
+
+namespace {
+
+// Firefox's schemeMap bits. A row that was only ever seen over http is
+// restored as an http cookie even when it carries the secure flag, which
+// Firefox tolerates and this store does not.
+constexpr int kSchemeHttp = 1 << 0;
+constexpr int kSchemeHttps = 1 << 1;
+
+// A container cookie belongs to a Firefox container this browser has no
+// equivalent for, so it cannot be carried over.
+bool IsContainerCookie(const std::string& origin_attributes) {
+  if (origin_attributes.empty()) {
+    return false;
+  }
+  const GURL url = OriginAttributesUrl(origin_attributes);
+  std::string user_context;
+  if (!net::GetValueForKeyInQuery(url, "userContextId", &user_context)) {
+    return false;
+  }
+  int value = 0;
+  return base::StringToInt(user_context, &value) && value != 0;
+}
+
+}  // namespace
+
+GURL UrlForFirefoxCookie(const FirefoxCookie& cookie) {
+  if (cookie.host.empty()) {
+    return GURL();
+  }
+  std::string host = cookie.host;
+  // A domain cookie's host starts with a dot in both stores; the URL it is
+  // scoped to is the same host without it.
+  if (host.front() == '.') {
+    host.erase(host.begin());
+  }
+  if (host.empty()) {
+    return GURL();
+  }
+  const bool https = cookie.is_secure ||
+                     (cookie.scheme_map & kSchemeHttps) != 0 ||
+                     (cookie.scheme_map & kSchemeHttp) == 0;
+  const std::string path = cookie.path.empty() ? "/" : cookie.path;
+  return GURL(base::StrCat({https ? "https://" : "http://", host, path}));
+}
+
+std::unique_ptr<net::CanonicalCookie> ConvertFirefoxCookie(
+    const FirefoxCookie& cookie) {
+  if (cookie.name.empty() && cookie.value.empty()) {
+    return nullptr;
+  }
+  if (IsContainerCookie(cookie.origin_attributes)) {
+    return nullptr;
+  }
+  const GURL url = UrlForFirefoxCookie(cookie);
+  if (!url.is_valid()) {
+    return nullptr;
+  }
+  net::CookieInclusionStatus status;
+  // Firefox does not record a SameSite value that maps onto this store's
+  // three-way attribute, so an imported cookie is unspecified, which this
+  // store treats the way it treats a cookie that arrived without the
+  // attribute. The partition key stays empty: Firefox's partitionKey names a
+  // top-level site whose scheme this row does not record.
+  return net::CanonicalCookie::CreateSanitizedCookie(
+      url, cookie.name, cookie.value, cookie.host,
+      cookie.path.empty() ? "/" : cookie.path, cookie.creation_time,
+      cookie.expiry, cookie.last_accessed, cookie.is_secure,
+      cookie.is_http_only, net::CookieSameSite::UNSPECIFIED,
+      net::COOKIE_PRIORITY_DEFAULT, /*partition_key=*/std::nullopt, &status);
+}
+
+PreparedFirefoxCookies PrepareFirefoxCookies(
+    const base::FilePath& profile_dir) {
+  PreparedFirefoxCookies prepared;
+  FirefoxCookieResult read = ReadFirefoxCookies(profile_dir);
+  if (!read.ok) {
+    prepared.error = read.error;
+    return prepared;
+  }
+  for (const FirefoxCookie& cookie : read.cookies) {
+    std::unique_ptr<net::CanonicalCookie> converted =
+        ConvertFirefoxCookie(cookie);
+    if (!converted) {
+      ++prepared.skipped;
+      continue;
+    }
+    prepared.cookies.push_back(std::move(*converted));
+  }
+  return prepared;
+}
+
+std::string SkippedFirefoxCookiesMessage(int skipped) {
+  if (skipped <= 0) {
+    return std::string();
+  }
+  return base::StrCat({"Skipped ", base::NumberToString(skipped),
+                       " unsupported or invalid Firefox cookies"});
+}
+
+}  // namespace aside_importer
