+#ifndef CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORT_DATA_ASIDE_IMPORT_DATA_SESSION_H_
+#define CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORT_DATA_ASIDE_IMPORT_DATA_SESSION_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/importer/external_process_importer_host.h"
+
+namespace aside {
+
+// Only the currently selected archive may be installed into the active
+// import's storage. Cancellation revokes outstanding asynchronous completions.
+class PendingSafariArchive {
+ public:
+  bool CanPick(bool import_active) const { return !pending_ && !import_active; }
+  std::optional<uint64_t> Begin(bool import_active) {
+    if (!CanPick(import_active)) return std::nullopt;
+    pending_ = true;
+    return ++generation_;
+  }
+  bool Complete(uint64_t generation, bool import_active) {
+    if (!pending_ || generation != generation_) return false;
+    pending_ = false;
+    return !import_active;
+  }
+  void Cancel() {
+    pending_ = false;
+    ++generation_;
+  }
+
+ private:
+  bool pending_ = false;
+  uint64_t generation_ = 0;
+};
+
+struct ImportDataResult {
+  enum class State { kImporting, kSucceeded, kFailed, kCancelled };
+  State state = State::kImporting;
+  std::string source_id;
+  std::string error_message;
+};
+
+// Binds the self-deleting import host to a WebUI lifetime. Utility failure and
+// cancellation are terminal outcomes, never implicit success. Destroying the
+// page detaches the observer before cancelling the host, so callbacks cannot
+// reach a destroyed handler or a document with JavaScript disallowed.
+class ImportDataSession : public importer::ImporterProgressObserver {
+ public:
+  using Completion = base::OnceCallback<void(ImportDataResult)>;
+
+  ImportDataSession(ExternalProcessImporterHost* host,
+                    uint16_t requested_items,
+                    std::string source_id,
+                    Completion completion);
+  ~ImportDataSession() override;
+  ImportDataSession(const ImportDataSession&) = delete;
+  ImportDataSession& operator=(const ImportDataSession&) = delete;
+
+  bool importing() const { return host_ != nullptr; }
+
+  void Abort();
+
+  void ImportStarted() override {}
+  void ImportItemStarted(user_data_importer::ImportItem) override {}
+  void ImportItemEnded(user_data_importer::ImportItem item) override;
+  void ImportFailed(const std::string& error_message) override;
+  void ImportCancelled() override;
+  void ImportEnded() override;
+
+ private:
+  raw_ptr<ExternalProcessImporterHost> host_;
+  const uint16_t requested_items_;
+  uint16_t completed_items_ = 0;
+  ImportDataResult result_;
+  Completion completion_;
+};
+
+}  // namespace aside
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORT_DATA_ASIDE_IMPORT_DATA_SESSION_H_
