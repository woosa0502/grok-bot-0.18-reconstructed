+namespace aside_importer {
+
+// The Chromium-family browsers chrome://aside-import-data offers, in the
+// order the original's picker enumerates them (RE: the browser switch in
+// chromium_profile_migrator.cc, arm64 0x4033df0).
+enum class ChromiumBrowser {
+  kArc = 0,
+  kBrave = 1,
+  kAtlas = 2,
+  kChrome = 3,
+  kComet = 4,
+  kDia = 5,
+  kEdge = 6,
+  // Not one of the original's ids; plain Chromium shares Chrome's layout and
+  // is the build most Linux machines actually have.
+  kChromium = 7,
+};
+
+// One row of the source browser's Local State profile list.
+struct ChromiumProfileInfo {
+  ChromiumProfileInfo();
+  ChromiumProfileInfo(const ChromiumProfileInfo&);
+  ChromiumProfileInfo(ChromiumProfileInfo&&);
+  ChromiumProfileInfo& operator=(const ChromiumProfileInfo&);
+  ChromiumProfileInfo& operator=(ChromiumProfileInfo&&);
+  ~ChromiumProfileInfo();
+
+  // The profile directory name, e.g. "Default" or "Profile 1".
+  std::string id;
+  // What the source browser shows for it (gaia_name, else name, else id).
+  std::string name;
+  // The source profile directory itself.
+  base::FilePath path;
+  // The cached Google account picture, when the source has one.
+  base::FilePath avatar;
+};
+
+// The page's browser id ("chrome", "brave", ...) and back.
+std::optional<ChromiumBrowser> ChromiumBrowserFromId(std::string_view id);
+std::string IdForChromiumBrowser(ChromiumBrowser browser);
+// The name the page's browser list shows, used in the picker and in errors.
+std::string DisplayNameForChromiumBrowser(ChromiumBrowser browser);
+
+// Where `browser` keeps its user data on this platform, or an empty path when
+// this platform has no such install location.
+base::FilePath UserDataDirectoryFor(ChromiumBrowser browser);
+
+// True when `browser` looks installed: its user data directory holds a Local
+// State file or a Default profile.
+bool IsChromiumBrowserInstalled(ChromiumBrowser browser);
+
+// The ids of every Chromium-family browser that is installed, in picker order.
+std::vector<std::string> InstalledChromiumBrowserIds();
+
+// The profiles `browser` lists in its Local State, ordered the way it orders
+// them (profile.profiles_order first, then anything left in
+// profile.info_cache). Blocking.
+std::vector<ChromiumProfileInfo> ReadChromiumProfiles(ChromiumBrowser browser);
+
+// The same read against an explicit user data directory, which is what makes
+// the ordering and naming rules testable without an installed browser.
+std::vector<ChromiumProfileInfo> ReadChromiumProfilesFromDirectory(
+    const base::FilePath& user_data_dir);
+
+// Outcome of a migration. `error` carries the original's wording.
+struct MigrationResult {
+  bool ok = false;
+  std::string error;
+  // What the source sealed with a key this installation cannot read. The
+  // caller reports these; the rows are left untouched rather than dropped.
+  int resealed_rows = 0;
+  int skipped_encrypted_rows = 0;
+  // True when a sealed store was opened and nothing in it could be read.
+  bool encrypted_store_unreadable = false;
+};
+
+// Copies `profile` into `target_profile_dir` and makes the copy usable by this
+// browser: journals and per-extension state that must not be carried are left
+// behind, the copied preferences are scrubbed, and the rows the source
+// encrypted are re-encrypted under this installation's key. Blocking; call on
+// a MayBlock sequence with `target_profile_dir` not yet loaded.
+MigrationResult MigrateChromiumProfile(
+    ChromiumBrowser browser,
+    const ChromiumProfileInfo& profile,
+    const base::FilePath& target_profile_dir,
+    const std::string& target_profile_name,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor);
+
+}  // namespace aside_importer
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASIDE_IMPORTER_CHROMIUM_PROFILE_MIGRATOR_H_
