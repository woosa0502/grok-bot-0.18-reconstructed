@@ -0,0 +1,81 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/aside_import_data/aside_import_data_session.h"
+
+#include <utility>
+
+namespace aside {
+
+ImportDataSession::ImportDataSession(ExternalProcessImporterHost* host,
+                                   uint16_t requested_items,
+                                   std::string source_id,
+                                   Completion completion)
+    : host_(host),
+      requested_items_(requested_items),
+      completion_(std::move(completion)) {
+  result_.source_id = std::move(source_id);
+  host_->set_observer(this);
+}
+
+ImportDataSession::~ImportDataSession() {
+  Abort();
+}
+
+void ImportDataSession::Abort() {
+  if (!host_) {
+    return;
+  }
+  ExternalProcessImporterHost* host = host_.get();
+  host_ = nullptr;
+  completion_.Reset();
+  host->set_observer(nullptr);
+  host->Cancel();  // Deletes host. No callback to this observer is possible.
+}
+
+void ImportDataSession::ImportItemEnded(user_data_importer::ImportItem item) {
+  if (result_.state == ImportDataResult::State::kImporting) {
+    completed_items_ |= item & requested_items_;
+  }
+}
+
+void ImportDataSession::ImportFailed(const std::string& error_message) {
+  if (result_.state != ImportDataResult::State::kImporting) {
+    return;
+  }
+  result_.state = ImportDataResult::State::kFailed;
+  result_.error_message = error_message.empty() ? "Browser import failed"
+                                              : error_message;
+}
+
+void ImportDataSession::ImportCancelled() {
+  if (result_.state != ImportDataResult::State::kImporting) {
+    return;
+  }
+  result_.state = ImportDataResult::State::kCancelled;
+  result_.error_message = "Browser import was cancelled";
+}
+
+void ImportDataSession::ImportEnded() {
+  if (!host_) {
+    return;
+  }
+  host_ = nullptr;
+  if (result_.state == ImportDataResult::State::kImporting) {
+    if (requested_items_ && completed_items_ == requested_items_) {
+      result_.state = ImportDataResult::State::kSucceeded;
+    } else {
+      ImportFailed("Import ended before all selected data types completed");
+    }
+  }
+  // The callback may destroy this session. Use locals and do not touch
+  // members after invocation.
+  auto completion = std::move(completion_);
+  auto result = result_;
+  if (completion) {
+    std::move(completion).Run(std::move(result));
+  }
+}
+
+}  // namespace aside
