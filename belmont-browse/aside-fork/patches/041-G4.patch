+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/aside_omnibox/aside_omnibox_match_utils.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+
+namespace extensions {
+
+const AutocompleteMatch* FindAsideOmniboxMatch(
+    const AutocompleteResult& result, const base::DictValue& request,
+    double result_sequence_id) {
+  if (!IsAsideOmniboxResultCurrent(request, result_sequence_id)) {
+    return nullptr;
+  }
+  const auto line = request.FindInt("line");
+  if (!line || *line < 0 || static_cast<size_t>(*line) >= result.size()) {
+    return nullptr;
+  }
+  const auto& match = result.match_at(*line);
+  const auto* url = request.FindString("url");
+  if (url && GURL(*url) != match.destination_url) {
+    return nullptr;
+  }
+  return &match;
+}
+
+bool IsAsideOmniboxResultCurrent(const base::DictValue& request,
+                                double result_sequence_id) {
+  const auto received = request.FindDouble("resultSequenceId");
+  return received && *received > 0 && *received == result_sequence_id;
+}
+
+bool ExecuteAsideOmniboxAction(const AutocompleteResult& result,
+                              size_t line, size_t action_index,
+                              OmniboxAction::ExecutionContext& context) {
+  if (line >= result.size() || action_index >= result.match_at(line).actions.size()) {
+    return false;
+  }
+  // Execute may synchronously replace the entire result. Retain only the
+  // selected action, and never read the result or match again after execution.
+  scoped_refptr<OmniboxAction> action = result.match_at(line).actions[action_index];
+  if (!action) {
+    return false;
+  }
+  action->Execute(context);
+  return true;
+}
+
+base::ListValue AsideOmniboxActionDescriptions(const AutocompleteMatch& match) {
+  base::ListValue actions;
+  for (const auto& action : match.actions) {
+    base::DictValue item;
+    if (action) {
+      const auto& labels = action->GetLabelStrings();
+      item.Set("hint", base::UTF16ToUTF8(labels.hint));
+      item.Set("suggestionContents", base::UTF16ToUTF8(labels.suggestion_contents));
+    }
+    // Preserve positional indexes even if an unavailable action is present.
+    actions.Append(std::move(item));
+  }
+  return actions;
+}
+
+}  // namespace extensions
