+// A View that paints its border after (that is, on top of) its children.
+// Aside wraps the tab list's ScrollView in one of these so the rounded 1px
+// outline stays visible over the layer-backed, scrolling rows; the ScrollView
+// itself carries no border. Replica of the original's BorderOnTopView in this
+// file (825.1 framework region 0x04892a00-0x048983a0, class metadata
+// "BorderOnTopView" recorded at desktop_media_tab_list.cc:69).
+class BorderOnTopView : public views::View {
+  METADATA_HEADER(BorderOnTopView, views::View)
+
+ public:
+  BorderOnTopView() = default;
+  BorderOnTopView(const BorderOnTopView&) = delete;
+  BorderOnTopView& operator=(const BorderOnTopView&) = delete;
+  ~BorderOnTopView() override = default;
+
+  // views::View:
+  void PaintChildren(const views::PaintInfo& paint_info) override {
+    views::View::PaintChildren(paint_info);
+    if (!GetBorder()) {
+      return;
+    }
+    ui::PaintCache paint_cache;
+    ui::PaintRecorder recorder(paint_info.context(),
+                               paint_info.paint_recording_size(),
+                               paint_info.paint_recording_scale_x(),
+                               paint_info.paint_recording_scale_y(),
+                               &paint_cache);
+    OnPaintBorder(recorder.canvas());
+  }
+};
+
+BEGIN_METADATA(BorderOnTopView)
+END_METADATA
