+
+namespace {
+
+constexpr int kDotSize = 8;
+
+class PopoverController {
+ public:
+  PopoverController(views::View* anchor,
+                    const base::DictValue& popover,
+                    base::RepeatingCallback<void(const std::string&)> on_action)
+      : on_action_(std::move(on_action)) {
+    delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, views::BubbleBorder::LEFT_TOP);
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetShowCloseButton(true);
+    delegate_->SetShowTitle(false);
+    delegate_->set_margins(gfx::Insets(12));
+
+    auto contents = std::make_unique<views::BoxLayoutView>();
+    contents->SetOrientation(views::BoxLayout::Orientation::kVertical);
+    contents->SetBetweenChildSpacing(8);
+    const std::string* title = popover.FindString("title");
+    const std::string* body = popover.FindString("body");
+    auto* title_label = contents->AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(title ? *title : std::string()),
+        views::style::CONTEXT_DIALOG_TITLE, views::style::STYLE_PRIMARY));
+    title_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_label->SetMultiLine(true);
+    title_label->SetMaximumWidth(280);
+    auto* body_label = contents->AddChildView(std::make_unique<views::Label>(
+        base::UTF8ToUTF16(body ? *body : std::string()),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    body_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    body_label->SetMultiLine(true);
+    body_label->SetMaximumWidth(280);
+    auto* actions = contents->AddChildView(std::make_unique<views::BoxLayoutView>());
+    actions->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    actions->SetMainAxisAlignment(views::LayoutAlignment::kEnd);
+    actions->SetBetweenChildSpacing(8);
+    if (const base::ListValue* list = popover.FindList("actions")) {
+      for (const base::Value& action : *list) {
+        const base::DictValue* d = action.GetIfDict();
+        if (!d) {
+          continue;
+        }
+        const std::string* id = d->FindString("id");
+        const std::string* label = d->FindString("label");
+        if (!id || !label) {
+          continue;
+        }
+        auto* button = actions->AddChildView(std::make_unique<views::MdTextButton>(
+            base::BindRepeating(&PopoverController::OnAction,
+                                base::Unretained(this), *id),
+            base::UTF8ToUTF16(*label)));
+        button->SetStyle(d->FindBool("primary").value_or(false)
+                             ? ui::ButtonStyle::kProminent
+                             : ui::ButtonStyle::kTonal);
+      }
+    }
+    delegate_->SetContentsView(std::move(contents));
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(), base::BindOnce(&PopoverController::OnClosed,
+                                        base::Unretained(this)));
+    widget_->Show();
+  }
+
+ private:
+  void OnAction(const std::string& action_id) {
+    on_action_.Run(action_id);
+    if (widget_) {
+      widget_->Close();
+    }
+  }
+  void OnClosed(views::Widget::ClosedReason) { delete this; }
+
+  base::RepeatingCallback<void(const std::string&)> on_action_;
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+};
+
+}  // namespace
+
+AsideTaskStatusDotView::AsideTaskStatusDotView(const std::string& status)
+    : status_(status) {
+  SetPreferredSize(gfx::Size(kDotSize + 4, kDotSize + 4));
+}
+
+AsideTaskStatusDotView::~AsideTaskStatusDotView() = default;
+
+void AsideTaskStatusDotView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* provider = GetColorProvider();
+  // Palette entries of the original's task section: the status-dot region
+  // (x86_64 0x04cff670) uses kColorAsideTaskAttentionBadge{Fore,Back}ground and
+  // the task-status region right before it (0x04cf7e80) uses
+  // kColorAsideControlInvalid, kColorAsideTaskCompletedIndicator and
+  // kColorAsideMutedForeground.
+  SkColor color = provider->GetColor(kColorAsideMutedForeground);
+  if (status_ == "error") {
+    color = provider->GetColor(kColorAsideControlInvalid);
+  } else if (status_ == "awaiting-approval" || status_ == "awaiting-answer") {
+    color = provider->GetColor(kColorAsideTaskAttentionBadgeForeground);
+  } else if (status_ == "finished-unread") {
+    color = provider->GetColor(kColorAsideTaskCompletedIndicator);
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(color);
+  gfx::RectF bounds(GetLocalBounds());
+  bounds.Inset(2);
+  canvas->DrawCircle(bounds.CenterPoint(), kDotSize / 2.0f, flags);
+}
+
+BEGIN_METADATA(AsideTaskStatusDotView)
+END_METADATA
+
+namespace {
+
+// vertical_tab_strip_region_view.cc:286 in the original.
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kRenameChatFieldId);
+
+// Original UTF-16 literals (arm64 0xd77af72-0xd77b07c).
+constexpr char16_t kNewChatName[] = u"New chat name";
+constexpr char16_t kChooseShortName[] =
+    u"Choose a short, recognizable name.";
+constexpr char16_t kSave[] = u"Save";
+constexpr char16_t kCancel[] = u"Cancel";
+constexpr char16_t kArchiveSessionTitle[] = u"Archive session?";
+constexpr char16_t kArchiveSessionBody[] = u"This will archive this task";
+constexpr char16_t kArchiveAllTitle[] = u"Archive all chats?";
+constexpr char16_t kArchiveAllBody[] = u"This will archive all chats.";
+constexpr char16_t kArchive[] = u"Archive";
+
+class RenameChatDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit RenameChatDelegate(
+      base::OnceCallback<void(const std::u16string&)> on_submit)
+      : on_submit_(std::move(on_submit)) {}
+
+  void OnAccept() {
+    if (!on_submit_) {
+      return;
+    }
+    std::move(on_submit_)
+        .Run(dialog_model()->GetTextfieldByUniqueId(kRenameChatFieldId)->text());
+  }
+
+ private:
+  base::OnceCallback<void(const std::u16string&)> on_submit_;
+};
+
+// The two archive confirmations differ only in their strings.
+void ShowArchiveConfirm(Browser* browser,
+                        const std::u16string& title,
+                        const std::u16string& body,
+                        const std::string& internal_name,
+                        base::OnceClosure on_accept) {
+  if (!browser) {
+    return;
+  }
+  auto model =
+      ui::DialogModel::Builder()
+          .SetTitle(title)
+          .SetInternalName(internal_name)
+          .AddParagraph(ui::DialogModelLabel(body))
+          .AddOkButton(
+              std::move(on_accept),
+              ui::DialogModel::Button::Params().SetLabel(kArchive).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+}  // namespace
+
+void ShowAsideRenameChatDialog(
+    Browser* browser,
+    const std::u16string& initial_title,
+    base::OnceCallback<void(const std::u16string&)> on_submit) {
+  if (!browser) {
+    return;
+  }
+  auto delegate = std::make_unique<RenameChatDelegate>(std::move(on_submit));
+  RenameChatDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kNewChatName)
+          .SetSubtitle(kChooseShortName)
+          .SetInternalName("VerticalTabStripRenameChat")
+          .AddTextfield(kRenameChatFieldId, kNewChatName, initial_title)
+          .AddOkButton(base::BindOnce(&RenameChatDelegate::OnAccept,
+                                      base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(kSave))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kRenameChatFieldId)
+          .Build();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void ShowAsideArchiveSessionDialog(Browser* browser,
+                                   base::OnceClosure on_accept) {
+  ShowArchiveConfirm(browser, kArchiveSessionTitle, kArchiveSessionBody,
+                     "VerticalTabStripArchiveSession", std::move(on_accept));
+}
+
+void ShowAsideArchiveAllChatsDialog(Browser* browser,
+                                    base::OnceClosure on_accept) {
+  ShowArchiveConfirm(browser, kArchiveAllTitle, kArchiveAllBody,
+                     "VerticalTabStripArchiveAllChats", std::move(on_accept));
+}
+
+namespace {
+
+// Self-owned: deletes itself when its widget closes.
+class ToastController {
+ public:
+  ToastController(views::View* anchor, const std::u16string& text) {
+    delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+        anchor, views::BubbleBorder::LEFT_TOP);
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetShowTitle(false);
+    delegate_->SetShowCloseButton(false);
+    delegate_->set_margins(gfx::Insets::VH(8, 12));
+    auto label = std::make_unique<views::Label>(text);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    delegate_->SetContentsView(std::move(label));
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        delegate_.get(),
+        base::BindOnce(&ToastController::OnClosed, base::Unretained(this)));
+    widget_->Show();
+    timer_.Start(FROM_HERE, base::Seconds(2),
+                 base::BindOnce(&ToastController::Dismiss,
+                                base::Unretained(this)));
+  }
+
+ private:
+  void Dismiss() {
+    if (widget_) {
+      widget_->Close();
+    }
+  }
+  void OnClosed(views::Widget::ClosedReason) { delete this; }
+
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  base::OneShotTimer timer_;
+};
+
+}  // namespace
+
+void ShowAsideToast(views::View* anchor, const std::u16string& text) {
+  if (!anchor || !anchor->GetWidget()) {
+    return;
+  }
+  new ToastController(anchor, text);  // self-owned
+}
+
+void ShowAsideTaskPopover(
+    views::View* anchor,
+    const base::DictValue& popover,
+    base::RepeatingCallback<void(const std::string&)> on_action) {
+  if (!anchor) {
+    return;
+  }
+  new PopoverController(anchor, popover, std::move(on_action));  // self-owned
+}
