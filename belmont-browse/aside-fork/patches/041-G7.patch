+void AsideProfileMenuView::BuildDownloadsPage() {
+  AddBackRow(body_, kDownloads,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+
+  content::DownloadManager* manager =
+      browser_->profile()->GetDownloadManager();
+  std::vector<raw_ptr<download::DownloadItem, VectorExperimental>> items;
+  if (manager) {
+    manager->GetAllDownloads(&items);
+  }
+  std::sort(items.begin(), items.end(),
+            [](const download::DownloadItem* a,
+               const download::DownloadItem* b) {
+              return a->GetStartTime() > b->GetStartTime();
+            });
+  size_t shown = 0;
+  for (download::DownloadItem* item : items) {
+    if (shown >= kRecentDownloadCount) {
+      break;
+    }
+    std::u16string state;
+    switch (item->GetState()) {
+      case download::DownloadItem::COMPLETE:
+        state = kDownloaded;
+        break;
+      case download::DownloadItem::INTERRUPTED:
+        state = kFailed;
+        break;
+      case download::DownloadItem::CANCELLED:
+        state = kCancelled;
+        break;
+      default:
+        continue;
+    }
+    ++shown;
+    body_->AddChildView(MakeDownloadRow(
+        base::BindRepeating(&AsideProfileMenuView::OnOpenDownload,
+                            base::Unretained(this), item->GetId()),
+        item->GetFileNameToReportUser().LossyDisplayName(),
+        base::StrCat({state, kSlash,
+                      base::UTF8ToUTF16(item->GetURL().host())})));
+  }
+  if (shown == 0) {
+    body_->AddChildView(MakeSectionLabel(kNoRecentDownloads));
+  }
+
+  body_->AddChildView(std::make_unique<views::Separator>());
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ShowDownloads(browser);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kShowAllDownloads, &kAsideDownloadMenuIcon));
+}
+
+void AsideProfileMenuView::BuildHistoryPage() {
+  AddBackRow(body_, kHistory,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+
+  body_->AddChildView(MakeSectionLabel(kRecentTabs));
+  size_t shown = 0;
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(browser_->profile());
+  if (service) {
+    service->LoadTabsFromLastSession();
+    for (const auto& entry : service->entries()) {
+      if (shown >= kRecentTabCount) {
+        break;
+      }
+      if (entry->type != sessions::tab_restore::Type::TAB) {
+        continue;
+      }
+      const auto* tab =
+          static_cast<const sessions::tab_restore::Tab*>(entry.get());
+      if (tab->navigations.empty()) {
+        continue;
+      }
+      const sessions::SerializedNavigationEntry& nav =
+          tab->navigations[tab->normalized_navigation_index()];
+      ++shown;
+      body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+          base::BindRepeating(&AsideProfileMenuView::OnRestoreClosedTab,
+                              base::Unretained(this), entry->id.id()),
+          nav.title().empty() ? base::UTF8ToUTF16(nav.virtual_url().spec())
+                              : nav.title(),
+          &kAsideGlobeIcon));
+    }
+  }
+  if (shown == 0) {
+    body_->AddChildView(MakeSectionLabel(kNoRecentTabs));
+  }
+
+  body_->AddChildView(std::make_unique<views::Separator>());
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ShowHistory(browser);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kAllHistory, &kAsideHistoryIcon));
+}
+
+void AsideProfileMenuView::BuildDevelopersPage() {
+  AddBackRow(body_, kDevelopers,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ShowSettingsSubPage(browser, "performance");
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kPerformance, &kAsidePerformanceIcon));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::OpenTaskManager(browser);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kTaskManager, &kAsideTaskManagerIcon));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ToggleDevToolsWindow(
+                browser, DevToolsToggleAction::Show(),
+                DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kDeveloperTools, &kAsideDeveloperToolsIcon));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                          base::Unretained(this), Page::kAdvanced),
+      kAdvanced, &kAsideSettingsSliderHorStrokeIcon));
+}
+
+void AsideProfileMenuView::BuildAdvancedPage() {
+  AddBackRow(body_, kAdvanced,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kDevelopers));
+
+  PrefService* local_state = g_browser_process->local_state();
+  const bool allowed =
+      local_state &&
+      local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed);
+  const bool debugging =
+      local_state &&
+      local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled);
+  auto remote = std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::OnToggleRemoteDebugging,
+                          base::Unretained(this)),
+      kRemoteDebugging,
+      debugging ? &kAsideCheckMarkIcon : &kAsideCodeLargeStrokeIcon);
+  remote->SetEnabled(allowed);
+  body_->AddChildView(std::move(remote));
+
+  const bool external_ai =
+      local_state && local_state->GetBoolean(kAllowExternalAiControlPref);
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::OnToggleExternalAiControl,
+                          base::Unretained(this)),
+      kAllowExternalAi,
+      external_ai ? &kAsideCheckMarkIcon : &kAsideCpuChip01Icon));
+}
+
+void AsideProfileMenuView::BuildProfileActionsPage() {
+  AddBackRow(body_, kProfileActions,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+  body_->GetViewAccessibility().SetName(std::u16string(kProfileSubmenu));
+
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::OnEditProfile,
+                          base::Unretained(this)),
+      kEdit, &kAsidePencil2SolidIcon));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                          base::Unretained(this), Page::kIconPicker),
+      kChangeIcon, &kAsideColorPalette2SolidIcon));
+  body_->AddChildView(std::make_unique<views::Separator>());
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::OnDeleteProfile,
+                          base::Unretained(this),
+                          browser_->profile()->GetPath()),
+      kDelete, &kAsideCircleXSolidIcon));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(&AsideProfileMenuView::OnSignOut,
+                          base::Unretained(this)),
+      kSignOut, &kAsideSquareArrowTopRightSolidIcon));
+}
+
+void AsideProfileMenuView::BuildIconPickerPage() {
+  AddBackRow(body_, kChangeIconPage,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this),
+                                 Page::kProfileActions));
+  std::string selected;
+  if (ProfileAttributesEntry* entry =
+          EntryForPath(browser_->profile()->GetPath())) {
+    selected = entry->GetAsideProfileIndicatorIcon();
+  }
+  body_->AddChildView(std::make_unique<ProfileIndicatorIconPickerPanel>(
+      selected, base::BindRepeating(&AsideProfileMenuView::OnPickIndicatorIcon,
+                                    base::Unretained(this))));
+}
+
+void AsideProfileMenuView::CloseBubble() {
+  if (views::Widget* widget = GetWidget()) {
+    widget->Close();
+  }
+}
+
+void AsideProfileMenuView::CloseBubbleForCommand() {
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OpenExtensionActions(const std::string& id) {
+  extension_id_ = id;
+  ShowPage(Page::kExtensionActions);
+}
+
+void AsideProfileMenuView::OpenExtensionRoute(const std::string& route) {
+  aside::ShowExtensionPage(
+      browser_,
+      aside::ExtensionPageUrl(browser_->profile(), kNewTabPage, route));
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnSwitchProfile(const base::FilePath& path) {
+  if (path == browser_->profile()->GetPath()) {
+    CloseBubble();
+    return;
+  }
+  // The pager keeps the window and stashes this profile's tabs; see
+  // chrome::SwitchProfileInPlaceForAside().
+  chrome::SwitchProfileInPlaceForAside(browser_, path);
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnAddProfile() {
+  aside::ShowExtensionPage(
+      browser_, aside::ExtensionPageUrl(browser_->profile(), kNewTabPage,
+                                        kOnboardingSplashRoute));
+  ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+      ProfilePicker::EntryPoint::kProfileMenuAddNewProfile));
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnGuestProfile() {
+  chrome::NewIncognitoWindow(browser_->profile());
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnEditProfile() {
+  const base::FilePath path = browser_->profile()->GetPath();
+  std::u16string current;
+  if (ProfileAttributesEntry* entry = EntryForPath(path)) {
+    current = entry->GetName();
+  }
+  auto delegate = std::make_unique<ProfileDialogDelegate>(path);
+  ProfileDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kEditProfileTitle)
+          .SetInternalName("AsideProfileMenuEditProfile")
+          .AddParagraph(ui::DialogModelLabel(kShortRecognizableName))
+          .AddTextfield(kEditProfileNameFieldId, kProfileName, current)
+          .AddOkButton(base::BindOnce(&ProfileDialogDelegate::OnRename,
+                                      base::Unretained(delegate_ptr)),
+                       ui::DialogModel::Button::Params().SetLabel(kSave))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .SetInitiallyFocusedField(kEditProfileNameFieldId)
+          .Build();
+  Browser* browser = browser_;
+  CloseBubble();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void AsideProfileMenuView::OnDeleteProfile(const base::FilePath& path) {
+  std::u16string name;
+  if (ProfileAttributesEntry* entry = EntryForPath(path)) {
+    name = entry->GetName();
+  }
+  const std::u16string body =
+      name.empty() ? std::u16string(kThisProfileRemoved)
+                   : base::StrCat({kQuote, name, kWillBeRemoved});
+  auto delegate = std::make_unique<ProfileDialogDelegate>(path);
+  ProfileDialogDelegate* delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(kDeleteProfileTitle)
+          .SetInternalName("AsideProfileMenuDeleteProfile")
+          .AddParagraph(ui::DialogModelLabel(body))
+          .AddOkButton(
+              base::BindOnce(&ProfileDialogDelegate::OnDelete,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(kDelete).SetStyle(
+                  ui::ButtonStyle::kProminent))
+          .AddCancelButton(base::DoNothing(),
+                           ui::DialogModel::Button::Params().SetLabel(kCancel))
+          .Build();
+  Browser* browser = browser_;
+  CloseBubble();
+  chrome::ShowBrowserModal(browser, std::move(model));
+}
+
+void AsideProfileMenuView::OnSignOut() {
+  aside::ShowExtensionPage(
+      browser_, aside::ExtensionPageUrl(browser_->profile(), kNewTabPage,
+                                        kSettingsAccountRoute));
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnPickIndicatorIcon(const std::string& icon_name) {
+  if (ProfileAttributesEntry* entry =
+          EntryForPath(browser_->profile()->GetPath())) {
+    // Picking the current icon again clears it (back to the monogram).
+    entry->SetAsideProfileIndicatorIcon(
+        entry->GetAsideProfileIndicatorIcon() == icon_name ? std::string()
+                                                           : icon_name);
+  }
+  if (avatar_) {
+    avatar_->Refresh();
+  }
+  ShowPage(Page::kIconPicker);
+}
+
+void AsideProfileMenuView::OnToggleRemoteDebugging() {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state ||
+      !local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed)) {
+    return;
+  }
+  local_state->SetBoolean(
+      prefs::kDevToolsRemoteDebuggingEnabled,
+      !local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled));
+  ShowPage(Page::kAdvanced);
+}
+
+void AsideProfileMenuView::OnToggleExternalAiControl() {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return;
+  }
+  local_state->SetBoolean(kAllowExternalAiControlPref,
+                          !local_state->GetBoolean(kAllowExternalAiControlPref));
+  ShowPage(Page::kAdvanced);
+}
+
+void AsideProfileMenuView::OnRestoreClosedTab(int session_id) {
+  sessions::TabRestoreService* service =
+      TabRestoreServiceFactory::GetForProfile(browser_->profile());
+  if (service) {
+    service->RestoreEntryById(browser_->GetFeatures().live_tab_context(),
+                              SessionID::FromSerializedValue(session_id),
+                              WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  }
+  CloseBubble();
+}
+
+void AsideProfileMenuView::OnOpenDownload(uint32_t download_id) {
+  content::DownloadManager* manager =
+      browser_->profile()->GetDownloadManager();
+  if (manager) {
+    if (download::DownloadItem* item = manager->GetDownload(download_id)) {
+      item->OpenDownload();
+    }
+  }
+  CloseBubble();
+}
+
+BEGIN_METADATA(AsideProfileMenuView)
+END_METADATA
