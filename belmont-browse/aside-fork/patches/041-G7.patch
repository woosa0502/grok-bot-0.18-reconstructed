+
+namespace {
+
+// The original's band is a few device-independent pixels tall and hugs the
+// bottom edge of the top container.
+constexpr int kLoadingBarHeight = 3;
+
+}  // namespace
+
+TopContainerLoadingBar::TopContainerLoadingBar(Browser* browser)
+    : browser_(browser) {
+  SetCanProcessEventsWithinSubtree(false);
+  SetVisible(false);
+  if (browser_) {
+    browser_->tab_strip_model()->AddObserver(this);
+    ObserveActiveTab();
+  }
+}
+
+TopContainerLoadingBar::~TopContainerLoadingBar() {
+  if (browser_) {
+    browser_->tab_strip_model()->RemoveObserver(this);
+  }
+}
+
+void TopContainerLoadingBar::SetLoadingProgress(double progress) {
+  progress = std::clamp(progress, 0.0, 1.0);
+  if (loading_progress_ == progress) {
+    return;
+  }
+  loading_progress_ = progress;
+  // Hidden while idle and once the load has completed, exactly like the
+  // original's fade-out at progress == 1.
+  SetVisible(progress > 0.0 && progress < 1.0);
+  SchedulePaint();
+}
+
+double TopContainerLoadingBar::GetLoadingProgress() const {
+  return loading_progress_;
+}
+
+void TopContainerLoadingBar::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* provider = GetColorProvider();
+  if (!provider || loading_progress_ <= 0.0) {
+    return;
+  }
+  // The original (OnPaint at x86_64 0x04c855a0) fills the whole band with
+  // kColorAsideControlSubtleBackground (id 257) and then fills the leading
+  // portion with kColorAsideControlProminentBackground (id 255), both with
+  // gfx::Canvas::FillRect - no anti-aliasing and no rounding.
+  gfx::Rect track(GetLocalBounds());
+  track.set_height(std::min(track.height(), kLoadingBarHeight));
+  track.set_y(GetLocalBounds().bottom() - track.height());
+  canvas->FillRect(track, provider->GetColor(kColorAsideControlSubtleBackground));
+
+  gfx::Rect filled(track);
+  filled.set_width(
+      static_cast<int>(track.width() * std::clamp(loading_progress_, 0.0, 1.0)));
+  if (!filled.IsEmpty()) {
+    canvas->FillRect(filled,
+                     provider->GetColor(kColorAsideControlProminentBackground));
+  }
+}
+
+void TopContainerLoadingBar::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    ObserveActiveTab();
+  }
+}
+
+void TopContainerLoadingBar::ObserveActiveTab() {
+  content::WebContents* active =
+      browser_ ? browser_->tab_strip_model()->GetActiveWebContents() : nullptr;
+  Observe(active);
+  SetLoadingProgress(active && active->IsLoading() ? active->GetLoadProgress()
+                                                   : 0.0);
+}
+
+void TopContainerLoadingBar::LoadProgressChanged(double progress) {
+  SetLoadingProgress(progress);
+}
+
+void TopContainerLoadingBar::DidStartLoading() {
+  SetLoadingProgress(0.05);
+}
+
+void TopContainerLoadingBar::DidStopLoading() {
+  SetLoadingProgress(0.0);
+}
