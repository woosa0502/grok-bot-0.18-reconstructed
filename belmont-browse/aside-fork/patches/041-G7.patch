+void AsideProfileMenuView::BuildHeader() {
+  auto header = std::make_unique<views::BoxLayoutView>();
+  header->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  header->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  header->SetInsideBorderInsets(gfx::Insets::VH(6, 8));
+  header->SetBetweenChildSpacing(8);
+
+  Profile* profile = browser_->profile();
+  if (profile->IsIncognitoProfile()) {
+    header->AddChildView(std::make_unique<views::ImageView>(
+        ui::ImageModel::FromVectorIcon(kAsideIncognitoRefreshMenuIcon,
+                                       ui::kColorIcon, kAvatarSize)));
+  } else {
+    avatar_ = header->AddChildView(std::make_unique<ProfileMonogramAvatarView>(
+        profile->GetPath(), kAvatarSize));
+  }
+
+  auto text = std::make_unique<views::BoxLayoutView>();
+  text->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  auto name = std::make_unique<views::Label>(DisplayName(profile));
+  name->SetFontList(aside::UiFontList(13, gfx::Font::Weight::MEDIUM));
+  name->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  name_label_ = text->AddChildView(std::move(name));
+  const std::string email = profile->GetPrefs()->GetString("aside.account_email");
+  if (!email.empty()) {
+    auto email_label = std::make_unique<views::Label>(
+        base::UTF8ToUTF16(email), views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY);
+    email_label->SetFontList(aside::UiFontList(11, gfx::Font::Weight::NORMAL));
+    email_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    text->AddChildView(std::move(email_label));
+  }
+  views::View* text_view = header->AddChildView(std::move(text));
+  header->SetFlexForView(text_view, 1);
+
+  // "Profile actions" opens the Edit / Change Icon / Sign Out submenu.
+  auto actions = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                          base::Unretained(this), Page::kProfileActions),
+      kAsideDotGrid1x3HorizontalStrokeIcon, kIconSize);
+  actions->SetTooltipText(std::u16string(kProfileActions));
+  actions->GetViewAccessibility().SetName(std::u16string(kProfileActions));
+  header->AddChildView(std::move(actions));
+  header_ = AddChildView(std::move(header));
+}
+
+void AsideProfileMenuView::ShowPage(Page page) {
+  page_ = page;
+  body_->RemoveAllChildViews();
+  switch (page) {
+    case Page::kRoot:
+      BuildRootPage();
+      break;
+    case Page::kProfiles:
+      BuildProfilesPage();
+      break;
+    case Page::kExtensions:
+      BuildExtensionsPage();
+      break;
+    case Page::kExtensionActions:
+      BuildExtensionActionsPage();
+      break;
+    case Page::kBookmarks:
+      BuildBookmarksPage();
+      break;
+    case Page::kDownloads:
+      BuildDownloadsPage();
+      break;
+    case Page::kHistory:
+      BuildHistoryPage();
+      break;
+    case Page::kDevelopers:
+      BuildDevelopersPage();
+      break;
+    case Page::kAdvanced:
+      BuildAdvancedPage();
+      break;
+    case Page::kProfileActions:
+      BuildProfileActionsPage();
+      break;
+    case Page::kIconPicker:
+      BuildIconPickerPage();
+      break;
+  }
+  InvalidateLayout();
+  if (views::Widget* widget = GetWidget()) {
+    widget->SetSize(widget->non_client_view()->GetPreferredSize({}));
+  }
+}
