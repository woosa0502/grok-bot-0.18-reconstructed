+// The Aside palette.  Every value below was read back out of the original
+// Aside framework binary (Aside-Framework-1.0.825.1-x86_64): the mixer
+// function at 0x035f9240 takes (ColorMixer&, bool dark) and assigns exactly
+// these 66 ids, 58 of them as literal SkColors and 8 as aliases of another
+// kColorAside* id.  No blend/alpha transforms are used by the original, so
+// each recipe here is a single term, matching the original one for one.
+//
+// Callers: the original adds this mixer first, before the other chrome
+// mixers, which is what AddChromeColorMixers() does here too.
+
+void AddAsideColorMixer(ui::ColorProvider* provider,
+                        const ui::ColorProviderKey& key) {
+  const bool dark =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  mixer[kColorAsideSurfacePrimary] =
+      {dark ? SkColorSetARGB(0x14, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xFF, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideSurfaceBorder] =
+      {dark ? SkColorSetARGB(0x26, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x1A, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideSurfaceBorderStrong] =
+      {dark ? SkColorSetARGB(0x33, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x26, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideAdjacentPaneBorder] = {kColorAsideSurfaceBorderStrong};
+  mixer[kColorAsideSurfaceSecondary] =
+      {dark ? SkColorSetARGB(0x0F, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xD9, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideSurfaceTertiary] =
+      {dark ? SkColorSetARGB(0x0A, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x8C, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideSurfaceQuarternary] =
+      {dark ? SkColorSetARGB(0x14, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x14, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideSurfacePrimaryForeground] =
+      {dark ? SkColorSetARGB(0xD9, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xD9, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideSurfaceSecondaryForeground] =
+      {dark ? SkColorSetARGB(0x8C, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x8C, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideSurfaceTertiaryForeground] =
+      {dark ? SkColorSetARGB(0x40, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x40, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideSurfaceInactiveForeground] =
+      {dark ? SkColorSetARGB(0xBF, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xBF, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideBaseForeground] =
+      {dark ? SkColorSetARGB(0xFF, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xFF, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideBaseBorder] =
+      {dark ? SkColorSetARGB(0x1A, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x1A, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideShadow] = {SkColorSetARGB(0x1A, 0x00, 0x00, 0x00)};
+  mixer[kColorAsideShadowSubtle] = {SkColorSetARGB(0x0D, 0x00, 0x00, 0x00)};
+  mixer[kColorAsidePinnedTabInactiveBackground] = {SkColorSetARGB(0x0F, 0xFA, 0xFA, 0xFA)};
+  mixer[kColorAsideHorizontalPinnedTabGroupBackground] =
+      {dark ? SkColorSetARGB(0x0F, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x8C, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsidePinnedTabInactiveBorder] =
+      {dark ? SkColorSetARGB(0x26, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x26, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideMutedForeground] =
+      {dark ? SkColorSetARGB(0x8C, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x8C, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideWindowBackground] =
+      {dark ? SkColorSetARGB(0x80, 0x17, 0x17, 0x17)
+            : SkColorSetARGB(0x80, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideTransparentWindowBackground] = {SkColorSetARGB(0x00, 0x00, 0x00, 0x00)};
+  mixer[kColorAsideBrowserWindowDimOverlay] =
+      {dark ? SkColorSetARGB(0x33, 0x60, 0x60, 0x60)
+            : SkColorSetARGB(0x66, 0xDE, 0xDE, 0xDE)};
+  mixer[kColorAsideWebContentsOverlay] =
+      {dark ? SkColorSetARGB(0xCC, 0x17, 0x17, 0x17)
+            : SkColorSetARGB(0xCC, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideHoverCardBackground] =
+      {dark ? SkColorSetARGB(0xFF, 0x1F, 0x1F, 0x1F)
+            : SkColorSetARGB(0xFF, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideTabSwitcherBackground] =
+      {dark ? SkColorSetARGB(0xB3, 0x17, 0x17, 0x17)
+            : SkColorSetARGB(0xB8, 0xF8, 0xF8, 0xF8)};
+  mixer[kColorAsideTabSwitcherItemBackgroundFocused] =
+      {dark ? SkColorSetARGB(0x14, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x14, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideFloatingSidebarBackground] =
+      {dark ? SkColorSetARGB(0xFF, 0x24, 0x27, 0x2B)
+            : SkColorSetARGB(0xFF, 0xF3, 0xF4, 0xF6)};
+  mixer[kColorAsideMenuItemBackgroundHover] =
+      {dark ? SkColorSetARGB(0x1A, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x14, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideMenuItemBackgroundSelected] =
+      {dark ? SkColorSetARGB(0x20, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x1A, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideUpdatePromptBackground] =
+      {dark ? SkColorSetARGB(0x99, 0x18, 0x18, 0x1B)
+            : SkColorSetARGB(0x99, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideUpdateBadgeBackground] =
+      {dark ? SkColorSetARGB(0x33, 0x38, 0xB6, 0xF6)
+            : SkColorSetARGB(0x1A, 0x02, 0x84, 0xC7)};
+  mixer[kColorAsideUpdateBadgeForeground] =
+      {dark ? SkColorSetARGB(0xFF, 0x38, 0xB6, 0xF6)
+            : SkColorSetARGB(0xFF, 0x0E, 0xA5, 0xE9)};
+  mixer[kColorAsideActionAccentBackground] = {SkColorSetARGB(0x33, 0x38, 0xBD, 0xF8)};
+  mixer[kColorAsideActionAccentForeground] = {SkColorSetARGB(0xFF, 0x38, 0xBD, 0xF8)};
+  mixer[kColorAsideFocusedLocationBarBackground] =
+      {dark ? SkColorSetARGB(0xFF, 0x37, 0x37, 0x37)
+            : SkColorSetARGB(0xFF, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideTooltipBackground] =
+      {dark ? SkColorSetARGB(0xFF, 0x18, 0x18, 0x1B)
+            : SkColorSetARGB(0xFF, 0xFA, 0xFA, 0xFA)};
+  mixer[kColorAsideTooltipForeground] =
+      {dark ? SkColorSetARGB(0xD9, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xFF, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideTooltipBorder] =
+      {dark ? SkColorSetARGB(0x26, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x1A, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideTooltipKbdBackground] =
+      {dark ? SkColorSetARGB(0x14, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x0D, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideTooltipKbdForeground] =
+      {dark ? SkColorSetARGB(0xD9, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xD9, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideControlProminentBackground] =
+      {dark ? SkColorSetARGB(0xD9, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xD9, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideControlProminentForeground] =
+      {dark ? SkColorSetARGB(0xD9, 0x0A, 0x0A, 0x0A)
+            : SkColorSetARGB(0xD9, 0xFA, 0xFA, 0xFA)};
+  mixer[kColorAsideControlSubtleBackground] = {kColorAsideSurfaceTertiary};
+  mixer[kColorAsideControlSubtleBorder] = {kColorAsideSurfaceBorder};
+  mixer[kColorAsideControlSubtleForeground] = {kColorAsideSurfacePrimaryForeground};
+  mixer[kColorAsideControlSubtleForegroundDisabled] = {kColorAsideSurfaceSecondaryForeground};
+  mixer[kColorAsideControlHoverOnProminent] =
+      {dark ? SkColorSetARGB(0x1A, 0x0A, 0x0A, 0x0A)
+            : SkColorSetARGB(0x1A, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideControlHoverOnSubtle] = {kColorAsideSurfaceQuarternary};
+  mixer[kColorAsideSidebarItemBackgroundHover] = {kColorAsideSurfaceQuarternary};
+  mixer[kColorAsideControlPressedOnSubtle] =
+      {dark ? SkColorSetARGB(0x26, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x1A, 0x0A, 0x0A, 0x0A)};
+  mixer[kColorAsideControlSuccess] = {SkColorSetARGB(0xFF, 0x16, 0xA3, 0x4A)};
+  mixer[kColorAsideControlSuccessSubtleBackground] = {SkColorSetARGB(0x33, 0x16, 0xA3, 0x4A)};
+  mixer[kColorAsideControlWarning] = {SkColorSetARGB(0xFF, 0xFA, 0xCC, 0x15)};
+  mixer[kColorAsideControlWarningSubtleBackground] = {SkColorSetARGB(0x33, 0xFA, 0xCC, 0x15)};
+  mixer[kColorAsideControlInvalid] = {SkColorSetARGB(0xFF, 0xFB, 0x71, 0x71)};
+  mixer[kColorAsideControlInvalidSubtleBackground] = {SkColorSetARGB(0x33, 0xFB, 0x71, 0x71)};
+  mixer[kColorAsideControlOnSuccessForeground] = {SkColorSetARGB(0xFF, 0xFA, 0xFA, 0xFA)};
+  mixer[kColorAsideTaskAttentionBadgeBackground] = {SkColorSetARGB(0x1A, 0x16, 0xA3, 0x4A)};
+  mixer[kColorAsideTaskAttentionBadgeForeground] =
+      {dark ? SkColorSetARGB(0xFF, 0x22, 0xC5, 0x5E)
+            : SkColorSetARGB(0xFF, 0x16, 0xA3, 0x4A)};
+  mixer[kColorAsideTaskCompletedIndicator] =
+      {dark ? SkColorSetARGB(0xFF, 0x38, 0xB6, 0xF6)
+            : SkColorSetARGB(0xFF, 0x02, 0x84, 0xC7)};
+  mixer[kColorAsideTabGroupForeground] =
+      {dark ? SkColorSetARGB(0xFF, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0xFF, 0x09, 0x0B, 0x0C)};
+  mixer[kColorAsideTabGroupCountChipBackground] =
+      {dark ? SkColorSetARGB(0x4D, 0xFA, 0xFA, 0xFA)
+            : SkColorSetARGB(0x4D, 0x09, 0x0B, 0x0C)};
+  mixer[kColorAsideToggleThumb] = {SkColorSetARGB(0xFF, 0xFF, 0xFF, 0xFF)};
+  mixer[kColorAsideToggleThumbHover] =
+      {dark ? SkColorSetARGB(0xFF, 0xD4, 0xD4, 0xD8)
+            : SkColorSetARGB(0xFF, 0xE5, 0xE5, 0xE5)};
+  mixer[kColorAsideToggleTrackOff] = {kColorAsideSurfaceBorder};
+  mixer[kColorAsideToggleHover] = {SkColorSetARGB(0x1F, 0x0A, 0x0A, 0x0A)};
+}
