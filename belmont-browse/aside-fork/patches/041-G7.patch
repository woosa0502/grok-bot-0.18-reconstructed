+// Backs the "Edit profile" and "Delete profile?" dialogs.
+class ProfileDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit ProfileDialogDelegate(const base::FilePath& path) : path_(path) {}
+
+  void OnRename() {
+    ProfileAttributesEntry* entry = EntryForPath(path_);
+    if (!entry) {
+      return;
+    }
+    const std::u16string name =
+        dialog_model()->GetTextfieldByUniqueId(kEditProfileNameFieldId)->text();
+    if (!name.empty()) {
+      entry->SetLocalProfileName(name, /*is_default_name=*/false);
+    }
+  }
+
+  void OnDelete() {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (!manager) {
+      return;
+    }
+    manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+        path_, base::DoNothing(),
+        ProfileMetrics::DELETE_PROFILE_SETTINGS);
+  }
+
+ private:
+  const base::FilePath path_;
+};
