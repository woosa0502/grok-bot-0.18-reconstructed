+// Returns true when the pointer is still over the strip or its collapse
+// button, in which case the monitor takes over closing the preview.
+bool VerticalTabStripRegionView::StartAsideCollapseHoverMonitor() {
+  const views::View* collapse_button =
+      top_button_container_ ? top_button_container_->GetCollapseButton()
+                            : nullptr;
+  if (!AsideToolbarCollapseHoverMonitor::IsPointerInside(this,
+                                                         collapse_button)) {
+    return false;
+  }
+  aside_collapse_hover_monitor_.Start(
+      this, collapse_button,
+      base::BindRepeating(
+          [](VerticalTabStripRegionView* view, bool pointer_inside) {
+            if (pointer_inside) {
+              // Back inside before the grace period ran out: keep the preview.
+              view->aside_collapse_hover_monitor_.CancelExit();
+              return;
+            }
+            // The original arms a 500 ms one-shot timer here rather than
+            // closing at once (StartToolbarCollapseButtonHoverExitTimer), so a
+            // pointer crossing the gap between the strip and its collapse
+            // button does not lose the preview.
+            view->aside_collapse_hover_monitor_.StartExit(base::BindOnce(
+                [](VerticalTabStripRegionView* view) {
+                  if (AsideToolbarCollapseHoverMonitor::IsPointerInside(
+                          view, view->top_button_container_
+                                    ? view->top_button_container_
+                                          ->GetCollapseButton()
+                                    : nullptr)) {
+                    return;
+                  }
+                  view->aside_collapse_hover_monitor_.Stop();
+                  view->UpdateExpandOnHoverState(false);
+                },
+                base::Unretained(view)));
+          },
+          base::Unretained(this)));
+  return true;
+}
