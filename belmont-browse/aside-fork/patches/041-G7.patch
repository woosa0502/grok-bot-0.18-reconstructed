+void VerticalTabStripRegionView::UpdateCrossSectionDragPreview(
+    const std::optional<BrowserRootView::DropIndex>& index) {
+  if (!cross_section_drag_preview_) {
+    return;
+  }
+  // A drop that lands inside the tab list keeps the ordinary drop arrow; only
+  // a drop aimed at one of the other sections gets the preview band.
+  if (index.has_value() || !aside_organizer_ ||
+      !aside_organizer_->GetVisible()) {
+    cross_section_drag_preview_->SetTargetSection(nullptr);
+    return;
+  }
+  display::Screen* screen = display::Screen::Get();
+  const gfx::Point cursor =
+      screen ? screen->GetCursorScreenPoint() : gfx::Point();
+  gfx::Point local = cursor;
+  views::View::ConvertPointFromScreen(this, &local);
+  views::View* target = nullptr;
+  const std::array<views::View*, 2> candidates = {
+      static_cast<views::View*>(aside_organizer_),
+      static_cast<views::View*>(aside_additions_)};
+  for (views::View* candidate : candidates) {
+    if (candidate && candidate->GetVisible() &&
+        candidate->bounds().Contains(local)) {
+      target = candidate;
+      break;
+    }
+  }
+  cross_section_drag_preview_->SetTargetSection(target);
 }
 
