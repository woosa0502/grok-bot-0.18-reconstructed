+// Original strings (Aside 1.0.825.1 locale pak; ids in comments).
+constexpr char16_t kViewOrganizer[] = u"View Organizer";   // IDS 11728
+constexpr char16_t kHideOrganizer[] = u"Hide Organizer";   // IDS 11729
+constexpr char16_t kTabGroups[] = u"Tab Groups";           // IDS 11730
+constexpr char16_t kRecentChats[] = u"Recent Chats & Threads";  // IDS 11731
+constexpr char16_t kAsideTasks[] = u"Aside Tasks";  // UTF-16 literal 0xcf648d6
+// Chat row context menu. Command ids and order are the original's
+// (RE 0x43d16dc-0x43d1a10: AddItem(0x7d0..0x7d3), separator,
+// AddItem(0x7d4..0x7d5), separator, AddItem(0x7d6)); labels are its UTF-16
+// literals at arm64 0xd77ae36-0xd77aeea. Daemon command words come from
+// vertical_tab_strip_region_view.cc's dispatcher (arm64 0xd6bc900-0xd6bc93f:
+// nameChat / archive / mark-read / mark-all-read / archive-all-chats /
+// open-folder).
+enum TaskMenuCommand {
+  kTaskMenuRename = 0x7d0,
+  kTaskMenuArchive = 0x7d1,
+  kTaskMenuBookmarkChat = 0x7d2,
+  kTaskMenuMarkRead = 0x7d3,
+  kTaskMenuOpenFolder = 0x7d4,
+  kTaskMenuCopySessionId = 0x7d5,
+  kTaskMenuOpenInNewTab = 0x7d6,
+  // Section header menu (RE 0x43d2734-0x43d2864: 0x834, 0x835, separator,
+  // 0x836).
+  kSectionMenuMarkAllRead = 0x834,
+  kSectionMenuArchiveAll = 0x835,
+  kSectionMenuShowAllChats = 0x836,
+  // Strip (empty area) context menu — RE IDS 277/9443/176/12245/9449/294/
+  // 11699/11710 loaded by vertical_tab_strip_region_view.cc (0x43a8xxx).
+  kStripMenuNewTab = 100,
+  kStripMenuReopenClosedTab,
+  kStripMenuBookmarkAllTabs,
+  kStripMenuGroupAllTabs,
+  kStripMenuNameWindow,
+  kStripMenuCreateSplitView,
+  kStripMenuTaskManager,
+  kStripMenuShowTabsHorizontally,
+};
+// Literals the original builds inline (RE 0x365ff84 "Tidy", 0x36600d0
+// "Organizer").
+constexpr char16_t kTidy[] = u"Tidy";
+constexpr char16_t kOrganizer[] = u"Organizer";
+constexpr char16_t kNewChat[] = u"New Chat";
+
+// Chat row / section menu labels, original UTF-16 literals
+// (arm64 0xd77ae36-0xd77af54).
+constexpr char16_t kRenameChat[] = u"Rename chat";
+constexpr char16_t kArchiveChat[] = u"Archive Chat";
+constexpr char16_t kBookmarkChat[] = u"Bookmark chat";
+constexpr char16_t kMarkAsRead[] = u"Mark as read";
+constexpr char16_t kOpenFolderInFinder[] = u"Open folder in Finder";
+constexpr char16_t kCopySessionId[] = u"Copy session ID";
+constexpr char16_t kOpenInANewTab[] = u"Open in a new tab";
+constexpr char16_t kMarkAllAsRead[] = u"Mark all as read";
+constexpr char16_t kArchiveAllChats[] = u"Archive all chats";
+constexpr char16_t kShowAllChats[] = u"Show all chats";
+// Row status / fallback strings (arm64 0xd77b242-0xd77b286, 0xd77b22e,
+// 0xd77b0b6).
+constexpr char16_t kAwaitingApproval[] = u"Awaiting approval";
+constexpr char16_t kAwaitingAnswer[] = u"Awaiting answer";
+constexpr char16_t kUntitledTask[] = u"Untitled task";
+constexpr char16_t kShowMore[] = u"Show more";
+constexpr char16_t kSessionIdCopied[] = u"Session ID Copied!";
+
+// "Awaiting approval" / "Awaiting answer" next to a row that is waiting on the
+// user. Empty for every other status.
+std::u16string StatusLabelFor(const std::string& status) {
+  if (status == "awaiting-approval") {
+    return kAwaitingApproval;
+  }
+  if (status == "awaiting-answer") {
+    return kAwaitingAnswer;
+  }
+  return std::u16string();
+}
