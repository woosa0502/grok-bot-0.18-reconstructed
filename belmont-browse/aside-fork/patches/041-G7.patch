+//
+// The original names this VerticalTabBookmarksView (rows:
+// VerticalBookmarkRowView) in
+// chrome/browser/ui/views/frame/vertical_tab_bookmarks_view.cc. Its two row
+// context menus and the four edit dialogs are reproduced here; the dialogs live
+// in aside_bookmark_dialogs.{h,cc}.
+class AsideBookmarksSectionView : public views::BoxLayoutView,
+                                  public bookmarks::BaseBookmarkModelObserver,
+                                  public views::ContextMenuController,
+                                  public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(AsideBookmarksSectionView, views::BoxLayoutView)
+
+ public:
+  explicit AsideBookmarksSectionView(Browser* browser);
+  ~AsideBookmarksSectionView() override;
+
+  void Rebuild();
+
+  // bookmarks::BaseBookmarkModelObserver:
+  void BookmarkModelChanged() override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  // Binds the bookmark model, the pref registrar and the tab-representation
+  // helper to browser_->profile().  Re-run after the profile pager repoints
+  // this window at another profile (Browser::RegisterAsideProfileSwitched),
+  // otherwise the section keeps showing the previous profile's bookmarks.
+  void BindToProfile();
+  void OnProfileSwitched(Browser* browser);
+  void AddNodeRows(const bookmarks::BookmarkNode* node, int depth);
+  void ToggleSection();
+  void ToggleFolder(int64_t folder_id);
+  void OpenBookmark(int64_t node_id);
+  bool IsFolderExpanded(int64_t folder_id) const;
+  std::set<std::string> ExpandedFolderIds() const;
+  // Opens `node_id` with `disposition`; used by the "Open in ..." commands.
+  void OpenBookmarkWith(int64_t node_id, WindowOpenDisposition disposition);
+
+  raw_ptr<Browser> browser_;
+  raw_ptr<bookmarks::BookmarkModel> model_ = nullptr;
