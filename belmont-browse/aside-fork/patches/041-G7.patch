+void AsideProfileMenuView::BuildExtensionsPage() {
+  AddBackRow(body_, kExtensions,
+             base::BindRepeating(&AsideProfileMenuView::ShowPage,
+                                 base::Unretained(this), Page::kRoot));
+
+  body_->AddChildView(MakeSectionLabel(kInstalledExtensions));
+  int shown = 0;
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(browser_->profile());
+  if (registry) {
+    for (const auto& extension : registry->enabled_extensions()) {
+      if (extensions::Manifest::IsComponentLocation(extension->location()) ||
+          extension->id() == aside::kAsideExtensionId) {
+        continue;
+      }
+      ++shown;
+      body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+          base::BindRepeating(
+              [](AsideProfileMenuView* self, std::string id) {
+                self->OpenExtensionActions(id);
+              },
+              base::Unretained(this), extension->id()),
+          base::UTF8ToUTF16(extension->name()),
+          &kAsideExtensionChromeRefreshIcon));
+    }
+  }
+  if (shown == 0) {
+    body_->AddChildView(MakeSectionLabel(kNoInstalledExtensions));
+  }
+
+  body_->AddChildView(std::make_unique<views::Separator>());
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::ShowExtensions(browser);
+            self->CloseBubbleForCommand();
+          },
+          base::Unretained(this), browser_),
+      kManageAllExtensions, &kAsideSettingsSliderHorStrokeIcon));
+  body_->AddChildView(std::make_unique<AsideMenuItemButton>(
+      base::BindRepeating(
+          [](AsideProfileMenuView* self, Browser* browser) {
+            chrome::AddSelectedTabWithURL(
+                browser,
