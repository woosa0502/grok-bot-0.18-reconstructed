+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { groundAction,MemoryRetriever,DigitalSelf } from '../dist/index.js';
+import { learningSetup,turn,accepted,S,T0,NOW } from './learning-helpers.mjs';
+const flight=(extra={})=>({scope:S,query:'뉴욕 항공편 찾아줘',task:'flight_search',at:NOW,context:{distance:'long-haul'},arguments:{destination:'NYC'},...extra});
+test('memory changes real HTTP tool arguments months after learning',async t=>{
+ const h=learningSetup(t);const absent=await h.self.prepare(flight());assert.equal(absent.action.arguments.seatPreference,undefined);
+ h.dream.learn([turn('장거리 비행은 가격이 조금 높아도 통로석을 선호한다')]);
+ let observed;const server=createServer(async(req,res)=>{let s='';for await(const p of req)s+=p;observed=JSON.parse(s);res.setHeader('content-type','application/json');res.end('{"ok":true}');});await new Promise(r=>server.listen(0,'127.0.0.1',r));t.after(()=>{server.closeAllConnections();server.close();});
+ const result=await h.self.execute(flight(),async action=>{const r=await fetch(`http://127.0.0.1:${server.address().port}/flight_search`,{method:'POST',body:JSON.stringify(action.arguments)});return r.json();});
+ assert.equal(observed.destination,'NYC');assert.equal(observed.seatPreference,'aisle');assert.equal(observed.pricePriority,'seat_over_price');assert.equal(result.action.memoryBindings.length,2);assert(result.retrieval.packet.evidence.some(e=>e.quote.includes('통로석')));assert.equal(observed.maxPrice,undefined);
+});
+test('explicit user correction controls later action, not the old trend',async t=>{const h=learningSetup(t);h.dream.learn([turn('장거리 비행은 통로석을 선호한다')]);h.dream.learn([turn('장거리 비행은 창가를 선호한다',T0+86400000,{explicitMemory:true})]);const r=await h.self.prepare(flight());assert.equal(r.action.arguments.seatPreference,'window');assert.equal(r.action.memoryBindings.length,1);});
+test('new current-turn argument beats stored preference',async t=>{const h=learningSetup(t);h.dream.learn([turn('장거리 비행은 통로석을 선호한다')]);const r=await h.self.prepare(flight({arguments:{destination:'NYC',seatPreference:'window'}}));assert.equal(r.action.arguments.seatPreference,'window');assert.equal(r.action.memoryBindings.length,0);});
+test('short-haul and long-haul seats remain distinct in tool arguments',async t=>{const h=learningSetup(t);h.dream.learn([turn('장거리 비행은 통로석을 선호한다'),turn('단거리 비행은 창가를 선호한다',T0+1000)]);const long=await h.self.prepare(flight()),short=await h.self.prepare(flight({context:{distance:'short-haul'}}));assert.equal(long.action.arguments.seatPreference,'aisle');assert.equal(short.action.arguments.seatPreference,'window');});
+test('unknown route context does not invent the applicability of long-haul preference',async t=>{const h=learningSetup(t);h.dream.learn([turn('장거리 비행은 통로석을 선호한다')]);const r=await h.self.prepare(flight({context:{}}));assert.equal(r.action.arguments.seatPreference,undefined);});
