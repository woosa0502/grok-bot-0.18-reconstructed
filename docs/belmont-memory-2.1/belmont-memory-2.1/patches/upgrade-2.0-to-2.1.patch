+export const mean=x=>x.length?x.reduce((a,b)=>a+b,0)/x.length:0;
+export const quantile=(x,q)=>{if(!x.length)return 0;const a=[...x].sort((a,b)=>a-b);return a[Math.min(a.length-1,Math.floor(q*(a.length-1)))];};
+export function score(ids,relevant,k){if(!relevant.length)return{recall:null,ndcg:null};const set=new Set(relevant),top=ids.slice(0,k),dcg=top.reduce((s,id,i)=>s+(set.has(id)?1/Math.log2(i+2):0),0),ideal=Array.from({length:Math.min(k,set.size)},(_,i)=>1/Math.log2(i+2)).reduce((s,x)=>s+x,0);return{recall:top.filter(id=>set.has(id)).length/set.size,ndcg:dcg/ideal};}
+export function aggregate(rows){const answerable=rows.filter(x=>x.relevant.length),absent=rows.filter(x=>!x.relevant.length);return{queries:rows.length,answerable:answerable.length,recall5:mean(answerable.map(r=>r.at5.recall)),recall10:mean(answerable.map(r=>r.at10.recall)),ndcg5:mean(answerable.map(r=>r.at5.ndcg)),ndcg10:mean(answerable.map(r=>r.at10.ndcg)),evidencePrecision:mean(answerable.map(r=>r.evidencePrecision)),abstention:absent.length?absent.filter(r=>r.returned.length===0).length/absent.length:null,p50Ms:quantile(rows.flatMap(r=>r.latencies),.5),p95Ms:quantile(rows.flatMap(r=>r.latencies),.95),meanContextTokenEstimate:mean(rows.map(r=>r.estimatedTokens)),meanContextBytes:mean(rows.map(r=>r.bytes))};}
