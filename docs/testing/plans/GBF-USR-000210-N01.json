{
  "schemaVersion": 1,
  "caseId": "GBF-USR-000210-N01",
  "description": "명령 팔레트 Arrow Up/Down 이동 후 Enter로 강조 항목 실행",
  "expectedBehavior": "명령 팔레트에서 Arrow Up/Down으로 이동한 뒤 Enter로 강조된 항목을 실행한다",
  "steps": [
    { "action": "press", "key": "k", "modifiers": ["CTRL"] },
    { "action": "assert", "locator": { "role": "dialog", "name": "Search", "exact": true }, "expect": { "visible": true }, "timeoutMs": 2000 },
    { "action": "assert", "locator": { "role": "option", "nth": 0 }, "expect": { "textIncludes": "Grok" } },
    { "action": "snapshot", "name": "before-arrow", "maxText": 2000 },
    { "action": "press", "key": "ArrowDown" },
    { "action": "wait", "ms": 200 },
    { "action": "assert", "locator": { "role": "option", "nth": 1 }, "expect": { "textIncludes": "Chat Settings" } },
    { "action": "snapshot", "name": "after-arrow-highlighted", "maxText": 2000 },
    { "action": "screenshot", "name": "after-arrow-highlighted" },
    { "action": "press", "key": "Enter" },
    { "action": "wait", "ms": 500 },
    { "action": "snapshot", "name": "after-enter", "maxText": 3000 },
    { "action": "screenshot", "name": "after-enter" }
  ]
}
